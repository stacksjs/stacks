{
  "ci": {
    "collect": {
      "startServerCommand": "bun .github/lighthouse/serve.ts dist/docs/.bunpress 4173",
      "startServerReadyPattern": "on http://localhost:4173",
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/guide/intro",
        "http://localhost:4173/guide/buddy/commands"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.8
          }
        ]
      }
    }
  }
}
