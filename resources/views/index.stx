<script server>
import { comparisonGroups, comparisons, comparisonsInGroup } from '../data/comparisons'
import { features } from '../data/features'
import { highlight } from '../data/highlight'
import { stats } from '../data/stats'
import { useCases } from '../data/use-cases'

const appName = 'Stacks'

/*
 * Launched. Two gates gated this page and both had to open:
 *
 *   APP_COMING_SOON in .env.production   the server gate, which 302'd / to
 *                                        /coming-soon before this file ran
 *   siteMode here                        the in-page gate, which hides
 *                                        .site-content and shows .mode-screen
 *
 * Flipping only the env var would have served this page with its own holding
 * card over it. Set siteMode back to 'coming-soon' to close it again; the
 * bypass token below is what /?preview= expects while it is closed.
 */
const siteMode = 'live'
const comingSoonBypassEnabled = true
const comingSoonBypassToken = 'trailhead'

const siteUrl = 'https://stacksjs.com'

// Read by the shared marketing-head partial.
const pageTitle = 'Stacks - Full-stack TypeScript framework'
const canonicalPath = '/'
const siteDescription = 'Stacks is a full-stack TypeScript framework. One UI ships to web, desktop, and mobile, with CMS, commerce, AI, auth, queues, and cloud deployment built in.'

// Structured data. Built as a string here so the @-prefixed schema.org keys
// (@context, @type) never reach the stx directive scanner; emitted raw in the
// head with {!! jsonLd !!}.
const pageDescription = siteDescription

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#org`,
      name: appName,
      url: `${siteUrl}/`,
      logo: `${siteUrl}/images/logos/logo.png`,
      sameAs: ['https://github.com/stacksjs/stacks'],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: appName,
      url: `${siteUrl}/`,
      publisher: { '@id': `${siteUrl}/#org` },
    },
    {
      '@type': 'SoftwareApplication',
      name: appName,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Cross-platform',
      description: siteDescription,
      url: `${siteUrl}/`,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
  ],
})

const featureFor = (slug: string) => features.find(feature => feature.slug === slug)

/*
 * The hero's code window. Five real files, one per layer, and every one is
 * the same sample its feature page shows, read from resources/data/features.ts
 * and highlighted at render time. The tabs are radio inputs and CSS, not a
 * script: they work with JavaScript off, and arrow keys move between them the
 * way a native radio group does.
 */
const heroTabs = [
  { slug: 'application-core', label: 'Model' },
  { slug: 'queues-and-mail', label: 'Job' },
  { slug: 'ai', label: 'AI' },
  { slug: 'testing', label: 'Test' },
  { slug: 'cloud-deploys', label: 'Deploy' },
].map((tab, i) => {
  const feature = featureFor(tab.slug)
  return {
    ...tab,
    id: `hero-tab-${i}`,
    checked: i === 0 ? 'checked' : '',
    file: feature ? feature.page.code.file : '',
    html: feature ? highlight(feature.page.code.code) : '',
  }
})

/*
 * The bento. Every cell IS a feature: same title, blurb and order as the mega
 * menu and the /features pages, because all of them read features.ts. Each
 * feature also declares its own width and visual there, so the layout cannot
 * name a feature the list does not have.
 *
 * Everything a cell shows is precomputed here, the href included: stx's dev
 * server blanks `{{ x.slug }}` (stacksjs/stacks#2392), so the template never
 * reads a property by that name.
 */
const bentoCells = features.map((feature) => {
  const tone = feature.bento.tone ? ` bento-cell--${feature.bento.tone}` : ''
  const visual = feature.bento.visual ? ` bento-cell--${feature.bento.visual}` : ''
  return {
    title: feature.title,
    blurb: feature.blurb,
    icon: feature.icon,
    href: `/features/${feature.slug}`,
    className: `bento-cell${tone}${visual}`,
    style: `--cols: ${feature.bento.cols}`,
    visual: feature.bento.visual || '',
    command: feature.page.commands[0],
    // The first dozen lines are the part that says what the file is.
    codeFile: feature.page.code.file,
    codeHtml: feature.bento.visual === 'code' ? highlight(feature.page.code.code.split('\n').slice(0, 12).join('\n')) : '',
    capabilities: feature.page.capabilities.slice(0, 6).map(capability => capability.title),
  }
})

const buildTargets = [
  { icon: 'i-hugeicons-globe-02', name: 'Web', note: 'Server-rendered, hydrated where it needs to be', command: 'buddy dev' },
  { icon: 'i-hugeicons-computer', name: 'macOS desktop', note: 'A native Craft window around the same views', command: 'buddy dev:desktop' },
  { icon: 'i-hugeicons-menu-square', name: 'System tray', note: 'A menu-bar utility from the same views', command: 'buddy build:desktop' },
  { icon: 'i-hugeicons-apple', name: 'iOS', note: 'An Xcode project generated from config/mobile.ts', command: 'buddy build:ios' },
  { icon: 'i-hugeicons-android', name: 'Android', note: 'A Gradle project from the same config', command: 'buddy build:android' },
]

const aiProviders = ['Anthropic', 'OpenAI', 'Ollama', 'Bedrock']
const aiExtras = ['RAG', 'Embeddings', 'MCP client', 'Streaming']
const contentTypes = ['Posts', 'Pages', 'Tags', 'Comments', 'Media', 'RSS']
const deployLines = [
  { name: 'web', note: 'built and uploaded' },
  { name: 'docs', note: 'mounted at /docs' },
  { name: 'cloud', note: 'DNS, CDN, TLS, mail' },
]

/*
 * The long tail. Each is real, first-party, and on the same config and types
 * as the twelve features above, but has no page of its own yet, which is why
 * they are a list rather than cells. Nothing here repeats a bento feature,
 * and nothing is a stub: every entry was checked against its package or its
 * buddy command (October 2026), so add to it the same way.
 */
const longTail = [
  { icon: 'i-hugeicons-credit-card', label: 'Stripe billing and Connect' },
  { icon: 'i-hugeicons-key-01', label: 'OAuth 2 server' },
  { icon: 'i-hugeicons-shield-01', label: 'GDPR export and erasure' },
  { icon: 'i-hugeicons-flash', label: 'Cache' },
  { icon: 'i-hugeicons-checkmark-badge-01', label: 'Validation' },
  { icon: 'i-hugeicons-translate', label: 'i18n' },
  { icon: 'i-hugeicons-flag-02', label: 'Feature flags' },
  { icon: 'i-hugeicons-chart-line-data-01', label: 'Analytics' },
  { icon: 'i-hugeicons-news', label: 'Newsletters' },
  { icon: 'i-hugeicons-message-01', label: 'SMS' },
  { icon: 'i-hugeicons-smart-phone-01', label: 'Push' },
  { icon: 'i-hugeicons-call', label: 'Phone numbers' },
  { icon: 'i-hugeicons-bubble-chat', label: 'Slack, Discord, Teams' },
  { icon: 'i-hugeicons-share-01', label: 'Social posting' },
  { icon: 'i-hugeicons-calendar-03', label: 'Scheduler' },
  { icon: 'i-hugeicons-database-02', label: 'Database backups' },
  { icon: 'i-hugeicons-undo-02', label: 'Deploy rollback' },
  { icon: 'i-hugeicons-wrench-01', label: 'Maintenance mode' },
  { icon: 'i-hugeicons-link-square-01', label: 'Public share tunnels' },
  { icon: 'i-hugeicons-globe-02', label: 'Domains and DNS' },
  { icon: 'i-hugeicons-lock-password', label: 'Encrypted env' },
  { icon: 'i-hugeicons-lock-key', label: 'Encryption and hashing' },
  { icon: 'i-hugeicons-file-01', label: 'Logging' },
  { icon: 'i-hugeicons-alert-02', label: 'Error pages' },
  { icon: 'i-hugeicons-kanban', label: 'Kanban boards' },
  { icon: 'i-hugeicons-task-01', label: 'Forms' },
  { icon: 'i-hugeicons-chart-bar-line', label: 'Charts' },
  { icon: 'i-hugeicons-layers-02', label: 'Multisite' },
  { icon: 'i-hugeicons-image-01', label: 'OG images and app icons' },
  { icon: 'i-hugeicons-puzzle', label: 'Browser extensions' },
  { icon: 'i-hugeicons-code', label: '150+ composables' },
  { icon: 'i-hugeicons-computer-terminal-01', label: 'Tinker REPL' },
]

const startSteps = [
  { icon: 'i-hugeicons-package-open', title: 'Install Pantry', text: 'Provisions Bun, Git, SQLite, and every tool the project declares.', command: 'curl -fsSL https://pantry.dev | bash' },
  { icon: 'i-hugeicons-magic-wand-01', title: 'Create a project', text: 'Scaffolds the app, its config, and its toolchain in one pass.', command: 'panx @stacksjs/buddy new my-app' },
  { icon: 'i-hugeicons-computer-terminal-01', title: 'Develop', text: 'Serves the frontend, API, docs, and dashboard with hot reload.', command: 'buddy dev' },
  { icon: 'i-hugeicons-rocket-01', title: 'Deploy', text: 'Builds every surface and publishes the infrastructure behind it.', command: 'buddy deploy' },
]

const dxCapabilities = [
  { icon: 'i-hugeicons-file-02', title: 'AGENTS.md, checked in', text: 'The file a coding agent reads first, versioned with the code it describes.' },
  { icon: 'i-hugeicons-ai-brain-01', title: 'A skill per subsystem', text: 'From auth to deploys, so an agent reaches for the real API instead of guessing one.' },
  { icon: 'i-hugeicons-source-code-square', title: 'Typed end to end', text: 'Model, migration, API, and view are typed against each other. A rename is everywhere or it does not compile.' },
  { icon: 'i-hugeicons-checkmark-circle-02', title: 'One way to check', text: 'buddy lint, typecheck, and test gate a human pull request and an agent the same way.' },
]

const agentTree = [
  { depth: 0, icon: 'i-hugeicons-file-02', name: 'AGENTS.md', note: 'you write this', source: true },
  { depth: 0, icon: 'i-hugeicons-file-01', name: 'CLAUDE.md', note: 'generated', source: false },
  { depth: 0, icon: 'i-hugeicons-folder-01', name: '.claude/skills/', note: '115 skills', source: false },
  { depth: 1, icon: 'i-hugeicons-file-01', name: 'stacks-models/SKILL.md', note: '', source: false },
  { depth: 1, icon: 'i-hugeicons-file-01', name: 'stacks-deploy/SKILL.md', note: '', source: false },
  { depth: 0, icon: 'i-hugeicons-folder-01', name: '.cursor/rules/', note: 'generated', source: false },
]

const deployTargets = [
  { icon: 'i-hugeicons-server-stack-01', label: 'Hetzner' },
  { icon: 'i-hugeicons-cloud', label: 'AWS' },
  { icon: 'i-hugeicons-computer-terminal-01', label: 'Any box over SSH' },
  { icon: 'i-hugeicons-hard-drive', label: 'A Raspberry Pi' },
]

const deploySurfaces = [
  { name: 'Web app', detail: 'stacksjs.com' },
  { name: 'Docs', detail: 'stacksjs.com/docs' },
  { name: 'Blog, RSS, sitemap', detail: 'stacksjs.com/blog' },
  { name: 'API', detail: 'stacksjs.com/api' },
  { name: 'Infrastructure', detail: 'DNS, TLS, storage, mail' },
  { name: 'Rollback', detail: 'buddy deploy:rollback' },
]

/*
 * The two hubs the nav opens as mega menus, given a landing on the page
 * itself: someone who scrolls rather than hovers should still meet them.
 *
 * Both samples are derived rather than listed, so neither can name a page
 * that stopped existing. The comparisons take the first two of each group
 * so the sample spans full-stack JS, TypeScript backends, and the other
 * ecosystems instead of showing six flavours of one.
 */
const homeUseCases = useCases.slice(0, 6).map(useCase => ({ title: useCase.title, icon: useCase.icon, href: `/use-cases/${useCase.slug}` }))

const homeComparisons = comparisonGroups.flatMap(group => comparisonsInGroup(group.id).slice(0, 2)).map(comparison => ({ name: comparison.name, icon: comparison.icon, href: `/compare/${comparison.slug}` }))
</script>

<!DOCTYPE html>
<html lang="en">
  <head>
    @include('marketing-head')
    <link rel="stylesheet" href="/assets/styles/home.css">
  </head>
  <body data-site-mode="{{ siteMode }}" data-coming-soon-bypass-enabled="{{ comingSoonBypassEnabled }}" data-coming-soon-bypass="{{ comingSoonBypassToken }}">
    <section class="mode-screen" aria-labelledby="coming-soon-heading">
      <div class="mode-card">
        <span class="mode-glow" aria-hidden="true"></span>
        <div class="mode-content">
          <h1 id="coming-soon-heading" class="mode-title">{{ appName }}</h1>
          <p class="mode-lead">The trailhead is almost ready.</p>
          <p class="mode-copy">
            We are clearing the last stretch: framework, docs, CMS, and the deploy path. Leave your email and we will let you know the moment the trail opens.
          </p>
          <form class="mode-subscribe" action="/api/email/subscribe" method="POST">
            <input type="email" name="email" placeholder="you@example.com" autocomplete="email" aria-label="Email address" required>
            <button class="button primary" type="submit">Notify me</button>
          </form>
          <div class="mode-meta">
            <a class="mode-textlink" href="/blog/introducing-stacks" data-no-router>Read “Introducing Stacks”</a>
            <span class="mode-social">
              <a href="https://bsky.app/profile/stacksjs.com" target="_blank" rel="noopener" aria-label="Stacks on Bluesky">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.038.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.789.624-6.478 0-.69-.139-1.861-.902-2.206-.658-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z"/></svg>
              </a>
              <a href="https://github.com/stacksjs" target="_blank" rel="noopener" aria-label="Stacks on GitHub">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
              </a>
            </span>
          </div>
        </div>
      </div>
    </section>

    <div class="site-content">
      @include('marketing-nav')

      <main class="home">
        <section class="home-hero site-shell" aria-labelledby="hero-heading">
          <div class="home-hero-copy">
            <a class="home-badge" href="/blog/introducing-stacks" data-no-router>
              <span class="home-badge-tag">New</span>
              Introducing Stacks
              <i class="i-hugeicons-arrow-right-01" aria-hidden="true"></i>
            </a>
            <h1 id="hero-heading" class="home-title">The whole stack, <span>one framework.</span></h1>
            <p class="home-lede">
              Models, auth, CMS, commerce, AI, queues, and cloud deploys, in one typed codebase that ships to web, desktop, and mobile.
            </p>
            <div class="home-actions">
              <a class="button primary" href="#start">Get started<i class="i-hugeicons-arrow-right-01" aria-hidden="true"></i></a>
              <a class="button" href="/docs" data-no-router>Read the docs</a>
            </div>
          </div>

          <div class="home-hero-visual">
            <div class="home-code" role="group" aria-label="Real Stacks files, one per layer">
              @foreach (heroTabs as tab)
                <input class="home-tab-input" type="radio" name="hero-tab" id="{{ tab.id }}" {{ tab.checked }}>
              @endforeach

              <div class="home-code-bar">
                <span class="home-code-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                <div class="home-tabs">
                  @foreach (heroTabs as tab)
                    <label class="home-tab" for="{{ tab.id }}">{{ tab.label }}</label>
                  @endforeach
                </div>
              </div>

              <div class="home-code-panes">
                @foreach (heroTabs as tab)
                  <div class="home-code-pane">
                    <span class="home-code-file"><i class="i-hugeicons-source-code-square" aria-hidden="true"></i>{{ tab.file }}</span>
                    <pre><code>{!! tab.html !!}</code></pre>
                  </div>
                @endforeach
              </div>

              <div class="home-code-foot"><span class="home-prompt">$</span> buddy dev <span class="home-ok">ready</span> <span class="home-dim">web, api, docs, dashboard on stacks.localhost</span></div>
            </div>
          </div>
        </section>

        <section class="home-stats site-shell" aria-label="What ships in the box">
          @foreach (stats as stat)
            <div class="home-stat">
              <strong>{{ stat.value }}</strong>
              <span>{{ stat.label }}</span>
            </div>
          @endforeach
        </section>

        <section id="platform" class="home-section site-shell" aria-labelledby="platform-heading">
          <div class="home-head rise">
            <h2 id="platform-heading" class="home-h2">Everything a product needs, in one install.</h2>
            <p class="home-sub">Each system is first-party and shares the same types, config, and tooling. No glue code, no plugin roulette.</p>
          </div>

          <div class="bento">
            @foreach (bentoCells as cell)
              <a class="{{ cell.className }} rise" style="{{ cell.style }}" href="{{ cell.href }}">
                <span class="bento-icon" aria-hidden="true"><i class="{{ cell.icon }}"></i></span>
                <h3>{{ cell.title }}</h3>
                <p>{{ cell.blurb }}</p>

                @if (cell.visual === 'code')
                  <span class="bento-code" aria-hidden="true">
                    <span class="bento-code-file">{{ cell.codeFile }}</span>
                    <pre><code>{!! cell.codeHtml !!}</code></pre>
                  </span>
                @endif

                @if (cell.visual === 'capabilities')
                  <span class="bento-caps" aria-hidden="true">
                    @foreach (cell.capabilities as capability)
                      <span><i class="i-hugeicons-tick-02"></i>{{ capability }}</span>
                    @endforeach
                  </span>
                @endif

                @if (cell.visual === 'targets')
                  <span class="bento-targets" aria-hidden="true">
                    @foreach (buildTargets as target)
                      <span class="bento-target"><i class="{{ target.icon }}"></i>{{ target.name }}</span>
                    @endforeach
                  </span>
                @endif

                @if (cell.visual === 'providers')
                  <span class="bento-providers" aria-hidden="true">
                    @foreach (aiProviders as provider)
                      <span class="bento-provider">{{ provider }}</span>
                    @endforeach
                    @foreach (aiExtras as extra)
                      <span class="bento-provider bento-provider--soft">{{ extra }}</span>
                    @endforeach
                  </span>
                @endif

                @if (cell.visual === 'content')
                  <span class="bento-content" aria-hidden="true">
                    @foreach (contentTypes as type)
                      <span>{{ type }}</span>
                    @endforeach
                  </span>
                @endif

                @if (cell.visual === 'deploy')
                  <span class="bento-deploy" aria-hidden="true">
                    @foreach (deployLines as line)
                      <span><i class="i-hugeicons-tick-02"></i>{{ line.name }}<em>{{ line.note }}</em></span>
                    @endforeach
                  </span>
                @endif

                <span class="bento-foot">
                  <code>$ {{ cell.command }}</code>
                  <i class="i-hugeicons-arrow-up-right-01" aria-hidden="true"></i>
                </span>
              </a>
            @endforeach
          </div>
        </section>

        <section id="builds" class="home-section site-shell" aria-labelledby="builds-heading">
          <div class="builds rise">
            <div class="builds-source">
              <h2 id="builds-heading" class="home-h2">Write the UI once. Ship it five ways.</h2>
              <p class="home-sub">The STX views, components, and routes you wrote for the web are the app. Craft wraps that same UI in a desktop window, a system tray, or a native iOS and Android shell.</p>
              <div class="builds-files" aria-hidden="true">
                <span><i class="i-hugeicons-folder-01"></i>resources/views/</span>
                <span><i class="i-hugeicons-folder-01"></i>resources/components/</span>
                <span><i class="i-hugeicons-file-01"></i>config/mobile.ts</span>
              </div>
              <a class="button" href="/features/native-apps">How native builds work</a>
            </div>

            <ul class="builds-targets" aria-label="Build targets">
              @foreach (buildTargets as target)
                <li class="builds-target">
                  <span class="builds-target-icon" aria-hidden="true"><i class="{{ target.icon }}"></i></span>
                  <span class="builds-target-text">
                    <strong>{{ target.name }}</strong>
                    <span>{{ target.note }}</span>
                  </span>
                  <code>{{ target.command }}</code>
                </li>
              @endforeach
            </ul>
          </div>
        </section>

        <section class="home-section site-shell" aria-labelledby="tail-heading">
          <div class="rise tail">
            <div>
              <h2 id="tail-heading" class="home-h2">And the long tail, already in the box.</h2>
              <p class="home-sub">The packages most apps end up hunting for one at a time, on the same config and types as everything above. Whole bundles install or uninstall with one command, so what you do not use is not loaded.</p>
              <div class="tail-command"><span class="home-prompt">$</span> buddy commerce:uninstall</div>
            </div>
            <ul class="tail-list">
              @foreach (longTail as item)
                <li><i class="{{ item.icon }}" aria-hidden="true"></i>{{ item.label }}</li>
              @endforeach
            </ul>
          </div>
        </section>

        <section id="start" class="home-section site-shell" aria-labelledby="start-heading">
          <div class="home-head home-head--center rise">
            <h2 id="start-heading" class="home-h2">From an empty folder to production.</h2>
            <p class="home-sub">Pantry installs the toolchain, Buddy does the rest. Four commands, and the last one is a deploy.</p>
          </div>

          <ol class="start">
            @foreach (startSteps as step)
              <li class="start-step rise">
                <span class="start-icon" aria-hidden="true"><i class="{{ step.icon }}"></i></span>
                <h3>{{ step.title }}</h3>
                <p>{{ step.text }}</p>
                <code>{{ step.command }}</code>
              </li>
            @endforeach
          </ol>
        </section>

        <section id="dx" class="home-section site-shell" aria-labelledby="dx-heading">
          <div class="dx rise">
            <div class="dx-copy">
              <span class="kicker">Developer and agent experience</span>
              <h2 id="dx-heading" class="home-h2">Written for you. Legible to the agent next to you.</h2>
              <p class="home-sub">buddy setup:ai turns one checked-in AGENTS.md into the files Claude Code, Codex, Cursor, Copilot, and Gemini each read, so every agent works from the same source.</p>

              <ul class="dx-list">
                @foreach (dxCapabilities as capability)
                  <li>
                    <i class="{{ capability.icon }}" aria-hidden="true"></i>
                    <span><strong>{{ capability.title }}</strong>{{ capability.text }}</span>
                  </li>
                @endforeach
              </ul>

              <div class="home-actions">
                <a class="button primary" href="https://github.com/stacksjs/stacks/blob/main/AGENTS.md">Read AGENTS.md</a>
                <a class="button" href="https://github.com/stacksjs/stacks/tree/main/storage/framework/defaults/ai/skills">Browse the skills</a>
              </div>
            </div>

            <div class="dx-tree" aria-label="What buddy setup:ai generates">
              <div class="dx-tree-bar"><span class="home-prompt">$</span> buddy setup:ai</div>
              <ul>
                @foreach (agentTree as node)
                  <li class="dx-node dx-node--d{{ node.depth }} {{ node.source ? 'dx-node--source' : '' }}">
                    <i class="{{ node.icon }}" aria-hidden="true"></i>
                    <span>{{ node.name }}</span>
                    <em>{{ node.note }}</em>
                  </li>
                @endforeach
              </ul>
              <div class="dx-tree-foot"><span class="home-prompt">$</span> buddy lint &amp;&amp; buddy typecheck <span class="home-ok">0 errors</span></div>
            </div>
          </div>
        </section>

        <section id="deploy" class="home-section site-shell" aria-labelledby="deploy-heading">
          <div class="rise ship">
            <div class="ship-copy">
              <h2 id="deploy-heading" class="home-h2">One command to production.</h2>
              <p class="home-sub">buddy deploy builds the site, docs, blog, and API, then publishes DNS, TLS, storage, and mail from config/cloud.ts, to servers you own. A bad release rolls back with one command.</p>
              <div class="ship-command"><span class="home-prompt">$</span> buddy deploy</div>
              <ul class="ship-targets" aria-label="Deploy targets">
                @foreach (deployTargets as target)
                  <li><i class="{{ target.icon }}" aria-hidden="true"></i>{{ target.label }}</li>
                @endforeach
              </ul>
            </div>
            <ol class="ship-steps">
              @foreach (deploySurfaces as surface)
                <li>
                  <i class="i-hugeicons-checkmark-circle-02" aria-hidden="true"></i>
                  <strong>{{ surface.name }}</strong>
                  <span>{{ surface.detail }}</span>
                </li>
              @endforeach
            </ol>
          </div>
        </section>

        <section id="paths" class="home-section site-shell" aria-labelledby="paths-heading">
          <div class="home-head rise">
            <h2 id="paths-heading" class="home-h2">Two ways to size it up.</h2>
            <p class="home-sub">What people build with it, and how it lines up against what you use today.</p>
          </div>

          <div class="paths">
            <article class="path rise">
              <span class="path-icon" aria-hidden="true"><i class="i-hugeicons-layers-02"></i></span>
              <h3>Same install, {{ useCases.length }} shapes of project.</h3>
              <p>SaaS, storefronts, content sites, APIs, internal tools, and native apps. Not editions or plans: one framework pointed at a different problem.</p>
              <div class="path-chips">
                @foreach (homeUseCases as useCase)
                  <a class="path-chip" href="{{ useCase.href }}"><i class="{{ useCase.icon }}" aria-hidden="true"></i>{{ useCase.title }}</a>
                @endforeach
              </div>
              <a class="path-link" href="/use-cases">All {{ useCases.length }} use cases<i class="i-hugeicons-arrow-right-01" aria-hidden="true"></i></a>
            </article>

            <article class="path rise">
              <span class="path-icon" aria-hidden="true"><i class="i-hugeicons-chart-bar-line"></i></span>
              <h3>{{ comparisons.length }} honest comparisons.</h3>
              <p>Each one says where the other framework is the better choice before it says where this one is, and compares what ships in the box.</p>
              <div class="path-chips">
                @foreach (homeComparisons as comparison)
                  <a class="path-chip" href="{{ comparison.href }}"><i class="{{ comparison.icon }}" aria-hidden="true"></i>vs {{ comparison.name }}</a>
                @endforeach
              </div>
              <a class="path-link" href="/compare">See the comparison table<i class="i-hugeicons-arrow-right-01" aria-hidden="true"></i></a>
            </article>
          </div>
        </section>

        <section class="home-section home-section--last site-shell" aria-labelledby="cta-heading">
          <div class="cta rise">
            <img class="cta-mark" src="/images/logos/favicon.svg" alt="" width="64" height="64" loading="lazy" decoding="async">
            <h2 id="cta-heading" class="home-h2">Start building.</h2>
            <p class="home-sub">Free and open source under the MIT license.</p>
            <div class="cta-command"><span class="home-prompt">$</span> <span class="cta-command-text">panx &#64;stacksjs/buddy new my-app</span></div>
            <div class="home-actions">
              <a class="button primary" href="/docs" data-no-router>Read the docs</a>
              <a class="button" href="https://github.com/stacksjs/stacks"><i class="i-hugeicons-github" aria-hidden="true"></i>Star on GitHub</a>
            </div>

            <form class="cta-form" action="/api/email/subscribe" method="POST">
              <label for="cta-email">Release notes, occasionally. No noise.</label>
              <div class="cta-form-row">
                <input id="cta-email" type="email" name="email" placeholder="you@example.com" autocomplete="email" required>
                <button class="button" type="submit">Subscribe</button>
              </div>
            </form>
          </div>
        </section>
      </main>

      @include('marketing-footer')
    </div>

    @include('marketing-theme-toggle')
    <script src="/assets/scripts/site-mode.js" defer></script>
  </body>
</html>
