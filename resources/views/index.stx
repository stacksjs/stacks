<script server>
import { comparisonGroups, comparisons, comparisonsInGroup } from '../data/comparisons'
import { features } from '../data/features'
import { useCases } from '../data/use-cases'

const appName = 'Stacks'

/*
 * Launched. Two gates gated this page and both had to open:
 *
 *   APP_COMING_SOON in .env.production   the server gate, which 302'd / to
 *                                        /coming-soon before this file ran
 *   siteMode here                        the in-page gate, which hides
 *                                        .site-content and shows .mode-screen
 *
 * Flipping only the env var would have served this page with its own holding
 * card over it. Set siteMode back to 'coming-soon' to close it again; the
 * bypass token below is what /?preview= expects while it is closed.
 */
const siteMode = 'live'
const comingSoonBypassEnabled = true
const comingSoonBypassToken = 'trailhead'

const siteUrl = 'https://stacksjs.com'

// Read by the shared marketing-head partial.
const pageTitle = 'Stacks - Full-stack TypeScript framework'
const canonicalPath = '/'
const siteDescription = 'Stacks is a full-stack TypeScript framework. One UI ships to web, desktop, and mobile, with CMS, commerce, AI, auth, queues, and cloud deployment built in.'

// Structured data. Built as a string here so the @-prefixed schema.org keys
// (@context, @type) never reach the stx directive scanner; emitted raw in the
// head with {!! jsonLd !!}.
const pageDescription = siteDescription

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#org`,
      name: appName,
      url: `${siteUrl}/`,
      logo: `${siteUrl}/images/logos/logo.png`,
      sameAs: ['https://github.com/stacksjs/stacks'],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: appName,
      url: `${siteUrl}/`,
      publisher: { '@id': `${siteUrl}/#org` },
    },
    {
      '@type': 'SoftwareApplication',
      name: appName,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Cross-platform',
      description: siteDescription,
      url: `${siteUrl}/`,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
  ],
})

// Platform bento. The eight cells ARE the eight features: same titles, same
// blurbs, same order as the mega menu and the /features pages, because all
// four read resources/data/features.ts. This used to be a second hardcoded
// list, which is how a bento ends up describing a feature the nav does not
// offer.
// The circle above each step used to render `step.label`, which no step ever
// had, so all three came out as empty badges. A glyph says what the step is;
// a number would only have said where it sits in a list you can already count.
const workflowSteps = [
  { icon: 'i-hugeicons-magic-wand-01', title: 'Scaffold', text: 'buddy make:model Post generates the model, migration, factory, and REST actions in one pass.' },
  { icon: 'i-hugeicons-computer-terminal-01', title: 'Build', text: 'buddy dev serves the app, docs, blog, and dashboard locally with hot reload and typed routes.' },
  { icon: 'i-hugeicons-rocket-01', title: 'Ship', text: 'buddy deploy builds every surface and publishes the AWS infrastructure from the same config.' },
]

const startSteps = [
  { title: 'Install Pantry', text: 'One installer provisions Bun, Git, SQLite, and every tool a Stacks project declares.' },
  { title: 'Create a project', text: 'panx runs Buddy in an isolated environment and sets up the generated project’s toolchain.' },
  { title: 'Start building', text: 'buddy dev serves the frontend, API, and dashboard together, with hot reload.' },
]

const buildTargets = ['Web', 'macOS desktop', 'System tray', 'iOS', 'Android']

const dxCapabilities = [
  { title: 'AGENTS.md, checked in', text: 'The one file a coding agent reads first, versioned with the code it describes instead of living in someone’s head.' },
  { title: '140-plus dedicated skills', text: 'One per subsystem, from auth to deploys, so an agent reaches for the real API instead of guessing one.' },
  { title: 'Typed the whole way down', text: 'A model, its migration, its API, and its view are typed against each other, so a rename is either everywhere or it does not compile.' },
  { title: 'One CLI, one way', text: 'buddy lint, buddy typecheck, buddy test: the same commands an agent runs are the ones that gate a human’s pull request.' },
]

/*
 * The two hubs the nav opens as mega menus, given a landing on the page
 * itself: someone who scrolls rather than hovers should still meet them.
 *
 * Both samples are derived rather than listed, so neither can name a page
 * that stopped existing. The comparisons take the first two of each group
 * so the sample spans full-stack JS, TypeScript backends, and the other
 * ecosystems instead of showing six flavours of one.
 */
const homeUseCases = useCases.slice(0, 6)

const homeComparisons = comparisonGroups.flatMap(group => comparisonsInGroup(group.id).slice(0, 2))

const cmsResources = [
  { title: 'Posts', text: 'Markdown body, excerpt, author, tags, and a generated API.' },
  { title: 'Pages', text: 'Structured content with stable slugs and dashboard editing.' },
  { title: 'Taxonomy', text: 'Tags, categories, and editorial filters that stay searchable.' },
  { title: 'Media', text: 'First-party storage hooks for images, attachments, and assets.' },
  { title: 'Custom resources', text: 'Model-backed resources with generated endpoints and screens.' },
  { title: 'Docs and blog', text: 'BunPress docs at /docs, Markdown blog with RSS at /blog.' },
]

const deployRoutes = [
  { label: 'Marketing', url: 'stacksjs.com' },
  { label: 'Docs', url: 'stacksjs.com/docs' },
  { label: 'Blog', url: 'stacksjs.com/blog' },
  { label: 'API', url: 'stacksjs.com/api' },
  { label: 'Dashboard', url: 'stacksjs.com/dashboard' },
]
</script>

<!DOCTYPE html>
<html lang="en">
  <head>
    @include('marketing-head')
  </head>
  <body data-site-mode="{{ siteMode }}" data-coming-soon-bypass-enabled="{{ comingSoonBypassEnabled }}" data-coming-soon-bypass="{{ comingSoonBypassToken }}">
    <section class="mode-screen" aria-labelledby="coming-soon-heading">
      <div class="mode-card">
        <span class="mode-glow" aria-hidden="true"></span>
        <div class="mode-content">
          <h1 id="coming-soon-heading" class="mode-title">{{ appName }}</h1>
          <p class="mode-lead">The trailhead is almost ready.</p>
          <p class="mode-copy">
            We are clearing the last stretch: framework, docs, CMS, and the deploy path. Leave your email and we will let you know the moment the trail opens.
          </p>
          <form class="mode-subscribe" action="/api/email/subscribe" method="POST">
            <input type="email" name="email" placeholder="you@example.com" autocomplete="email" aria-label="Email address" required>
            <button class="button primary" type="submit">Notify me</button>
          </form>
          <div class="mode-meta">
            <a class="mode-textlink" href="/blog/introducing-stacks" data-no-router>Read “Introducing Stacks”</a>
            <span class="mode-social">
              <a href="https://bsky.app/profile/stacksjs.com" target="_blank" rel="noopener" aria-label="Stacks on Bluesky">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.038.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.789.624-6.478 0-.69-.139-1.861-.902-2.206-.658-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z"/></svg>
              </a>
              <a href="https://github.com/stacksjs" target="_blank" rel="noopener" aria-label="Stacks on GitHub">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
              </a>
            </span>
          </div>
        </div>
      </div>
    </section>

    <div class="site-content">
      @include('marketing-nav')

      <main>
        <section class="hero site-shell">
          <div class="hero-animate">
            <span class="kicker">Full-stack TypeScript framework</span>
            <h1 class="hero-title">The whole stack, <em>one framework.</em></h1>
            <p class="hero-copy">
              Routing, views, models, auth, CMS, commerce, AI, and cloud deploys. The same UI ships to web, desktop, and mobile, first-party and fully typed throughout.
            </p>
            <div class="hero-actions">
              <a class="button primary" href="#start">Get started</a>
              <a class="button" href="#platform">Explore features</a>
            </div>
          </div>

          <aside class="product-preview" aria-label="Define a model in Stacks">
            <div class="code-window">
              <div class="code-titlebar">
                <span class="code-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="code-file">app/Models/Post.ts</span>
              </div>
              <pre class="code-body"><code><span class="tok-key">import</span> { defineModel } <span class="tok-key">from</span> <span class="tok-str">'&#64;stacksjs/orm'</span>

<span class="tok-key">export default</span> <span class="tok-fn">defineModel</span>({
  <span class="tok-prop">name</span>: <span class="tok-str">'Post'</span>,
  <span class="tok-prop">traits</span>: {
    <span class="tok-prop">useUuid</span>: <span class="tok-bool">true</span>,
    <span class="tok-prop">useTimestamps</span>: <span class="tok-bool">true</span>,
    <span class="tok-prop">useApi</span>: { <span class="tok-prop">uri</span>: <span class="tok-str">'posts'</span> },     <span class="tok-com">// REST routes + actions</span>
    <span class="tok-prop">useSearch</span>: { <span class="tok-prop">searchable</span>: [<span class="tok-str">'title'</span>] },
  },
  <span class="tok-prop">attributes</span>: {
    <span class="tok-prop">title</span>: { <span class="tok-prop">fillable</span>: <span class="tok-bool">true</span>, <span class="tok-prop">required</span>: <span class="tok-bool">true</span> },
    <span class="tok-prop">status</span>: { <span class="tok-prop">default</span>: <span class="tok-str">'draft'</span> },
  },
})</code></pre>
            </div>
            <div class="terminal-strip">$ buddy migrate      <span class="term-com"># models to migrations, applied</span>
$ buddy deploy       <span class="term-com"># web, docs, blog, API, cloud</span></div>
          </aside>
        </section>

        <section id="start" class="section site-shell" aria-labelledby="start-heading">
          <div class="rise start-panel">
            <div class="section-head" style="margin-bottom: 0">
              <h2 id="start-heading" class="section-title">Running in a few minutes.</h2>
              <p class="section-copy">Pantry provisions Bun, SQLite, and everything else the project declares. Install it once, then Buddy takes over.</p>
              <ol class="start-steps">
                @foreach (startSteps as step)
                  <li><strong>{{ step.title }}</strong><span>{{ step.text }}</span></li>
                @endforeach
              </ol>
              <div class="hero-actions">
                <a class="button primary" href="/docs" data-no-router>Read the docs</a>
                <a class="button" href="https://github.com/stacksjs/stacks">Source on GitHub</a>
              </div>
            </div>
            <div class="deploy-terminal">$ curl -fsSL https://pantry.dev | bash
<span class="term-ok">✓</span> pantry installed
$ panx &#64;stacksjs/buddy new my-project
<span class="term-ok">✓</span> project scaffolded
$ cd my-project &amp;&amp; buddy dev
<span class="term-ok">✓</span> web · api · dashboard  <span class="term-dim">hot reload on</span></div>
          </div>
        </section>

        <section id="platform" class="section site-shell" aria-labelledby="platform-heading">
          <div class="rise section-head">
            <h2 id="platform-heading" class="section-title">One install, every layer.</h2>
            <p class="section-copy">Each system is first-party and shares the same types, config, and tooling. No glue code, no plugin roulette.</p>
          </div>
          <div class="bento">
            @foreach (features as cell)
              <a class="cell rise {{ cell.span === 'wide' ? 'cell--wide' : '' }} {{ cell.span === 'tall' ? 'cell--tall' : '' }} {{ cell.tone === 'tint' ? 'cell--tint' : '' }} {{ cell.tone === 'gradient' ? 'cell--gradient' : '' }}" href="/features/{{ cell.slug }}">
                @if (cell.image)
                  <span class="cell-art" aria-hidden="true"><img src="{{ cell.image }}" alt="" width="240" height="240" loading="lazy" decoding="async"></span>
                @endif
                <span class="cell-icon" aria-hidden="true"><i class="{{ cell.icon }}"></i></span>
                <h3>{{ cell.title }}</h3>
                <p>{{ cell.blurb }}</p>
                <span class="cell-more">Read more<i class="i-hugeicons-arrow-right-01" aria-hidden="true"></i></span>
              </a>
            @endforeach
          </div>
        </section>

        <section id="paths" class="section site-shell" aria-labelledby="paths-heading">
          <div class="rise section-head">
            <h2 id="paths-heading" class="section-title">Two ways to size it up.</h2>
            <p class="section-copy">What people build with it, and how it lines up against whatever you are using today.</p>
          </div>

          <div class="paths">
            <article class="path-card rise">
              <span class="kicker">Use cases</span>
              <h3>Same install, {{ useCases.length }} shapes of project.</h3>
              <p>SaaS, storefronts, content sites, APIs, internal tools, native apps. Not editions or plans: the same framework pointed at a different problem, with the layers each one leans on spelled out.</p>

              <div class="stack-strip">
                @foreach (homeUseCases as useCase)
                  <a class="stack-chip" href="/use-cases/{{ useCase.slug }}">
                    <i class="{{ useCase.icon }}" aria-hidden="true"></i>
                    {{ useCase.title }}
                  </a>
                @endforeach
              </div>

              <a class="button primary" href="/use-cases">All {{ useCases.length }} use cases</a>
            </article>

            <article class="path-card rise">
              <span class="kicker">Compare</span>
              <h3>{{ comparisons.length }} honest comparisons.</h3>
              <p>Every one says where the other framework is the better choice before it says where this one is, and the table is about what ships in the box rather than which is faster.</p>

              <div class="stack-strip">
                @foreach (homeComparisons as comparison)
                  <a class="stack-chip" href="/compare/{{ comparison.slug }}">
                    <i class="{{ comparison.icon }}" aria-hidden="true"></i>
                    vs {{ comparison.name }}
                  </a>
                @endforeach
              </div>

              <a class="button primary" href="/compare">See the comparison table</a>
            </article>
          </div>
        </section>

        <section id="builds" class="section site-shell" aria-labelledby="builds-heading">
          <div class="rise builds-panel">
            <div class="section-head" style="margin-bottom: 0">
              <h2 id="builds-heading" class="section-title">One UI. Web, desktop, and mobile.</h2>
              <p class="section-copy">The STX views, components, and routes already written for the web are the application. Craft wraps that same UI in a desktop window with a system tray, or a native iOS and Android shell, so a feature built once ships everywhere.</p>
              <div class="route-chips" aria-label="Build targets">
                @foreach (buildTargets as target)
                  <span class="chip">{{ target }}</span>
                @endforeach
              </div>
            </div>
            <div class="deploy-terminal">$ buddy dev:desktop
<span class="term-ok">✓</span> Craft window   <span class="term-dim">dashboard, hot reload</span>
$ buddy build:ios
<span class="term-ok">✓</span> Xcode project  <span class="term-dim">config/mobile.ts</span>
$ buddy build:android
<span class="term-ok">✓</span> Gradle project <span class="term-dim">config/mobile.ts</span></div>
          </div>
        </section>

        <section class="section site-shell" aria-labelledby="workflow-heading">
          <div class="rise section-head">
            <h2 id="workflow-heading" class="section-title">From first commit to production.</h2>
            <p class="section-copy">Buddy is the command center. It scaffolds, serves, tests, builds, and deploys the whole project.</p>
          </div>
          <div class="steps">
            @foreach (workflowSteps as step)
              <div class="rise step">
                <em aria-hidden="true"><i class="{{ step.icon }}"></i></em>
                <h3>{{ step.title }}</h3>
                <p>{{ step.text }}</p>
              </div>
            @endforeach
          </div>
        </section>

        <section id="dx" class="section site-shell" aria-labelledby="dx-heading">
          <div class="rise dx-panel">
            <div>
              <span class="kicker">Developer experience, agent experience</span>
              <h2 id="dx-heading" class="section-title">Written for you. Legible to the agent next to you.</h2>
              <p class="section-copy">AGENTS.md is the one file a coding agent already knows how to read, checked into the repo like everything else. buddy setup:ai generates CLAUDE.md, .claude/skills/, and .cursor/rules/ from it, so Claude Code, Codex, and Cursor all work from the same source instead of three drifting sets of instructions.</p>

              <div class="resource-grid">
                @foreach (dxCapabilities as capability)
                  <div class="resource"><strong>{{ capability.title }}</strong><span>{{ capability.text }}</span></div>
                @endforeach
              </div>

              <div class="hero-actions">
                <a class="button primary" href="https://github.com/stacksjs/stacks/blob/main/AGENTS.md">Read AGENTS.md</a>
                <a class="button" href="https://github.com/stacksjs/stacks/tree/main/storage/framework/defaults/ai/skills">Browse the skills</a>
              </div>
            </div>
            <div class="deploy-terminal">$ buddy setup:ai
<span class="term-ok">✓</span> CLAUDE.md generated
<span class="term-ok">✓</span> skills written to .claude/skills/
$ buddy lint &amp;&amp; buddy typecheck
<span class="term-ok">✓</span> 0 errors  <span class="term-dim">· 0 warnings</span></div>
          </div>
        </section>

        <!--
          The horizon. Full bleed on purpose: it is the one place the page
          stops being panels on paper, and it breaks a run of six white
          sections in half.

          The scene is the same dawn illustration the holding page and the
          error pages use (Laravel 5.7's, recolored to the Stacks sunset), so
          the marketing page, /coming-soon and a 404 all read as one product
          rather than three unrelated designs.
        -->
        <section class="horizon" aria-labelledby="horizon-heading">
          <div class="horizon-scene" aria-hidden="true"><span class="horizon-sun"></span></div>
          <div class="site-shell">
            <div class="horizon-copy">
              <h2 id="horizon-heading" class="section-title">One repo, all the way to the edge.</h2>
              <p class="section-copy">The site, the docs, the blog, the API, the queues, and the infrastructure they run on. Same config, same types, same deploy.</p>
            </div>
          </div>
        </section>

        <section id="cms" class="section site-shell" aria-labelledby="cms-heading">
          <div class="cms-panel rise">
            <div class="section-head" style="margin-bottom: 0">
              <h2 id="cms-heading" class="section-title">A CMS your editors will actually use.</h2>
              <p class="section-copy">Markdown for developers, a real dashboard for editors. Content ships with generated APIs, so the site, docs, and blog stay in the same repo.</p>
            </div>
            <div class="resource-grid">
              @foreach (cmsResources as resource)
                <div class="resource"><strong>{{ resource.title }}</strong><span>{{ resource.text }}</span></div>
              @endforeach
            </div>
          </div>
        </section>

        <section id="deploy" class="section site-shell" aria-labelledby="deploy-heading">
          <div class="deploy-panel rise">
            <div class="section-head" style="margin-bottom: 0">
              <h2 id="deploy-heading" class="section-title">One command to production.</h2>
              <p class="section-copy"><code>buddy deploy</code> builds the site, docs, blog, and API, then publishes DNS, CDN, storage, and mail from the same config.</p>
              <div class="route-chips" aria-label="Deployed surfaces">
                @foreach (deployRoutes as route)
                  <span class="chip">{{ route.url }}</span>
                @endforeach
              </div>
            </div>
            <div class="deploy-terminal">$ buddy deploy
<span class="term-ok">✓</span> web      <span class="term-dim">built and uploaded</span>
<span class="term-ok">✓</span> docs     <span class="term-dim">mounted at /docs</span>
<span class="term-ok">✓</span> blog     <span class="term-dim">feed and sitemap live</span>
<span class="term-ok">✓</span> cloud    <span class="term-dim">DNS, CDN, TLS, mail</span></div>
          </div>
        </section>

        <section class="section site-shell" aria-labelledby="signup-heading">
          <div class="rise signup-panel">
            <div class="section-head" style="margin-bottom: 0">
              <h2 id="signup-heading" class="section-title">Release notes, occasionally.</h2>
              <p class="section-copy">Framework updates and deployment notes by email. No noise.</p>
            </div>
            <form action="/api/email/subscribe" method="POST">
              <input type="email" name="email" placeholder="you@example.com" autocomplete="email" aria-label="Email address" required>
              <button class="button primary" type="submit">Subscribe</button>
            </form>
          </div>
        </section>
      </main>

      @include('marketing-footer')
    </div>

    @include('marketing-theme-toggle')
    <script src="/assets/scripts/site-mode.js" defer></script>
  </body>
</html>
