<script server>
// The welcome email for stacksjs.com's launch list, sent by
// SubscriptionConfirmation (defaults/app/Mail) the moment someone signs up
// from the home page or the blog.
//
// Stacks has not launched, so this thanks them, says what Stacks is in one
// line, and says exactly what they signed up for: one launch-day email, early
// access, and the occasional note. Built on the shared <EmailLayout>, so it
// gets the light card, dark mode in clients that honour it, and the phone
// layout. Images are absolute: an email has no origin to resolve against.
const email = props.email || ''
const unsubscribeUrl = props.unsubscribeUrl || '#'
const appUrl = props.appUrl || 'https://stacksjs.com'
const year = props.year || new Date().getFullYear()

const blue = '#1747c9'
const navy = '#00296b'
const logoUrl = `${appUrl}/images/logos/logo.png`
const postUrl = `${appUrl}/blog/introducing-stacks`
const subject = 'You are on the Stacks list'
</script>

<EmailLayout title="{{ subject }}" preheader="Thanks for joining. One email the day Stacks opens up, and early access before that." accent="{{ blue }}">
  <template #header>
    <tr>
      <td style="padding:36px 40px 32px;background-color:{{ navy }};background-image:linear-gradient(145deg,{{ blue }},{{ navy }});text-align:left;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
          <tr>
            <td style="vertical-align:middle;padding-right:12px;">
              <a href="{{ appUrl }}"><img src="{{ logoUrl }}" width="40" height="40" alt="Stacks" style="display:block;border:1px solid rgba(255,255,255,0.28);border-radius:10px;"></a>
            </td>
            <td style="vertical-align:middle;">
              <a href="{{ appUrl }}" style="color:#ffffff;font-size:20px;font-weight:700;letter-spacing:-0.02em;text-decoration:none;">Stacks</a>
            </td>
          </tr>
        </table>
        <p style="margin:28px 0 0;color:#ffffff;font-size:26px;line-height:1.2;font-weight:700;letter-spacing:-0.02em;">Thanks for joining the launch list.</p>
        <p style="margin:10px 0 0;color:#c9d6f2;font-size:15px;line-height:1.55;">You will be among the first to try it.</p>
      </td>
    </tr>
  </template>

  <EmailText>Hi there,</EmailText>
  <EmailText>Thank you for signing up. We have spent five years building Stacks, the all-in-one TypeScript framework: routing, models, auth, a CMS, commerce, queues, mail, an admin dashboard and cloud deploys in one install, with nothing to stitch together.</EmailText>
  <EmailText>It is not out yet. Here is what you signed up for:</EmailText>

  <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;margin:0 0 24px;">
    <tr>
      <td style="width:28px;vertical-align:top;padding:2px 0 12px;color:{{ blue }};font-size:15px;font-weight:700;">1</td>
      <td class="email-text" style="padding:0 0 12px;color:#3f3f46;font-size:15px;line-height:1.55;"><strong>One email the day Stacks opens up.</strong> No countdowns, no drip campaign.</td>
    </tr>
    <tr>
      <td style="width:28px;vertical-align:top;padding:2px 0 12px;color:{{ blue }};font-size:15px;font-weight:700;">2</td>
      <td class="email-text" style="padding:0 0 12px;color:#3f3f46;font-size:15px;line-height:1.55;"><strong>Early access</strong> before the public release.</td>
    </tr>
    <tr>
      <td style="width:28px;vertical-align:top;padding:2px 0 0;color:{{ blue }};font-size:15px;font-weight:700;">3</td>
      <td class="email-text" style="padding:0;color:#3f3f46;font-size:15px;line-height:1.55;"><strong>A short note from the build</strong>, now and then, when there is something worth telling.</td>
    </tr>
  </table>

  <EmailButton href="{{ postUrl }}" bg="{{ blue }}">Read "Introducing Stacks"</EmailButton>

  <EmailDivider />
  <EmailText size="sm" spacing="0">Want to watch it take shape? The source is already public on <a href="https://github.com/stacksjs/stacks" style="color:{{ blue }};text-decoration:underline;">GitHub</a>, and the docs are at <a href="{{ appUrl }}/docs" style="color:{{ blue }};text-decoration:underline;">stacksjs.com/docs</a>.</EmailText>

  <template #footer>
    <tr>
      <td class="email-muted" style="padding:20px 40px 24px;border-top:1px solid #e4e4e7;color:#71717a;font-size:12px;line-height:1.6;text-align:center;">
        You are getting this because {{ email }} joined the Stacks launch list at <a href="{{ appUrl }}" style="color:#71717a;">stacksjs.com</a>.<br>
        <a href="{{ unsubscribeUrl }}" style="color:#71717a;text-decoration:underline;">Unsubscribe</a> in one click. &copy; {{ year }} Stacks.
      </td>
    </tr>
  </template>
</EmailLayout>
