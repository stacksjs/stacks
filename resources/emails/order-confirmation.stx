<script server>
const appName = props.appName || 'Stacks'
const customerName = props.customerName || 'there'
const orderId = props.orderId || ''
const orderUrl = props.orderUrl || '#'
const itemRows = props.itemRows || ''
const subtotal = props.subtotal || 0
const shipping = props.shipping || 0
const total = props.total || 0
const shippingAddress = props.shippingAddress || ''
const year = new Date().getFullYear()

const money = (cents: number | string) => (Number(cents) / 100).toFixed(2)
</script>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>Your {{ appName }} order</title>
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #0e0e0e; line-height: 1.6; color: #d4d4d4;">
  <table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: collapse;">
    <tr>
      <td style="padding: 40px 20px;">
        <table role="presentation" cellpadding="0" cellspacing="0" style="max-width: 600px; margin: 0 auto;">

          <tr>
            <td style="text-align: center; padding-bottom: 32px;">
              <h1 style="color: #ececec; font-size: 28px; font-weight: 600; margin: 0;">{{ appName }}</h1>
            </td>
          </tr>

          <tr>
            <td style="background-color: #1a1a1a; border-radius: 12px; padding: 40px;">

              <h2 style="color: #ececec; font-size: 22px; font-weight: 600; margin: 0 0 16px;">Thanks, {{ customerName }}.</h2>

              <p style="color: #a0a0a0; font-size: 16px; margin: 0 0 24px;">
                Order #{{ orderId }} is confirmed. Here is what is on its way.
              </p>

              <table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: collapse; border-top: 1px solid #2a2a2a;">
                {!! itemRows !!}
              </table>

              <table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: collapse; border-top: 1px solid #2a2a2a; margin-top: 8px;">
                <tr>
                  <td style="padding: 12px 0 4px; color: #a0a0a0; font-size: 14px;">Subtotal</td>
                  <td style="padding: 12px 0 4px; color: #a0a0a0; font-size: 14px; text-align: right;">{{ money(subtotal) }}</td>
                </tr>
                <tr>
                  <td style="padding: 4px 0; color: #a0a0a0; font-size: 14px;">Shipping</td>
                  <td style="padding: 4px 0; color: #a0a0a0; font-size: 14px; text-align: right;">{{ money(shipping) }}</td>
                </tr>
                <tr>
                  <td style="padding: 12px 0 0; color: #ececec; font-size: 16px; font-weight: 600;">Total</td>
                  <td style="padding: 12px 0 0; color: #ececec; font-size: 16px; font-weight: 600; text-align: right;">{{ money(total) }}</td>
                </tr>
              </table>

              @if (shippingAddress)
                <p style="color: #a0a0a0; font-size: 14px; margin: 24px 0 0;">
                  Shipping to<br>
                  <span style="color: #d4d4d4;">{{ shippingAddress }}</span>
                </p>
              @endif

              <table role="presentation" cellpadding="0" cellspacing="0" style="margin: 32px 0 0;">
                <tr>
                  <td style="background-color: #c14a15; border-radius: 8px;">
                    <a href="{{ orderUrl }}" style="display: inline-block; padding: 12px 24px; color: #ffffff; font-size: 15px; font-weight: 600; text-decoration: none;">View your order</a>
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <tr>
            <td style="text-align: center; padding-top: 32px;">
              <p style="color: #6b6b6b; font-size: 13px; margin: 0;">&copy; {{ year }} {{ appName }}</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
