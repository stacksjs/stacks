{{-- The launch-list signup the blog pages share: the framework's
  <SubscribeForm>, which answers in place and posts to /api/email/subscribe.

  The page declares `subscribeSource` (who signed up from where, for the
  subscribers table), `subscribeReturn` (its own path plus `#subscribe`, for
  a post without JavaScript) and `subscribeOutcome` (the ?subscribe= the
  page was loaded with, from subscribeOutcomeFrom in resources/data/blog.ts). --}}
<script server>
declare const subscribeSource: string
declare const subscribeReturn: string
declare const subscribeOutcome: string
</script>

<SubscribeForm source="{{ subscribeSource }}" returnTo="{{ subscribeReturn }}" outcome="{{ subscribeOutcome }}" label="Get the launch email" buttonClass="button primary" successText="Thanks, you are on the list. A welcome email is on its way to your inbox." alreadyText="You are already on the list. We will write the day Stacks opens up." fine="One email when Stacks opens up, then a build note now and then. Unsubscribe in one click." />
