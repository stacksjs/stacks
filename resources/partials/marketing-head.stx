{{-- Shared <head> for every marketing page: the home page, /features, and
  each feature page.

  Partials inherit the including page's scope, so a page sets pageTitle,
  pageDescription and canonicalPath in its own <script server> and this reads
  them. Anything optional (jsonLd, ogImage) is guarded, so a page that has
  nothing to say about it simply does not declare it. --}}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="{{ pageDescription }}">
<title>{{ pageTitle }}</title>

<link rel="canonical" href="https://stacksjs.com{{ canonicalPath }}">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#fff7ec" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#1c1016" media="(prefers-color-scheme: dark)">
<link rel="icon" href="/images/logos/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/images/logos/logo.png">

{{-- Open Graph. Defining og:title here makes stx skip its default SEO
  injection, which would otherwise stamp placeholder "stx Project" tags. --}}
<meta property="og:type" content="website">
<meta property="og:site_name" content="Stacks">
<meta property="og:url" content="https://stacksjs.com{{ canonicalPath }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:image" content="https://stacksjs.com/images/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="600">
<meta property="og:image:alt" content="Stacks - develop modern apps, clouds, and framework-agnostic libraries, faster.">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@stacksjs">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDescription }}">
<meta name="twitter:image" content="https://stacksjs.com/images/og-image.png">

{{-- Brand type: Geist + Geist Mono. Preconnect so the hero paints fast. --}}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Geist+Mono:wght@400;500;600&display=swap">

@if (typeof jsonLd !== 'undefined' && jsonLd)
  <script type="application/ld+json">{!! jsonLd !!}</script>
@endif
<script>
  /*
   * Theme, applied before first paint so the page never flashes the wrong
   * one. Shares its storage key with the blog (see blogChrome() in
   * core/actions/src/blog.ts), so a choice made here follows the reader to
   * /blog and back.
   *
   * Precedence: ?theme= override, then a saved choice, then the operating
   * system preference. Only a visitor who has never chosen gets the OS
   * answer, which is what `prefers-color-scheme` is for.
   */
  /*
   * `window.stxTheme` is installed here and called from the theme toggle in the
   * markup, so it has to be declared for the checker to know the property
   * exists on `Window` - `stx typecheck` reported it as TS2339 in every file
   * that includes this partial.
   */
  declare global {
    interface Window {
      stxTheme?: (next: string) => void
    }
  }

  ;(function () {
    var modes = ['colored', 'light', 'dark']
    var ok = function (t: string) { return modes.indexOf(t) !== -1 }

    var queryTheme = ''
    try { queryTheme = new URLSearchParams(location.search).get('theme') || '' }
    catch {}

    var savedTheme = ''
    try { savedTheme = localStorage.getItem('stacks-theme') || localStorage.getItem('stacks-blog-theme') || '' }
    catch {}

    var prefersDark = false
    try { prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches }
    catch {}

    var theme = ok(queryTheme) ? queryTheme : (ok(savedTheme) ? savedTheme : (prefersDark ? 'dark' : 'light'))
    document.documentElement.setAttribute('data-theme', theme)

    window.stxTheme = function (next: string) {
      if (!ok(next)) return
      try { localStorage.setItem('stacks-theme', next) }
      catch {}
      document.documentElement.setAttribute('data-theme', next)
      var group = document.querySelector('.theme-toggle')
      if (group) {
        group.querySelectorAll('button').forEach(function (b) {
          b.setAttribute('aria-pressed', String(b.getAttribute('data-t') === next))
        })
      }
    }
  })()
</script>
{{-- theme.css first: marketing.css builds on its tokens and primitives, and
  the holding page links theme.css on its own. --}}
<link rel="stylesheet" href="/assets/styles/theme.css">
<link rel="stylesheet" href="/assets/styles/marketing.css">
