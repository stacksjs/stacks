{{-- Shared <head> for every marketing page: the home page, /features, and
  each feature page.

  Partials inherit the including page's scope, so a page sets pageTitle,
  pageDescription and canonicalPath in its own server script and this reads
  them. Anything optional (jsonLd, pageStyles) is guarded, so a page that has
  nothing to say about it simply does not declare it. --}}
<script server>
// The partial imports what it uses rather than leaning on the page's scope:
// a shared head that reads an import only some pages happen to make renders
// an empty href on all the others.
import { fonts, inlineStyles } from '../data/assets'
import { themeBootScript } from '../data/theme'

// The page owns these; declaring them types the template without emitting
// anything, so the page's own values still render.
declare const pageTitle: string
declare const pageDescription: string
declare const canonicalPath: string
declare const jsonLd: string | undefined
declare const pageStyles: string[] | undefined

// theme.css first: marketing.css builds on its tokens and primitives. A page
// with a sheet of its own (the home page) names it in `pageStyles`, and it is
// appended after both, where a linked file used to come.
const styles = inlineStyles(['theme', 'marketing', ...(typeof pageStyles !== 'undefined' && pageStyles ? pageStyles : [])])
</script>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="{{ pageDescription }}">
<title>{{ pageTitle }}</title>

<link rel="canonical" href="https://stacksjs.com{{ canonicalPath }}">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#fafbfc" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#070b14" media="(prefers-color-scheme: dark)">
<link rel="icon" href="/images/logos/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/images/logos/logo.png">

{{-- Open Graph. Defining og:title here makes stx skip its default SEO
  injection, which would otherwise stamp placeholder "stx Project" tags. --}}
<meta property="og:type" content="website">
<meta property="og:site_name" content="Stacks">
<meta property="og:url" content="https://stacksjs.com{{ canonicalPath }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:image" content="https://stacksjs.com/images/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="600">
<meta property="og:image:alt" content="Stacks - develop modern apps, clouds, and framework-agnostic libraries, faster.">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@stacksjs">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDescription }}">
<meta name="twitter:image" content="https://stacksjs.com/images/og-image.png">

{{-- Brand type: Geist and Geist Mono, from this origin. Preloaded because
  the browser only learns it needs a font once it has matched a rule that
  uses one, and both are on screen before the fold on every page. The
  `crossorigin` is not optional even for a same-origin font: without it the
  preload and the request the stylesheet makes do not match, and the file
  is fetched twice. --}}
<link rel="preload" href="{{ fonts.sans }}" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ fonts.mono }}" as="font" type="font/woff2" crossorigin>

@if (typeof jsonLd !== 'undefined' && jsonLd)
  <script type="application/ld+json">{!! jsonLd !!}</script>
@endif
{{-- The theme, chosen before first paint so the page never flashes the
  wrong one. Written and explained in resources/data/theme.ts; emitted raw so
  it stays a plain inline script. --}}
{!! themeBootScript !!}
{{-- Every stylesheet the page needs, in the document itself: nothing between
  the HTML arriving and the first paint waits on another request. See
  inlineStyles() in resources/data/assets.ts. --}}
{!! styles !!}
