<script server>
/*
 * The body of every feature page. Included by the thin view per feature in
 * resources/views/features/, each of which sets `featureSlug` and nothing
 * else; a partial inherits the including page's scope, so that is the whole
 * contract between them.
 *
 * The content itself comes from resources/data/features.ts, which the home
 * page bento and the nav mega menu read too, so the three surfaces cannot
 * disagree about what the product has.
 *
 * This used to be `features/[slug].stx`, one dynamic route for all eight,
 * which cost nothing to add a feature to and answered 200 for every URL under
 * /features - including the ones that are not features. A view cannot set its
 * own status in stx, so that was a soft 404 with no way out from inside the
 * template. Concrete views instead: an unknown slug now matches no view at
 * all, which is the case stx already answers with a real 404 and the site's
 * own error page. The price is a four-line file per feature.
 */
import { featureBySlug, featureGroups, featuresInGroup } from '../data/features'
import { highlight } from '../data/highlight'

const appName = 'Stacks'

const feature = featureBySlug(featureSlug)

const pageTitle = `${feature.title} - Stacks`
const pageDescription = feature.blurb
const canonicalPath = `/features/${feature.slug}`

// The code panel holds plain source in the data file; it becomes tok-* spans
// here rather than being written as markup by hand.
const codeHtml = highlight(feature.page.code.code)

const related = feature.page.related.map(featureBySlug).filter(Boolean)

const navLinks = [
  { label: 'CMS', url: '/#cms' },
  { label: 'Cloud', url: '/#deploy' },
  { label: 'Docs', url: '/docs', native: true },
  { label: 'Blog', url: '/blog', native: true },
]

const megaGroups = featureGroups.map(group => ({
  ...group,
  items: featuresInGroup(group.id),
}))
</script>

<!DOCTYPE html>
<html lang="en">
  <head>
    @include('marketing-head')
  </head>
  <body>
    <div class="site-content">
      @include('marketing-nav')

      <main>
        <section class="page-hero site-shell">
          <div>
            <div class="breadcrumb">
              <a href="/features">Features</a>
              <i class="i-hugeicons-arrow-right-01" aria-hidden="true"></i>
              <span>{{ feature.title }}</span>
            </div>

            <div class="page-glyph"><i class="{{ feature.icon }}" aria-hidden="true"></i></div>
            <span class="kicker">{{ feature.page.kicker }}</span>
            <h1 class="page-title">{{ feature.page.headline }}</h1>
            <p class="page-lede">{{ feature.page.lede }}</p>

            <div class="hero-actions">
              <a class="button primary" href="{{ feature.page.docs }}" data-no-router>Read the docs</a>
              <a class="button" href="/features">All features</a>
            </div>
          </div>

          <aside class="product-preview" aria-label="{{ feature.title }} in code">
            <div class="code-window">
              <div class="code-titlebar">
                <span class="code-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="code-file">{{ feature.page.code.file }}</span>
              </div>
              <pre class="code-body"><code>{!! codeHtml !!}</code></pre>
            </div>
          </aside>
        </section>

        <section class="section site-shell" aria-labelledby="capabilities-heading">
          <div class="section-head">
            <h2 id="capabilities-heading" class="section-title">What you get.</h2>
            <p class="section-copy">All of it in the same install, with nothing to wire together first.</p>
          </div>

          <div class="capability-grid">
            @foreach (feature.page.capabilities as capability)
              <article class="capability rise">
                <h3>{{ capability.title }}</h3>
                <p>{{ capability.text }}</p>
              </article>
            @endforeach
          </div>
        </section>

        <section class="section site-shell" aria-labelledby="commands-heading">
          <div class="section-head">
            <h2 id="commands-heading" class="section-title">From the command line.</h2>
            <p class="section-copy">Buddy scaffolds, runs, and ships this the same way it does the rest of the app.</p>
          </div>

          <div class="command-strip rise">
            @foreach (feature.page.commands as command)
              <span>{{ command }}</span>
            @endforeach
          </div>
        </section>

        <section class="section site-shell" aria-labelledby="related-heading">
          <div class="section-head">
            <h2 id="related-heading" class="section-title">Pairs with.</h2>
            <p class="section-copy">These share the same models, config, and types, so using them together costs nothing extra.</p>
          </div>

          <div class="related-grid">
            @foreach (related as other)
              <a class="related-card rise" href="/features/{{ other.slug }}">
                <h3><i class="{{ other.icon }}" aria-hidden="true"></i>{{ other.title }}</h3>
                <p>{{ other.blurb }}</p>
              </a>
            @endforeach
          </div>
        </section>
      </main>

      @include('marketing-footer')
    </div>

    @include('marketing-theme-toggle')
  </body>
</html>
