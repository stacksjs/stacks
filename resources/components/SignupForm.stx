<script client>
/*
 * The launch-list signup, answered in place.
 *
 * Submitting does not reload the page: `@submit.prevent` hands the form to
 * `submit()`, the button shows a spinner while the request is out, and the
 * answer appears under the field. A good address clears the field; a bad one
 * keeps it, with focus, to fix.
 *
 * Without JavaScript it is still a plain form: it posts to
 * /api/email/subscribe, the API sends the browser back to `returnTo` with
 * `?subscribe=<outcome>`, and the page passes that back in as `outcome`.
 *
 * Props:
 *   source   who signed up from where, stored on the subscriber
 *   returnTo the page and fragment to come back to without JavaScript
 *   outcome  the ?subscribe= value the page was loaded with, if any
 *   intro    a visible label above the field (else a screen-reader label)
 *   fine     fine print under the field, replaced by the answer
 *   tone     'primary' for a filled button, anything else for an outlined one
 */
import type { SubscribeOutcome } from '../data/signup-messages'
import { isSubscribeOutcome, subscribeMessages, subscribeOutcome } from '../data/signup-messages'

const source = useReactiveProp<string>('source', 'site')
const returnTo = useReactiveProp<string>('returnTo', '/#subscribe')
const loadedWith = useReactiveProp<string>('outcome', '')
const intro = useReactiveProp<string>('intro', '')
const fine = useReactiveProp<string>('fine', '')
const tone = useReactiveProp<string>('tone', 'primary')

const email = state('')
const sending = state(false)
const outcome = state<SubscribeOutcome | ''>(isSubscribeOutcome(loadedWith()) ? loadedWith() as SubscribeOutcome : '')
const notice = derived(() => {
  const current = outcome()
  return current ? subscribeMessages[current] : null
})
const noticeClass = derived(() => notice() ? `signup-notice--${notice()?.tone}` : 'signup-notice--empty')
const noticeIcon = derived(() => notice()?.tone === 'error' ? 'i-hugeicons-alert-circle' : 'i-hugeicons-checkmark-circle-02')
const noticeText = derived(() => notice()?.text ?? '')
const emailInput = useRef('emailInput')

// Long enough to read as "working" rather than a flicker, short enough never
// to be the slow part.
const minimumSpin = 450

async function send() {
  try {
    const response = await fetch('/api/email/subscribe', {
      method: 'POST',
      headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams({ email: email(), source: source(), return: returnTo() }).toString(),
    })
    let body: unknown = null
    try {
      body = await response.json()
    }
    catch {}
    return subscribeOutcome(response.status, body)
  }
  catch {
    return 'error' as const
  }
}

async function submit(): Promise<void> {
  if (sending())
    return

  sending.set(true)
  const [answer] = await Promise.all([send(), new Promise(resolve => setTimeout(resolve, minimumSpin))])
  outcome.set(answer)
  sending.set(false)

  if (answer === 'subscribed' || answer === 'already')
    email.set('')
  else
    void nextTick(() => emailInput.current?.focus())
}
</script>

<form
  class="signup-form"
  :class="(sending() ? 'is-loading' : '') + (intro() ? ' signup-form--intro' : '')"
  action="/api/email/subscribe"
  method="POST"
  :aria-busy="sending() ? 'true' : 'false'"
  @submit.prevent="submit()"
>
  <input type="hidden" name="source" :value="source()">
  <input type="hidden" name="return" :value="returnTo()">
  <label class="signup-intro" :class="intro() ? '' : 'sr-only'" for="signup-email">{{ intro() || 'Email address' }}</label>
  <div class="signup-row">
    <input id="signup-email" ref="emailInput" type="email" name="email" placeholder="you@example.com" autocomplete="email" required x-model.trim="email">
    <button type="submit" class="button signup-submit" :class="tone() === 'primary' ? 'primary' : ''" :disabled="sending()">
      <span class="signup-spinner" aria-hidden="true"></span>
      <span class="signup-label">Get the launch email</span>
    </button>
  </div>
  <p
    class="signup-notice"
    :class="noticeClass()"
    role="status"
    aria-live="polite"
  >
    <i
      aria-hidden="true"
      :class="noticeIcon()"
    ></i>
    <span>{{ noticeText() }}</span>
  </p>
  <p class="signup-fine" :class="notice() || !fine() ? 'signup-fine--gone' : ''">{{ fine() }}</p>
</form>
