+// src/webauthn/json.ts
+function encodeBase64URL(value) {
+  const bytes = value instanceof Uint8Array ? value : new Uint8Array(value);
+  return btoa(Array.from(bytes, (byte) => String.fromCharCode(byte)).join("")).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
+}
+function decodeBase64URL(value) {
+  if (typeof value !== "string" || !value || value.length > 131072 || !/^[A-Za-z0-9_-]+$/.test(value) || value.length % 4 === 1)
+    throw new Error("Invalid base64url");
+  const raw = atob(value.replace(/-/g, "+").replace(/_/g, "/"));
+  const bytes = Uint8Array.from(raw, (char) => char.charCodeAt(0));
+  if (encodeBase64URL(bytes) !== value)
+    throw new Error("Noncanonical base64url");
+  return bytes.buffer;
+}
+function registrationOptionsToJSON(options) {
+  return {
+    ...options,
+    challenge: encodeBase64URL(options.challenge),
+    user: { ...options.user, id: encodeBase64URL(options.user.id) },
+    excludeCredentials: options.excludeCredentials?.map((item) => ({ ...item, id: typeof item.id === "string" ? item.id : encodeBase64URL(item.id) }))
+  };
+}
+function authenticationOptionsToJSON(options) {
+  return {
+    ...options,
+    challenge: encodeBase64URL(options.challenge),
+    allowCredentials: options.allowCredentials?.map((item) => ({ ...item, id: typeof item.id === "string" ? item.id : encodeBase64URL(item.id) }))
+  };
+}
+function registrationCredentialFromJSON(value) {
+  return { id: value.id, type: value.type, rawId: decodeBase64URL(value.rawId), response: {
+    clientDataJSON: decodeBase64URL(value.response.clientDataJSON),
+    attestationObject: decodeBase64URL(value.response.attestationObject)
+  } };
+}
+function authenticationCredentialFromJSON(value) {
+  return { id: value.id, type: value.type, rawId: decodeBase64URL(value.rawId), response: {
+    clientDataJSON: decodeBase64URL(value.response.clientDataJSON),
+    authenticatorData: decodeBase64URL(value.response.authenticatorData),
+    signature: decodeBase64URL(value.response.signature),
+    userHandle: value.response.userHandle == null ? null : decodeBase64URL(value.response.userHandle)
+  } };
+}
+function registrationCredentialToJSON(value) {
+  return { id: value.id, type: value.type, rawId: encodeBase64URL(value.rawId), response: {
+    clientDataJSON: encodeBase64URL(value.response.clientDataJSON),
+    attestationObject: encodeBase64URL(value.response.attestationObject),
+    transports: value.response.transports
+  } };
+}
+function authenticationCredentialToJSON(value) {
+  return { id: value.id, type: value.type, rawId: encodeBase64URL(value.rawId), response: {
+    clientDataJSON: encodeBase64URL(value.response.clientDataJSON),
+    authenticatorData: encodeBase64URL(value.response.authenticatorData),
+    signature: encodeBase64URL(value.response.signature),
+    userHandle: value.response.userHandle == null ? null : encodeBase64URL(value.response.userHandle)
+  } };
+}
+
+// src/webauthn/browser.ts
+async function startRegistration(options, control = {}) {
+  if (!browserSupportsWebAuthn()) {
+    throw new Error("WebAuthn is not supported in this browser");
+  }
+  const publicKeyOptions = {
+    ...options,
+    challenge: typeof options.challenge === "string" ? new Uint8Array(decodeBase64URL(options.challenge)) : options.challenge,
+    user: {
+      ...options.user,
+      id: typeof options.user.id === "string" ? new Uint8Array(decodeBase64URL(options.user.id)) : options.user.id
+    }
+  };
+  publicKeyOptions.excludeCredentials = options.excludeCredentials?.map((item) => ({ ...item, id: typeof item.id === "string" ? decodeBase64URL(item.id) : item.id }));
+  const credential = await navigator.credentials.create({
+    publicKey: publicKeyOptions,
+    signal: control.signal
+  });
+  if (!credential) {
+    throw new Error("Failed to create credential");
+  }
+  return {
+    id: credential.id,
+    rawId: credential.rawId,
+    response: {
+      clientDataJSON: credential.response.clientDataJSON,
+      attestationObject: credential.response.attestationObject,
+      transports: credential.response.getTransports?.() || []
+    },
+    type: credential.type
+  };
+}
+async function startAuthentication(options, control = {}) {
+  if (!browserSupportsWebAuthn()) {
+    throw new Error("WebAuthn is not supported in this browser");
+  }
+  const credential = await navigator.credentials.get({
+    publicKey: {
+      ...options,
+      challenge: typeof options.challenge === "string" ? decodeBase64URL(options.challenge) : options.challenge,
+      allowCredentials: options.allowCredentials?.map((item) => ({ ...item, id: typeof item.id === "string" ? decodeBase64URL(item.id) : item.id }))
+    },
+    signal: control.signal,
+    mediation: control.mediation
+  });
+  if (!credential) {
+    throw new Error("Failed to get credential");
+  }
+  return {
+    id: credential.id,
+    rawId: credential.rawId,
+    response: {
+      clientDataJSON: credential.response.clientDataJSON,
+      authenticatorData: credential.response.authenticatorData,
+      signature: credential.response.signature,
+      userHandle: credential.response.userHandle
+    },
+    type: credential.type
+  };
+}
+async function platformAuthenticatorIsAvailable() {
+  if (!browserSupportsWebAuthn()) {
+    return false;
+  }
+  try {
+    return await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable();
+  } catch {
+    return false;
+  }
+}
+function browserSupportsWebAuthn() {
+  return typeof globalThis.PublicKeyCredential !== "undefined" && typeof navigator !== "undefined" && !!navigator.credentials;
+}
+async function browserSupportsWebAuthnAutofill() {
+  if (!browserSupportsWebAuthn()) {
+    return false;
+  }
+  try {
+    return !!await PublicKeyCredential.isConditionalMediationAvailable?.();
+  } catch {
+    return false;
+  }
+}
+export {
+  authenticationCredentialFromJSON,
+  authenticationCredentialToJSON,
+  authenticationOptionsToJSON,
+  browserSupportsWebAuthn,
+  browserSupportsWebAuthnAutofill,
+  decodeBase64URL,
+  encodeBase64URL,
+  platformAuthenticatorIsAvailable,
+  registrationCredentialFromJSON,
+  registrationCredentialToJSON,
+  registrationOptionsToJSON,
+  startAuthentication,
+  startRegistration
+};
