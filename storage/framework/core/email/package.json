{
  "name": "@stacksjs/email",
  "type": "module",
  "sideEffects": false,
  "version": "0.73.3",
  "description": "The Stacks Email integration. Painlessly create & manage your inboxes, templates, and send emails.",
  "author": "Chris Breuer",
  "contributors": [
    "Chris Breuer <chris@stacksjs.com>"
  ],
  "license": "MIT",
  "funding": "https://github.com/sponsors/chrisbbreuer",
  "homepage": "https://github.com/stacksjs/stacks/tree/main/storage/framework/core/email#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/stacks.git",
    "directory": "./storage/framework/core/email"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/stacks/issues"
  },
  "keywords": [
    "email",
    "ses",
    "aws",
    "stacks",
    "emailjs",
    "mailgun"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "bun": "./dist/*.js",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "bun": "./dist/*.js",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "bun build.ts",
    "build:inbound": "bun build-inbound.ts",
    "typecheck": "bun tsc --noEmit",
    "typecheck:types": "bun tsc --noEmit -p tsconfig.type-tests.json --pretty false",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@stacksjs/config": "workspace:*",
    "@stacksjs/database": "workspace:*",
    "@stacksjs/events": "workspace:*",
    "@stacksjs/logging": "workspace:*",
    "@stacksjs/path": "workspace:*",
    "@stacksjs/queue": "workspace:*",
    "@stacksjs/storage": "workspace:*",
    "@stacksjs/strings": "workspace:*",
    "@stacksjs/stx": "^0.2.246",
    "@stacksjs/ts-cloud": "^0.12.10",
    "@stacksjs/utils": "workspace:*",
    "postal-mime": "^2.7.6"
  },
  "devDependencies": {
    "@stacksjs/cli": "workspace:*",
    "@stacksjs/error-handling": "workspace:*",
    "@stacksjs/types": "workspace:*",
    "better-dx": "^0.2.24"
  }
}
