{
  // Shared config for the framework's own packages, and for `api/` and
  // `server/`. It only adds the path mappings that resolve `@stacksjs/*` to
  // package sources - every compiler option comes from the base the whole
  // project shares.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      // Deep subpath imports need their own mapping: `@stacksjs/*` below binds
      // the wildcard to the WHOLE remainder, so `@stacksjs/browser/composables/csrf`
      // resolves to `./browser/composables/csrf/src`, which does not exist. tsc
      // then falls back to node resolution and lands on the package's `dist/`,
      // which nothing builds before `bun run typecheck` — so these read as
      // "Cannot find module" on a clean checkout and in CI, and are four of the
      // six errors that have kept the typecheck job red.
      "@stacksjs/actions/*": ["./actions/src/*"],
      // Deep runtime entrypoints must resolve to source in a clean checkout.
      "@stacksjs/storage/*": ["./storage/src/*"],
      // The ORM route generator is a package entrypoint of its own, so the
      // vendored `storage/framework/orm/routes.ts` can reach it from an app
      // that has no `core/` directory. Mapped explicitly because `@stacksjs/*`
      // below binds the wildcard to the whole remainder — `@stacksjs/orm/routes`
      // would look for `./orm/routes/src`.
      "@stacksjs/orm/routes": ["./orm/src/routes.ts"],
      "@stacksjs/browser/*": ["./browser/src/*"],
      "@stacksjs/composables/*": ["./composables/src/*"],
      // Published name and directory name disagree: `@stacksjs/desktop-build`
      // lives in `core/desktop/`. `@stacksjs/*` looks for `./desktop-build/src`
      // and misses, which is the remaining pair of typecheck errors.
      "@stacksjs/desktop-build": ["./desktop/src"],
      "@stacksjs/*": ["./*/src"],
      "stacks/*": ["./*/src"],
      "buddy": ["./buddy/src/index.ts"],
      "buddy/*": ["./buddy/src/*"],
      "Actions/*": ["../../../app/Actions/*"],
      "Commands/*": ["../../../app/Commands/*"],
      "Jobs/*": ["../../../app/Jobs/*"],
      "Middleware/*": ["../../../app/Middleware/*"],
      "Models/*": ["../../../app/Models/*"],
      "Notifications/*": ["../../../app/Notifications/*"],
      "~/*": ["../../../*"],
      "@/*": ["../../../resources/*"],
      // Fallback for third-party packages: Pantry installs the dependency graph
      // into `pantry/` rather than `node_modules/`. It is listed last so it only
      // applies to specifiers that none of the mappings above matched.
      "ts-pantry": ["../../../node_modules/ts-pantry"],
      "*": ["../../../pantry/*"]
    },
    // `dtsx` emits the published `.d.ts` files, not tsc - these two only
    // describe intent for editors and for anyone running tsc by hand. The base
    // sets `noEmit`, so nothing is written either way.
    "declaration": true,
    "declarationMap": true
  }
}
