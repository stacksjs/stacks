{
  "name": "@stacksjs/auth",
  "type": "module",
  "sideEffects": false,
  "version": "0.74.14",
  "description": "A more simplistic way to authenticate.",
  "author": "Chris Breuer",
  "contributors": [
    "Chris Breuer <chris@stacksjs.com>"
  ],
  "license": "MIT",
  "funding": "https://github.com/sponsors/chrisbbreuer",
  "homepage": "https://github.com/stacksjs/stacks/tree/main/storage/framework/core/auth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/stacks.git",
    "directory": "./storage/framework/core/auth"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/stacks/issues"
  },
  "keywords": [
    "auth",
    "authenticate",
    "stacks"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "bun": "./dist/*.js",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "bun": "./dist/*.js",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "bun build.ts",
    "typecheck": "bun tsc --noEmit",
    "typecheck:types": "bun tsc --noEmit -p tsconfig.type-tests.json --pretty false",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@stacksjs/bun-router": "^0.1.8",
    "@stacksjs/cache": "workspace:*",
    "@stacksjs/config": "workspace:*",
    "@stacksjs/database": "workspace:*",
    "@stacksjs/email": "workspace:*",
    "@stacksjs/env": "workspace:*",
    "@stacksjs/error-handling": "workspace:*",
    "@stacksjs/logging": "workspace:*",
    "@stacksjs/orm": "workspace:*",
    "@stacksjs/path": "workspace:*",
    "@stacksjs/router": "workspace:*",
    "@stacksjs/security": "workspace:*",
    "@stacksjs/storage": "workspace:*",
    "@stacksjs/ts-auth": "^0.4.4",
    "ts-qr-codes": "^0.1.8"
  },
  "devDependencies": {
    "better-dx": "^0.2.24"
  }
}
