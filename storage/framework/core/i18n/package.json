    "@stacksjs/development": "workspace:*"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "bun": "./dist/index.js",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./client": {
        "types": "./dist/client.d.ts",
        "bun": "./dist/client.js",
        "import": "./dist/client.js",
        "default": "./dist/client.js"
      },
      "./stx": {
        "types": "./dist/stx.d.ts",
        "bun": "./dist/stx.js",
        "import": "./dist/stx.js",
        "default": "./dist/stx.js"
      }
    }
  }
