{
  "name": "@stacksjs/actions",
  "type": "module",
  "sideEffects": false,
  "version": "0.74.3",
  "description": "The Stacks actions.",
  "author": "Chris Breuer",
  "contributors": [
    "Chris Breuer <chris@stacksjs.com>"
  ],
  "license": "MIT",
  "funding": "https://github.com/sponsors/chrisbbreuer",
  "homepage": "https://github.com/stacksjs/stacks/tree/main/storage/framework/core/actions#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/stacks.git",
    "directory": "./storage/framework/core/actions"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/stacks/issues"
  },
  "keywords": [
    "actions",
    "stacks",
    "framework",
    "typescript",
    "javascript",
    "bun"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./run-action": {
      "types": "./dist/run-action.d.ts",
      "bun": "./dist/run-action.js",
      "import": "./dist/run-action.js",
      "default": "./dist/run-action.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "bun": "./dist/*.js",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "bun build.ts",
    "typecheck": "bun tsc --noEmit",
    "typecheck:types": "bun tsc --noEmit -p tsconfig.type-tests.json --pretty false",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@stacksjs/ai": "workspace:*",
    "@stacksjs/analytics": "workspace:*",
    "@stacksjs/api": "workspace:*",
    "@stacksjs/auth": "workspace:*",
    "@stacksjs/build": "workspace:*",
    "@stacksjs/bumpx": "^0.2.6",
    "@stacksjs/bunpress": "^0.2.8",
    "@stacksjs/cli": "workspace:*",
    "@stacksjs/cloud": "workspace:*",
    "@stacksjs/cms": "workspace:*",
    "@stacksjs/config": "workspace:*",
    "@stacksjs/database": "workspace:*",
    "@stacksjs/desktop-build": "workspace:*",
    "@stacksjs/dns": "workspace:*",
    "@stacksjs/enums": "workspace:*",
    "@stacksjs/env": "workspace:*",
    "@stacksjs/error-handling": "workspace:*",
    "@stacksjs/gitit": "^0.2.5",
    "@stacksjs/i18n": "workspace:*",
    "@stacksjs/image": "workspace:*",
    "@stacksjs/logging": "workspace:*",
    "@stacksjs/logsmith": "^0.2.3",
    "@stacksjs/orm": "workspace:*",
    "@stacksjs/path": "workspace:*",
    "@stacksjs/payments": "workspace:*",
    "@stacksjs/queue": "workspace:*",
    "@stacksjs/registry": "workspace:*",
    "@stacksjs/router": "workspace:*",
    "@stacksjs/rpx": "^0.11.42",
    "@stacksjs/scheduler": "workspace:*",
    "@stacksjs/search-engine": "workspace:*",
    "@stacksjs/security": "workspace:*",
    "@stacksjs/server": "workspace:*",
    "@stacksjs/sites": "workspace:*",
    "@stacksjs/storage": "workspace:*",
    "@stacksjs/strings": "workspace:*",
    "@stacksjs/stx": "^0.2.253",
    "@stacksjs/tlsx": "^0.13.19",
    "@stacksjs/ts-cloud": "^0.12.10",
    "@stacksjs/ts-md": "^0.1.1",
    "@stacksjs/tunnel": "workspace:*",
    "@stacksjs/types": "workspace:*",
    "@stacksjs/utils": "workspace:*",
    "@stacksjs/whois": "workspace:*",
    "bun-plugin-stx": "^0.2.246"
  },
  "peerDependencies": {
    "craft-native": ">=0.0.72",
    "pickier": "^0.1.58"
  },
  "peerDependenciesMeta": {
    "pickier": {
      "optional": true
    },
    "craft-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@stacksjs/validation": "workspace:*",
    "better-dx": "^0.2.24"
  }
}
