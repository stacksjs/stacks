{
  "name": "@stacksjs/utils",
  "type": "module",
  "sideEffects": false,
  "version": "0.70.342",
  "description": "The Stacks helper functions.",
  "author": "Chris Breuer",
  "contributors": [
    "Chris Breuer <chris@stacksjs.com>"
  ],
  "license": "MIT",
  "funding": "https://github.com/sponsors/chrisbbreuer",
  "homepage": "https://github.com/stacksjs/stacks/tree/main/storage/framework/core/utils#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/stacks.git",
    "directory": "./storage/framework/core/utils"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/stacks/issues"
  },
  "keywords": [
    "objects",
    "strings",
    "arrays",
    "alias",
    "helpers",
    "utilities",
    "functions",
    "stacks"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "bun": "./dist/*.js",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "bun": "./dist/*.js",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "bun build.ts",
    "typecheck": "bun tsc --noEmit",
    "prepublishOnly": "bun run build",
    "size": "bun scripts/export-size.ts"
  },
  "dependencies": {
    "@stacksjs/browser": "workspace:*"
  },
  "devDependencies": {
    "@stacksjs/actions": "workspace:*",
    "@stacksjs/arrays": "workspace:*",
    "@stacksjs/cli": "workspace:*",
    "@stacksjs/config": "workspace:*",
    "better-dx": "^0.2.17",
    "filesize": "^11.0.22",
    "markdown-table": "^3.0.4",
    "@stacksjs/lint": "workspace:*",
    "@stacksjs/path": "workspace:*",
    "@stacksjs/storage": "workspace:*",
    "@stacksjs/strings": "workspace:*",
    "@stacksjs/types": "workspace:*"
  }
}
