{
  "name": "@stacksjs/desktop-build",
  "type": "module",
  "sideEffects": false,
  "version": "0.72.28",
  "description": "Build and launch Craft desktop applications for Stacks",
  "author": "Chris Breuer",
  "contributors": [
    "Chris Breuer <chris@stacksjs.com>"
  ],
  "license": "MIT",
  "funding": "https://github.com/sponsors/chrisbbreuer",
  "homepage": "https://github.com/stacksjs/stacks/tree/main/storage/framework/core/desktop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/stacks.git",
    "directory": "./storage/framework/core/desktop"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/stacks/issues"
  },
  "keywords": [
    "desktop",
    "nexmo",
    "twilio",
    "aws",
    "sms",
    "email",
    "database",
    "slack",
    "discord",
    "webhooks",
    "stacks"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "bun": "./dist/*.js",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "bun": "./dist/*.js",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "dev": "bun ../../actions/src/dev/desktop.ts",
    "dev:app": "bun ../../actions/src/dev/desktop.ts",
    "build": "bun build.ts",
    "build:app": "bun ../../actions/src/build/desktop.ts",
    "typecheck": "bun tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@stacksjs/build": "workspace:*",
    "better-dx": "^0.2.23",
    "@stacksjs/server": "workspace:*"
  },
  "dependencies": {
    "craft-native": ">=0.0.55"
  }
}
