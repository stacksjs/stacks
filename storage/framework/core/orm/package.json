{
  "name": "@stacksjs/orm",
  "type": "module",
  "sideEffects": false,
  "version": "0.72.47",
  "description": "The Stacks ORM integration",
  "author": "Chris Breuer",
  "contributors": [
    "Chris Breuer <chris@stacksjs.com>"
  ],
  "license": "MIT",
  "funding": "https://github.com/sponsors/chrisbbreuer",
  "homepage": "https://github.com/stacksjs/stacks/tree/main/storage/framework/core/orm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/stacks.git",
    "directory": "./storage/framework/core/orm"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/stacks/issues"
  },
  "keywords": [
    "stacks",
    "orm",
    "bun"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./traits/*": {
      "types": "./dist/traits/*.d.ts",
      "bun": "./dist/traits/*.js",
      "import": "./dist/traits/*.js",
      "default": "./dist/traits/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "bun": "./dist/*.js",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "bun": "./dist/*.js",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "bun build.ts",
    "typecheck": "bun tsc --noEmit",
    "typecheck:inference": "bun run build && (cd ../faker && bun run build) && (cd ../query-builder && bun run build) && (cd ../types && bun run build) && (cd ../validation && bun run build) && bun tsc -p tsconfig.type-tests.json",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@stacksjs/ts-validation": "^0.5.5",
    "bun-query-builder": "^0.2.53"
  },
  "devDependencies": {
    "@stacksjs/config": "workspace:*",
    "better-dx": "^0.2.24",
    "@stacksjs/query-builder": "workspace:*",
    "@stacksjs/types": "workspace:*"
  }
}
