{
  "name": "@stacksjs/browser",
  "type": "module",
  "sideEffects": false,
  "version": "0.70.349",
  "description": "Stacks core frontend/browser functionalities.",
  "author": "Chris Breuer",
  "contributors": [
    "Chris Breuer <chris@stacksjs.com>"
  ],
  "license": "MIT",
  "funding": "https://github.com/sponsors/chrisbbreuer",
  "homepage": "https://github.com/stacksjs/stacks/tree/main/storage/framework/core/browser#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/stacks.git",
    "directory": "./storage/framework/core/browser"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/stacks/issues"
  },
  "keywords": [
    "frontend",
    "browser",
    "stacks",
    "api"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./composables": {
      "types": "./dist/composables/index.d.ts",
      "bun": "./dist/composables/index.js",
      "import": "./dist/composables/index.js",
      "default": "./dist/composables/index.js"
    },
    "./composables/*": {
      "types": "./dist/composables/*.d.ts",
      "bun": "./dist/composables/*.js",
      "import": "./dist/composables/*.js",
      "default": "./dist/composables/*.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "bun": "./dist/utils/index.js",
      "import": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "bun": "./dist/*.js",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "bun build.ts",
    "typecheck": "bun tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@stacksjs/composables": "workspace:*",
    "@stacksjs/stx": "^0.2.148",
    "bun-query-builder": "^0.2.25"
  },
  "peerDependencies": {
    "@stripe/stripe-js": "^9.10.0"
  },
  "peerDependenciesMeta": {
    "@stripe/stripe-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "better-dx": "^0.2.17",
    "@stacksjs/utils": "workspace:*",
    "@stripe/stripe-js": "^9.10.0"
  }
}
