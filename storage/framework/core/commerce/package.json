{
  "name": "@stacksjs/commerce",
  "type": "module",
  "sideEffects": false,
  "version": "0.74.22",
  "description": "Stacks commerce utilities.",
  "author": "Chris Breuer",
  "contributors": [
    "Chris Breuer <chris@stacksjs.com>"
  ],
  "license": "MIT",
  "funding": "https://github.com/sponsors/chrisbbreuer",
  "homepage": "https://github.com/stacksjs/stacks/tree/main/storage/framework/core/commerce#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/stacks.git",
    "directory": "./storage/framework/core/commerce"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/stacks/issues"
  },
  "keywords": [
    "commerce",
    "utilities",
    "functions",
    "bun",
    "stacks"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "bun": "./dist/*.js",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "bun": "./dist/*.js",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "bun build.ts",
    "typecheck": "bun tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@stacksjs/cache": "workspace:*",
    "@stacksjs/config": "workspace:*",
    "@stacksjs/database": "workspace:*",
    "@stacksjs/env": "workspace:*",
    "@stacksjs/error-handling": "workspace:*",
    "@stacksjs/events": "workspace:*",
    "@stacksjs/logging": "workspace:*",
    "@stacksjs/orm": "workspace:*",
    "@stacksjs/payments": "workspace:*",
    "@stacksjs/realtime": "workspace:*",
    "@stacksjs/strings": "workspace:*",
    "ts-spreadsheets": "^0.2.5"
  },
  "devDependencies": {
    "better-dx": "^0.2.24"
  }
}
