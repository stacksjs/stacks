    "@stacksjs/payments": "^0.74.15",
    "@stacksjs/realtime": "^0.74.15",
    "@stacksjs/router": "^0.74.15",
    "@stacksjs/rpx": "^0.11.42",
    "@stacksjs/scheduler": "^0.74.15",
    "@stacksjs/search-engine": "^0.74.15",
    "@stacksjs/security": "^0.74.15",
