{
  "name": "@stacksjs/buddy",
  "type": "module",
  "sideEffects": false,
  "version": "0.75.528",
  "description": "Meet Buddy. The Stacks runtime.",
  "author": "Chris Breuer",
  "contributors": [
    "Chris Breuer <chris@stacksjs.com>"
  ],
  "license": "MIT",
  "funding": "https://github.com/sponsors/chrisbbreuer",
  "homepage": "https://github.com/stacksjs/stacks/tree/main/stacks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/stacks.git",
    "directory": "./storage/framework/core/buddy"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/stacks/issues"
  },
  "keywords": [
    "stacks",
    "buddy",
    "runtime",
    "component",
    "composables",
    "functions",
    "headless",
    "api",
    "ssg",
    "pwa",
    "modern",
    "library",
    "stx",
    "web components",
    "typescript",
    "javascript",
    "starter kit"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "bun": "./dist/cli.js",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "bun": "./dist/*.js",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "bun": "./dist/*.js",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "stacks": "dist/cli.js",
    "buddy": "dist/cli.js",
    "bud": "dist/cli.js"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "buddy": "bunx --bun ./src/cli.ts",
    "build": "bun build.ts",
    "compile": "bun build ./src/cli.ts --compile --compile-autoload-package-json --minify --sourcemap --outfile dist/buddy",
    "compile:all": "bun run compile:linux-x64 && bun run compile:linux-arm64 && bun run compile:windows-x64 && bun run compile:darwin-x64 && bun run compile:darwin-arm64",
    "compile:linux-x64": "bun build ./src/cli.ts --compile --compile-autoload-package-json --minify --target=bun-linux-x64 --outfile bin/buddy-linux-x64",
    "compile:linux-arm64": "bun build ./src/cli.ts --compile --compile-autoload-package-json --minify --target=bun-linux-arm64 --outfile bin/buddy-linux-arm64",
    "compile:windows-x64": "bun build ./src/cli.ts --compile --compile-autoload-package-json --minify --target=bun-windows-x64 --outfile bin/buddy-windows-x64.exe",
    "compile:darwin-x64": "bun build ./src/cli.ts --compile --compile-autoload-package-json --minify --target=bun-darwin-x64 --outfile bin/buddy-darwin-x64",
    "compile:darwin-arm64": "bun build ./src/cli.ts --compile --compile-autoload-package-json --minify --target=bun-darwin-arm64 --outfile bin/buddy-darwin-arm64",
    "typecheck": "bun tsc --noEmit",
    "zip:all": "bun run zip:linux-x64 && bun run zip:linux-arm64 && bun run zip:windows-x64 && bun run zip:darwin-x64 && bun run zip:darwin-arm64",
    "zip:linux-x64": "zip -j bin/buddy-linux-x64.zip bin/buddy-linux-x64",
    "zip:linux-arm64": "zip -j bin/buddy-linux-arm64.zip bin/buddy-linux-arm64",
    "zip:windows-x64": "zip -j bin/buddy-windows-x64.zip bin/buddy-windows-x64.exe",
    "zip:darwin-x64": "zip -j bin/buddy-darwin-x64.zip bin/buddy-darwin-x64",
    "zip:darwin-arm64": "zip -j bin/buddy-darwin-arm64.zip bin/buddy-darwin-arm64",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@stacksjs/actions": "0.75.528",
