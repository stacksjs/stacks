    "@stacksjs/dns": "^0.74.15",
    "@stacksjs/dnsx": "^0.2.3",
    "@stacksjs/email": "^0.74.15",
    "@stacksjs/enums": "^0.74.15",
    "@stacksjs/env": "^0.74.15",
    "@stacksjs/error-handling": "^0.74.15",
    "@stacksjs/events": "^0.74.15",
    "@stacksjs/features": "workspace:*",
