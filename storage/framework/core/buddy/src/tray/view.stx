<script client>
type Project = { id: string, name: string, path: string, pending: number, issue: string }
type Snapshot = { online: boolean, watched: number, running: boolean, failed: number, projects: Project[], system: { cpu: number | null, memory: { used: number, total: number, raw: boolean } } }
type Package = { name: string, version: string, managed?: boolean }
type CatalogMatch = { name: string, domain: string }
type PantryJob = { id: string, domain: string, operation?: string, status: string, error?: string }
type PantryStatus = { state: 'offline' | 'pair' | 'ready', issue?: string, packages?: Package[], jobs?: PantryJob[], removal?: boolean }

const snapshot = state<Snapshot | null>(null)
const filter = state('')
const busy = state('')
const notice = state('')
const unavailable = state(false)
const pane = state<'overview' | 'pantry'>('overview')
const pantry = state<PantryStatus | null>(null)
const pairingCode = state('')
const packageSearch = state('')
const searched = state(false)
const matches = state<CatalogMatch[]>([])
const packageJobs = state<PantryJob[]>([])
const removal = state('')
const system = derived(() => snapshot()?.system)
const installed = derived(() => {
  const query = packageSearch().trim().toLowerCase()
  return (pantry()?.packages ?? []).filter(item => item.name.toLowerCase().includes(query)).slice(0, 10)
})
const jobInProgress = derived(() => packageJobs().some(job => job.status === 'queued' || job.status === 'running'))
const pending = derived(() => snapshot()?.projects.filter(project => project.pending > 0) ?? [])
const recent = derived(() => {
  const search = filter().trim().toLowerCase()
  const projects = snapshot()?.projects ?? []
  return search
    ? projects.filter(project => project.name.toLowerCase().includes(search) || project.path.toLowerCase().includes(search))
    : projects.slice(0, 6)
})
const launch = globalThis.buddyTray
const desktop = globalThis.craft
let refreshing = false

async function call(path: string, body?: object) {
  const response = await fetch(launch ? new URL(path, launch.origin) : path, {
    method: body ? 'POST' : 'GET',
    headers: { authorization: `Bearer ${launch?.token ?? ''}`, ...(body ? { 'content-type': 'application/json' } : {}) },
    body: body && JSON.stringify(body),
  })
  const result = await response.json()
  if (!response.ok) throw new Error(result.error)
  return result
}

async function refreshStatus() {
  if (refreshing) return
  refreshing = true
  try {
    snapshot.set(await call('/api/status'))
    unavailable.set(false)
  }
  catch {
    unavailable.set(true)
  }
  finally {
    refreshing = false
  }
}

function gib(bytes: number) {
  return new Intl.NumberFormat(undefined, { maximumFractionDigits: 1 }).format(bytes / 1024 ** 3)
}

async function refreshPantry() {
  try {
    const status: PantryStatus = await call('/api/pantry')
    pantry.set(status)
    packageJobs.set(status.jobs ?? [])
  }
  catch (error) {
    pantry.set({ state: 'offline', issue: error.message })
  }
}

async function refreshActivePane() {
  if (pane() === 'overview') return refreshStatus()
  if (!jobInProgress()) return
  try {
    const jobs: PantryJob[] = await call('/api/pantry/jobs')
    packageJobs.set(jobs)
    if (!jobInProgress()) await refreshPantry()
  }
  catch (error) {
    notice.set(error.message)
  }
}

function openPane(next: 'overview' | 'pantry') {
  pane.set(next)
  notice.set('')
  removal.set('')
  void (next === 'overview' ? refreshStatus() : refreshPantry())
}

async function pantryAction(fields: object) {
  if (busy()) return
  busy.set('pantry')
  notice.set('')
  try {
    await call('/api/action', fields)
    pairingCode.set('')
    removal.set('')
    await refreshPantry()
  }
  catch (error) {
    notice.set(error.message)
  }
  finally {
    busy.set('')
  }
}

function changePackage(action: string, domain: string) {
  if (packageChanging(domain)) return
  return pantryAction({ action, domain, requestId: crypto.randomUUID() })
}

function packageChanging(domain: string) {
  return packageJobs().some(job => job.domain === domain && (job.status === 'queued' || job.status === 'running'))
}

async function searchCatalog() {
  const query = packageSearch().trim()
  if (query.length < 2) return
  try {
    const packages = await call(`/api/pantry/catalog?q=${encodeURIComponent(query)}`)
    if (query === packageSearch().trim()) {
      matches.set(packages)
      searched.set(true)
    }
  }
  catch (error) {
    notice.set(error.message)
  }
}

async function perform(action: string, project?: string) {
  if (busy()) return
  busy.set(project || action)
  notice.set('')
  try {
    await call('/api/action', { action, project })
    if (action === 'review') notice.set('Review opened in Terminal.')
    await refreshStatus()
  }
  catch (error) {
    notice.set(error instanceof Error ? error.message : 'Buddy could not complete this action.')
  }
  finally {
    busy.set('')
  }
}

const { pause, resume } = useInterval(() => void refreshActivePane(), 5_000, { immediate: !desktop, whileVisible: true })
const stopFocus = useEventListener(desktop ? 'craft:window:focus' : 'focus', () => {
  resume()
  void (pane() === 'overview' ? refreshStatus() : refreshPantry())
})
const stopBlur = useEventListener('craft:window:blur', pause)
const stopKeys = useEventListener('keydown', (event) => {
  if (event.key === 'Escape') void Promise.resolve(desktop?.window?.hide?.()).catch(() => {})
})
onMount(() => {
  if (desktop) pause()
  void refreshStatus()
  const tray = desktop?.tray
  void Promise.resolve(tray?.setTooltip?.('Buddy')).catch(() => {})
  void Promise.resolve(tray?.setIcon?.('terminal.fill')).catch(() => {})
})
onDestroy(() => {
  pause()
  stopFocus()
  stopBlur()
  stopKeys()
})
</script>

<style>
  :root {
    color-scheme: light dark;
    font-family: -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    --ink: light-dark(#1e2026, #f1f0f5);
    --secondary: light-dark(#555965, #aaaab5);
    --surface: light-dark(#ffffffc2, #25252bd4);
    --line: light-dark(#15172519, #ffffff20);
    --accent: light-dark(#164bc3, #b3c9ff);
    --accent-surface: light-dark(#e4ecff, #253759);
  }
  html, body { margin: 0; min-height: 100%; background: transparent; color: var(--ink); }
  body { font-size: 13px; }
  button, input { font: inherit; }
  button { color: inherit; cursor: pointer; }
  button:disabled { cursor: default; opacity: .65; }
  button:focus-visible, input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  h1, h2, p { margin: 0; }
  .tray { height: 100dvh; }
  .secondary { color: var(--secondary); }
  .line { border-color: var(--line); }
  .surface { background: var(--surface); }
  .accent { color: var(--accent); background: var(--accent-surface); }
  .plain { border: 0; background: transparent; }
  .plain:hover { background: var(--line); }
  .status-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .online { color: light-dark(#207442, #8bdfa9); }
  .issue { color: light-dark(#875115, #f0bd83); }
  .search { color: inherit; }
  .tab { border: 0; }
  .meter { display: block; appearance: none; width: 100%; height: 4px; border: 0; overflow: hidden; border-radius: 8px; }
  .meter::-webkit-progress-bar { background: var(--accent-surface); }
  .meter::-webkit-progress-value { background: var(--accent); border-radius: 8px; }
  .meter::-moz-progress-bar { background: var(--accent); border-radius: 8px; }
</style>

<main class="flex flex-col tray">
  <header class="flex gap-3 items-center justify-between shrink-0 px-4 py-3 border-b line">
    <div class="flex gap-3 items-center">
      <span class="flex items-center justify-center h-9 w-9 font-bold font-mono accent rounded-xl" aria-hidden="true">›_</span>
      <div>
        <h1 class="font-semibold leading-tight text-base">Buddy</h1>
        <p class="flex gap-1.5 items-center text-xs secondary">
          @if(unavailable())
            <span>Connection unavailable</span>
          @elseif(snapshot()?.online)
            <span class="online status-dot" aria-hidden="true"></span>
            <span>{{ snapshot()?.running ? 'Generating' : 'Daemon running' }} · {{ snapshot()?.watched }} watched</span>
          @elseif(snapshot())
            <span class="status-dot" aria-hidden="true"></span>
            <span>Daemon stopped</span>
          @else
            <span>Connecting…</span>
          @endif
        </p>
      </div>
    </div>
    <button class="px-2 py-1 text-xs rounded-lg plain secondary" type="button" @click="pane() === 'overview' ? refreshStatus() : refreshPantry()">Refresh</button>
  </header>
  <nav aria-label="Buddy views" class="flex gap-2 px-4 py-2 border-b line">
    <button type="button" class="px-3 py-1 font-medium text-xs rounded-md tab" :class="pane() === 'overview' ? 'accent' : 'plain secondary'" :aria-pressed="pane() === 'overview'" @click="openPane('overview')">Overview</button>
    <button type="button" class="px-3 py-1 font-medium text-xs rounded-md tab" :class="pane() === 'pantry' ? 'accent' : 'plain secondary'" :aria-pressed="pane() === 'pantry'" @click="openPane('pantry')">Pantry</button>
  </nav>

  <div class="overflow-y-auto flex-1 px-4 py-3 min-h-0">
  @if(pane() === 'pantry')
    @if(!pantry())
      <p role="status" class="secondary">Connecting to Pantry…</p>
    @elseif(pantry()?.state === 'offline')
      <h2 class="mb-2 font-semibold text-sm">Pantry is unavailable</h2>
      <p class="mb-2 secondary">{{ pantry()?.issue }}</p>
      <p>Start Pantry Desktop in Terminal with <code>pantry desktop setup --yes</code>, then refresh.</p>
    @elseif(pantry()?.state === 'pair')
      <h2 class="mb-2 font-semibold text-sm">Connect Pantry</h2>
      <p class="mb-2 secondary">Run <code>pantry desktop pair</code> in Terminal and enter the eight-digit code.</p>
      <form class="flex gap-2" @submit.prevent="pantryAction({ action: 'pantry:pair', code: pairingCode() })">
        <input class="flex-1 px-2 py-1 min-w-0 border rounded-lg line search surface" aria-label="Pairing code" inputmode="numeric" maxlength="8" :value="pairingCode()" @input="pairingCode.set($event.target.value)" />
        <button class="px-3 py-1 font-medium accent rounded-md tab" :disabled="pairingCode().length !== 8 || busy() !== ''">Pair</button>
      </form>
    @else
      <form class="flex gap-2 mb-3" @submit.prevent="searchCatalog()">
        <input class="flex-1 px-2 py-1 min-w-0 border rounded-lg line search surface" type="search" aria-label="Find a Pantry package" placeholder="Find a package" :value="packageSearch()" @input="packageSearch.set($event.target.value); matches.set([]); searched.set(false)" />
        <button class="px-3 py-1 font-medium accent rounded-md tab" :disabled="packageSearch().trim().length < 2">Find</button>
      </form>
      @if(searched())
        <h2 class="mb-2 font-semibold text-sm">Catalog</h2>
        @foreach(matches() as pkg)
          <div class="flex gap-2 items-center justify-between px-2 py-1 border-b line">
            <div class="min-w-0"><p class="truncate">{{ pkg.name }}</p><p class="text-xs truncate secondary">{{ pkg.domain }}</p></div>
            <button type="button" class="shrink-0 px-2 py-1 text-xs accent rounded-md tab" :disabled="busy() !== '' || packageChanging(pkg.domain)" @click="changePackage('pantry:install', pkg.domain)">Install</button>
          </div>
        @endforeach
        @if(!matches().length)
          <p class="secondary">No catalog matches.</p>
        @endif
      @endif
      @if(packageJobs().length)
        <h2 class="mb-2 mt-3 font-semibold text-sm">Activity</h2>
        @foreach(packageJobs().slice(0, 3) as job)
          <p class="flex gap-2 justify-between text-xs secondary" :title="job.error || ''"><span class="truncate">{{ job.domain }}</span><span>{{ job.status }}</span></p>
        @endforeach
      @endif
      <h2 class="mb-2 mt-3 font-semibold text-sm">Installed</h2>
      @foreach(installed() as pkg)
        <div class="flex gap-2 items-center justify-between px-2 py-1 border-b line">
          <p class="min-w-0 truncate" :title="pkg.name">{{ pkg.name }} <span class="text-xs secondary">{{ pkg.version }}</span></p>
          @if(pantry()?.removal && pkg.managed)
            @if(removal() === pkg.name)
              <button type="button" class="shrink-0 px-2 py-1 text-xs rounded-md plain" @click="removal.set('')">Cancel</button>
              <button type="button" class="shrink-0 px-2 py-1 text-xs rounded-md issue plain" :disabled="busy() !== '' || packageChanging(pkg.name)" @click="changePackage('pantry:uninstall', pkg.name)">Confirm</button>
            @else
              <button type="button" class="shrink-0 px-2 py-1 text-xs rounded-md plain secondary" :aria-label="'Remove ' + pkg.name" @click="removal.set(pkg.name)">Remove</button>
            @endif
          @endif
        </div>
      @endforeach
      @if(!installed().length)
        <p class="secondary">No installed packages match.</p>
      @endif
      <button type="button" class="mt-3 px-2 py-1 text-xs rounded-md plain secondary" :disabled="busy() !== ''" @click="pantryAction({ action: 'pantry:disconnect' })">Disconnect Pantry</button>
    @endif
  @else
    @if(unavailable())
      <p class="py-3 secondary" role="status">Buddy’s local connection was interrupted. Refresh to reconnect.</p>
    @elseif(snapshot())
      @if(system())
        <section aria-label="System usage" class="grid gap-2 grid-cols-2 mb-3">
          <div class="p-2 border rounded-xl line surface">
            <p class="flex items-center justify-between mb-1"><span class="text-xs secondary">CPU</span><strong>{{ system()?.cpu == null ? '—' : system()?.cpu + '%' }}</strong></p>
            <progress class="meter" aria-label="CPU utilization" max="100" :value="system()?.cpu ?? 0"></progress>
          </div>
          <div class="p-2 border rounded-xl line surface">
            <p class="flex items-center justify-between mb-1" :title="system()?.memory.raw ? 'RAM in use, including cache' : 'Active, wired, and compressed memory'"><span class="text-xs secondary">RAM</span><strong>{{ gib(system()?.memory.used ?? 0) }} / {{ gib(system()?.memory.total ?? 0) }} GiB</strong></p>
            <progress class="meter" aria-label="Memory in use" :max="system()?.memory.total" :value="system()?.memory.used"></progress>
          </div>
        </section>
      @endif
      @if(!snapshot()?.online)
        <button type="button" class="mb-3 px-3 py-2 font-medium accent rounded-lg plain" :disabled="busy() !== ''" @click="perform('start')">Start daemon</button>
      @endif
      <section aria-labelledby="pending-heading" class="mb-4">
        <div class="flex items-center justify-between mb-2">
          <h2 id="pending-heading" class="font-semibold text-sm">Pending approvals</h2>
          @if(pending().length)
            <span class="px-2 py-0.5 font-semibold text-xs accent rounded-full">{{ pending().length }}</span>
          @endif
        </div>
        @if(pending().length)
          <ul class="m-0 p-0 list-none border divide-y rounded-xl line surface">
            @foreach(pending() as project)
              <li class="flex gap-3 items-center justify-between px-3 py-2">
                <div class="min-w-0">
                  <p class="font-medium truncate" :title="project.path">{{ project.name }}</p>
                  <p class="text-xs secondary">{{ project.pending }} generated {{ project.pending === 1 ? 'file' : 'files' }}</p>
                </div>
                <button type="button" class="shrink-0 px-2.5 py-1 font-medium text-xs accent border-0 rounded-md" :disabled="busy() !== ''" @click="perform('review', project.id)">Review</button>
              </li>
            @endforeach
          </ul>
        @else
          <p class="px-3 py-2.5 border rounded-xl line secondary surface">You’re caught up.</p>
        @endif
      </section>

      <section aria-labelledby="projects-heading">
        <h2 id="projects-heading" class="mb-2 font-semibold text-sm">{{ filter() ? 'Matching projects' : 'Recent projects' }}</h2>
        @if(snapshot()?.projects.length > 6)
          <input type="search" aria-label="Find a project" placeholder="Find a project" class="mb-2 px-2.5 py-1.5 w-full border rounded-lg line search surface" :value="filter()" @input="filter.set($event.target.value)" />
        @endif
        @if(recent().length)
          <ul class="m-0 p-0 list-none border rounded-xl line surface">
            @foreach(recent() as project)
              <li class="flex gap-3 items-center justify-between px-3 py-1.5 border-b last:border-b-0 line">
                <div class="min-w-0">
                  <p class="truncate" :title="project.path">{{ project.name }}</p>
                  @if(project.issue)
                    <p class="text-xs truncate issue" :title="project.issue">{{ project.issue }}</p>
                  @endif
                </div>
                <button type="button" class="shrink-0 px-2 py-1 text-xs rounded-md plain secondary" :disabled="busy() !== ''" @click="perform('dashboard', project.id)">Dashboard ↗</button>
              </li>
            @endforeach
          </ul>
        @else
          <p class="secondary">{{ filter() ? 'No projects match your search.' : 'Run Buddy in a Stacks project to add it here.' }}</p>
        @endif
      </section>
    @else
      <p class="py-3 secondary" role="status">Loading projects…</p>
    @endif
  @endif
  </div>

  <footer class="flex gap-3 items-center justify-between shrink-0 px-4 py-2 border-t line">
    <p class="min-w-0 text-xs secondary" role="status">{{ notice() || (snapshot()?.failed ? snapshot()?.failed + (snapshot()?.failed === 1 ? ' generation issue' : ' generation issues') : '') }}</p>
    <button type="button" class="shrink-0 px-2 py-1 text-xs rounded-md plain secondary" :disabled="busy() !== ''" @click="perform('quit')">Quit Buddy</button>
  </footer>
</main>
