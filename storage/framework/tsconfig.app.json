      "stacks/notifications": ["./core/notifications/src/index.ts"],
      "stacks/objects": ["./core/objects/src/index.ts"],
      "stacks/orm": ["./core/orm/src/index.ts"],
      "stacks/path": ["./core/path/src/index.ts"],
      "stacks/payments": ["./core/payments/src/index.ts"],
      "stacks/push": ["./core/push/src/index.ts"],
      "stacks/query-builder": ["./core/query-builder/src/index.ts"],
      "stacks/queue": ["./core/queue/src/index.ts"],
      "stacks/realtime": ["./core/realtime/src/index.ts"],
      "stacks/repl": ["./core/repl/src/index.ts"],
      "stacks/router": ["./core/router/src/index.ts"],
      "stacks/scheduler": ["./core/scheduler/src/index.ts"],
      "stacks/search-engine": ["./core/search-engine/src/index.ts"],
      "stacks/security": ["./core/security/src/index.ts"],
      "stacks/server": ["./core/server/src/index.ts"],
      "stacks/skills": ["./core/skills/src/index.ts"],
      "stacks/slug": ["./core/slug/src/index.ts"],
      "stacks/sms": ["./core/sms/src/index.ts"],
      "stacks/storage": ["./core/storage/src/index.ts"],
      "stacks/strings": ["./core/strings/src/index.ts"],
      "stacks/testing": ["./core/testing/src/index.ts"],
      "stacks/tinker": ["./core/tinker/src/index.ts"],
      "stacks/tunnel": ["./core/tunnel/src/index.ts"],
      "stacks/types": ["./core/types/src/index.ts"],
      "stacks/ui": ["./core/ui/src/index.ts"],
      "stacks/utils": ["./core/utils/src/index.ts"],
      "stacks/validation": ["./core/validation/src/index.ts"],
      "stacks/video": ["./core/video/src/index.ts"],
      "buddy": ["./core/buddy/src/index.ts"],
      "buddy/*": ["./core/buddy/src/*"],
      "Actions/*": ["../../app/Actions/*"],
      "Commands/*": ["../../app/Commands/*"],
      "Jobs/*": ["../../app/Jobs/*"],
      "Middleware/*": ["../../app/Middleware/*"],
      "Models/*": ["../../app/Models/*"],
      "Notifications/*": ["../../app/Notifications/*"],
      "~/*": ["../../*"],
      "@/*": ["../../resources/*"],
      "/__deps/charts.js": ["./core/charts/src/index.ts"]
    }
  },
  // Only the four directories you author, plus the generated framework
  // declarations (auto-imports, ORM globals, model attributes) they rely on.
  // Keeping this list tight is the single biggest lever on check time.
  "include": [
    "./types/**/*.d.ts",
    // The generated table shapes, from `buddy generate:db-types`. Without this
    // the augmentation is written and never loaded, so `db.selectFrom('users')`
    // answers the framework's default `users` - or an unknown-valued record -
    // and an application's own columns are invisible to the compiler.
    "../../database/types.d.ts",
    "../../app/**/*.ts",
    "../../config/**/*.ts",
    "../../resources/**/*.ts",
    "../../routes/**/*.ts"
  ],
  "exclude": [
    "../../cloud/**",
    "../../dist/**",
    "../../node_modules/**",
    "../../pantry/**",
    "../../resources/assets/**"
  ]
}
