{
  // Framework-provided defaults for YOUR application code: `app/`, `config/`,
  // `resources/` and `routes/`. The project's root `tsconfig.json` extends this
  // file, so everything set here applies unless the root overrides it.
  //
  // Framework internals are checked separately, by `tsconfig.framework.json`.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // The globals a `.stx` page is checked against beyond the stx runtime's
    // own: `requestContext` is installed by the dev and production servers,
    // not by stx, so neither checker can know it unless told. Both read this
    // list - `stx typecheck` (and so `bun run typecheck:views`) and the stx
    // extension's TypeScript plugin in the editor - so a page cannot pass one
    // and fail the other (stacksjs/stx#2028). Paths are relative to this file.
    "plugins": [
      { "name": "@stacksjs/stx-typescript-plugin", "libs": ["./types/request-context.d.ts"] }
    ],
    // App code runs on both the server and in the browser (stx templates,
    // stores, composables), so DOM types sit on top of the base `esnext` lib.
    "lib": ["esnext", "dom"],
    "rootDir": "../..",
    // Deliberately NOT incremental, unlike the framework's own projects.
    //
    // `tsc`'s incremental state goes stale across the regeneration of the
    // auto-import barrels, and it does so in the direction that matters: after
    // removing a job and running `buddy generate`, a warm cache reported ZERO
    // errors on an app whose `Scheduler.ts` still scheduled the deleted job -
    // the exact diagnostic `SchedulableJobs` exists to produce. Cold, the same
    // tree reports it. Neither half does this alone: deleting the file alone is
    // caught, editing the barrel alone is caught; only the combination loses
    // it, and it goes stale in both directions.
    //
    // The trade is not close. Measured on this project: cold 3.3s, warm 1.9s
    // raw, and through `buddy typecheck` the difference is inside the noise of
    // CLI boot. A second and a half is not worth a check that can pass on code
    // that does not compile, in precisely the workflow that produces the
    // mistake - delete an example job, regenerate, typecheck, ship.
    //
    // The framework's own projects keep the cache, where it saves considerably
    // more; `generateAutoImportFiles()` drops their build-info files whenever it
    // rewrites a barrel. stacksjs/stacks#2405.
    "incremental": false,
    "paths": {
