      "stacks/search-engine": ["./core/search-engine/src/index.ts"],
      "stacks/security": ["./core/security/src/index.ts"],
      "stacks/server": ["./core/server/src/index.ts"],
      "stacks/skills": ["./core/skills/src/index.ts"],
      "stacks/slug": ["./core/slug/src/index.ts"],
      "stacks/sms": ["./core/sms/src/index.ts"],
      "stacks/storage": ["./core/storage/src/index.ts"],
      "stacks/strings": ["./core/strings/src/index.ts"],
      "stacks/support": ["./core/support/src/index.ts"],
      "stacks/testing": ["./core/testing/src/index.ts"],
      "stacks/tinker": ["./core/tinker/src/index.ts"],
      "stacks/tunnel": ["./core/tunnel/src/index.ts"],
      "stacks/types": ["./core/types/src/index.ts"],
      "stacks/ui": ["./core/ui/src/index.ts"],
      "stacks/utils": ["./core/utils/src/index.ts"],
      "stacks/validation": ["./core/validation/src/index.ts"],
      "stacks/video": ["./core/video/src/index.ts"],
      "buddy": ["./core/buddy/src/index.ts"],
      "buddy/*": ["./core/buddy/src/*"],
      "Actions/*": ["../../app/Actions/*"],
      "Commands/*": ["../../app/Commands/*"],
      "Jobs/*": ["../../app/Jobs/*"],
      "Middleware/*": ["../../app/Middleware/*"],
      "Models/*": ["../../app/Models/*"],
      "Notifications/*": ["../../app/Notifications/*"],
      "~/*": ["../../*"],
      "@/*": ["../../resources/*"],
      "ts-pantry": ["../../node_modules/ts-pantry"],
      "*": ["../../node_modules/*","../../pantry/*"]
    }
  },
  "include": [
    "./**/*.ts",
    "./**/*.d.ts"
  ],
  "exclude": [
    "./**/cdk.out/**",
    "./**/dist/**",
    "./**/fixtures/**",
    "./**/out/**",
    "./**/tests/**",
    "./**/*.test.ts",
    "./**/*.spec.ts",
    "./**/build.ts",
    "./auto-imports/**",
    "./core/deploy/**",
    // `@stacksjs/defaults` copies the whole of `defaults/` into `core/defaults/`
    // at build time, plus a `project/` tree of root support files. Those copies
    // are generated, gitignored duplicates that resolve their imports from the
    // wrong directory, so checking them reports phantom errors about code that
    // is already checked where it actually lives. Worse than noise: the copied
    // `project/.../model-events.d.ts` augments the real `@stacksjs/events`
    // module from a place where its models barrel does not exist, so the event
    // map widened to an index signature and every model event failed TS2411 -
    // 816 errors after any local build, on a tree CI never builds. Excluded
    // whole; the package's own tracked files are its build script (excluded
    // above) and its tests (excluded above).
    "./core/defaults/**",
    "./core/models/**",
    "./core/requests/**",
    // The source of the two directories above. Checked by
    // `tsconfig.defaults.json`, which resolves it as the app code it becomes
    // once `<feature>:install` publishes it. (This note used to claim it was
    // "checked as part of the app" - the app config never included the path,
    // so nothing checked this tree at all and it drifted for months.)
    "./defaults/**",
    "./frontend-dist/**",
    "./libs/packages/**",
    // Runtime state, not source: stx's build cache and the CLI's scratch
    // directory. Both are gitignored and can be deleted at any time.
    "./stx/**",
    "./runtime/**",
    "./.cache/**",
    "./server/app/**",
    "./server/config/**",
    "./server/core/**",
    "./server/docs/**",
    "./server/routes/**",
    "./server/storage/**",
    "./views/**"
  ]
}
