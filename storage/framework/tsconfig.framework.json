{
  // Type checks the framework itself - everything under `storage/framework/`.
  // Application code is checked separately, by the project's root
  // `tsconfig.json` (which extends `tsconfig.app.json`).
  //
  // Run it with: bun run typecheck
  //
  // Extends the BASE, not `core/tsconfig.json`, and carries its own path map.
  // An installed app has no `core/` directory: `extends` pointed at a file that
  // was not there, TypeScript reported one TS5083 and then silently dropped
  // every option the base sets — `skipLibCheck` included — so `bun run
  // typecheck` in an app turned into a full type-check of node_modules and
  // reported 265 errors, none of them in the app's own code. Paths that do not
  // resolve are harmless: TypeScript falls back to node resolution, which is
  // how an app finds `@stacksjs/*` in node_modules.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "rootDir": "../..",
    "tsBuildInfoFile": "./.cache/typescript/framework.tsbuildinfo",
    "paths": {
      // Generated workspace identities and public exports. Run bun .github/scripts/generate-workspace-aliases.ts.
