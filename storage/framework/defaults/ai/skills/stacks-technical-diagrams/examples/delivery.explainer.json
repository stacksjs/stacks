  "meta": {
    "title": "缓存未命中时，请求为什么变慢？",
    "id": "mechanism",
    "locale": "zh-CN"
  },
  "answer": {
    "summary": "缓存未命中后，请求要多等**数据库查询和同步写回缓存**两段。",
    "reasons": [
      "命中时，接口读到缓存值就能返回。",
      "未命中时，接口必须先拿到数据库结果。",
      "同步写回位于响应之前，写完缓存才能结束请求。"
    ],
    "scope": "示例采用旁路缓存：GET返回空值后查询PostgreSQL，查询成功后同步SET再响应；无并行、重试或其他缓存层。未实测耗时，具体慢多少由链路测量决定。"
  },
  "panels": [
    {
      "id": "timeline",
      "title": "一次未命中，时间花在哪？",
      "blocks": [
        {
          "type": "steps",
          "id": "cache-path-steps",
          "items": [
            {
              "id": "get-step",
              "text": "读取缓存",
              "detail": "GET返回空值，接口继续向数据库查询。[](source:get-doc)"
            },
            {
              "id": "query-step",
              "text": "查询PostgreSQL",
              "detail": "等待数据库执行SQL并返回结果。"
            },
            {
              "id": "set-step",
              "text": "同步写回Redis",
              "detail": "SET完成后，接口返回响应。[](source:set-doc)"
            }
          ]
        }
      ]
    },
