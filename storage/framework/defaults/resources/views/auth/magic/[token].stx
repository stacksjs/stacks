<script server>
import { config } from '@stacksjs/config'

/**
 * Where a magic sign-in link lands, at `/auth/magic/{token}`.
 *
 * The logic sits in the component rather than here. As a page-level
 * `<script client>` it combined `useRef` with a top-level `effect`, and that
 * pair leaves an stx page inert: the setup registers, no directive binds, and
 * the page renders perfectly while its button does nothing. Either alone is
 * fine, and a component's script binds regardless - which is also how every
 * other auth page here is built.
 *
 * `autoConsume` is passed as an attribute because it is a server decision a
 * client script cannot read.
 */
const autoConsume = config.auth.magicLink?.confirmInteraction !== true
</script>

<MagicLink autoConsume="{{ autoConsume }}" />
