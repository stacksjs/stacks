<script server>
const appName = props.appName || 'Stacks'
const teamName = props.teamName || 'a team'
const role = props.role || 'member'
const invitationUrl = props.invitationUrl || '#'
const expiresInDays = props.expiresInDays || 7
const primaryColor = props.primaryColor || '#2563eb'
const subject = props.subject || `You are invited to join ${teamName}`
const year = props.year || new Date().getFullYear()
</script>

<EmailLayout title="{{ subject }}">
  <template #header>
    <tr>
      <td style="background-color:{{ primaryColor }};padding:30px 40px;text-align:center;">
        <h1 style="margin:0;color:#ffffff;font-size:24px;font-weight:600;">{{ appName }}</h1>
      </td>
    </tr>
  </template>

  <EmailText size="heading">Join {{ teamName }}</EmailText>
  <EmailText>You have been invited to join <strong>{{ teamName }}</strong> as a <strong>{{ role }}</strong>.</EmailText>

  <EmailButton href="{{ invitationUrl }}" bg="{{ primaryColor }}">Accept Invitation</EmailButton>

  <EmailText size="sm" color="#6b7280">This invitation expires in <strong>{{ expiresInDays }} days</strong> and can only be used by this email address.</EmailText>
  <EmailText size="sm" color="#6b7280">If you were not expecting this invitation, you can safely ignore this email.</EmailText>

  <EmailDivider />
  <EmailText size="sm" color="#9ca3af" spacing="8px">If the button above does not work, copy and paste this URL into your browser:</EmailText>
  <p style="margin:0;word-break:break-all;">
    <EmailLink href="{{ invitationUrl }}" color="{{ primaryColor }}">{{ invitationUrl }}</EmailLink>
  </p>

  <template #footer>
    <tr>
      <td style="padding:20px 40px;background-color:#f9fafb;border-top:1px solid #e5e7eb;">
        <p style="margin:0;color:#6b7280;font-size:12px;text-align:center;">This is an automated message from {{ appName }}. Please do not reply to this email.</p>
        <p style="margin:10px 0 0 0;color:#9ca3af;font-size:11px;text-align:center;">&copy; {{ year }} {{ appName }}. All rights reserved.</p>
      </td>
    </tr>
  </template>
</EmailLayout>
