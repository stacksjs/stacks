<script server>
// The default welcome for a newsletter signup, sent by SubscriptionConfirmation
// (defaults/app/Mail) when someone subscribes through /api/email/subscribe.
//
// It speaks for the app, not for Stacks: the name and address come from the
// app's config. It used to describe Stacks as "a rapid application development
// framework" in every app's welcome email. An app overrides it with its own
// resources/emails/subscription-confirmation.stx.
const email = props.email || ''
const unsubscribeUrl = props.unsubscribeUrl || '#'
const appName = props.appName || 'our newsletter'
const appUrl = props.appUrl || ''
const primaryColor = props.primaryColor || '#3451b2'
const year = props.year || new Date().getFullYear()
const subject = `You are on the ${appName} list`
</script>

<EmailLayout title="{{ subject }}" preheader="Thanks for subscribing to {{ appName }}." brand="{{ appName }}" brandUrl="{{ appUrl }}" accent="{{ primaryColor }}">
  <EmailText size="heading">Thanks for subscribing.</EmailText>
  <EmailText>You are on the {{ appName }} list. We will write when there is something worth reading, and never more than that.</EmailText>

  @if (appUrl)
    <EmailButton href="{{ appUrl }}" bg="{{ primaryColor }}">Visit {{ appName }}</EmailButton>
  @endif

  <EmailDivider />
  <EmailText size="sm" spacing="0">You are getting this because {{ email }} subscribed. Changed your mind? <a href="{{ unsubscribeUrl }}" style="color:#71717a;text-decoration:underline;">Unsubscribe</a> in one click.</EmailText>

  <template #footer>
    <tr>
      <td class="email-muted" style="padding:16px 40px 20px;border-top:1px solid #e4e4e7;color:#a1a1aa;font-size:11px;text-align:center;">&copy; {{ year }} {{ appName }}</td>
    </tr>
  </template>
</EmailLayout>
