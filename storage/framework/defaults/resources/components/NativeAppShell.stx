<div data-native-app-shell class="native-app-shell {{ className }}">
  <main class="native-app-content">
    <slot />
  </main>
  @if(tabBar)
    <footer class="native-app-tab-slot">
      <slot name="tab-bar" />
    </footer>
  @endif
</div>

<style>
  .native-app-shell {
    min-height: 100dvh;
    color: inherit;
