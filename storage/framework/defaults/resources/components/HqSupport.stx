<script client>
import { mountNativeSupport } from '@stacksjs/support/browser'
import type { NativeSupportMount } from '@stacksjs/support/browser'
import { useAuth } from '@stacksjs/browser'

const supportHost = useRef('supportHost')
let mountedSupport: NativeSupportMount | undefined
onMount(() => {
  const auth = useAuth()
  mountedSupport = mountNativeSupport(supportHost.current as HTMLElement, { getToken: auth.getToken, fetch: auth.authFetch })
  void mountedSupport.refresh()
})
onDestroy(() => mountedSupport?.shutdown())
</script>

<div ref="supportHost" data-hq-support-native></div>
