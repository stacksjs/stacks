<script client>
import { observeNativeRefresh, observePullToRefresh, refresh, resolveScrollHost, whenBridgeReady } from '@stacksjs/mobile'

/**
 * Pull the page down from its top to refresh it.
 *
 * In Craft's iOS shell this is the phone's own UIRefreshControl, the spinner
 * and the feel of every native list. Elsewhere, and on a shell without it,
 * the web gesture draws the same thing: the 12-spoke activity indicator
 * revealed spoke by spoke above the content as it is pulled, a haptic tap at
 * the threshold, the content held down under the spinning indicator while
 * refreshing, and eased back up when done.
 *
 * The `refresh` event carries `done()`: call it when the new data is in. A
 * handler that never calls it is let go after 15 seconds. `scrollHost` names
 * (by CSS selector) a container the screen scrolls in instead of the page;
 * the native control covers only the page, so a scroll host uses the gesture.
 */
const emit = defineEmits()
const threshold = useReactiveProp<number>('threshold', 72)
const label = useReactiveProp<string>('label', 'Refreshing')
const scrollHost = useReactiveProp<string>('scrollHost', '')
const tint = useReactiveProp<string>('tint', '')
const distance = state(0)
const bounce = state(0)
const armed = state(false)
const refreshing = state(false)
const ptr = useRef('nativePtr')
let stop: (() => void) | null = null
let destroyed = false

// The height the content is held down by while refreshing: the indicator's.
const HOLD = 56

function run(): Promise<void> {
  return new Promise<void>((resolve) => {
    refreshing.set(true)
    const finish = (): void => {
      clearTimeout(timer)
      refreshing.set(false)
      resolve()
    }
    const timer = setTimeout(finish, 15000)
    emit('refresh', { done: finish })
  })
}

function useGesture(): void {
  stop = observePullToRefresh({
    threshold: threshold(),
    host: resolveScrollHost(scrollHost()),
    onPull: (pulled, isArmed, pull) => {
      distance.set(pulled)
      bounce.set(pull.bounce)
      armed.set(isArmed)
    },
    onRefresh: run,
  })
}

onMount(() => {
  const element = ptr.current as HTMLElement | null
  // Decided once the bridge can answer, so the phone never runs both.
  void whenBridgeReady(3000).then(() => {
    if (destroyed) return
    if (element && !scrollHost() && refresh.isAvailable()) {
      // The native spinner draws itself; the page only refreshes.
      stop = observeNativeRefresh(element, {
        tintColor: tint() || undefined,
        onRefresh: () => new Promise<void>((resolve) => {
          const timer = setTimeout(resolve, 15000)
          const finish = (): void => {
            clearTimeout(timer)
            resolve()
          }
          emit('refresh', { done: finish })
        }),
      })
    }
    else {
      useGesture()
    }
  })
})
onDestroy(() => {
  destroyed = true
  stop?.()
})

const ptrClass = derived(() => {
  const pulling = !refreshing() && distance() > 0
  return `${pulling ? 'is-pulling' : ''}${refreshing() ? ' is-refreshing' : ''}${armed() ? ' is-armed' : ''}${refreshing() || distance() > 4 ? ' is-visible' : ''}`.trim()
})
// iOS's rubber band already moves the page by `bounce`; the content moves by
// the rest. While refreshing it is held under the indicator.
const ptrStyle = derived(() => {
  const shift = refreshing() ? HOLD : Math.max(0, distance() - bounce())
  const progress = refreshing() ? 1 : Math.min(1, distance() / Math.max(1, threshold()))
  return `--native-ptr-shift:${Math.round(shift)}px;--native-ptr-progress:${progress.toFixed(3)}`
})
</script>

<div ref="nativePtr" class="native-ptr" :class="ptrClass()" :style="ptrStyle()" data-native-ptr>
  <div class="native-ptr-indicator" role="status" :aria-label="refreshing() ? label() : ''">
    <span class="native-ptr-spinner" aria-hidden="true">
      <span class="native-ptr-spoke" style="--i: 0"></span>
      <span class="native-ptr-spoke" style="--i: 1"></span>
      <span class="native-ptr-spoke" style="--i: 2"></span>
      <span class="native-ptr-spoke" style="--i: 3"></span>
      <span class="native-ptr-spoke" style="--i: 4"></span>
      <span class="native-ptr-spoke" style="--i: 5"></span>
      <span class="native-ptr-spoke" style="--i: 6"></span>
      <span class="native-ptr-spoke" style="--i: 7"></span>
      <span class="native-ptr-spoke" style="--i: 8"></span>
      <span class="native-ptr-spoke" style="--i: 9"></span>
      <span class="native-ptr-spoke" style="--i: 10"></span>
      <span class="native-ptr-spoke" style="--i: 11"></span>
    </span>
  </div>
  <div class="native-ptr-content">
    <slot />
  </div>
</div>

<style>
  .native-ptr { position: relative; }

  /* Under the navigation bar, in the gap the pulled content opens. */
  .native-ptr-indicator {
    position: fixed;
    top: calc(env(safe-area-inset-top, 0px) + var(--native-ptr-top, 3.25rem));
    left: 50%;
    z-index: 25;
    width: 1.75rem;
    height: 1.75rem;
    margin-left: -0.875rem;
    color: var(--native-ptr-color, rgb(142 142 147));
    opacity: 0;
    pointer-events: none;
    transform: scale(0.85);
    transition: opacity 200ms ease, transform 200ms ease;
  }

  .native-ptr.is-visible .native-ptr-indicator { opacity: 1; transform: none; }
  .native-ptr.is-pulling .native-ptr-indicator { transition: none; }

  .native-ptr-spinner { position: absolute; inset: 0; }

  /* Twelve rounded spokes round a centre, as UIActivityIndicatorView draws. */
  .native-ptr-spoke {
    position: absolute;
    top: 0;
    left: 50%;
    width: 9%;
    height: 28%;
    margin-left: -4.5%;
    border-radius: 999px;
    background: currentColor;
    transform: rotate(calc(var(--i) * 30deg));
    transform-origin: 50% 178%;
    /* Revealed one by one as the pull goes on. */
    opacity: clamp(0, calc(var(--native-ptr-progress, 0) * 12 - var(--i)), 1);
  }

  .native-ptr.is-refreshing .native-ptr-spoke {
    opacity: 0.25;
    animation: native-ptr-spoke 1s linear infinite;
    animation-delay: calc(var(--i) * (1s / 12) - 1s);
  }

  @keyframes native-ptr-spoke {
    from { opacity: 1; }
    to { opacity: 0.25; }
  }

  /* The content follows the finger, is held while refreshing, and eases back.
     Transformed only while it is moved: a transform at rest, even a zero
     one, would become the containing block of every fixed element on the
     page. */
  .native-ptr-content { transition: transform 380ms cubic-bezier(0.32, 0.72, 0, 1); }

  .native-ptr:is(.is-pulling, .is-refreshing) .native-ptr-content {
    transform: translateY(var(--native-ptr-shift, 0px));
  }

  .native-ptr.is-pulling .native-ptr-content { transition: none; }

  @media (prefers-reduced-motion: reduce) {
    .native-ptr.is-refreshing .native-ptr-spoke { animation-duration: 3s; }
    .native-ptr-content { transition-duration: 1ms; }
  }

  :root[data-native-reduce-motion] .native-ptr.is-refreshing .native-ptr-spoke { animation-duration: 3s; }
</style>
