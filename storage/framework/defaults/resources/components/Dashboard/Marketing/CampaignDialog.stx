<script client>
import type {
  CampaignListOption,
  CampaignRecord,
  CampaignStatus,
  CampaignType,
} from '../../../../app/Actions/Dashboard/Marketing/campaign-records'
import { minorToInput, moneyInputError, moneyInputStep, parseMoneyInput } from '@stacksjs/commerce/money'

const open = useReactiveProp('open', false)
const mode = useReactiveProp('mode', 'add')
const record = useReactiveProp('record', null as CampaignRecord | null)
const lists = useReactiveProp('lists', [] as CampaignListOption[])
const defaultCurrency = useReactiveProp('defaultCurrency', 'USD')
const busy = useReactiveProp('busy', false)
const error = useReactiveProp('error', '')
const emit = defineEmits(['submit', 'close'])
const name = state('')
// Not `description`: a field bound inside the Modal is first read as the
// Modal's own `description` prop (stacksjs/stacks#3310).
const descriptionText = state('')
const type = state<CampaignType>('email')
const status = state<CampaignStatus>('draft')
const subject = state('')
const template = state('')
const text = state('')
const fromName = state('')
const fromAddress = state('')
const emailListId = state('')
const scheduledAt = state('')
// Budget and spend as typed, in major units of `currency`. The record and
// the API hold integer minor units (1999 is $19.99), converted at this
// boundary through @stacksjs/commerce/money.
const budget = state('')
const spent = state('0')
const currency = state('USD')
const startDate = state('')
const endDate = state('')
const canSubmit = derived(() => {
  if (!name().trim())
    return false
  if (budgetError() || spentError())
    return false
  return type() !== 'email'
    || Boolean(subject().trim() && template().trim() && emailListId())
})
let hydrationKey = ''

function localDateTime(value: string): string {
  return value ? value.replace(' ', 'T').slice(0, 16) : ''
}

function databaseDateTime(value: string): string {
  return value ? `${value.replace('T', ' ')}:00` : ''
}

effect(() => {
  if (!open()) {
    hydrationKey = ''
    return
  }
  const current = record()
  const key = `${mode()}:${current?.id || 'new'}`
  if (hydrationKey === key)
    return
  hydrationKey = key
  name.set(current?.name || '')
  descriptionText.set(current?.description || '')
  type.set(current?.type || 'email')
  status.set(current?.status || 'draft')
  subject.set(current?.subject || '')
  template.set(current?.template || '')
  text.set(current?.text || '')
  fromName.set(current?.fromName || '')
  fromAddress.set(current?.fromAddress || '')
  emailListId.set(current?.emailListId || '')
  scheduledAt.set(localDateTime(current?.scheduledAt || ''))
  const recordCurrency = current?.currency || defaultCurrency()
  budget.set(current?.budget ? minorToInput(current.budget, recordCurrency) : '')
  spent.set(minorToInput(current?.spent || 0, recordCurrency))
  currency.set(recordCurrency)
  startDate.set(localDateTime(current?.startDate || ''))
  endDate.set(localDateTime(current?.endDate || ''))
})

function budgetError(): string {
  return moneyInputError(budget(), currency(), { required: false })
}

function spentError(): string {
  return moneyInputError(spent(), currency(), { required: false })
}

/**
 * The statuses this campaign may be set to. An email campaign is scheduled,
 * sent and sending by its delivery, so those are shown only while it is one.
 */
const statusOptions = derived(() => {
  const email = type() === 'email'
  const current = status()
  return [
    { value: 'draft', label: 'Draft', shown: true },
    { value: 'scheduled', label: 'Scheduled', shown: !email },
    { value: 'active', label: 'Active', shown: !email },
    { value: 'paused', label: 'Paused', shown: true },
    { value: 'cancelled', label: 'Cancelled', shown: true },
    { value: 'failed', label: 'Failed', shown: true },
    { value: 'completed', label: 'Completed', shown: !email },
    { value: 'archived', label: 'Archived', shown: !email },
    { value: 'scheduled', label: 'Scheduled', shown: email && current === 'scheduled' },
    { value: 'sending', label: 'Sending', shown: email && current === 'sending' },
    { value: 'sent', label: 'Sent', shown: email && current === 'sent' },
  ].filter(option => option.shown).map(({ value, label }) => ({ value, label }))
})

function normalizeType(next: string): void {
  const nextType = next as CampaignType
  if (nextType === 'email')
    status.set('draft')
  else if (['sending', 'sent'].includes(status()))
    status.set('draft')
}

function submit(): void {
  if (!canSubmit())
    return
  const code = currency().trim().toUpperCase()
  emit('submit', {
    name: name().trim(),
    description: descriptionText().trim(),
    type: type(),
    status: type() === 'email' && mode() === 'add' ? 'draft' : status(),
    subject: subject().trim(),
    template: template().trim(),
    text: text().trim(),
    fromName: fromName().trim(),
    fromAddress: fromAddress().trim(),
    emailListId: emailListId() || null,
    scheduledAt: databaseDateTime(scheduledAt()) || null,
    budget: parseMoneyInput(budget(), code, { required: false }),
    spent: parseMoneyInput(spent(), code, { required: false }) ?? 0,
    currency: code,
    startDate: databaseDateTime(startDate()),
    endDate: databaseDateTime(endDate()),
  })
}
</script>

<Modal
  :isOpen="open()"
  :title="mode() === 'edit' ? 'Edit campaign' : 'Add campaign'"
  description="Persist campaign metadata through the Campaign model. Email delivery is started separately after review."
  size="xl"
  @close="emit('close')"
>
    <form id="campaign-form" @submit.prevent="submit">
        <div :if="error()" role="alert" class="mb-5 p-3 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">{{ error() }}</div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <Input v-model:value="name" label="Name" :minLength="3" :maxLength="255" :required="true" autocomplete="off" />
          </div>
          <div class="sm:col-span-2">
            <Textarea v-model:value="descriptionText" label="Description" :rows="2" :maxLength="1000" />
          </div>
          <Select v-model:value="type" label="Type" placeholder="" :options="[{ value: 'email', label: 'Email' }, { value: 'sms', label: 'SMS' }, { value: 'push', label: 'Push' }, { value: 'social', label: 'Social' }, { value: 'multi-channel', label: 'Multi-channel' }]" @change="normalizeType" />
          <Select v-model:value="status" label="Status" placeholder="" :options="statusOptions()" :disabled="type() === 'email' && (mode() === 'add' || ['scheduled', 'sending', 'sent'].includes(status()))" />

          <div :if="type() === 'email'" class="grid gap-4 sm:col-span-2 sm:grid-cols-2 p-4 bg-gray-50 dark:bg-neutral-900/50 border border-gray-200 rounded-lg dark:border-neutral-700">
            <div class="sm:col-span-2">
              <Select v-model:value="emailListId" label="Email list" :required="true" placeholder="Select a list" :options="lists().map(list => ({ value: list.id, label: list.name + ' - ' + list.activeMembers.toLocaleString() + ' active' }))" />
            </div>
            <div class="sm:col-span-2">
              <Input v-model:value="subject" label="Subject" :maxLength="255" :required="true" />
            </div>
            <div class="sm:col-span-2">
              <Textarea v-model:value="template" label="Template name or raw HTML" :rows="3" :required="true" :monospace="true" />
            </div>
            <div class="sm:col-span-2">
              <Textarea v-model:value="text" label="Plain-text fallback" :rows="3" />
            </div>
            <Input v-model:value="fromName" label="From name" :maxLength="100" />
            <Input v-model:value="fromAddress" label="From address" type="email" :maxLength="255" />
          </div>

          <div :if="status() === 'scheduled'" class="sm:col-span-2">
            <Input v-model:value="scheduledAt" label="Scheduled for" type="datetime-local" :required="true" :disabled="type() === 'email'" :hint="type() === 'email' ? 'Email scheduling is managed by the delivery pipeline.' : ''" />
          </div>

          <Input v-model:value="startDate" label="Starts" type="datetime-local" />
          <Input v-model:value="endDate" label="Ends" type="datetime-local" />
          <Input v-model:value="budget" label="Budget" type="number" min="0" :step="moneyInputStep(currency())" inputmode="decimal" :error="budgetError()" />
          <div class="grid gap-3 grid-cols-[1fr_7rem]">
            <Input v-model:value="spent" label="Spent" type="number" min="0" :step="moneyInputStep(currency())" inputmode="decimal" :error="spentError()" />
            <Input v-model:value="currency" label="Currency" :minLength="3" :maxLength="3" :required="true" class="uppercase" :spellcheck="false" />
          </div>
        </div>
    </form>
  <template #footer>
    <div class="flex gap-2 justify-end w-full">
        <Button :disabled="busy()" variant="secondary" @click="emit('close')">Cancel</Button>
        <Button type="submit" form="campaign-form" :disabled="busy() || !canSubmit()" :loading="busy()">
          {{ mode() === 'edit' ? 'Save campaign' : 'Add campaign' }}
        </Button>
    </div>
  </template>
</Modal>
