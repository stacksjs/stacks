<script client>
import type { MarketingListRecord } from '../../../../app/Actions/Dashboard/Marketing/marketing-list-records'

const open = useReactiveProp('open', false)
const record = useReactiveProp('record', null as MarketingListRecord | null)
const busy = useReactiveProp('busy', false)
const error = useReactiveProp('error', '')
const emit = defineEmits()
</script>

<div :if="open()" class="flex fixed inset-0 z-50 items-center justify-center p-4 dashboard-modal-layer">
  <button type="button" aria-label="Close delete email list dialog" class="absolute inset-0 bg-black/45" @click="emit('close')"></button>
  <section role="dialog" aria-modal="true" aria-labelledby="marketing-list-delete-title" class="relative p-6 max-w-md w-full bg-white dark:bg-neutral-800 border border-gray-200 rounded-xl dark:border-neutral-700 shadow-xl">
    <h2 id="marketing-list-delete-title" class="font-semibold text-gray-900 text-lg dark:text-white">Delete email list?</h2>
    <p class="mt-2 text-gray-600 text-sm dark:text-neutral-300"><span class="font-medium">{{ record()?.name }}</span> will be permanently removed.</p>
    <p :if="record()?.subscriberCount || record()?.campaignCount" class="mt-3 p-3 text-amber-800 text-sm dark:text-amber-200 bg-amber-50 dark:bg-amber-950/30 rounded-lg">This list has membership or campaign history. Archive it instead to preserve relationships.</p>
    <p :if="error()" role="alert" class="mt-3 p-3 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 rounded-lg">{{ error() }}</p>
    <footer class="flex gap-2 justify-end mt-6">
      <Button :disabled="busy()" variant="secondary" @click="emit('close')">Cancel</Button>
      <Button :disabled="busy() || Boolean(record()?.subscriberCount) || Boolean(record()?.campaignCount)" :loading="busy()" variant="danger" @click="emit('confirm')">
        Delete email list
      </Button>
    </footer>
  </section>
</div>
