<script client>
import type { SocialPostRecord } from '../../../../app/Actions/Dashboard/Marketing/social-post-records'

const open = useReactiveProp('open', false)
const record = useReactiveProp('record', null as SocialPostRecord | null)
const busy = useReactiveProp('busy', false)
const error = useReactiveProp('error', '')
const emit = defineEmits()
</script>

<div :if="open()" class="flex fixed inset-0 z-50 items-center justify-center p-4 dashboard-modal-layer">
  <button type="button" aria-label="Close delete social post dialog" class="absolute inset-0 bg-black/45" @click="emit('close')"></button>
  <section role="dialog" aria-modal="true" aria-labelledby="social-post-delete-title" class="relative p-6 max-w-md w-full bg-white dark:bg-neutral-800 border border-gray-200 rounded-xl dark:border-neutral-700 shadow-xl">
    <h2 id="social-post-delete-title" class="font-semibold text-gray-900 text-lg dark:text-white">Delete social post?</h2>
    <p class="mt-2 text-gray-600 text-sm dark:text-neutral-300">The persisted {{ record()?.platform }} post will be permanently removed. This does not remove a post already published on the external platform.</p>
    <p :if="error()" role="alert" class="mt-3 p-3 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 rounded-lg">{{ error() }}</p>
    <footer class="flex gap-2 justify-end mt-6">
      <Button :disabled="busy()" variant="secondary" @click="emit('close')">Cancel</Button>
      <Button :loading="busy()" variant="danger" @click="emit('confirm')">Delete social post</Button>
    </footer>
  </section>
</div>
