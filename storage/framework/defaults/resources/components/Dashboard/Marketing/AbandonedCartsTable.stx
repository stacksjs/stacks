@import('../UI/Table')

<script client>
import type { AbandonedCartRecord } from '../../../../app/Actions/Dashboard/Marketing/abandoned-cart-records'

const records = useReactiveProp('records', [] as AbandonedCartRecord[])
const loading = useReactiveProp('loading', false)
/** The parent's sort select: a change hands the order back from a header sort. */
const sortResetKey = useReactiveProp<unknown>('sortResetKey', '')
/** The parent's search and filters: a change returns to the first page. */
const pageResetKey = useReactiveProp<unknown>('pageResetKey', '')

/**
 * How long ago, in the units a person would actually say it in.
 *
 * "37.4 hours" is a measurement; "2 days" is how somebody decides whether a
 * cart is still worth chasing.
 */
function idle(hours: number): string {
  if (hours < 1)
    return 'under an hour'
  if (hours < 48)
    return `${Math.round(hours)}h`
  return `${Math.round(hours / 24)} days`
}

function contents(record: AbandonedCartRecord): string {
  if (record.items.length === 0)
    return `${record.itemCount} item${record.itemCount === 1 ? '' : 's'}`
  const shown = record.items.slice(0, 2).join(', ')
  const rest = record.itemCount - Math.min(2, record.items.length)
  return rest > 0 ? `${shown} +${rest} more` : shown
}

/** Recovered and expired by state; an open cart by whether anyone has chased it yet. */
function stateKey(record: AbandonedCartRecord): string {
  if (record.state === 'recovered' || record.state === 'expired')
    return record.state
  return record.contacted ? 'chased' : 'cold'
}

/**
 * A cart's total is integer minor units, like every commerce amount
 * (stacksjs/stacks#2851), so value is a currency column in the cart's own
 * currency. Idle reads as words, and sorts by the hours behind them.
 */
const COLUMNS = [
  { key: 'customerName', label: 'Customer', sortable: true, subtitleKey: 'emailLabel', class: 'font-medium text-gray-900 dark:text-white' },
  { key: 'contentsLabel', label: 'Left behind', subtitleKey: 'cartLabel', class: 'text-gray-900 dark:text-white' },
  { key: 'value', label: 'Value', type: 'currency' as const, currencyKey: 'currency', sortable: true, class: 'font-medium text-gray-900 dark:text-white' },
  { key: 'idleHours', label: 'Idle', sortable: true, slotted: true },
  {
    key: 'stateKey',
    label: 'State',
    type: 'badge' as const,
    sortable: true,
    badgeClasses: {
      recovered: 'bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-300',
      expired: 'bg-gray-100 text-gray-600 dark:bg-neutral-700 dark:text-neutral-300',
      chased: 'bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300',
      cold: 'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300',
    },
    badgeLabels: { recovered: 'Recovered', expired: 'Expired', chased: 'Chased', cold: 'Cold' },
  },
]

const rows = derived(() => records().map(record => ({
  ...record,
  emailLabel: record.customerEmail || 'No address on the cart',
  contentsLabel: contents(record),
  cartLabel: `Cart #${record.id}`,
  idleLabel: idle(record.idleHours),
  stateKey: stateKey(record),
})))
</script>

{{--
  No `searchable` or `filterable`: the parent dashboard owns the search box
  and the filter selects. Table pages the whole filtered list the parent passes.
--}}
<Table
  :sort-reset-key="sortResetKey()"
  :page-reset-key="pageResetKey()"
  :columns="COLUMNS"
  :data="rows()"
  :loading="loading()"
  paginated
  :page-size="10"
  empty-title="No carts to chase"
  empty-description="Nothing matches these filters, which, for once, is the good outcome."
>
  <template #cell="{ row }">
    <p class="text-gray-900 text-sm dark:text-white" x-text="row.idleLabel"></p>
  </template>
</Table>
