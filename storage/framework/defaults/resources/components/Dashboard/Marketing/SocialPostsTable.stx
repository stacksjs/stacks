@import('../UI/Table')

<script client>
import type { SocialPostRecord } from '../../../../app/Actions/Dashboard/Marketing/social-post-records'
import { parseDashboardDate } from '../../../../functions/dashboard-dates'

const records = useReactiveProp('records', [] as SocialPostRecord[])
const loading = useReactiveProp('loading', false)
/** The parent's sort select: a change hands the order back from a header sort. */
const sortResetKey = useReactiveProp<unknown>('sortResetKey', '')
/** The parent's search and filters: a change returns to the first page. */
const pageResetKey = useReactiveProp<unknown>('pageResetKey', '')
const emit = defineEmits(['edit', 'delete'])

function formatDate(value: string): string {
  if (!value)
    return 'Not set'
  const date = parseDashboardDate(value)
  return Number.isNaN(date.getTime())
    ? value
    : new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' }).format(date)
}

function displayPlatform(value: string): string {
  return value.charAt(0).toUpperCase() + value.slice(1)
}

/** The post cell is slotted: an image link and an external id appear only when present. */
const COLUMNS = [
  { key: 'content', label: 'Post', slotted: true },
  { key: 'platformLabel', label: 'Platform', sortable: true, class: 'font-medium text-gray-700 whitespace-nowrap dark:text-neutral-200' },
  { key: 'authorName', label: 'Owner', sortable: true, subtitleKey: 'authorEmail' },
  { key: 'timingLabel', label: 'Timing', subtitleKey: 'timingNote', class: 'whitespace-nowrap' },
  { key: 'reach', label: 'Performance', type: 'number' as const, sortable: true, subtitleKey: 'engagementLabel', class: 'whitespace-nowrap' },
  {
    key: 'status',
    label: 'Status',
    type: 'badge' as const,
    sortable: true,
    badgeClasses: {
      published: 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300',
      scheduled: 'bg-blue-50 text-blue-700 dark:bg-blue-950/40 dark:text-blue-300',
      failed: 'bg-red-50 text-red-700 dark:bg-red-950/40 dark:text-red-300',
      draft: 'bg-amber-50 text-amber-700 dark:bg-amber-950/40 dark:text-amber-300',
    },
  },
]

const ROW_ACTIONS = [
  { action: 'edit', label: 'Edit social post', icon: 'i-hugeicons-edit-01' },
  { action: 'delete', label: 'Delete social post', icon: 'i-hugeicons-delete-02', class: 'text-red-500' },
]

const rows = derived(() => records().map(record => ({
  ...record,
  platformLabel: displayPlatform(record.platform),
  timingLabel: record.status === 'published' ? formatDate(record.publishedAt) : formatDate(record.scheduledAt),
  timingNote: record.status === 'published' ? 'Published' : record.status === 'scheduled' ? 'Scheduled' : `Created ${formatDate(record.createdAt)}`,
  engagementLabel: `${record.engagement.toLocaleString()} interactions`,
})))

function handleRowAction(payload: { action: string, row: SocialPostRecord }): void {
  emit(payload.action, payload.row)
}
</script>

{{--
  No `searchable` or `filterable`: the parent dashboard owns the search box
  and the filter selects. Table pages the whole filtered list the parent passes.
--}}
<Table
  :sort-reset-key="sortResetKey()"
  :page-reset-key="pageResetKey()"
  :columns="COLUMNS"
  :data="rows()"
  :loading="loading()"
  :row-actions="ROW_ACTIONS"
  action-label-key="id"
  paginated
  :page-size="10"
  empty-title="No social posts found"
  empty-description="Adjust the filters or add a SocialPost record."
  @row-action="handleRowAction"
>
  <template #cell="{ row }">
    <div class="max-w-md">
      <p class="text-gray-900 text-sm dark:text-white" x-text="row.content"></p>
      <p :if="row.imageUrl" class="mt-1 max-w-xs text-blue-600 text-xs truncate dark:text-blue-400" x-text="row.imageUrl"></p>
      <p :if="row.externalId" class="mt-1 font-mono text-gray-500 text-xs dark:text-neutral-400" x-text="row.externalId"></p>
    </div>
  </template>
</Table>
