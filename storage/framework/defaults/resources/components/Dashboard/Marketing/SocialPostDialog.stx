<script client>
import type {
  SocialPostRecord,
  SocialPostUserOption,
} from '../../../../app/Actions/Dashboard/Marketing/social-post-records'

const open = useReactiveProp('open', false)
const mode = useReactiveProp('mode', 'add')
const record = useReactiveProp('record', null as SocialPostRecord | null)
const users = useReactiveProp('users', [] as SocialPostUserOption[])
const busy = useReactiveProp('busy', false)
const error = useReactiveProp('error', '')
const emit = defineEmits()
const content = state('')
const platform = state('twitter')
const status = state('draft')
const scheduledAt = state('')
const imageUrl = state('')
const userId = state('')
let hydrationKey = ''

effect(() => {
  if (!open()) {
    hydrationKey = ''
    return
  }
  const current = record()
  const key = `${mode()}:${current?.id || 'new'}`
  if (hydrationKey === key)
    return
  hydrationKey = key
  content.set(current?.content || '')
  platform.set(current?.platform || 'twitter')
  status.set(current?.status || 'draft')
  scheduledAt.set(current?.scheduledAt ? current.scheduledAt.replace(' ', 'T').slice(0, 16) : '')
  imageUrl.set(current?.imageUrl || '')
  userId.set(current?.userId || '')
})

function submit(): void {
  if (!content().trim() || (status() === 'scheduled' && !scheduledAt()))
    return
  emit('submit', {
    content: content().trim(),
    platform: platform(),
    status: status(),
    scheduledAt: scheduledAt() ? `${scheduledAt().replace('T', ' ')}:00` : null,
    publishedAt: record()?.publishedAt || null,
    imageUrl: imageUrl().trim() || null,
    userId: userId() ? Number(userId()) : null,
  })
}
</script>

<Modal
  :isOpen="open()"
  :title="mode() === 'edit' ? 'Edit social post' : 'Add social post'"
  description="Create or schedule a persisted SocialPost record. Platform delivery remains the responsibility of the configured publisher."
  size="lg"
  @close="emit('close')"
>
    <form id="social-post-form" @submit.prevent="submit">
        <div :if="error()" role="alert" class="mb-5 p-3 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">{{ error() }}</div>

        <div class="space-y-4">
          <label class="block">
            <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Content</span>
            <textarea x-model="content" rows="5" maxlength="2000" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700"></textarea>
            <span class="block mt-1 text-gray-500 text-xs dark:text-neutral-400">{{ content().length.toLocaleString() }} of 2,000 characters</span>
          </label>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Platform</span>
              <select x-model="platform" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700">
                <option value="twitter">Twitter</option>
                <option value="facebook">Facebook</option>
                <option value="instagram">Instagram</option>
                <option value="linkedin">LinkedIn</option>
                <option value="tiktok">TikTok</option>
                <option value="youtube">YouTube</option>
              </select>
            </label>
            <label class="block">
              <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Status</span>
              <select x-model="status" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700">
                <option value="draft">Draft</option>
                <option value="scheduled">Scheduled</option>
                <option value="published">Published</option>
                <option value="failed">Failed</option>
              </select>
            </label>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Schedule time</span>
              <input x-model="scheduledAt" type="datetime-local" :required="status() === 'scheduled'" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" />
            </label>
            <label class="block">
              <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Owner</span>
              <select x-model="userId" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700">
                <option value="">Unassigned</option>
                <template :for="user in users()" :key="user.id">
                  <option :value="user.id">{{ user.name }}{{ user.email ? ' - ' + user.email : '' }}</option>
                </template>
              </select>
            </label>
          </div>
          <label class="block">
            <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Image URL</span>
            <input x-model="imageUrl" type="url" maxlength="2000" placeholder="https://example.com/image.jpg" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" />
          </label>
        </div>
    </form>
  <template #footer>
    <div class="flex gap-2 justify-end w-full">
        <Button :disabled="busy()" variant="secondary" @click="emit('close')">Cancel</Button>
        <Button type="submit" form="social-post-form" :disabled="busy() || !content().trim() || (status() === 'scheduled' && !scheduledAt())" :loading="busy()">
          {{ mode() === 'edit' ? 'Save social post' : 'Add social post' }}
        </Button>
    </div>
  </template>
</Modal>
