<script client>
const active = useReactiveProp('active', 'overview')

function linkClass(name: string): string {
  return active() === name
    ? 'bg-white text-gray-900 shadow-sm dark:bg-neutral-700 dark:text-white'
    : 'text-gray-600 hover:text-gray-900 dark:text-neutral-400 dark:hover:text-white'
}
</script>

<nav aria-label="Notification sections" class="inline-flex gap-1 p-1 bg-gray-100 dark:bg-neutral-900 rounded-lg">
  <StxLink to="/notifications/dashboard" :class="'px-3 py-1.5 font-medium text-sm rounded-md transition-colors ' + linkClass('overview')">
    Overview
  </StxLink>
  <StxLink to="/notifications/email" :class="'px-3 py-1.5 font-medium text-sm rounded-md transition-colors ' + linkClass('email')">
    Email
  </StxLink>
  <StxLink to="/notifications/sms" :class="'px-3 py-1.5 font-medium text-sm rounded-md transition-colors ' + linkClass('sms')">
    SMS
  </StxLink>
  <StxLink to="/notifications/history" :class="'px-3 py-1.5 font-medium text-sm rounded-md transition-colors ' + linkClass('history')">
    History
  </StxLink>
</nav>
