<script client>
import type {
  DashboardDeliveryChannel,
  NotificationDelivery,
} from '../../../../functions/notifications/deliveries'
import {
  fetchNotificationDeliveries,
  retryNotificationDelivery,
} from '../../../../functions/notifications/deliveries'

const channel = useReactiveProp('channel', 'email' as DashboardDeliveryChannel)
const title = useReactiveProp('title', 'Notification Deliveries')
const description = useReactiveProp('description', 'Monitor notification transport attempts.')

const deliveries = state<NotificationDelivery[]>([])
const currentPage = state(1)
const perPage = state(10)
const isLoading = state(true)
const searchQuery = state('')
const selectedStatus = state('all')
const showFilters = state(false)
const sortDirection = state<'asc' | 'desc'>('desc')
const selectedDelivery = state<NotificationDelivery | null>(null)
const showDetails = state(false)
const retryingId = state<number | null>(null)

const filteredDeliveries = derived(() => {
  const query = searchQuery().trim().toLowerCase()
  const status = selectedStatus()

  return deliveries().filter((delivery) => {
    if (status !== 'all' && delivery.status !== status)
      return false
    if (!query)
      return true

    return delivery.recipient.toLowerCase().includes(query)
      || delivery.subject.toLowerCase().includes(query)
      || delivery.body.toLowerCase().includes(query)
      || delivery.error.toLowerCase().includes(query)
  })
})

const sortedDeliveries = derived(() => [...filteredDeliveries()].sort((a, b) => {
  const comparison = new Date(a.sent_at).getTime() - new Date(b.sent_at).getTime()
  return sortDirection() === 'asc' ? comparison : -comparison
}))

const paginatedDeliveries = derived(() => {
  const start = (currentPage() - 1) * perPage()
  return sortedDeliveries().slice(start, start + perPage())
})

const totalItems = derived(() => filteredDeliveries().length)
const totalPages = derived(() => Math.max(1, Math.ceil(totalItems() / perPage())))
const rangeStart = derived(() => totalItems() === 0 ? 0 : (currentPage() - 1) * perPage() + 1)
const rangeEnd = derived(() => Math.min(currentPage() * perPage(), totalItems()))
const canGoBack = derived(() => currentPage() > 1)
const canGoForward = derived(() => currentPage() < totalPages())
const sentCount = derived(() => deliveries().filter(delivery => delivery.status === 'sent' || delivery.status === 'delivered').length)
const failedCount = derived(() => deliveries().filter(delivery => delivery.status === 'failed').length)
const pendingCount = derived(() => deliveries().filter(delivery => delivery.status === 'pending').length)

effect(() => {
  searchQuery()
  selectedStatus()
  sortDirection()
  currentPage.set(1)
})

function openDelivery(event: CustomEvent<NotificationDelivery>): void {
  selectedDelivery.set(event.detail)
  showDetails.set(true)
}

function closeDelivery(): void {
  showDetails.set(false)
  selectedDelivery.set(null)
}

async function loadDeliveries(): Promise<void> {
  isLoading.set(true)
  deliveries.set(await fetchNotificationDeliveries(channel()))
  isLoading.set(false)
}

async function retryDelivery(event: CustomEvent<NotificationDelivery>): Promise<void> {
  const delivery = event.detail
  retryingId.set(delivery.id)
  const retried = await retryNotificationDelivery(delivery)
  if (retried)
    await loadDeliveries()
  retryingId.set(null)
}

function resetFilters(): void {
  searchQuery.set('')
  selectedStatus.set('all')
  sortDirection.set('desc')
}

function previousPage(): void {
  if (canGoBack())
    currentPage.update(page => page - 1)
}

function nextPage(): void {
  if (canGoForward())
    currentPage.update(page => page + 1)
}

onMount(loadDeliveries)
</script>

<section class="py-4 lg:py-8 min-h-screen dark:bg-neutral-800">
  <div class="px-4 sm:px-6 lg:px-8">
    <div class="mb-6">
      <NotificationNavigation :active="channel" />
    </div>
    <div class="sm:flex sm:items-center">
      <div class="sm:flex-auto">
        <h1 class="font-semibold leading-6 text-base text-gray-900 dark:text-neutral-100">{{ title }}</h1>
        <p class="mt-2 text-gray-700 text-sm dark:text-neutral-300">{{ description }}</p>
      </div>
      <div class="sm:flex-none mt-4 sm:ml-16 sm:mt-0">
        <Button variant="secondary" @click="showFilters.update(value => !value)">
          <span class="h-5 w-5 i-hugeicons-filter"></span>
          {{ showFilters ? 'Hide Filters' : 'Show Filters' }}
        </Button>
      </div>
    </div>

    <dl class="grid gap-3 grid-cols-2 lg:grid-cols-4 mt-6">
      <div class="px-4 py-3 bg-white dark:bg-neutral-700 ring-1 ring-gray-200 rounded-lg dark:ring-neutral-600">
        <dt class="text-gray-500 text-xs dark:text-neutral-400">Attempts</dt>
        <dd class="mt-1 font-semibold text-gray-900 text-xl dark:text-white">{{ deliveries.length }}</dd>
      </div>
      <div class="px-4 py-3 bg-white dark:bg-neutral-700 ring-1 ring-gray-200 rounded-lg dark:ring-neutral-600">
        <dt class="text-gray-500 text-xs dark:text-neutral-400">Sent</dt>
        <dd class="mt-1 font-semibold text-green-700 text-xl dark:text-green-300">{{ sentCount }}</dd>
      </div>
      <div class="px-4 py-3 bg-white dark:bg-neutral-700 ring-1 ring-gray-200 rounded-lg dark:ring-neutral-600">
        <dt class="text-gray-500 text-xs dark:text-neutral-400">Failed</dt>
        <dd class="mt-1 font-semibold text-red-700 text-xl dark:text-red-300">{{ failedCount }}</dd>
      </div>
      <div class="px-4 py-3 bg-white dark:bg-neutral-700 ring-1 ring-gray-200 rounded-lg dark:ring-neutral-600">
        <dt class="text-gray-500 text-xs dark:text-neutral-400">Pending</dt>
        <dd class="mt-1 font-semibold text-amber-700 text-xl dark:text-amber-300">{{ pendingCount }}</dd>
      </div>
    </dl>

    <div :show="showFilters" class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 mt-4">
      <label class="block">
        <span class="sr-only">Search notification deliveries</span>
        <span class="block relative">
          <span class="flex absolute inset-y-0 left-0 items-center pl-3 pointer-events-none">
            <span class="h-5 w-5 text-gray-400 i-hugeicons-search-01"></span>
          </span>
          <input x-model.trim="searchQuery" type="search" placeholder="Search recipient or content..." class="block pl-10 py-1.5 w-full text-gray-900 sm:leading-6 sm:text-sm dark:text-neutral-100 placeholder:text-gray-400 dark:bg-neutral-600 border-0 ring-1 ring-gray-300 ring-inset rounded-md dark:ring-neutral-600 focus:ring-2 focus:ring-blue-600 focus:ring-inset" />
        </span>
      </label>
      <label class="block">
        <span class="sr-only">Delivery status</span>
        <select x-model="selectedStatus" class="block pl-3 pr-10 py-1.5 w-full text-gray-900 sm:leading-6 sm:text-sm dark:text-neutral-100 dark:bg-neutral-600 border-0 ring-1 ring-gray-300 ring-inset rounded-md dark:ring-neutral-600 focus:ring-2 focus:ring-blue-600">
          <option value="all">All Statuses</option>
          <option value="sent">Sent</option>
          <option value="delivered">Delivered</option>
          <option value="failed">Failed</option>
          <option value="pending">Pending</option>
        </select>
      </label>
      <label class="block">
        <span class="sr-only">Attempt order</span>
        <select x-model="sortDirection" class="block pl-3 pr-10 py-1.5 w-full text-gray-900 sm:leading-6 sm:text-sm dark:text-neutral-100 dark:bg-neutral-600 border-0 ring-1 ring-gray-300 ring-inset rounded-md dark:ring-neutral-600 focus:ring-2 focus:ring-blue-600">
          <option value="desc">Newest First</option>
          <option value="asc">Oldest First</option>
        </select>
      </label>
      <div>
        <Button variant="secondary" @click="resetFilters()">Reset Filters</Button>
      </div>
    </div>

    <div class="mt-8">
      <NotificationDeliveryTable
        :deliveries="paginatedDeliveries"
        :loading="isLoading"
        :actions="true"
        :retryingId="retryingId"
        :emptyMessage="'No ' + (channel === 'email' ? 'email' : 'SMS') + ' delivery attempts have been recorded.'"
        @view="openDelivery($event)"
        @retry="retryDelivery($event)"
      />
    </div>

    <div class="flex items-center justify-between mt-4">
      <p class="text-gray-700 text-sm dark:text-neutral-300">
        Showing <span class="font-medium">{{ rangeStart }}</span> to <span class="font-medium">{{ rangeEnd }}</span> of <span class="font-medium">{{ totalItems }}</span> results
      </p>
      <div class="flex gap-2 items-center">
        <Button variant="secondary" :disabled="!canGoBack" @click="previousPage()">Previous</Button>
        <Button variant="secondary" :disabled="!canGoForward" @click="nextPage()">Next</Button>
      </div>
    </div>
  </div>

  <NotificationDeliveryDialog :open="showDetails" :delivery="selectedDelivery" @close="closeDelivery()" />
</section>
