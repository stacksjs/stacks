@import('../UI/Table')

<script client>
import type { NotificationDelivery } from '../../../../functions/notifications/deliveries'

const deliveries = useReactiveProp('deliveries', [] as NotificationDelivery[])
const loading = useReactiveProp('loading', false)
const actions = useReactiveProp('actions', false)
const allowRetry = useReactiveProp('allowRetry', true)
const retryingId = useReactiveProp('retryingId', null as number | null)
const emptyMessage = useReactiveProp('emptyMessage', 'No notification delivery attempts have been recorded.')
/**
 * Off by default: the delivery history pages on the server and hands this
 * one page at a time, while the per-channel deliveries page passes every
 * attempt it loaded and lets Table page them (stacksjs/stacks#2977).
 */
const paginated = useReactiveProp('paginated', false)
/** The parent's sort select: a change hands the order back from a header sort. */
const sortResetKey = useReactiveProp<unknown>('sortResetKey', '')
/** The parent's search and filters: a change returns to the first page. */
const pageResetKey = useReactiveProp<unknown>('pageResetKey', '')
const emit = defineEmits()

function channelIcon(channel: string): string {
  if (channel === 'email')
    return 'i-hugeicons-mail-01'
  if (channel === 'sms')
    return 'i-hugeicons-smart-phone-01'
  if (channel === 'push')
    return 'i-hugeicons-notification-01'
  if (channel === 'database')
    return 'i-hugeicons-database'
  if (channel === 'broadcast')
    return 'i-hugeicons-satellite'
  if (channel === 'chat')
    return 'i-hugeicons-message-01'
  return 'i-hugeicons-notification-03'
}

function provider(delivery: NotificationDelivery): string {
  const value = delivery.metadata.provider || delivery.metadata.driver
  return typeof value === 'string' && value ? value : 'Default'
}

function canRetry(delivery: NotificationDelivery): boolean {
  return allowRetry()
    && delivery.status === 'failed'
    && (delivery.channel === 'email' || delivery.channel === 'sms')
}

/** The channel cell is slotted for its icon. */
const COLUMNS = [
  { key: 'channel', label: 'Channel', sortable: true, slotted: true },
  { key: 'recipient', label: 'Recipient', sortable: true, emptyText: 'Not recorded', class: 'whitespace-nowrap' },
  { key: 'summary', label: 'Content', class: 'max-w-sm truncate' },
  {
    key: 'status',
    label: 'Status',
    type: 'badge' as const,
    sortable: true,
    badgeClasses: {
      failed: 'capitalize bg-red-50 text-red-700 dark:bg-red-950/40 dark:text-red-300',
      pending: 'capitalize bg-amber-50 text-amber-700 dark:bg-amber-950/40 dark:text-amber-300',
      sent: 'capitalize bg-blue-50 text-blue-700 dark:bg-blue-950/40 dark:text-blue-300',
      delivered: 'capitalize bg-green-50 text-green-700 dark:bg-green-950/40 dark:text-green-300',
    },
  },
  { key: 'providerLabel', label: 'Provider', sortable: true, class: 'whitespace-nowrap' },
  { key: 'sent_at', label: 'Attempted', type: 'datetime' as const, sortable: true, align: 'right' as const, emptyText: 'Not recorded', class: 'whitespace-nowrap' },
]

const ROW_ACTIONS = [
  { action: 'retry', label: 'Retry delivery to', icon: 'i-hugeicons-reload', when: { key: 'retryable', equals: true } },
  { action: 'view', label: 'View details of delivery to', icon: 'i-hugeicons-view' },
]

const rows = derived(() => deliveries().map(delivery => ({
  ...delivery,
  icon: `h-5 w-5 ${channelIcon(delivery.channel)}`,
  summary: delivery.subject || delivery.body || 'No content recorded',
  providerLabel: provider(delivery),
  retryable: canRetry(delivery),
  actionName: delivery.recipient || `attempt ${delivery.id}`,
})))

function handleRowAction(payload: { action: string, row: NotificationDelivery }): void {
  emit(payload.action, payload.row)
}
</script>

<Table
  :sort-reset-key="sortResetKey()"
  :page-reset-key="pageResetKey()"
  :columns="COLUMNS"
  :data="rows()"
  :loading="loading()"
  :row-actions="actions() ? ROW_ACTIONS : []"
  action-label-key="actionName"
  busy-key="id"
  :busy-value="retryingId()"
  :paginated="paginated()"
  :page-size="10"
  empty-title="No delivery attempts"
  :empty-description="emptyMessage()"
  @row-action="handleRowAction"
>
  <template #cell="{ row }">
    <span class="inline-flex gap-2 items-center font-medium text-gray-900 dark:text-neutral-100">
      <span :class="row.icon"></span>
      <span class="capitalize" x-text="row.channel"></span>
    </span>
  </template>
</Table>
