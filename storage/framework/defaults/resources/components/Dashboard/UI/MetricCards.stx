<script client>
/**
 * The metric strip above a dashboard list.
 *
 * Twenty-two dashboards carried this markup verbatim (stacksjs/stacks#2917):
 * the same card, the same classes, the same three lines. Five of them omit
 * `detail`, which is the only variation and is why it is optional here.
 *
 * It renders the <section> rather than only the cards, which is not a
 * stylistic choice. stx wraps every component render in a
 * `data-stx-component-wrapper` div, so a component that emitted only the
 * cards would become ONE child of the caller's grid and every card would
 * stack inside a single cell. Owning the grid keeps the articles as its
 * direct children, where the column classes can reach them.
 *
 * `columns` is a prop because the counts genuinely differ per screen: four,
 * five, three, and two different responsive ramps across the callers.
 */
const items = useReactiveProp('items', [] as Array<{ label: string, value: string, detail?: string }>)
const label = useReactiveProp('label', 'Metrics')
const columns = useReactiveProp('columns', 'grid-cols-2 lg:grid-cols-4')
</script>

<section :aria-label="label()" :class="`grid gap-3 ${columns()}`">
  <template :for="item in items()" :key="item.label">
    <article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
      <p class="text-gray-500 text-xs dark:text-neutral-400">{{ item.label }}</p>
      <p class="mt-2 font-semibold text-2xl text-gray-900 dark:text-white">{{ item.value }}</p>
      <p :if="item.detail" class="mt-1 text-gray-500 text-xs dark:text-neutral-500">{{ item.detail }}</p>
    </article>
  </template>
</section>
