<script client>
interface QuickLink {
  title: string
  description?: string
  href: string
  icon?: string
  tone?: string
}

const title = useReactiveProp('title', 'Quick links')
const links = useReactiveProp('links', [] as QuickLink[])
const customClass = useReactiveProp('class', '')
const validLinks = derived(() => links().filter(link => typeof link.href === 'string' && link.href.length > 0))

function isExternal(href: string): boolean {
  return /^https?:\/\//.test(href)
}

function iconClass(link: QuickLink): string {
  return `${link.icon || 'i-hugeicons-link-02'} h-5 w-5`
}

function toneClass(link: QuickLink): string {
  const tones: Record<string, string> = {
    blue: 'bg-blue-500',
    green: 'bg-green-500',
    purple: 'bg-purple-500',
    orange: 'bg-orange-500',
    neutral: 'bg-neutral-500',
  }
  return tones[link.tone || 'neutral'] || tones.neutral
}
</script>

<section :class="customClass()">
  <h2 class="mb-4 font-semibold text-base text-neutral-900 dark:text-white">{{ title() }}</h2>
  <div class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
    <template :for="link in validLinks()">
      <a
        :if="isExternal(link.href)"
        :href="link.href"
        target="_blank"
        rel="noopener noreferrer"
        class="block p-5 no-underline bg-white dark:bg-neutral-800 border border-neutral-200 rounded-xl dark:border-neutral-700 hover:shadow-md transition-shadow"
      >
        <div class="flex gap-4 items-center">
          <div :class="'flex flex-shrink-0 items-center justify-center h-11 w-11 text-white rounded-xl ' + toneClass(link)">
            <span :class="iconClass(link)" aria-hidden="true"></span>
          </div>
          <div class="flex-1 min-w-0">
            <p class="font-medium text-neutral-900 text-sm dark:text-white">{{ link.title }}</p>
            <p :if="link.description" class="mt-0.5 text-neutral-500 text-xs truncate dark:text-neutral-400">{{ link.description }}</p>
          </div>
        </div>
      </a>
      <StxLink
        :else
        :to="link.href"
        class="block p-5 no-underline bg-white dark:bg-neutral-800 border border-neutral-200 rounded-xl dark:border-neutral-700 hover:shadow-md transition-shadow"
      >
        <div class="flex gap-4 items-center">
          <div :class="'flex flex-shrink-0 items-center justify-center h-11 w-11 text-white rounded-xl ' + toneClass(link)">
            <span :class="iconClass(link)" aria-hidden="true"></span>
          </div>
          <div class="flex-1 min-w-0">
            <p class="font-medium text-neutral-900 text-sm dark:text-white">{{ link.title }}</p>
            <p :if="link.description" class="mt-0.5 text-neutral-500 text-xs truncate dark:text-neutral-400">{{ link.description }}</p>
          </div>
        </div>
      </StxLink>
    </template>
  </div>
</section>
