<script client>
import { formatCurrency } from '@stacksjs/commerce/money'
/**
 * The data table.
 *
 * Everything past the plain markup is opt-in, and every default matches the
 * behaviour this component had before those options existed, so an existing
 * `<Table :columns :data />` renders exactly as it did.
 *
 * The one thing that changed by default is sorting. It used to only emit a
 * `sort` event and wait for the parent to hand back reordered rows, which
 * meant a table whose parent ignored the event had sort arrows that did
 * nothing. It now sorts what it was given. A parent that sorts server-side
 * sets `manual-sort` and keeps the event.
 *
 * ## The slots, and what to use instead
 *
 * Three upstream stx limitations, and together they are why this component
 * had no callers at all while 69 dashboard components hand-rolled a `<table>`:
 *
 * - `{{ … }}` in slot content is evaluated at slot-expansion time against an
 *   empty context and written out as an empty string, so the expression is
 *   gone before the client loop runs. Attribute bindings (`x-text`, `:attr`,
 *   `@click`) survive intact, so half of a slot works and the text silently
 *   vanishes. stacksjs/stx#2095.
 * - `stx typecheck` does not bind scoped slot props, so every reference to
 *   `row` in `<template #cell="{ row }">` is a TS2304, in every binding form.
 *   It is a required CI step, so correct usage cannot land. stacksjs/stx#2096.
 * - `$slots.name` evaluates falsy inside a compound condition, so every
 *   `$slots` reference below stands alone and the branches are split rather
 *   than combined. stacksjs/stx#2098.
 *
 * So prefer the props over the slots until those are fixed:
 *
 * - action buttons: `rowActions` + the `row-action` event, with `when` for
 *   per-row availability and `busy-key`/`busy-value` to disable a row that is
 *   being written
 * - a second line under a value: the column's `subtitleKey`
 * - a pill that only marks some rows: a `badge` column with `emptyText: ''`
 * - page-level filters that belong beside the table: `#toolbar`, which sits
 *   outside the row loop and so is unaffected by #2095
 *
 * `Library/DependenciesDashboard` and the Commerce `*Table.stx` migrations are
 * the worked examples. See stacksjs/stacks#2924 and stacksjs/stacks#2925.
 */
interface DashboardTableColumn {
  key: string
  label: string
  align?: 'left' | 'center' | 'right'
  sortable?: boolean
  /** Show a filter control for this column in the filter row. */
  filterable?: boolean
  /** Constrains the filter to a dropdown of these values. */
  filterOptions?: string[]
  /** Include this column in the global search. Defaults to true. */
  searchable?: boolean
  /**
   * How the value is compared and rendered. Kept as a string rather than a
   * formatter function because props cross an attribute boundary, where a
   * function does not survive.
   */
  type?: 'text' | 'number' | 'currency' | 'date' | 'datetime' | 'boolean' | 'badge'
  /**
   * For a `badge` column: the classes each value wears. A value with no
   * entry gets a neutral pill, so a new status never renders unstyled.
   *
   * A map rather than a function because props cross an attribute boundary,
   * which a function does not survive - the same reason `type` is a string.
   */
  badgeClasses?: Record<string, string>
  /**
   * For a `badge` column: what each value reads as, when the stored value is
   * not the word to show. `active` displaying as "Available" is a real case
   * and is not derivable from the value.
   *
   * Without an entry the value is humanised: `on_delivery` becomes
   * "On delivery".
   */
  badgeLabels?: Record<string, string>
  /**
   * Row field rendered as a second, quieter line under the value.
   *
   * A name with its slug, abbreviation or description underneath is by far the
   * most common custom cell in the dashboard - 38 of the 67 hand-rolled tables
   * have one - and it is the only reason most of them needed a slot at all.
   * Doing it here keeps them off the `cell` slot, which cannot carry text
   * (stacksjs/stx#2095). A row with no value for the key renders one line.
   */
  subtitleKey?: string

  /**
   * What an empty cell reads as. Defaults to `-`. On a `badge` column, `''`
   * means no pill at all for rows without a value, which is what a flag
   * column wants.
   *
   * Per column because the right word is specific: a shipping table wants
   * "No minimum" for an absent free-shipping threshold, which is a statement
   * about the rate rather than missing data.
   */
  emptyText?: string
  /**
   * Fixed ISO code for a `currency` column, when every row is the same
   * currency. Defaults to USD, which is what this column did before it
   * could be told otherwise.
   */
  currency?: string
  /**
   * Row field holding the ISO code, when currency varies per row. Wins over
   * `currency` when both are given and the row actually carries one.
   */
  currencyKey?: string
  width?: string
  class?: string
  /** Hidden until switched on in the column menu. */
  hidden?: boolean
  /**
   * Route this column through the `cell` slot and leave every other column on
   * the built-in rendering.
   *
   * Without this, a caller that needs custom markup in one column has to
   * re-implement all of them, because the slot replaces the default content
   * wholesale. Per-column slots would be the obvious answer and are not
   * reachable: stx matches slot names literally, so `:name="'cell-' + key"`
   * never resolves and its content is dropped silently.
   *
   * A table where no column sets this keeps the old behaviour and sends every
   * cell through the slot, so existing callers are unaffected.
   * See stacksjs/stacks#2924.
   */
  slotted?: boolean
}

/**
 * An icon button in the actions column, declared rather than slotted.
 *
 * The `actions` slot needs `row`, and `stx typecheck` rejects every reference
 * to a scoped slot prop (stacksjs/stx#2096), so a table with action buttons
 * could not be migrated at all. Props and events cross the attribute boundary
 * cleanly, which this does: Table renders the buttons and emits `row-action`
 * with the action name and the row.
 */
interface DashboardTableRowAction {
  /** Identifies this action in the `row-action` payload. */
  action: string
  /** Read out as "<label> <row[actionLabelKey]>", e.g. "Edit Kilogram". */
  label: string
  /** Iconify class, e.g. `i-hugeicons-edit-01`. */
  icon: string
  /** Colour class for the icon. Defaults to the usual blue. */
  class?: string
  /**
   * Show this action only on rows where `row[key]` equals `equals`.
   *
   * Approving, seating or cancelling is usually only offered on the rows it
   * applies to - a restaurant party can be seated while it is still waiting,
   * and not afterwards. Without this the whole actions column had to be a
   * slot, which is the thing that could not be migrated.
   */
  when?: { key: string, equals: unknown }
}

type DashboardTableRow = Record<string, any>
type TableKey = string | number
type SortDirection = 'asc' | 'desc'

const columns = useReactiveProp<DashboardTableColumn[]>('columns', [])
const rows = useReactiveProp<DashboardTableRow[]>('data', [])
const loading = useReactiveProp('loading', false)
const selectable = useReactiveProp('selectable', false)
const striped = useReactiveProp('striped', false)
const bordered = useReactiveProp('bordered', false)
const compact = useReactiveProp('compact', false)
const stickyHeader = useReactiveProp('stickyHeader', false)
const emptyTitle = useReactiveProp('emptyTitle', 'No data')
const emptyDescription = useReactiveProp('emptyDescription', 'There are no items to display.')
const rowKey = useReactiveProp('rowKey', 'id')
const hoverable = useReactiveProp('hoverable', true)

const searchable = useReactiveProp('searchable', false)
const searchPlaceholder = useReactiveProp('searchPlaceholder', 'Search')
const filterable = useReactiveProp('filterable', false)
const paginated = useReactiveProp('paginated', false)
const pageSize = useReactiveProp('pageSize', 25)
const pageSizeOptions = useReactiveProp<number[]>('pageSizeOptions', [10, 25, 50, 100])
const manualSort = useReactiveProp('manualSort', false)
const columnToggle = useReactiveProp('columnToggle', false)
const exportable = useReactiveProp('exportable', false)
const exportFilename = useReactiveProp('exportFilename', 'table')
const stickyFirstColumn = useReactiveProp('stickyFirstColumn', false)
const rowActions = useReactiveProp<DashboardTableRowAction[]>('rowActions', [])
const actionLabelKey = useReactiveProp('actionLabelKey', '')
/**
 * Disable every action on the row currently being written.
 *
 * `busyValue` is whatever the parent is tracking - usually the id of the row
 * whose request is in flight - and `busyKey` is the field it compares against,
 * defaulting to the row key. Empty means nothing is busy.
 */
const busyKey = useReactiveProp('busyKey', '')
const busyValue = useReactiveProp<unknown>('busyValue', '')

const selectedKeys = state<TableKey[]>([])
const sortKey = state('')
const sortDirection = state<SortDirection>('asc')
const query = state('')
const columnFilters = state<Record<string, string>>({})
const hiddenColumns = state<string[]>([])
const page = state(1)
const columnMenuOpen = state(false)
const emit = defineEmits()

/* ---------------------------------------------------------------- columns */

const visibleColumns = derived(() =>
  columns().filter(column => !hiddenColumns().includes(column.key)),
)

// Seed from `hidden` once, so a column can ship hidden without the parent
// having to manage the list.
effect(() => {
  const initial = columns().filter(column => column.hidden).map(column => column.key)
  if (initial.length && hiddenColumns().length === 0)
    hiddenColumns.set(initial)
})

function toggleColumn(key: string): void {
  const next = hiddenColumns().includes(key)
    ? hiddenColumns().filter(hidden => hidden !== key)
    : [...hiddenColumns(), key]
  hiddenColumns.set(next)
  emit('column-visibility-change', next)
}

/* ----------------------------------------------------------------- values */

/** Text used for searching, filtering and CSV. Never the formatted string. */
function rawValue(row: DashboardTableRow, key: string): any {
  return row?.[key]
}

function displayValue(row: DashboardTableRow, column: DashboardTableColumn): string {
  const value = rawValue(row, column.key)
  if (value === null || value === undefined || value === '')
    return column.emptyText ?? '-'

  if (column.type === 'currency') {
    const amount = Number(value)
    if (!Number.isFinite(amount))
      return String(value)

    // Through @stacksjs/commerce/money, not Intl directly. Stacks stores
    // money in MINOR units, so formatting the stored number as if it were
    // major multiplies every amount by the currency's exponent: a 1200 cent
    // base rate rendered as $1,200.00 instead of $12.00 (stacksjs/stacks#2916).
    //
    // And the exponent is per currency, not always 100 - JPY and KRW have
    // none - so dividing here rather than delegating would be a second bug
    // behind the first. `currencyExponent` is the only thing that knows.
    const perRow = column.currencyKey ? rawValue(row, column.currencyKey) : undefined
    const code = typeof perRow === 'string' && perRow ? perRow : column.currency
    return formatCurrency(amount, code)
  }
  if (column.type === 'number') {
    const amount = Number(value)
    return Number.isFinite(amount) ? amount.toLocaleString() : String(value)
  }
  if (column.type === 'date') {
    const at = toDate(value)
    return Number.isNaN(at.getTime()) ? String(value) : at.toLocaleDateString()
  }
  // An event or log row is ordered by when it happened, and to the minute, so
  // the date alone is not enough to read it. Separate from `date` rather than
  // a flag on it because the two render differently everywhere they appear.
  if (column.type === 'datetime') {
    const at = toDate(value)
    return Number.isNaN(at.getTime())
      ? String(value)
      : at.toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' })
  }
  if (column.type === 'boolean')
    return value ? 'Yes' : 'No'

  return String(value)
}

/* ------------------------------------------------- search, filter, sort */

const searchableKeys = derived(() =>
  columns().filter(column => column.searchable !== false).map(column => column.key),
)

const searched = derived(() => {
  const term = query().trim().toLowerCase()
  if (!term)
    return rows()

  const keys = searchableKeys()
  return rows().filter(row => keys.some((key) => {
    const value = rawValue(row, key)
    return value !== null && value !== undefined && String(value).toLowerCase().includes(term)
  }))
})

const filtered = derived(() => {
  const active = Object.entries(columnFilters()).filter(([, value]) => value !== '' && value !== undefined)
  if (!active.length)
    return searched()

  return searched().filter(row => active.every(([key, value]) => {
    const cell = rawValue(row, key)
    if (cell === null || cell === undefined)
      return false
    return String(cell).toLowerCase().includes(String(value).toLowerCase())
  }))
})

/** Nulls sort last in both directions: "missing" is not a small value. */
const BADGE_BASE = 'inline-flex px-2.5 py-1 font-medium text-xs ring-1 ring-inset rounded-full'
const BADGE_NEUTRAL = 'bg-stone-100 text-stone-600 ring-stone-500/20 dark:bg-white/5 dark:text-neutral-300 dark:ring-white/10'

/** The pill's classes for this row's value, neutral when the value is unmapped. */
function badgeClass(row: DashboardTableRow, column: DashboardTableColumn): string {
  const key = String(rawValue(row, column.key) ?? '')
  return `${BADGE_BASE} ${column.badgeClasses?.[key] ?? BADGE_NEUTRAL}`
}

/**
 * Whether this row gets a pill at all.
 *
 * A badge column with `emptyText: ''` is a flag: it marks the rows that have
 * the value and leaves the rest blank, rather than drawing an empty pill
 * around a dash on every other row.
 */
function hasBadge(row: DashboardTableRow, column: DashboardTableColumn): boolean {
  return badgeLabel(row, column) !== ''
}

/**
 * Parse a stored timestamp.
 *
 * SQLite hands back `2026-01-01 12:00:00`, with a space and no zone. `new
 * Date()` reads that as local time where it reads it at all, so every row
 * shifted by the viewer's offset - a date near midnight landing on the wrong
 * day. The hand-rolled tables each normalised it themselves; this is the same
 * knowledge in the one place that needs it.
 */
function toDate(value: unknown): Date {
  const text = String(value)
  return new Date(/^\d{4}-\d{2}-\d{2} \d/.test(text) ? `${text.replace(' ', 'T')}Z` : text)
}

/** The pill's text: the mapped label, else the value with its underscores read as spaces. */
function badgeLabel(row: DashboardTableRow, column: DashboardTableColumn): string {
  const value = rawValue(row, column.key)
  if (value === null || value === undefined || value === '')
    return column.emptyText ?? '-'

  const key = String(value)
  const mapped = column.badgeLabels?.[key]
  if (mapped)
    return mapped

  const words = key.replaceAll('_', ' ')
  return words.charAt(0).toUpperCase() + words.slice(1)
}

function compare(a: any, b: any, type: DashboardTableColumn['type']): number {
  const aMissing = a === null || a === undefined || a === ''
  const bMissing = b === null || b === undefined || b === ''
  if (aMissing && bMissing)
    return 0
  if (aMissing)
    return 1
  if (bMissing)
    return -1

  if (type === 'number' || type === 'currency')
    return Number(a) - Number(b)
  // `datetime` sorts as a date too. Left out, it fell through to the string
  // comparison below, which is only accidentally right for ISO timestamps and
  // wrong for every other format.
  if (type === 'date' || type === 'datetime')
    return toDate(a).getTime() - toDate(b).getTime()
  if (type === 'boolean')
    return (a ? 1 : 0) - (b ? 1 : 0)

  return String(a).localeCompare(String(b), undefined, { numeric: true, sensitivity: 'base' })
}

const sorted = derived(() => {
  const key = sortKey()
  if (!key || manualSort())
    return filtered()

  const column = columns().find(candidate => candidate.key === key)
  const direction = sortDirection() === 'asc' ? 1 : -1

  // Copy first: sorting the prop array in place would mutate the parent's data.
  return filtered().slice().sort((a, b) => direction * compare(rawValue(a, key), rawValue(b, key), column?.type))
})

/* ------------------------------------------------------------- pagination */

const pageCount = derived(() => (paginated() ? Math.max(1, Math.ceil(sorted().length / pageSize())) : 1))

// A filter that shortens the list must not strand the viewer on a page that
// no longer exists.
effect(() => {
  if (page() > pageCount())
    page.set(pageCount())
})

const visibleRows = derived(() => {
  if (!paginated())
    return sorted()
  const start = (page() - 1) * pageSize()
  return sorted().slice(start, start + pageSize())
})

const rangeStart = derived(() => (sorted().length === 0 ? 0 : (page() - 1) * pageSize() + 1))
const rangeEnd = derived(() => Math.min(page() * pageSize(), sorted().length))

function goToPage(next: number): void {
  const target = Math.min(Math.max(1, next), pageCount())
  page.set(target)
  emit('page-change', target)
}

function changePageSize(event: Event): void {
  const size = Number((event.target as HTMLSelectElement).value)
  pageSize.set(size)
  page.set(1)
  emit('page-size-change', size)
}

/* -------------------------------------------------------------- selection */

const visibleKeys = derived(() => visibleRows().map(row => row[rowKey()] as TableKey))
const allSelected = derived(() =>
  visibleKeys().length > 0 && visibleKeys().every(key => selectedKeys().includes(key)),
)
const someSelected = derived(() =>
  !allSelected() && visibleKeys().some(key => selectedKeys().includes(key)),
)

/*
 * Drop selections whose row is gone from the data entirely. Deliberately
 * checked against every row rather than the visible page: paginating or
 * filtering must not silently discard a selection the viewer made two pages
 * back, which is what a "select all" then "delete" would act on.
 */
effect(() => {
  const present = new Set(rows().map(row => row[rowKey()] as TableKey))
  const next = selectedKeys().filter(key => present.has(key))
  if (next.length !== selectedKeys().length)
    selectedKeys.set(next)
})

function emitSelection(next: TableKey[]): void {
  selectedKeys.set(next)
  emit('update:selectedKeys', next)
  emit('selection-change', next)
}

function toggleAll(event: Event): void {
  const checked = (event.target as HTMLInputElement).checked
  const onPage = visibleKeys()
  const next = checked
    ? [...new Set([...selectedKeys(), ...onPage])]
    : selectedKeys().filter(key => !onPage.includes(key))
  emitSelection(next)
}

function toggleRow(row: DashboardTableRow, event: Event): void {
  const key = row[rowKey()] as TableKey
  const checked = (event.target as HTMLInputElement).checked
  const next = checked
    ? [...new Set([...selectedKeys(), key])]
    : selectedKeys().filter(selected => selected !== key)
  emitSelection(next)
}

/* ------------------------------------------------------------------ sort */

function sort(column: DashboardTableColumn): void {
  if (!column.sortable)
    return
  const direction: SortDirection = sortKey() === column.key && sortDirection() === 'asc' ? 'desc' : 'asc'
  sortKey.set(column.key)
  sortDirection.set(direction)
  emit('sort', { key: column.key, direction })
}

function sortLabel(column: DashboardTableColumn): string {
  if (sortKey() !== column.key)
    return `Sort by ${column.label}`
  return `Sort by ${column.label} ${sortDirection() === 'asc' ? 'descending' : 'ascending'}`
}

/** Mirrors sort state into aria-sort so screen readers announce it. */
function ariaSort(column: DashboardTableColumn): string {
  if (!column.sortable || sortKey() !== column.key)
    return 'none'
  return sortDirection() === 'asc' ? 'ascending' : 'descending'
}

/* ---------------------------------------------------------------- filters */

function setFilter(key: string, event: Event): void {
  const value = (event.target as HTMLInputElement | HTMLSelectElement).value
  columnFilters.set({ ...columnFilters(), [key]: value })
  page.set(1)
  emit('filter-change', columnFilters())
}

function setQuery(event: Event): void {
  query.set((event.target as HTMLInputElement).value)
  page.set(1)
  emit('search', query())
}

const hasActiveFilters = derived(() =>
  query().trim() !== '' || Object.values(columnFilters()).some(value => value !== ''),
)

function clearFilters(): void {
  query.set('')
  columnFilters.set({})
  page.set(1)
  emit('search', '')
  emit('filter-change', {})
}

/* ----------------------------------------------------------------- export */

function csvBlob(): Blob {
  const cols = visibleColumns()
  const escape = (value: any): string => {
    const text = value === null || value === undefined ? '' : String(value)
    return /[",\n]/.test(text) ? `"${text.replace(/"/g, '""')}"` : text
  }

  const lines = [
    cols.map(column => escape(column.label)).join(','),
    ...sorted().map(row => cols.map(column => escape(rawValue(row, column.key))).join(',')),
  ]

  return new Blob([`﻿${lines.join('\n')}`], { type: 'text/csv;charset=utf-8' })
}

/**
 * CSV of what is on screen: current search, filters and sort, all columns
 * that are visible, every page rather than just the current one. Exporting
 * the raw prop would hand back something the viewer never asked for.
 * useObjectUrl owns URL revocation while the native download link owns the
 * browser interaction.
 */
const exportBlob = derived(() => exportable() ? csvBlob() : null)
const exportUrl = useObjectUrl(exportBlob)
const exportDownload = derived(() => `${exportFilename()}.csv`)

function recordExport(): void {
  emit('export', sorted().length)
}

/* ------------------------------------------------------------------ style */

function alignClass(align: DashboardTableColumn['align']): string {
  if (align === 'center') return 'text-center'
  if (align === 'right') return 'text-right'
  return 'text-left'
}

function headerClass(column: DashboardTableColumn, index: number): string {
  return [
    index === 0 && !selectable() ? 'pl-6' : 'pl-4',
    'pr-4 font-semibold text-xs uppercase tracking-wider text-stone-500 dark:text-neutral-400',
    compact() ? 'py-2' : 'py-3.5',
    alignClass(column.align),
    index === 0 && stickyFirstColumn() ? 'sticky left-0 z-20 bg-stone-50 dark:bg-neutral-800' : '',
    column.class || '',
  ].filter(Boolean).join(' ')
}

function rowClass(index: number): string {
  return [
    hoverable() ? 'hover:bg-stone-50/50 dark:hover:bg-neutral-800/50' : '',
    striped() && index % 2 === 1 ? 'bg-stone-50/30 dark:bg-neutral-800/25' : '',
    bordered() ? 'border-b border-stone-100 dark:border-neutral-700' : '',
    'transition-colors',
  ].filter(Boolean).join(' ')
}

/**
 * Whether any column opted into the `cell` slot.
 *
 * Once one does, only those columns route through the slot and the rest keep
 * the built-in rendering. A table that marks none of them behaves as it always
 * did: the slot, when given, takes every cell. `$slots` is template-only, so
 * the presence of the slot is checked alongside this in the markup.
 */
function hasSlottedColumns(): boolean {
  return columns().some(column => column.slotted)
}

/** Whether the actions column is shown at all. */
function hasRowActions(): boolean {
  return rowActions().length > 0
}

/** The quieter second line, when the column asked for one and the row has it. */
function subtitleValue(row: DashboardTableRow, column: DashboardTableColumn): string {
  if (!column.subtitleKey)
    return ''
  const value = rawValue(row, column.subtitleKey)
  return value === null || value === undefined ? '' : String(value)
}

/** "Edit Kilogram", built from the action's label and the row's own name. */
function rowActionLabel(row: DashboardTableRow, action: DashboardTableRowAction): string {
  const key = actionLabelKey() || rowKey()
  const name = rawValue(row, key)
  return name === null || name === undefined || name === '' ? action.label : `${action.label} ${String(name)}`
}

/** Whether this action applies to this row. */
function showsRowAction(row: DashboardTableRow, action: DashboardTableRowAction): boolean {
  return !action.when || rawValue(row, action.when.key) === action.when.equals
}

/** Whether this row has a write in flight, so its actions are inert. */
function rowIsBusy(row: DashboardTableRow): boolean {
  const value = busyValue()
  if (value === '' || value === null || value === undefined)
    return false
  return rawValue(row, busyKey() || rowKey()) === value
}

function rowActionIconClass(action: DashboardTableRowAction): string {
  return `block h-4 w-4 ${action.class || 'text-blue-500'} ${action.icon}`
}

function cellClass(column: DashboardTableColumn, index: number): string {
  return [
    index === 0 && !selectable() ? 'pl-6' : 'pl-4',
    'pr-4 text-sm text-stone-700 dark:text-neutral-200',
    compact() ? 'py-2' : 'py-3.5',
    alignClass(column.align),
    column.type === 'number' || column.type === 'currency' ? 'tabular-nums' : '',
    index === 0 && stickyFirstColumn() ? 'sticky left-0 z-10 bg-white dark:bg-neutral-900' : '',
    column.class || '',
  ].filter(Boolean).join(' ')
}
</script>

<div class="overflow-hidden relative bg-white dark:bg-neutral-900 border border-stone-200/80 rounded-xl dark:border-neutral-700 shadow-sm">
  <div :if="loading()" class="flex absolute inset-0 z-30 items-center justify-center bg-white/80 dark:bg-neutral-900/80 backdrop-blur-sm" role="status">
    <span aria-hidden="true" class="mr-2 h-5 w-5 text-blue-500 animate-spin i-hugeicons-loading-03"></span>
    <span class="text-neutral-500 text-sm dark:text-neutral-400">Loading</span>
  </div>

  <!-- Toolbar: only rendered when something asked for it. -->
  {{-- `$slots.toolbar` used to be the last arm of this `||`, which only ever
       worked because one of the calls before it was usually true: `$slots`
       does not resolve inside a compound expression, so a table whose ONLY
       toolbar content came from the slot rendered no toolbar at all. The
       slot-only case gets its own branch below. See stacksjs/stx#2098. --}}
  <div
    :if="searchable() || columnToggle() || exportable()"
    class="flex flex-wrap gap-3 items-center justify-between px-4 py-3 border-b border-stone-200/80 dark:border-neutral-700"
  >
    <div class="flex flex-wrap gap-2 items-center">
      <div :if="searchable()" class="relative">
        <span aria-hidden="true" class="absolute left-2.5 top-1/2 h-4 w-4 text-neutral-400 -translate-y-1/2 i-hugeicons-search-01"></span>
        <input
          type="search"
          :placeholder="searchPlaceholder()"
          :aria-label="searchPlaceholder()"
          :value="query()"
          @input="setQuery($event)"
          class="pl-8 pr-3 py-1.5 w-56 text-sm bg-white dark:bg-neutral-800 border border-stone-300 rounded-lg dark:border-neutral-600 focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>

      <Button
        :if="hasActiveFilters()"
        variant="ghost"
        size="xs"
        @click="clearFilters()"
      >
        Clear filters
      </Button>

      <slot name="toolbar" />
    </div>

    <div class="flex gap-2 items-center">
      <div :if="columnToggle()" class="relative">
        <Button
          variant="outline"
          size="sm"
          ariaHasPopup="true"
          :ariaExpanded="columnMenuOpen() ? 'true' : 'false'"
          @click="columnMenuOpen.set(!columnMenuOpen())"
        >
          <span aria-hidden="true" class="h-3.5 w-3.5 i-hugeicons-layout-table-01"></span>
          Columns
        </Button>

        <div
          :if="columnMenuOpen()"
          class="absolute right-0 z-40 mt-1 p-2 w-52 bg-white dark:bg-neutral-800 border border-stone-200 rounded-lg dark:border-neutral-700 shadow-lg"
        >
          <template :for="column in columns()">
            <label class="flex gap-2 items-center px-2 py-1.5 text-neutral-700 text-sm dark:text-neutral-200 hover:bg-stone-50 dark:hover:bg-neutral-700 rounded cursor-pointer">
              <input
                type="checkbox"
                :checked="!hiddenColumns().includes(column.key)"
                @change="toggleColumn(column.key)"
                class="h-3.5 w-3.5 text-blue-600 border-stone-300 rounded dark:border-neutral-600"
              />
              {{ column.label }}
            </label>
          </template>
        </div>
      </div>

      <Button
        :if="exportable()"
        tag="a"
        variant="outline"
        size="sm"
        :href="exportUrl.value || ''"
        :download="exportDownload()"
        :disabled="!exportUrl.value"
        @click="recordExport()"
      >
        <span aria-hidden="true" class="h-3.5 w-3.5 i-hugeicons-download-04"></span>
        Export CSV
      </Button>
    </div>
  </div>

  {{-- A table that only contributes toolbar content through the slot, with
       none of the built-in controls switched on. --}}
  <div
    :else-if="$slots.toolbar"
    class="flex flex-wrap gap-3 items-center justify-between px-4 py-3 border-b border-stone-200/80 dark:border-neutral-700"
  >
    <div class="flex flex-wrap gap-2 items-center">
      <slot name="toolbar" />
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full">
      <thead :class="'bg-stone-50/80 dark:bg-neutral-800/50 ' + (stickyHeader() ? 'sticky top-0 z-20' : '')">
        <tr>
          <th :if="selectable()" scope="col" class="pl-6 pr-2 py-3 w-12">
            <input
              type="checkbox"
              aria-label="Select all rows on this page"
              class="h-4 w-4 text-blue-600 dark:bg-neutral-700 border-stone-300 rounded dark:border-neutral-600 focus:ring-blue-500"
              :checked="allSelected()"
              :indeterminate="someSelected()"
              @change="toggleAll($event)"
            />
          </th>

          <template :for="(column, index) in visibleColumns()">
            <th
              scope="col"
              :class="headerClass(column, index)"
              :style="column.width ? 'width: ' + column.width : undefined"
              :aria-sort="ariaSort(column)"
            >
              {{-- `bare`: a header button fills its `<th>` and carries no box
                   of its own, so none of the sizes fit. It still comes through
                   `UI/Button` for the shared focus ring and disabled handling.
                   See stacksjs/stacks#2926. --}}
              <Button
                :if="column.sortable"
                variant="bare"
                :ariaLabel="sortLabel(column)"
                class="inline-flex gap-1.5 items-center hover:text-stone-700 dark:hover:text-neutral-200"
                @click="sort(column)"
              >
                <span>{{ column.label }}</span>
                <span
                  aria-hidden="true"
                  :class="'h-3.5 w-3.5 ' + (sortKey() === column.key ? (sortDirection() === 'asc' ? 'i-hugeicons-arrow-up-02' : 'i-hugeicons-arrow-down-02') : 'opacity-30 i-hugeicons-arrow-up-down')"
                ></span>
              </Button>
              <span :else>{{ column.label }}</span>
            </th>
          </template>

          {{-- `$slots` only resolves as a standalone reference: inside a
               compound expression like `$slots.actions || hasRowActions()` the
               whole condition comes out falsy, so the column silently vanished.
               Hence the pair. See stacksjs/stx#2098. --}}
          <th :if="$slots.actions" scope="col" class="px-4 py-3 w-12"><span class="sr-only">Actions</span></th>
          <th :else-if="hasRowActions()" scope="col" class="px-4 py-3 w-12"><span class="sr-only">Actions</span></th>
        </tr>

        <!-- Per-column filter row. -->
        <tr :if="filterable()" class="border-stone-200/70 border-t dark:border-neutral-700">
          <td :if="selectable()" class="pl-6 pr-2 py-2"></td>
          <template :for="(column, index) in visibleColumns()">
            <td :class="(index === 0 && !selectable() ? 'pl-6' : 'pl-4') + ' pr-4 py-2'">
              <select
                :if="column.filterable && column.filterOptions"
                :aria-label="'Filter by ' + column.label"
                :value="columnFilters()[column.key] || ''"
                @change="setFilter(column.key, $event)"
                class="px-1.5 py-1 w-full text-xs bg-white dark:bg-neutral-800 border border-stone-300 rounded dark:border-neutral-600"
              >
                <option value="">All</option>
                <template :for="option in column.filterOptions">
                  <option :value="option">{{ option }}</option>
                </template>
              </select>
              <input
                :else-if="column.filterable"
                type="text"
                :aria-label="'Filter by ' + column.label"
                :placeholder="column.label"
                :value="columnFilters()[column.key] || ''"
                @input="setFilter(column.key, $event)"
                class="px-1.5 py-1 w-full text-xs bg-white dark:bg-neutral-800 border border-stone-300 rounded dark:border-neutral-600"
              />
            </td>
          </template>
          <td :if="$slots.actions" class="px-4 py-2"></td>
          <td :else-if="hasRowActions()" class="px-4 py-2"></td>
        </tr>
      </thead>

      <tbody class="divide-stone-100 divide-y dark:divide-neutral-700">
        <template :for="(row, rowIndex) in visibleRows()">
          <tr :class="rowClass(rowIndex)" :data-row-id="String(row[rowKey()])">
            <td :if="selectable()" class="pl-6 pr-2 w-12" :class="compact() ? 'py-2' : 'py-3.5'">
              <input
                type="checkbox"
                :aria-label="'Select row ' + String(row[rowKey()])"
                class="h-4 w-4 text-blue-600 dark:bg-neutral-700 border-stone-300 rounded dark:border-neutral-600 focus:ring-blue-500"
                :checked="selectedKeys().includes(row[rowKey()])"
                @change="toggleRow(row, $event)"
              />
            </td>

            <template :for="(column, columnIndex) in visibleColumns()">
              <td :class="cellClass(column, columnIndex)">
                {{-- No `$slots` here: it only resolves standalone, so the
                     compound condition this used to carry made every slotted
                     cell render nothing. The slot's own fallback covers the
                     "caller gave no slot" case instead. See stacksjs/stx#2098. --}}
                <template :if="column.slotted || !hasSlottedColumns()">
                  <slot name="cell" :row="row" :column="column" :value="row[column.key]">
                    <span :if="column.type === 'badge' && hasBadge(row, column)" :class="badgeClass(row, column)">{{ badgeLabel(row, column) }}</span>
                    <span :if="column.type !== 'badge'">{{ displayValue(row, column) }}</span>
                    <p :if="subtitleValue(row, column)" class="mt-1 text-neutral-500 text-xs dark:text-neutral-400">{{ subtitleValue(row, column) }}</p>
                  </slot>
                </template>
                <template :else>
                  <span :if="column.type === 'badge' && hasBadge(row, column)" :class="badgeClass(row, column)">{{ badgeLabel(row, column) }}</span>
                  <span :if="column.type !== 'badge'">{{ displayValue(row, column) }}</span>
                  <p :if="subtitleValue(row, column)" class="mt-1 text-neutral-500 text-xs dark:text-neutral-400">{{ subtitleValue(row, column) }}</p>
                </template>
              </td>
            </template>

            <td :if="$slots.actions" class="px-4 w-12" :class="compact() ? 'py-2' : 'py-3'">
              <slot name="actions" :row="row" />
            </td>
            <td :else-if="hasRowActions()" class="px-4 w-12" :class="compact() ? 'py-2' : 'py-3'">
              <div class="flex gap-1 justify-end">
                <template :for="action in rowActions()">
                  <Button
                    :if="showsRowAction(row, action)"
                    variant="ghost"
                    size="sm"
                    iconOnly
                    :disabled="rowIsBusy(row)"
                    :ariaLabel="rowActionLabel(row, action)"
                    @click="emit('row-action', { action: action.action, row })"
                  >
                    <span aria-hidden="true" :class="rowActionIconClass(action)"></span>
                  </Button>
                </template>
              </div>
            </td>
          </tr>
        </template>
      </tbody>
    </table>
  </div>

  <!--
    Two different empty states. "No data" and "nothing matched your filter"
    call for different next actions, and showing the first when the viewer has
    typed a search reads as though their data disappeared.
  -->
  <div :if="visibleRows().length === 0 && !loading() && hasActiveFilters()" class="flex flex-col items-center justify-center px-4 py-12">
    <span aria-hidden="true" class="mb-3 p-3 h-12 w-12 text-neutral-400 bg-neutral-100 dark:bg-neutral-800 rounded-full i-hugeicons-search-remove"></span>
    <p class="font-medium text-neutral-700 text-sm dark:text-neutral-200">No matches</p>
    <p class="mt-1 text-neutral-500 text-sm dark:text-neutral-400">No rows match the current search or filters.</p>
    <Button variant="ghost" size="sm" class="mt-3" @click="clearFilters()">Clear filters</Button>
  </div>

  <div :if="visibleRows().length === 0 && !loading() && !hasActiveFilters()" class="flex flex-col items-center justify-center px-4 py-12">
    <template :if="$slots.empty">
      <slot name="empty" />
    </template>
    <template :else>
      <span aria-hidden="true" class="mb-3 p-3 h-12 w-12 text-neutral-400 bg-neutral-100 dark:bg-neutral-800 rounded-full i-hugeicons-inbox"></span>
      <p class="font-medium text-neutral-700 text-sm dark:text-neutral-200">{{ emptyTitle() }}</p>
      <p class="mt-1 text-neutral-500 text-sm dark:text-neutral-400">{{ emptyDescription() }}</p>
    </template>
  </div>

  <div
    :if="paginated() && sorted().length > 0"
    class="flex flex-wrap gap-3 items-center justify-between px-4 py-3 bg-neutral-50/50 dark:bg-neutral-800/25 border-neutral-200 border-t dark:border-neutral-700"
  >
    <div class="flex gap-3 items-center text-neutral-500 text-sm dark:text-neutral-400">
      <span>Showing {{ rangeStart() }}-{{ rangeEnd() }} of {{ sorted().length }}</span>
      <label class="flex gap-1.5 items-center">
        <span class="sr-only">Rows per page</span>
        <select
          :value="String(pageSize())"
          @change="changePageSize($event)"
          class="px-1.5 py-1 text-xs bg-white dark:bg-neutral-800 border border-stone-300 rounded dark:border-neutral-600"
        >
          <template :for="option in pageSizeOptions()">
            <option :value="String(option)">{{ option }} / page</option>
          </template>
        </select>
      </label>
    </div>

    <nav class="flex gap-1 items-center" aria-label="Pagination">
      <Button
        variant="outline"
        size="sm"
        iconOnly
        ariaLabel="Previous page"
        :disabled="page() <= 1"
        @click="goToPage(page() - 1)"
      >
        <span aria-hidden="true" class="h-4 w-4 i-hugeicons-arrow-left-01"></span>
      </Button>
      <span class="px-2 tabular-nums text-neutral-600 text-sm dark:text-neutral-300">{{ page() }} / {{ pageCount() }}</span>
      <Button
        variant="outline"
        size="sm"
        iconOnly
        ariaLabel="Next page"
        :disabled="page() >= pageCount()"
        @click="goToPage(page() + 1)"
      >
        <span aria-hidden="true" class="h-4 w-4 i-hugeicons-arrow-right-01"></span>
      </Button>
    </nav>
  </div>

  <div :if="$slots.footer" class="px-4 py-3 bg-neutral-50/50 dark:bg-neutral-800/25 border-neutral-200 border-t dark:border-neutral-700">
    <slot name="footer" />
  </div>
</div>
