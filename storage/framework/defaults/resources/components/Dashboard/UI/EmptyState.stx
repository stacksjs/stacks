<script client>
const icon = useReactiveProp('icon', 'i-hugeicons-folder-02')
const title = useReactiveProp('title', '')
const description = useReactiveProp('description', '')
const actionLabel = useReactiveProp('actionLabel', '')
const actionIcon = useReactiveProp('actionIcon', '')
const actionHref = useReactiveProp('actionHref', '')
</script>

<div class="flex flex-col items-center justify-center px-4 py-12 text-center">
  <div class="mb-4 p-4 bg-neutral-100 dark:bg-neutral-800 rounded-full">
    <slot name="icon">
      <span :class="icon() + ' block h-8 w-8 text-neutral-400 dark:text-neutral-500'"></span>
    </slot>
  </div>

  <h3 class="mb-1 font-medium text-lg text-neutral-900 dark:text-white" :text="title()"></h3>

  <p :if="description()" class="mb-6 max-w-sm text-neutral-500 text-sm dark:text-neutral-400" :text="description()"></p>

  <Button
    :if="actionLabel() && actionHref()"
    tag="a"
    :href="actionHref()"
  >
    <span :if="actionIcon()" :class="actionIcon() + ' h-4 w-4'"></span>
    <span :text="actionLabel()"></span>
  </Button>

  <slot name="action" />
</div>
