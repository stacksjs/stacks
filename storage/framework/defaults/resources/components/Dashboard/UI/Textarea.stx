<script client>
type TextareaResize = 'none' | 'vertical' | 'horizontal' | 'both'

const liveValue = useReactiveProp('value', '')
const liveLabel = useReactiveProp('label', '')
const livePlaceholder = useReactiveProp('placeholder', '')
const liveError = useReactiveProp('error', '')
const liveHint = useReactiveProp('hint', '')
const liveDisabled = useReactiveProp('disabled', false)
const liveReadonly = useReactiveProp('readonly', false)
const liveRequired = useReactiveProp('required', false)
const liveRows = useReactiveProp('rows', 3)
const liveMaxLength = useReactiveProp('maxLength', 0)
const liveShowCount = useReactiveProp('showCount', false)
const liveResize = useReactiveProp('resize', 'vertical' as TextareaResize)
const liveName = useReactiveProp('name', '')
const liveId = useReactiveProp('id', '')
const liveAriaLabel = useReactiveProp('ariaLabel', '')
const liveClass = useReactiveProp('class', '')
const emit = defineEmits()
const generatedId = useId('textarea')

const resizeClasses: Record<TextareaResize, string> = {
  none: 'resize-none',
  vertical: 'resize-y',
  horizontal: 'resize-x',
  both: 'resize',
}

const textareaId = derived(() => liveId() || generatedId)
const valueLength = derived(() => String(liveValue() || '').length)
const headerVisible = derived(() => Boolean(liveLabel() || (liveShowCount() && liveMaxLength())))
const textareaClass = derived(() => [
  'block w-full rounded-lg border px-3 py-2.5 text-sm transition-all duration-150',
  'text-neutral-900 placeholder:text-neutral-400 focus:outline-none focus:ring-2',
  'dark:text-white dark:placeholder:text-neutral-500',
  resizeClasses[liveResize()] || resizeClasses.vertical,
  liveError()
    ? 'border-red-300 focus:border-red-500 focus:ring-red-500/20 dark:border-red-700'
    : 'border-neutral-300 hover:border-neutral-400 focus:border-blue-500 focus:ring-blue-500/20 dark:border-neutral-600 dark:hover:border-neutral-500',
  liveDisabled()
    ? 'cursor-not-allowed border-neutral-200 bg-neutral-100 text-neutral-400 dark:border-neutral-700 dark:bg-neutral-800'
    : 'bg-white dark:bg-neutral-900',
  liveClass(),
].join(' '))
const limitedCountLabel = derived(() => `${valueLength()}/${liveMaxLength()}`)
const openCountLabel = derived(() => `${valueLength()} characters`)

function textareaValue(event: Event): string {
  return (event.target as HTMLTextAreaElement).value
}

function handleInput(event: Event): void {
  const value = textareaValue(event)
  emit('update:value', value)
  emit('input', value)
}

function handleChange(event: Event): void {
  emit('change', textareaValue(event))
}

function handleBlur(event: Event): void {
  emit('blur', textareaValue(event))
}
</script>

<div>
  <div :if="headerVisible()" class="flex items-center justify-between mb-1.5">
    <label
      :if="liveLabel()"
      :for="textareaId()"
      class="block font-medium text-neutral-700 text-sm dark:text-neutral-200"
    >
      <span :text="liveLabel()"></span>
      <span :if="liveRequired()" class="text-red-500">*</span>
    </label>
    <span
      :if="liveShowCount() && liveMaxLength()"
      class="text-neutral-400 text-xs dark:text-neutral-500"
      :text="limitedCountLabel()"
    ></span>
  </div>

  <div class="relative">
    <textarea
      :id="textareaId()"
      :name="liveName() || null"
      :rows="liveRows()"
      :placeholder="livePlaceholder()"
      :aria-label="liveAriaLabel() || liveLabel() || null"
      :aria-invalid="liveError() ? 'true' : null"
      :maxlength="liveMaxLength() || null"
      :class="textareaClass()"
      x-model="liveValue"
      :disabled="liveDisabled()"
      :readonly="liveReadonly()"
      :required="liveRequired()"
      @input="handleInput"
      @change="handleChange"
      @blur="handleBlur"
    ></textarea>

    <span
      :if="liveShowCount() && !liveMaxLength()"
      class="absolute bottom-2 right-2 px-1 text-neutral-400 text-xs dark:text-neutral-500 bg-white dark:bg-neutral-900"
      :text="openCountLabel()"
    ></span>
  </div>

  <p :if="liveError()" class="mt-1.5 text-red-600 text-sm dark:text-red-400" :text="liveError()"></p>
  <p :if="!liveError() && liveHint()" class="mt-1.5 text-neutral-500 text-sm dark:text-neutral-400" :text="liveHint()"></p>
</div>
