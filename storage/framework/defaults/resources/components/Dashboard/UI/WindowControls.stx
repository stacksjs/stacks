<script client>
import { useWindowControls } from '../../../../functions/craft'

type WindowControlVariant = 'macos' | 'windows'
type WindowControlSize = 'sm' | 'md' | 'lg'

const liveVariant = useReactiveProp('variant', 'macos' as WindowControlVariant)
const liveSize = useReactiveProp('size', 'md' as WindowControlSize)
const liveShowLabels = useReactiveProp('showLabels', false)
const liveDisabled = useReactiveProp('disabled', false)
const emit = defineEmits()
const windowControls = useWindowControls()

const sizeConfig: Record<WindowControlSize, { button: string, gap: string, icon: string }> = {
  sm: { button: 'h-3 w-3', gap: 'gap-1.5', icon: 'h-2 w-2' },
  md: { button: 'h-3.5 w-3.5', gap: 'gap-2', icon: 'h-2.5 w-2.5' },
  lg: { button: 'h-4 w-4', gap: 'gap-2.5', icon: 'h-3 w-3' },
}

const config = derived(() => sizeConfig[liveSize()] || sizeConfig.md)
const macButtonClass = (color: string) => [
  config().button,
  color,
  'group relative rounded-full transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-offset-1',
  liveDisabled() ? 'cursor-not-allowed opacity-50' : 'cursor-pointer',
].join(' ')

async function handleClose(): Promise<void> {
  emit('close')
  await windowControls.close()
}

async function handleMinimize(): Promise<void> {
  emit('minimize')
  await windowControls.minimize()
}

async function handleMaximize(): Promise<void> {
  emit('maximize')
  await windowControls.toggle()
}
</script>

<div :if="liveVariant() === 'macos'" class="flex items-center" :class="config().gap" data-window-controls>
  <span class="flex gap-1.5 items-center">
    <button
      type="button"
      :class="macButtonClass('bg-[#ff5f57] focus:ring-red-500/50')"
      :disabled="liveDisabled()"
      aria-label="Close window"
      title="Close"
      @click="handleClose"
    >
      <span aria-hidden="true" class="hidden group-hover:block absolute inset-0 m-auto h-1.5 w-1.5 text-[#4c0002] i-hugeicons-cancel-01"></span>
    </button>
    <span :if="liveShowLabels()" class="text-neutral-500 text-xs dark:text-neutral-400">Close</span>
  </span>

  <span class="flex gap-1.5 items-center">
    <button
      type="button"
      :class="macButtonClass('bg-[#febc2e] focus:ring-yellow-500/50')"
      :disabled="liveDisabled()"
      aria-label="Minimize window"
      title="Minimize"
      @click="handleMinimize"
    >
      <span aria-hidden="true" class="hidden group-hover:block absolute inset-0 m-auto h-1.5 w-1.5 text-[#995700] i-hugeicons-minus-sign"></span>
    </button>
    <span :if="liveShowLabels()" class="text-neutral-500 text-xs dark:text-neutral-400">Minimize</span>
  </span>

  <span class="flex gap-1.5 items-center">
    <button
      type="button"
      :class="macButtonClass('bg-[#28c840] focus:ring-green-500/50')"
      :disabled="liveDisabled()"
      aria-label="Maximize window"
      title="Maximize"
      @click="handleMaximize"
    >
      <span aria-hidden="true" class="hidden group-hover:block absolute inset-0 m-auto h-1.5 w-1.5 text-[#006400] i-hugeicons-arrow-expand-01"></span>
    </button>
    <span :if="liveShowLabels()" class="text-neutral-500 text-xs dark:text-neutral-400">Maximize</span>
  </span>
</div>

<div :else class="flex items-center">
  <button
    type="button"
    class="flex items-center justify-center h-8 w-12 text-neutral-600 dark:text-neutral-400 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors"
    :disabled="liveDisabled()"
    aria-label="Minimize window"
    title="Minimize"
    @click="handleMinimize"
  >
    <span aria-hidden="true" class="h-3 w-3 i-hugeicons-minus-sign"></span>
  </button>
  <button
    type="button"
    class="flex items-center justify-center h-8 w-12 text-neutral-600 dark:text-neutral-400 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors"
    :disabled="liveDisabled()"
    aria-label="Maximize window"
    title="Maximize"
    @click="handleMaximize"
  >
    <span aria-hidden="true" class="h-3 w-3 i-hugeicons-square"></span>
  </button>
  <button
    type="button"
    class="flex items-center justify-center h-8 w-12 text-neutral-600 dark:text-neutral-400 hover:text-white hover:bg-red-600 transition-colors"
    :disabled="liveDisabled()"
    aria-label="Close window"
    title="Close"
    @click="handleClose"
  >
    <span aria-hidden="true" class="h-3 w-3 i-hugeicons-cancel-01"></span>
  </button>
</div>
