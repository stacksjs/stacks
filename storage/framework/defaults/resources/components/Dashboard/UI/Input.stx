<script client>
type InputType = 'text' | 'email' | 'password' | 'number' | 'tel' | 'url' | 'search' | 'date' | 'time' | 'datetime-local'
type InputSize = 'xs' | 'sm' | 'md' | 'lg'

const liveValue = useReactiveProp('value', '')
const liveType = useReactiveProp('type', 'text' as InputType)
const livePlaceholder = useReactiveProp('placeholder', '')
const liveDisabled = useReactiveProp('disabled', false)
const liveReadonly = useReactiveProp('readonly', false)
const liveRequired = useReactiveProp('required', false)
const liveError = useReactiveProp('error', '')
const liveHint = useReactiveProp('hint', '')
const liveLabel = useReactiveProp('label', '')
const liveAriaLabel = useReactiveProp('ariaLabel', '')
const liveAutocomplete = useReactiveProp('autocomplete', '')
const liveId = useReactiveProp('id', '')
const liveSize = useReactiveProp('size', 'md' as InputSize)
const liveName = useReactiveProp('name', '')
const liveFullWidth = useReactiveProp('fullWidth', true)
// What the browser itself holds a value to: a number's or a date's range and
// step, a text's length. Empty or zero means the input has none.
const liveMin = useReactiveProp<string | number>('min', '')
const liveMax = useReactiveProp<string | number>('max', '')
const liveStep = useReactiveProp<string | number>('step', '')
const liveMaxLength = useReactiveProp('maxLength', 0)
const liveMinLength = useReactiveProp('minLength', 0)
// Which keyboard a phone shows: `decimal`, `numeric`, `email`, `tel`, `url`.
const liveInputmode = useReactiveProp('inputmode', '')
// Null leaves it to the browser. False for what is not prose: a slug, a code, a key.
const liveSpellcheck = useReactiveProp<boolean | null>('spellcheck', null)
// The id of a `<datalist>` of suggestions.
const liveList = useReactiveProp('list', '')
// Codes, keys and slugs read better in a fixed-width face.
const liveMonospace = useReactiveProp('monospace', false)
// Added to the input itself: `uppercase` for a code that is stored that way.
const liveClass = useReactiveProp('class', '')
// The field a dialog focuses when it opens: the Modal looks for `[autofocus]`.
const liveAutofocus = useReactiveProp('autofocus', false)
// A pattern the browser holds the text to, as a native input's.
const livePattern = useReactiveProp('pattern', '')
const emit = defineEmits(['update:value', 'input', 'change', 'blur', 'keydown'])
const generatedId = useId('input')

const sizeClasses: Record<InputSize, string> = {
  xs: 'px-2 py-1 text-[11px] h-6',
  sm: 'px-2.5 py-1 text-[12px] h-7',
  md: 'px-3 py-1.5 text-[13px] h-8',
  lg: 'px-3.5 py-2 text-[14px] h-9',
}

const inputId = derived(() => liveId() || generatedId)
const inputClass = derived(() => [
  'block w-full',
  'bg-white dark:bg-white/10',
  'border rounded-lg',
  'text-stone-900 dark:text-neutral-100',
  'placeholder:text-stone-400 dark:placeholder:text-neutral-500',
  'transition-all duration-150',
  'focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:ring-offset-0',
  sizeClasses[liveSize()] || sizeClasses.md,
  liveMonospace() ? 'font-mono' : '',
  // Digits of one width, so a column of amounts lines up and a number does not shift as it is typed.
  liveType() === 'number' ? 'tabular-nums' : '',
  liveError()
    ? 'border-red-400/60 dark:border-red-500/60 focus:border-red-500 focus:ring-red-500/30'
    : 'border-stone-200/80 dark:border-white/15 focus:border-blue-400 hover:border-stone-300 dark:hover:border-white/25',
  liveDisabled() ? 'opacity-40 cursor-not-allowed bg-stone-50 dark:bg-white/5' : '',
  liveClass(),
].join(' '))

/** An attribute's value, or null to leave the attribute off. Zero is a real minimum. */
function bound(value: string | number): string | number | null {
  return value === '' || value === null || value === undefined ? null : value
}

function inputValue(event: Event): string {
  return (event.target as HTMLInputElement).value
}

function handleInput(event: Event): void {
  const nextValue = inputValue(event)
  emit('update:value', nextValue)
  emit('input', nextValue)
}

function handleChange(event: Event): void {
  emit('change', inputValue(event))
}

function handleBlur(event: Event): void {
  emit('blur', inputValue(event))
}

/**
 * A key pressed in the field, as the event itself: a dialog that saves on
 * Enter, or sends on Command+Enter, decides, and can prevent the default.
 */
function handleKeydown(event: KeyboardEvent): void {
  emit('keydown', event)
}
</script>

<div :class="liveFullWidth() ? 'w-full' : ''">
  <template :if="liveLabel()">
    <label :for="inputId()" class="block mb-1.5 font-medium text-[13px] tracking-tight" :class="liveError() ? 'text-red-600 dark:text-red-400' : 'text-stone-600 dark:text-neutral-400'">
      <span :text="liveLabel()"></span>
      <span :if="liveRequired()" class="ml-0.5 text-red-500">*</span>
    </label>
  </template>

  <div class="relative">
    @if($slots.iconLeft)
      <div class="flex absolute inset-y-0 left-0 items-center pl-2.5 text-neutral-400 pointer-events-none">
        <slot name="iconLeft" />
      </div>
    @endif
    <input
      :id="inputId()"
      :type="liveType()"
      x-model="liveValue"
      :placeholder="livePlaceholder()"
      :aria-label="liveAriaLabel() || liveLabel() || null"
      :aria-invalid="liveError() ? 'true' : null"
      :autocomplete="liveAutocomplete() || null"
      :name="liveName() || null"
      :min="bound(liveMin())"
      :max="bound(liveMax())"
      :step="bound(liveStep())"
      :maxlength="liveMaxLength() || null"
      :minlength="liveMinLength() || null"
      :inputmode="liveInputmode() || null"
      :spellcheck="liveSpellcheck() === null ? null : String(liveSpellcheck())"
      :list="liveList() || null"
      :autofocus="liveAutofocus() || null"
      :pattern="livePattern() || null"
      class="{{ $slots.iconLeft ? 'pl-8' : '' }}"
      :class="inputClass()"
      @input="handleInput"
      @change="handleChange"
      @blur="handleBlur"
      @keydown="handleKeydown"
      :disabled="liveDisabled()"
      :readonly="liveReadonly()"
      :required="liveRequired()"
    >
  </div>

  <p :if="liveError()" class="mt-1.5 text-[12px] text-red-600 dark:text-red-400" :text="liveError()"></p>
  <p :if="!liveError() && liveHint()" class="mt-1.5 text-[12px] text-stone-500 dark:text-neutral-400" :text="liveHint()"></p>
</div>
