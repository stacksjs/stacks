<script client>
type InputType = 'text' | 'email' | 'password' | 'number' | 'tel' | 'url' | 'search' | 'date' | 'time' | 'datetime-local'
type InputSize = 'xs' | 'sm' | 'md' | 'lg'

const liveValue = useReactiveProp('value', '')
const liveType = useReactiveProp('type', 'text' as InputType)
const livePlaceholder = useReactiveProp('placeholder', '')
const liveDisabled = useReactiveProp('disabled', false)
const liveReadonly = useReactiveProp('readonly', false)
const liveRequired = useReactiveProp('required', false)
const liveError = useReactiveProp('error', '')
const liveHint = useReactiveProp('hint', '')
const liveLabel = useReactiveProp('label', '')
const liveAriaLabel = useReactiveProp('ariaLabel', '')
const liveAutocomplete = useReactiveProp('autocomplete', '')
const liveId = useReactiveProp('id', '')
const liveSize = useReactiveProp('size', 'md' as InputSize)
const liveName = useReactiveProp('name', '')
const liveFullWidth = useReactiveProp('fullWidth', true)
const emit = defineEmits()
const generatedId = useId('input')

const sizeClasses: Record<InputSize, string> = {
  xs: 'px-2 py-1 text-[11px] h-6',
  sm: 'px-2.5 py-1 text-[12px] h-7',
  md: 'px-3 py-1.5 text-[13px] h-8',
  lg: 'px-3.5 py-2 text-[14px] h-9',
}

const inputId = derived(() => liveId() || generatedId)
const inputClass = derived(() => [
  'block w-full',
  'bg-white dark:bg-white/10',
  'border rounded-lg',
  'text-stone-900 dark:text-neutral-100',
  'placeholder:text-stone-400 dark:placeholder:text-neutral-500',
  'transition-all duration-150',
  'focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:ring-offset-0',
  sizeClasses[liveSize()] || sizeClasses.md,
  liveError()
    ? 'border-red-400/60 dark:border-red-500/60 focus:border-red-500 focus:ring-red-500/30'
    : 'border-stone-200/80 dark:border-white/15 focus:border-blue-400 hover:border-stone-300 dark:hover:border-white/25',
  liveDisabled() ? 'opacity-40 cursor-not-allowed bg-stone-50 dark:bg-white/5' : '',
].join(' '))

function inputValue(event: Event): string {
  return (event.target as HTMLInputElement).value
}

function handleInput(event: Event): void {
  const nextValue = inputValue(event)
  emit('update:value', nextValue)
  emit('input', nextValue)
}

function handleChange(event: Event): void {
  emit('change', inputValue(event))
}

function handleBlur(event: Event): void {
  emit('blur', inputValue(event))
}
</script>

<div :class="liveFullWidth() ? 'w-full' : ''">
  <template :if="liveLabel()">
    <label :for="inputId()" class="block mb-1.5 font-medium text-[13px] tracking-tight" :class="liveError() ? 'text-red-600 dark:text-red-400' : 'text-stone-600 dark:text-neutral-400'">
      <span :text="liveLabel()"></span>
      <span :if="liveRequired()" class="ml-0.5 text-red-500">*</span>
    </label>
  </template>

  <div class="relative">
    @if($slots.iconLeft)
      <div class="flex absolute inset-y-0 left-0 items-center pl-2.5 text-neutral-400 pointer-events-none">
        <slot name="iconLeft" />
      </div>
    @endif
    <input
      :id="inputId()"
      :type="liveType()"
      x-model="liveValue"
      :placeholder="livePlaceholder()"
      :aria-label="liveAriaLabel() || liveLabel() || null"
      :autocomplete="liveAutocomplete() || null"
      :name="liveName() || null"
      class="{{ $slots.iconLeft ? 'pl-8' : '' }}"
      :class="inputClass()"
      @input="handleInput"
      @change="handleChange"
      @blur="handleBlur"
      :disabled="liveDisabled()"
      :readonly="liveReadonly()"
      :required="liveRequired()"
    >
  </div>

  <p :if="liveError()" class="mt-1.5 text-red-600 text-sm dark:text-red-400" :text="liveError()"></p>
  <p :if="!liveError() && liveHint()" class="mt-1.5 text-sm text-stone-500 dark:text-neutral-400" :text="liveHint()"></p>
</div>
