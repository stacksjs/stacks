<script server>
interface AvatarProps {
  src?: string
  alt?: string
  name?: string
  initials?: string
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl' | '2xl'
  rounded?: 'sm' | 'md' | 'lg' | 'full'
  status?: 'online' | 'offline' | 'away' | 'busy'
}

const { src = '', alt = '', name = '', initials: suppliedInitials = '', size = 'md', rounded = 'full', status = '' } = defineProps<AvatarProps>()

const sizeClasses = {
  xs: 'h-5 w-5 text-[10px]',
  sm: 'h-7 w-7 text-[11px]',
  md: 'h-8 w-8 text-[12px]',
  lg: 'h-10 w-10 text-[13px]',
  xl: 'h-12 w-12 text-[14px]',
  '2xl': 'h-14 w-14 text-[16px]'
}

const radiusClasses = {
  sm: 'rounded-md',
  md: 'rounded-lg',
  lg: 'rounded-xl',
  full: 'rounded-full'
}

const statusColors = {
  online: 'bg-green-500',
  offline: 'bg-neutral-400',
  away: 'bg-orange-500',
  busy: 'bg-red-500'
}

const statusSizes = {
  xs: 'h-1.5 w-1.5',
  sm: 'h-2 w-2',
  md: 'h-2 w-2',
  lg: 'h-2.5 w-2.5',
  xl: 'h-3 w-3',
  '2xl': 'h-3.5 w-3.5'
}

// Generate initials from name
function getInitials(fullName: string) {
  if (!fullName) return ''
  const parts = fullName.trim().split(/\s+/)
  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase()
  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase()
}

const initials = suppliedInitials || getInitials(name)

// Background colors for initials (consistent based on name)
const bgColors = [
  'bg-red-500/15 text-red-600 dark:bg-red-400/20 dark:text-red-400',
  'bg-orange-500/15 text-orange-600 dark:bg-orange-400/20 dark:text-orange-400',
  'bg-yellow-500/15 text-yellow-600 dark:bg-yellow-400/20 dark:text-yellow-400',
  'bg-green-500/15 text-green-600 dark:bg-green-400/20 dark:text-green-400',
  'bg-teal-500/15 text-teal-600 dark:bg-teal-400/20 dark:text-teal-400',
  'bg-cyan-500/15 text-cyan-600 dark:bg-cyan-400/20 dark:text-cyan-400',
  'bg-blue-500/15 text-blue-600 dark:bg-blue-400/20 dark:text-blue-400',
  'bg-indigo-500/15 text-indigo-600 dark:bg-indigo-400/20 dark:text-indigo-400',
  'bg-purple-500/15 text-purple-600 dark:bg-purple-400/20 dark:text-purple-400',
  'bg-pink-500/15 text-pink-600 dark:bg-pink-400/20 dark:text-pink-400'
]

</script>
<script client>
const avatarSrc = useReactiveProp('src', {{ src }})
const avatarAlt = useReactiveProp('alt', {{ alt }})
const avatarName = useReactiveProp('name', {{ name }})
const avatarInitials = useReactiveProp('initials', {{ suppliedInitials }})
const avatarDescription = derived(() => avatarAlt() || avatarName() || 'Avatar')
const avatarFallback = derived(() => {
  if (avatarInitials()) return avatarInitials()
  const parts = String(avatarName() || '').trim().split(/\s+/).filter(Boolean)
  if (!parts.length) return ''
  return (parts.length === 1 ? parts[0].slice(0, 2) : parts[0][0] + parts[parts.length - 1][0]).toUpperCase()
})
const avatarColor = derived(() => {
  const name = String(avatarName() || '')
  if (!name) return 'bg-black/[0.06] text-neutral-500 dark:bg-white/10 dark:text-neutral-400'
  let hash = 0
  for (let i = 0; i < name.length; i++) hash = name.charCodeAt(i) + ((hash << 5) - hash)
  const colors = {{ bgColors }}
  return colors[Math.abs(hash) % colors.length]
})
</script>
<div class="inline-flex relative flex-shrink-0">
      <img
        :if="avatarSrc"
        src="{{ src }}"
        :src="avatarSrc"
        alt="{{ alt || name || 'Avatar' }}"
        :alt="avatarDescription"
        class="object-cover {{ sizeClasses[size] }} {{ radiusClasses[rounded] }}"
      >
      <div :if="!avatarSrc" :class="avatarColor" class="inline-flex items-center justify-center font-medium {{ sizeClasses[size] }} {{ radiusClasses[rounded] }}">
          <span :if="avatarFallback" :text="avatarFallback">{{ initials }}</span>
          <span :if="!avatarFallback" aria-hidden="true" class="h-1/2 w-1/2 text-neutral-400 i-hugeicons-user"></span>
      </div>

    @if(status)
      <span class="absolute bottom-0 right-0 rounded-full ring-2 ring-white dark:ring-neutral-900 {{ statusColors[status] }} {{ statusSizes[size] }}"></span>
    @endif
  </div>
