<script client>
interface StatsCardProps {
  title?: string
  value?: string
  subtitle?: string
  trendLabel?: string
  icon?: string
  iconBg?: 'primary' | 'success' | 'warning' | 'danger' | 'info' | 'neutral'
  loading?: boolean
  trend?: any
}

const iconBgClasses = {
  primary: 'bg-blue-500/15 text-blue-600 dark:bg-blue-400/20 dark:text-blue-400',
  success: 'bg-green-500/15 text-green-600 dark:bg-green-400/20 dark:text-green-400',
  warning: 'bg-orange-500/15 text-orange-600 dark:bg-orange-400/20 dark:text-orange-400',
  danger: 'bg-red-500/15 text-red-600 dark:bg-red-400/20 dark:text-red-400',
  info: 'bg-cyan-500/15 text-cyan-600 dark:bg-cyan-400/20 dark:text-cyan-400',
  neutral: 'bg-black/[0.06] text-neutral-600 dark:bg-white/10 dark:text-neutral-400'
}

const trendClasses = {
  up: 'text-green-500 dark:text-green-400',
  down: 'text-red-500 dark:text-red-400',
  neutral: 'text-neutral-500 dark:text-neutral-400'
}

const liveTitle = useReactiveProp('title', '')
const liveValue = useReactiveProp('value', '')
const liveSubtitle = useReactiveProp('subtitle', '')
const liveTrendLabel = useReactiveProp('trendLabel', '')
const liveIcon = useReactiveProp('icon', '')
const liveIconBg = useReactiveProp<StatsCardProps['iconBg']>('iconBg', 'primary')
const liveLoading = useReactiveProp('loading', false)
const liveTrend = useReactiveProp<number | null>('trend', null)

const supportText = derived(() => liveTrendLabel() || liveSubtitle())
const iconBackgroundClass = derived(() => iconBgClasses[liveIconBg() || 'primary'])
const trendDirection = derived(() => liveTrend() === null || liveTrend() === 0 ? 'neutral' : (Number(liveTrend()) > 0 ? 'up' : 'down'))
const trendClass = derived(() => trendClasses[trendDirection()])
</script>
<div class="p-5 bg-white dark:bg-neutral-800/90 border border-black/5 rounded-xl dark:border-white/5 hover:shadow-black/5 hover:shadow-md dark:hover:shadow-black/20 duration-150 transition-all">
    <div class="flex items-start justify-between">
      <div class="flex-1 min-w-0">
        <p class="font-medium text-[13px] text-neutral-500 tracking-tight truncate dark:text-neutral-400">
          {{ liveTitle() }}
        </p>

        <div class="flex gap-2 items-baseline mt-1.5">
          <div :if="liveLoading()" class="h-7 w-20 bg-black/5 dark:bg-white/10 rounded-md animate-pulse"></div>
          <div :else class="flex gap-2 items-baseline">
            <p class="font-semibold text-[22px] text-neutral-900 tracking-tight dark:text-white">
              @if($slots.value)
                <slot name="value" />
              @else
                {{ liveValue() }}
              @endif
            </p>

            @if($slots.trend)
              <slot name="trend" />
            @else
              <span :if="liveTrend() !== null" :class="'inline-flex items-center text-[12px] font-medium ' + trendClass()">
                <span :if="trendDirection() === 'up'" class="mr-0.5 h-3.5 w-3.5 i-hugeicons-arrow-up-02"></span>
                <span :if="trendDirection() === 'down'" class="mr-0.5 h-3.5 w-3.5 i-hugeicons-arrow-down-02"></span>
                {{ Math.abs(Number(liveTrend())) }}%
              </span>
            @endif
          </div>
        </div>

        @if($slots.subtitle)
          <p class="mt-1 text-[12px] text-neutral-500 dark:text-neutral-400">
            <slot name="subtitle" />
          </p>
        @else
          <p :if="supportText()" class="mt-1 text-[12px] text-neutral-500 dark:text-neutral-400">
            {{ supportText() }}
          </p>
        @endif
      </div>

      <div :if="liveIcon()" :class="'p-2.5 rounded-lg flex-shrink-0 ' + iconBackgroundClass()">
        <div :class="liveIcon() + ' h-5 w-5'"></div>
      </div>
    </div>

    <slot />
  </div>
