<script server>
interface ModalProps {
  isOpen?: boolean
  title?: string
  description?: string
  size?: 'sm' | 'md' | 'lg' | 'xl' | 'full'
  closable?: boolean
}

const { isOpen = false, title = '', description = '', size = 'md', closable = true } = defineProps<ModalProps>()

const sizeClasses = {
  sm: 'max-w-sm',
  md: 'max-w-lg',
  lg: 'max-w-2xl',
  xl: 'max-w-4xl',
  full: 'max-w-[calc(100vw-2rem)] max-h-[calc(100vh-2rem)]'
}
</script>
<script client>
const open = useReactiveProp('isOpen', false)
const liveClosable = useReactiveProp('closable', true)
const liveTitle = useReactiveProp('title', '')
const liveDescription = useReactiveProp('description', '')
const dialog = useRef<HTMLElement>('dashboardModalDialog')
const activeElement = useActiveElement()
const scrollLocked = useScrollLock()
const emit = defineEmits()
let restoreFocus: HTMLElement | null = null

function focusableElements(): HTMLElement[] {
  return [...(dialog.current?.querySelectorAll<HTMLElement>(
    'a[href]:not([tabindex="-1"]), button:not([disabled]):not([tabindex="-1"]), input:not([disabled]):not([tabindex="-1"]), select:not([disabled]):not([tabindex="-1"]), textarea:not([disabled]):not([tabindex="-1"]), [tabindex]:not([tabindex="-1"])',
  ) || [])].filter(element => element.offsetParent !== null)
}

function closeModal(): void {
  emit('close')
}

function handleKeydown(event: KeyboardEvent): void {
  if (!open()) return

  if (event.key === 'Escape' && liveClosable()) {
    event.preventDefault()
    event.stopPropagation()
    closeModal()
    return
  }

  if (event.key !== 'Tab') return
  const focusable = focusableElements()
  if (focusable.length === 0) {
    event.preventDefault()
    dialog.current?.focus()
    return
  }

  const first = focusable[0]
  const last = focusable[focusable.length - 1]
  if (event.shiftKey && (event.target === first || event.target === dialog.current)) {
    event.preventDefault()
    last.focus()
  }
  else if (!event.shiftKey && event.target === last) {
    event.preventDefault()
    first.focus()
  }
}

effect(() => {
  const isOpen = open()
  scrollLocked.value = isOpen

  if (isOpen) {
    const focused = peek(() => activeElement.value)
    if (focused instanceof HTMLElement)
      restoreFocus = focused
    void nextTick(() => dialog.current?.focus())
    return
  }

  const target = restoreFocus
  restoreFocus = null
  if (target)
    void nextTick(() => target.focus())
})
</script>
  <div :if="open()" class="fixed inset-0 overflow-y-auto z-[55] dashboard-modal-layer" @keydown="handleKeydown">
    <!-- Overlay -->
    <button type="button" class="absolute inset-0 w-full bg-black/50 backdrop-blur-sm" aria-label="Close modal" @click="closeModal"></button>

    <!-- Modal container -->
    <div class="flex items-center justify-center p-4 min-h-full">
      <div
        ref="dashboardModalDialog"
        role="dialog"
        aria-modal="true"
        :aria-label="liveTitle() || 'Dialog'"
        tabindex="-1"
        class="relative w-full rounded-xl bg-white dark:bg-neutral-900 shadow-2xl {{ sizeClasses[size] }}"
      >
        <!-- Header -->
        @if(title || closable)
          <div class="flex gap-4 items-start justify-between p-6 border-b border-neutral-200 dark:border-neutral-700">
            <div class="min-w-0">
                <h3 :if="liveTitle()" class="font-semibold text-lg text-neutral-900 dark:text-white">
                  {{ liveTitle() }}
                </h3>
                <p :if="liveDescription()" class="mt-1 text-neutral-500 text-sm dark:text-neutral-400">
                  {{ liveDescription() }}
                </p>
            </div>

            @if(closable)
              <Button
                variant="ghost"
                size="sm"
                iconOnly
                ariaLabel="Close modal"
                @click="closeModal"
              >
                <div class="h-5 w-5 i-hugeicons-cancel-01"></div>
              </Button>
            @endif
          </div>
        @endif

        <!-- Body -->
        <div class="p-6">
          <slot />
        </div>

        @if($slots.footer)
          <div class="flex items-center justify-end px-6 py-4 border-neutral-200 border-t dark:border-neutral-700">
            <slot name="footer" />
          </div>
        @endif
      </div>
    </div>
  </div>
