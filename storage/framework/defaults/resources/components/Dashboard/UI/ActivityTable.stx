<script client>
interface ActivityItem {
  id: number | string
  type: string
  title: string
  source?: string
  time: string
  status: 'success' | 'error' | 'warning' | 'info' | string
}

const activities = useReactiveProp('activities', [] as ActivityItem[])
const title = useReactiveProp('title', 'Recent activity')
const loading = useReactiveProp('loading', false)

function statusClass(status: string): string {
  if (status === 'success')
    return 'text-green-600 dark:text-green-400 bg-green-100 dark:bg-green-900/30'
  if (status === 'error')
    return 'text-red-600 dark:text-red-400 bg-red-100 dark:bg-red-900/30'
  if (status === 'warning')
    return 'text-amber-600 dark:text-amber-400 bg-amber-100 dark:bg-amber-900/30'
  return 'text-blue-600 dark:text-blue-400 bg-blue-100 dark:bg-blue-900/30'
}

function statusIcon(status: string): string {
  if (status === 'success')
    return 'i-hugeicons-checkmark-circle-02'
  if (status === 'error')
    return 'i-hugeicons-alert-02'
  if (status === 'warning')
    return 'i-hugeicons-alert-circle'
  return 'i-hugeicons-information-circle'
}
</script>

<section class="bg-white dark:bg-neutral-800/90 border border-black/5 rounded-xl dark:border-white/5">
  <header class="flex items-center justify-between p-5 border-b border-neutral-200/60 dark:border-white/5">
    <div>
      <h2 class="font-semibold text-[14px] text-neutral-900 tracking-tight dark:text-white">{{ title() }}</h2>
      <p class="mt-1 text-neutral-500 text-xs dark:text-neutral-400">Persisted orders and user registrations.</p>
    </div>
    <slot name="actions" />
  </header>

  <div :if="loading()" class="divide-neutral-100 divide-y dark:divide-white/5">
    <div :for="item in [1, 2, 3]" class="flex gap-3 items-center px-5 py-4">
      <div class="h-8 w-8 bg-neutral-100 dark:bg-neutral-700 rounded-lg animate-pulse"></div>
      <div class="flex-1">
        <div class="h-3.5 w-3/4 bg-neutral-100 dark:bg-neutral-700 rounded animate-pulse"></div>
        <div class="mt-2 h-3 w-1/3 bg-neutral-100 dark:bg-neutral-700 rounded animate-pulse"></div>
      </div>
    </div>
  </div>

  <div :if="!loading() && activities().length > 0" class="divide-neutral-100 divide-y dark:divide-white/5">
    <article :for="activity in activities()" class="flex gap-4 items-center px-5 py-3.5">
      <div :class="'flex flex-shrink-0 items-center justify-center h-8 w-8 rounded-lg ' + statusClass(activity.status)">
        <span :class="'h-4 w-4 ' + statusIcon(activity.status)" aria-hidden="true"></span>
      </div>
      <div class="flex-1 min-w-0">
        <p class="font-medium text-neutral-900 text-sm truncate dark:text-white">{{ activity.title }}</p>
        <p class="text-neutral-500 text-xs dark:text-neutral-400">
          <span :if="activity.source">{{ activity.source }} · </span>{{ activity.time }}
        </p>
      </div>
      <span class="flex-shrink-0 px-2 py-0.5 capitalize font-medium text-[10px] text-neutral-600 dark:text-neutral-300 bg-neutral-100 dark:bg-neutral-700 rounded-full">{{ activity.type }}</span>
    </article>
  </div>

  <div :if="!loading() && activities().length === 0" class="py-12 text-center">
    <span aria-hidden="true" class="inline-block h-7 w-7 text-neutral-300 dark:text-neutral-600 i-hugeicons-activity-01"></span>
    <p class="mt-2 font-medium text-neutral-900 text-sm dark:text-white">No recent activity</p>
    <p class="mt-1 text-[12px] text-neutral-500 dark:text-neutral-400">Persisted activity will appear here.</p>
  </div>
</section>
