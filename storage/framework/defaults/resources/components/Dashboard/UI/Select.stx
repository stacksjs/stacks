<script client>
interface SelectOption {
  value?: string | number
  id?: string | number
  label?: string
  text?: string
  disabled?: boolean
}

type SelectSize = 'xs' | 'sm' | 'md' | 'lg'

const liveValue = useReactiveProp('value', '')
const liveOptions = useReactiveProp('options', [])
const livePlaceholder = useReactiveProp('placeholder', 'Select an option')
const liveLabel = useReactiveProp('label', '')
const liveAriaLabel = useReactiveProp('ariaLabel', '')
const liveError = useReactiveProp('error', '')
const liveHint = useReactiveProp('hint', '')
const liveDisabled = useReactiveProp('disabled', false)
const liveRequired = useReactiveProp('required', false)
const liveSize = useReactiveProp('size', 'md' as SelectSize)
const liveName = useReactiveProp('name', '')
const liveId = useReactiveProp('id', '')
const emit = defineEmits()
const generatedId = useId('select')

const sizeClasses: Record<SelectSize, string> = {
  xs: 'h-6 text-[11px] px-2',
  sm: 'h-7 text-[12px] px-2.5',
  md: 'h-8 text-[13px] px-3',
  lg: 'h-9 text-[14px] px-3.5',
}

const selectId = derived(() => liveId() || generatedId)
const selectClass = derived(() => [
  'w-full flex items-center justify-between gap-2 rounded-md border transition-all duration-150',
  'focus:outline-none focus:ring-2 appearance-none pr-8',
  sizeClasses[liveSize()] || sizeClasses.md,
  liveError()
    ? 'border-red-400/60 dark:border-red-500/60 focus:ring-red-500/30 focus:border-red-500'
    : 'border-black/10 dark:border-white/15 focus:ring-blue-500/40 focus:border-blue-500/50 hover:border-black/20 dark:hover:border-white/25',
  liveDisabled()
    ? 'bg-black/5 dark:bg-white/5 text-neutral-400 cursor-not-allowed border-black/5 dark:border-white/10 opacity-40'
    : 'bg-white dark:bg-white/10',
].join(' '))

function optionValue(option: SelectOption | string | number): string | number {
  if (typeof option !== 'object' || option === null)
    return option
  return option.value ?? option.id ?? option.label ?? ''
}

function optionLabel(option: SelectOption | string | number): string {
  if (typeof option !== 'object' || option === null)
    return String(option)
  return String(option.label ?? option.text ?? option.value ?? '')
}

function optionDisabled(option: SelectOption | string | number): boolean {
  return typeof option === 'object' && option !== null && Boolean(option.disabled)
}

function handleChange(event: Event): void {
  const nextValue = (event.target as HTMLSelectElement).value
  emit('change', nextValue)
  emit('update:value', nextValue)
}
</script>

<div class="relative">
  <template :if="liveLabel()">
    <label :for="selectId()" class="block mb-1.5 font-medium text-[13px] text-neutral-600 tracking-tight dark:text-neutral-400">
      <span :text="liveLabel()"></span>
      <span :if="liveRequired()" class="text-red-500">*</span>
    </label>
  </template>

  <div class="relative">
    <select
      :id="selectId()"
      :name="liveName() || null"
      :aria-label="liveAriaLabel() || liveLabel() || null"
      x-model="liveValue"
      :class="selectClass()"
      @change="handleChange"
      :disabled="liveDisabled()"
      :required="liveRequired()"
    >
      <option :if="livePlaceholder()" value="" disabled>{{ livePlaceholder() }}</option>
      <option
        :for="option in liveOptions()"
        :value="optionValue(option)"
        :disabled="optionDisabled(option)"
      >
        {{ optionLabel(option) }}
      </option>
    </select>
    <div class="flex absolute inset-y-0 right-0 items-center pr-2 pointer-events-none">
      <div class="h-3.5 w-3.5 text-neutral-400 i-hugeicons-arrow-down-01"></div>
    </div>
  </div>

  <p :if="liveError()" class="mt-1.5 text-[12px] text-red-600 dark:text-red-400" :text="liveError()"></p>
  <p :if="!liveError() && liveHint()" class="mt-1.5 text-[12px] text-neutral-500 dark:text-neutral-400" :text="liveHint()"></p>
</div>
