<script client>
type ConfirmVariant = 'danger' | 'warning'

const open = useReactiveProp('isOpen', false)
const title = useReactiveProp('title', 'Are you sure?')
const description = useReactiveProp('description', 'This action cannot be undone.')
const confirmLabel = useReactiveProp('confirmLabel', 'Delete')
const cancelLabel = useReactiveProp('cancelLabel', 'Cancel')
const variant = useReactiveProp('variant', 'danger' as ConfirmVariant)
const busy = useReactiveProp('busy', false)
const emit = defineEmits()

function close(): void {
  if (!busy())
    emit('close')
}

function confirm(): void {
  if (!busy())
    emit('confirm')
}

function iconClass(): string {
  return variant() === 'warning'
    ? 'bg-orange-500/15 text-orange-600 dark:bg-orange-400/20 dark:text-orange-400'
    : 'bg-red-500/15 text-red-600 dark:bg-red-400/20 dark:text-red-400'
}

function iconName(): string {
  return variant() === 'warning' ? 'i-hugeicons-alert-circle' : 'i-hugeicons-alert-02'
}

function confirmClass(): string {
  return variant() === 'warning'
    ? 'bg-orange-600 hover:bg-orange-500 focus-visible:ring-orange-500'
    : 'bg-red-600 hover:bg-red-500 focus-visible:ring-red-500'
}
</script>

<template :if="open()">
  <div class="fixed inset-0 overflow-y-auto z-[55] dashboard-modal-layer" @keydown.escape="close">
    <button type="button" class="fixed inset-0 w-full bg-black/50 backdrop-blur-sm cursor-default" aria-label="Close confirmation dialog" @click="close"></button>

    <div class="flex relative items-center justify-center p-4 min-h-full">
      <section
        role="alertdialog"
        aria-modal="true"
        :aria-label="title()"
        class="relative p-6 max-w-md w-full bg-white dark:bg-neutral-900 rounded-xl shadow-2xl"
      >
        <div class="flex gap-4 items-start">
          <div class="shrink-0 p-2.5 rounded-lg" :class="iconClass()">
            <span class="block h-5 w-5" :class="iconName()"></span>
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="font-semibold text-lg text-neutral-900 dark:text-white">
              {{ title() }}
            </h3>
            <p class="mt-1 text-neutral-500 text-sm dark:text-neutral-400">
              {{ description() }}
            </p>
          </div>
        </div>

        <div class="flex gap-2 items-center justify-end mt-6">
          <button
            type="button"
            class="inline-flex items-center justify-center px-3 py-1.5 font-medium text-[13px] text-neutral-800 tracking-tight dark:text-neutral-100 bg-white/80 dark:bg-white/10 hover:bg-white dark:hover:bg-white/15 border border-black/10 rounded-lg dark:border-white/10 shadow-sm disabled:opacity-50 duration-150 transition-all"
            :disabled="busy()"
            @click="close"
          >
            {{ cancelLabel() }}
          </button>
          <button
            type="button"
            class="inline-flex gap-1.5 items-center justify-center px-3 py-1.5 font-medium text-[13px] text-white tracking-tight rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-neutral-900 shadow-sm disabled:opacity-50 duration-150 transition-colors"
            :class="confirmClass()"
            :disabled="busy()"
            @click="confirm"
          >
            <span :if="busy()" class="h-4 w-4 animate-spin i-hugeicons-loading-03"></span>
            {{ confirmLabel() }}
          </button>
        </div>
      </section>
    </div>
  </div>
</template>
