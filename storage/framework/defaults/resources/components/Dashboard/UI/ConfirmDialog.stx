<script client>
type ConfirmVariant = 'danger' | 'warning'

const open = useReactiveProp('isOpen', false)
const title = useReactiveProp('title', 'Are you sure?')
const description = useReactiveProp('description', 'This action cannot be undone.')
const confirmLabel = useReactiveProp('confirmLabel', 'Delete')
const cancelLabel = useReactiveProp('cancelLabel', 'Cancel')
const variant = useReactiveProp('variant', 'danger' as ConfirmVariant)
const busy = useReactiveProp('busy', false)
const emit = defineEmits()

function close(): void {
  if (!busy())
    emit('close')
}

function confirm(): void {
  if (!busy())
    emit('confirm')
}

function iconClass(): string {
  return variant() === 'warning'
    ? 'bg-orange-500/15 text-orange-600 dark:bg-orange-400/20 dark:text-orange-400'
    : 'bg-red-500/15 text-red-600 dark:bg-red-400/20 dark:text-red-400'
}

function iconName(): string {
  return variant() === 'warning' ? 'i-hugeicons-alert-circle' : 'i-hugeicons-alert-02'
}

</script>

<Modal
  :isOpen="open()"
  :title="title()"
  :description="description()"
  :closable="!busy()"
  role="alertdialog"
  size="sm"
  @close="close"
>
  <template #header-leading>
    <div class="shrink-0 p-2.5 rounded-lg" :class="iconClass()">
      <span class="block h-5 w-5" :class="iconName()"></span>
    </div>
  </template>

  <template #footer>
    <div class="flex gap-2 items-center justify-end">
      <Button
        variant="secondary"
        :disabled="busy()"
        @click="close"
      >
        {{ cancelLabel() }}
      </Button>
      <Button
        :if="variant() === 'warning'"
        variant="warning"
        :loading="busy()"
        @click="confirm"
      >
        {{ confirmLabel() }}
      </Button>
      <Button
        :if="variant() !== 'warning'"
        variant="danger"
        :loading="busy()"
        @click="confirm"
      >
        {{ confirmLabel() }}
      </Button>
    </div>
  </template>
</Modal>
