<script client>
import type { DeploymentRecord } from '../../../../functions/deployments'
import { fetchDeployments, summarizeDeployments } from '../../../../functions/deployments'
import { pushToast } from '../../../../functions/toasts'

const deployments = state<DeploymentRecord[]>([])
const search = state('')
const status = state('all')
const isLoading = state(true)
const loadError = state('')
const summary = derived(() => summarizeDeployments(deployments()))

function rows(): DeploymentRecord[] {
  const query = search().trim().toLowerCase()
  return deployments().filter((deployment) => {
    if (status() !== 'all' && deployment.status !== status())
      return false
    if (!query)
      return true
    return [
      deployment.commitHash,
      deployment.commitMessage,
      deployment.branch,
      deployment.environment,
      deployment.author,
    ].some(value => value.toLowerCase().includes(query))
  })
}

function updateSearch(event: Event): void {
  search.set((event.target as HTMLInputElement).value)
}

function updateStatus(event: Event): void {
  status.set((event.target as HTMLSelectElement).value)
}

function formatNumber(value: number): string {
  return new Intl.NumberFormat().format(value)
}

function formatDuration(value: number | null): string {
  if (value === null)
    return 'Not recorded'
  if (value < 60)
    return `${Math.round(value)}s`
  const minutes = Math.floor(value / 60)
  const seconds = Math.round(value % 60)
  return seconds > 0 ? `${minutes}m ${seconds}s` : `${minutes}m`
}

async function loadDeployments(): Promise<void> {
  isLoading.set(true)
  loadError.set('')
  try {
    deployments.set(await fetchDeployments())
  }
  catch (error) {
    loadError.set('Deployment records could not be loaded.')
    pushToast('error', 'Could not load deployments', { detail: String(error) })
  }
  finally {
    isLoading.set(false)
  }
}

onMount(() => {
  void loadDeployments()
})
</script>

<div class="space-y-6">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="font-bold text-2xl text-gray-900 dark:text-white">Deployments</h1>
      <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Deployment model records through the guarded dashboard API.</p>
    </div>
    <button type="button" :disabled="isLoading()" class="inline-flex items-center px-3 py-2 font-semibold text-gray-700 text-sm dark:text-neutral-200 bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700 disabled:opacity-50" @click="loadDeployments">
      <span :class="'mr-2 h-4 w-4 ' + (isLoading() ? 'animate-spin i-hugeicons-loading-03' : 'i-hugeicons-refresh')"></span>
      Refresh
    </button>
  </header>

  <div :if="loadError()" class="p-4 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">{{ loadError() }}</div>

  <section class="grid gap-3 grid-cols-2 lg:grid-cols-4">
    <div class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
      <p class="text-gray-500 text-xs uppercase dark:text-neutral-400">Recorded</p>
      <p class="mt-2 font-semibold text-2xl text-gray-900 dark:text-white">{{ formatNumber(summary().total) }}</p>
    </div>
    <div class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
      <p class="text-gray-500 text-xs uppercase dark:text-neutral-400">Successful</p>
      <p class="mt-2 font-semibold text-2xl text-gray-900 dark:text-white">{{ formatNumber(summary().successful) }}</p>
    </div>
    <div class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
      <p class="text-gray-500 text-xs uppercase dark:text-neutral-400">Failed</p>
      <p class="mt-2 font-semibold text-2xl text-gray-900 dark:text-white">{{ formatNumber(summary().failed) }}</p>
    </div>
    <div class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
      <p class="text-gray-500 text-xs uppercase dark:text-neutral-400">Average duration</p>
      <p class="mt-2 font-semibold text-2xl text-gray-900 dark:text-white">{{ formatDuration(summary().averageDuration) }}</p>
    </div>
  </section>

  <section class="space-y-3">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2 class="font-semibold text-gray-900 dark:text-white">Deployment history</h2>
        <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">No estimated totals or synthetic build activity.</p>
      </div>
      <div class="flex gap-2">
        <label class="sr-only" for="deployment-status">Status</label>
        <select id="deployment-status" :value="status()" class="px-3 py-2 text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700" @change="updateStatus($event)">
          <option value="all">All statuses</option>
          <option value="success">Success</option>
          <option value="failed">Failed</option>
          <option value="running">Running</option>
          <option value="pending">Pending</option>
          <option value="cancelled">Cancelled</option>
        </select>
        <label class="sr-only" for="deployment-search">Search deployments</label>
        <input id="deployment-search" :value="search()" type="search" placeholder="Search deployments" class="px-3 py-2 w-56 text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700" @input="updateSearch($event)" />
      </div>
    </div>
    <DeploymentTable :deployments="rows()" :loading="isLoading" />
  </section>
</div>
