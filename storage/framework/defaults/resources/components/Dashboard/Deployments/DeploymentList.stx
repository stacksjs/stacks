<script client>
import type { DeploymentRecord } from '../../../../functions/deployments'
import { dashboardApi } from '../../../../functions/dashboard-api'
import { fetchDeployments, summarizeDeployments } from '../../../../functions/deployments'
import { pushToast } from '../../../../functions/toasts'

interface DeploymentStartResponse {
  success: boolean
  message: string
  pid?: number
}

const deployments = state<DeploymentRecord[]>([])
const search = state('')
const status = state('all')
const isLoading = state(true)
const loadError = state('')
const showDeployModal = state(false)
const isStarting = state(false)
const environment = state('production')
const domain = state('')
const summary = derived(() => summarizeDeployments(deployments()))
const environmentOptions = [
  { value: 'production', label: 'Production' },
  { value: 'staging', label: 'Staging' },
  { value: 'development', label: 'Development' },
]

function rows(): DeploymentRecord[] {
  const query = search().trim().toLowerCase()
  return deployments().filter((deployment) => {
    if (status() !== 'all' && deployment.status !== status())
      return false
    if (!query)
      return true
    return [
      deployment.commitHash,
      deployment.commitMessage,
      deployment.branch,
      deployment.environment,
      deployment.author,
    ].some(value => value.toLowerCase().includes(query))
  })
}

function formatNumber(value: number): string {
  return new Intl.NumberFormat().format(value)
}

function formatDuration(value: number | null): string {
  if (value === null)
    return 'Not recorded'
  if (value < 60)
    return `${Math.round(value)}s`
  const minutes = Math.floor(value / 60)
  const seconds = Math.round(value % 60)
  return seconds > 0 ? `${minutes}m ${seconds}s` : `${minutes}m`
}

async function loadDeployments(): Promise<void> {
  isLoading.set(true)
  loadError.set('')
  try {
    deployments.set(await fetchDeployments())
  }
  catch (error) {
    loadError.set('Deployment records could not be loaded.')
    pushToast('error', 'Could not load deployments', { detail: String(error) })
  }
  finally {
    isLoading.set(false)
  }
}

async function startDeployment(dryRun: boolean): Promise<void> {
  isStarting.set(true)
  try {
    const result = await dashboardApi<DeploymentStartResponse>('/api/dashboard/deployments', {
      method: 'POST',
      body: {
        confirmed: !dryRun,
        dryRun,
        environment: environment(),
        domain: domain().trim(),
      },
    })
    if (!result.success)
      throw new Error(result.message)
    showDeployModal.set(false)
    pushToast('success', result.message, {
      detail: result.pid ? `Process ${result.pid}` : undefined,
    })
    if (!dryRun)
      await loadDeployments()
  }
  catch (error) {
    pushToast('error', dryRun ? 'Could not preview deployment' : 'Could not start deployment', {
      detail: error instanceof Error ? error.message : String(error),
    })
  }
  finally {
    isStarting.set(false)
  }
}

onMount(() => {
  void loadDeployments()
})
</script>

<div class="space-y-6">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="font-bold text-2xl text-gray-900 dark:text-white">Deployments</h1>
      <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Deployment model records through the guarded dashboard API.</p>
    </div>
    <div class="flex gap-2 items-center">
      <Button :disabled="isStarting()" variant="outline" @click="startDeployment(true)">
        Preview
      </Button>
      <Button :disabled="isStarting()" @click="showDeployModal.set(true)">
        Deploy
      </Button>
      <Button :loading="isLoading()" variant="secondary" @click="loadDeployments">
        <span :if="!isLoading()" aria-hidden="true" class="h-4 w-4 i-hugeicons-refresh"></span>
        Refresh
      </Button>
    </div>
  </header>

  <div :if="loadError()" class="p-4 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">{{ loadError() }}</div>

  <section class="grid gap-3 grid-cols-2 lg:grid-cols-4">
    <div class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
      <p class="text-gray-500 text-xs uppercase dark:text-neutral-400">Recorded</p>
      <p class="mt-2 font-semibold text-2xl text-gray-900 dark:text-white">{{ formatNumber(summary().total) }}</p>
    </div>
    <div class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
      <p class="text-gray-500 text-xs uppercase dark:text-neutral-400">Successful</p>
      <p class="mt-2 font-semibold text-2xl text-gray-900 dark:text-white">{{ formatNumber(summary().successful) }}</p>
    </div>
    <div class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
      <p class="text-gray-500 text-xs uppercase dark:text-neutral-400">Failed</p>
      <p class="mt-2 font-semibold text-2xl text-gray-900 dark:text-white">{{ formatNumber(summary().failed) }}</p>
    </div>
    <div class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
      <p class="text-gray-500 text-xs uppercase dark:text-neutral-400">Average duration</p>
      <p class="mt-2 font-semibold text-2xl text-gray-900 dark:text-white">{{ formatDuration(summary().averageDuration) }}</p>
    </div>
  </section>

  <section class="space-y-3">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2 class="font-semibold text-gray-900 dark:text-white">Deployment history</h2>
        <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">No estimated totals or synthetic build activity.</p>
      </div>
      <div class="flex gap-2">
        <label class="sr-only" for="deployment-status">Status</label>
        <select id="deployment-status" x-model="status" class="px-3 py-2 text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700">
          <option value="all">All statuses</option>
          <option value="success">Success</option>
          <option value="failed">Failed</option>
          <option value="running">Running</option>
          <option value="pending">Pending</option>
          <option value="cancelled">Cancelled</option>
        </select>
        <label class="sr-only" for="deployment-search">Search deployments</label>
        <input id="deployment-search" x-model="search" type="search" placeholder="Search deployments" class="px-3 py-2 w-56 text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700" />
      </div>
    </div>
    <DeploymentTable :deployments="rows()" :loading="isLoading" />
  </section>

  <section class="grid gap-6 grid-cols-1 xl:grid-cols-2">
    <DeployScript />
    <LiveTerminalOutput />
  </section>

  <Modal
    :isOpen="showDeployModal()"
    title="Start deployment"
    description="This runs ./buddy deploy as a real background process and records its status."
    size="sm"
    @close="showDeployModal.set(false)"
  >
    <div class="space-y-4">
      <Select
        v-model:value="environment"
        :options="environmentOptions"
        label="Environment"
        placeholder=""
      />
      <Input
        v-model:value="domain"
        type="text"
        label="Domain"
        placeholder="app.example.com"
        hint="Optional. Leave blank to use the configured deployment domain."
      />
      <div class="p-3 text-amber-800 text-sm dark:text-amber-200 bg-amber-50 dark:bg-amber-950/30 border border-amber-200 rounded-lg dark:border-amber-900">
        A deployment can create or update cloud resources. Confirm only after reviewing the target environment.
      </div>
    </div>
    <template #footer>
      <div class="flex gap-2 items-center">
        <Button :disabled="isStarting()" variant="ghost" @click="showDeployModal.set(false)">Cancel</Button>
        <Button :loading="isStarting()" @click="startDeployment(false)">Start deployment</Button>
      </div>
    </template>
  </Modal>
</div>
