<script client>
import type { DeploymentRecord } from '../../../../functions/deployments'

const deployments = useReactiveProp('deployments', [])
const loading = useReactiveProp('loading', false)

function rows(): DeploymentRecord[] {
  return deployments() as DeploymentRecord[]
}

function formatDate(value: string): string {
  if (!value)
    return 'Not recorded'
  const date = new Date(value)
  return Number.isNaN(date.getTime())
    ? value
    : new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' }).format(date)
}

function formatDuration(value: number | null): string {
  if (value === null)
    return '-'
  if (value < 60)
    return `${Math.round(value)}s`
  const minutes = Math.floor(value / 60)
  const seconds = Math.round(value % 60)
  return seconds > 0 ? `${minutes}m ${seconds}s` : `${minutes}m`
}

function statusClass(status: string): string {
  if (['success', 'successful', 'completed', 'ready'].includes(status))
    return 'text-green-700 dark:text-green-300 bg-green-50 dark:bg-green-950/40'
  if (['failed', 'error', 'cancelled'].includes(status))
    return 'text-red-700 dark:text-red-300 bg-red-50 dark:bg-red-950/40'
  if (['pending', 'queued', 'running', 'deploying'].includes(status))
    return 'text-amber-700 dark:text-amber-300 bg-amber-50 dark:bg-amber-950/40'
  return 'text-gray-700 dark:text-neutral-300 bg-gray-100 dark:bg-neutral-700'
}

function statusLabel(status: string): string {
  if (!status)
    return 'Unknown'
  return status.charAt(0).toUpperCase() + status.slice(1)
}
</script>

<div class="overflow-hidden bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
  <div :if="loading()" class="px-5 py-12 text-center text-gray-500 text-sm dark:text-neutral-400">Loading deployments</div>
  <div :if="!loading() && rows().length === 0" class="px-5 py-12 text-center">
    <div class="mb-3 mx-auto h-9 w-9 text-gray-400 i-hugeicons-rocket-01"></div>
    <p class="font-semibold text-gray-900 dark:text-white">No deployment records found</p>
    <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Records appear when a deployment integration writes to the Deployment model.</p>
  </div>
  <div :if="rows().length > 0" class="overflow-x-auto">
    <table class="min-w-full divide-gray-200 divide-y dark:divide-neutral-700">
      <thead class="bg-gray-50 dark:bg-neutral-700/50">
        <tr>
          <th class="px-4 py-3 font-medium text-gray-500 text-left text-xs uppercase dark:text-neutral-300">Commit</th>
          <th class="px-4 py-3 font-medium text-gray-500 text-left text-xs uppercase dark:text-neutral-300">Environment</th>
          <th class="px-4 py-3 font-medium text-gray-500 text-left text-xs uppercase dark:text-neutral-300">Status</th>
          <th class="px-4 py-3 font-medium text-gray-500 text-right text-xs uppercase dark:text-neutral-300">Duration</th>
          <th class="px-4 py-3 font-medium text-gray-500 text-right text-xs uppercase dark:text-neutral-300">Created</th>
          <th class="px-4 py-3"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody class="divide-gray-200 divide-y dark:divide-neutral-700">
        <template :for="deployment in rows()">
          <tr>
            <td class="px-4 py-3">
              <p class="font-medium text-gray-900 text-sm dark:text-white">{{ deployment.commitMessage || 'No commit message' }}</p>
              <p class="mt-0.5 font-mono text-gray-500 text-xs dark:text-neutral-400">{{ deployment.commitHash || 'No commit hash' }} · {{ deployment.branch || 'No branch' }}</p>
            </td>
            <td class="px-4 py-3 text-gray-500 text-sm dark:text-neutral-300">{{ deployment.environment || 'Not recorded' }}</td>
            <td class="px-4 py-3">
              <span :class="'inline-flex px-2 py-1 font-medium text-xs rounded-md ' + statusClass(deployment.status)">{{ statusLabel(deployment.status) }}</span>
            </td>
            <td class="px-4 py-3 font-mono text-gray-500 text-right text-sm dark:text-neutral-300">{{ formatDuration(deployment.duration) }}</td>
            <td class="px-4 py-3 text-gray-500 text-right text-sm whitespace-nowrap dark:text-neutral-300">{{ formatDate(deployment.createdAt) }}</td>
            <td class="px-4 py-3 text-right">
              <StxLink :to="'/deployments/' + deployment.id" class="font-medium text-blue-600 text-sm dark:text-blue-400 hover:text-blue-500">View</StxLink>
            </td>
          </tr>
        </template>
      </tbody>
    </table>
  </div>
</div>
