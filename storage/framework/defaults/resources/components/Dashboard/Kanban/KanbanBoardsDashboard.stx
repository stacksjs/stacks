<script client>
  // Lists every non-archived board with a card-count badge. Clicking a
  // board navigates to its complete drag-and-drop view.
  //
  // Follows #1838 conventions: no <script server>, no vanilla DOM
  // reads, all state via the store. Role gate via useRole() - the
  // surface is dev-mode-only (admins + devs see it, clients don't).
  import { useRole } from '~/storage/framework/defaults/views/dashboard/composables/useRole'
  import { kanbanStore } from '~/storage/framework/defaults/views/dashboard/stores/kanban'

  // Keep the page component self-contained: the imported store definition is
  // registered before this controller runs on both direct and SPA navigation.
  const kanban = kanbanStore
  const { isDev } = useRole()
  const canView = derived(() => isDev())

  const loading = derived(() => kanban.loading())
  const error = derived(() => kanban.error())
  const boards = derived(() => kanban.boards())
  const hasBoards = derived(() => kanban.hasBoards())

  // ─── New-board modal ──────────────────────────────────────────────
  interface BoardDeleteTarget {
    id: number
    name: string
    cardCount: number
  }

  const isCreating = state(false)
  const draftName = state('')
  const draftDescription = state('')
  const draftColor = state('violet')
  const submitting = state(false)
  const submitError = state('')
  const pendingBoardDelete = state<BoardDeleteTarget | null>(null)
  const deletingBoard = state(false)

  const colorChoices = ['violet', 'blue', 'emerald', 'amber', 'rose', 'slate']

  function openCreate() {
    isCreating.set(true)
    draftName.set('')
    draftDescription.set('')
    draftColor.set('violet')
    submitError.set('')
  }
  function closeCreate() {
    isCreating.set(false)
    submitError.set('')
  }

  function handleKeydown(event: KeyboardEvent): void {
    if (event.key === 'Escape' && isCreating())
      closeCreate()
  }

  useEventListener('keydown', handleKeydown)
  async function submitCreate() {
    const name = draftName().trim()
    if (!name) {
      submitError.set('Name is required.')
      return
    }
    submitting.set(true)
    submitError.set('')
    const result = await kanban.createBoard({
      name,
      description: draftDescription().trim() || undefined,
      color: draftColor(),
    })
    submitting.set(false)
    if (result)
      closeCreate()
    else
      submitError.set(kanban.error() || 'Failed to create board.')
  }

  const boardDeleteDescription = derived(() => {
    const selected = pendingBoardDelete()
    if (!selected)
      return ''
    const count = selected.cardCount || 0
    return count > 0
      ? `${count} ${count === 1 ? 'card' : 'cards'} and every column on this board will also be deleted.`
      : 'Every column on this board will also be deleted.'
  })

  async function confirmBoardDelete(): Promise<void> {
    const selected = pendingBoardDelete()
    if (!selected || deletingBoard())
      return
    deletingBoard.set(true)
    try {
      if (await kanban.deleteBoard(selected.id))
        pendingBoardDelete.set(null)
    }
    finally {
      deletingBoard.set(false)
    }
  }

  function colorSwatchClass(c) {
    return ({
      violet: 'bg-violet-500',
      blue: 'bg-blue-500',
      emerald: 'bg-emerald-500',
      amber: 'bg-amber-500',
      rose: 'bg-rose-500',
      slate: 'bg-slate-500',
    })[c] || 'bg-violet-500'
  }

  function colorButtonClass(c) {
    const base = `w-6 h-6 rounded-full ${colorSwatchClass(c)} cursor-pointer transition-all `
    return draftColor() === c
      ? base + 'ring-2 ring-offset-2 ring-violet-500 dark:ring-offset-zinc-950'
      : base + 'opacity-60 hover:opacity-100'
  }

  // Color → tailwind class. Free-form string in the model, mapped here
  // so the UI stays stable when a new hue is added without an explicit
  // mapping (falls back to violet).
  function accentClass(color) {
    return ({
      violet: 'bg-violet-500',
      blue: 'bg-blue-500',
      emerald: 'bg-emerald-500',
      amber: 'bg-amber-500',
      rose: 'bg-rose-500',
      slate: 'bg-slate-500',
    })[color] || 'bg-violet-500'
  }

  function cardCountText(n) {
    if (n === 0) return 'No cards'
    if (n === 1) return '1 card'
    return n + ' cards'
  }

  kanban.loadBoards()
</script>

<template>
<div class="mx-auto px-6 py-8 max-w-7xl">
  <!-- Role gate. The full RBAC check via useRole(); unauthenticated
      dev-dashboard viewers see the surface as if they were a dev per
      the permissive default. -->
  <div :if="!canView" class="px-5 py-8 text-center bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 rounded-lg dark:border-zinc-800">
    <p class="text-sm text-zinc-600 dark:text-zinc-400">Kanban boards require the dev role.</p>
  </div>

  <div :if="canView">
    <header class="flex items-center justify-between mb-6">
      <div>
        <h1 class="font-semibold text-2xl text-zinc-900 dark:text-zinc-100">Boards</h1>
        <p class="mt-1 text-sm text-zinc-500">Internal project-management boards with native card and column reordering.</p>
      </div>
      <Button @click="openCreate()">
        New board
      </Button>
    </header>

    <!-- Loading -->
    <div :if="loading" class="flex items-center justify-center min-h-[40vh]">
      <span class="h-7 w-7 text-violet-500 animate-spin i-hugeicons-loading-03"></span>
    </div>

    <!-- Error -->
    <div :if="error && !loading" class="px-5 py-4 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900/40">
      <p class="font-medium text-red-700 text-sm dark:text-red-300">Couldn't load boards</p>
      <p class="mt-1 text-red-600 text-xs dark:text-red-400" :text="error"></p>
      <p class="mt-2 text-xs text-zinc-500">Most common: migrations haven't run yet. Try <code>./buddy migrate</code>.</p>
    </div>

    <!-- Empty state - DB reachable but no boards yet -->
    <div :if="!loading && !error && !hasBoards" class="px-6 py-12 text-center border border-dashed border-zinc-300 rounded-lg dark:border-zinc-700">
      <span class="block mb-3 mx-auto h-10 w-10 text-zinc-400 i-hugeicons-layout-3-column"></span>
      <p class="font-medium text-sm text-zinc-700 dark:text-zinc-300">No boards yet</p>
      <p class="mt-1 text-xs text-zinc-500">Click "New board" to create one.</p>
    </div>

    <!-- Boards grid -->
    <div :if="!loading && !error && hasBoards" class="grid gap-4 grid-cols-[repeat(auto-fill,minmax(280px,1fr))]">
      <article
        :for="board in boards"
        class="overflow-hidden relative bg-white dark:bg-zinc-900 border border-zinc-200 rounded-lg dark:border-zinc-800 hover:border-zinc-300 dark:hover:border-zinc-700 transition-colors group"
      >
        <StxLink
          :to="`/kanban/${board.id}`"
          prefetch
          class="block no-underline"
        >
          <div :class="`h-2 ${accentClass(board.color)}`"></div>
          <div class="pr-11 px-4 py-3">
            <h2 class="font-medium text-sm text-zinc-900 truncate dark:text-zinc-100 group-hover:text-violet-600 dark:group-hover:text-violet-400" :text="board.name"></h2>
            <p
              :if="board.description"
              class="mt-1 line-clamp-2 text-xs text-zinc-500"
              :text="board.description"
            ></p>
            <p class="mt-3 text-xs text-zinc-400" :text="cardCountText(board.cardCount)"></p>
          </div>
        </StxLink>
        <span class="absolute right-3 top-4 opacity-0 focus-within:opacity-100 group-hover:opacity-100 transition-opacity">
          <Button variant="ghost" size="sm" iconOnly :ariaLabel="'Delete ' + board.name" @click="pendingBoardDelete.set(board)">
            <span class="block h-4 w-4 text-red-500 i-hugeicons-delete-02"></span>
          </Button>
        </span>
      </article>
    </div>
  </div>

  <Modal
    :isOpen="isCreating()"
    title="New board"
    size="md"
    @close="closeCreate()"
  >
    <form @submit.prevent="submitCreate">
      <div class="space-y-4">
        <div>
          <label for="kanban-board-name" class="block mb-1 font-medium text-xs text-zinc-700 dark:text-zinc-300">Name</label>
          <input
            id="kanban-board-name"
            x-model="draftName"
            placeholder="e.g. Q3 Roadmap"
            class="px-3 py-2 w-full text-sm text-zinc-900 dark:text-zinc-100 bg-white dark:bg-zinc-950 border border-zinc-300 rounded dark:border-zinc-700 focus:border-violet-500 focus:outline-none"
            required
          />
        </div>

        <div>
          <label for="kanban-board-description" class="block mb-1 font-medium text-xs text-zinc-700 dark:text-zinc-300">Description <span class="text-zinc-400">(optional)</span></label>
          <textarea
            id="kanban-board-description"
            x-model="draftDescription"
            rows="3"
            placeholder="A short description of what this board tracks."
            class="px-3 py-2 w-full text-sm text-zinc-900 dark:text-zinc-100 bg-white dark:bg-zinc-950 border border-zinc-300 rounded dark:border-zinc-700 focus:border-violet-500 focus:outline-none resize-none"
          ></textarea>
        </div>

        <div>
          <label class="block mb-2 font-medium text-xs text-zinc-700 dark:text-zinc-300">Accent color</label>
          <div class="flex gap-2 items-center" role="group" aria-label="Board accent color">
            <button
              :for="c in colorChoices"
              @click="draftColor.set(c)"
              :class="colorButtonClass(c)"
              :aria-label="'Use ' + c + ' accent'"
              :aria-pressed="String(draftColor() === c)"
              type="button"
            ></button>
          </div>
        </div>

        <p :if="submitError()" class="text-red-600 text-xs dark:text-red-400" :text="submitError()"></p>
      </div>

      <div class="flex gap-2 justify-end mt-5 pt-4 border-t border-zinc-200 dark:border-zinc-800">
        <Button variant="secondary" :disabled="submitting()" @click="closeCreate()">
          Cancel
        </Button>
        <Button type="submit" :loading="submitting()">
          <span :if="!submitting()">Create</span>
          <span :if="submitting()">Creating…</span>
        </Button>
      </div>
    </form>
  </Modal>

  <ConfirmDialog
    :isOpen="Boolean(pendingBoardDelete())"
    title="Delete this board?"
    :description="boardDeleteDescription()"
    :busy="deletingBoard()"
    :confirmLabel="deletingBoard() ? 'Deleting' : 'Delete'"
    @close="pendingBoardDelete.set(null)"
    @confirm="confirmBoardDelete"
  />
</div>
</template>
