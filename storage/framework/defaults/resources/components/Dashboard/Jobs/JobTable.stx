<script client>
import type { DashboardJob } from '../../../../functions/jobs'

const jobs = useReactiveProp('jobs', [])
const loading = useReactiveProp('loading', false)
const emptyTitle = useReactiveProp('emptyTitle', 'No jobs found')
const emit = defineEmits()

function rows(): DashboardJob[] {
  return jobs() as DashboardJob[]
}

function formatDate(value?: string): string {
  if (!value)
    return 'Not recorded'
  const date = new Date(value)
  return Number.isNaN(date.getTime())
    ? value
    : new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' }).format(date)
}

function statusClass(status: DashboardJob['status']): string {
  const classes: Record<DashboardJob['status'], string> = {
    queued: 'text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-950/40',
    processing: 'text-amber-700 dark:text-amber-300 bg-amber-50 dark:bg-amber-950/40',
    failed: 'text-red-700 dark:text-red-300 bg-red-50 dark:bg-red-950/40',
  }
  return classes[status]
}

function attemptsLabel(job: DashboardJob): string {
  if (job.attempts === null)
    return 'Not recorded'
  return job.maxAttempts === null
    ? String(job.attempts)
    : `${job.attempts} / ${job.maxAttempts}`
}
</script>

<div class="overflow-hidden bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
  <div :if="loading()" class="px-5 py-12 text-center text-gray-500 text-sm dark:text-neutral-400">
    Loading jobs
  </div>
  <div :if="!loading() && rows().length === 0" class="px-5 py-12 text-center">
    <div class="mb-3 mx-auto h-9 w-9 text-gray-400 i-hugeicons-layers-01"></div>
    <p class="font-semibold text-gray-900 dark:text-white">{{ emptyTitle() }}</p>
    <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Jobs appear here after they are dispatched through the configured queue.</p>
  </div>
  <div :if="rows().length > 0" class="overflow-x-auto">
    <table class="min-w-full divide-gray-200 divide-y dark:divide-neutral-700">
      <thead class="bg-gray-50 dark:bg-neutral-700/50">
        <tr>
          <th class="px-4 py-3 font-medium text-gray-500 text-left text-xs uppercase dark:text-neutral-300">Job</th>
          <th class="px-4 py-3 font-medium text-gray-500 text-left text-xs uppercase dark:text-neutral-300">Queue</th>
          <th class="px-4 py-3 font-medium text-gray-500 text-left text-xs uppercase dark:text-neutral-300">Status</th>
          <th class="px-4 py-3 font-medium text-gray-500 text-right text-xs uppercase dark:text-neutral-300">Attempts</th>
          <th class="px-4 py-3 font-medium text-gray-500 text-right text-xs uppercase dark:text-neutral-300">Duration</th>
          <th class="px-4 py-3 font-medium text-gray-500 text-right text-xs uppercase dark:text-neutral-300">Created</th>
          <th class="px-4 py-3"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody class="divide-gray-200 divide-y dark:divide-neutral-700">
        <template :for="job in rows()">
          <tr>
            <td class="px-4 py-3">
              <p class="font-medium text-gray-900 text-sm dark:text-white">{{ job.name }}</p>
              <p class="mt-0.5 font-mono text-gray-500 text-xs dark:text-neutral-400">{{ job.id }}</p>
            </td>
            <td class="px-4 py-3 text-gray-500 text-sm dark:text-neutral-300">{{ job.queue }}</td>
            <td class="px-4 py-3">
              <span :class="'inline-flex px-2 py-1 font-medium text-xs rounded-md ' + statusClass(job.status)">{{ job.status }}</span>
            </td>
            <td class="px-4 py-3 text-gray-500 text-right text-sm dark:text-neutral-300">{{ attemptsLabel(job) }}</td>
            <td class="px-4 py-3 font-mono text-gray-500 text-right text-sm dark:text-neutral-300">{{ job.duration || 'Not recorded' }}</td>
            <td class="px-4 py-3 text-gray-500 text-right text-sm whitespace-nowrap dark:text-neutral-300">{{ formatDate(job.created_at) }}</td>
            <td class="px-4 py-3 text-right">
              <div class="inline-flex gap-3 items-center">
                <StxLink :to="'/jobs/' + encodeURIComponent(job.id)" class="font-medium text-neutral-600 text-sm dark:text-neutral-300 hover:text-blue-600 dark:hover:text-blue-400">
                  View
                </StxLink>
                <Button :if="job.status === 'failed'" size="sm" @click="emit('retry', job.id)">
                  Retry
                </Button>
              </div>
            </td>
          </tr>
        </template>
      </tbody>
    </table>
  </div>
</div>
