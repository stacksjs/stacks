<script client>
import type { DashboardJob, JobListResponse } from '../../../../functions/jobs'
import { dashboardApi } from '../../../../functions/dashboard-api'
import { useServerList } from '../../../../functions/dashboard-list'
import { retryJob } from '../../../../functions/jobs'
import { pushToast } from '../../../../functions/toasts'

const queues = state<string[]>([])
const selectedQueue = state('all')
const selectedStatus = state('all')

// The server searches, filters and pages across the waiting and failed jobs
// (stacksjs/stacks#3201); useServerList keeps the request order, paging and
// search debounce this page used to keep itself. Only the newest answer
// lands, so a slow page can no longer overwrite the one asked for after it.
// The history is newest first and has no order to choose, so no sort is sent.
const {
  records: jobs,
  total,
  page: currentPage,
  perPage,
  search: searchQuery,
  loading: isLoading,
  loadError,
  load,
  changePage,
} = useServerList<DashboardJob>({
  fetch: async (query) => {
    const data = await dashboardApi<JobListResponse>(`/api/dashboard/jobs?${query}`)
    return { ...data, records: data.data }
  },
  filters: () => ({ queue: selectedQueue(), status: selectedStatus() }),
  searchParam: 'search',
  onLoad: (result) => {
    const data = result as unknown as JobListResponse
    queues.set(Array.isArray(data.queues) ? data.queues : [])
  },
  onError: error => pushToast('error', 'Could not load job history', { detail: error instanceof Error ? error.message : String(error) }),
})

function totalPages(): number {
  return Math.max(1, Math.ceil(total() / perPage()))
}

function rangeStart(): number {
  return total() === 0 ? 0 : (currentPage() - 1) * perPage() + 1
}

function rangeEnd(): number {
  return Math.min(currentPage() * perPage(), total())
}

function previousPage(): void {
  if (currentPage() > 1)
    changePage(currentPage() - 1)
}

function nextPage(): void {
  if (currentPage() < totalPages())
    changePage(currentPage() + 1)
}

async function handleRetry(id: string | CustomEvent<string>): Promise<void> {
  const jobId = typeof id === 'string' ? id : id.detail
  try {
    const result = await retryJob(jobId)
    if (!result.success)
      throw new Error(result.message)
    pushToast('success', result.message)
    await load()
  }
  catch (error) {
    pushToast('error', 'Could not retry job', { detail: String(error) })
  }
}

onMount(() => {
  void load()
})
</script>

<div class="flex flex-col gap-6">
  <header>
    <h1 class="font-bold text-2xl text-gray-900 dark:text-white">Job History</h1>
    <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Search active and failed jobs recorded by the configured queue.</p>
  </header>

  <div class="grid gap-3 grid-cols-1 md:grid-cols-[minmax(0,1fr)_12rem_12rem]">
    <div>
      <label for="job-search" class="sr-only">Search jobs</label>
      <input id="job-search" x-model="searchQuery" type="search" placeholder="Search job names" class="block px-3 py-2 w-full text-gray-900 text-sm dark:text-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700" />
    </div>
    <select x-model="selectedQueue" aria-label="Queue" class="block px-3 py-2 text-gray-900 text-sm dark:text-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700">
      <option value="all">All queues</option>
      <template :for="queue in queues()">
        <option :value="queue">{{ queue }}</option>
      </template>
    </select>
    <select x-model="selectedStatus" aria-label="Status" class="block px-3 py-2 text-gray-900 text-sm dark:text-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700">
      <option value="all">All statuses</option>
      <option value="queued">Queued</option>
      <option value="processing">Processing</option>
      <option value="failed">Failed</option>
    </select>
  </div>

  <div :if="loadError()" class="p-4 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">{{ loadError() }}</div>

  <JobTable :jobs="jobs" :loading="isLoading" emptyTitle="No jobs match these filters" @retry="handleRetry" />

  <div class="flex items-center justify-between">
    <p class="text-gray-500 text-sm dark:text-neutral-400">Showing {{ rangeStart() }} to {{ rangeEnd() }} of {{ total() }}</p>
    <div class="flex gap-2">
      <Button variant="secondary" :disabled="currentPage() <= 1" @click="previousPage">Previous</Button>
      <Button variant="secondary" :disabled="currentPage() >= totalPages()" @click="nextPage">Next</Button>
    </div>
  </div>
</div>
