<script client>
interface FileItem {
  id: string | number
  name: string
  type: string
  size?: number
  mime_type?: string
  url?: string
  thumbnail?: string
  /** A generated preview image (stacksjs/stacks#308): a scaled photo, a waveform, a font specimen. */
  preview?: string
  /** The first lines of a text file, shown as text rather than an image. */
  previewText?: string
}

const EMPTY_ITEM: FileItem = {
  id: '',
  name: '',
  type: 'other',
}
const item = useReactiveProp<FileItem | null>('item', null)
const currentItem = derived(() => item() ?? EMPTY_ITEM)

const IMAGE_EXT = ['jpg', 'jpeg', 'png', 'gif', 'webp', 'avif', 'svg', 'bmp', 'heic']
const VIDEO_EXT = ['mp4', 'mov', 'webm', 'mkv', 'avi', 'm4v']
const AUDIO_EXT = ['mp3', 'wav', 'ogg', 'flac', 'm4a', 'aac']
const ARCHIVE_EXT = ['zip', 'rar', 'gz', 'tar', '7z']
const DOC_EXT = ['pdf', 'doc', 'docx', 'xls', 'xlsx', 'ppt', 'pptx', 'txt', 'md', 'csv', 'key', 'pages']

function kindOf(value: FileItem): string {
  if (value.type === 'folder')
    return 'folder'
  const mime = (value.mime_type || '').toLowerCase()
  if (mime.startsWith('image/'))
    return 'image'
  if (mime.startsWith('video/'))
    return 'video'
  if (mime.startsWith('audio/'))
    return 'audio'
  const extension = (value.type || '').toLowerCase()
  if (IMAGE_EXT.includes(extension))
    return 'image'
  if (VIDEO_EXT.includes(extension))
    return 'video'
  if (AUDIO_EXT.includes(extension))
    return 'audio'
  if (ARCHIVE_EXT.includes(extension))
    return 'archive'
  if (DOC_EXT.includes(extension))
    return 'document'
  return 'other'
}

const kind = derived(() => kindOf(currentItem()))
const extension = derived(() => (currentItem().type || '').toUpperCase())
// The generated preview wins over the original: it is a small PNG for any kind
// that could be drawn, where the original may be a 40 MB photo or not an image
// at all. Only an image falls back to the original, because only an image can
// be shown by pointing an <img> at it.
const previewUrl = derived(() => currentItem().preview || (kind() === 'image' ? currentItem().thumbnail || currentItem().url || '' : ''))
const hasImage = derived(() => Boolean(previewUrl()))
const hasText = derived(() => !hasImage() && Boolean(currentItem().previewText))
const imageClass = derived(() => currentItem().preview && kind() !== 'image' ? 'object-contain h-full w-full' : 'object-cover h-full w-full')

const backdropByKind: Record<string, string> = {
  image: 'bg-gradient-to-br from-sky-50 to-indigo-100 dark:from-neutral-800 dark:to-neutral-900',
  video: 'bg-gradient-to-br from-neutral-800 to-neutral-950',
  audio: 'bg-gradient-to-br from-fuchsia-50 to-purple-100 dark:from-neutral-800 dark:to-neutral-900',
  document: 'bg-gradient-to-br from-stone-50 to-stone-200 dark:from-neutral-800 dark:to-neutral-900',
  archive: 'bg-gradient-to-br from-amber-50 to-amber-100 dark:from-neutral-800 dark:to-neutral-900',
  folder: 'bg-gradient-to-br from-indigo-50 to-indigo-100 dark:from-neutral-800 dark:to-neutral-900',
  other: 'bg-gradient-to-br from-stone-50 to-stone-200 dark:from-neutral-800 dark:to-neutral-900',
}
const glyphByKind: Record<string, string> = {
  image: 'i-hugeicons-image-01 text-indigo-400/80 dark:text-indigo-300/70',
  audio: 'i-hugeicons-music-note-01 text-purple-400/80 dark:text-purple-300/70',
  document: 'i-hugeicons-file-01 text-stone-400 dark:text-neutral-400',
  archive: 'i-hugeicons-folder-file-storage text-amber-500/80 dark:text-amber-300/70',
  folder: 'i-hugeicons-folder-02 text-indigo-400 dark:text-indigo-300',
  other: 'i-hugeicons-file-02 text-stone-400 dark:text-neutral-400',
}

const previewClass = derived(() => `relative flex items-center justify-center h-32 w-full overflow-hidden ${backdropByKind[kind()] || backdropByKind.other}`)
const glyphClass = derived(() => `h-10 w-10 ${glyphByKind[kind()] || glyphByKind.other}`)
const badgeClass = derived(() => kind() === 'video'
  ? 'absolute left-2 top-2 px-1.5 py-0.5 font-semibold text-[10px] tracking-wide text-white bg-black/55 rounded'
  : 'absolute left-2 top-2 px-1.5 py-0.5 font-semibold text-[10px] text-stone-600 dark:text-neutral-200 tracking-wide bg-white/85 dark:bg-black/40 rounded')
</script>

<div class="flex flex-col">
  <div :class="previewClass()">
    <img :if="hasImage()" :src="previewUrl()" :alt="currentItem().name" loading="lazy" :class="imageClass()" />
    <pre :else-if="hasText()" class="absolute inset-0 overflow-hidden m-0 pb-2 pt-7 px-3 font-mono leading-[1.35] text-[9px] text-left text-stone-600 whitespace-pre dark:text-neutral-300 bg-white/80 dark:bg-neutral-900/60">{{ currentItem().previewText }}</pre>
    <div :else-if="kind() === 'video'" class="flex items-center justify-center h-12 w-12 bg-white/90 rounded-full shadow-md"><span class="ml-0.5 h-5 w-5 text-neutral-900 i-hugeicons-play"></span></div>
    <span :else :class="glyphClass()"></span>
    <span :if="currentItem().type !== 'folder' && extension()" :class="badgeClass()">{{ extension() }}</span>
  </div>
  <div class="px-3 py-2.5">
    <p :title="currentItem().name" class="font-medium text-[13px] text-stone-800 truncate dark:text-white">{{ currentItem().name }}</p>
    <p class="mt-0.5 capitalize text-[11px] text-stone-400 dark:text-neutral-500">{{ currentItem().type === 'folder' ? 'Folder' : kind() }}</p>
  </div>
</div>
