<script server>
interface AppButtonProps {
  buttonText?: string
  loadingText?: string
  passedClass?: string
  loading?: boolean
}

const { buttonText = '', loadingText = '', passedClass = '', loading = false } = defineProps<AppButtonProps>()

const buttonString = loading ? loadingText : buttonText
const disabledClass = ' disabled:opacity-50 disabled:cursor-not-allowed'
const finalClass = passedClass + disabledClass
</script>
<button
  type="button"
  class="flex items-center {{ finalClass }}"
  @if(loading) disabled @endif
>
  @if(loading)
    <span aria-hidden="true" class="-ml-1 mr-3 h-5 w-5 text-white animate-spin i-hugeicons-loading-03"></span>
  @else
    <slot name="icon" />
  @endif

  <span>
    {{ buttonString }}
  </span>
</button>
