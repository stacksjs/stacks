<script client>
// A record's own page (`/models/{slug}/{id}`), where the eye on any table row
// leads. A breadcrumb back to the list, "View User", and the record's fields
// as titled cards two across: what it is, its settings, its identifiers and
// its timestamps, each field a label over its value. Edit (which opens the
// record's edit page) and Delete appear where the model's API allows them. A page rather than a dialog, so a record
// has an address to share, open in a tab and come back to.
import { useNavigation } from '@stacksjs/defaults/views/dashboard/composables/useNavigation'
import type { ModelRecord } from '../../../../functions/dashboard-model-record'
import { deleteModelRecord, fetchModelRecord, modelDeleteNotice, modelDeleteWarning, modelRecordBackHref, modelRecordEditHref, modelRecordListLabel, modelRecordSections, modelRecordTitle } from '../../../../functions/dashboard-model-record'
import { pushToast } from '../../../../functions/toasts'

const navigation = useNavigation()
const record = state<ModelRecord | null>(null)
const loading = state(true)
const loadError = state('')
const confirmingDelete = state(false)
const working = state(false)

// `/models/{slug}/{id}`: the last two segments of the address.
function slug(): string {
  return navigation.urlSegment(-2)
}

function recordId(): string {
  return navigation.urlSegment(-1)
}

const from = navigation.urlQuery('from')
const backHref = derived(() => modelRecordBackHref(slug(), from))
/** The list in the breadcrumb: "Users" for /data/users, else the model's table. */
const listLabel = derived(() => modelRecordListLabel(record(), backHref()))

const modelName = derived(() => record()?.modelName || 'Record')
const title = derived(() => record() ? modelRecordTitle(record()!) : '')
const sections = derived(() => record() ? modelRecordSections(record()!) : [])
const canEdit = derived(() => Boolean(record()?.writeCapabilities.update))
const canDelete = derived(() => Boolean(record()?.writeCapabilities.destroy))

async function loadRecord(): Promise<void> {
  loading.set(true)
  loadError.set('')
  try {
    record.set(await fetchModelRecord(slug(), recordId()))
  }
  catch (error) {
    record.set(null)
    loadError.set(error instanceof Error ? error.message : 'This record could not be loaded.')
  }
  finally {
    loading.set(false)
  }
}

// The edit page comes back here after saving or cancelling.
function editRecord(): void {
  navigate(modelRecordEditHref(slug(), recordId(), { from: backHref() === from ? from : undefined, via: 'view' }))
}

async function deleteRecord(): Promise<void> {
  const current = record()
  if (!current)
    return
  working.set(true)
  try {
    const outcome = await deleteModelRecord(slug(), recordId())
    const notice = modelDeleteNotice(`${current.modelName} ${recordId()}`, outcome)
    pushToast('success', notice.title, { detail: notice.detail })
    confirmingDelete.set(false)
    navigate(backHref())
  }
  catch (error) {
    pushToast('error', 'Could not delete', { detail: error instanceof Error ? error.message : String(error) })
  }
  finally {
    working.set(false)
  }
}

onMount(() => {
  void loadRecord()
})
</script>

<div class="flex flex-col gap-6">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div class="min-w-0">
      <nav aria-label="Breadcrumb" class="flex gap-2 items-center mb-2 text-neutral-500 text-sm dark:text-neutral-400">
        <StxLink :to="backHref()" class="font-medium hover:text-blue-600 dark:hover:text-blue-400">{{ listLabel() }}</StxLink>
        <span aria-hidden="true" class="h-4 w-4 i-hugeicons-arrow-right-01"></span>
        <span aria-current="page">View</span>
      </nav>
      <h1 class="font-bold text-3xl text-neutral-900 tracking-tight truncate dark:text-white">View {{ modelName() }}</h1>
    </div>
    <div :if="record()" class="flex flex-none gap-2 items-center">
      <Button :if="canDelete()" variant="outline" @click="confirmingDelete.set(true)">
        <span aria-hidden="true" class="h-4 w-4 text-red-500 i-hugeicons-delete-02"></span>
        Delete
      </Button>
      <Button :if="canEdit()" variant="primary" @click="editRecord">Edit</Button>
    </div>
  </header>

  <div :if="loading()" class="flex items-center justify-center py-20 text-neutral-500 text-sm dark:text-neutral-400">
    <span aria-hidden="true" class="mr-2 h-5 w-5 animate-spin i-hugeicons-loading-03"></span>
    Loading record
  </div>

  <div :if="!loading() && loadError()" role="alert" class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between px-4 py-3 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/40 border border-red-200 rounded-lg dark:border-red-900">
    <span>{{ loadError() }}</span>
    <Button variant="secondary" size="sm" @click="loadRecord">Try again</Button>
  </div>

  <div :if="!loading() && record()?.anonymized" role="note" class="flex gap-3 items-start px-4 py-3 text-neutral-700 text-sm dark:text-neutral-200 bg-neutral-100 dark:bg-white/5 border border-neutral-200 rounded-lg dark:border-neutral-700">
    <span aria-hidden="true" class="flex-none mt-0.5 h-4 w-4 text-neutral-500 i-hugeicons-user-remove-01"></span>
    <span>This account was anonymized. Its name and email were removed and it can no longer sign in. Records that refer to it were kept.</span>
  </div>

  <div :if="!loading() && record()" class="grid gap-6 grid-cols-1 items-start lg:grid-cols-2">
    <div :for="section in sections()" class="min-w-0">
      <Card padding="none">
        <h2 class="px-6 py-4 font-semibold text-base text-neutral-900 dark:text-white border-b border-neutral-200 dark:border-neutral-700">{{ section.title }}</h2>
        <dl :class="section.columns === 2 ? 'grid gap-x-8 gap-y-6 grid-cols-1 sm:grid-cols-2 p-6' : 'flex flex-col gap-6 p-6'">
          <div :for="detail in section.details" :class="detail.wide ? 'min-w-0 sm:col-span-2' : 'min-w-0'">
            <dt class="font-medium text-neutral-900 text-sm dark:text-white">{{ detail.label }}</dt>
            <dd class="mt-1.5 text-sm">
              <span :if="detail.kind === 'boolean'" class="inline-flex gap-1.5 items-center text-neutral-700 dark:text-neutral-200">
                <span aria-hidden="true" :class="detail.yes ? 'h-5 w-5 text-green-600 dark:text-green-400 i-hugeicons-checkmark-circle-02' : 'h-5 w-5 text-neutral-400 dark:text-neutral-500 i-hugeicons-cancel-circle'"></span>
                {{ detail.value }}
              </span>
              <span :if="detail.kind === 'badge'" class="inline-flex px-2 py-0.5 font-medium text-neutral-800 text-xs dark:text-neutral-100 border border-neutral-400 rounded-md dark:border-neutral-500">{{ detail.value }}</span>
              <pre :if="detail.kind === 'json'" class="overflow-x-auto p-3 font-mono text-neutral-800 text-xs dark:text-neutral-200 bg-neutral-50 dark:bg-neutral-900 rounded-lg">{{ detail.value }}</pre>
              <span :if="detail.kind === 'text'" :class="detail.empty ? 'text-neutral-400 dark:text-neutral-500' : 'break-words text-neutral-700 dark:text-neutral-200'">{{ detail.value }}</span>
            </dd>
          </div>
        </dl>
      </Card>
    </div>
  </div>

  <ConfirmDialog
    :isOpen="confirmingDelete()"
    :title="'Delete this ' + modelName().toLowerCase() + '?'"
    :description="modelDeleteWarning(title() || modelName(), Boolean(record()?.writeCapabilities.anonymize))"
    :busy="working()"
    :confirmLabel="working() ? 'Deleting' : 'Delete'"
    @close="confirmingDelete.set(false)"
    @confirm="deleteRecord"
  />
</div>
