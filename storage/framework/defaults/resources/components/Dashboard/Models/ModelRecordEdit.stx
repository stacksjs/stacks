<script client>
// A record's edit page (`/models/{slug}/{id}/edit`), where the pencil on any
// table row and the Edit button on the record's page lead. The fields the
// model's API lets the dashboard change are inputs; the rest are shown beside
// them, read only, as context. Saving sends only what changed, then returns
// to where the visitor came from: the record's page, or the list.
import { useNavigation } from '@stacksjs/defaults/views/dashboard/composables/useNavigation'
import type { ModelFormValues, ModelRecord } from '../../../../functions/dashboard-model-record'
import { fetchModelRecord, modelNameFromSlug, modelFormFieldsFor, modelFormPayload, modelFormValues, modelRecordBackHref, modelRecordHref, modelRecordListLabel, modelRecordSections, updateModelRecord } from '../../../../functions/dashboard-model-record'
import { dashboardLoaderTimer } from '../../../../functions/dashboard-loading'
import { pushToast } from '../../../../functions/toasts'

const navigation = useNavigation()
const record = state<ModelRecord | null>(null)
const values = state<ModelFormValues>({})
/** What the form started with, so a save sends only what was changed. */
const initial = state<ModelFormValues>({})
const loading = state(true)
// Set once the request has taken long enough to say so (dashboard-loading.ts).
const slow = state(false)
const loadError = state('')
const saving = state(false)
const saveError = state('')
const saveErrors = state<Record<string, string[]>>({})

// `/models/{slug}/{id}/edit`
function slug(): string {
  return navigation.urlSegment(-3)
}

function recordId(): string {
  return navigation.urlSegment(-2)
}

const from = navigation.urlQuery('from')
const cameFromView = navigation.urlQuery('via') === 'view'
const listHref = derived(() => modelRecordBackHref(slug(), from))
const viewHref = derived(() => modelRecordHref(slug(), recordId(), listHref() === from ? from : undefined))
/** After saving or cancelling: the page the visitor came from. */
const returnHref = derived(() => cameFromView ? viewHref() : listHref())
const listLabel = derived(() => modelRecordListLabel(record(), listHref()))
// Known from the address before the record comes, so the heading does not change.
const modelName = derived(() => record()?.modelName || modelNameFromSlug(slug()))

// As the record is stored: a switch that cannot be turned from where it is stays shown, not offered.
const writable = derived(() => modelFormFieldsFor(record()?.fields ?? [], initial()))
/** What cannot be changed here, formatted as the record's page shows it. */
const context = derived(() => {
  const current = record()
  if (!current)
    return []
  return modelRecordSections(current)
    .flatMap(section => section.details)
    .filter(detail => !current.updateColumns.includes(detail.name))
})
const anonymized = derived(() => Boolean(record()?.anonymized))
const canEdit = derived(() => Boolean(record()?.writeCapabilities.update) && writable().length > 0 && !anonymized())

function setValue(change: { name: string, value: string | boolean }): void {
  values.set({ ...values(), [change.name]: change.value })
}

async function loadRecord(): Promise<void> {
  loading.set(true)
  loadError.set('')
  const settle = dashboardLoaderTimer(slow)
  try {
    const loaded = await fetchModelRecord(slug(), recordId())
    record.set(loaded)
    const start = modelFormValues(loaded.fields, loaded.row)
    initial.set(start)
    values.set({ ...start })
  }
  catch (error) {
    record.set(null)
    loadError.set(error instanceof Error ? error.message : 'This record could not be loaded.')
  }
  finally {
    settle()
    loading.set(false)
  }
}

async function save(): Promise<void> {
  const current = record()
  if (!current || saving())
    return
  const fields = modelFormPayload(current.fields, values(), initial())
  if (Object.keys(fields).length === 0) {
    navigate(returnHref())
    return
  }
  saving.set(true)
  saveError.set('')
  saveErrors.set({})
  const result = await updateModelRecord(slug(), recordId(), fields)
  saving.set(false)
  if (!result.ok) {
    // A refusal says which field and why; "Validation failed" alone left the
    // visitor to guess which of the inputs it meant.
    saveError.set(result.error)
    saveErrors.set(result.errors)
    return
  }
  pushToast('success', `${current.modelName} ${recordId()} updated`)
  navigate(returnHref())
}

function cancel(): void {
  if (!saving())
    navigate(returnHref())
}

onMount(() => {
  void loadRecord()
})
</script>

<div class="flex flex-col gap-6">
  <header class="min-w-0">
    <nav aria-label="Breadcrumb" class="flex gap-2 items-center mb-2 text-neutral-500 text-sm dark:text-neutral-400">
      <StxLink :to="listHref()" class="font-medium hover:text-blue-600 dark:hover:text-blue-400">{{ listLabel() }}</StxLink>
      <span aria-hidden="true" class="h-4 w-4 i-hugeicons-arrow-right-01"></span>
      <StxLink :to="viewHref()" class="font-medium hover:text-blue-600 dark:hover:text-blue-400">View</StxLink>
      <span aria-hidden="true" class="h-4 w-4 i-hugeicons-arrow-right-01"></span>
      <span aria-current="page">Edit</span>
    </nav>
    <h1 class="font-bold text-3xl text-neutral-900 tracking-tight truncate dark:text-white">Edit {{ modelName() }}</h1>
  </header>

  <QuietLoader :if="loading()" :slow="slow()" label="Loading record" />

  <div :if="!loading() && loadError()" role="alert" class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between px-4 py-3 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/40 border border-red-200 rounded-lg dark:border-red-900">
    <span>{{ loadError() }}</span>
    <Button variant="secondary" size="sm" @click="loadRecord">Try again</Button>
  </div>

  <EmptyState
    :if="!loading() && record() && !canEdit() && !anonymized()"
    icon="i-hugeicons-square-lock-02"
    :title="modelName() + ' records cannot be edited here'"
    description="This model does not allow changes through the dashboard. You can still view the record."
  />

  <EmptyState
    :if="!loading() && anonymized()"
    icon="i-hugeicons-user-remove-01"
    title="This account was anonymized"
    description="Its name and email were removed and it can no longer sign in, so there is nothing to edit. Records that refer to it were kept."
  />

  <form :if="!loading() && canEdit()" id="model-edit-form" class="flex flex-col gap-6" @submit.prevent="save">
    <div :if="saveError()" role="alert" class="px-4 py-3 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/40 border border-red-200 rounded-lg dark:border-red-900">
      {{ saveError() }}
    </div>

    <div class="grid gap-6 grid-cols-1 items-start lg:grid-cols-2">
      <Card padding="none">
        <h2 class="px-6 py-4 font-semibold text-base text-neutral-900 dark:text-white border-b border-neutral-200 dark:border-neutral-700">{{ modelName() }} Details</h2>
        <div class="p-6">
          <ModelFieldInputs :fields="writable()" :slug="slug()" :values="values()" :errors="saveErrors()" :disabled="saving()" @change="setValue" />
        </div>
      </Card>

      <Card :if="context().length > 0" padding="none">
        <div class="px-6 py-4 border-b border-neutral-200 dark:border-neutral-700">
          <h2 class="font-semibold text-base text-neutral-900 dark:text-white">Read only</h2>
          <p class="mt-1 text-neutral-500 text-xs dark:text-neutral-400">Set by the application. These cannot be changed from here.</p>
        </div>
        <dl class="grid gap-x-8 gap-y-6 grid-cols-1 sm:grid-cols-2 p-6">
          <div :for="detail in context()" :class="detail.wide ? 'min-w-0 sm:col-span-2' : 'min-w-0'">
            <dt class="font-medium text-neutral-900 text-sm dark:text-white">{{ detail.label }}</dt>
            <dd :class="detail.empty ? 'mt-1.5 text-sm text-neutral-400 dark:text-neutral-500' : 'mt-1.5 text-sm break-words text-neutral-700 dark:text-neutral-200'">{{ detail.value }}</dd>
          </div>
        </dl>
      </Card>
    </div>

    <div class="flex gap-3 items-center">
      <Button type="submit" variant="primary" :loading="saving()">Save changes</Button>
      <Button variant="secondary" :disabled="saving()" @click="cancel">Cancel</Button>
    </div>
  </form>
</div>
