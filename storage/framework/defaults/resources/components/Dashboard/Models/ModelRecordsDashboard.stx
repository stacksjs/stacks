<script client>
// The page every model gets for free (stacksjs/stacks#1838): a browsable,
// sortable, filterable table over any model the app defines, with no
// per-model code.
//
// All querying is server-side (`GET /api/dashboard/models/{slug}`), so this
// works the same on a table with 10 rows and one with a million. Rows and
// writes go through the model, so scopes, casts and observers apply.
import { useNavigation } from '@stacksjs/defaults/views/dashboard/composables/useNavigation'
import { dashboardApi } from '@stacksjs/defaults/functions/dashboard-api'
import type { ModelCustomAction, ModelRelationTarget, ModelWriteCapabilities } from '@stacksjs/defaults/functions/dashboard-model-record'
import { deleteModelRecord, modelActionAsks, modelActionIconClass, modelActionNotice, modelActionsFor, modelDeleteNotice, modelDeleteWarning, modelListColumnNames, modelListFilters, modelRecordCreateHref, modelRecordEditHref, modelRecordHref, modelRelationCell, NO_WRITES, runModelAction, userInviteHref } from '@stacksjs/defaults/functions/dashboard-model-record'
import type { ModelBulkResult } from '@stacksjs/defaults/functions/dashboard-model-bulk'
import { deleteModelRecords, modelBulkActionConfirm, modelBulkActionScope, modelBulkActions, modelBulkDeleteConfirm, modelBulkDeleteTargets, modelBulkNotice, modelBulkTargets, runModelActionOnEach } from '@stacksjs/defaults/functions/dashboard-model-bulk'
import type { ModelFieldDisplay, ModelFormattedValue } from '@stacksjs/defaults/functions/dashboard-model-format'
import { modelColumnIsNumeric, modelFormattedValue } from '@stacksjs/defaults/functions/dashboard-model-format'
import { pushToast } from '@stacksjs/defaults/functions/toasts'

interface ColumnMeta {
  name: string
  label: string
  type: 'number' | 'boolean' | 'date' | 'json' | 'text'
  /** How the model says the value reads (`dashboard.fields`): money, a size, a link. */
  format?: ModelFieldDisplay
}

interface ResponseShape {
  modelName: string
  modelLabel?: string
  tableName: string
  rows: Array<Record<string, unknown>>
  displayColumns: string[]
  columnMeta: ColumnMeta[]
  totalCount: number
  page: number
  perPage: number
  lastPage: number
  sort: string
  dir: 'asc' | 'desc'
  writable: boolean
  writeCapabilities: ModelWriteCapabilities
  /** Rows erased under the app's data-subject rules (users only). */
  anonymizedIds?: Array<number | string>
  /** The columns the list draws: the model's own choice, or all of them. */
  listColumns?: string[]
  relations?: Record<string, ModelRelationTarget>
  relationNames?: Record<string, Record<string, string>>
  /** The model's own actions (`dashboard.actions`), and which each row is offered. */
  actions?: ModelCustomAction[]
  rowActions?: Record<string, string[]>
  updateColumns: string[]
  migrated?: boolean
  error: string | null
}

const PER_PAGE_OPTIONS = [25, 50, 100, 200]
const navigation = useNavigation()

const modelName = state('')
// The class name, for the one message that tells a developer what was looked for.
const modelClass = state('')
const tableName = state('')
const rows = state<Array<Record<string, unknown>>>([])
const anonymizedIds = state<string[]>([])
// Columns that hold another model's id, and what those records are called.
const relations = state<Record<string, ModelRelationTarget>>({})
const relationNames = state<Record<string, Record<string, string>>>({})
const columnMeta = state<ColumnMeta[]>([])
const totalCount = state(0)
const page = state(1)
const perPage = state(25)
const lastPage = state(1)
const sort = state('')
const dir = state<'asc' | 'desc'>('desc')
const search = state(navigation.urlQuery('q') || '')
// A list opened from a record's panel arrives narrowed to that record.
const filters = state<Record<string, string>>(modelListFilters(navigation.urlQuery('filters')))
const writeCapabilities = state<ModelWriteCapabilities>(NO_WRITES)
const error = state<string | null>(null)
// False when the model's table has not been created yet: the server checked the
// catalog after the query failed, so this is never a guess from an error.
const migrated = state(true)
const loading = state(true)
// Open when it arrives filtered, so what narrowed the list can be seen and cleared.
const showFilters = state(Object.keys(filters()).length > 0)

const saving = state(false)
const confirmingDelete = state<Record<string, unknown> | null>(null)
// The model's own actions, and the rows the server says each is for.
const actions = state<ModelCustomAction[]>([])
const rowActions = state<Record<string, string[]>>({})
// One of them waiting on its confirmation, and the one that is running.
const confirmingAction = state<{ action: ModelCustomAction, row: Record<string, unknown> } | null>(null)
const runningAction = state<{ name: string, id: string } | null>(null)

// The rows ticked on this page, by id. A selection is what is on screen: it
// is dropped whenever the rows are read again.
const selected = state<string[]>([])
// What the selection is about to have done to it, waiting on its confirmation.
const confirmingBulk = state<{ kind: 'action', action: ModelCustomAction } | { kind: 'delete' } | null>(null)
// How far a run over the selection has got. Null when none is running.
const bulkProgress = state<{ done: number, total: number } | null>(null)
// An action that takes input, with its form open: for one row, or (no row)
// for the selection. And what its last try was refused for.
const askingAction = state<{ action: ModelCustomAction, row: Record<string, unknown> | null } | null>(null)
const actionError = state('')
const actionErrors = state<Record<string, string[]>>({})

/** The model's own actions that may be run on a selection: `on: ['bulk']`. */
const bulkActions = derived(() => modelBulkActions(actions()))
// A tick box is only drawn when there is something to do with a tick.
const selectable = derived(() => migrated() && (bulkActions().length > 0 || writeCapabilities().destroy))
const allSelected = derived(() => rows().length > 0 && rows().every(row => selected().includes(String(row.id))))
const selectionLabel = derived(() => `${selected().length} selected`)
const bulkBusy = derived(() => bulkProgress() !== null)
const bulkProgressLabel = derived(() => {
  const progress = bulkProgress()
  return progress ? `Working: ${Math.min(progress.done + 1, progress.total)} of ${progress.total}` : ''
})

const slug = derived(() => navigation.urlSegment(-1) || '')

const recordLabel = derived(() => {
  const n = totalCount()
  return `${n.toLocaleString()} ${n === 1 ? 'record' : 'records'}`
})

const rangeLabel = derived(() => {
  if (totalCount() === 0) return 'No records'
  const from = (page() - 1) * perPage() + 1
  const to = Math.min(page() * perPage(), totalCount())
  return `${from.toLocaleString()} to ${to.toLocaleString()} of ${totalCount().toLocaleString()}`
})

const activeFilterCount = derived(() => Object.values(filters()).filter(v => v !== '').length)

const filterLabel = derived(() => {
  const n = activeFilterCount()
  return n === 0 ? 'Filter' : `Filter (${n})`
})

const isEmpty = derived(() => !loading() && !error() && migrated() && rows().length === 0)

const subtitle = derived(() => migrated()
  ? `${recordLabel()} in the ${tableName()} table`
  : `The ${tableName()} table has not been created yet`)

const deleteDescription = derived(() => {
  const row = confirmingDelete()
  if (!row)
    return ''
  return modelDeleteWarning(`Row ${row.id}`, writeCapabilities().anonymize)
})

// Skeleton rows while a query is in flight. Matching the real row count
// keeps the table from collapsing and jumping back on every keystroke.
const skeletonRows = derived(() => Array.from({ length: Math.min(8, Math.max(3, rows().length || 6)) }, (_, i) => i))

function formatDate(value: unknown): string {
  const date = new Date(value as string | number)
  if (Number.isNaN(date.getTime())) return String(value)
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })
}

function formatCell(value: unknown, type: ColumnMeta['type']): string {
  if (value === null || value === undefined || value === '') return '-'
  if (type === 'date') return formatDate(value)
  if (type === 'boolean') return (value === true || value === 1 || value === '1') ? 'Yes' : 'No'
  if (type === 'number' && typeof value === 'number') return value.toLocaleString()
  if (typeof value === 'object') {
    try { return JSON.stringify(value).slice(0, 90) }
    catch { return '[object]' }
  }
  const text = String(value)
  return text.length > 120 ? `${text.slice(0, 120)}…` : text
}

/** A cell that points at another model's record: its name, and where it leads. */
function relationCell(row: Record<string, unknown>, column: ColumnMeta) {
  return modelRelationCell(column.name, row[column.name], relations(), relationNames())
}

function relationHref(row: Record<string, unknown>, column: ColumnMeta): string {
  return relationCell(row, column)?.href ?? ''
}

/**
 * A cell as the model says it reads: "$12.00", "1.5 KB", a link, a picture.
 * Null when the model does not say, or nothing is stored.
 */
function formatted(row: Record<string, unknown>, column: ColumnMeta): ModelFormattedValue | null {
  return column.format ? modelFormattedValue(row[column.name], column.format, row) : null
}

/** How a cell is drawn: a link to a record, or what its format calls for, or words. */
function cellKind(row: Record<string, unknown>, column: ColumnMeta): 'relation' | ModelFormattedValue['kind'] {
  if (relationHref(row, column))
    return 'relation'
  return formatted(row, column)?.kind ?? 'text'
}

function cellHref(row: Record<string, unknown>, column: ColumnMeta): string {
  return formatted(row, column)?.href ?? ''
}

function cellValue(row: Record<string, unknown>, column: ColumnMeta): string {
  if (column.format && !relationCell(row, column))
    return formatted(row, column)?.text ?? '-'
  return relationCell(row, column)?.text ?? formatCell(row[column.name], column.type)
}

// Returned as COMPLETE class strings and applied with `:class`, because a
// `{{ }}` placeholder inside a class attribute is not reactively bound.
function cellClass(column: ColumnMeta): string {
  const align = modelColumnIsNumeric(column) ? 'text-right tabular-nums' : 'text-left'
  const mono = column.type === 'json' && !column.format ? ' font-mono text-[12px]' : ''
  return `px-3 py-2 max-w-xs truncate whitespace-nowrap text-[13px] text-neutral-800 dark:text-neutral-200 ${align}${mono}`
}

function headerClass(column: ColumnMeta): string {
  const align = modelColumnIsNumeric(column) ? 'justify-end' : 'justify-start'
  return `flex items-center gap-1 w-full ${align} font-medium text-[11px] uppercase tracking-wide text-neutral-500 dark:text-neutral-400 hover:text-neutral-800 dark:hover:text-neutral-200 transition-colors`
}

function sortIconClass(column: ColumnMeta): string {
  if (sort() !== column.name) return 'h-3 w-3 opacity-0 group-hover:opacity-40 i-hugeicons-arrow-up-down'
  return dir() === 'asc' ? 'h-3 w-3 i-hugeicons-arrow-up-01' : 'h-3 w-3 i-hugeicons-arrow-down-01'
}

async function load() {
  if (!slug()) {
    error.set('Missing model slug in the URL.')
    loading.set(false)
    return
  }
  loading.set(true)
  error.set(null)
  // The rows about to arrive may not be the ones that were ticked.
  selected.set([])
  try {
    const params = new URLSearchParams({
      page: String(page()),
      per_page: String(perPage()),
      dir: dir(),
    })
    if (sort()) params.set('sort', sort())
    if (search()) params.set('q', search())
    const active = Object.fromEntries(Object.entries(filters()).filter(([, v]) => v !== ''))
    if (Object.keys(active).length > 0) params.set('filters', JSON.stringify(active))

    const data = await dashboardApi<ResponseShape>(`/api/dashboard/models/${encodeURIComponent(slug())}?${params}`)

    modelName.set(data.modelLabel ?? data.modelName ?? '')
    modelClass.set(data.modelName ?? '')
    tableName.set(data.tableName ?? '')
    rows.set(data.rows ?? [])
    anonymizedIds.set((data.anonymizedIds ?? []).map(String))
    // Only reassign when the column set actually changes. It is the same for
    // every page and every sort of a given model, and re-rendering the
    // header `:for` on each query both wastes work and trips a reconciler
    // bug that leaves the columns rotated out of order.
    relations.set(data.relations ?? {})
    relationNames.set(data.relationNames ?? {})
    actions.set(data.actions ?? [])
    rowActions.set(data.rowActions ?? {})
    // The columns the model chose for its list, and any the list is filtered on.
    const every = data.columnMeta ?? []
    const shown = modelListColumnNames(every.map(column => column.name), data.listColumns, active)
    const nextColumns = shown.map(name => every.find(column => column.name === name)!).filter(Boolean)
    const sameColumns = nextColumns.length === columnMeta().length
      && nextColumns.every((c, i) => c.name === columnMeta()[i]?.name)
    if (!sameColumns) columnMeta.set(nextColumns)
    totalCount.set(data.totalCount ?? 0)
    lastPage.set(data.lastPage ?? 1)
    sort.set(data.sort ?? '')
    writeCapabilities.set({ ...NO_WRITES, ...data.writeCapabilities })
    migrated.set(data.migrated !== false)
    error.set(data.error ?? null)
  }
  catch (e) {
    error.set(e instanceof Error ? e.message : String(e))
  }
  finally {
    loading.set(false)
  }
}

function toggleSort(column: ColumnMeta) {
  if (sort() === column.name) dir.set(dir() === 'asc' ? 'desc' : 'asc')
  else { sort.set(column.name); dir.set('asc') }
  page.set(1)
  void load()
}

// Debounced so a query is not fired per keystroke. Search and the per-column
// filters deliberately share one debounce, the way they shared one timer id
// before: typing in either should schedule a single reload, not two.
const onSearchInput = useDebounce(() => {
  page.set(1)
  void load()
}, 250)

function onFilterInput(column: string, event: Event) {
  filters.set({ ...filters(), [column]: (event.target as HTMLInputElement).value })
  onSearchInput()
}

function clearFilters() {
  filters.set({})
  search.set('')
  page.set(1)
  void load()
}

function goToPage(next: number) {
  const target = Math.min(Math.max(1, next), lastPage())
  if (target === page()) return
  page.set(target)
  void load()
}

function onPerPageChange() {
  page.set(1)
  void load()
}

// An anonymized account keeps its eye and loses its pencil and trash: there
// is nothing left to edit, and deleting it again changes nothing.
function isAnonymized(row: Record<string, unknown>): boolean {
  return anonymizedIds().includes(String(row.id))
}

// The eye and the pencil each open a page of the record's own.
function startEdit(row: Record<string, unknown>) {
  navigate(modelRecordEditHref(slug(), String(row.id)))
}

function startView(row: Record<string, unknown>) {
  navigate(modelRecordHref(slug(), String(row.id)))
}

// Creating has a page of its own too.
function openCreate(): void {
  navigate(modelRecordCreateHref(slug()))
}

// A user is invited, not typed in: the account's holder chooses the password.
function openInvite(): void {
  navigate(userInviteHref(`/models/${slug()}`))
}

/** The model's own actions this row is offered in a list. */
function actionsFor(row: Record<string, unknown>): ModelCustomAction[] {
  return modelActionsFor(actions(), rowActions(), String(row.id), 'row')
}

/** The name of the action running on this row, if one is. */
function runningOn(row: Record<string, unknown>): string {
  const current = runningAction()
  return current && current.id === String(row.id) ? current.name : ''
}

function openActionForm(action: ModelCustomAction, row: Record<string, unknown> | null): void {
  actionError.set('')
  actionErrors.set({})
  askingAction.set({ action, row })
}

// An action that takes input opens its form, one that asks first its
// confirmation, and any other runs.
function startAction(payload: { action: ModelCustomAction, record: Record<string, unknown> }): void {
  if (modelActionAsks(payload.action))
    openActionForm(payload.action, payload.record)
  else if (payload.action.confirm)
    confirmingAction.set({ action: payload.action, row: payload.record })
  else
    void runAction(payload.action, payload.record)
}

async function runAction(action: ModelCustomAction, row: Record<string, unknown>, input: Record<string, unknown> = {}): Promise<void> {
  if (runningAction())
    return
  runningAction.set({ name: action.name, id: String(row.id) })
  const result = await runModelAction(slug(), String(row.id), action.name, input)
  runningAction.set(null)
  confirmingAction.set(null)
  // A refusal of what was typed is answered where it was typed.
  if (!result.ok && askingAction()) {
    actionError.set(result.error)
    actionErrors.set(result.errors ?? {})
    return
  }
  askingAction.set(null)
  const notice = modelActionNotice(action, result)
  pushToast(notice.tone, notice.title, { detail: notice.detail })
  if (!result.ok)
    return
  if (result.redirect)
    navigate(result.redirect)
  else
    // The row may read differently now, and be offered different actions.
    await load()
}

function confirmAction(): void {
  const pending = confirmingAction()
  if (pending)
    void runAction(pending.action, pending.row)
}

function isSelected(row: Record<string, unknown>): boolean {
  return selected().includes(String(row.id))
}

function toggleSelected(row: Record<string, unknown>): void {
  const id = String(row.id)
  selected.set(isSelected(row) ? selected().filter(candidate => candidate !== id) : [...selected(), id])
}

function toggleAllSelected(): void {
  selected.set(allSelected() ? [] : rows().map(row => String(row.id)))
}

/** The selected rows an action is for: the server has said which rows it applies to. */
function bulkTargets(action: ModelCustomAction): string[] {
  return modelBulkTargets(action, rowActions(), selected())
}

/** The selected rows a delete is for: an anonymized account is left alone. */
function bulkDeleteTargets(): string[] {
  return modelBulkDeleteTargets(selected(), anonymizedIds())
}

// Acting on many records always asks first, whatever a single press does.
const bulkConfirm = derived(() => {
  const pending = confirmingBulk()
  if (!pending)
    return { title: '', description: '', label: 'Run', destructive: false }
  if (pending.kind === 'delete')
    return { ...modelBulkDeleteConfirm(bulkDeleteTargets().length, selected().length, writeCapabilities().anonymize), label: 'Delete', destructive: true }
  return { ...modelBulkActionConfirm(pending.action, bulkTargets(pending.action).length, selected().length), label: pending.action.label, destructive: pending.action.destructive }
})

// Acting on a selection always asks first: in the action's form when it
// takes input, in a confirmation when it does not.
function startBulkAction(action: ModelCustomAction): void {
  if (modelActionAsks(action))
    openActionForm(action, null)
  else
    confirmingBulk.set({ kind: 'action', action })
}

/** What the form is told beside the model's own sentence: how far the action reaches. */
const actionFormNote = derived(() => {
  const asking = askingAction()
  return asking && !asking.row ? modelBulkActionScope(bulkTargets(asking.action).length, selected().length) : ''
})

function submitAction(input: Record<string, unknown>): void {
  const asking = askingAction()
  if (!asking)
    return
  if (asking.row)
    void runAction(asking.action, asking.row, input)
  else
    void runBulk({ kind: 'action', action: asking.action }, input)
}

async function runBulk(pending = confirmingBulk(), input: Record<string, unknown> = {}): Promise<void> {
  if (!pending || bulkBusy())
    return
  const track = (done: number, total: number) => bulkProgress.set({ done, total })
  let result: ModelBulkResult
  if (pending.kind === 'delete')
    result = await deleteModelRecords(slug(), bulkDeleteTargets(), track)
  else
    result = await runModelActionOnEach(slug(), bulkTargets(pending.action), pending.action.name, { input, progress: track })
  bulkProgress.set(null)
  // What was typed was refused by the first record: nothing ran, and the
  // form says which field and why.
  if (Object.keys(result.invalid).length > 0) {
    actionError.set(Object.keys(result.invalid).length === 1 ? 'Check the field marked below.' : `Check the ${Object.keys(result.invalid).length} fields marked below.`)
    actionErrors.set(result.invalid)
    return
  }
  askingAction.set(null)
  confirmingBulk.set(null)
  const notice = modelBulkNotice(pending.kind === 'delete' ? { kind: 'delete' } : { kind: 'action', label: pending.action.label }, modelName(), result)
  pushToast(notice.tone, notice.title, { detail: notice.detail })
  // Deleting every row of the final page would strand the viewer on an empty one.
  if (pending.kind === 'delete' && result.done >= rows().length && page() > 1)
    page.set(page() - 1)
  await load()
}

async function confirmDelete() {
  const row = confirmingDelete()
  if (!row) return
  saving.set(true)
  try {
    const outcome = await deleteModelRecord(slug(), String(row.id))
    const notice = modelDeleteNotice(`${modelName()} ${row.id}`, outcome)
    pushToast('success', notice.title, { detail: notice.detail })
    confirmingDelete.set(null)
    // Deleting the last row of the final page would strand the viewer on an
    // empty page, so step back one.
    if (rows().length === 1 && page() > 1) page.set(page() - 1)
    await load()
  }
  catch (e) {
    pushToast('error', 'Could not delete', { detail: e instanceof Error ? e.message : String(e) })
  }
  finally {
    saving.set(false)
  }
}

void load()
</script>

<template>
<div class="flex flex-col gap-4 p-6">

  <!-- Written out rather than using <PageHeader>: that component renders on
      the server, so a `{{ }}` placeholder in it is baked at render time and
      would stay empty for a title that only exists once the fetch resolves.
      `:text` bindings here stay reactive. -->
  <div class="flex flex-wrap gap-4 items-start justify-between">
    <div class="min-w-0">
      <h1 class="font-bold text-2xl text-neutral-900 truncate dark:text-white" :text="modelName()"></h1>
      <p class="mt-1 text-[13px] text-neutral-500 dark:text-neutral-400" :text="subtitle()"></p>
    </div>
    <div class="flex gap-2 items-center">
      <Button
        :if="writeCapabilities().create && !writeCapabilities().invite"
        @click="openCreate"
      >
        <span aria-hidden="true" class="h-4 w-4 i-hugeicons-add-01"></span>
        Create
      </Button>
      <Button
        :if="writeCapabilities().invite"
        @click="openInvite"
      >
        <span aria-hidden="true" class="h-4 w-4 i-hugeicons-mail-send-01"></span>
        Invite
      </Button>
      <Button
        :if="migrated()"
        variant="secondary"
        size="sm"
        interaction="toggle"
        :pressed="showFilters()"
        @click="showFilters.set(!showFilters())"
      >
        <span class="h-4 w-4 i-hugeicons-filter"></span>
        <span :text="filterLabel()"></span>
      </Button>
    </div>
  </div>

  <!-- Search + page size -->
  <div :if="migrated()" class="flex flex-wrap gap-3 items-center">
    <div class="relative flex-1 max-w-sm">
      <div class="flex absolute inset-y-0 left-0 items-center pl-3 pointer-events-none">
        <div class="h-4 w-4 text-neutral-400 dark:text-neutral-500 i-hugeicons-search-01"></div>
      </div>
      <input
        type="search"
        x-model="search"
        @input="onSearchInput"
        :placeholder="'Search ' + (modelName() || 'records')"
        class="block pl-9 pr-3 py-1.5 w-full text-[13px] text-neutral-900 dark:text-neutral-100 placeholder:text-neutral-400 dark:placeholder:text-neutral-500 bg-white dark:bg-white/10 border border-black/10 rounded-lg dark:border-white/15 focus:border-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-500/20 transition-all"
      >
    </div>

    <div :if="activeFilterCount() > 0 || search()" class="flex items-center">
      <Button variant="ghost" size="sm" @click="clearFilters()">
        Clear
      </Button>
    </div>

    <div class="flex gap-2 items-center ml-auto text-[12px] text-neutral-500 dark:text-neutral-400">
      <span>Show</span>
      <select
        x-model.number="perPage"
        @change="onPerPageChange"
        class="px-2 h-8 text-[12px] text-neutral-700 dark:text-neutral-200 bg-white dark:bg-white/10 border border-black/10 rounded-md dark:border-white/15 focus:border-blue-500/50"
      >
        <option :for="option in PER_PAGE_OPTIONS" :value="option" :selected="option === perPage()">{{ option }}</option>
      </select>
    </div>
  </div>

  <!-- What can be done to the ticked rows. Only there when some are ticked. -->
  <div :if="selected().length > 0" role="region" aria-label="Selected rows" data-bulk-bar class="flex flex-wrap gap-3 items-center justify-between px-3 py-2 bg-blue-50 dark:bg-blue-500/10 border border-blue-200 rounded-lg dark:border-blue-500/30">
    <p class="font-medium text-[13px] text-neutral-800 dark:text-neutral-100" aria-live="polite">
      <span :if="!bulkBusy()" :text="selectionLabel()"></span>
      <span :if="bulkBusy()" :text="bulkProgressLabel()"></span>
    </p>
    <div class="flex flex-wrap gap-2 items-center">
      <span :for="action in bulkActions()" class="contents">
        <Button
          variant="secondary"
          size="sm"
          :disabled="bulkBusy() || bulkTargets(action).length === 0"
          :title="bulkTargets(action).length === 0 ? 'Does not apply to any of the selected rows' : action.label"
          @click="startBulkAction(action)"
        >
          <span aria-hidden="true" :class="modelActionIconClass(action)"></span>
          {{ action.label }}
        </Button>
      </span>
      <Button
        :if="writeCapabilities().destroy"
        variant="secondary"
        size="sm"
        :disabled="bulkBusy() || bulkDeleteTargets().length === 0"
        @click="confirmingBulk.set({ kind: 'delete' })"
      >
        <span aria-hidden="true" class="h-4 w-4 text-red-500 i-hugeicons-delete-02"></span>
        Delete
      </Button>
      <Button variant="ghost" size="sm" :disabled="bulkBusy()" @click="selected.set([])">Clear</Button>
    </div>
  </div>

  <div :if="error()" class="p-4 bg-red-50 dark:bg-red-900/20 border border-red-200 rounded-xl dark:border-red-800">
    <div class="flex gap-3 items-start">
      <span class="flex-shrink-0 mt-0.5 h-5 w-5 text-red-500 i-hugeicons-alert-02"></span>
      <div>
        <h3 class="font-medium text-[13px] text-red-800 dark:text-red-200">Couldn't load <span :text="modelName()"></span></h3>
        <p class="mt-1 text-[13px] text-red-600 dark:text-red-300" :text="error()"></p>
        <p class="mt-2 text-[12px] text-red-500 dark:text-red-400">
          Looked for an ORM model named <code :text="modelClass()"></code> and a table named <code :text="tableName()"></code>.
        </p>
      </div>
    </div>
  </div>

  <div :if="!loading() && !error() && !migrated()" role="status" class="p-12 text-center bg-white dark:bg-neutral-900 border border-black/8 rounded-xl dark:border-white/10">
    <span aria-hidden="true" class="mx-auto h-10 w-10 text-neutral-300 dark:text-neutral-600 i-hugeicons-database-sync-01"></span>
    <h3 class="mt-3 font-medium text-[15px] text-neutral-900 dark:text-white">
      The <code :text="tableName()"></code> table has not been created yet
    </h3>
    <p class="mt-1.5 text-[13px] text-neutral-500 dark:text-neutral-400">
      Run <code>./buddy migrate</code> to create it, then reload this page.
    </p>
  </div>

  <div :if="isEmpty()" class="p-12 text-center bg-white dark:bg-neutral-900 border border-black/8 rounded-xl dark:border-white/10">
    <span class="mx-auto h-10 w-10 text-neutral-300 dark:text-neutral-600 i-hugeicons-database-01"></span>
    <h3 class="mt-3 font-medium text-[15px] text-neutral-900 dark:text-white">
      <span :if="activeFilterCount() > 0 || search()">Nothing matches those filters</span>
      <span :if="activeFilterCount() === 0 && !search()">No <span :text="modelName()"></span> records yet</span>
    </h3>
    <p class="mt-1.5 text-[13px] text-neutral-500 dark:text-neutral-400">
      <span :if="activeFilterCount() > 0 || search()">Try a broader search, or clear the filters.</span>
      <span :if="activeFilterCount() === 0 && !search()">Seed some with <code>./buddy seed</code>.</span>
    </p>
  </div>

  <div :if="!error() && migrated() && (rows().length > 0 || loading())" class="overflow-hidden bg-white dark:bg-neutral-900 border border-black/8 rounded-xl dark:border-white/10">
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead class="bg-neutral-50 dark:bg-white/5">
          <tr>
            <th :if="selectable()" scope="col" class="pl-3 pr-1 py-2 w-8">
              <input
                type="checkbox"
                aria-label="Select every row on this page"
                :checked="allSelected()"
                :disabled="loading() || bulkBusy() || rows().length === 0"
                class="block h-4 w-4 text-blue-600 border-neutral-300 rounded"
                @change="toggleAllSelected()"
              />
            </th>
            <th :for="column in columnMeta()" scope="col" class="px-3 py-2 whitespace-nowrap group">
              <button type="button" @click="toggleSort(column)" :class="headerClass(column)">
                <span>{{ column.label }}</span>
                <span :class="sortIconClass(column)"></span>
              </button>
            </th>
            <th scope="col" class="right-0 sticky z-20 px-3 py-2 w-28 font-medium text-[11px] text-neutral-500 text-right tracking-wide uppercase dark:text-neutral-400 bg-neutral-50 dark:bg-neutral-800 border-black/5 border-l dark:border-white/10">Actions</th>
          </tr>

          <!-- Per-column filter row -->
          <tr :if="showFilters()" class="bg-white dark:bg-neutral-900">
            <th :if="selectable()"></th>
            <th :for="column in columnMeta()" scope="col" class="pb-2 px-2">
              <input
                type="text"
                :value="filters()[column.name] || ''"
                @input="onFilterInput(column.name, $event)"
                :placeholder="column.label"
                class="block px-2 py-1 w-full font-normal text-[12px] text-neutral-900 dark:text-neutral-100 placeholder:text-neutral-400 dark:placeholder:text-neutral-500 bg-white dark:bg-white/10 border border-black/10 rounded-md dark:border-white/15 focus:border-blue-400 focus:outline-none"
              >
            </th>
            <th class="right-0 sticky z-20 bg-white dark:bg-neutral-900 border-black/5 border-l dark:border-white/10"></th>
          </tr>
        </thead>

        <!-- Loading skeleton, shaped like the real rows so the table does not
            collapse and jump back on every keystroke. Two <tbody> elements
            rather than one: `:if` and `:for` on the same <template> do not
            compose, and a table may legally carry several bodies. -->
        <tbody :if="loading()" class="divide-black/5 divide-y dark:divide-white/8">
          <tr :for="i in skeletonRows()">
            <td :if="selectable()" class="pl-3 pr-1 py-2 w-8"></td>
            <td :for="column in columnMeta()" class="px-3 py-2">
              <div class="h-3 bg-neutral-200 dark:bg-white/10 rounded animate-pulse"></div>
            </td>
            <td class="right-0 sticky z-10 px-3 py-2 bg-white dark:bg-neutral-900 border-black/5 border-l dark:border-white/10">
              <div class="ml-auto h-3 w-16 bg-neutral-200 dark:bg-white/10 rounded animate-pulse"></div>
            </td>
          </tr>
        </tbody>

        <tbody :if="!loading()" class="divide-black/5 divide-y dark:divide-white/8">
          <tr :for="row in rows()" class="hover:bg-neutral-50 dark:hover:bg-white/5 transition-colors group">
            <td :if="selectable()" class="pl-3 pr-1 py-2 w-8">
              <input
                type="checkbox"
                :aria-label="'Select ' + modelName() + ' ' + row.id"
                :checked="isSelected(row)"
                :disabled="bulkBusy()"
                class="block h-4 w-4 text-blue-600 border-neutral-300 rounded"
                @change="toggleSelected(row)"
              />
            </td>
            <td :for="column in columnMeta()" :class="cellClass(column)" :title="cellValue(row, column)">
              <StxLink :if="relationHref(row, column)" :to="relationHref(row, column)" class="font-medium text-blue-600 dark:text-blue-400 hover:underline">{{ cellValue(row, column) }}</StxLink>
              <span :if="cellKind(row, column) === 'text'">{{ cellValue(row, column) }}</span>
              <span :if="cellKind(row, column) === 'badge'" class="inline-flex px-2 py-0.5 font-medium text-neutral-800 text-xs dark:text-neutral-100 border border-neutral-400 rounded-md dark:border-neutral-500">{{ cellValue(row, column) }}</span>
              <a :if="cellKind(row, column) === 'link'" :href="cellHref(row, column)" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline">{{ cellValue(row, column) }}</a>
              <img :if="cellKind(row, column) === 'image'" :src="cellHref(row, column)" alt="" loading="lazy" class="inline-block object-cover h-7 w-7 bg-neutral-100 dark:bg-neutral-800 rounded" />
              <code :if="cellKind(row, column) === 'code'" class="font-mono text-[12px]">{{ cellValue(row, column) }}</code>
            </td>
            <td class="right-0 sticky z-10 px-3 py-2 text-right bg-white dark:bg-neutral-900 group-hover:bg-neutral-50 dark:group-hover:bg-white/5 border-black/5 border-l dark:border-white/10 transition-colors">
              <ModelRecordActions
                :record="row"
                :modelName="modelName()"
                :canUpdate="writeCapabilities().update && !isAnonymized(row)"
                :canDestroy="writeCapabilities().destroy && !isAnonymized(row)"
                :actions="actionsFor(row)"
                :running="runningOn(row)"
                @action="startAction"
                @view="startView"
                @edit="startEdit"
                @delete="confirmingDelete.set($event)"
              />
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="flex flex-wrap gap-3 items-center justify-between px-3 py-2 bg-neutral-50 dark:bg-white/5 border-black/5 border-t dark:border-white/10">
      <p class="text-[12px] text-neutral-500 dark:text-neutral-400" :text="rangeLabel()"></p>
      <div class="flex gap-1 items-center">
        <Button variant="secondary" size="xs" :disabled="page() === 1" @click="goToPage(1)">First</Button>
        <Button variant="secondary" size="xs" :disabled="page() === 1" @click="goToPage(page() - 1)">Previous</Button>
        <span class="px-2 tabular-nums text-[12px] text-neutral-500 dark:text-neutral-400">{{ page() }} / {{ lastPage() }}</span>
        <Button variant="secondary" size="xs" :disabled="page() >= lastPage()" @click="goToPage(page() + 1)">Next</Button>
        <Button variant="secondary" size="xs" :disabled="page() >= lastPage()" @click="goToPage(lastPage())">Last</Button>
      </div>
    </div>
  </div>

  <ConfirmDialog
    :isOpen="Boolean(confirmingDelete())"
    :title="'Delete this ' + modelName() + '?'"
    :description="deleteDescription()"
    :busy="saving()"
    :confirmLabel="saving() ? 'Deleting' : 'Delete'"
    @close="confirmingDelete.set(null)"
    @confirm="confirmDelete"
  />

  <ConfirmDialog
    :isOpen="Boolean(confirmingAction())"
    :title="(confirmingAction()?.action.label || 'Run this action') + '?'"
    :description="confirmingAction()?.action.confirm || ''"
    :variant="confirmingAction()?.action.destructive ? 'danger' : 'warning'"
    :busy="Boolean(runningAction())"
    :confirmLabel="confirmingAction()?.action.label || 'Run'"
    @close="confirmingAction.set(null)"
    @confirm="confirmAction"
  />

  <ConfirmDialog
    :isOpen="Boolean(confirmingBulk())"
    :title="bulkConfirm().title"
    :description="bulkConfirm().description"
    :variant="bulkConfirm().destructive ? 'danger' : 'warning'"
    :busy="bulkBusy()"
    :confirmLabel="bulkBusy() ? bulkProgressLabel() : bulkConfirm().label"
    @close="confirmingBulk.set(null)"
    @confirm="runBulk()"
  />

  <ModelActionForm
    :action="askingAction() ? askingAction().action : null"
    :note="actionFormNote()"
    :busy="Boolean(runningAction()) || bulkBusy()"
    :busyLabel="bulkProgressLabel()"
    :error="actionError()"
    :errors="actionErrors()"
    @close="askingAction.set(null)"
    @submit="submitAction"
  />
</div>
</template>

<style>
.overflow-x-auto { -webkit-overflow-scrolling: touch; }
</style>
