<script client>
// The inputs of a model's form, one per field, each in the control its kind
// calls for: a select for a choice, a switch for yes or no, a date or a
// date-and-time picker, a number box, a tall box for prose and for JSON, a
// search for another model's record, a file chooser, a Markdown editor, and a
// line of text for the rest. Under each, the sentence the model wrote for it,
// when it wrote one.
//
// The create page and the edit page both render this, so a kind of field is
// drawn once. The page owns the values: this reports each change upward as
// `{ name, value }` and shows the message a refused save came back with.
import type { ModelCreateField, ModelFormValues } from '../../../../functions/dashboard-model-record'
import { modelFieldError } from '../../../../functions/dashboard-model-record'

const fields = useReactiveProp<ModelCreateField[]>('fields', [])
// The model these fields belong to, in a dashboard URL: where a chosen file is sent.
const slug = useReactiveProp('slug', '')
const values = useReactiveProp<ModelFormValues>('values', {})
const errors = useReactiveProp<Record<string, string[]>>('errors', {})
const disabled = useReactiveProp('disabled', false)
const emit = defineEmits(['change'])

function text(field: ModelCreateField): string {
  const value = values()[field.name]
  return typeof value === 'string' ? value : ''
}

function error(field: ModelCreateField): string {
  return modelFieldError(errors(), field.name)
}

function inputType(field: ModelCreateField): 'date' | 'datetime-local' | 'email' | 'number' | 'text' | 'url' {
  if (field.type === 'datetime')
    return 'datetime-local'
  if (field.type === 'date' || field.type === 'email' || field.type === 'number' || field.type === 'url')
    return field.type
  return 'text'
}

/** Everything that is one line: text, email, number, date, date and time. */
function isLine(field: ModelCreateField): boolean {
  return !['boolean', 'enum', 'json', 'longtext', 'markdown', 'relation', 'upload'].includes(field.type)
}

/**
 * The line under an input: what the model says about the field
 * (`dashboard.fields.<name>.help`), then what its kind needs said.
 */
function hint(field: ModelCreateField): string {
  const kind = field.type === 'json' ? 'JSON. Checked when you save.' : field.type === 'datetime' ? 'In your own time zone.' : ''
  return [field.help, kind].filter(Boolean).join(' ')
}

function change(field: ModelCreateField, value: string | boolean): void {
  emit('change', { name: field.name, value })
}
</script>

<div class="flex flex-col gap-5">
  <div :for="field in fields()" class="contents">
    <div :if="field.type === 'boolean'" class="p-3 border border-neutral-200 rounded-lg dark:border-neutral-700">
      <Toggle
        :name="field.name"
        :checked="values()[field.name] === true"
        :label="field.label"
        :description="hint(field)"
        :error="error(field)"
        :disabled="disabled()"
        labelPosition="left"
        @update:checked="change(field, $event)"
      />
    </div>

    <Select
      :if="field.type === 'enum'"
      :name="field.name"
      :value="text(field)"
      :options="field.options"
      :label="field.label"
      :ariaLabel="field.label"
      :hint="hint(field)"
      :required="field.required"
      :disabled="disabled()"
      :error="error(field)"
      @update:value="change(field, $event)"
    />

    <ModelRelationPicker
      :if="field.type === 'relation'"
      :slug="field.relation ? field.relation.slug : ''"
      :name="field.name"
      :value="text(field)"
      :label="field.label"
      :hint="hint(field)"
      :required="field.required"
      :disabled="disabled()"
      :error="error(field)"
      @update:value="change(field, $event)"
    />

    <ModelUploadInput
      :if="field.type === 'upload'"
      :slug="slug()"
      :name="field.name"
      :value="text(field)"
      :label="field.label"
      :accept="field.accept || ''"
      :hint="hint(field)"
      :required="field.required"
      :disabled="disabled()"
      :error="error(field)"
      @update:value="change(field, $event)"
    />

    <ModelMarkdownInput
      :if="field.type === 'markdown'"
      :name="field.name"
      :value="text(field)"
      :label="field.label"
      :hint="hint(field)"
      :required="field.required"
      :disabled="disabled()"
      :error="error(field)"
      @update:value="change(field, $event)"
    />

    <Textarea
      :if="field.type === 'longtext' || field.type === 'json'"
      :name="field.name"
      :value="text(field)"
      :label="field.label"
      :ariaLabel="field.label"
      :rows="field.type === 'json' ? 8 : 4"
      :monospace="field.type === 'json'"
      :hint="hint(field)"
      :required="field.required"
      :disabled="disabled()"
      :error="error(field)"
      @update:value="change(field, $event)"
    />

    <Input
      :if="isLine(field)"
      :name="field.name"
      :value="text(field)"
      :type="inputType(field)"
      :label="field.label"
      :ariaLabel="field.label"
      :hint="hint(field)"
      :required="field.required"
      :disabled="disabled()"
      :error="error(field)"
      @update:value="change(field, $event)"
    />
  </div>
</div>
