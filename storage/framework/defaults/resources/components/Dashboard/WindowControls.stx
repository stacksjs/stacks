<script client>
import { useWindowControls } from '../../../functions/craft'

type WindowControlVariant = 'macos' | 'windows'
type WindowControlSize = 'xs' | 'sm' | 'md' | 'lg'

const liveVariant = useReactiveProp('variant', 'macos' as WindowControlVariant)
const liveSize = useReactiveProp('size', 'sm' as WindowControlSize)
const liveDisabled = useReactiveProp('disabled', false)
const emit = defineEmits()
const windowControls = useWindowControls()

const sizeClasses: Record<WindowControlSize, string> = {
  xs: 'h-2 w-2',
  sm: 'h-2.5 w-2.5',
  md: 'h-3 w-3',
  lg: 'h-3.5 w-3.5',
}
const gapClasses: Record<WindowControlSize, string> = {
  xs: 'gap-1',
  sm: 'gap-1.5',
  md: 'gap-2',
  lg: 'gap-2',
}

const controlSize = derived(() => sizeClasses[liveSize()] || sizeClasses.sm)
const controlGap = derived(() => gapClasses[liveSize()] || gapClasses.sm)
const macButtonClass = (color: string) => [
  controlSize(),
  color,
  'group relative rounded-full transition-colors focus:outline-none focus:ring-2',
  liveDisabled() ? 'cursor-not-allowed opacity-50' : 'cursor-pointer',
].join(' ')

async function closeWindow(): Promise<void> {
  emit('close')
  await windowControls.close()
}

async function minimizeWindow(): Promise<void> {
  emit('minimize')
  await windowControls.minimize()
}

async function maximizeWindow(): Promise<void> {
  emit('maximize')
  await windowControls.toggle()
}
</script>

<div :if="liveVariant() === 'macos'" class="flex items-center group" :class="controlGap()">
  <button
    type="button"
    :class="macButtonClass('bg-[#ff5f57] focus:ring-red-500/50')"
    :disabled="liveDisabled()"
    aria-label="Close window"
    title="Close"
    @click="closeWindow"
  >
    <span aria-hidden="true" class="absolute inset-0 m-auto h-1.5 w-1.5 text-[#4d0000] opacity-0 group-hover:opacity-100 transition-opacity i-hugeicons-cancel-01"></span>
  </button>
  <button
    type="button"
    :class="macButtonClass('bg-[#febc2e] focus:ring-yellow-500/50')"
    :disabled="liveDisabled()"
    aria-label="Minimize window"
    title="Minimize"
    @click="minimizeWindow"
  >
    <span aria-hidden="true" class="absolute inset-0 m-auto h-1.5 w-1.5 text-[#995700] opacity-0 group-hover:opacity-100 transition-opacity i-hugeicons-minus-sign"></span>
  </button>
  <button
    type="button"
    :class="macButtonClass('bg-[#28c840] focus:ring-green-500/50')"
    :disabled="liveDisabled()"
    aria-label="Maximize window"
    title="Maximize"
    @click="maximizeWindow"
  >
    <span aria-hidden="true" class="absolute inset-0 m-auto h-1.5 w-1.5 text-[#006500] opacity-0 group-hover:opacity-100 transition-opacity i-hugeicons-arrow-expand-01"></span>
  </button>
</div>

<div :else class="flex items-center">
  <button
    type="button"
    class="p-1.5 text-neutral-600 dark:text-neutral-400 hover:bg-neutral-200 dark:hover:bg-neutral-700 rounded transition-colors"
    :disabled="liveDisabled()"
    aria-label="Minimize window"
    title="Minimize"
    @click="minimizeWindow"
  >
    <span aria-hidden="true" class="h-3 w-3 i-hugeicons-minus-sign"></span>
  </button>
  <button
    type="button"
    class="p-1.5 text-neutral-600 dark:text-neutral-400 hover:bg-neutral-200 dark:hover:bg-neutral-700 rounded transition-colors"
    :disabled="liveDisabled()"
    aria-label="Maximize window"
    title="Maximize"
    @click="maximizeWindow"
  >
    <span aria-hidden="true" class="h-3 w-3 i-hugeicons-square"></span>
  </button>
  <button
    type="button"
    class="p-1.5 text-neutral-600 dark:text-neutral-400 hover:text-white hover:bg-red-500 rounded transition-colors"
    :disabled="liveDisabled()"
    aria-label="Close window"
    title="Close"
    @click="closeWindow"
  >
    <span aria-hidden="true" class="h-3 w-3 i-hugeicons-cancel-01"></span>
  </button>
</div>
