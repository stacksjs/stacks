<script client>
const liveId = useReactiveProp('id', '')
const liveShow = useReactiveProp('show', true)
const liveAriaLabel = useReactiveProp('ariaLabel', 'Dialog')
const emit = defineEmits()
const generatedId = useId('modal')

const modalId = derived(() => liveId() || generatedId)

function closeModal(reason: 'backdrop' | 'button'): void {
  liveShow.set(false)
  emit('update:show', false)
  emit('close', reason)
}
</script>

<div
  :if="liveShow()"
  :data-modal="modalId()"
  class="flex fixed inset-0 z-50 items-end justify-center sm:items-center pb-6 px-4 sm:p-0"
>
  <button
    type="button"
    class="fixed inset-0 bg-gray-500/75 transition-opacity"
    aria-label="Close dialog"
    @click="closeModal('backdrop')"
  ></button>

  <div
    class="overflow-y-auto relative pb-4 pt-5 px-4 sm:p-6 max-h-[32rem] max-w-md w-full md:max-w-xl bg-white dark:bg-neutral-700 rounded-lg shadow-xl transition-all"
    role="dialog"
    aria-modal="true"
    :aria-label="liveAriaLabel()"
  >
    <button
      type="button"
      class="absolute right-4 top-4 text-gray-400 focus:text-gray-500 hover:text-neutral-500 focus:outline-none focus:ring-2 focus:ring-blue-500/40 transition"
      aria-label="Close dialog"
      @click="closeModal('button')"
    >
      <span aria-hidden="true" class="h-6 w-6 i-hugeicons-cancel-01"></span>
    </button>

    <div class="flex flex-col">
      <slot name="body" />
    </div>

    <div class="sm:flex sm:flex-row-reverse mt-5 space-y-4 sm:mt-4 md:space-y-0">
      <slot name="actions" />
    </div>
  </div>
</div>
