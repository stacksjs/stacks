@import('../UI/Button')

<script client>
type ToastWrapperPosition = 'center' | 'top' | 'top-right' | 'top-left'

const liveWidth = useReactiveProp('width', 30)
const livePosition = useReactiveProp('position', 'top-right' as ToastWrapperPosition)
const emit = defineEmits()

const containerClass = derived(() => [
  'pointer-events-none fixed z-[60] flex p-4 sm:p-6',
  ({
    center: 'inset-0 items-center justify-center',
    top: 'inset-x-0 top-0 justify-center',
    'top-right': 'inset-x-0 top-0 justify-end',
    'top-left': 'inset-x-0 top-0 justify-start',
  })[livePosition()] || 'inset-x-0 top-0 justify-end',
].join(' '))
const wrapperStyle = derived(() => `max-width: ${Math.max(16, Number(liveWidth()) || 30)}rem`)
</script>

<div :class="containerClass()" aria-live="polite">
  <div
    class="overflow-hidden w-full bg-white dark:bg-neutral-700 ring-1 ring-black/5 rounded-lg shadow-lg pointer-events-auto"
    :style="wrapperStyle()"
  >
    <div class="flex items-center p-4">
      <div class="flex-1 min-w-0">
        <slot name="body" />
      </div>
      <Button
        type="button"
        variant="ghost"
        size="sm"
        iconOnly
        class="shrink-0 ml-4"
        ariaLabel="Dismiss notification"
        @click="emit('close')"
      >
        <span aria-hidden="true" class="h-5 w-5 i-hugeicons-cancel-01"></span>
      </Button>
    </div>
  </div>
</div>
