@import('../../UI/Button')

<script client>
type ToastType = 'warning' | 'success' | 'error' | 'info'
type ToastPosition = 'center' | 'top' | 'top-right' | 'top-left'

const liveShow = useReactiveProp('show', false)
const liveType = useReactiveProp('type', 'warning' as ToastType)
const liveTitle = useReactiveProp('title', '')
const livePosition = useReactiveProp('position', 'top-right' as ToastPosition)
const liveId = useReactiveProp('id', '')
const emit = defineEmits()
const generatedId = useId('toast')

const toastId = derived(() => liveId() || generatedId)
const containerClass = derived(() => [
  'pointer-events-none fixed z-[60] flex p-4 sm:p-6',
  ({
    center: 'inset-0 items-center justify-center',
    top: 'inset-x-0 top-0 justify-center',
    'top-right': 'inset-x-0 top-0 justify-end',
    'top-left': 'inset-x-0 top-0 justify-start',
  })[livePosition()] || 'inset-x-0 top-0 justify-end',
].join(' '))
const iconClass = derived(() => ({
  warning: 'i-hugeicons-alert-02 text-yellow-500',
  success: 'i-hugeicons-checkmark-circle-02 text-green-500',
  error: 'i-hugeicons-cancel-circle text-red-500',
  info: 'i-hugeicons-information-circle text-blue-500',
})[liveType()] || 'i-hugeicons-alert-02 text-yellow-500')
const liveRegion = derived(() => liveType() === 'error' || liveType() === 'warning' ? 'assertive' : 'polite')

function dismiss(): void {
  liveShow.set(false)
  emit('update:show', false)
  emit('close')
}
</script>

<div :if="liveShow()" :class="containerClass()">
  <div
    :data-toast="toastId()"
    role="alert"
    :aria-live="liveRegion()"
    class="overflow-hidden max-w-sm w-full bg-white dark:bg-neutral-700 ring-1 ring-black/5 rounded-lg shadow-lg pointer-events-auto"
  >
    <div class="flex items-center p-4">
      <span aria-hidden="true" class="shrink-0 h-6 w-6" :class="iconClass()"></span>
      <p class="flex-1 ml-3 min-w-0 font-medium text-gray-900 text-left text-sm dark:text-neutral-100" :text="liveTitle()"></p>
      <Button
        type="button"
        variant="ghost"
        size="sm"
        iconOnly
        class="shrink-0 ml-4"
        ariaLabel="Dismiss notification"
        @click="dismiss"
      >
        <span aria-hidden="true" class="h-5 w-5 i-hugeicons-cancel-01"></span>
      </Button>
    </div>
  </div>
</div>
