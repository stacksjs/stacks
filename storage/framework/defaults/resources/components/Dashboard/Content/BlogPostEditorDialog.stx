<script client>
interface BlogPostRecord {
  slug: string
  title: string
  description: string
  date: string
  author: string
  poster: string
  draft: boolean
  featured: boolean
}

interface BlogPostDraft {
  slug: string
  title: string
  description: string
  date: string
  author: string
  authorBio: string
  poster: string
  featured: boolean
  draft: boolean
  body: string
}

const open = useReactiveProp('open', false)
// Named `editing`, not `post`, while still reading the `post` prop.
// A bare `post` in a `{{ … }}` interpolation is resolved server-side
// against module and global scope, where it finds the dashboard API
// client's own `post()` and calls it mid-render (stacksjs/stacks#2944).
const editing = useReactiveProp('post', null as BlogPostRecord | null)
const loadedBody = useReactiveProp('loadedBody', '')
const bodyLoading = useReactiveProp('bodyLoading', false)
const bodyLoadFailed = useReactiveProp('bodyLoadFailed', false)
const busy = useReactiveProp('busy', false)
const error = useReactiveProp('error', '')
// Not `title` and `description`: a field bound inside the Modal is first read
// as the Modal's own prop of that name (stacksjs/stacks#3310).
const postTitle = state('')
const slug = state('')
const descriptionText = state('')
const date = state('')
const author = state('')
const poster = state('')
const body = state('')
const draft = state(true)
const featured = state(false)
const emit = defineEmits(['close', 'submit', 'retry'])
let wasOpen = false
let activeSlug = ''

function slugify(input: string): string {
  return input
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '')
    .slice(0, 80)
}

const suggestedSlug = derived(() => slugify(postTitle()))
const wordCount = derived(() => body().split(/\s+/).filter(Boolean).length)
const readingTime = derived(() => Math.max(1, Math.round(wordCount() / 200)))
const dialogTitle = derived(() => editing() ? 'Edit post' : 'New post')
const actionLabel = derived(() => editing() ? 'Save post' : 'Create post')

effect(() => {
  const isOpen = open()
  if (isOpen && !wasOpen) {
    const record = editing()
    activeSlug = record?.slug || ''
    postTitle.set(record?.title || '')
    slug.set(record?.slug || '')
    descriptionText.set(record?.description || '')
    date.set(record?.date || new Date().toISOString().slice(0, 10))
    author.set(record?.author || '')
    poster.set(record?.poster || '')
    draft.set(record?.draft ?? true)
    featured.set(Boolean(record?.featured))
    body.set(record ? '' : loadedBody())
  }
  wasOpen = isOpen
})

effect(() => {
  if (open() && editing()?.slug === activeSlug && !bodyLoading())
    body.set(loadedBody())
})

function valid(): boolean {
  return postTitle().trim().length > 0 && !bodyLoading() && !bodyLoadFailed()
}

function close(): void {
  if (!busy())
    emit('close')
}

function submit(): void {
  if (!valid())
    return

  const postDraft: BlogPostDraft = {
    slug: slug().trim() || suggestedSlug(),
    title: postTitle().trim(),
    description: descriptionText().trim(),
    date: date(),
    author: author().trim(),
    authorBio: '',
    poster: poster().trim(),
    featured: featured(),
    draft: draft(),
    body: body(),
  }
  emit('submit', postDraft)
}
</script>

<Modal
  :isOpen="open()"
  :title="dialogTitle()"
  description="Edit the markdown file and its publishing metadata together."
  size="xl"
  :closable="!busy()"
  @close="close"
>
  <form id="blog-post-editor-form" class="grid gap-4" @submit.prevent="submit">
    <div :if="error()" role="alert" class="flex flex-wrap gap-3 items-center justify-between px-3 py-2 text-red-800 text-sm dark:text-red-200 bg-red-50 dark:bg-red-950/40 border border-red-200 rounded-md dark:border-red-900">
      <span class="flex gap-2 items-start min-w-0">
        <span class="shrink-0 mt-0.5 h-4 w-4 i-hugeicons-alert-02"></span>
        <span>{{ error() }}</span>
      </span>
      <Button :if="bodyLoadFailed()" variant="secondary" size="sm" @click="emit('retry')">Retry loading content</Button>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <Input v-model:value="postTitle" name="title" label="Title" :required="true" :autofocus="true" />
      </div>
      <div class="sm:col-span-2">
        <Input v-model:value="slug" name="slug" label="Slug" :placeholder="suggestedSlug()" :spellcheck="false" :monospace="true" :hint="'The file name and public URL: /blog/' + (slug() || suggestedSlug() || 'your-post')" />
      </div>
      <div class="sm:col-span-2">
        <Input v-model:value="descriptionText" name="description" label="Description" hint="Used as the excerpt, meta description, and RSS summary." />
      </div>
      <Input v-model:value="date" name="date" label="Date" type="date" />
      <Input v-model:value="author" name="author" label="Author" />
      <div class="sm:col-span-2">
        <Input v-model:value="poster" name="poster" label="Poster image" placeholder="/assets/images/example.svg" />
      </div>
      <div class="sm:col-span-2">
        <Textarea v-model:value="body" name="body" label="Content" :rows="14" :monospace="true" :disabled="bodyLoading() || bodyLoadFailed()" :hint="'Markdown. ' + wordCount() + ' words, about ' + readingTime() + ' min read.'" />
        <p :if="bodyLoading()" role="status" class="inline-flex gap-1.5 items-center mt-1.5 text-neutral-500 text-xs dark:text-neutral-400">
          <span aria-hidden="true" class="h-3.5 w-3.5 animate-spin i-hugeicons-loading-03"></span>
          Loading content
        </p>
      </div>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row sm:gap-6 pt-2 border-neutral-200 border-t dark:border-neutral-800">
      <Toggle v-model:checked="draft" name="draft" label="Draft, keep off the public blog" />
      <Toggle v-model:checked="featured" name="featured" label="Feature at the top of the listing" />
    </div>
  </form>

  <template #footer>
    <div class="flex gap-2 justify-end w-full">
      <Button variant="secondary" :disabled="busy()" @click="close">Cancel</Button>
      <Button type="submit" form="blog-post-editor-form" :disabled="!valid()" :loading="busy()">
        {{ actionLabel() }}
      </Button>
    </div>
  </template>
</Modal>
