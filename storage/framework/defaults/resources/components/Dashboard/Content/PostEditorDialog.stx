<script client>
type PostStatus = 'draft' | 'published' | 'archived'
interface OptionRecord { id: string, name: string, slug: string }
interface AuthorRecord { id: string, name: string, email: string }
interface PostRecord {
  id: string
  title: string
  excerpt: string
  poster: string
  status: PostStatus
  authorId: string
  featured: boolean
  categoryIds: string[]
  tagIds: string[]
}

interface PostDraft {
  title: string
  excerpt: string
  content: string
  poster: string
  status: PostStatus
  authorId: string | null
  featured: boolean
  categoryIds: string[]
  tagIds: string[]
}

const open = useReactiveProp('open', false)
// Named `editing`, not `post`, while still reading the `post` prop.
// A bare `post` in a `{{ … }}` interpolation is resolved server-side
// against module and global scope, where it finds the dashboard API
// client's own `post()` and calls it mid-render (stacksjs/stacks#2944).
const editing = useReactiveProp('post', null as PostRecord | null)
const categories = useReactiveProp('categories', [] as OptionRecord[])
const tags = useReactiveProp('tags', [] as OptionRecord[])
const authors = useReactiveProp('authors', [] as AuthorRecord[])
// The list row carries a preview, not the body, so the parent reads the body
// when an edit opens and hands it in here (stacksjs/stacks#3191), as the blog
// editor does.
const loadedContent = useReactiveProp('loadedContent', '')
const contentLoading = useReactiveProp('contentLoading', false)
const contentLoadFailed = useReactiveProp('contentLoadFailed', false)
const busy = useReactiveProp('busy', false)
const error = useReactiveProp('error', '')
// Not `title`: a field bound inside the Modal is first read as the Modal's own
// `title` prop (stacksjs/stacks#3310).
const postTitle = state('')
const excerpt = state('')
const content = state('')
const poster = state('')
const status = state<PostStatus>('draft')
const authorId = state('')
const featured = state(false)
const categoryIds = state<string[]>([])
const tagIds = state<string[]>([])
const emit = defineEmits(['close', 'submit', 'retry'])
let wasOpen = false
let activeId = ''

effect(() => {
  const isOpen = open()
  if (isOpen && !wasOpen) {
    const record = editing()
    activeId = record?.id || ''
    postTitle.set(record?.title || '')
    excerpt.set(record?.excerpt || '')
    content.set('')
    poster.set(record?.poster || '')
    status.set(record?.status || 'draft')
    authorId.set(record?.authorId || '')
    featured.set(Boolean(record?.featured))
    categoryIds.set(record ? [...record.categoryIds] : [])
    tagIds.set(record ? [...record.tagIds] : [])
  }
  wasOpen = isOpen
})

effect(() => {
  if (open() && activeId && editing()?.id === activeId && !contentLoading())
    content.set(loadedContent())
})

function valid(): boolean {
  const excerptLength = excerpt().trim().length
  return !contentLoading() && !contentLoadFailed()
    && postTitle().trim().length >= 3 && postTitle().trim().length <= 255
    && content().trim().length >= 10 && content().length <= 100000
    && (excerptLength === 0 || excerptLength >= 10) && excerpt().length <= 500
}

/** Tick or untick one category or tag, as its box reports. */
function chooseCategory(id: string, chosen: boolean): void {
  const current = categoryIds()
  categoryIds.set(chosen ? (current.includes(id) ? current : [...current, id]) : current.filter(entry => entry !== id))
}

function chooseTag(id: string, chosen: boolean): void {
  const current = tagIds()
  tagIds.set(chosen ? (current.includes(id) ? current : [...current, id]) : current.filter(entry => entry !== id))
}

function close(): void {
  if (!busy())
    emit('close')
}

function submit(): void {
  const draft: PostDraft = {
    title: postTitle().trim(),
    excerpt: excerpt().trim(),
    content: content().trim(),
    poster: poster().trim(),
    status: status(),
    authorId: authorId() || null,
    featured: featured(),
    categoryIds: [...categoryIds()],
    tagIds: [...tagIds()],
  }
  emit('submit', draft)
}
</script>

<Modal
  :isOpen="open()"
  :title="editing() ? 'Edit post' : 'New post'"
  description="The text, author, categories and tags are saved together."
  size="xl"
  :closable="!busy()"
  @close="close"
>
  <form id="post-editor-form" class="grid gap-5" @submit.prevent="submit">
    <Input v-model:value="postTitle" name="title" label="Title" :required="true" :minLength="3" :maxLength="255" />
    <div class="grid gap-4 sm:grid-cols-3">
      <Select v-model:value="status" name="status" label="Status" placeholder="" :options="[{ value: 'draft', label: 'Draft' }, { value: 'published', label: 'Published' }, { value: 'archived', label: 'Archived' }]" />
      <Select v-model:value="authorId" name="author_id" label="Author" placeholder="" :options="[{ value: '', label: 'No author' }, ...authors().map(author => ({ value: author.id, label: author.name + ' (' + author.email + ')' }))]" />
      <div class="self-end px-3 py-2 min-h-10 bg-gray-50 dark:bg-neutral-900/60 border border-gray-200 rounded-md dark:border-neutral-700">
        <Toggle v-model:checked="featured" name="featured" label="Featured post" labelPosition="left" />
      </div>
    </div>
    <Input v-model:value="poster" name="poster" label="Poster URL" type="url" inputmode="url" :maxLength="255" placeholder="https://example.com/poster.jpg" />
    <Textarea v-model:value="excerpt" name="excerpt" label="Excerpt" :rows="3" :maxLength="500" :showCount="true" placeholder="Optional, at least 10 characters when provided" />
    <div>
      <Textarea v-model:value="content" name="content" label="Content" :required="true" :minLength="10" :maxLength="100000" :showCount="true" :rows="10" :monospace="true" :disabled="contentLoading() || contentLoadFailed()" />
      <p :if="contentLoading()" role="status" class="inline-flex gap-1.5 items-center mt-1.5 text-gray-500 text-xs dark:text-neutral-400">
        <span aria-hidden="true" class="h-3.5 w-3.5 animate-spin i-hugeicons-loading-03"></span>
        Loading content
      </p>
    </div>
    <div class="grid gap-4 lg:grid-cols-2">
      <fieldset class="p-4 border border-gray-200 rounded-lg dark:border-neutral-700">
        <legend class="px-1 font-semibold text-gray-700 text-sm dark:text-neutral-200">Categories, {{ categoryIds().length }} selected</legend>
        <div :if="categories().length === 0" class="text-gray-500 text-sm dark:text-neutral-400">No categories available.</div>
        <div :else class="grid gap-2">
          <span :for="categoryOption in categories()" class="contents">
            <Checkbox size="sm" :label="categoryOption.name" :checked="categoryIds().includes(categoryOption.id)" @update:checked="chooseCategory(categoryOption.id, $event)" />
          </span>
        </div>
      </fieldset>
      <fieldset class="p-4 border border-gray-200 rounded-lg dark:border-neutral-700">
        <legend class="px-1 font-semibold text-gray-700 text-sm dark:text-neutral-200">Tags, {{ tagIds().length }} selected</legend>
        <div :if="tags().length === 0" class="text-gray-500 text-sm dark:text-neutral-400">No tags available.</div>
        <div :else class="grid gap-2 sm:grid-cols-2">
          <span :for="tagOption in tags()" class="contents">
            <Checkbox size="sm" :label="tagOption.name" :checked="tagIds().includes(tagOption.id)" @update:checked="chooseTag(tagOption.id, $event)" />
          </span>
        </div>
      </fieldset>
    </div>
  </form>

  <div :if="error()" role="alert" class="flex flex-wrap gap-3 items-center justify-between mt-4 p-3 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">
    <span>{{ error() }}</span>
    <Button :if="contentLoadFailed()" variant="secondary" size="sm" @click="emit('retry')">Retry loading content</Button>
  </div>

  <template #footer>
    <div class="flex gap-2 justify-end w-full">
      <Button :disabled="busy()" variant="secondary" @click="close">Cancel</Button>
      <Button type="submit" form="post-editor-form" :disabled="!valid()" :loading="busy()">
        {{ editing() ? 'Save changes' : 'Create post' }}
      </Button>
    </div>
  </template>
</Modal>
