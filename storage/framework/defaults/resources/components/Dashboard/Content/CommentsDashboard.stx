<script client>
import { dashboardApi } from '../../../../functions/dashboard-api'
import { pushToast } from '../../../../functions/toasts'

type CommentStatus = 'pending' | 'approved' | 'spam' | 'trash'

interface CommentRecord {
  id: string
  authorName: string
  authorEmail: string
  content: string
  postTitle: string
  status: CommentStatus
  createdAt: string
}

const comments = state<CommentRecord[]>([])
const loading = state(true)
const loadError = state('')
const search = state('')
const statusFilter = state('all')
const updatingId = state('')
const deletingComment = state<CommentRecord | null>(null)
const deleting = state(false)
const deleteError = state('')

function normalize(record: any): CommentRecord {
  const rawStatus = String(record?.status || 'pending').toLowerCase()
  return {
    id: String(record?.id || ''),
    authorName: String(record?.author_name || ''),
    authorEmail: String(record?.author_email || ''),
    content: String(record?.content || ''),
    postTitle: String(record?.post_title || ''),
    status: ['pending', 'approved', 'spam', 'trash'].includes(rawStatus) ? rawStatus as CommentStatus : 'pending',
    createdAt: String(record?.created_at || ''),
  }
}

function visibleComments(): CommentRecord[] {
  const query = search().trim().toLowerCase()
  return comments().filter(comment =>
    (statusFilter() === 'all' || comment.status === statusFilter())
    && (!query || [comment.content, comment.authorName, comment.authorEmail, comment.postTitle]
      .some(value => value.toLowerCase().includes(query))),
  )
}

function statusCount(status: CommentStatus): number {
  return comments().filter(comment => comment.status === status).length
}

function statusClass(status: CommentStatus): string {
  return `inline-flex px-2 py-1 font-medium text-xs rounded-full ${({
    approved: 'text-green-700 dark:text-green-300 bg-green-50 dark:bg-green-950/40',
    pending: 'text-yellow-700 dark:text-yellow-300 bg-yellow-50 dark:bg-yellow-950/40',
    spam: 'text-red-700 dark:text-red-300 bg-red-50 dark:bg-red-950/40',
    trash: 'text-gray-600 dark:text-neutral-300 bg-gray-100 dark:bg-neutral-700',
  }[status])}`
}

function formatDate(value: string): string {
  if (!value)
    return 'Unknown'
  const date = new Date(value)
  return Number.isNaN(date.getTime())
    ? value
    : new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(date)
}

async function loadComments(): Promise<void> {
  loading.set(true)
  loadError.set('')
  try {
    const data = await dashboardApi<{ comments?: unknown[] }>('/api/dashboard/comments')
    if (!Array.isArray(data.comments))
      throw new TypeError('Comments were not returned in the expected shape.')
    comments.set(data.comments.map(normalize))
  }
  catch (error) {
    loadError.set(error instanceof Error ? error.message : String(error))
    pushToast('error', 'Could not load comments', { detail: loadError() })
  }
  finally {
    loading.set(false)
  }
}

async function setStatus(comment: CommentRecord, status: CommentStatus): Promise<void> {
  updatingId.set(comment.id)
  try {
    await dashboardApi(`/api/dashboard/comments/${comment.id}`, {
      method: 'PATCH',
      body: { status },
    })
    comments.set(comments().map(record => record.id === comment.id ? { ...record, status } : record))
    pushToast('success', `Comment marked ${status}`)
  }
  catch (error) {
    pushToast('error', 'Could not update comment', {
      detail: error instanceof Error ? error.message : String(error),
    })
  }
  finally {
    updatingId.set('')
  }
}

function openDelete(comment: CommentRecord): void {
  deletingComment.set(comment)
  deleteError.set('')
}

function closeDelete(): void {
  if (!deleting())
    deletingComment.set(null)
}

async function deleteComment(): Promise<void> {
  const comment = deletingComment()
  if (!comment)
    return
  deleting.set(true)
  deleteError.set('')
  try {
    await dashboardApi(`/api/dashboard/comments/${comment.id}`, { method: 'DELETE' })
    comments.set(comments().filter(record => record.id !== comment.id))
    deletingComment.set(null)
    pushToast('success', 'Comment permanently deleted')
  }
  catch (error) {
    deleteError.set(error instanceof Error ? error.message : String(error))
  }
  finally {
    deleting.set(false)
  }
}

onMount(() => {
  void loadComments()
})
</script>

<div class="space-y-6">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div><p class="font-semibold text-blue-600 text-xs tracking-wide uppercase dark:text-blue-400">CMS</p><h1 class="mt-1 font-bold text-2xl text-gray-900 dark:text-white">Comments</h1><p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Moderate persisted reader comments without altering their content.</p></div>
    <Button :loading="loading()" variant="secondary" @click="loadComments()"><span :if="!loading()" aria-hidden="true" class="h-4 w-4 i-hugeicons-refresh"></span>Refresh</Button>
  </header>

  <div :if="loadError()" role="alert" class="flex gap-4 items-center justify-between p-4 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900"><span>{{ loadError() }}</span><Button variant="secondary" size="sm" @click="loadComments()">Retry</Button></div>

  <section aria-label="Comment metrics" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    <article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700"><p class="text-gray-500 text-xs dark:text-neutral-400">Total</p><p class="mt-2 font-semibold text-2xl text-gray-900 dark:text-white">{{ comments().length }}</p></article>
    <article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700"><p class="text-gray-500 text-xs dark:text-neutral-400">Pending</p><p class="mt-2 font-semibold text-2xl text-yellow-700 dark:text-yellow-300">{{ statusCount('pending') }}</p></article>
    <article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700"><p class="text-gray-500 text-xs dark:text-neutral-400">Approved</p><p class="mt-2 font-semibold text-2xl text-green-700 dark:text-green-300">{{ statusCount('approved') }}</p></article>
    <article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700"><p class="text-gray-500 text-xs dark:text-neutral-400">Spam or trash</p><p class="mt-2 font-semibold text-2xl text-gray-900 dark:text-white">{{ statusCount('spam') + statusCount('trash') }}</p></article>
  </section>

  <section class="overflow-hidden bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
    <div class="flex flex-col gap-3 sm:flex-row p-4 border-b border-gray-200 dark:border-neutral-700"><label class="flex-1"><span class="sr-only">Search comments</span><input x-model="search" type="search" placeholder="Search comments" class="px-3 py-2 max-w-xl w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" /></label><label><span class="sr-only">Filter comment status</span><select x-model="statusFilter" class="px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700"><option value="all">All statuses</option><option value="pending">Pending</option><option value="approved">Approved</option><option value="spam">Spam</option><option value="trash">Trash</option></select></label></div>
    <div class="divide-gray-200 divide-y dark:divide-neutral-700">
      <div :if="loading()" class="px-4 py-14 text-center text-gray-500 text-sm dark:text-neutral-400"><span class="inline-block mr-2 h-4 w-4 animate-spin i-hugeicons-loading-03"></span>Loading comments</div>
      <div :else-if="visibleComments().length === 0" class="px-4 py-14 text-center"><span class="inline-block h-6 w-6 text-gray-400 i-hugeicons-comment-01"></span><p class="mt-2 font-medium text-gray-900 text-sm dark:text-white">No comments found</p><p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Adjust the search or status filter.</p></div>
      <template :else><template :for="comment in visibleComments()"><article class="p-4"><div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between"><div class="min-w-0"><div class="flex flex-wrap gap-2 items-center"><p class="font-semibold text-gray-900 text-sm dark:text-white">{{ comment.authorName || 'Anonymous' }}</p><span :class="statusClass(comment.status)">{{ comment.status }}</span><span class="text-gray-400 text-xs">{{ formatDate(comment.createdAt) }}</span></div><p class="mt-1 text-gray-500 text-xs dark:text-neutral-400">{{ comment.authorEmail }}<span :if="comment.postTitle"> on {{ comment.postTitle }}</span></p><p class="mt-3 max-w-4xl text-gray-700 text-sm whitespace-pre-wrap dark:text-neutral-200">{{ comment.content }}</p></div><div class="flex flex-shrink-0 flex-wrap gap-2"><Button :if="comment.status !== 'approved'" variant="success" size="sm" :disabled="Boolean(updatingId())" @click="setStatus(comment, 'approved')">Approve</Button><Button :if="comment.status !== 'pending'" variant="secondary" size="sm" :disabled="Boolean(updatingId())" @click="setStatus(comment, 'pending')">Restore</Button><Button :if="comment.status !== 'spam'" variant="warning" size="sm" :disabled="Boolean(updatingId())" @click="setStatus(comment, 'spam')">Spam</Button><Button :if="comment.status !== 'trash'" variant="outline" size="sm" :disabled="Boolean(updatingId())" @click="setStatus(comment, 'trash')">Trash</Button><Button variant="ghost" size="sm" iconOnly :ariaLabel="'Permanently delete comment by ' + comment.authorName" :disabled="Boolean(updatingId())" @click="openDelete(comment)"><span class="block h-4 w-4 text-red-500 i-hugeicons-delete-02"></span></Button></div></div></article></template></template>
    </div>
  </section>
</div>

<div :if="Boolean(deletingComment())" class="flex fixed inset-y-0 right-0 z-[55] items-center justify-center p-4 dashboard-modal-layer">
  <button type="button" aria-label="Close delete comment dialog" class="absolute inset-0 bg-black/45" @click="closeDelete()"></button>
  <section role="dialog" aria-modal="true" aria-label="Permanently delete comment?" class="relative p-6 max-w-md w-full bg-white dark:bg-neutral-800 border border-gray-200 rounded-xl dark:border-neutral-700 shadow-xl"><h2 class="font-semibold text-gray-900 text-lg dark:text-white">Permanently delete comment?</h2><p class="mt-2 text-gray-500 text-sm dark:text-neutral-400">The comment from <strong>{{ deletingComment()?.authorName || 'Anonymous' }}</strong> cannot be restored.</p><div :if="deleteError()" role="alert" class="mt-4 p-3 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">{{ deleteError() }}</div><div class="flex gap-2 justify-end mt-6"><Button :disabled="deleting()" variant="secondary" @click="closeDelete()">Cancel</Button><Button :loading="deleting()" variant="danger" @click="deleteComment()">Delete permanently</Button></div></section>
</div>
