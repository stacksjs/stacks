<script client>
interface TaxonomyDraft {
  name: string
  slug: string
  description: string
}

const open = useReactiveProp('open', false)
const kind = useReactiveProp('kind', 'category')
const busy = useReactiveProp('busy', false)
const error = useReactiveProp('error', '')
const name = state('')
const slug = state('')
// Not `description`: a field bound inside the Modal is first read as the Modal's own
// `description` prop (stacksjs/stacks#3310).
const descriptionText = state('')
const slugTouched = state(false)
const emit = defineEmits(['close', 'submit'])
let wasOpen = false

function slugify(value: string): string {
  return value
    .normalize('NFKD')
    .replace(/[\u0300-\u036F]/g, '')
    .trim()
    .toLowerCase()
    .replace(/['"]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '')
}

effect(() => {
  const isOpen = open()
  if (isOpen && !wasOpen) {
    name.set('')
    slug.set('')
    descriptionText.set('')
    slugTouched.set(false)
  }
  wasOpen = isOpen
})

effect(() => {
  if (!open() || slugTouched())
    return
  slug.set(slugify(name()))
})

function markSlugTouched(): void {
  slugTouched.set(true)
}

function normalizeSlug(): void {
  const normalized = slugify(slug())
  if (normalized !== slug())
    slug.set(normalized)
}

function close(): void {
  if (!busy())
    emit('close')
}

function submit(): void {
  const draft: TaxonomyDraft = {
    name: name().trim(),
    slug: slugify(slug()),
    description: descriptionText().trim(),
  }
  emit('submit', draft)
}
</script>

<Modal
  :isOpen="open()"
  :title="'New ' + kind()"
  description="Add a reusable classification for your published content."
  :closable="!busy()"
  @close="close"
>
  <form id="taxonomy-editor-form" class="grid gap-4" @submit.prevent="submit">
    <Input v-model:value="name" name="name" label="Name" :required="true" :maxLength="255" />
    <Input v-model:value="slug" name="slug" label="Slug" :required="true" :maxLength="255" :spellcheck="false" :monospace="true" @input="markSlugTouched" @blur="normalizeSlug" />
    <Textarea v-model:value="descriptionText" name="description" label="Description" :rows="3" :maxLength="1000" />
  </form>

  <div :if="error()" role="alert" class="mt-4 p-3 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">
    {{ error() }}
  </div>

  <template #footer>
    <div class="flex gap-2 justify-end w-full">
      <Button :disabled="busy()" variant="secondary" @click="close">Cancel</Button>
      <Button type="submit" form="taxonomy-editor-form" :disabled="!name().trim() || !slug().trim()" :loading="busy()">
        Create {{ kind() }}
      </Button>
    </div>
  </template>
</Modal>
