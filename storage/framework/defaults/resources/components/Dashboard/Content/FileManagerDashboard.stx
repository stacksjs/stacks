@import('../UI/Table')

<script client>
import { dashboardApi } from '../../../../functions/dashboard-api'
import { pushToast } from '../../../../functions/toasts'

interface FileItem {
  id: string
  name: string
  type: string
  size: number
  path: string
  lastModified: string | null
  mime_type?: string
  url?: string
  thumbnail?: string
  preview?: string
  previewText?: string
  starred: false
  shared: boolean
  items?: FileItem[]
}

interface FileStats {
  files: number
  folders: number
  contentBytes: number
  byType: {
    documents: number
    images: number
    videos: number
    audio: number
    other: number
  }
  disk: {
    totalBytes: number | null
    availableBytes: number | null
    usedBytes: number | null
  }
}

interface FileSnapshot {
  disk: string
  disks: Array<{ name: string, public: boolean }>
  root: FileItem
  stats: FileStats
  truncated: boolean
  warnings: string[]
}

const emptyRoot = (): FileItem => ({
  id: 'folder:',
  name: 'Home',
  type: 'folder',
  size: 0,
  path: '',
  lastModified: null,
  starred: false,
  shared: true,
  items: [],
})

const emptyStats = (): FileStats => ({
  files: 0,
  folders: 0,
  contentBytes: 0,
  byType: { documents: 0, images: 0, videos: 0, audio: 0, other: 0 },
  disk: { totalBytes: null, availableBytes: null, usedBytes: null },
})

const root = state<FileItem>(emptyRoot())
const stats = state<FileStats>(emptyStats())
const disks = state<Array<{ name: string, public: boolean }>>([])
const selectedDisk = state('public')
const currentFolderPath = state('')
const searchQuery = state('')
const sortBy = state<'name' | 'lastModified' | 'size'>('name')
const sortOrder = state<'asc' | 'desc'>('asc')
const viewMode = state<'grid' | 'list'>('grid')
// A wide screen shows the storage panel beside the files; a narrow one has
// no room for it, so the same panel opens in a drawer instead.
const sidePanelOpen = state(true)
const storageDrawerOpen = state(false)
const isWideScreen = useMediaQuery('(min-width: 1024px)')
const loading = state(true)
const loadError = state('')
const truncated = state(false)
const warnings = state<string[]>([])
const scanLimit = state(1000)

const selectedItem = state<FileItem | null>(null)
const showCreateFolderModal = state(false)
const creatingFolder = state(false)
const createError = state('')
const showUploadModal = state(false)
const uploading = state(false)
const uploadError = state('')
const itemToDelete = state<FileItem | null>(null)
const deleting = state(false)
const deleteError = state('')

const fileTypeIcons: Record<string, string> = {
  pdf: 'i-hugeicons-pdf-01',
  doc: 'i-hugeicons-doc-01',
  docx: 'i-hugeicons-doc-01',
  xls: 'i-hugeicons-xls-01',
  xlsx: 'i-hugeicons-xls-01',
  ppt: 'i-hugeicons-ppt-01',
  pptx: 'i-hugeicons-ppt-01',
  jpg: 'i-hugeicons-jpg-01',
  jpeg: 'i-hugeicons-jpg-01',
  png: 'i-hugeicons-png-01',
  gif: 'i-hugeicons-gif-01',
  svg: 'i-hugeicons-svg-01',
  txt: 'i-hugeicons-txt-01',
  zip: 'i-hugeicons-zip-01',
  mp3: 'i-hugeicons-mp3-01',
  mp4: 'i-hugeicons-mp-4-01',
  folder: 'i-hugeicons-folder-02',
  default: 'i-hugeicons-file-02',
}

function findFolder(folder: FileItem, path: string): FileItem | null {
  if (folder.path === path)
    return folder
  for (const child of folder.items || []) {
    if (child.type === 'folder') {
      const found = findFolder(child, path)
      if (found)
        return found
    }
  }
  return null
}

const currentFolder = derived(() => findFolder(root(), currentFolderPath()) || root())
const topLevelFolders = derived(() => (root().items || []).filter(item => item.type === 'folder'))
const breadcrumbs = derived(() => {
  const parts = currentFolderPath() ? currentFolderPath().split('/') : []
  return [
    { label: 'Home', path: '' },
    ...parts.map((label, index) => ({ label, path: parts.slice(0, index + 1).join('/') })),
  ]
})

const filteredItems = derived(() => {
  const query = searchQuery().trim().toLowerCase()
  const items = [...(currentFolder().items || [])].filter(item => !query || item.name.toLowerCase().includes(query))
  items.sort((a, b) => {
    if (a.type === 'folder' && b.type !== 'folder')
      return -1
    if (a.type !== 'folder' && b.type === 'folder')
      return 1
    if (sortBy() === 'lastModified') {
      const left = a.lastModified ? new Date(a.lastModified).getTime() : 0
      const right = b.lastModified ? new Date(b.lastModified).getTime() : 0
      return sortOrder() === 'asc' ? left - right : right - left
    }
    if (sortBy() === 'size')
      return sortOrder() === 'asc' ? a.size - b.size : b.size - a.size
    return sortOrder() === 'asc' ? a.name.localeCompare(b.name) : b.name.localeCompare(a.name)
  })
  return items
})

const typeRows = derived(() => [
  { key: 'documents', label: 'Documents', bytes: stats().byType.documents, color: 'bg-blue-500' },
  { key: 'images', label: 'Images', bytes: stats().byType.images, color: 'bg-fuchsia-500' },
  { key: 'videos', label: 'Videos', bytes: stats().byType.videos, color: 'bg-amber-500' },
  { key: 'audio', label: 'Audio', bytes: stats().byType.audio, color: 'bg-emerald-500' },
  { key: 'other', label: 'Other', bytes: stats().byType.other, color: 'bg-stone-400 dark:bg-neutral-500' },
].map(row => ({ key: row.key, label: row.label, color: row.color, size: formatFileSize(row.bytes), barStyle: typeBarStyle(row.bytes) })))

const volumePercent = derived(() => {
  const total = stats().disk.totalBytes
  const used = stats().disk.usedBytes
  return total && used !== null ? Math.min(100, Math.max(0, used / total * 100)) : 0
})
const capacityKnown = derived(() => stats().disk.totalBytes !== null && stats().disk.availableBytes !== null)
const storageSummary = derived(() => ({
  files: stats().files,
  folders: stats().folders,
  contentSize: formatFileSize(stats().contentBytes),
  capacityKnown: capacityKnown(),
  capacityPercent: volumePercent(),
  available: formatFileSize(stats().disk.availableBytes),
  total: formatFileSize(stats().disk.totalBytes),
}))
const storageFolders = derived(() => topLevelFolders().map(folder => ({ path: folder.path, name: folder.name, count: (folder.items || []).length })))
const currentFolderLabel = derived(() => currentFolderPath() || 'Storage root')
const emptyHint = derived(() => searchQuery() ? 'No items match your search.' : 'This folder is empty.')

function toggleSidePanel(): void {
  if (isWideScreen())
    sidePanelOpen.set(!sidePanelOpen())
  else
    storageDrawerOpen.set(true)
}

effect(() => {
  if (isWideScreen() && storageDrawerOpen())
    storageDrawerOpen.set(false)
})

const segmentBase = 'inline-flex items-center px-2.5 py-1.5 rounded-md text-sm font-medium transition-colors'
const segmentActive = 'bg-white dark:bg-neutral-700 text-stone-800 dark:text-white shadow-sm'
const segmentInactive = 'text-stone-500 dark:text-neutral-400 hover:text-stone-700 dark:hover:text-neutral-200'
const gridViewClass = derived(() => `${segmentBase} ${viewMode() === 'grid' ? segmentActive : segmentInactive}`)
const listViewClass = derived(() => `${segmentBase} ${viewMode() === 'list' ? segmentActive : segmentInactive}`)
const sortOrderIconClass = derived(() => `${sortOrder() === 'asc' ? 'i-hugeicons-arrow-up-02' : 'i-hugeicons-arrow-down-02'} h-5 w-5`)

function gridCardClass(item: FileItem): string {
  const selected = selectedItem()?.id === item.id
  return `group relative overflow-hidden bg-white dark:bg-neutral-800 border rounded-lg shadow-sm hover:shadow-md transition-all cursor-pointer ${selected ? 'border-blue-400 ring-2 ring-blue-500/20' : 'border-gray-200 dark:border-neutral-700 hover:border-blue-300 dark:hover:border-blue-700'}`
}

function itemIconClass(item: FileItem): string {
  const icon = item.type === 'folder' ? fileTypeIcons.folder : fileTypeIcons[item.type] || fileTypeIcons.default
  return `${icon} h-5 w-5 mr-3 ${item.type === 'folder' ? 'text-amber-500' : 'text-gray-500 dark:text-neutral-400'}`
}

function typeBarStyle(bytes: number): string {
  const total = stats().contentBytes
  const percentage = total > 0 ? Math.max(bytes > 0 ? 2 : 0, bytes / total * 100) : 0
  return `width: ${percentage.toFixed(2)}%`
}

function formatFileSize(bytes: number | null): string {
  if (bytes === null)
    return 'Unavailable'
  if (bytes === 0)
    return '0 Bytes'
  const units = ['Bytes', 'KB', 'MB', 'GB', 'TB']
  const index = Math.min(units.length - 1, Math.floor(Math.log(bytes) / Math.log(1024)))
  return `${Number.parseFloat((bytes / 1024 ** index).toFixed(2))} ${units[index]}`
}

const FILE_COLUMNS = [
  { key: 'name', label: 'Name', sortable: true, slotted: true },
  { key: 'size', label: 'Size', sortable: true, slotted: true, searchable: false },
  { key: 'lastModified', label: 'Modified', type: 'date' as const, sortable: true, emptyText: 'No date', class: 'text-sm text-stone-500 dark:text-neutral-400' },
]

/** What the list view's table reads; `item` is what the click and delete handlers take. */
const fileRows = derived(() => filteredItems().map(item => ({
  id: item.id,
  name: item.name,
  size: item.type === 'folder' ? -1 : item.size,
  sizeLabel: item.type === 'folder' ? '-' : formatFileSize(item.size),
  lastModified: item.lastModified,
  iconClass: itemIconClass(item),
  item,
})))

async function loadFiles(options: { resetPath?: boolean } = {}): Promise<void> {
  loading.set(true)
  loadError.set('')
  try {
    const payload = await dashboardApi<FileSnapshot>(`/api/dashboard/files?disk=${encodeURIComponent(selectedDisk())}&limit=${scanLimit()}`)
    if (!payload?.root || !Array.isArray(payload.root.items) || !payload.stats || !Array.isArray(payload.disks))
      throw new TypeError('Storage data was not returned in the expected shape.')
    root.set(payload.root)
    stats.set(payload.stats)
    disks.set(payload.disks)
    selectedDisk.set(payload.disk)
    truncated.set(Boolean(payload.truncated))
    warnings.set(Array.isArray(payload.warnings) ? payload.warnings : [])
    if (options.resetPath || !findFolder(payload.root, currentFolderPath()))
      currentFolderPath.set('')
  }
  catch (error) {
    loadError.set(error instanceof Error ? error.message : String(error))
    pushToast('error', 'Could not load storage', { detail: loadError() })
  }
  finally {
    loading.set(false)
  }
}

function changeDisk(): void {
  selectedItem.set(null)
  searchQuery.set('')
  scanLimit.set(1000)
  void loadFiles({ resetPath: true })
}

function loadMore(): void {
  scanLimit.set(Math.min(5000, scanLimit() + 1000))
  void loadFiles()
}

function navigateToFolder(folder: FileItem): void {
  currentFolderPath.set(folder.path)
  selectedItem.set(null)
}

function openStorageFolder(path: string): void {
  currentFolderPath.set(path)
  selectedItem.set(null)
  storageDrawerOpen.set(false)
}

function selectStorageDisk(name: string): void {
  selectedDisk.set(name)
  changeDisk()
}

function uploadFromStoragePanel(): void {
  storageDrawerOpen.set(false)
  openUpload()
}

function onItemClick(item: FileItem): void {
  if (item.type === 'folder')
    navigateToFolder(item)
  else
    selectedItem.set(item)
}

function onItemKeydown(item: FileItem, event: KeyboardEvent): void {
  if (event.target !== event.currentTarget || (event.key !== 'Enter' && event.key !== ' '))
    return
  event.preventDefault()
  onItemClick(item)
}

function toggleSortOrder(): void {
  sortOrder.set(sortOrder() === 'asc' ? 'desc' : 'asc')
}

function openCreateFolder(): void {
  createError.set('')
  showCreateFolderModal.set(true)
}

function closeCreateFolder(): void {
  if (!creatingFolder())
    showCreateFolderModal.set(false)
}

async function createFolder(name: string): Promise<void> {
  creatingFolder.set(true)
  createError.set('')
  try {
    await dashboardApi('/api/dashboard/files/directories', {
      method: 'POST',
      body: { disk: selectedDisk(), path: currentFolderPath(), name },
    })
    showCreateFolderModal.set(false)
    pushToast('success', 'Folder created', { detail: name })
    await loadFiles()
  }
  catch (error) {
    createError.set(error instanceof Error ? error.message : String(error))
  }
  finally {
    creatingFolder.set(false)
  }
}

function openUpload(): void {
  uploadError.set('')
  showUploadModal.set(true)
}

function closeUpload(): void {
  if (!uploading())
    showUploadModal.set(false)
}

async function uploadFiles(files: File[]): Promise<void> {
  if (!files.length)
    return
  uploading.set(true)
  uploadError.set('')
  try {
    const formData = new FormData()
    formData.append('disk', selectedDisk())
    formData.append('path', currentFolderPath())
    for (const file of files)
      formData.append('files', file)
    await dashboardApi('/api/dashboard/files/uploads', { method: 'POST', formData })
    const count = files.length
    showUploadModal.set(false)
    pushToast('success', `${count} ${count === 1 ? 'file' : 'files'} uploaded`)
    await loadFiles()
  }
  catch (error) {
    uploadError.set(error instanceof Error ? error.message : String(error))
  }
  finally {
    uploading.set(false)
  }
}

function openDelete(item: FileItem, event: Event): void {
  event.stopPropagation()
  itemToDelete.set(item)
  deleteError.set('')
}

function closeDelete(): void {
  if (!deleting())
    itemToDelete.set(null)
}

function deleteTitle(): string {
  const item = itemToDelete()
  return item ? `Delete ${item.name}` : 'Delete item'
}

function deleteDescription(): string {
  return itemToDelete()?.type === 'folder'
    ? 'The folder and everything inside it will be permanently deleted.'
    : 'This file will be permanently deleted.'
}

async function deleteItem(): Promise<void> {
  const item = itemToDelete()
  if (!item)
    return
  deleting.set(true)
  deleteError.set('')
  try {
    await dashboardApi('/api/dashboard/files', {
      method: 'DELETE',
      body: { disk: selectedDisk(), path: item.path },
    })
    itemToDelete.set(null)
    if (selectedItem()?.id === item.id)
      selectedItem.set(null)
    pushToast('success', item.type === 'folder' ? 'Folder deleted' : 'File deleted', { detail: item.name })
    await loadFiles()
  }
  catch (error) {
    deleteError.set(error instanceof Error ? error.message : String(error))
  }
  finally {
    deleting.set(false)
  }
}

onMount(() => { void loadFiles() })
</script>

<div class="flex min-h-[calc(100dvh-3rem)] bg-white dark:bg-neutral-900">
  <aside class="hidden lg:block shrink-0 bg-[#F5F3EE]/70 dark:bg-neutral-900/40 border-black/[0.06] border-r dark:border-white/[0.08] backdrop-blur-2xl duration-300 transition-all" :class="sidePanelOpen() ? 'w-64' : 'w-0 overflow-hidden'">
    <div class="h-full min-h-[calc(100dvh-3rem)] w-64">
      <FileStoragePanel :disks="disks()" :disk="selectedDisk()" :busy="loading()" :summary="storageSummary()" :type-rows="typeRows()" :folders="storageFolders()" :current-path="currentFolderPath()" @disk="selectStorageDisk" @navigate="openStorageFolder" @upload="uploadFromStoragePanel()" />
    </div>
  </aside>

  <div class="flex-1 min-w-0">
    <header class="sticky top-0 z-10 p-4 bg-white/85 dark:bg-neutral-900/85 border-b border-black/[0.06] dark:border-white/[0.08] backdrop-blur-xl">
      <div class="flex flex-wrap gap-3 items-center justify-between">
        <div class="flex items-center min-w-0">
          <Button variant="ghost" iconOnly ariaLabel="Toggle storage sidebar" @click="toggleSidePanel()"><span class="block h-5 w-5 i-hugeicons-menu-01"></span></Button>
          <div class="ml-3 min-w-0"><p class="font-semibold text-stone-900 truncate dark:text-white">{{ currentFolderLabel }}</p><p class="mt-0.5 text-stone-500 text-xs dark:text-neutral-400">{{ selectedDisk }} disk</p></div>
        </div>
        <div class="flex flex-wrap gap-2 items-center">
          <label class="relative"><span class="sr-only">Search current folder</span><span class="absolute left-3 top-2.5 h-4 w-4 text-stone-400 i-hugeicons-search-01"></span><input x-model="searchQuery" type="search" placeholder="Search this folder" class="pl-9 pr-3 py-2 w-56 text-sm text-stone-900 dark:text-white bg-white dark:bg-neutral-800 border border-stone-200 rounded-lg dark:border-neutral-700" /></label>
          <div class="flex gap-0.5 p-0.5 bg-black/[0.05] dark:bg-white/[0.06] rounded-lg"><button type="button" aria-label="Grid view" :class="gridViewClass()" @click="viewMode.set('grid')"><span class="h-5 w-5 i-hugeicons-grid-view"></span></button><button type="button" aria-label="List view" :class="listViewClass()" @click="viewMode.set('list')"><span class="h-5 w-5 i-hugeicons-right-to-left-list-number"></span></button></div>
          <select x-model="sortBy" aria-label="Sort files" class="px-2.5 py-2 text-sm text-stone-700 dark:text-neutral-200 bg-white dark:bg-neutral-800 border border-stone-200 rounded-lg dark:border-neutral-700"><option value="name">Name</option><option value="lastModified">Date</option><option value="size">Size</option></select>
          <Button variant="ghost" iconOnly ariaLabel="Reverse sort order" @click="toggleSortOrder()"><span :class="sortOrderIconClass()"></span></Button>
          <Button :loading="loading()" variant="secondary" @click="loadFiles()"><span :if="!loading()" aria-hidden="true" class="h-4 w-4 i-hugeicons-refresh"></span>Refresh</Button>
          <Button @click="openCreateFolder()"><span aria-hidden="true" class="h-4 w-4 i-hugeicons-folder-add"></span>New folder</Button>
        </div>
      </div>
      <nav aria-label="Folder path" class="flex overflow-x-auto items-center mt-4 text-sm">
        <template :for="(crumb, index) in breadcrumbs">
          <span :if="index > 0" aria-hidden="true" class="mx-1 text-stone-300 dark:text-neutral-600">/</span>
          <button type="button" :aria-current="crumb.path === currentFolderPath() ? 'page' : undefined" class="font-medium text-stone-500 whitespace-nowrap dark:text-neutral-400 hover:text-blue-600 dark:hover:text-blue-400" @click="currentFolderPath.set(crumb.path)">{{ crumb.label }}</button>
        </template>
      </nav>
    </header>

    <div class="p-4 lg:p-6">
      <div :if="loadError()" role="alert" class="flex gap-4 items-center justify-between p-4 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-xl dark:border-red-900"><span>{{ loadError() }}</span><Button variant="secondary" size="sm" @click="loadFiles()">Retry</Button></div>
      <div :if="warnings().length" role="status" class="mb-4 p-3 text-amber-800 text-sm dark:text-amber-200 bg-amber-50 dark:bg-amber-950/30 border border-amber-200 rounded-lg dark:border-amber-900">
        <p class="font-semibold">Some storage metadata is unavailable</p>
        <ul class="mt-1 list-disc list-inside">
          <template :for="warning in warnings()">
            <li>{{ warning }}</li>
          </template>
        </ul>
      </div>
      <div :if="truncated()" role="status" class="flex gap-4 items-center justify-between mb-4 p-3 text-amber-800 text-sm dark:text-amber-200 bg-amber-50 dark:bg-amber-950/30 border border-amber-200 rounded-lg dark:border-amber-900"><span>This disk contains more than {{ scanLimit }} visible entries. The current view shows the first {{ scanLimit }}.</span><Button :if="scanLimit() < 5000" variant="secondary" size="sm" :loading="loading()" @click="loadMore()">Load 1,000 more</Button><span :else class="flex-shrink-0 font-semibold">5,000 entry limit</span></div>

      <div :if="loading() && !root().items?.length" class="grid gap-4 grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 xl:grid-cols-6" aria-label="Loading files">
        <template :for="index in [1, 2, 3, 4, 5, 6]"><div class="h-44 bg-stone-100 dark:bg-neutral-800 rounded-lg animate-pulse"></div></template>
      </div>

      <div :else-if="!loadError() && filteredItems().length === 0" class="flex flex-col items-center justify-center min-h-[55dvh] text-center">
        <span class="h-14 w-14 text-stone-300 dark:text-neutral-700 i-hugeicons-folder-02"></span><h2 class="mt-3 font-semibold text-stone-900 dark:text-white">No items</h2><p class="mt-1 text-sm text-stone-500 dark:text-neutral-400">{{ emptyHint }}</p><div :if="!searchQuery()" class="flex gap-2 mt-5"><Button variant="secondary" @click="openCreateFolder()">Create folder</Button><Button @click="openUpload()">Upload files</Button></div>
      </div>

      <div :else-if="viewMode() === 'grid'" class="grid gap-4 grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6">
        <template :for="item in filteredItems">
          <article role="button" tabindex="0" :aria-label="(item.type === 'folder' ? 'Open folder ' : 'View file ') + item.name" :class="gridCardClass(item)" @click="onItemClick(item)" @keydown="onItemKeydown(item, $event)">
            <MediaCard :item="item" />
            <div class="absolute right-2 top-2 opacity-0 focus-within:opacity-100 group-hover:opacity-100 transition-opacity"><Button variant="secondary" size="sm" iconOnly :ariaLabel="'Delete ' + item.name" @click="openDelete(item, $event)"><span class="block h-4 w-4 text-red-500 i-hugeicons-delete-02"></span></Button></div>
          </article>
        </template>
      </div>

      {{--
        The list view. The page owns search, the folder path and the loading
        and empty states; the table brings sorting and paging, which a large
        folder had none of. Name is slotted for its icon and the click that
        opens a folder, and size is slotted so it reads as a size while
        sorting on the byte count underneath.
      --}}
      <div :else>
        <Table :columns="FILE_COLUMNS" :data="fileRows()" paginated :page-size="50" empty-title="No items" empty-description="Nothing to show in this folder.">
          <template #cell="{ row, column }">
            <template :if="column.key === 'name'">
              <button type="button" class="flex items-center max-w-md text-left" @click="onItemClick(row.item)"><span :class="row.iconClass"></span><span class="font-medium text-sm text-stone-900 truncate dark:text-white" x-text="row.name"></span></button>
            </template>
            <template :else>
              <span class="text-sm text-stone-500 dark:text-neutral-400" x-text="row.sizeLabel"></span>
            </template>
          </template>
          <template #actions="{ row }">
            <div class="text-right"><Button variant="ghost" size="sm" iconOnly :ariaLabel="'Delete ' + row.name" @click="openDelete(row.item, $event)"><span class="block h-4 w-4 text-red-500 i-hugeicons-delete-02"></span></Button></div>
          </template>
        </Table>
      </div>
    </div>
  </div>
</div>

<Drawer :isOpen="storageDrawerOpen()" title="Storage" :description="selectedDisk() + ' disk'" size="sm" @close="storageDrawerOpen.set(false)">
  <FileStoragePanel :disks="disks()" :disk="selectedDisk()" :busy="loading()" :summary="storageSummary()" :type-rows="typeRows()" :folders="storageFolders()" :current-path="currentFolderPath()" @disk="selectStorageDisk" @navigate="openStorageFolder" @upload="uploadFromStoragePanel()" />
</Drawer>

<FileDetailsDrawer :item="selectedItem()" :disk="selectedDisk()" @close="selectedItem.set(null)" />

<CreateFolderDialog
  :open="showCreateFolderModal()"
  :location="currentFolderLabel()"
  :busy="creatingFolder()"
  :error="createError()"
  @close="closeCreateFolder"
  @submit="createFolder"
/>

<FileUploadDialog
  :open="showUploadModal()"
  :location="currentFolderLabel()"
  :busy="uploading()"
  :error="uploadError()"
  @close="closeUpload"
  @submit="uploadFiles"
/>

<ConfirmDialog
  :isOpen="Boolean(itemToDelete())"
  :title="deleteTitle()"
  :description="deleteDescription()"
  confirmLabel="Delete permanently"
  :busy="deleting()"
  :error="deleteError()"
  @close="closeDelete"
  @confirm="deleteItem"
/>
