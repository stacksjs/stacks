<script client>
import { dashboardApi } from '../../../../functions/dashboard-api'
import { pushToast } from '../../../../functions/toasts'

interface TaxonomyRecord {
  id: string
  name: string
  slug: string
  description: string
  active: boolean
  postCount: number
}

const resource = useReactiveProp('resource', 'categories')
const title = useReactiveProp('title', 'Categories')
const description = useReactiveProp('description', '')
const records = state<TaxonomyRecord[]>([])
const loading = state(true)
const loadError = state('')
const search = state('')
const dialogOpen = state(false)
const name = state('')
const slug = state('')
const taxonomyDescription = state('')
const slugTouched = state(false)
const saving = state(false)
const saveError = state('')
const deletingRecord = state<TaxonomyRecord | null>(null)
const deleting = state(false)
const deleteError = state('')

function singular(): string {
  return resource() === 'tags' ? 'tag' : 'category'
}

function normalize(record: any): TaxonomyRecord {
  return {
    id: String(record?.id || ''),
    name: String(record?.name || ''),
    slug: String(record?.slug || ''),
    description: String(record?.description || ''),
    active: record?.is_active !== false && record?.is_active !== 0,
    postCount: Number(record?.post_count || 0),
  }
}

function visibleRecords(): TaxonomyRecord[] {
  const query = search().trim().toLowerCase()
  return records().filter(record => !query || [
    record.name,
    record.slug,
    record.description,
  ].some(value => value.toLowerCase().includes(query)))
}

function secondaryMetricLabel(): string {
  return resource() === 'tags' ? 'Assigned posts' : 'Active'
}

function secondaryMetric(): number {
  return resource() === 'tags'
    ? records().reduce((sum, record) => sum + record.postCount, 0)
    : records().filter(record => record.active).length
}

function slugify(value: string): string {
  return value
    .normalize('NFKD')
    .replace(/[\u0300-\u036F]/g, '')
    .trim()
    .toLowerCase()
    .replace(/['"]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '')
}

effect(() => {
  if (!dialogOpen() || slugTouched())
    return
  slug.set(slugify(name()))
})

function markSlugTouched(): void {
  slugTouched.set(true)
}

function normalizeSlug(): void {
  const normalized = slugify(slug())
  if (normalized !== slug())
    slug.set(normalized)
}

async function loadRecords(): Promise<void> {
  loading.set(true)
  loadError.set('')
  try {
    const data = await dashboardApi<Record<string, unknown>>(`/api/dashboard/${resource()}`)
    const rows = data[resource()]
    if (!Array.isArray(rows))
      throw new TypeError(`${title()} were not returned in the expected shape.`)
    records.set(rows.map(normalize))
  }
  catch (error) {
    loadError.set(error instanceof Error ? error.message : String(error))
    pushToast('error', `Could not load ${resource()}`, { detail: loadError() })
  }
  finally {
    loading.set(false)
  }
}

function openCreate(): void {
  name.set('')
  slug.set('')
  taxonomyDescription.set('')
  slugTouched.set(false)
  saveError.set('')
  dialogOpen.set(true)
}

function closeCreate(): void {
  if (!saving())
    dialogOpen.set(false)
}

async function createRecord(): Promise<void> {
  saving.set(true)
  saveError.set('')
  try {
    await dashboardApi(`/api/dashboard/${resource()}`, {
      method: 'POST',
      body: {
        name: name().trim(),
        slug: slugify(slug()),
        description: taxonomyDescription().trim(),
      },
    })
    dialogOpen.set(false)
    pushToast('success', `${singular().replace(/^\w/, letter => letter.toUpperCase())} created`)
    await loadRecords()
  }
  catch (error) {
    saveError.set(error instanceof Error ? error.message : String(error))
  }
  finally {
    saving.set(false)
  }
}

function openDelete(record: TaxonomyRecord): void {
  deletingRecord.set(record)
  deleteError.set('')
}

function closeDelete(): void {
  if (!deleting())
    deletingRecord.set(null)
}

async function deleteRecord(): Promise<void> {
  const record = deletingRecord()
  if (!record)
    return
  deleting.set(true)
  deleteError.set('')
  try {
    await dashboardApi(`/api/dashboard/${resource()}/${record.id}`, { method: 'DELETE' })
    deletingRecord.set(null)
    pushToast('success', `${singular().replace(/^\w/, letter => letter.toUpperCase())} deleted`)
    await loadRecords()
  }
  catch (error) {
    deleteError.set(error instanceof Error ? error.message : String(error))
  }
  finally {
    deleting.set(false)
  }
}

onMount(() => {
  void loadRecords()
})
</script>

<div class="min-w-0 max-w-full space-y-6">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="font-semibold text-blue-600 text-xs tracking-wide uppercase dark:text-blue-400">CMS</p>
      <h1 class="mt-1 font-bold text-2xl text-gray-900 dark:text-white">{{ title() }}</h1>
      <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">{{ description() }}</p>
    </div>
    <div class="flex gap-2">
      <Button :loading="loading()" variant="secondary" @click="loadRecords()"><span :if="!loading()" aria-hidden="true" class="h-4 w-4 i-hugeicons-refresh"></span>Refresh</Button>
      <Button @click="openCreate()"><span aria-hidden="true" class="h-4 w-4 i-hugeicons-add-01"></span>New {{ singular() }}</Button>
    </div>
  </header>

  <div :if="loadError()" role="alert" class="flex gap-4 items-center justify-between p-4 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900"><span>{{ loadError() }}</span><Button variant="secondary" size="sm" @click="loadRecords()">Retry</Button></div>

  <section :aria-label="title() + ' metrics'" class="grid gap-3 sm:grid-cols-3">
    <article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700"><p class="text-gray-500 text-xs dark:text-neutral-400">Total</p><p class="mt-2 font-semibold text-2xl text-gray-900 dark:text-white">{{ records().length }}</p></article>
    <article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700"><p class="text-gray-500 text-xs dark:text-neutral-400">{{ secondaryMetricLabel() }}</p><p class="mt-2 font-semibold text-2xl text-gray-900 dark:text-white">{{ secondaryMetric() }}</p></article>
    <article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700"><p class="text-gray-500 text-xs dark:text-neutral-400">Newest</p><p class="mt-2 font-semibold text-gray-900 text-lg truncate dark:text-white">{{ records()[0]?.name || 'None' }}</p></article>
  </section>

  <section class="overflow-hidden min-w-0 max-w-full bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
    <div class="p-4 border-b border-gray-200 dark:border-neutral-700"><label><span class="sr-only">Search {{ resource() }}</span><input x-model="search" type="search" :placeholder="'Search ' + resource()" class="px-3 py-2 max-w-md w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" /></label></div>
    <div class="overflow-x-auto max-w-full w-full">
      <table class="min-w-full divide-gray-200 divide-y dark:divide-neutral-700">
        <thead class="bg-gray-50 dark:bg-neutral-900/50"><tr><th class="px-4 py-3 font-semibold text-gray-600 text-left text-xs dark:text-neutral-300">Name</th><th class="px-4 py-3 font-semibold text-gray-600 text-left text-xs dark:text-neutral-300">Slug</th><th class="px-4 py-3 font-semibold text-gray-600 text-left text-xs dark:text-neutral-300">Description</th><th class="px-4 py-3 font-semibold text-gray-600 text-left text-xs dark:text-neutral-300">{{ resource() === 'tags' ? 'Posts' : 'Status' }}</th><th class="px-4 py-3"><span class="sr-only">Actions</span></th></tr></thead>
        <tbody class="divide-gray-200 divide-y dark:divide-neutral-700">
          <template :if="loading()"><tr><td colspan="5" class="px-4 py-12 text-center text-gray-500 text-sm dark:text-neutral-400"><span class="inline-block mr-2 h-4 w-4 animate-spin i-hugeicons-loading-03"></span>Loading {{ resource() }}</td></tr></template>
          <template :else-if="visibleRecords().length === 0"><tr><td colspan="5" class="px-4 py-14 text-center"><span class="inline-block h-6 w-6 text-gray-400 i-hugeicons-tags"></span><p class="mt-2 font-medium text-gray-900 text-sm dark:text-white">No {{ resource() }} found</p><p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Adjust the search or create a {{ singular() }}.</p></td></tr></template>
          <template :else><template :for="record in visibleRecords()"><tr><td class="px-4 py-3 font-medium text-gray-900 text-sm dark:text-white">{{ record.name }}</td><td class="px-4 py-3 font-mono text-gray-500 text-sm dark:text-neutral-400">{{ record.slug }}</td><td class="px-4 py-3 max-w-md text-gray-500 text-sm truncate dark:text-neutral-400">{{ record.description || 'No description' }}</td><td class="px-4 py-3 text-gray-500 text-sm dark:text-neutral-400">{{ resource() === 'tags' ? record.postCount : record.active ? 'Active' : 'Inactive' }}</td><td class="px-4 py-3 text-right"><Button variant="ghost" size="sm" iconOnly :ariaLabel="'Delete ' + singular() + ' ' + record.name" @click="openDelete(record)"><span class="block h-4 w-4 text-red-500 i-hugeicons-delete-02"></span></Button></td></tr></template></template>
        </tbody>
      </table>
    </div>
  </section>
</div>

<div :if="dialogOpen()" class="flex fixed inset-y-0 right-0 z-[55] items-center justify-center p-4 dashboard-modal-layer">
  <button type="button" aria-label="Close taxonomy dialog" class="absolute inset-0 bg-black/45" @click="closeCreate()"></button>
  <section role="dialog" aria-modal="true" :aria-label="'New ' + singular()" class="relative max-w-lg w-full bg-white dark:bg-neutral-800 border border-gray-200 rounded-xl dark:border-neutral-700 shadow-xl">
    <form @submit.prevent="createRecord()">
      <div class="p-6"><h2 class="font-semibold text-gray-900 text-lg dark:text-white">New {{ singular() }}</h2><div :if="saveError()" role="alert" class="mt-4 p-3 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">{{ saveError() }}</div><div class="grid gap-4 mt-5"><label><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Name</span><input x-model="name" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" /></label><label><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Slug</span><input x-model="slug" required class="mt-1 px-3 py-2 w-full font-mono text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @input="markSlugTouched" @blur="normalizeSlug" /></label><label><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Description</span><textarea x-model="taxonomyDescription" rows="3" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700"></textarea></label></div></div>
      <footer class="flex gap-2 justify-end px-6 py-4 bg-gray-50 dark:bg-neutral-900/50 border-gray-200 border-t dark:border-neutral-700"><Button :disabled="saving()" variant="secondary" @click="closeCreate()">Cancel</Button><Button type="submit" :disabled="saving() || !name().trim() || !slug().trim()" :loading="saving()">Create {{ singular() }}</Button></footer>
    </form>
  </section>
</div>

<div :if="Boolean(deletingRecord())" class="flex fixed inset-y-0 right-0 z-[55] items-center justify-center p-4 dashboard-modal-layer">
  <button type="button" aria-label="Close delete taxonomy dialog" class="absolute inset-0 bg-black/45" @click="closeDelete()"></button>
  <section role="dialog" aria-modal="true" :aria-label="'Delete ' + singular() + '?'" class="relative p-6 max-w-md w-full bg-white dark:bg-neutral-800 border border-gray-200 rounded-xl dark:border-neutral-700 shadow-xl"><h2 class="font-semibold text-gray-900 text-lg dark:text-white">Delete {{ singular() }}?</h2><p class="mt-2 text-gray-500 text-sm dark:text-neutral-400"><strong>{{ deletingRecord()?.name || '' }}</strong> will be permanently removed.</p><div :if="deleteError()" role="alert" class="mt-4 p-3 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">{{ deleteError() }}</div><div class="flex gap-2 justify-end mt-6"><Button :disabled="deleting()" variant="secondary" @click="closeDelete()">Cancel</Button><Button :loading="deleting()" variant="danger" @click="deleteRecord()">Delete {{ singular() }}</Button></div></section>
</div>
