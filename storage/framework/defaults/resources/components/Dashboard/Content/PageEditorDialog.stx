<script client>
interface PageRecord {
  id: string
  title: string
  template: string
  publishedAt: string
}

interface PageDraft {
  title: string
  template: string
  published: boolean
}

const open = useReactiveProp('open', false)
const page = useReactiveProp('page', null as PageRecord | null)
const busy = useReactiveProp('busy', false)
const error = useReactiveProp('error', '')
// Not `title`: a field bound inside the Modal is first read as the Modal's own
// `title` prop (stacksjs/stacks#3310).
const pageTitle = state('')
const template = state('default')
const published = state(false)
const emit = defineEmits(['close', 'submit'])
let wasOpen = false

effect(() => {
  const isOpen = open()
  if (isOpen && !wasOpen) {
    const record = page()
    pageTitle.set(record?.title || '')
    template.set(record?.template || 'default')
    published.set(Boolean(record?.publishedAt))
  }
  wasOpen = isOpen
})

function close(): void {
  if (!busy())
    emit('close')
}

function submit(): void {
  const draft: PageDraft = {
    title: pageTitle().trim(),
    template: template(),
    published: published(),
  }
  emit('submit', draft)
}
</script>

<Modal
  :isOpen="open()"
  :title="page() ? 'Edit page' : 'New page'"
  description="Configure the page template and publishing state."
  :closable="!busy()"
  @close="close"
>
  <form id="page-editor-form" class="grid gap-4" @submit.prevent="submit">
    <Input v-model:value="pageTitle" name="title" label="Title" :required="true" :minLength="3" :maxLength="255" />
    <Select v-model:value="template" name="template" label="Template" placeholder="" :options="[{ value: 'default', label: 'Default' }, { value: 'landing', label: 'Landing' }, { value: 'blog', label: 'Blog' }, { value: 'contact', label: 'Contact' }]" />
    <div class="p-3 bg-gray-50 dark:bg-neutral-900/50 border border-gray-200 rounded-lg dark:border-neutral-700">
      <Toggle v-model:checked="published" name="published" label="Published" description="Published pages receive a timestamp. Clearing this returns the page to draft." labelPosition="left" />
    </div>
  </form>

  <div :if="error()" role="alert" class="mt-4 p-3 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">
    {{ error() }}
  </div>

  <template #footer>
    <div class="flex gap-2 justify-end w-full">
      <Button :disabled="busy()" variant="secondary" @click="close">Cancel</Button>
      <Button type="submit" form="page-editor-form" :disabled="pageTitle().trim().length < 3" :loading="busy()">
        {{ page() ? 'Save changes' : 'Create page' }}
      </Button>
    </div>
  </template>
</Modal>
