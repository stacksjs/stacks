<script client>
import type { ConfigField, EditorMode } from '@stacksjs/defaults/views/dashboard/composables/useProjectConfigEditor'
import { useProjectConfigEditor } from '@stacksjs/defaults/views/dashboard/composables/useProjectConfigEditor'

const { files, current, drafts, sourceDraft, selected, mode, setMode, loading, saving, message, error, isDirty, setDocument, loadFiles, selectFile, save, initialize } = useProjectConfigEditor

const pending = state<{ file: string } | { mode: EditorMode } | null>(null)
const fileQuery = state('')
const fieldQuery = state('')
const fieldLimit = state(40)
const pickerOpen = state(false)
const pickerButton = useRef<HTMLButtonElement>('configPickerButton')

const filteredFiles = derived(() => {
  const needle = fileQuery().trim().toLowerCase()
  return files().filter(file => file.name.toLowerCase().includes(needle) || file.title.toLowerCase().includes(needle))
})
const selectedFile = derived(() => files().find(file => file.name === selected()))
const filteredFields = derived(() => {
  const needle = fieldQuery().trim().toLowerCase()
  return (current()?.fields ?? []).filter(field => field.key.toLowerCase().includes(needle))
})
const visibleFields = derived(() => filteredFields().slice(0, fieldLimit()))

function closePicker(): void {
  pickerOpen.set(false)
  pickerButton.current?.focus()
  fileQuery.set('')
}

function closePickerOnEscape(event: KeyboardEvent): void {
  if (pickerOpen() && event.key === 'Escape') {
    event.preventDefault()
    closePicker()
  }
}

function openFile(name: string): Promise<void> {
  fieldQuery.set('')
  fieldLimit.set(40)
  return selectFile(name)
}

function requestFile(name: string): void {
  if (loading() || saving())
    return
  closePicker()
  if (name === selected())
    return
  if (current() && isDirty())
    pending.set({ file: name })
  else
    void openFile(name)
}

function requestMode(next: EditorMode): void {
  if (saving() || next === mode())
    return
  if (isDirty())
    pending.set({ mode: next })
  else
    setMode(next)
}

function discardAndContinue(): void {
  const destination = pending()
  pending.set(null)
  if (!destination)
    return
  if ('file' in destination) {
    void openFile(destination.file)
    return
  }
  const loaded = current()
  if (loaded) {
    setDocument(loaded)
    setMode(destination.mode)
    error.set('')
  }
}

function handleBeforeUnload(event: BeforeUnloadEvent): void {
  if (current() && isDirty()) {
    event.preventDefault()
    event.returnValue = ''
  }
}

function fieldInputType(field: ConfigField): string {
  if (field.type === 'number')
    return 'number'
  return /password|secret|api[-_]?key|private[-_]?key|access[-_]?token/i.test(field.key) ? 'password' : 'text'
}

useEventListener('beforeunload', handleBeforeUnload)
onMount(initialize)
</script>

<template>
<div class="dashboard-settings-stack">
  <div :if="files().length > 0">
    <SettingsGroup>
      <div class="dashboard-settings-config-picker" @keydown="closePickerOnEscape($event)">
        <button type="button" class="dashboard-settings-config-trigger" ref="configPickerButton"
          aria-controls="project-config-files" :aria-expanded="String(pickerOpen())"
          @click="pickerOpen() ? closePicker() : pickerOpen.set(true)">
          <span>Configuration file</span>
          <span class="dashboard-settings-config-selection">
            <span :text="selectedFile()?.title"></span>
            <span class="i-f7-chevron-down" aria-hidden="true"></span>
          </span>
        </button>
        <div :if="pickerOpen()" id="project-config-files">
          <div class="pt-2 px-2">
            <SearchFilter v-model:searchValue="fileQuery" placeholder="Search config files" ariaLabel="Search config files" />
          </div>

          <nav class="overflow-y-auto p-2 max-h-64" aria-label="Configuration files">
            <button :for="file in filteredFiles()" type="button"
              :aria-pressed="String(selected() === file.name)"
              :disabled="saving() || loading()"
              class="w-full dashboard-settings-nav-item"
              @click="requestFile(file.name)">
              <span class="flex-1 min-w-0 text-left truncate" :text="file.title"></span>
              <span class="max-w-[50%] font-mono text-xs truncate opacity-75" :text="file.name + '.ts'"></span>
            </button>
            <p :if="filteredFiles().length === 0" class="p-3 text-neutral-500 text-sm" role="status">No matching config files.</p>
          </nav>
        </div>
      </div>
    </SettingsGroup>
  </div>

  <p :if="loading()" class="p-6 text-neutral-500 text-sm dark:text-neutral-400" role="status">Loading configuration…</p>
  <div :if="error()" class="text-red-700 text-sm dark:text-red-400" role="alert">
    <p :text="error()"></p>
    <Button :if="!current() && !loading()" variant="secondary" size="sm" @click="selected() ? selectFile(selected()) : loadFiles()">Retry</Button>
    <Button :if="current() && isDirty()" variant="secondary" size="sm" @click="pending.set({ file: selected() })">Reopen file</Button>
  </div>
  <p :if="!loading() && !error() && files().length === 0" class="p-6 text-neutral-500 text-sm dark:text-neutral-400">No TypeScript files were found in config/.</p>
  <p :if="message()" class="text-green-700 text-sm dark:text-green-400" role="status" :text="message()"></p>

  <div :if="current()" class="min-w-0">
    <SettingsGroup>
      <form @submit.prevent="save()">
        <div class="flex flex-wrap gap-2 items-center justify-between px-4 py-3">
          <h2 class="min-w-0 break-all font-medium font-mono text-sm" :text="'config/' + selected() + '.ts'"></h2>
          <div class="flex flex-wrap gap-2 items-center" role="group" aria-label="Configuration editor">
            <button type="button" class="dashboard-config-mode" :aria-pressed="String(mode() === 'fields')" :disabled="saving()" @click="requestMode('fields')">Fields</button>
            <button type="button" class="dashboard-config-mode" :aria-pressed="String(mode() === 'source')" :disabled="saving()" @click="requestMode('source')">TypeScript</button>
            <Button type="submit" size="sm" :loading="saving()" :disabled="saving() || !isDirty()">Save changes</Button>
          </div>
        </div>

        <div :if="mode() === 'source'" class="flex flex-col gap-2 p-4 pt-0">
          <p :if="current()?.diagnostic" class="text-amber-700 text-sm dark:text-amber-300" :text="current()?.diagnostic"></p>
          <p class="text-neutral-500 text-sm dark:text-neutral-400">Edit expressions, environment bindings, and the structure of this file.</p>
          <CodeEditor v-model:value="sourceDraft" language="typescript" :label="'config/' + selected() + '.ts'" :readonly="saving()" @save="save()" />
        </div>

        <div :if="mode() === 'fields'" class="min-w-0">
          <div class="pb-3 px-4 text-neutral-500 text-sm dark:text-neutral-400">
            <p>For computed values, environment bindings, or new keys, open TypeScript.</p>
            <div :if="(current()?.fields.length ?? 0) > 0" class="mt-3">
              <SearchFilter v-model:searchValue="fieldQuery" placeholder="Filter fields" ariaLabel="Filter configuration fields" />
            </div>
          </div>
          <p :if="visibleFields().length === 0" class="pb-4 px-4 text-neutral-500 text-sm dark:text-neutral-400">No matching literal fields.</p>

          <div :for="(field, index) in visibleFields()" class="dashboard-config-field" :data-config-type="field.type">
            @if(field.type === 'boolean')
              <Toggle v-model:checked="drafts[field.key]" :label="field.key" :ariaLabel="field.key" labelPosition="left" :disabled="saving()" />
            @elseif(field.type === 'null')
              <span class="break-all text-sm" :text="field.key"></span>
              <span class="text-neutral-500 text-sm dark:text-neutral-400">Null · edit in TypeScript</span>
            @else
              <label :for="'dashboard-config-field-' + index" class="break-all text-sm" :text="field.key"></label>
              @if(field.type === 'number')
                <input :id="'dashboard-config-field-' + index" data-dashboard-field type="number" step="any" required
                  class="dashboard-config-input" x-model.number="drafts[field.key]" :disabled="saving()">
              @else
                <input :id="'dashboard-config-field-' + index" data-dashboard-field :type="fieldInputType(field)" autocomplete="off"
                  class="dashboard-config-input" x-model="drafts[field.key]" :disabled="saving()">
              @endif
            @endif
          </div>
          <div :if="filteredFields().length > fieldLimit()" class="p-3">
            <Button variant="secondary" size="sm" @click="fieldLimit.update(limit => limit + 40)">Show more fields</Button>
          </div>
        </div>
      </form>
    </SettingsGroup>
  </div>

  <ConfirmDialog :isOpen="Boolean(pending())" title="Discard unsaved changes?"
    description="Your changes to this configuration file will be lost."
    confirmLabel="Discard changes" variant="warning" @close="pending.set(null)" @confirm="discardAndContinue" />
</div>
</template>
