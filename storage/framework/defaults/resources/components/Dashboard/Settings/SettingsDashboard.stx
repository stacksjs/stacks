<script server>
import type { ProjectConfigSection } from '@stacksjs/defaults/resources/functions/dashboard/project-config-sections'

const { section } = defineProps<{ section?: ProjectConfigSection }>()
export const configSectionId = section ?? 'general'
defineClientPayload({ configSectionId })
</script>

<script client>
import type { ConfigField, EditorMode } from '@stacksjs/defaults/views/dashboard/composables/useProjectConfigEditor'
import { configLabel, projectConfigSection } from '@stacksjs/defaults/resources/functions/dashboard/project-config-sections'
import { confirmSettingsDiscard } from '@stacksjs/defaults/views/dashboard/composables/settings-dialog'
import { projectConfigEditor, rememberProjectConfigFile, requestedProjectConfigFile } from '@stacksjs/defaults/views/dashboard/composables/useProjectConfigEditor'

const configSection = projectConfigSection({{ configSectionId }})
const { files, current, drafts, sourceDraft, selected, mode, setMode, loading, saving, message, error, isDirty, setDocument, selectFile, save, initialize } = projectConfigEditor({{ configSectionId }})

const pending = state<'reload' | EditorMode | null>(null)
const confirming = state(false)
const visibleMode = state<EditorMode>('fields')
const fieldQuery = state('')
const fieldLimit = state(40)
const dnsFile = derived(() => selected() === 'dns')

const fileOptions = derived(() => files().map(file => ({ value: file.name, label: file.title })))
const editorModes = derived(() => [
  { value: 'fields', label: dnsFile() ? 'Records' : 'Fields' },
  { value: 'source', label: 'TypeScript' },
])
const selectedFile = derived(() => files().find(file => file.name === selected()))
const discardTitle = 'Discard unsaved changes?'
const discardDescription = 'Your changes to this configuration file will be lost.'
effect(() => visibleMode.set(mode()))

function displayPart(part: string | number): string {
  return typeof part === 'number' ? `Item ${part + 1}` : configLabel(part)
}

const fields = derived(() => (current()?.fields ?? []).map((field) => {
  const labels = field.path.map(displayPart)
  const label = labels.at(-1) ?? 'Value'
  return { ...field, label, group: JSON.stringify(field.path.slice(0, -1)), heading: labels.slice(0, -1).join(' › '), accessibleLabel: labels.join(' › ') || label }
}))
const filteredFields = derived(() => {
  const needle = fieldQuery().trim().toLowerCase()
  return fields().filter(field => `${field.key} ${field.accessibleLabel} ${field.description ?? ''}`.toLowerCase().includes(needle))
})
const displayRows = derived(() => {
  const groups = new Map<string, ReturnType<typeof filteredFields>>()
  for (const field of filteredFields()) {
    const group = groups.get(field.group)
    if (group)
      group.push(field)
    else
      groups.set(field.group, [field])
  }
  let remaining = fieldLimit()
  return [...groups.values()].flatMap((group) => {
    const chosen = group.slice(0, remaining)
    remaining -= chosen.length
    return chosen.map((field, index) => ({
      ...field,
      sectionHeading: index === 0 && groups.size > 1 ? field.heading || 'General' : '',
    }))
  })
})

function openFile(name: string, reload = false): Promise<void> {
  if (name !== selected()) {
    fieldQuery.set('')
    fieldLimit.set(40)
    rememberProjectConfigFile(name)
  }
  return selectFile(name, { reload })
}

function requestMode(next: EditorMode): void {
  if (saving() || next === mode())
    return
  if (isDirty()) {
    visibleMode.set(mode())
    void requestDiscard(next)
  }
  else {
    setMode(next)
  }
}

async function requestDiscard(destination: 'reload' | EditorMode): Promise<void> {
  if (confirming() || pending())
    return
  const file = selected()
  confirming.set(true)
  try {
    const confirmed = await confirmSettingsDiscard(discardTitle, discardDescription, 'Discard Changes')
    if (selected() !== file || saving())
      return
    if (confirmed === null)
      pending.set(destination)
    else if (confirmed)
      discardAndContinue(destination)
  }
  finally {
    confirming.set(false)
  }
}

function discardAndContinue(destination = pending()): void {
  pending.set(null)
  if (destination === 'reload') {
    void openFile(selected(), true)
    return
  }
  const loaded = current()
  if (destination && loaded) {
    setDocument(loaded)
    setMode(destination)
    error.set('')
  }
}

function fieldInputType(field: ConfigField): string {
  return /password|secret|api[-_]?key|private[-_]?key|access[-_]?token/i.test(field.key) ? 'password' : 'text'
}

function loadSection(): Promise<void> {
  return initialize(requestedProjectConfigFile())
}

onMount(loadSection)
useEventListener('stx:load', loadSection)
useEventListener('keydown', (event: KeyboardEvent) => {
  if (!event.defaultPrevented && (event.metaKey || event.ctrlKey) && !event.altKey && !event.shiftKey && event.key.toLowerCase() === 's') {
    event.preventDefault()
    if (!confirming() && !pending())
      void save()
  }
})
</script>

<template>
<div class="dashboard-settings-stack">
  <p class="dashboard-config-intro" :text="configSection?.description"></p>

  <div :if="files().length > 1">
    <SettingsGroup>
      <SettingsRow label="Configuration file">
        <SettingsPicker :options="fileOptions()" :value="selected()" ariaLabel="Configuration file"
          :disabled="saving() || confirming()" @change="openFile($event)" />
      </SettingsRow>
    </SettingsGroup>
  </div>

  <p :if="loading()" class="dashboard-config-intro" role="status">Loading configuration…</p>
  <div :if="error()" class="text-red-700 text-sm dark:text-red-400" role="alert">
    <p :text="error()"></p>
    <Button :if="!current() && !loading()" variant="secondary" size="sm" @click="selected() ? openFile(selected(), true) : loadSection()">Retry</Button>
    <Button :if="current() && isDirty()" variant="secondary" size="sm" @click="requestDiscard('reload')">Reopen file</Button>
  </div>
  <p :if="!loading() && !error() && files().length === 0" class="dashboard-config-intro">This project has no configuration files in this section.</p>
  <p :if="message()" class="text-green-700 text-sm dark:text-green-400" role="status" :text="message()"></p>

  <div :if="current()" class="min-w-0">
    <SettingsGroup>
      <form @submit.prevent="save()">
        <div class="dashboard-config-header">
          <div class="min-w-0">
            <h2 :text="selectedFile()?.title"></h2>
            <p class="dashboard-config-path" data-config-path :text="'config/' + selected() + '.ts'"></p>
          </div>
          <div class="flex flex-wrap gap-2 items-center">
            <SegmentedControl v-model:value="visibleMode" :options="editorModes()" label="Configuration editor" variant="mac"
              :disabled="saving() || confirming()" @change="requestMode($event)" />
            <Button :if="!dnsFile() || mode() === 'source'" type="submit" size="sm" :loading="saving()" :disabled="saving() || !isDirty()">Save changes</Button>
          </div>
        </div>

        <div :if="mode() === 'source'" class="flex flex-col gap-2 p-4 pt-0">
          <p :if="current()?.diagnostic" class="text-amber-700 text-sm dark:text-amber-300" :text="current()?.diagnostic"></p>
          <SettingsCodeEditor v-model:value="sourceDraft" language="typescript" :label="'config/' + selected() + '.ts'" :readonly="saving()" @save="save()" />
        </div>

        <div :if="mode() === 'fields' && !dnsFile()" class="min-w-0">
          <div class="dashboard-config-field-tools">
            <p class="dashboard-config-intro">Use TypeScript for expressions, environment bindings, and new keys.</p>
            <div :if="fields().length > 6">
              <SearchFilter v-model:searchValue="fieldQuery" placeholder="Filter fields" ariaLabel="Filter configuration fields" />
            </div>
          </div>
          <p :if="displayRows().length === 0" class="pb-4 px-4 text-neutral-500 text-sm dark:text-neutral-400"
            :text="fieldQuery() ? 'No matching fields' : 'Open TypeScript to edit this file.'"></p>

          <div :for="(field, index) in displayRows()" :key="field.key">
            <h3 :if="field.sectionHeading" class="dashboard-config-subheading" :text="field.sectionHeading"></h3>
            @if(field.type === 'boolean')
            <SettingsRow :label="field.label" :description="field.description">
              <Switch v-model:checked="drafts[field.key]" variant="mac" :disabled="saving()" />
            </SettingsRow>
            @else
            <div class="dashboard-config-field" :data-config-type="field.type">
              @if(field.type === 'null')
                <span class="dashboard-config-field-label" :title="field.key" :text="field.label"></span>
                <span class="dashboard-config-intro">Unset</span>
              @else
                <div class="min-w-0">
                  <label :for="'dashboard-config-field-' + index" class="dashboard-config-field-label" :title="field.key" :text="field.label"></label>
                  <p :if="field.description" :id="'dashboard-config-help-' + index" class="dashboard-config-field-description" :text="field.description"></p>
                </div>
                @if(field.type === 'number')
                  <input :id="'dashboard-config-field-' + index" data-dashboard-field type="number" step="any" required
                    :aria-describedby="field.description ? 'dashboard-config-help-' + index : null"
                    class="dashboard-config-input" x-model="drafts[field.key]" :disabled="saving()">
                @else
                  <input :id="'dashboard-config-field-' + index" data-dashboard-field :type="fieldInputType(field)" autocomplete="off"
                    :aria-describedby="field.description ? 'dashboard-config-help-' + index : null"
                    class="dashboard-config-input" x-model="drafts[field.key]" :disabled="saving()">
                @endif
              @endif
            </div>
            @endif
          </div>
          <div :if="filteredFields().length > fieldLimit()" class="p-3">
            <Button variant="secondary" size="sm" @click="fieldLimit.update(limit => limit + 40)">Show more fields</Button>
          </div>
        </div>
      </form>
      <div :if="dnsFile() && mode() === 'fields'">
        <DnsRecordsSettings @saved="setDocument($event)" />
      </div>
    </SettingsGroup>
  </div>

  <ConfirmDialog :isOpen="Boolean(pending())" :title="discardTitle" :description="discardDescription"
    confirmLabel="Discard Changes" variant="warning" @close="pending.set(null)" @confirm="discardAndContinue()" />
</div>
</template>
