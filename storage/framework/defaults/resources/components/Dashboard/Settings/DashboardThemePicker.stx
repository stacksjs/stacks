<script client>
import type { DashboardTheme } from '@stacksjs/defaults/views/dashboard/composables/dashboard-themes'
import {
  BUNDLED_DASHBOARD_THEMES,
  dashboardThemeColor,
  MAX_THEME_FILE_SIZE,
  ORIGINAL_DASHBOARD_THEME,
  SYSTEM_CLEANER_THEME,
} from '@stacksjs/defaults/views/dashboard/composables/dashboard-themes'
import { useDashboardThemes } from '@stacksjs/defaults/views/dashboard/composables/useDashboardThemes'

const themes = useDashboardThemes()
const active = themes.active
const installed = themes.installed
const themeFile = useRef('dashboardThemeFile')
const feedback = state('')
const failure = state('')

const themesToShow = derived(() => [
  {
    id: ORIGINAL_DASHBOARD_THEME,
    name: 'The Original',
    description: 'The classic Stacks dashboard with your choice of sidebar style.',
    preview: '',
    overview: 'panel',
  },
  ...[...BUNDLED_DASHBOARD_THEMES, ...installed()].map(theme => ({
    id: theme.id,
    name: theme.name,
    description: theme.description ?? '',
    preview: previewStyle(theme),
    overview: theme.overview,
  })),
])

const selectedInstallation = derived(() => installed().find(theme => theme.id === active()))
const downloadable = derived(() => selectedInstallation() || {
  ...SYSTEM_CLEANER_THEME,
  id: 'my-dashboard',
  name: 'My Dashboard',
})

function previewStyle(theme: DashboardTheme): string {
  return [
    `--preview-window:${dashboardThemeColor(theme, 'window')}`,
    `--preview-canvas:${dashboardThemeColor(theme, 'canvas')}`,
    `--preview-surface:${dashboardThemeColor(theme, 'surface')}`,
    `--preview-accent:${dashboardThemeColor(theme, 'accentFill')}`,
    `--preview-hero-start:${dashboardThemeColor(theme, 'heroStart')}`,
    `--preview-hero-end:${dashboardThemeColor(theme, 'heroEnd')}`,
    `--preview-gap:${theme.layout === 'inset' ? '4px' : '0'}`,
  ].join(';')
}

function downloadHref(): string {
  return `data:application/json;charset=utf-8,${encodeURIComponent(JSON.stringify(downloadable(), null, 2))}`
}

function selectTheme(id: string): void {
  feedback.set('')
  failure.set('')
  try {
    themes.select(id)
  }
  catch (error) {
    failure.set((error as Error).message)
  }
}

async function importTheme(event: Event): Promise<void> {
  const input = event.currentTarget as HTMLInputElement
  const file = input.files?.[0]
  if (!file)
    return
  input.value = ''
  feedback.set('')
  failure.set('')
  try {
    if (file.size > MAX_THEME_FILE_SIZE)
      throw new Error('Choose a theme JSON file smaller than 16 KB.')
    let manifest: unknown
    try {
      manifest = JSON.parse(await file.text())
    }
    catch {
      throw new Error('Choose a valid theme JSON file.')
    }
    const name = themes.install(manifest)
    feedback.set(`${name} is installed and active.`)
  }
  catch (error) {
    failure.set((error as Error).message)
  }
}

function removeTheme(): void {
  const theme = selectedInstallation()
  if (!theme)
    return
  feedback.set('')
  failure.set('')
  try {
    themes.remove(theme.id)
    feedback.set(`${theme.name} was removed. The Original is active.`)
  }
  catch (error) {
    failure.set((error as Error).message)
  }
}
</script>

<style>
.dashboard-theme-choice {
  border-color: var(--dashboard-border, light-dark(#e7e5e4, #ffffff24));
  background: var(--dashboard-surface, light-dark(#fff, #262626));
}
.dashboard-theme-choice:hover {
  background: var(--dashboard-surface-muted, light-dark(#fafaf9, #333));
}
.dashboard-theme-choice[aria-pressed="true"] {
  border-color: var(--dashboard-accent, light-dark(#2563eb, #60a5fa));
  box-shadow: 0 0 0 1px var(--dashboard-accent, light-dark(#2563eb, #60a5fa));
}
.dashboard-theme-choice:focus-visible {
  outline: 2px solid var(--dashboard-accent, light-dark(#2563eb, #60a5fa));
  outline-offset: 3px;
}
.dashboard-theme-preview {
  color-scheme: light;
  height: 5.25rem;
  background: var(--preview-window, light-dark(#e7e7ec, #1c1c1e));
  box-shadow: inset 0 0 0 1px rgb(127 127 127 / .18);
}
.dark .dashboard-theme-preview {
  color-scheme: dark;
}
.dashboard-theme-preview[data-overview="immersive"] {
  background: linear-gradient(155deg, var(--preview-hero-start), var(--preview-hero-end));
}
.dashboard-theme-preview[data-overview="immersive"] .dashboard-theme-preview-page {
  background: transparent;
}
.dashboard-theme-preview[data-overview="immersive"] .dashboard-theme-preview-page > span {
  background: rgb(255 255 255 / .15);
}
.dashboard-theme-preview-nav {
  width: 30%;
  display: grid;
  align-content: start;
  gap: 4px;
  padding: 9px 5px;
}
.dashboard-theme-preview-nav > span {
  height: 5px;
  border-radius: 2px;
  background: rgb(127 127 127 / .25);
}
.dashboard-theme-preview-nav > span:first-child {
  background: var(--preview-accent, #007aff);
}
.dashboard-theme-preview-page {
  display: grid;
  flex: 1;
  grid-template: 2fr 1fr / repeat(3, 1fr);
  gap: 4px;
  padding: 7px;
  margin: var(--preview-gap, 0) var(--preview-gap, 0) var(--preview-gap, 0) 0;
  border-radius: var(--preview-gap, 0);
  background: var(--preview-canvas, light-dark(#f6f6f9, #121318));
}
.dashboard-theme-preview-page > span {
  border-radius: 3px;
  background: var(--preview-surface, light-dark(#fff, #27272a));
}
.dashboard-theme-preview-page > span:first-child {
  grid-column: 1 / -1;
  background: linear-gradient(155deg, var(--preview-hero-start, light-dark(#e4e4eb, #2d2e36)), var(--preview-hero-end, light-dark(#ececf1, #23242b)));
}
</style>

<template>
<Card variant="default" padding="none">
  <div class="px-6 py-5 border-b border-neutral-200/60 dark:border-white/5">
    <h2 class="font-semibold text-lg text-neutral-900 dark:text-white">Dashboard theme</h2>
    <p class="mt-1 text-neutral-500 text-sm dark:text-neutral-400">Choose a theme or install one from a JSON file.</p>
  </div>
  <div class="grid gap-4 sm:grid-cols-2 p-6" role="group" aria-label="Dashboard theme">
    <button
      :for="theme in themesToShow()"
      type="button"
      class="flex flex-col gap-2 p-3 text-left border rounded-xl dashboard-theme-choice"
      :data-theme-id="theme.id"
      :aria-pressed="String(active() === theme.id)"
      @click="selectTheme(theme.id)"
    >
      <span class="flex overflow-hidden w-full rounded-lg dashboard-theme-preview" :style="theme.preview" :data-overview="theme.overview" aria-hidden="true">
        <span class="dashboard-theme-preview-nav"><span></span><span></span><span></span></span>
        <span class="dashboard-theme-preview-page"><span></span><span></span><span></span><span></span></span>
      </span>
      <span class="font-medium text-neutral-900 text-sm dark:text-white" :text="theme.name"></span>
      <span :if="theme.description" class="text-neutral-500 text-xs dark:text-neutral-400" :text="theme.description"></span>
    </button>
  </div>
  <div class="pb-6 px-6">
    <div class="flex flex-wrap gap-2">
      <input ref="dashboardThemeFile" hidden type="file" accept=".json,application/json" @change="importTheme($event)" />
      <Button variant="secondary" size="sm" @click="themeFile.current?.click()">Install theme</Button>
      <Button tag="a" variant="outline" size="sm" :href="downloadHref()" :download="downloadable().id + '.json'">
        {{ selectedInstallation() ? 'Export theme' : 'Download starter theme' }}
      </Button>
      <Button :if="selectedInstallation()" variant="outline" size="sm" @click="removeTheme()">Remove theme</Button>
    </div>
    <p class="mt-3 text-neutral-500 text-xs dark:text-neutral-400">To build a theme, download the starter, edit its JSON, and install the file.</p>
    <p :if="feedback()" class="mt-2 text-neutral-700 text-sm dark:text-neutral-200" role="status" :text="feedback()"></p>
    <p :if="failure()" class="mt-2 text-red-700 text-sm dark:text-red-300" role="alert" :text="failure()"></p>
  </div>
</Card>
</template>
