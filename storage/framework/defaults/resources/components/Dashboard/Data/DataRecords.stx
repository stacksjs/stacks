@import('../UI/Table')

<script client>
import type {
  DashboardActivity,
  DashboardSubscriber,
  DashboardTeam,
  DashboardUser,
  DataMode,
  DataStats,
} from '../../../../functions/data'
import { fetchDashboardData } from '../../../../functions/data'

type DataRecord = DashboardActivity | DashboardSubscriber | DashboardTeam | DashboardUser

const mode = useReactiveProp<DataMode>('mode', 'activity')
const records = state<DataRecord[]>([])
const stats = state<DataStats>({ total: 0 })
const search = state('')
const loading = state(true)
const loadError = state('')

const metadata: Record<DataMode, { title: string, description: string, icon: string, empty: string }> = {
  activity: {
    title: 'Activity Log',
    description: 'Review the native application audit trail.',
    icon: 'i-hugeicons-activity-03',
    empty: 'No activity has been recorded.',
  },
  users: {
    title: 'Users',
    description: 'Review registered application users.',
    icon: 'i-hugeicons-user-group',
    empty: 'No users have registered.',
  },
  teams: {
    title: 'Teams',
    description: 'Review collaborative teams and membership totals.',
    icon: 'i-hugeicons-user-multiple-02',
    empty: 'No teams have been created.',
  },
  subscribers: {
    title: 'Subscribers',
    description: 'Review subscription status and acquisition sources.',
    icon: 'i-hugeicons-mail-account-01',
    empty: 'No subscribers have joined.',
  },
}

const page = derived(() => metadata[mode()])
const filteredRecords = derived(() => {
  const query = search().trim().toLowerCase()
  if (!query)
    return records()
  return records().filter(record => searchableText(record).includes(query))
})


function searchableText(record: DataRecord): string {
  return Object.values(record)
    .filter(value => typeof value === 'string' || typeof value === 'number')
    .join(' ')
    .toLowerCase()
}

function statValue(key: string): number {
  return Number(stats()[key] || 0)
}

function formatSubject(record: DashboardActivity): string {
  if (!record.subjectType)
    return 'Application'
  return record.subjectId > 0 ? `${record.subjectType} #${record.subjectId}` : record.subjectType
}

/** A status pill's colour: settled, ended, or still in progress. */
function statusTone(status: string): string {
  if (['active', 'subscribed', 'completed'].includes(status))
    return 'positive'
  if (['bounced', 'inactive', 'unsubscribed'].includes(status))
    return 'negative'
  return 'pending'
}

const TONES = {
  positive: 'text-green-700 dark:text-green-300 bg-green-50 dark:bg-green-950/40',
  negative: 'text-red-700 dark:text-red-300 bg-red-50 dark:bg-red-950/40',
  pending: 'text-amber-700 dark:text-amber-300 bg-amber-50 dark:bg-amber-950/40',
}

function capitalize(value: string): string {
  return value ? value.charAt(0).toUpperCase() + value.slice(1) : value
}

const recorded = (key: string, label: string) => ({ key, label, type: 'datetime' as const, align: 'right' as const, sortable: true, emptyText: 'Never', class: 'text-neutral-500 text-xs whitespace-nowrap dark:text-neutral-400' })
const statusColumn = { key: 'statusTone', label: 'Status', type: 'badge' as const, sortable: true, badgeLabelKey: 'statusLabel', badgeClasses: TONES }

const COLUMNS_BY_MODE = {
  activity: [
    { key: 'description', label: 'Activity', sortable: true, subtitleKey: 'type', class: 'font-medium text-neutral-900 dark:text-white' },
    { key: 'subject', label: 'Subject', sortable: true, class: 'text-neutral-600 dark:text-neutral-300' },
    { key: 'causer', label: 'Causer', sortable: true, class: 'text-neutral-600 dark:text-neutral-300' },
    recorded('createdAt', 'Recorded'),
  ],
  users: [
    { key: 'name', label: 'User', sortable: true, subtitleKey: 'email', class: 'font-medium text-neutral-900 dark:text-white' },
    { key: 'verificationTone', label: 'Verification', type: 'badge' as const, sortable: true, badgeLabelKey: 'verificationLabel', badgeClasses: TONES },
    recorded('updatedAt', 'Updated'),
    recorded('createdAt', 'Registered'),
  ],
  teams: [
    { key: 'name', label: 'Team', sortable: true, slotted: true },
    { key: 'memberCount', label: 'Members', type: 'number' as const, align: 'right' as const, sortable: true, class: 'font-mono text-neutral-700 dark:text-neutral-300' },
    statusColumn,
    recorded('createdAt', 'Created'),
  ],
  subscribers: [
    { key: 'email', label: 'Subscriber', sortable: true, class: 'font-medium text-neutral-900 dark:text-white' },
    { key: 'sourceLabel', label: 'Source', sortable: true, class: 'text-neutral-600 dark:text-neutral-300' },
    statusColumn,
    recorded('createdAt', 'Subscribed'),
  ],
}

const recordColumns = derived(() => COLUMNS_BY_MODE[mode()] ?? COLUMNS_BY_MODE.activity)

const recordRows = derived(() => filteredRecords().map((record) => {
  const row = record as Record<string, any>
  return {
    ...row,
    subject: mode() === 'activity' ? formatSubject(record as DashboardActivity) : undefined,
    verificationTone: row.emailVerifiedAt ? 'positive' : 'pending',
    verificationLabel: row.emailVerifiedAt ? 'Verified' : 'Unverified',
    statusTone: statusTone(String(row.status ?? '')),
    statusLabel: capitalize(String(row.status ?? '')),
    sourceLabel: capitalize(String(row.source ?? '')),
    descriptionLabel: row.description || 'No description',
    modelLink: `/models/team?q=${encodeURIComponent(String(row.name ?? ''))}`,
  }
}))

async function loadRecords(): Promise<void> {
  loading.set(true)
  loadError.set('')
  try {
    if (mode() === 'activity') {
      const response = await fetchDashboardData<DashboardActivity>('activity')
      records.set(response.activities || [])
      stats.set(response.stats)
    }
    else if (mode() === 'users') {
      const response = await fetchDashboardData<DashboardUser>('users')
      records.set(response.users || [])
      stats.set(response.stats)
    }
    else if (mode() === 'teams') {
      const response = await fetchDashboardData<DashboardTeam>('teams')
      records.set(response.teams || [])
      stats.set(response.stats)
    }
    else {
      const response = await fetchDashboardData<DashboardSubscriber>('subscribers')
      records.set(response.subscribers || [])
      stats.set(response.stats)
    }
  }
  catch (error) {
    records.set([])
    stats.set({ total: 0 })
    loadError.set(error instanceof Error ? error.message : `${page().title} could not be loaded.`)
  }
  finally {
    loading.set(false)
  }
}

onMount(() => {
  void loadRecords()
})
</script>

<div class="space-y-6">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="font-semibold text-2xl text-neutral-900 tracking-tight dark:text-white">{{ page().title }}</h1>
      <p class="mt-1 text-neutral-500 text-sm dark:text-neutral-400">{{ page().description }}</p>
    </div>
    <Button variant="secondary" :loading="loading()" @click="loadRecords">
      <span :if="!loading()" class="h-4 w-4 i-hugeicons-refresh"></span>
      Refresh
    </Button>
  </header>

  <div class="grid gap-4 grid-cols-2 lg:grid-cols-4">
    <StatsCard :title="'Total ' + page().title" :icon="page().icon" iconBg="primary">
      <template #value>{{ statValue('total') }}</template>
    </StatsCard>
    <StatsCard :if="mode() === 'activity'" title="Last 24 Hours" icon="i-hugeicons-clock-01" iconBg="success">
      <template #value>{{ statValue('last24Hours') }}</template>
    </StatsCard>
    <StatsCard :if="mode() === 'activity'" title="Last 7 Days" icon="i-hugeicons-calendar-03" iconBg="info">
      <template #value>{{ statValue('last7Days') }}</template>
    </StatsCard>
    <StatsCard :if="mode() === 'users'" title="New This Week" icon="i-hugeicons-user-add-01" iconBg="success">
      <template #value>{{ statValue('newThisWeek') }}</template>
    </StatsCard>
    <StatsCard :if="mode() === 'users'" title="Email Verified" icon="i-hugeicons-mail-validation-01" iconBg="info">
      <template #value>{{ statValue('verified') }}</template>
    </StatsCard>
    <StatsCard :if="mode() === 'teams'" title="Active Teams" icon="i-hugeicons-checkmark-circle-02" iconBg="success">
      <template #value>{{ statValue('active') }}</template>
    </StatsCard>
    <StatsCard :if="mode() === 'teams'" title="Members" icon="i-hugeicons-user-multiple" iconBg="info">
      <template #value>{{ statValue('members') }}</template>
    </StatsCard>
    <StatsCard :if="mode() === 'teams'" title="New This Month" icon="i-hugeicons-calendar-add-01" iconBg="warning">
      <template #value>{{ statValue('newThisMonth') }}</template>
    </StatsCard>
    <StatsCard :if="mode() === 'subscribers'" title="Subscribed" icon="i-hugeicons-mail-open-01" iconBg="success">
      <template #value>{{ statValue('subscribed') }}</template>
    </StatsCard>
    <StatsCard :if="mode() === 'subscribers'" title="Unsubscribed" icon="i-hugeicons-mail-remove-01" iconBg="warning">
      <template #value>{{ statValue('unsubscribed') }}</template>
    </StatsCard>
    <StatsCard :if="mode() === 'subscribers'" title="New This Month" icon="i-hugeicons-calendar-add-01" iconBg="info">
      <template #value>{{ statValue('newThisMonth') }}</template>
    </StatsCard>
  </div>

  <div :if="loadError()" role="alert" class="px-4 py-3 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/40 border border-red-200 rounded-lg dark:border-red-900">
    {{ loadError() }}
  </div>

  <Card padding="none">
    <div class="flex flex-col gap-3 items-start sm:flex-row sm:items-center sm:justify-between p-5 border-b border-neutral-200 dark:border-neutral-700">
      <div>
        <h2 class="font-semibold text-neutral-900 dark:text-white">{{ page().title }}</h2>
        <p class="mt-1 text-neutral-500 text-xs dark:text-neutral-400">Showing {{ filteredRecords().length }} of {{ records().length }} loaded records</p>
      </div>
      <label class="block relative w-full sm:w-72">
        <span class="sr-only">Search {{ page().title.toLowerCase() }}</span>
        <span class="flex absolute inset-y-0 left-0 items-center pl-3 text-neutral-400 i-hugeicons-search-01"></span>
        <input x-model="search" type="search" :placeholder="'Search ' + page().title.toLowerCase()" class="block pl-9 pr-3 py-2 w-full text-neutral-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-neutral-300 rounded-lg dark:border-neutral-700 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20">
      </label>
    </div>

    <div :if="loading()" class="flex items-center justify-center py-16 text-neutral-500 text-sm dark:text-neutral-400">
      <span class="mr-2 h-5 w-5 animate-spin i-hugeicons-loading-03"></span>
      Loading {{ page().title.toLowerCase() }}...
    </div>

    <EmptyState :if="!loading() && !loadError() && filteredRecords().length === 0" :icon="page().icon" :title="search() ? 'No matching records' : page().empty" :description="search() ? 'Try a different search term.' : 'New records will appear here automatically.'" />

    {{--
      Four column sets: the mode decides which. The page keeps its search,
      loading and empty states; the table brings sorting and paging. Only a
      team's name is slotted, for the link to its model page.
    --}}
    <div :if="!loading() && filteredRecords().length > 0">
      {{--
        Two tables rather than one with a slot: Table hands every cell to a
        given cell slot when no column is slotted, so the slot can only be
        passed in the mode that has a slotted column.
      --}}
      <template :if="mode() === 'teams'">
        <Table :columns="recordColumns()" :data="recordRows()" paginated :page-size="25">
          <template #cell="{ row }">
            <StxLink :to="row.modelLink" class="font-medium text-neutral-900 text-sm dark:text-white hover:text-blue-600 dark:hover:text-blue-400">{{ row.name }}</StxLink>
            <p class="mt-0.5 max-w-xl text-neutral-500 text-xs dark:text-neutral-400" x-text="row.descriptionLabel"></p>
          </template>
        </Table>
      </template>
      <template :else>
        <Table :columns="recordColumns()" :data="recordRows()" paginated :page-size="25" />
      </template>
    </div>
  </Card>
</div>
