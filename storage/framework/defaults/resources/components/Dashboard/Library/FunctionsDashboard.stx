@import('../UI/Button')

<script client>
import { dashboardApi } from '../../../../functions/dashboard-api'
import { pushToast } from '../../../../functions/toasts'

interface FunctionRow {
  name: string
  path: string
  extension: string
  bytes: number
  createdAt: string
  updatedAt: string
}

const functions = state<FunctionRow[]>([])
const totalBytes = state(0)
const sourceRoot = state('resources/functions')
const loading = state(true)
const loadError = state('')
const search = state('')
const dialogOpen = state(false)
const saving = state(false)
const saveError = state('')

function visibleFunctions(): FunctionRow[] {
  const query = search().trim().toLowerCase()
  return functions().filter(fn => !query || [fn.name, fn.path, fn.extension].some(value => value.toLowerCase().includes(query)))
}

function formatBytes(bytes: number): string {
  if (bytes < 1024)
    return `${bytes} B`
  return `${(bytes / 1024).toFixed(1)} kB`
}

function formatDate(value: string): string {
  const date = new Date(value)
  return Number.isNaN(date.getTime()) ? value : new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeStyle: 'short' }).format(date)
}

async function loadFunctions(): Promise<void> {
  loading.set(true)
  loadError.set('')
  try {
    const data = await dashboardApi<{ functions?: FunctionRow[], totalBytes?: number, sourceRoot?: string }>('/api/dashboard/library/functions')
    if (!Array.isArray(data.functions))
      throw new TypeError('Function sources were not returned in the expected shape.')
    functions.set(data.functions)
    totalBytes.set(Number(data.totalBytes || 0))
    sourceRoot.set(String(data.sourceRoot || 'resources/functions'))
  }
  catch (error) {
    loadError.set(error instanceof Error ? error.message : String(error))
    pushToast('error', 'Could not load functions', { detail: loadError() })
  }
  finally {
    loading.set(false)
  }
}

function openCreate(): void {
  saveError.set('')
  dialogOpen.set(true)
}

function closeCreate(): void {
  if (!saving())
    dialogOpen.set(false)
}

async function createFunction(name: string): Promise<void> {
  saving.set(true)
  saveError.set('')
  try {
    await dashboardApi('/api/dashboard/library/functions', {
      method: 'POST',
      body: { name },
    })
    dialogOpen.set(false)
    pushToast('success', 'Function created', { detail: `${name}.ts` })
    await loadFunctions()
  }
  catch (error) {
    saveError.set(error instanceof Error ? error.message : String(error))
  }
  finally {
    saving.set(false)
  }
}

onMount(() => { void loadFunctions() })
</script>

<div class="space-y-6">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div><p class="font-semibold text-blue-600 text-xs tracking-wide uppercase dark:text-blue-400">Library</p><h1 class="mt-1 font-bold text-2xl text-gray-900 dark:text-white">Functions</h1><p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Source files discovered from {{ sourceRoot() }}.</p></div>
    <div class="flex gap-2"><Button type="button" variant="secondary" :loading="loading()" :disabled="loading()" @click="loadFunctions()">Refresh</Button><Button type="button" variant="primary" @click="openCreate()"><span class="h-4 w-4 i-hugeicons-add-01"></span>Create function</Button></div>
  </header>

  <div :if="loadError()" role="alert" class="flex gap-4 items-center justify-between p-4 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900"><span>{{ loadError() }}</span><Button type="button" variant="ghost" size="sm" @click="loadFunctions()">Retry</Button></div>

  <section aria-label="Function metrics" class="grid gap-3 sm:grid-cols-3">
    <article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700"><p class="text-gray-500 text-xs dark:text-neutral-400">Source files</p><p class="mt-2 font-semibold text-2xl text-gray-900 dark:text-white">{{ functions().length }}</p></article>
    <article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700"><p class="text-gray-500 text-xs dark:text-neutral-400">Combined size</p><p class="mt-2 font-semibold text-2xl text-gray-900 dark:text-white">{{ formatBytes(totalBytes()) }}</p></article>
    <article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700"><p class="text-gray-500 text-xs dark:text-neutral-400">Visible</p><p class="mt-2 font-semibold text-2xl text-blue-700 dark:text-blue-300">{{ visibleFunctions().length }}</p></article>
  </section>

  <section class="overflow-hidden bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
    <div class="p-4 border-b border-gray-200 dark:border-neutral-700"><label><span class="sr-only">Search functions</span><input x-model="search" type="search" placeholder="Search name or path" class="px-3 py-2 max-w-md w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" /></label></div>
    <div class="overflow-x-auto"><table class="min-w-full divide-gray-200 divide-y dark:divide-neutral-700"><thead class="bg-gray-50 dark:bg-neutral-900/50"><tr><th class="px-4 py-3 font-semibold text-gray-600 text-left text-xs dark:text-neutral-300">Function</th><th class="px-4 py-3 font-semibold text-gray-600 text-left text-xs dark:text-neutral-300">Path</th><th class="px-4 py-3 font-semibold text-gray-600 text-left text-xs dark:text-neutral-300">Size</th><th class="px-4 py-3 font-semibold text-gray-600 text-left text-xs dark:text-neutral-300">Updated</th></tr></thead><tbody class="divide-gray-200 divide-y dark:divide-neutral-700">
      <template :if="loading()"><tr><td colspan="4" class="px-4 py-12 text-center text-gray-500 text-sm dark:text-neutral-400"><span class="inline-block mr-2 h-4 w-4 animate-spin i-hugeicons-loading-03"></span>Scanning function sources</td></tr></template>
      <template :else-if="visibleFunctions().length === 0"><tr><td colspan="4" class="px-4 py-14 text-center"><span class="inline-block h-6 w-6 text-gray-400 i-hugeicons-function"></span><p class="mt-2 font-medium text-gray-900 text-sm dark:text-white">No functions found</p><p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Create a function or adjust the search.</p></td></tr></template>
      <template :else><template :for="fn in visibleFunctions()"><tr><td class="px-4 py-3 font-medium text-gray-900 text-sm dark:text-white">{{ fn.name }}</td><td class="px-4 py-3 font-mono text-gray-500 text-xs dark:text-neutral-400">{{ fn.path }}</td><td class="px-4 py-3 text-gray-500 text-sm dark:text-neutral-400">{{ formatBytes(fn.bytes) }}</td><td class="px-4 py-3 text-gray-500 text-sm dark:text-neutral-400">{{ formatDate(fn.updatedAt) }}</td></tr></template></template>
    </tbody></table></div>
  </section>
</div>

<SourceScaffoldDialog
  :open="dialogOpen()"
  kind="function"
  :busy="saving()"
  :error="saveError()"
  @close="closeCreate"
  @submit="createFunction"
/>
