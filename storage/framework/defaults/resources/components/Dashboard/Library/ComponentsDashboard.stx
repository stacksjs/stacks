@import('../UI/Button')
@import('../UI/Table')

<script client>
import { dashboardApi } from '../../../../functions/dashboard-api'
import { pushToast } from '../../../../functions/toasts'

interface ComponentRow {
  name: string
  path: string
  category: string
  bytes: number
  updatedAt: string
}

interface ComponentsResponse {
  components?: ComponentRow[]
  categories?: string[]
  totalBytes?: number
  sourceRoot?: string
}

const components = state<ComponentRow[]>([])
const categories = state<string[]>(['All'])
const totalBytes = state(0)
const sourceRoot = state('resources/components')
const loading = state(true)
const loadError = state('')
const selectedCategory = state('All')
const dialogOpen = state(false)
const saving = state(false)
const saveError = state('')

const COLUMNS = [
  { key: 'name', label: 'Component', sortable: true, class: 'font-medium text-gray-900 dark:text-white' },
  // A neutral pill with no per-value styling, which is what a badge column
  // renders when it is given no `badgeClasses`.
  { key: 'category', label: 'Category', type: 'badge' as const, sortable: true },
  { key: 'path', label: 'Path', sortable: true, class: 'font-mono text-xs text-gray-500 dark:text-neutral-400' },
  // `sizeLabel` is what the cell shows; `bytes` stays on the row so a future
  // numeric sort has something to read.
  { key: 'sizeLabel', label: 'Size', sortable: true, class: 'text-gray-500 dark:text-neutral-400' },
  { key: 'updatedAt', label: 'Updated', type: 'datetime' as const, sortable: true, class: 'text-gray-500 dark:text-neutral-400' },
]

/** `UI/Table` owns the search, so this applies only the category filter. */
function visibleComponents(): Array<ComponentRow & { sizeLabel: string }> {
  return components()
    .filter(component => selectedCategory() === 'All' || component.category === selectedCategory())
    .map(component => ({ ...component, sizeLabel: formatBytes(component.bytes) }))
}

function formatBytes(bytes: number): string {
  if (bytes < 1024)
    return `${bytes} B`
  return `${(bytes / 1024).toFixed(1)} kB`
}

async function loadComponents(): Promise<void> {
  loading.set(true)
  loadError.set('')
  try {
    const data = await dashboardApi<ComponentsResponse>('/api/dashboard/library/components')
    if (!Array.isArray(data.components))
      throw new TypeError('Component sources were not returned in the expected shape.')

    components.set(data.components)
    categories.set(Array.isArray(data.categories) && data.categories.length > 0 ? data.categories : ['All'])
    totalBytes.set(Number(data.totalBytes || 0))
    sourceRoot.set(String(data.sourceRoot || 'resources/components'))

    if (!categories().includes(selectedCategory()))
      selectedCategory.set('All')
  }
  catch (error) {
    loadError.set(error instanceof Error ? error.message : String(error))
    pushToast('error', 'Could not load components', { detail: loadError() })
  }
  finally {
    loading.set(false)
  }
}

function openCreate(): void {
  saveError.set('')
  dialogOpen.set(true)
}

function closeCreate(): void {
  if (!saving())
    dialogOpen.set(false)
}

async function createComponent(name: string): Promise<void> {
  saving.set(true)
  saveError.set('')
  try {
    await dashboardApi('/api/dashboard/library/components', {
      method: 'POST',
      body: { name },
    })
    dialogOpen.set(false)
    pushToast('success', 'Component created', { detail: `${name}.stx` })
    await loadComponents()
  }
  catch (error) {
    saveError.set(error instanceof Error ? error.message : String(error))
  }
  finally {
    saving.set(false)
  }
}

onMount(() => {
  void loadComponents()
})
</script>

<div class="space-y-6">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="font-semibold text-blue-600 text-xs tracking-wide uppercase dark:text-blue-400">Library</p>
      <h1 class="mt-1 font-bold text-2xl text-gray-900 dark:text-white">Components</h1>
      <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">
        STX component sources discovered from <span class="font-mono" :text="sourceRoot()"></span>.
      </p>
    </div>
    <div class="flex gap-2">
      <Button
        type="button"
        variant="secondary"
        :loading="loading()"
        :disabled="loading()"
        @click="loadComponents()"
      >
        Refresh
      </Button>
      <Button
        type="button"
        variant="primary"
        @click="openCreate()"
      >
        <span class="h-4 w-4 i-hugeicons-add-01"></span>
        Create component
      </Button>
    </div>
  </header>

  <div
    :if="loadError()"
    role="alert"
    class="flex gap-4 items-center justify-between p-4 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900"
  >
    <span :text="loadError()"></span>
    <Button type="button" variant="ghost" size="sm" @click="loadComponents()">Retry</Button>
  </div>

  <section aria-label="Component metrics" class="grid gap-3 sm:grid-cols-3">
    <article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
      <p class="text-gray-500 text-xs dark:text-neutral-400">Source files</p>
      <p class="mt-2 font-semibold text-2xl text-gray-900 dark:text-white" :text="components().length"></p>
    </article>
    <article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
      <p class="text-gray-500 text-xs dark:text-neutral-400">Combined size</p>
      <p class="mt-2 font-semibold text-2xl text-gray-900 dark:text-white" :text="formatBytes(totalBytes())"></p>
    </article>
    <article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
      <p class="text-gray-500 text-xs dark:text-neutral-400">Visible</p>
      <p class="mt-2 font-semibold text-2xl text-blue-700 dark:text-blue-300" :text="visibleComponents().length"></p>
    </article>
  </section>

  <section class="overflow-hidden bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
    <Table
      :columns="COLUMNS"
      :data="visibleComponents()"
      :loading="loading()"
      row-key="path"
      searchable
      search-placeholder="Search name, category, or path"
      paginated
      :page-size="25"
      empty-title="No components found"
      empty-description="Adjust the search or category filter."
    >
      <template #toolbar>
        <label>
          <span class="sr-only">Filter by category</span>
          {{-- `x-text` rather than `{{ category }}`: an interpolation inside
               slot content is preserved but never evaluated on the installed
               stx, while the attribute forms read the loop variable fine.
               See stacksjs/stx#2095. --}}
          <select
            x-model="selectedCategory"
            aria-label="Filter by category"
            class="px-2.5 py-1.5 text-sm bg-white dark:bg-neutral-800 border border-stone-300 rounded-lg dark:border-neutral-600"
          >
            <option :for="category in categories()" :value="category" x-text="category"></option>
          </select>
        </label>
      </template>
    </Table>
  </section>
</div>

<SourceScaffoldDialog
  :open="dialogOpen()"
  kind="component"
  :busy="saving()"
  :error="saveError()"
  @close="closeCreate"
  @submit="createComponent"
/>
