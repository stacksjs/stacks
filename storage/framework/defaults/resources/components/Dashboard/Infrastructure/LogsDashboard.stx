<script client>
import type {
  DashboardLogRecord,
  DashboardLogSummary,
  DashboardLogType,
} from '../../../../app/Actions/Dashboard/Infrastructure/log-dashboard'
import { dashboardApi } from '../../../../functions/dashboard-api'

interface LogPagination {
  page: number
  perPage: number
  total: number
  totalPages: number
}

interface LogOptions {
  sources: string[]
  projects: string[]
  types: string[]
  ranges: string[]
}

interface LogResponse {
  logs: DashboardLogRecord[]
  summary: DashboardLogSummary
  pagination: LogPagination
  options: LogOptions
  generatedAt?: string
}

const EMPTY_SUMMARY: DashboardLogSummary = { total: 0, error: 0, warning: 0, info: 0, success: 0 }
const EMPTY_PAGINATION: LogPagination = { page: 1, perPage: 25, total: 0, totalPages: 1 }
const EMPTY_OPTIONS: LogOptions = { sources: [], projects: [], types: [], ranges: [] }

const logs = state<DashboardLogRecord[]>([])
const summary = state<DashboardLogSummary>({ ...EMPTY_SUMMARY })
const pagination = state<LogPagination>({ ...EMPTY_PAGINATION })
const options = state<LogOptions>({ ...EMPTY_OPTIONS })
const generatedAt = state('')
const loading = state(true)
const loadError = state('')
const search = state('')
const source = state('')
const type = state('')
const project = state('')
const range = state('30')
const perPage = state('25')
const autoRefresh = state(false)
const selectedLog = state<DashboardLogRecord | null>(null)
let loadVersion = 0

const levels = derived(() => [
  { type: 'error' as const, label: 'Errors', count: summary().error },
  { type: 'warning' as const, label: 'Warnings', count: summary().warning },
  { type: 'info' as const, label: 'Info', count: summary().info },
  { type: 'success' as const, label: 'Success', count: summary().success },
])
const hasFilters = derived(() => Boolean(search() || source() || type() || project() || range() !== '30'))
const pageStart = derived(() => pagination().total === 0 ? 0 : (pagination().page - 1) * pagination().perPage + 1)
const pageEnd = derived(() => Math.min(pagination().total, pagination().page * pagination().perPage))

function countWidth(count: number): string {
  if (summary().total <= 0)
    return '0%'
  return `${Math.max(2, Math.round((count / summary().total) * 100))}%`
}

function formatDate(value: string): string {
  if (!value)
    return 'Not recorded'
  const date = new Date(value)
  return Number.isNaN(date.getTime())
    ? 'Not recorded'
    : new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' }).format(date)
}

function rangeLabel(value: string): string {
  if (value === 'all')
    return 'All time'
  if (value === '1')
    return 'Last 24 hours'
  return `Last ${value} days`
}

function closeLog(): void {
  selectedLog.set(null)
}

function openLog(record: DashboardLogRecord): void {
  selectedLog.set(record)
}

function clearData(): void {
  logs.set([])
  summary.set({ ...EMPTY_SUMMARY })
  pagination.set({ ...EMPTY_PAGINATION })
  options.set({ ...EMPTY_OPTIONS })
  generatedAt.set('')
}

async function loadLogs(showLoading = true): Promise<void> {
  const version = ++loadVersion
  if (showLoading)
    loading.set(true)
  loadError.set('')
  try {
    const params = new URLSearchParams({
      page: String(pagination().page),
      per_page: perPage(),
      range: range(),
    })
    if (search())
      params.set('search', search().trim())
    if (source())
      params.set('source', source())
    if (type())
      params.set('type', type())
    if (project())
      params.set('project', project())

    const result = await dashboardApi<LogResponse>(`/api/dashboard/logs?${params}`)
    if (version !== loadVersion)
      return
    logs.set(Array.isArray(result.logs) ? result.logs : [])
    summary.set(result.summary || { ...EMPTY_SUMMARY })
    pagination.set(result.pagination || { ...EMPTY_PAGINATION })
    options.set(result.options || { ...EMPTY_OPTIONS })
    generatedAt.set(result.generatedAt || '')
  }
  catch (error) {
    if (version !== loadVersion)
      return
    clearData()
    loadError.set(error instanceof Error ? error.message : 'Logs could not be loaded.')
  }
  finally {
    if (version === loadVersion)
      loading.set(false)
  }
}

function reloadFilters(): void {
  pagination.set({ ...pagination(), page: 1 })
  void loadLogs()
}

const scheduleSearch = debounce(() => {
  reloadFilters()
}, 250)

function resetFilters(): void {
  search.set('')
  source.set('')
  type.set('')
  project.set('')
  range.set('30')
  reloadFilters()
}

function previousPage(): void {
  if (pagination().page <= 1)
    return
  pagination.set({ ...pagination(), page: pagination().page - 1 })
  void loadLogs()
}

function nextPage(): void {
  if (pagination().page >= pagination().totalPages)
    return
  pagination.set({ ...pagination(), page: pagination().page + 1 })
  void loadLogs()
}

function toggleAutoRefresh(): void {
  autoRefresh.set(!autoRefresh())
}

const visibility = useDocumentVisibility()
const { pause: pauseRefresh, resume: resumeRefresh } = useIntervalFn(() => {
  if (autoRefresh() && visibility.value === 'visible')
    void loadLogs(false)
}, 15000, { immediate: false })

effect(() => {
  if (autoRefresh())
    resumeRefresh()
  else
    pauseRefresh()
})

useEventListener('keydown', (event: KeyboardEvent) => {
  if (event.key === 'Escape')
    closeLog()
})

onMount(() => {
  void loadLogs()
})

onDestroy(() => {
  scheduleSearch.cancel()
  pauseRefresh()
})
</script>

<div class="space-y-6">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <div class="flex gap-2 items-center">
        <h1 class="font-semibold text-2xl text-neutral-900 tracking-tight dark:text-white">System logs</h1>
        <CloudStatusBadge :status="loadError() ? 'attention' : 'configured'" />
      </div>
      <p class="mt-1 max-w-2xl text-neutral-500 text-sm dark:text-neutral-400">Persisted Log model records. Counts, filters, and details come from the same database query.</p>
    </div>
    <div class="flex gap-2 items-center">
      <Button variant="secondary" interaction="toggle" :pressed="autoRefresh()" @click="toggleAutoRefresh">
        <span :class="'h-4 w-4 i-hugeicons-refresh ' + (autoRefresh() ? 'animate-spin' : '')"></span>
        {{ autoRefresh() ? 'Auto refresh on' : 'Auto refresh off' }}
      </Button>
      <Button variant="secondary" iconOnly :loading="loading()" ariaLabel="Refresh system logs" @click="loadLogs">
        <span :if="!loading()" class="h-4 w-4 i-hugeicons-refresh"></span>
      </Button>
    </div>
  </header>

  <div :if="loadError()" role="alert" class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between px-4 py-3 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/40 border border-red-200 rounded-xl dark:border-red-900">
    <span>{{ loadError() }}</span>
    <Button variant="secondary" size="sm" @click="loadLogs">Try again</Button>
  </div>

  <section class="grid gap-3 grid-cols-2 xl:grid-cols-4">
    <div class="p-4 bg-white dark:bg-neutral-900 border border-neutral-200 rounded-xl dark:border-neutral-700">
      <p class="text-neutral-500 text-xs uppercase dark:text-neutral-400">Matching records</p>
      <p class="mt-2 font-semibold text-neutral-900 text-xl dark:text-white">{{ summary().total }}</p>
    </div>
    <div class="p-4 bg-white dark:bg-neutral-900 border border-neutral-200 rounded-xl dark:border-neutral-700">
      <p class="text-neutral-500 text-xs uppercase dark:text-neutral-400">Errors</p>
      <p class="mt-2 font-semibold text-red-600 text-xl dark:text-red-400">{{ summary().error }}</p>
    </div>
    <div class="p-4 bg-white dark:bg-neutral-900 border border-neutral-200 rounded-xl dark:border-neutral-700">
      <p class="text-neutral-500 text-xs uppercase dark:text-neutral-400">Warnings</p>
      <p class="mt-2 font-semibold text-amber-600 text-xl dark:text-amber-400">{{ summary().warning }}</p>
    </div>
    <div class="p-4 bg-white dark:bg-neutral-900 border border-neutral-200 rounded-xl dark:border-neutral-700">
      <p class="text-neutral-500 text-xs uppercase dark:text-neutral-400">Selected range</p>
      <p class="mt-2 font-medium text-neutral-900 text-sm dark:text-white">{{ rangeLabel(range()) }}</p>
    </div>
  </section>

  <section class="grid gap-4 grid-cols-1 xl:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)]">
    <div class="p-5 bg-white dark:bg-neutral-900 border border-neutral-200 rounded-xl dark:border-neutral-700">
      <h2 class="font-semibold text-neutral-900 dark:text-white">Type distribution</h2>
      <p class="mt-1 text-neutral-500 text-xs dark:text-neutral-400">Exact counts for the active server-side filters.</p>
      <div class="mt-5 space-y-4">
        <div :for="level in levels()" class="grid gap-3 grid-cols-[5.5rem_minmax(0,1fr)_2.5rem] items-center">
          <LogLevelBadge :type="level.type" />
          <div class="overflow-hidden h-2 bg-neutral-100 dark:bg-neutral-800 rounded-full">
            <div :style="'width: ' + countWidth(level.count)" :class="'h-full rounded-full ' + (level.type === 'error' ? 'bg-red-500' : level.type === 'warning' ? 'bg-amber-500' : level.type === 'success' ? 'bg-green-500' : 'bg-blue-500')"></div>
          </div>
          <span class="font-mono text-neutral-500 text-right text-xs dark:text-neutral-400">{{ level.count }}</span>
        </div>
      </div>
    </div>

    <div class="p-5 bg-white dark:bg-neutral-900 border border-neutral-200 rounded-xl dark:border-neutral-700">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div><h2 class="font-semibold text-neutral-900 dark:text-white">Query logs</h2><p class="mt-1 text-neutral-500 text-xs dark:text-neutral-400">Search message, project, file, and stack trace.</p></div>
        <p :if="generatedAt()" class="text-neutral-400 text-xs dark:text-neutral-500">Snapshot {{ formatDate(generatedAt()) }}</p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3 mt-5">
        <label class="block relative sm:col-span-2 xl:col-span-1">
          <span class="sr-only">Search system logs</span>
          <span class="absolute left-3 top-2.5 h-4 w-4 text-neutral-400 i-hugeicons-search-01"></span>
          <input x-model="search" type="search" placeholder="Search logs" class="pl-9 pr-3 py-2 w-full text-neutral-900 text-sm dark:text-white bg-white dark:bg-neutral-950 border border-neutral-300 rounded-lg dark:border-neutral-700 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" @input="scheduleSearch" />
        </label>
        <label><span class="sr-only">Filter by type</span><select x-model="type" class="px-3 py-2 w-full text-neutral-900 text-sm dark:text-white bg-white dark:bg-neutral-950 border border-neutral-300 rounded-lg dark:border-neutral-700" @change="reloadFilters"><option value="">All types</option><option :for="entry in options().types" :value="entry">{{ entry }}</option></select></label>
        <label><span class="sr-only">Filter by source</span><select x-model="source" class="px-3 py-2 w-full text-neutral-900 text-sm dark:text-white bg-white dark:bg-neutral-950 border border-neutral-300 rounded-lg dark:border-neutral-700" @change="reloadFilters"><option value="">All sources</option><option :for="entry in options().sources" :value="entry">{{ entry }}</option></select></label>
        <label><span class="sr-only">Filter by project</span><select x-model="project" class="px-3 py-2 w-full text-neutral-900 text-sm dark:text-white bg-white dark:bg-neutral-950 border border-neutral-300 rounded-lg dark:border-neutral-700" @change="reloadFilters"><option value="">All projects</option><option :for="entry in options().projects" :value="entry">{{ entry }}</option></select></label>
        <label><span class="sr-only">Filter by time range</span><select x-model="range" class="px-3 py-2 w-full text-neutral-900 text-sm dark:text-white bg-white dark:bg-neutral-950 border border-neutral-300 rounded-lg dark:border-neutral-700" @change="reloadFilters"><option value="1">Last 24 hours</option><option value="7">Last 7 days</option><option value="30">Last 30 days</option><option value="90">Last 90 days</option><option value="all">All time</option></select></label>
        <Button :if="hasFilters()" variant="secondary" @click="resetFilters"><span class="h-4 w-4 i-hugeicons-cancel-01"></span>Reset filters</Button>
      </div>
    </div>
  </section>

  <section class="overflow-hidden bg-white dark:bg-neutral-900 border border-neutral-200 rounded-xl dark:border-neutral-700">
    <div :if="loading() && logs().length === 0" class="flex items-center justify-center py-20 text-neutral-500 text-sm dark:text-neutral-400"><span class="mr-2 h-5 w-5 animate-spin i-hugeicons-loading-03"></span>Loading system logs</div>
    <EmptyState :if="!loading() && !loadError() && logs().length === 0" icon="i-hugeicons-file-search" title="No matching log records" description="Adjust the server-side filters or wait for the application to persist another Log model record." />
    <div :if="logs().length > 0" class="overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead class="text-neutral-500 text-xs uppercase dark:text-neutral-400 bg-neutral-50 dark:bg-neutral-800/60 border-b border-neutral-200 dark:border-neutral-700">
          <tr><th class="px-5 py-3 font-medium text-left">Occurred</th><th class="px-5 py-3 font-medium text-left">Type</th><th class="px-5 py-3 font-medium text-left">Source</th><th class="px-5 py-3 font-medium text-left">Message</th><th class="px-5 py-3 font-medium text-left">Project</th><th class="px-5 py-3 font-medium text-right">Details</th></tr>
        </thead>
        <tbody class="divide-neutral-100 divide-y dark:divide-neutral-800">
          <tr :for="record in logs()" class="hover:bg-neutral-50 dark:hover:bg-neutral-800/70">
            <td class="px-5 py-4 text-neutral-500 whitespace-nowrap dark:text-neutral-400">{{ formatDate(record.timestamp) }}</td>
            <td class="px-5 py-4"><LogLevelBadge :type="record.type" /></td>
            <td class="px-5 py-4 font-mono text-neutral-700 text-xs dark:text-neutral-300">{{ record.source || 'Not recorded' }}</td>
            <td class="px-5 py-4 max-w-md"><p class="font-medium text-neutral-900 dark:text-white">{{ record.message }}</p><p :if="record.file" class="mt-1 font-mono text-neutral-400 text-xs truncate dark:text-neutral-500">{{ record.file }}</p></td>
            <td class="px-5 py-4 text-neutral-600 whitespace-nowrap dark:text-neutral-300">{{ record.project || 'Not recorded' }}</td>
            <td class="px-5 py-4 text-right"><Button variant="ghost" iconOnly :ariaLabel="'Inspect log ' + record.id" @click="openLog(record)"><span class="block h-5 w-5 i-hugeicons-view"></span></Button></td>
          </tr>
        </tbody>
      </table>
    </div>
    <footer :if="logs().length > 0" class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between px-5 py-4 text-neutral-500 text-sm dark:text-neutral-400 bg-neutral-50 dark:bg-neutral-800/50 border-neutral-200 border-t dark:border-neutral-700">
      <p>Showing {{ pageStart() }} to {{ pageEnd() }} of {{ pagination().total }}</p>
      <div class="flex gap-2 items-center">
        <label><span class="sr-only">Logs per page</span><select x-model="perPage" class="px-2 py-1.5 text-neutral-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-neutral-300 rounded-lg dark:border-neutral-700" @change="reloadFilters"><option value="10">10 per page</option><option value="25">25 per page</option><option value="50">50 per page</option><option value="100">100 per page</option></select></label>
        <Button variant="secondary" iconOnly :disabled="pagination().page <= 1" ariaLabel="Previous log page" @click="previousPage"><span class="block h-4 w-4 i-hugeicons-arrow-left-01"></span></Button>
        <span class="font-mono text-neutral-600 text-xs dark:text-neutral-300">{{ pagination().page }} / {{ pagination().totalPages }}</span>
        <Button variant="secondary" iconOnly :disabled="pagination().page >= pagination().totalPages" ariaLabel="Next log page" @click="nextPage"><span class="block h-4 w-4 i-hugeicons-arrow-right-01"></span></Button>
      </div>
    </footer>
  </section>

  <LogDetailsDialog :open="Boolean(selectedLog())" :record="selectedLog()" @close="closeLog" />
</div>
