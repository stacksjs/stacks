<script client>
interface MailFolder {
  id: string
  name: string
  icon?: string
}

interface MailCategory {
  id: string
  name: string
  icon: string
  count: number
}

const activeFolder = useReactiveProp('activeFolder', 'inbox')
const folders = useReactiveProp('folders', [] as MailFolder[])
const unreadCounts = useReactiveProp('unreadCounts', {} as Record<string, number>)
const mailbox = useReactiveProp('mailbox', 'Configured mailbox')
const categories = useReactiveProp('categories', [] as MailCategory[])
const emit = defineEmits()

function unreadCount(folderId: string): number {
  return Number(unreadCounts()[folderId] || 0)
}

function folderIcon(folder: MailFolder): string {
  if (folder.icon)
    return `i-hugeicons-${folder.icon}`
  if (folder.id === 'drafts')
    return 'i-hugeicons-edit-01'
  if (folder.id === 'sent')
    return 'i-hugeicons-sent'
  if (folder.id === 'trash')
    return 'i-hugeicons-waste'
  return `i-hugeicons-${folder.id}`
}

function folderClass(folderId: string): string {
  return activeFolder() === folderId
    ? 'bg-gray-100 dark:bg-neutral-700 text-gray-900 dark:text-white font-medium'
    : 'text-gray-700 dark:text-neutral-300 hover:bg-gray-50 dark:hover:bg-neutral-700'
}

function mailboxLabel(): string {
  const value = mailbox()
  return value || 'Configured mailbox'
}
</script>

<aside class="flex flex-col flex-shrink-0 w-64 bg-white dark:bg-neutral-800 border-gray-200 border-r dark:border-neutral-600">
  <div class="p-3 border-b border-gray-200 dark:border-neutral-600">
    <div class="flex items-center space-x-2">
      <div class="flex flex-shrink-0 items-center justify-center h-8 w-8 text-gray-700 dark:text-white bg-gray-200 dark:bg-neutral-700 rounded">
        <i class="text-sm i-hugeicons-mail-02"></i>
      </div>
      <div class="min-w-0">
        <p class="font-medium text-gray-900 text-sm truncate dark:text-white">Mailbox</p>
        <p class="text-gray-500 text-xs truncate dark:text-neutral-400">{{ mailboxLabel() }}</p>
      </div>
    </div>
    <Button
      class="mt-3"
      fullWidth
      @click="emit('compose')"
    >
      <span class="h-4 w-4 i-hugeicons-plus-sign"></span>
      Compose Email
    </Button>
  </div>

  <div class="overflow-y-auto flex-1">
    <nav aria-label="Mail folders" class="mt-1">
      <ul>
        <template :for="folder in folders">
          <li class="mb-1">
            <button
              type="button"
              :class="'flex items-center justify-between px-4 py-2 w-full text-sm ' + folderClass(folder.id)"
              @click="emit('update:active-folder', folder.id)"
            >
              <span class="flex items-center min-w-0">
                <span :class="'mr-3 h-5 w-5 flex-shrink-0 ' + folderIcon(folder)"></span>
                <span class="truncate">{{ folder.name }}</span>
              </span>
              <span
                :show="unreadCount(folder.id) > 0"
                class="ml-2 px-2 font-medium text-gray-800 text-xs dark:text-neutral-200 bg-gray-200 dark:bg-neutral-600 rounded-full"
              >
                {{ unreadCount(folder.id) }}
              </span>
            </button>
          </li>
        </template>
      </ul>
    </nav>

    <section :if="categories.length > 0" class="mt-6 px-4">
      <h3 class="font-semibold text-gray-500 text-xs tracking-wider uppercase dark:text-neutral-400">Categories</h3>
      <nav aria-label="Mail categories" class="mt-2">
        <ul>
          <template :for="category in categories">
            <li class="mb-1">
              <button
                type="button"
                class="flex items-center px-2 py-2 w-full text-gray-700 text-sm dark:text-neutral-300 hover:bg-gray-50 dark:hover:bg-neutral-700 rounded"
                @click="emit('category', category.id)"
              >
                <span :class="'mr-3 h-5 w-5 ' + category.icon"></span>
                <span>{{ category.name }}</span>
                <span
                  :if="category.count > 0"
                  class="ml-auto px-2 font-medium text-gray-800 text-xs dark:text-neutral-200 bg-gray-200 dark:bg-neutral-600 rounded-full"
                >
                  {{ category.count }}
                </span>
              </button>
            </li>
          </template>
        </ul>
      </nav>
    </section>
  </div>
</aside>
