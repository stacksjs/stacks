<script client>
interface SettingsSection {
  id: string
  name: string
  icon: string
}

const activeSection = useReactiveProp('activeSection', 'general')
const sections = useReactiveProp('sections', [] as SettingsSection[])
const emit = defineEmits()

function sectionClass(sectionId: string): string {
  return activeSection() === sectionId
    ? 'bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-100'
    : 'text-gray-700 hover:bg-gray-100 dark:text-neutral-200 dark:hover:bg-neutral-600'
}
</script>

<aside class="overflow-y-auto flex-shrink-0 w-64 bg-white dark:bg-neutral-700 border-gray-200 border-r dark:border-neutral-600">
  <nav aria-label="Mail settings sections" class="p-4">
    <ul class="space-y-1">
      <template :for="section in sections">
        <li>
          <button
            type="button"
            :class="'flex items-center px-3 py-3 w-full text-sm rounded-md ' + sectionClass(section.id)"
            @click="emit('select', section.id)"
          >
            <span :class="section.icon + ' text-lg'"></span>
            <span class="ml-3">{{ section.name }}</span>
          </button>
        </li>
      </template>
    </ul>
  </nav>
</aside>
