<script client>
import type { DashboardInboxEmail } from '../../../../functions/inbox'

const email = useReactiveProp<DashboardInboxEmail | null>('email', null)
const deletePending = useReactiveProp('deletePending', false)
const deleting = useReactiveProp('deleting', false)
const replying = useReactiveProp('replying', false)
const replyText = useReactiveProp('replyText', '')
const canSendReply = useReactiveProp('canSendReply', false)
const emit = defineEmits()

function message(): DashboardInboxEmail | null {
  return email() as DashboardInboxEmail | null
}

function formatDate(value: string): string {
  if (!value)
    return 'Not recorded'
  const date = new Date(value)
  return Number.isNaN(date.getTime())
    ? value
    : new Intl.DateTimeFormat(undefined, { dateStyle: 'long', timeStyle: 'short' }).format(date)
}

</script>

<section :if="message()" aria-label="Selected message" class="flex flex-col w-full md:w-3/5 bg-white dark:bg-neutral-700">
  <div class="flex items-center justify-between px-4 py-2 border-b border-gray-200 dark:border-neutral-600">
    <div class="flex items-center space-x-2 min-w-0">
      <Button variant="ghost" iconOnly ariaLabel="Close message" @click="emit('close')">
        <span class="block h-5 w-5 i-hugeicons-arrow-left-02"></span>
      </Button>
      <h2 class="font-medium text-gray-900 text-lg truncate dark:text-white">{{ message()?.subject }}</h2>
    </div>
    <div class="flex space-x-2">
      <Button variant="ghost" iconOnly :ariaLabel="message()?.read ? 'Mark as unread' : 'Mark as read'" @click="emit('toggle-read')">
        <span :class="'block h-5 w-5 ' + (message()?.read ? 'i-hugeicons-mail-02' : 'i-hugeicons-mail-open-01')"></span>
      </Button>
      <Button variant="ghost" iconOnly ariaLabel="Delete message" @click="emit('request-delete')">
        <span class="block h-5 w-5 i-hugeicons-waste"></span>
      </Button>
    </div>
  </div>

  <div :if="deletePending()" class="flex gap-3 items-center justify-end px-4 py-2 text-sm bg-red-50 dark:bg-red-950/30 border-b border-red-200 dark:border-red-900">
    <span class="mr-auto text-red-800 dark:text-red-200">Permanently delete this email?</span>
    <Button variant="secondary" size="sm" @click="emit('cancel-delete')">Cancel</Button>
    <Button variant="danger" size="sm" :loading="deleting()" @click="emit('confirm-delete')">
      {{ deleting() ? 'Deleting...' : 'Delete' }}
    </Button>
  </div>

  <div class="px-4 py-3 border-b border-gray-200 dark:border-neutral-600">
    <div class="flex items-start justify-between">
      <div class="flex items-center min-w-0">
        <div class="flex flex-shrink-0 items-center justify-center h-10 w-10 font-medium text-gray-700 dark:text-white bg-gray-200 dark:bg-neutral-500 rounded-full">{{ message()?.from?.charAt(0) }}</div>
        <div class="ml-3 min-w-0">
          <p class="font-medium text-gray-900 text-sm truncate dark:text-white">{{ message()?.from }}</p>
          <p class="text-gray-500 text-xs truncate dark:text-neutral-400">{{ message()?.email }}</p>
        </div>
      </div>
      <time class="ml-4 text-gray-500 text-xs whitespace-nowrap dark:text-neutral-400" :datetime="message()?.date || ''">{{ formatDate(message()?.date || '') }}</time>
    </div>
  </div>

  <div class="flex overflow-hidden flex-1 flex-col text-gray-900 dark:text-white">
    <EmailBodyPreview
      :html="message()?.bodyHtml || ''"
      :text="message()?.bodyText || ''"
      :title="message()?.subject || 'Inbound email preview'"
    />
    <div :if="message()?.hasAttachments" class="flex gap-3 items-start mb-4 mx-4 p-3 text-gray-700 text-sm dark:text-neutral-300 bg-gray-50 dark:bg-neutral-800 border border-gray-200 rounded-md dark:border-neutral-600">
      <span class="flex-shrink-0 mt-0.5 h-5 w-5 i-hugeicons-attachment-01"></span>
      <p>This message includes attachments. Attachment downloads are not exposed by the inbox API yet.</p>
    </div>
  </div>

  <div class="p-4 bg-white dark:bg-neutral-700 border-gray-200 border-t dark:border-neutral-600">
    <label for="inbox-reply" class="sr-only">Reply</label>
    <textarea id="inbox-reply" x-model="replyText" placeholder="Reply..." class="block p-3 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-600 border border-gray-300 rounded-md dark:border-neutral-600 focus:outline-none focus:ring-1 focus:ring-blue-500" rows="3" @input="emit('update:reply', $event.target.value)"></textarea>
    <div class="flex justify-end mt-2">
      <Button :disabled="!canSendReply()" :loading="replying()" @click="emit('reply')">
        {{ replying() ? 'Sending...' : 'Send reply' }}
      </Button>
    </div>
  </div>
</section>
