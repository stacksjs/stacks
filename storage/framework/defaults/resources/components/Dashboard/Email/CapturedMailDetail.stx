<script client>
import type { CapturedMailMessage } from '../../../../functions/captured-mail'

const message = useReactiveProp<CapturedMailMessage | null>('message', null)
const loading = useReactiveProp('loading', false)
const error = useReactiveProp('error', '')

function selected(): CapturedMailMessage | null {
  return message()
}

function formatDate(value: string): string {
  const date = new Date(value)
  return Number.isNaN(date.getTime())
    ? 'Not recorded'
    : new Intl.DateTimeFormat(undefined, { dateStyle: 'long', timeStyle: 'short' }).format(date)
}

function formatBytes(value: number): string {
  if (!Number.isFinite(value) || value < 0)
    return 'Not recorded'
  if (value < 1024)
    return `${value} B`
  if (value < 1024 * 1024)
    return `${(value / 1024).toFixed(1)} KB`
  return `${(value / (1024 * 1024)).toFixed(1)} MB`
}
</script>

<section aria-label="Captured message detail" class="flex flex-col w-full md:w-3/5 bg-white dark:bg-neutral-700">
  <div :if="loading()" aria-live="polite" class="flex flex-1 gap-2 items-center justify-center p-8 text-gray-500 text-sm dark:text-neutral-400">
    <span class="h-4 w-4 animate-spin i-hugeicons-loading-03"></span>
    Loading message
  </div>

  <div :if="error() && !loading()" role="alert" class="flex flex-1 flex-col items-center justify-center p-8 text-center">
    <span class="h-9 w-9 text-red-500 i-hugeicons-alert-02"></span>
    <p class="mt-3 font-semibold text-gray-900 dark:text-white">Message could not be loaded</p>
    <p class="mt-1 max-w-md text-red-600 text-sm dark:text-red-300">{{ error() }}</p>
  </div>

  <div :if="!selected() && !loading() && !error()" class="flex flex-1 flex-col items-center justify-center p-8 text-center">
    <span class="h-12 w-12 text-blue-500 i-hugeicons-mail-open-02"></span>
    <h2 class="mt-4 font-semibold text-gray-900 text-lg dark:text-white">Select a captured message</h2>
    <p class="mt-1 max-w-md text-gray-500 text-sm dark:text-neutral-400">Inspect the exact outbound content recorded by the local log mail driver.</p>
  </div>

  <template :if="selected() && !loading() && !error()">
    <header class="px-5 py-4 border-b border-gray-200 dark:border-neutral-600">
      <div class="flex gap-3 items-start justify-between">
        <div class="min-w-0">
          <div class="flex gap-2 items-center">
            <h2 class="font-semibold text-gray-900 text-lg truncate dark:text-white">{{ selected()?.subject }}</h2>
            <Badge :variant="selected()?.source === 'memory' ? 'success' : 'info'">{{ selected()?.source }}</Badge>
          </div>
          <p class="mt-2 text-gray-600 text-sm dark:text-neutral-300"><span class="font-medium">From:</span> {{ selected()?.from }}</p>
          <p class="mt-1 text-gray-600 text-sm dark:text-neutral-300"><span class="font-medium">To:</span> {{ selected()?.to }}</p>
          <p :if="selected()?.cc" class="mt-1 text-gray-600 text-sm dark:text-neutral-300"><span class="font-medium">Cc:</span> {{ selected()?.cc }}</p>
          <p :if="selected()?.bcc" class="mt-1 text-gray-600 text-sm dark:text-neutral-300"><span class="font-medium">Bcc:</span> {{ selected()?.bcc }}</p>
        </div>
        <div class="flex-shrink-0 text-right">
          <time class="block text-gray-500 text-xs dark:text-neutral-400" :datetime="selected()?.sentAt || ''">{{ formatDate(selected()?.sentAt || '') }}</time>
          <span class="block mt-1 text-gray-400 text-xs dark:text-neutral-500">{{ formatBytes(selected()?.size || 0) }}</span>
        </div>
      </div>
    </header>

    <div class="overflow-y-auto flex-1 bg-gray-50 dark:bg-neutral-800">
      <iframe
        :if="selected()?.html"
        title="Captured email preview"
        :srcdoc="selected()?.html || ''"
        sandbox=""
        referrerpolicy="no-referrer"
        class="block min-h-[36rem] w-full bg-white border-0"
      ></iframe>
      <pre :if="!selected()?.html && selected()?.text" class="p-6 font-sans text-gray-900 text-sm whitespace-pre-wrap dark:text-neutral-100">{{ selected()?.text }}</pre>
      <p :if="!selected()?.html && !selected()?.text" class="p-8 text-center text-gray-500 text-sm dark:text-neutral-400">This capture has no message body.</p>
    </div>
  </template>
</section>
