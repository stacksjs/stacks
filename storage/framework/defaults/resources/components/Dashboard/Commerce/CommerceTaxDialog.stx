<script client>
import type { TaxRateRecord } from '../../../../app/Actions/Dashboard/Commerce/tax-rate-records'

const open = useReactiveProp('open', false)
const mode = useReactiveProp('mode', 'add')
const record = useReactiveProp('record', null as TaxRateRecord | null)
const types = useReactiveProp('types', [] as string[])
const busy = useReactiveProp('busy', false)
const emit = defineEmits()
const name = state('')
const rate = state(0)
const type = state('')
const country = state('')
const region = state('North America')
const status = state<'active' | 'inactive'>('active')
const isDefault = state(false)
let hydrationKey = ''

const regions = ['North America', 'South America', 'Europe', 'Asia', 'Africa', 'Oceania', 'Antarctica'] as const

effect(() => {
  if (!open()) {
    hydrationKey = ''
    return
  }
  const current = record()
  const key = `${mode()}:${current?.id || 'new'}`
  if (hydrationKey === key)
    return
  hydrationKey = key
  name.set(current?.name || '')
  rate.set(current?.rate || 0)
  type.set(current?.type || '')
  country.set(current?.country || '')
  region.set(current?.region || 'North America')
  status.set(current?.status || 'active')
  isDefault.set(current?.isDefault || false)
})

function updateName(event: Event): void {
  name.set((event.target as HTMLInputElement).value)
}

function updateType(event: Event): void {
  type.set((event.target as HTMLInputElement).value)
}

function updateCountry(event: Event): void {
  country.set((event.target as HTMLInputElement).value)
}

function updateRate(event: Event): void {
  rate.set(Number((event.target as HTMLInputElement).value))
}

function updateRegion(event: Event): void {
  region.set((event.target as HTMLSelectElement).value)
}

function updateStatus(event: Event): void {
  status.set((event.target as HTMLSelectElement).value as 'active' | 'inactive')
}

function updateDefault(event: Event): void {
  isDefault.set((event.target as HTMLInputElement).checked)
}

function submit(): void {
  if (!name().trim() || !type().trim() || !country().trim() || rate() < 0 || rate() > 100)
    return
  emit('submit', {
    name: name().trim(),
    rate: rate(),
    type: type().trim(),
    country: country().trim(),
    region: region(),
    status: status(),
    isDefault: isDefault(),
  })
}
</script>

<div :if="open()" class="flex fixed inset-0 z-50 items-center justify-center p-4">
  <button type="button" aria-label="Close tax rate dialog" class="absolute inset-0 bg-black/45" @click="emit('close')"></button>
  <section role="dialog" aria-modal="true" aria-labelledby="tax-rate-dialog-title" class="relative max-w-lg w-full bg-white dark:bg-neutral-800 border border-gray-200 rounded-xl dark:border-neutral-700 shadow-xl">
    <form @submit.prevent="submit">
      <div class="p-6">
        <h2 id="tax-rate-dialog-title" class="font-semibold text-gray-900 text-lg dark:text-white">{{ mode() === 'edit' ? 'Edit tax rate' : 'Add tax rate' }}</h2>
        <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">All fields follow the TaxRate model validation rules.</p>
        <div class="mt-5 space-y-4">
          <label class="block">
            <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Name</span>
            <input :value="name()" type="text" maxlength="255" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @input="updateName($event)" />
          </label>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Rate (%)</span>
              <input :value="rate()" type="number" min="0" max="100" step="0.01" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @input="updateRate($event)" />
            </label>
            <label class="block">
              <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Type</span>
              <input :value="type()" type="text" list="tax-rate-types" maxlength="100" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @input="updateType($event)" />
              <datalist id="tax-rate-types"><template :for="taxType in types()" :key="taxType"><option :value="taxType"></option></template></datalist>
            </label>
          </div>
          <label class="block">
            <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Country</span>
            <input :value="country()" type="text" maxlength="100" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @input="updateCountry($event)" />
          </label>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Region</span>
              <select :value="region()" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @change="updateRegion($event)">
                <template :for="regionOption in regions" :key="regionOption"><option :value="regionOption">{{ regionOption }}</option></template>
              </select>
            </label>
            <label class="block">
              <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Status</span>
              <select :value="status()" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @change="updateStatus($event)">
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
              </select>
            </label>
          </div>
          <label class="flex gap-3 items-start p-3 border border-gray-200 rounded-lg dark:border-neutral-700">
            <input type="checkbox" :checked="isDefault()" class="mt-0.5 h-4 w-4 text-blue-600 border-gray-300 rounded" @change="updateDefault($event)" />
            <span>
              <span class="block font-medium text-gray-700 text-sm dark:text-neutral-200">Default tax rate</span>
              <span class="block mt-0.5 text-gray-500 text-xs dark:text-neutral-400">Selecting this clears the default flag from every other rate.</span>
            </span>
          </label>
        </div>
      </div>
      <footer class="flex gap-2 justify-end px-6 py-4 bg-gray-50 dark:bg-neutral-900/50 border-gray-200 border-t dark:border-neutral-700">
        <button type="button" :disabled="busy()" class="px-3 py-2 font-semibold text-gray-700 text-sm dark:text-neutral-200 bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700 disabled:opacity-50" @click="emit('close')">Cancel</button>
        <button type="submit" :disabled="busy() || !name().trim() || !type().trim() || !country().trim() || rate() < 0 || rate() > 100" class="inline-flex items-center px-3 py-2 font-semibold text-sm text-white bg-blue-600 hover:bg-blue-500 rounded-md disabled:opacity-50">
          <span :if="busy()" class="mr-2 h-4 w-4 animate-spin i-hugeicons-loading-03"></span>
          {{ mode() === 'edit' ? 'Save tax rate' : 'Add tax rate' }}
        </button>
      </footer>
    </form>
  </section>
</div>
