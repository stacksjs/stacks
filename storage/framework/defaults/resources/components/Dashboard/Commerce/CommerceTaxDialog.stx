<script client>
import type { TaxRateRecord } from '../../../../app/Actions/Dashboard/Commerce/tax-rate-records'
import { formErrorMessages } from '../../../../functions/dashboard-form'

const open = useReactiveProp('open', false)
const mode = useReactiveProp('mode', 'add')
const record = useReactiveProp('record', null as TaxRateRecord | null)
const types = useReactiveProp('types', [] as string[])
const busy = useReactiveProp('busy', false)
const errors = useReactiveProp('errors', {} as Record<string, string>)
const emit = defineEmits(['submit', 'close'])
const name = state('')
const rate = state(0)
const type = state('')
const country = state('')
const region = state('North America')
const status = state<'active' | 'inactive'>('active')
const isDefault = state(false)
const code = state('')
const exemptible = state(false)
let hydrationKey = ''

const regions = ['North America', 'South America', 'Europe', 'Asia', 'Africa', 'Oceania', 'Antarctica'] as const

effect(() => {
  if (!open()) {
    hydrationKey = ''
    return
  }
  const current = record()
  const key = `${mode()}:${current?.id || 'new'}`
  if (hydrationKey === key)
    return
  hydrationKey = key
  name.set(current?.name || '')
  rate.set(current?.rate || 0)
  type.set(current?.type || '')
  country.set(current?.country || '')
  region.set(current?.region || 'North America')
  status.set(current?.status || 'active')
  isDefault.set(current?.isDefault || false)
  code.set(current?.code || '')
  exemptible.set(current?.exemptible || false)
})

function submit(): void {
  if (!name().trim() || !type().trim() || !country().trim() || rate() < 0 || rate() > 100)
    return
  emit('submit', {
    name: name().trim(),
    rate: rate(),
    type: type().trim(),
    country: country().trim(),
    region: region(),
    status: status(),
    isDefault: isDefault(),
    code: code().trim(),
    exemptible: exemptible(),
  })
}

function errorMessages(): string[] {
  return formErrorMessages(errors())
}
</script>

<Modal
  :isOpen="open()"
  :title="mode() === 'edit' ? 'Edit tax rate' : 'Add tax rate'"
  description="All fields follow the TaxRate model validation rules."
  size="md"
  @close="emit('close')"
>
    <form id="tax-rate-form" @submit.prevent="submit">
        <ul :if="errorMessages().length > 0" class="mb-5 p-3 space-y-1 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">
          <li :for="message in errorMessages()" :key="message">{{ message }}</li>
        </ul>
        <div class="space-y-4">
          <label class="block">
            <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Name</span>
            <input x-model="name" type="text" maxlength="255" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" />
          </label>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Rate (%)</span>
              <input x-model.number="rate" type="number" min="0" max="100" step="0.01" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" />
            </label>
            <label class="block">
              <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Type</span>
              <input x-model="type" type="text" list="tax-rate-types" maxlength="100" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" />
              <datalist id="tax-rate-types"><option :for="taxType in types()" :key="taxType" :value="taxType"></option></datalist>
            </label>
          </div>
          <label class="block">
            <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Country</span>
            <input x-model="country" type="text" maxlength="100" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" />
          </label>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Region</span>
              <select x-model="region" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700">
                <option :for="regionOption in regions" :key="regionOption" :value="regionOption">{{ regionOption }}</option>
              </select>
            </label>
            <label class="block">
              <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Status</span>
              <select x-model="status" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700">
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
              </select>
            </label>
          </div>
          <label class="block">
            <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Code</span>
            <input x-model="code" type="text" placeholder="sales" class="mt-1 px-3 py-2 w-full font-mono text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" />
            <span class="block mt-1 text-gray-500 text-xs dark:text-neutral-400">What the application matches on. Renaming the rate above does not change what is charged; changing this can.</span>
          </label>
          <div class="p-3 border border-gray-200 rounded-lg dark:border-neutral-700">
            <Toggle v-model:checked="isDefault" label="Default tax rate" description="Selecting this clears the default flag from every other rate." labelPosition="left" />
          </div>
          {{--
            Spelled out rather than labelled "exempt", because the two read
            alike and mean opposite things: this marks the component as one an
            exemption can lift, not one that is currently unpaid.
          --}}
          <div class="p-3 border border-gray-200 rounded-lg dark:border-neutral-700">
            <Toggle v-model:checked="exemptible" label="Can be exempted" description="Customers who qualify for an exemption are not charged this component. Leave off for anything owed regardless - an excise or a city levy is usually still due." labelPosition="left" />
          </div>
        </div>
    </form>
  <template #footer>
    <div class="flex gap-2 justify-end w-full">
        <Button variant="secondary" :disabled="busy()" @click="emit('close')">Cancel</Button>
        <Button type="submit" form="tax-rate-form" :loading="busy()" :disabled="!name().trim() || !type().trim() || !country().trim() || rate() < 0 || rate() > 100">
          {{ mode() === 'edit' ? 'Save tax rate' : 'Add tax rate' }}
        </Button>
    </div>
  </template>
</Modal>
