<script client>
import type {
  PrintDeviceRecord,
  PrintDeviceSummary,
  PrintDeviceStatus,
} from '../../../../app/Actions/Dashboard/Commerce/print-device-records'
import { DashboardApiError, dashboardApi } from '../../../../functions/dashboard-api'
import { pushToast } from '../../../../functions/toasts'

interface PrintDevicesResponse {
  records: PrintDeviceRecord[]
  summary: PrintDeviceSummary
}

interface PrintDeviceWritePayload {
  name: string
  macAddress: string
  location: string
  terminal: string
  status: PrintDeviceStatus
}

const emptySummary: PrintDeviceSummary = {
  total: 0,
  online: 0,
  offline: 0,
  warning: 0,
  locations: 0,
  totalPrints: 0,
}
const records = state<PrintDeviceRecord[]>([])
const summary = state<PrintDeviceSummary>({ ...emptySummary })
const search = state('')
const statusFilter = state('all')
const locationFilter = state('all')
const sort = state('name')
const page = state(1)
const pageSize = 20
const loading = state(true)
const loadError = state('')
const dialogOpen = state(false)
const dialogMode = state<'add' | 'edit'>('add')
const editingRecord = state<PrintDeviceRecord | null>(null)
const detailsRecord = state<PrintDeviceRecord | null>(null)
const deletingRecord = state<PrintDeviceRecord | null>(null)
const saving = state(false)
const deleting = state(false)
const validationErrors = state<Record<string, string>>({})

function locations(): string[] {
  return [...new Set(records().map(record => record.location).filter(Boolean))].sort()
}

function filteredRecords(): PrintDeviceRecord[] {
  const query = search().trim().toLowerCase()
  const selectedStatus = statusFilter()
  const selectedLocation = locationFilter()
  return [...records()]
    .filter((record) => {
      if (selectedStatus !== 'all' && record.status !== selectedStatus)
        return false
      if (selectedLocation !== 'all' && record.location !== selectedLocation)
        return false
      return !query || [record.name, record.macAddress, record.location, record.terminal]
        .some(value => value.toLowerCase().includes(query))
    })
    .sort((left, right) => {
      if (sort() === 'prints')
        return right.printCount - left.printCount || left.name.localeCompare(right.name)
      if (sort() === 'heartbeat')
        return right.lastPing - left.lastPing || left.name.localeCompare(right.name)
      if (sort() === 'status')
        return left.status.localeCompare(right.status) || left.name.localeCompare(right.name)
      return left.name.localeCompare(right.name)
    })
}

function pageCount(): number {
  return Math.max(1, Math.ceil(filteredRecords().length / pageSize))
}

function visibleRecords(): PrintDeviceRecord[] {
  const selectedPage = Math.min(page(), pageCount())
  return filteredRecords().slice((selectedPage - 1) * pageSize, selectedPage * pageSize)
}

function metricCards(): Array<{ label: string, value: string, detail: string }> {
  const current = summary()
  const health = current.total ? Math.round((current.online / current.total) * 100) : 0
  return [
    { label: 'Print devices', value: String(current.total), detail: `${current.locations} active locations` },
    { label: 'Online', value: String(current.online), detail: `${health}% of registered devices` },
    { label: 'Needs attention', value: String(current.warning + current.offline), detail: `${current.warning} warning, ${current.offline} offline` },
    { label: 'Recorded prints', value: current.totalPrints.toLocaleString(), detail: 'Across registered devices' },
  ]
}

function exportHref(): string {
  const rows = filteredRecords().map(record => [
    record.name,
    record.macAddress,
    record.location,
    record.terminal,
    record.status,
    new Date(record.lastPing).toISOString(),
    String(record.printCount),
  ])
  const escape = (value: string): string => `"${value.replaceAll('"', '""')}"`
  const csv = [
    ['Name', 'MAC address', 'Location', 'Terminal', 'Status', 'Last heartbeat', 'Print count'],
    ...rows,
  ].map(row => row.map(escape).join(',')).join('\n')
  return `data:text/csv;charset=utf-8,${encodeURIComponent(`\uFEFF${csv}`)}`
}

function exportFilename(): string {
  return `print-devices-${new Date().toISOString().slice(0, 10)}.csv`
}

effect(() => {
  search()
  statusFilter()
  locationFilter()
  sort()
  page.set(1)
})

async function loadPrintDevices(): Promise<void> {
  loading.set(true)
  loadError.set('')
  try {
    const data = await dashboardApi<PrintDevicesResponse>('/api/dashboard/commerce/print-devices')
    records.set(Array.isArray(data.records) ? data.records : [])
    summary.set(data.summary ?? { ...emptySummary })
    page.set(Math.min(page(), Math.max(1, Math.ceil((data.records?.length || 0) / pageSize))))
  }
  catch (error) {
    loadError.set('Print devices could not be loaded.')
    pushToast('error', 'Could not load print devices', {
      detail: error instanceof Error ? error.message : String(error),
    })
  }
  finally {
    loading.set(false)
  }
}

function openAdd(): void {
  dialogMode.set('add')
  editingRecord.set(null)
  validationErrors.set({})
  dialogOpen.set(true)
}

function openEdit(record: PrintDeviceRecord): void {
  dialogMode.set('edit')
  editingRecord.set(record)
  validationErrors.set({})
  dialogOpen.set(true)
}

function closeDialog(): void {
  if (saving())
    return
  dialogOpen.set(false)
  editingRecord.set(null)
  validationErrors.set({})
}

async function savePrintDevice(payload: PrintDeviceWritePayload): Promise<void> {
  const current = editingRecord()
  const editing = dialogMode() === 'edit' && current !== null
  const path = editing ? `/api/dashboard/commerce/print-devices/${current.id}` : '/api/dashboard/commerce/print-devices'
  saving.set(true)
  validationErrors.set({})
  try {
    await dashboardApi(path, {
      method: editing ? 'PATCH' : 'POST',
      body: payload,
    })
    dialogOpen.set(false)
    editingRecord.set(null)
    pushToast('success', editing ? 'Print device updated' : 'Print device added')
    await loadPrintDevices()
  }
  catch (error) {
    if (error instanceof DashboardApiError)
      validationErrors.set(error.fields ?? {})
    pushToast('error', 'Could not save print device', {
      detail: error instanceof Error ? error.message : String(error),
    })
  }
  finally {
    saving.set(false)
  }
}

function openDetails(record: PrintDeviceRecord): void {
  detailsRecord.set(record)
}

function closeDetails(): void {
  detailsRecord.set(null)
}

function openDelete(record: PrintDeviceRecord): void {
  deletingRecord.set(record)
}

function closeDelete(): void {
  if (!deleting())
    deletingRecord.set(null)
}

async function deletePrintDevice(): Promise<void> {
  const current = deletingRecord()
  if (!current)
    return
  deleting.set(true)
  try {
    await dashboardApi(`/api/dashboard/commerce/print-devices/${current.id}`, { method: 'DELETE' })
    deletingRecord.set(null)
    detailsRecord.set(null)
    pushToast('success', 'Print device deleted', { detail: current.name })
    await loadPrintDevices()
  }
  catch (error) {
    pushToast('error', 'Could not delete print device', {
      detail: error instanceof Error ? error.message : String(error),
    })
  }
  finally {
    deleting.set(false)
  }
}

function previousPage(): void {
  page.set(Math.max(1, page() - 1))
}

function nextPage(): void {
  page.set(Math.min(pageCount(), page() + 1))
}

onMount(() => {
  void loadPrintDevices()
})
</script>

<div class="space-y-6">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="font-bold text-2xl text-gray-900 dark:text-white">Receipt printers</h1>
      <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Manage native PrintDevice records and inspect their persisted operational state.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <Button variant="secondary" :loading="loading()" @click="loadPrintDevices"><span :if="!loading()" class="h-4 w-4 i-hugeicons-refresh"></span>Refresh</Button>
      <Button tag="a" variant="secondary" :href="exportHref()" :download="exportFilename()"><span class="h-4 w-4 i-hugeicons-download-04"></span>Export filtered</Button>
      <Button @click="openAdd()"><span class="h-4 w-4 i-hugeicons-add-01"></span>Add printer</Button>
    </div>
  </header>

  <div :if="loadError()" class="p-4 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">{{ loadError() }}</div>

  <section aria-label="Print device metrics" class="grid gap-3 grid-cols-2 lg:grid-cols-4">
    <template :for="item in metricCards()" :key="item.label">
      <article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
        <p class="text-gray-500 text-xs dark:text-neutral-400">{{ item.label }}</p>
        <p class="mt-2 font-semibold text-2xl text-gray-900 dark:text-white">{{ item.value }}</p>
        <p class="mt-1 text-gray-400 text-xs dark:text-neutral-500">{{ item.detail }}</p>
      </article>
    </template>
  </section>

  <PrintDeviceBreakdown :records="records()" />

  <section class="space-y-3">
    <div class="grid gap-3 grid-cols-1 sm:grid-cols-2 xl:grid-cols-5">
      <label class="relative sm:col-span-2">
        <span class="sr-only">Search print devices</span>
        <span class="flex absolute inset-y-0 left-0 items-center pl-3 text-gray-400 pointer-events-none"><span class="h-4 w-4 i-hugeicons-search-01"></span></span>
        <input x-model="search" type="search" placeholder="Search printers, locations, or terminals" class="pl-9 pr-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700" />
      </label>
      <label><span class="sr-only">Printer status</span><select x-model="statusFilter" class="px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700"><option value="all">All statuses</option><option value="online">Online</option><option value="warning">Warning</option><option value="offline">Offline</option></select></label>
      <label><span class="sr-only">Printer location</span><select x-model="locationFilter" class="px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700"><option value="all">All locations</option><template :for="location in locations()" :key="location"><option :value="location">{{ location }}</option></template></select></label>
      <label><span class="sr-only">Sort print devices</span><select x-model="sort" class="px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700"><option value="name">Name</option><option value="prints">Most prints</option><option value="heartbeat">Recent heartbeat</option><option value="status">Status</option></select></label>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-gray-500 text-sm dark:text-neutral-400">{{ filteredRecords().length }} matching print devices</p>
      <div class="flex gap-2 items-center">
        <Button variant="secondary" size="sm" :disabled="page() <= 1" @click="previousPage()">Previous</Button>
        <span class="text-gray-500 text-sm dark:text-neutral-400">Page {{ Math.min(page(), pageCount()) }} of {{ pageCount() }}</span>
        <Button variant="secondary" size="sm" :disabled="page() >= pageCount()" @click="nextPage()">Next</Button>
      </div>
    </div>

    <PrintDevicesTable :records="visibleRecords()" :loading="loading()" @view="openDetails" @edit="openEdit" @delete="openDelete" />
  </section>
</div>

<PrintDeviceDialog :open="dialogOpen()" :mode="dialogMode()" :record="editingRecord()" :busy="saving()" :errors="validationErrors()" @submit="savePrintDevice" @close="closeDialog()" />
<PrintDeviceDetailsDialog :open="Boolean(detailsRecord())" :record="detailsRecord()" @edit="openEdit" @delete="openDelete" @close="closeDetails()" />
<PrintDeviceDeleteDialog :open="Boolean(deletingRecord())" :record="deletingRecord()" :busy="deleting()" @confirm="deletePrintDevice()" @close="closeDelete()" />
