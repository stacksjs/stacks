<script client>
import type {
  ProductUnitOption,
  ProductUnitRecord,
} from '../../../../app/Actions/Dashboard/Commerce/product-unit-records'

const open = useReactiveProp('open', false)
const mode = useReactiveProp('mode', 'add')
const record = useReactiveProp('record', null as ProductUnitRecord | null)
const products = useReactiveProp('products', [] as ProductUnitOption[])
const types = useReactiveProp('types', [] as string[])
const busy = useReactiveProp('busy', false)
const emit = defineEmits()
const name = state('')
const abbreviation = state('')
const type = state('')
const description = state('')
const productId = state('')
const isDefault = state(false)
let hydrationKey = ''

effect(() => {
  if (!open()) {
    hydrationKey = ''
    return
  }
  const current = record()
  const key = `${mode()}:${current?.id || 'new'}`
  if (hydrationKey === key)
    return
  hydrationKey = key
  name.set(current?.name || '')
  abbreviation.set(current?.abbreviation || '')
  type.set(current?.type || '')
  description.set(current?.description || '')
  productId.set(current?.productId || '')
  isDefault.set(current?.isDefault || false)
})

function updateName(event: Event): void {
  name.set((event.target as HTMLInputElement).value)
}

function updateAbbreviation(event: Event): void {
  abbreviation.set((event.target as HTMLInputElement).value)
}

function updateType(event: Event): void {
  type.set((event.target as HTMLInputElement).value)
}

function updateDescription(event: Event): void {
  description.set((event.target as HTMLTextAreaElement).value)
}

function updateProduct(event: Event): void {
  productId.set((event.target as HTMLSelectElement).value)
}

function updateDefault(event: Event): void {
  isDefault.set((event.target as HTMLInputElement).checked)
}

function submit(): void {
  if (!name().trim() || !abbreviation().trim() || !type().trim())
    return
  emit('submit', {
    name: name().trim(),
    abbreviation: abbreviation().trim(),
    type: type().trim(),
    description: description().trim(),
    productId: productId() ? Number(productId()) : null,
    isDefault: isDefault(),
  })
}
</script>

<div :if="open()" class="flex fixed inset-0 z-50 items-center justify-center p-4">
  <button type="button" aria-label="Close product unit dialog" class="absolute inset-0 bg-black/45" @click="emit('close')"></button>
  <section role="dialog" aria-modal="true" aria-labelledby="product-unit-dialog-title" class="relative max-w-lg w-full bg-white dark:bg-neutral-800 border border-gray-200 rounded-xl dark:border-neutral-700 shadow-xl">
    <form @submit.prevent="submit">
      <div class="p-6">
        <h2 id="product-unit-dialog-title" class="font-semibold text-gray-900 text-lg dark:text-white">{{ mode() === 'edit' ? 'Edit product unit' : 'Add product unit' }}</h2>
        <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Fields and relationships come from the ProductUnit model.</p>
        <div class="mt-5 space-y-4">
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Name</span>
              <input :value="name()" type="text" maxlength="100" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @input="updateName($event)" />
            </label>
            <label class="block">
              <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Abbreviation</span>
              <input :value="abbreviation()" type="text" maxlength="10" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @input="updateAbbreviation($event)" />
            </label>
          </div>
          <label class="block">
            <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Type</span>
            <input :value="type()" type="text" list="product-unit-types" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @input="updateType($event)" />
            <datalist id="product-unit-types">
              <template :for="unitType in types()" :key="unitType">
                <option :value="unitType"></option>
              </template>
            </datalist>
          </label>
          <label class="block">
            <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Product</span>
            <select :value="productId()" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @change="updateProduct($event)">
              <option value="">Unassigned</option>
              <template :for="product in products()" :key="product.id">
                <option :value="product.id">{{ product.name }}</option>
              </template>
            </select>
          </label>
          <label class="block">
            <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Description</span>
            <textarea :value="description()" rows="3" maxlength="255" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @input="updateDescription($event)"></textarea>
          </label>
          <label class="flex gap-3 items-start p-3 border border-gray-200 rounded-lg dark:border-neutral-700">
            <input type="checkbox" :checked="isDefault()" class="mt-0.5 h-4 w-4 text-blue-600 border-gray-300 rounded" @change="updateDefault($event)" />
            <span>
              <span class="block font-medium text-gray-700 text-sm dark:text-neutral-200">Default for this type</span>
              <span class="block mt-0.5 text-gray-500 text-xs dark:text-neutral-400">Selecting this clears any other default in the same unit type.</span>
            </span>
          </label>
        </div>
      </div>
      <footer class="flex gap-2 justify-end px-6 py-4 bg-gray-50 dark:bg-neutral-900/50 border-gray-200 border-t dark:border-neutral-700">
        <button type="button" :disabled="busy()" class="px-3 py-2 font-semibold text-gray-700 text-sm dark:text-neutral-200 bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700 disabled:opacity-50" @click="emit('close')">Cancel</button>
        <button type="submit" :disabled="busy() || !name().trim() || !abbreviation().trim() || !type().trim()" class="inline-flex items-center px-3 py-2 font-semibold text-sm text-white bg-blue-600 hover:bg-blue-500 rounded-md disabled:opacity-50">
          <span :if="busy()" class="mr-2 h-4 w-4 animate-spin i-hugeicons-loading-03"></span>
          {{ mode() === 'edit' ? 'Save product unit' : 'Add product unit' }}
        </button>
      </footer>
    </form>
  </section>
</div>
