<script client>
import type { ProductChoice } from '../../../../app/Actions/Dashboard/Commerce/commerce-choice-records'
import type { ProductUnitRecord } from '../../../../app/Actions/Dashboard/Commerce/product-unit-records'
import { dashboardApi } from '../../../../functions/dashboard-api'
import { formErrorMessages } from '../../../../functions/dashboard-form'

const open = useReactiveProp('open', false)
const mode = useReactiveProp('mode', 'add')
const record = useReactiveProp('record', null as ProductUnitRecord | null)
const types = useReactiveProp('types', [] as string[])
const busy = useReactiveProp('busy', false)
const errors = useReactiveProp('errors', {} as Record<string, string>)
const emit = defineEmits(['submit', 'close'])
const name = state('')
const abbreviation = state('')
const type = state('')
const description = state('')
const productId = state('')
const isDefault = state(false)
let hydrationKey = ''

// The product choices are a server search (stacksjs/stacks#3218): this used
// to be handed the first 500 products by name, so a unit could not be given
// any later product.
const productChoices = state<ProductChoice[]>([])
const productMatches = state(0)
const productQuery = state('')
let productRequest = 0
let productTimer: ReturnType<typeof setTimeout> | null = null

async function loadProducts(term: string): Promise<void> {
  const request = ++productRequest
  const params = new URLSearchParams()
  if (term)
    params.set('q', term)
  let found: ProductChoice[] = []
  let count = 0
  try {
    const data = await dashboardApi<{ choices?: ProductChoice[], total?: number }>(`/api/dashboard/commerce/product-choices${term ? `?${params}` : ''}`)
    found = Array.isArray(data.choices) ? data.choices : []
    count = Number(data.total) || found.length
  }
  catch {
    // Soft-fail: the unit's own product stays selectable.
  }
  if (request !== productRequest)
    return
  productChoices.set(found)
  productMatches.set(count)
}

function searchProductsSoon(): void {
  if (productTimer)
    clearTimeout(productTimer)
  productTimer = setTimeout(() => { void loadProducts(productQuery().trim()) }, 250)
}

/** The choices to show: the search results, with the unit's own product kept in. */
function products(): ProductChoice[] {
  const found = productChoices()
  const current = record()
  if (!current?.productId || found.some(choice => choice.id === current.productId))
    return found
  return [{ id: current.productId, label: current.productName || `Product ${current.productId}`, detail: '' }, ...found]
}

function moreProductsLabel(): string {
  const shown = productChoices().length
  const total = productMatches()
  return total > shown ? `Showing ${shown} of ${total.toLocaleString()} matching products. Search to narrow it down.` : ''
}

effect(() => {
  if (!open()) {
    hydrationKey = ''
    return
  }
  const current = record()
  const key = `${mode()}:${current?.id || 'new'}`
  if (hydrationKey === key)
    return
  hydrationKey = key
  name.set(current?.name || '')
  abbreviation.set(current?.abbreviation || '')
  type.set(current?.type || '')
  description.set(current?.description || '')
  productId.set(current?.productId || '')
  isDefault.set(current?.isDefault || false)
  productQuery.set('')
  void loadProducts('')
})

function submit(): void {
  if (!name().trim() || !abbreviation().trim() || !type().trim())
    return
  emit('submit', {
    name: name().trim(),
    abbreviation: abbreviation().trim(),
    type: type().trim(),
    description: description().trim(),
    productId: productId() ? Number(productId()) : null,
    isDefault: isDefault(),
  })
}

function errorMessages(): string[] {
  return formErrorMessages(errors())
}
</script>

<Modal
  :isOpen="open()"
  :title="mode() === 'edit' ? 'Edit product unit' : 'Add product unit'"
  description="Fields and relationships come from the ProductUnit model."
  size="md"
  @close="emit('close')"
>
    <form id="product-unit-form" @submit.prevent="submit">
        <ul :if="errorMessages().length > 0" class="mb-5 p-3 space-y-1 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">
          <template :for="message in errorMessages()" :key="message"><li>{{ message }}</li></template>
        </ul>
        <div class="space-y-4">
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Name</span>
              <input x-model="name" type="text" maxlength="100" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" />
            </label>
            <label class="block">
              <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Abbreviation</span>
              <input x-model="abbreviation" type="text" maxlength="10" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" />
            </label>
          </div>
          <label class="block">
            <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Type</span>
            <input x-model="type" type="text" list="product-unit-types" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" />
            <datalist id="product-unit-types">
              <template :for="unitType in types()" :key="unitType">
                <option :value="unitType"></option>
              </template>
            </datalist>
          </label>
          <label class="block">
            <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Product</span>
            <input x-model="productQuery" @input="searchProductsSoon()" type="search" name="product_search" aria-label="Search products by name or id" placeholder="Search by name or id" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" />
          </label>
          <div>
            <select x-model="productId" aria-label="Product" class="px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700">
              <option value="">Unassigned</option>
              <template :for="product in products()" :key="product.id">
                <option :value="product.id" :selected="product.id === productId()">{{ product.label }}</option>
              </template>
            </select>
            <p :if="moreProductsLabel()" class="mt-1 text-gray-500 text-xs dark:text-neutral-400" :text="moreProductsLabel()"></p>
          </div>
          <label class="block">
            <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Description</span>
            <textarea x-model="description" rows="3" maxlength="255" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700"></textarea>
          </label>
          <label class="flex gap-3 items-start p-3 border border-gray-200 rounded-lg dark:border-neutral-700">
            <input x-model="isDefault" type="checkbox" class="mt-0.5 h-4 w-4 text-blue-600 border-gray-300 rounded" />
            <span>
              <span class="block font-medium text-gray-700 text-sm dark:text-neutral-200">Default for this type</span>
              <span class="block mt-0.5 text-gray-500 text-xs dark:text-neutral-400">Selecting this clears any other default in the same unit type.</span>
            </span>
          </label>
        </div>
    </form>
  <template #footer>
    <div class="flex gap-2 justify-end w-full">
        <Button variant="secondary" :disabled="busy()" @click="emit('close')">Cancel</Button>
        <Button type="submit" form="product-unit-form" :loading="busy()" :disabled="!name().trim() || !abbreviation().trim() || !type().trim()">
          {{ mode() === 'edit' ? 'Save product unit' : 'Add product unit' }}
        </Button>
    </div>
  </template>
</Modal>
