@import('../UI/Pagination')

<script client>
import type { CommercePosProduct } from '../../../../app/Actions/Dashboard/Commerce/commerce-pos'
import type { ProductOption } from '../../../../app/Actions/Dashboard/Commerce/commerce-product-records'
import { formatCurrency } from '@stacksjs/commerce/money'

const products = useReactiveProp('products', [] as CommercePosProduct[])
const categories = useReactiveProp('categories', [] as ProductOption[])
const search = useReactiveProp('search', '')
const category = useReactiveProp('category', 'all')
const availability = useReactiveProp('availability', 'sellable')
const currency = useReactiveProp('currency', 'USD')
const loading = useReactiveProp('loading', false)
/**
 * The server searches and pages the catalogue (stacksjs/stacks#3218): how
 * many products match, the page shown and its size.
 */
const total = useReactiveProp('total', 0)
const currentPage = useReactiveProp('currentPage', 1)
const perPage = useReactiveProp('perPage', 50)
const emit = defineEmits(['search', 'category', 'availability', 'add', 'page'])

function changePage(page: number): void {
  emit('page', page)
}

function initials(name: string): string {
  return name.split(/\s+/).filter(Boolean).slice(0, 2).map(part => part[0]?.toUpperCase() || '').join('') || 'PR'
}

function formatMoney(value: number): string {
  return formatCurrency(value, currency())
}

function sellable(product: CommercePosProduct): boolean {
  return product.isAvailable && product.inventoryCount > 0
}
</script>

<section class="min-w-0">
  <div class="grid gap-3 grid-cols-1 sm:grid-cols-2 xl:grid-cols-4">
    <div class="sm:col-span-2"><SearchFilter v-model:searchValue="search" placeholder="Search products, categories, or allergens" ariaLabel="Search point of sale products" @search="emit('search', $event)" /></div>
    <Select v-model:value="category" ariaLabel="Product category" placeholder="" :options="[{ value: 'all', label: 'Any category' }, ...categories().map(option => ({ value: option.id, label: option.label }))]" @change="emit('category', $event)" />
    <Select v-model:value="availability" ariaLabel="Product availability" placeholder="" :options="[{ value: 'sellable', label: 'Sellable products' }, { value: 'all', label: 'All products' }, { value: 'unavailable', label: 'Unavailable or sold out' }]" @change="emit('availability', $event)" />
  </div>

  <div :if="loading()" class="flex items-center justify-center mt-4 py-24 text-gray-500 text-sm dark:text-neutral-400 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700"><span class="mr-2 h-4 w-4 animate-spin i-hugeicons-loading-03"></span>Loading persisted products</div>
  <div :if="!loading() && products().length === 0" class="mt-4 py-24 text-center bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
    <div class="mb-3 mx-auto h-8 w-8 text-gray-400 i-hugeicons-package-out-of-stock"></div>
    <p class="font-medium text-gray-900 text-sm dark:text-white">No products match this catalog view</p>
    <p class="mt-1 text-gray-500 text-xs dark:text-neutral-400">Adjust the filters or manage native Product records.</p>
  </div>

  <div :if="!loading() && products().length > 0" class="grid gap-3 grid-cols-1 sm:grid-cols-2 2xl:grid-cols-3 mt-4">
    <article :for="product in products()" :key="product.id" :class="'flex flex-col p-4 bg-white dark:bg-neutral-800 border rounded-lg ' + (sellable(product) ? 'border-gray-200 dark:border-neutral-700' : 'border-gray-200 dark:border-neutral-700 opacity-65')">
      <div class="flex gap-3 items-start">
        <div class="flex flex-none items-center justify-center h-10 w-10 font-semibold text-blue-700 text-xs dark:text-blue-300 bg-blue-50 dark:bg-blue-950/40 rounded-md">{{ initials(product.name) }}</div>
        <div class="min-w-0">
          <h2 class="font-semibold text-gray-900 text-sm truncate dark:text-white">{{ product.name || 'Unnamed product' }}</h2>
          <p class="mt-1 text-gray-500 text-xs dark:text-neutral-400">{{ product.categoryName }}</p>
        </div>
      </div>
      <p class="mt-3 min-h-10 line-clamp-2 text-gray-500 text-xs dark:text-neutral-400">{{ product.description || 'No description recorded.' }}</p>
      <div :if="product.allergens.length > 0" class="flex flex-wrap gap-1 mt-3"><span :for="allergen in product.allergens" :key="allergen" class="px-2 py-0.5 text-amber-700 text-xs dark:text-amber-300 bg-amber-50 dark:bg-amber-950/40 rounded-full">{{ allergen }}</span></div>
      <div class="flex items-end justify-between mt-auto pt-4">
        <div>
          <p class="font-semibold text-gray-900 dark:text-white">{{ formatMoney(product.price) }}</p>
          <p :class="'mt-1 text-xs ' + (product.inventoryCount > 0 ? 'text-gray-500 dark:text-neutral-500' : 'text-red-600 dark:text-red-400')">{{ product.inventoryCount.toLocaleString() }} in stock<span :if="product.preparationTime > 0"> · {{ product.preparationTime }} min</span></p>
        </div>
        <Button size="sm" :disabled="!sellable(product)" :ariaLabel="'Add ' + product.name + ' to cart'" @click="emit('add', product)"><span class="h-4 w-4 i-hugeicons-add-01"></span>Add</Button>
      </div>
    </article>
  </div>
  <div :if="!loading() && total() > 0" class="mt-4">
    <Pagination :currentPage="currentPage()" :totalItems="total()" :itemsPerPage="perPage()" showTotalItems @page="changePage" />
  </div>
</section>
