<script client>
import type { ProductWaitlistOptions, ProductWaitlistRecord } from '../../../../app/Actions/Dashboard/Commerce/product-waitlist-records'

const records = useReactiveProp('records', [] as ProductWaitlistRecord[])
const options = useReactiveProp('options', {
  products: [],
  customers: [],
} as ProductWaitlistOptions)
const loading = useReactiveProp('loading', false)
const emit = defineEmits()

function formatDate(value: string): string {
  if (!value)
    return 'Not recorded'
  const date = new Date(value)
  return Number.isNaN(date.getTime()) ? value : new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' }).format(date)
}

function productLabel(productId: string): string {
  return options().products.find(option => option.id === productId)?.label || (productId ? `Product ${productId}` : 'Not linked')
}

function statusClass(value: string): string {
  if (value === 'purchased')
    return 'text-purple-700 dark:text-purple-300 bg-purple-50 dark:bg-purple-950/30'
  if (value === 'notified')
    return 'text-green-700 dark:text-green-300 bg-green-50 dark:bg-green-950/30'
  if (value === 'waiting')
    return 'text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-950/30'
  return 'text-gray-700 dark:text-neutral-300 bg-gray-100 dark:bg-neutral-700'
}
</script>

<div class="overflow-hidden bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
  <div :if="loading()" class="flex items-center justify-center p-8 text-gray-500 text-sm dark:text-neutral-400">
    <span class="mr-2 h-4 w-4 animate-spin i-hugeicons-loading-03"></span>
    Loading waitlist records
  </div>
  <div :else-if="records().length === 0" class="p-8 text-center">
    <p class="font-medium text-gray-900 text-sm dark:text-white">No product waitlist records found</p>
    <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Add an entry or adjust the current filters.</p>
  </div>
  <div :else class="overflow-x-auto">
    <table class="min-w-full divide-gray-200 divide-y dark:divide-neutral-700">
      <thead class="bg-gray-50 dark:bg-neutral-900/50">
        <tr>
          <th scope="col" class="px-4 py-3 font-semibold text-gray-600 text-left text-xs uppercase dark:text-neutral-400">Customer</th>
          <th scope="col" class="px-4 py-3 font-semibold text-gray-600 text-left text-xs uppercase dark:text-neutral-400">Product</th>
          <th scope="col" class="px-4 py-3 font-semibold text-gray-600 text-right text-xs uppercase dark:text-neutral-400">Quantity</th>
          <th scope="col" class="px-4 py-3 font-semibold text-gray-600 text-left text-xs uppercase dark:text-neutral-400">Status</th>
          <th scope="col" class="px-4 py-3 font-semibold text-gray-600 text-left text-xs uppercase dark:text-neutral-400">Preference</th>
          <th scope="col" class="px-4 py-3 font-semibold text-gray-600 text-left text-xs uppercase dark:text-neutral-400">Created</th>
          <th scope="col" class="relative px-4 py-3"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody class="divide-gray-100 divide-y dark:divide-neutral-700">
        <template :for="entry in records()" :key="entry.id">
          <tr class="hover:bg-gray-50/60 dark:hover:bg-neutral-700/50">
            <td class="px-4 py-3">
              <p class="font-medium text-gray-900 text-sm dark:text-white">{{ entry.name || 'Unnamed' }}</p>
              <p class="mt-1 text-gray-500 text-xs dark:text-neutral-400">{{ entry.email || entry.phone || 'No contact recorded' }}</p>
            </td>
            <td class="px-4 py-3 text-gray-700 text-sm dark:text-neutral-200">{{ productLabel(entry.productId) }}</td>
            <td class="px-4 py-3 font-mono text-gray-700 text-right text-sm dark:text-neutral-200">{{ entry.quantity }}</td>
            <td class="px-4 py-3"><span :class="'inline-flex px-2 py-1 font-medium text-xs capitalize rounded-full ' + statusClass(entry.status)">{{ entry.status || 'unknown' }}</span></td>
            <td class="px-4 py-3 capitalize text-gray-600 text-sm dark:text-neutral-300">{{ entry.notificationPreference || 'Not recorded' }}</td>
            <td class="px-4 py-3 text-gray-600 text-sm whitespace-nowrap dark:text-neutral-300">{{ formatDate(entry.createdAt) }}</td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <Button variant="ghost" size="sm" iconOnly :ariaLabel="'Edit waitlist entry for ' + (entry.name || 'customer')" @click="emit('edit', entry)">
                <span class="block h-4 w-4 text-blue-500 i-hugeicons-edit-01"></span>
              </Button>
              <Button variant="ghost" size="sm" iconOnly :ariaLabel="'Delete waitlist entry for ' + (entry.name || 'customer')" @click="emit('delete', entry)">
                <span class="block h-4 w-4 text-red-500 i-hugeicons-waste"></span>
              </Button>
            </td>
          </tr>
        </template>
      </tbody>
    </table>
  </div>
</div>
