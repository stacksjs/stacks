@import('../UI/Table')

<script client>
import type { ProductWaitlistOptions, ProductWaitlistRecord } from '../../../../app/Actions/Dashboard/Commerce/product-waitlist-records'

const records = useReactiveProp('records', [] as ProductWaitlistRecord[])
const options = useReactiveProp('options', {
  products: [],
  customers: [],
} as ProductWaitlistOptions)
const loading = useReactiveProp('loading', false)
const emit = defineEmits(['edit', 'delete'])

const STATUS_CLASSES = {
  purchased: 'text-purple-700 dark:text-purple-300 bg-purple-50 dark:bg-purple-950/30',
  notified: 'text-green-700 dark:text-green-300 bg-green-50 dark:bg-green-950/30',
  waiting: 'text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-950/30',
}

const COLUMNS = [
  { key: 'name', label: 'Customer', sortable: true, emptyText: 'Unnamed', subtitleKey: 'contact', class: 'font-medium text-gray-900 dark:text-white' },
  { key: 'productName', label: 'Product', sortable: true },
  { key: 'quantity', label: 'Quantity', type: 'number' as const, sortable: true, align: 'right' as const, class: 'font-mono' },
  { key: 'status', label: 'Status', type: 'badge' as const, sortable: true, badgeClasses: STATUS_CLASSES, emptyText: 'unknown' },
  { key: 'notificationPreference', label: 'Preference', sortable: true, emptyText: 'Not recorded', class: 'capitalize' },
  { key: 'createdAt', label: 'Created', type: 'date' as const, sortable: true, emptyText: 'Not recorded', class: 'whitespace-nowrap' },
]

const ROW_ACTIONS = [
  { action: 'edit', label: 'Edit waitlist entry for', icon: 'i-hugeicons-edit-01' },
  { action: 'delete', label: 'Delete waitlist entry for', icon: 'i-hugeicons-waste', class: 'text-red-500' },
]

function productLabel(productId: string): string {
  return options().products.find(option => option.id === productId)?.label || (productId ? `Product ${productId}` : 'Not linked')
}

/**
 * `contact` and `productName` are computed per row because a column reads a
 * field: the contact line falls back through email then phone, and the product
 * name is looked up in the options the parent passed.
 */
const rows = derived(() => records().map(entry => ({
  ...entry,
  contact: entry.email || entry.phone || 'No contact recorded',
  productName: productLabel(entry.productId),
})))

function handleRowAction(payload: { action: string, row: ProductWaitlistRecord }): void {
  emit(payload.action, payload.row)
}
</script>

{{--
  No `searchable` or `filterable`: the parent dashboard owns the search box and
  the filter selects. Paging is what was missing.
--}}
<Table
  :columns="COLUMNS"
  :data="rows()"
  :loading="loading()"
  :row-actions="ROW_ACTIONS"
  action-label-key="name"
  paginated
  :page-size="25"
  empty-title="No product waitlist records found"
  empty-description="Add an entry or adjust the current filters."
  @row-action="handleRowAction"
/>
