<script client>
import type { ProductVariantOption, ProductVariantRecord } from '../../../../app/Actions/Dashboard/Commerce/product-variant-records'

const open = useReactiveProp('open', false)
const mode = useReactiveProp('mode', 'add')
const record = useReactiveProp('record', null as ProductVariantRecord | null)
const products = useReactiveProp('products', [] as ProductVariantOption[])
const types = useReactiveProp('types', [] as string[])
const busy = useReactiveProp('busy', false)
const emit = defineEmits()
const variant = state('')
const type = state('')
const description = state('')
const options = state('')
const status = state<'active' | 'inactive' | 'draft'>('active')
const productId = state('')
let hydrationKey = ''

effect(() => {
  if (!open()) {
    hydrationKey = ''
    return
  }
  const current = record()
  const key = `${mode()}:${current?.id || 'new'}`
  if (hydrationKey === key)
    return
  hydrationKey = key
  variant.set(current?.variant || '')
  type.set(current?.type || '')
  description.set(current?.description || '')
  options.set(current?.options.join(', ') || '')
  status.set(current?.status || 'active')
  productId.set(current?.productId || '')
})

function updateVariant(event: Event): void {
  variant.set((event.target as HTMLInputElement).value)
}

function updateType(event: Event): void {
  type.set((event.target as HTMLInputElement).value)
}

function updateDescription(event: Event): void {
  description.set((event.target as HTMLTextAreaElement).value)
}

function updateOptions(event: Event): void {
  options.set((event.target as HTMLTextAreaElement).value)
}

function updateStatus(event: Event): void {
  status.set((event.target as HTMLSelectElement).value as 'active' | 'inactive' | 'draft')
}

function updateProduct(event: Event): void {
  productId.set((event.target as HTMLSelectElement).value)
}

function submit(): void {
  if (!variant().trim() || !type().trim())
    return
  emit('submit', {
    variant: variant().trim(),
    type: type().trim(),
    description: description().trim(),
    options: options().split(/[,\n]/).map(option => option.trim()).filter(Boolean),
    status: status(),
    productId: productId() ? Number(productId()) : null,
  })
}
</script>

<div :if="open()" class="flex fixed inset-0 z-50 items-center justify-center p-4">
  <button type="button" aria-label="Close product variant dialog" class="absolute inset-0 bg-black/45" @click="emit('close')"></button>
  <section role="dialog" aria-modal="true" aria-labelledby="product-variant-dialog-title" class="relative max-w-lg w-full bg-white dark:bg-neutral-800 border border-gray-200 rounded-xl dark:border-neutral-700 shadow-xl">
    <form @submit.prevent="submit">
      <div class="p-6">
        <h2 id="product-variant-dialog-title" class="font-semibold text-gray-900 text-lg dark:text-white">{{ mode() === 'edit' ? 'Edit product variant' : 'Add product variant' }}</h2>
        <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Fields and product assignment follow the ProductVariant model.</p>
        <div class="mt-5 space-y-4">
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block"><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Variant</span><input :value="variant()" type="text" maxlength="100" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @input="updateVariant($event)" /></label>
            <label class="block"><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Type</span><input :value="type()" type="text" list="product-variant-types" maxlength="50" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @input="updateType($event)" /><datalist id="product-variant-types"><template :for="variantType in types()" :key="variantType"><option :value="variantType"></option></template></datalist></label>
          </div>
          <label class="block"><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Product</span><select :value="productId()" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @change="updateProduct($event)"><option value="" :selected="!productId()">Unassigned</option><template :for="product in products()" :key="product.id"><option :value="product.id" :selected="productId() === product.id">{{ product.name }}</option></template></select></label>
          <label class="block"><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Description</span><textarea :value="description()" rows="3" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @input="updateDescription($event)"></textarea></label>
          <label class="block"><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Options</span><textarea :value="options()" rows="3" placeholder="Small, Medium, Large" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @input="updateOptions($event)"></textarea><span class="block mt-1 text-gray-500 text-xs dark:text-neutral-400">Separate options with commas or new lines.</span></label>
          <label class="block"><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Status</span><select :value="status()" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @change="updateStatus($event)"><option value="active">Active</option><option value="inactive">Inactive</option><option value="draft">Draft</option></select></label>
        </div>
      </div>
      <footer class="flex gap-2 justify-end px-6 py-4 bg-gray-50 dark:bg-neutral-900/50 border-gray-200 border-t dark:border-neutral-700">
        <button type="button" :disabled="busy()" class="px-3 py-2 font-semibold text-gray-700 text-sm dark:text-neutral-200 bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700 disabled:opacity-50" @click="emit('close')">Cancel</button>
        <button type="submit" :disabled="busy() || !variant().trim() || !type().trim()" class="inline-flex items-center px-3 py-2 font-semibold text-sm text-white bg-blue-600 hover:bg-blue-500 rounded-md disabled:opacity-50"><span :if="busy()" class="mr-2 h-4 w-4 animate-spin i-hugeicons-loading-03"></span>{{ mode() === 'edit' ? 'Save product variant' : 'Add product variant' }}</button>
      </footer>
    </form>
  </section>
</div>
