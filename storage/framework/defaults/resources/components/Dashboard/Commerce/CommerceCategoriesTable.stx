@import('../UI/Table')

<script client>
import type { CommerceCategoryRecord } from '../../../../app/Actions/Dashboard/Commerce/commerce-category-records'

const records = useReactiveProp('records', [] as CommerceCategoryRecord[])
const allRecords = useReactiveProp('allRecords', [] as CommerceCategoryRecord[])
const loading = useReactiveProp('loading', false)
/** The parent's sort select: a change hands the order back from a header sort. */
const sortResetKey = useReactiveProp<unknown>('sortResetKey', '')
/** The parent's search and filters: a change returns to the first page. */
const pageResetKey = useReactiveProp<unknown>('pageResetKey', '')
const emit = defineEmits()

function parentName(record: CommerceCategoryRecord): string {
  if (!record.parentCategoryId)
    return 'Root category'
  return allRecords().find(parent => parent.id === record.parentCategoryId)?.name || 'Unknown parent'
}

/**
 * Only the category cell is slotted, for its initial. The parent comes from
 * `allRecords`, which can hold categories the current filter hides, so it is
 * resolved into the row rather than looked up per cell.
 */
const COLUMNS = [
  { key: 'name', label: 'Category', sortable: true, slotted: true },
  { key: 'parentLabel', label: 'Hierarchy', sortable: true, subtitleKey: 'slug', class: 'text-gray-700 dark:text-neutral-200' },
  { key: 'displayOrder', label: 'Display order', type: 'number' as const, sortable: true, class: 'font-mono' },
  {
    key: 'availability',
    label: 'Availability',
    type: 'badge' as const,
    sortable: true,
    badgeClasses: { active: 'bg-green-50 text-green-700 dark:bg-green-950/40 dark:text-green-300' },
    badgeLabels: { active: 'Active', inactive: 'Inactive' },
  },
]

const ROW_ACTIONS = [
  { action: 'view', label: 'View', icon: 'i-hugeicons-view' },
  { action: 'edit', label: 'Edit', icon: 'i-hugeicons-edit-02' },
  { action: 'delete', label: 'Delete', icon: 'i-hugeicons-delete-02', class: 'text-red-500' },
]

const rows = derived(() => records().map(record => ({
  ...record,
  initial: record.name.slice(0, 1).toUpperCase(),
  summary: record.description || record.slug,
  parentLabel: parentName(record),
  availability: record.isActive ? 'active' : 'inactive',
})))

function handleRowAction(payload: { action: string, row: CommerceCategoryRecord }): void {
  emit(payload.action, payload.row)
}
</script>

{{--
  No `searchable` or `filterable`: the parent dashboard owns the search box
  and the filter selects. Table pages the whole filtered list the parent passes.
--}}
<Table
  :sort-reset-key="sortResetKey()"
  :page-reset-key="pageResetKey()"
  :columns="COLUMNS"
  :data="rows()"
  :loading="loading()"
  :row-actions="ROW_ACTIONS"
  action-label-key="name"
  paginated
  :page-size="20"
  empty-title="No product categories found"
  empty-description="Adjust the filters or add a native Category record."
  @row-action="handleRowAction"
>
  <template #cell="{ row }">
    <div class="flex gap-3 items-center">
      <span class="flex items-center justify-center shrink-0 h-9 w-9 font-semibold text-blue-700 text-sm dark:text-blue-300 bg-blue-50 dark:bg-blue-950/40 rounded-md" x-text="row.initial"></span>
      <div class="min-w-0">
        <p class="font-medium text-gray-900 text-sm dark:text-white" x-text="row.name"></p>
        <p class="mt-1 max-w-96 text-gray-400 text-xs truncate dark:text-neutral-500" x-text="row.summary"></p>
      </div>
    </div>
  </template>
</Table>
