<script client>
import type { CommerceCustomerRecord } from '../../../../app/Actions/Dashboard/Commerce/commerce-customer-records'
import { minorToInput, moneyInputError, moneyInputStep, parseMoneyInput } from '@stacksjs/commerce/money'
import { formErrorMessages } from '../../../../functions/dashboard-form'

const open = useReactiveProp('open', false)
const mode = useReactiveProp('mode', 'add')
const record = useReactiveProp('record', null as CommerceCustomerRecord | null)
const currency = useReactiveProp('currency', 'USD')
const busy = useReactiveProp('busy', false)
const errors = useReactiveProp('errors', {} as Record<string, string>)
const emit = defineEmits(['submit', 'close'])
const name = state('')
const email = state('')
const phone = state('')
const totalSpent = state('0')
const lastOrder = state('')
const status = state<'Active' | 'Inactive'>('Active')
const avatar = state('')
let hydrationKey = ''

effect(() => {
  if (!open()) {
    hydrationKey = ''
    return
  }
  const current = record()
  const key = `${mode()}:${current?.id || 'new'}`
  if (hydrationKey === key)
    return
  hydrationKey = key
  name.set(current?.name || '')
  email.set(current?.email || '')
  phone.set(current?.phone || '')
  // Stored as integer minor units; the field shows the decimal.
  totalSpent.set(minorToInput(current?.totalSpent ?? 0, currency()))
  lastOrder.set(current?.lastOrder.slice(0, 10) || '')
  status.set(current?.status === 'Inactive' ? 'Inactive' : 'Active')
  avatar.set(current?.avatar || '')
})

function validAvatar(): boolean {
  try {
    const result = new URL(avatar().trim())
    return result.protocol === 'https:' || result.protocol === 'http:'
  }
  catch {
    return false
  }
}

function valid(): boolean {
  return Boolean(
    name().trim().length >= 2
    && email().trim()
    && !moneyInputError(totalSpent(), currency())
    && validAvatar()
  )
}

function submit(): void {
  if (!valid())
    return
  emit('submit', {
    name: name().trim(),
    email: email().trim(),
    phone: phone().trim(),
    totalSpent: parseMoneyInput(totalSpent(), currency()),
    lastOrder: lastOrder() || undefined,
    status: status(),
    avatar: avatar().trim(),
  })
}

function errorMessages(): string[] {
  return formErrorMessages(errors())
}
</script>

<Modal
  :isOpen="open()"
  :title="mode() === 'edit' ? 'Edit customer' : 'Add customer'"
  description="Store fields declared by the native Customer model."
  size="lg"
  @close="emit('close')"
>
    <form id="customer-form" @submit.prevent="submit">
        <ul :if="errorMessages().length > 0" class="mb-5 p-3 space-y-1 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">
          <li :for="message in errorMessages()" :key="message">{{ message }}</li>
        </ul>
        <div class="grid gap-4 grid-cols-1 sm:grid-cols-2">
          <Input v-model:value="name" label="Name" :minLength="2" :maxLength="255" :required="true" />
          <Input v-model:value="email" label="Email" type="email" :required="true" />
          <Input v-model:value="phone" label="Phone (optional)" type="tel" :maxLength="50" />
          <Select v-model:value="status" label="Status" placeholder="" :options="[{ value: 'Active', label: 'Active' }, { value: 'Inactive', label: 'Inactive' }]" />
          <Input v-model:value="totalSpent" :label="'Recorded spend (' + currency() + ')'" type="number" min="0" :step="moneyInputStep(currency())" :required="true" />
          <Input v-model:value="lastOrder" label="Last order" type="date" />
          <div class="sm:col-span-2"><Input v-model:value="avatar" label="Avatar URL" type="url" placeholder="https://cdn.example.com/customers/avatar.jpg" :required="true" hint="Use a persisted HTTP asset URL. The dashboard uses initials when rendering the table." /></div>
        </div>
    </form>
  <template #footer>
    <div class="flex gap-2 justify-end w-full"><Button variant="secondary" :disabled="busy()" @click="emit('close')">Cancel</Button><Button type="submit" form="customer-form" :loading="busy()" :disabled="!valid()">{{ mode() === 'edit' ? 'Save customer' : 'Add customer' }}</Button></div>
  </template>
</Modal>
