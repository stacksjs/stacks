<script client>
interface CourierOption {
  id: number
  name: string
  vehicle_number: string
  status: 'active' | 'on_delivery' | 'on_break'
}

interface DeliveryRouteRecord {
  id: number
  courier: string
  courier_id?: number | null
  vehicle: string
  stops: number
  delivery_time: number
  total_distance: number
  last_active: string | number
}

const open = useReactiveProp('open', false)
const mode = useReactiveProp('mode', 'create')
const record = useReactiveProp('record', null as DeliveryRouteRecord | null)
const couriers = useReactiveProp('couriers', [] as CourierOption[])
const busy = useReactiveProp('busy', false)
const error = useReactiveProp('error', '')
const emit = defineEmits(['invalid', 'submit', 'close'])
const courierId = state('')
const stops = state('0')
const deliveryTime = state('0')
const totalDistance = state('0')
const lastActive = state('')
let hydrationKey = ''

function currentDateTimeLocal(): string {
  const now = new Date()
  return new Date(now.getTime() - now.getTimezoneOffset() * 60_000).toISOString().slice(0, 16)
}

function toDateTimeLocal(value?: string | number): string {
  if (value === undefined || value === null || value === '')
    return currentDateTimeLocal()

  const numeric = typeof value === 'number' || /^\d+$/.test(String(value))
  const date = numeric
    ? new Date(Number(value))
    : new Date(String(value).replace(' ', 'T'))
  if (Number.isNaN(date.getTime()))
    return currentDateTimeLocal()

  return new Date(date.getTime() - date.getTimezoneOffset() * 60_000).toISOString().slice(0, 16)
}

function toUnixTimestamp(value: string): number {
  return new Date(value).getTime()
}

effect(() => {
  if (!open()) {
    hydrationKey = ''
    return
  }
  const current = record()
  const nextKey = `${mode()}:${current?.id || 'new'}`
  if (hydrationKey === nextKey)
    return
  hydrationKey = nextKey
  courierId.set(current?.courier_id ? String(current.courier_id) : '')
  stops.set(String(current?.stops ?? 0))
  deliveryTime.set(String(current?.delivery_time ?? 0))
  totalDistance.set(String(current?.total_distance ?? 0))
  lastActive.set(toDateTimeLocal(current?.last_active))
})

function selectedCourier(): CourierOption | undefined {
  const id = Number(courierId())
  return couriers().find(courier => courier.id === id)
}

function submit(): void {
  const courier = selectedCourier()
  const parsedStops = Number(stops())
  const parsedDeliveryTime = Number(deliveryTime())
  const parsedDistance = Number(totalDistance())

  if (!courier) {
    emit('invalid', 'Select a persisted courier.')
    return
  }
  if (!Number.isInteger(parsedStops) || parsedStops < 0) {
    emit('invalid', 'Stops must be a whole number of zero or more.')
    return
  }
  if (!Number.isInteger(parsedDeliveryTime) || parsedDeliveryTime < 0) {
    emit('invalid', 'Delivery time must be a whole number of minutes.')
    return
  }
  if (!Number.isInteger(parsedDistance) || parsedDistance < 0) {
    emit('invalid', 'Distance must be a whole number of miles.')
    return
  }
  if (!lastActive()) {
    emit('invalid', 'Last active time is required.')
    return
  }

  emit('submit', {
    courier: courier.name,
    courierId: courier.id,
    vehicle: courier.vehicle_number,
    stops: parsedStops,
    deliveryTime: parsedDeliveryTime,
    totalDistance: parsedDistance,
    lastActive: toUnixTimestamp(lastActive()),
  })
}
</script>

<Modal
  :isOpen="open()"
  :title="mode() === 'edit' ? 'Edit delivery route' : 'Add delivery route'"
  description="Assign a persisted courier and record the operational route metrics."
  size="lg"
  @close="emit('close')"
>
    <form id="delivery-route-form" @submit.prevent="submit()">
        <div :if="error()" class="mb-5 p-3 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">{{ error() }}</div>

        <div class="space-y-4">
          <div>
            <Select v-model:value="courierId" label="Courier" :required="true" placeholder="Select a courier" :options="[...couriers().map(courier => ({ value: courier.id, label: `${courier.name} - ${courier.vehicle_number}` }))]" />
          </div>
          <div :if="selectedCourier()" class="flex gap-3 items-center p-3 text-gray-600 text-sm dark:text-neutral-300 bg-gray-50 dark:bg-neutral-900/60 border border-gray-200 rounded-lg dark:border-neutral-700">
            <span class="h-5 w-5 text-blue-600 i-hugeicons-delivery-truck-02"></span>
            <span><strong class="text-gray-900 dark:text-white">{{ selectedCourier()?.vehicle_number }}</strong> will be stored as the route vehicle snapshot.</span>
          </div>
          <div class="grid gap-4 grid-cols-1 sm:grid-cols-3">
            <Input v-model:value="stops" label="Stops" type="number" :required="true" min="0" step="1" inputmode="numeric" />
            <Input v-model:value="deliveryTime" label="Time, minutes" type="number" :required="true" min="0" step="1" inputmode="numeric" />
            <Input v-model:value="totalDistance" label="Distance, miles" type="number" :required="true" min="0" step="1" inputmode="numeric" />
          </div>
          <div>
            <Input v-model:value="lastActive" label="Last active" type="datetime-local" :required="true" />
          </div>
        </div>
    </form>
  <template #footer>
    <div class="flex gap-2 justify-end w-full">
      <Button :disabled="busy()" variant="secondary" @click="emit('close')">Cancel</Button>
      <Button type="submit" form="delivery-route-form" :loading="busy()">{{ mode() === 'edit' ? 'Save changes' : 'Add route' }}</Button>
    </div>
  </template>
</Modal>
