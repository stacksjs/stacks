<script client>
type LicenseKeyStatus = 'active' | 'inactive' | 'unassigned'

interface RelatedSummary {
  id: number
  label: string
  detail?: string
}

interface LicenseKeyRow {
  id: number
  key: string
  template: string
  customer_id?: number | null
  product_id?: number | null
  order_id?: number | null
  expiry_date: string
  created_at: string
  status: LicenseKeyStatus
  customer?: RelatedSummary | null
  product?: RelatedSummary | null
  order?: RelatedSummary | null
}

const licenseKeys = useReactiveProp('license-keys', [] as LicenseKeyRow[])
const emit = defineEmits()

function formatDate(value: string): string {
  if (!value)
    return 'Not set'

  const normalized = value.includes('T') ? value : value.replace(' ', 'T')
  const date = new Date(normalized)
  if (Number.isNaN(date.getTime()))
    return value

  return new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' }).format(date)
}

function statusLabel(status: LicenseKeyStatus): string {
  return status === 'unassigned' ? 'Unassigned' : status === 'active' ? 'Active' : 'Inactive'
}

function statusClass(status: LicenseKeyStatus): string {
  if (status === 'active')
    return 'bg-green-50 text-green-700 ring-green-600/20 dark:bg-green-900/30 dark:text-green-300'
  if (status === 'inactive')
    return 'bg-stone-100 text-stone-600 ring-stone-500/20 dark:bg-neutral-700 dark:text-neutral-300'
  return 'bg-amber-50 text-amber-700 ring-amber-600/20 dark:bg-amber-900/30 dark:text-amber-300'
}
</script>

<div class="overflow-x-auto border border-stone-200/80 rounded-xl dark:border-neutral-700 shadow-sm">
  <table class="min-w-full divide-stone-100 divide-y dark:divide-neutral-700">
    <thead class="bg-stone-50/80 dark:bg-neutral-800">
      <tr>
        <th scope="col" class="pl-6 pr-3 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">Key</th>
        <th scope="col" class="px-4 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">Template</th>
        <th scope="col" class="px-4 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">Customer</th>
        <th scope="col" class="px-4 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">Product</th>
        <th scope="col" class="px-4 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">Order</th>
        <th scope="col" class="px-4 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">Created</th>
        <th scope="col" class="px-4 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">Expires</th>
        <th scope="col" class="px-4 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">Status</th>
        <th scope="col" class="relative pl-3 pr-6 py-3.5">
          <span class="sr-only">Actions</span>
        </th>
      </tr>
    </thead>
    <tbody class="bg-white dark:bg-neutral-800 divide-stone-100 divide-y dark:divide-neutral-700">
      <template :for="licenseKey in licenseKeys" :key="licenseKey.id">
        <tr class="hover:bg-stone-50/50 dark:hover:bg-neutral-700/50 transition-colors">
          <td class="pl-6 pr-3 py-3.5 font-medium font-mono text-sm text-stone-800 whitespace-nowrap dark:text-white">
            {{ licenseKey.key }}
          </td>
          <td class="px-4 py-3.5 text-sm text-stone-500 whitespace-nowrap dark:text-neutral-300">
            {{ licenseKey.template }}
          </td>
          <td class="px-4 py-3.5 text-sm text-stone-500 whitespace-nowrap dark:text-neutral-300">
            <span class="block">{{ licenseKey.customer?.label || 'Unassigned' }}</span>
            <span :if="licenseKey.customer?.detail" class="block text-stone-400 text-xs dark:text-neutral-500">
              {{ licenseKey.customer?.detail }}
            </span>
          </td>
          <td class="px-4 py-3.5 text-sm text-stone-500 whitespace-nowrap dark:text-neutral-300">
            {{ licenseKey.product?.label || 'Unassigned' }}
          </td>
          <td class="px-4 py-3.5 text-sm text-stone-500 whitespace-nowrap dark:text-neutral-300">
            {{ licenseKey.order?.label || 'Unassigned' }}
          </td>
          <td class="px-4 py-3.5 text-sm text-stone-500 whitespace-nowrap dark:text-neutral-300">
            {{ formatDate(licenseKey.created_at) }}
          </td>
          <td class="px-4 py-3.5 text-sm text-stone-500 whitespace-nowrap dark:text-neutral-300">
            {{ formatDate(licenseKey.expiry_date) }}
          </td>
          <td class="px-4 py-3.5 text-sm whitespace-nowrap">
            <span :class="'inline-flex items-center px-2 py-1 font-medium text-xs ring-1 ring-inset rounded-md ' + statusClass(licenseKey.status)">
              {{ statusLabel(licenseKey.status) }}
            </span>
          </td>
          <td class="relative pl-3 pr-6 py-3.5 font-medium text-right text-sm whitespace-nowrap">
            <Button
              variant="ghost"
              size="sm"
              iconOnly
              @click="emit('edit', licenseKey)"
              :ariaLabel="'Edit license key ' + licenseKey.key + ', record ' + licenseKey.id"
            >
              <span class="block h-4 w-4 text-blue-500 i-hugeicons-edit-01"></span>
            </Button>
            <Button
              variant="ghost"
              size="sm"
              iconOnly
              @click="emit('delete', licenseKey)"
              :ariaLabel="'Delete license key ' + licenseKey.key + ', record ' + licenseKey.id"
            >
              <span class="block h-4 w-4 text-red-500 i-hugeicons-waste"></span>
            </Button>
          </td>
        </tr>
      </template>

      <tr :if="licenseKeys().length === 0">
        <td colspan="9" class="px-6 py-12 text-center text-sm text-stone-500 dark:text-neutral-400">
          No license keys found.
        </td>
      </tr>
    </tbody>
  </table>
</div>
