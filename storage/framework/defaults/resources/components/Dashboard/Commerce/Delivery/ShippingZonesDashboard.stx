<script client>
import { dashboardApi } from '../../../../../functions/dashboard-api'
import { pushToast } from '../../../../../functions/toasts'

type SerializedList = string | string[] | null | undefined

interface ShippingMethodOption {
  id: number
  name: string
  status?: string
}

interface ShippingZoneRecord {
  id: number
  name: string
  countries?: SerializedList
  regions?: SerializedList
  postal_codes?: SerializedList
  shipping_method_id: number
  status: 'active' | 'inactive' | 'draft'
  shipping_method?: ShippingMethodOption
}

interface ShippingZonePayload {
  name: string
  countries: string
  regions: string
  postalCodes: string
  shippingMethodId: number
  status: 'active' | 'inactive' | 'draft'
}

const records = state<ShippingZoneRecord[]>([])
const methods = state<ShippingMethodOption[]>([])
const loading = state(true)
const loadError = state('')
const search = state('')
const page = state(1)
const perPage = state(10)
const editorOpen = state(false)
const editorMode = state<'create' | 'edit'>('create')
const editing = state<ShippingZoneRecord | null>(null)
const saving = state(false)
const editorError = state('')
const deleting = state<ShippingZoneRecord | null>(null)
const deleteBusy = state(false)
const deleteError = state('')

function listTokens(value: SerializedList): string[] {
  if (Array.isArray(value))
    return value.map(item => String(item).trim()).filter(Boolean)
  if (!value)
    return []
  try {
    const parsed = JSON.parse(value)
    if (Array.isArray(parsed))
      return parsed.map(item => String(item).trim()).filter(Boolean)
  }
  catch {
    return value.split(/[\n,|;]+/).map(item => item.trim()).filter(Boolean)
  }
  return []
}

function methodFor(id: number): ShippingMethodOption | undefined {
  return methods().find(method => method.id === id)
}

function withMethod(record: ShippingZoneRecord): ShippingZoneRecord {
  return {
    ...record,
    shipping_method: methodFor(record.shipping_method_id),
  }
}

function filteredRecords(): ShippingZoneRecord[] {
  const query = search().trim().toLowerCase()
  if (!query)
    return records()
  return records().filter(record => [
    record.name,
    record.status,
    record.shipping_method?.name,
    ...listTokens(record.countries),
    ...listTokens(record.regions),
    ...listTokens(record.postal_codes),
  ].some(value => String(value || '').toLowerCase().includes(query)))
}

function paginatedRecords(): ShippingZoneRecord[] {
  const start = (page() - 1) * perPage()
  return filteredRecords().slice(start, start + perPage())
}

function uniqueCount(field: 'countries' | 'regions'): number {
  return new Set(records().flatMap(record => listTokens(record[field]))).size
}

function postalCodeCount(): number {
  return records().reduce((sum, record) => sum + listTokens(record.postal_codes).length, 0)
}

function metricCards(): Array<{ label: string, value: string, detail: string }> {
  const active = records().filter(record => record.status === 'active').length
  return [
    { label: 'Shipping zones', value: records().length.toLocaleString(), detail: 'Persisted ShippingZone records' },
    { label: 'Active', value: active.toLocaleString(), detail: `${records().length - active} inactive or draft` },
    { label: 'Country entries', value: uniqueCount('countries').toLocaleString(), detail: `${uniqueCount('regions')} unique regions` },
    { label: 'Postal entries', value: postalCodeCount().toLocaleString(), detail: 'Across all configured zones' },
  ]
}

async function loadZones(): Promise<void> {
  loading.set(true)
  loadError.set('')
  try {
    const [zoneData, methodData] = await Promise.all([
      dashboardApi<ShippingZoneRecord[]>('/api/dashboard/commerce/shipping-zones'),
      dashboardApi<ShippingMethodOption[]>('/api/dashboard/commerce/shipping-methods'),
    ])
    if (!Array.isArray(zoneData) || !Array.isArray(methodData))
      throw new TypeError('Shipping zone resources were not returned as arrays.')
    methods.set(methodData)
    records.set(zoneData.map(withMethod))
    const lastPage = Math.max(1, Math.ceil(filteredRecords().length / perPage()))
    if (page() > lastPage)
      page.set(lastPage)
  }
  catch (error) {
    loadError.set(error instanceof Error ? error.message : String(error))
    pushToast('error', 'Could not load shipping zones', { detail: loadError() })
  }
  finally {
    loading.set(false)
  }
}

function handleSearch(value: string): void {
  search.set(value)
  page.set(1)
}

function openCreate(): void {
  editing.set(null)
  editorMode.set('create')
  editorError.set('')
  editorOpen.set(true)
}

function openEdit(record: ShippingZoneRecord): void {
  editing.set(record)
  editorMode.set('edit')
  editorError.set('')
  editorOpen.set(true)
}

function closeEditor(): void {
  if (saving())
    return
  editorOpen.set(false)
  editing.set(null)
  editorError.set('')
}

function setEditorError(message: string): void {
  editorError.set(message)
}

async function saveZone(payload: ShippingZonePayload): Promise<void> {
  saving.set(true)
  editorError.set('')
  try {
    const current = editing()
    const updated = await dashboardApi<ShippingZoneRecord>(
      current
        ? `/api/dashboard/commerce/shipping-zones/${current.id}`
        : '/api/dashboard/commerce/shipping-zones',
      {
        method: current ? 'PATCH' : 'POST',
        body: payload,
      },
    )
    const hydrated = withMethod(updated)
    if (current) {
      records.set(records().map(record => record.id === current.id ? hydrated : record))
    }
    else {
      const nextRecords = [...records(), hydrated]
      records.set(nextRecords)
      page.set(Math.max(1, Math.ceil(nextRecords.length / perPage())))
    }
    editorOpen.set(false)
    editing.set(null)
    pushToast('success', current ? 'Shipping zone updated' : 'Shipping zone added', {
      detail: hydrated.name,
    })
  }
  catch (error) {
    editorError.set(error instanceof Error ? error.message : String(error))
  }
  finally {
    saving.set(false)
  }
}

function requestDelete(record: ShippingZoneRecord): void {
  deleting.set(record)
  deleteError.set('')
}

function closeDelete(): void {
  if (deleteBusy())
    return
  deleting.set(null)
  deleteError.set('')
}

async function confirmDelete(): Promise<void> {
  const current = deleting()
  if (!current)
    return
  deleteBusy.set(true)
  deleteError.set('')
  try {
    await dashboardApi(`/api/dashboard/commerce/shipping-zones/${current.id}`, {
      method: 'DELETE',
    })
    records.set(records().filter(record => record.id !== current.id))
    deleting.set(null)
    const lastPage = Math.max(1, Math.ceil(filteredRecords().length / perPage()))
    if (page() > lastPage)
      page.set(lastPage)
    pushToast('success', 'Shipping zone deleted', { detail: current.name })
  }
  catch (error) {
    deleteError.set(error instanceof Error ? error.message : String(error))
  }
  finally {
    deleteBusy.set(false)
  }
}

function goToPage(value: number): void {
  page.set(value)
}

onMount(() => {
  void loadZones()
})
</script>

<div class="space-y-6">
  <TabNavigation model-value="zones" />

  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="font-bold text-2xl text-gray-900 dark:text-white">Shipping zones</h1>
      <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Map methods to persisted country, region, and postal coverage.</p>
    </div>
    <div class="flex gap-2">
      <Button :loading="loading()" variant="secondary" @click="loadZones()"><span :if="!loading()" aria-hidden="true" class="h-4 w-4 i-hugeicons-refresh"></span>Refresh</Button>
      <Button :disabled="loading() || methods().length === 0" @click="openCreate()"><span aria-hidden="true" class="h-4 w-4 i-hugeicons-add-01"></span>Add zone</Button>
    </div>
  </header>

  <div :if="loadError()" class="flex gap-4 items-center justify-between p-4 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900"><span>{{ loadError() }}</span><Button variant="secondary" size="sm" @click="loadZones()">Retry</Button></div>
  <div :if="!loading() && methods().length === 0" class="p-4 text-amber-800 text-sm dark:text-amber-200 bg-amber-50 dark:bg-amber-950/30 border border-amber-200 rounded-lg dark:border-amber-900">Add a shipping method before creating a zone.</div>

  <section aria-label="Shipping zone metrics" class="grid gap-3 grid-cols-1 sm:grid-cols-2 xl:grid-cols-4">
    <template :for="item in metricCards()" :key="item.label"><article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700"><p class="text-gray-500 text-xs dark:text-neutral-400">{{ item.label }}</p><p class="mt-2 font-semibold text-2xl text-gray-900 dark:text-white">{{ item.value }}</p><p class="mt-1 text-gray-400 text-xs dark:text-neutral-500">{{ item.detail }}</p></article></template>
  </section>

  <section class="overflow-hidden bg-white dark:bg-neutral-800 border border-gray-200 rounded-xl dark:border-neutral-700">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between px-4 py-4 border-b border-gray-200 dark:border-neutral-700">
      <div><h2 class="font-semibold text-gray-900 dark:text-white">Configured coverage</h2><p class="mt-0.5 text-gray-500 text-xs dark:text-neutral-400">{{ filteredRecords().length }} matching records</p></div>
      <SearchFilter placeholder="Search shipping zones" class="w-full sm:w-80" @search="handleSearch" />
    </div>
    <div :if="loading()" class="flex items-center justify-center py-24 text-gray-500 text-sm dark:text-neutral-400"><span class="mr-2 h-4 w-4 animate-spin i-hugeicons-loading-03"></span>Loading shipping zones</div>
    <ShippingZonesTable :if="!loading()" :zones="paginatedRecords()" @edit="openEdit" @delete="requestDelete" />
    <div :if="!loading()" class="px-4 py-3 bg-gray-50 dark:bg-neutral-900/50 border-gray-200 border-t dark:border-neutral-700">
      <DeliveryPagination :current-page="page()" :total-items="filteredRecords().length" :items-per-page="perPage()" @select="goToPage" />
    </div>
  </section>
</div>

<ShippingZoneDialog :open="editorOpen()" :mode="editorMode()" :record="editing()" :methods="methods()" :busy="saving()" :error="editorError()" @submit="saveZone" @invalid="setEditorError" @close="closeEditor()" />
<ShippingZoneDeleteDialog :open="Boolean(deleting())" :record="deleting()" :busy="deleteBusy()" :error="deleteError()" @confirm="confirmDelete()" @close="closeDelete()" />
