<script client>
import { dashboardApi } from '../../../../../functions/dashboard-api'
import { pushToast } from '../../../../../functions/toasts'

interface DeliveryStat {
  label: string
  value: string
  detail: string
}

interface DeliveryRoute {
  id: number
  driver: string
  vehicle: string
  stops: number
  duration: string
  distance: string
  lastActive: number
}

interface ShippingMethod {
  id: number
  name: string
  status: string
  baseRate: string
  freeShipping: string
}

interface ShippingZone {
  id: number
  name: string
  status: string
  countries: number
  regions: number
}

interface DriverSummary {
  total: number
  active: number
  onDelivery: number
  onBreak: number
}

interface DeliveryOverviewResponse {
  stats: DeliveryStat[]
  routes: DeliveryRoute[]
  methods: ShippingMethod[]
  zones: ShippingZone[]
  drivers: DriverSummary
}

const stats = state<DeliveryStat[]>([])
const routes = state<DeliveryRoute[]>([])
const methods = state<ShippingMethod[]>([])
const zones = state<ShippingZone[]>([])
const drivers = state<DriverSummary>({
  total: 0,
  active: 0,
  onDelivery: 0,
  onBreak: 0,
})
const loading = state(true)
const loadError = state('')

function statIcon(label: string): string {
  const icons: Record<string, string> = {
    'Active Routes': 'i-hugeicons-route-02',
    'Drivers on Delivery': 'i-hugeicons-delivery-truck-02',
    'Average Route': 'i-hugeicons-clock-01',
    'Active Zones': 'i-hugeicons-maps-global-02',
  }
  return icons[label] || 'i-hugeicons-chart'
}

function statusClass(status: string): string {
  if (status === 'active')
    return 'bg-emerald-50 text-emerald-700 ring-emerald-600/20 dark:bg-emerald-400/10 dark:text-emerald-300 dark:ring-emerald-400/20'
  if (status === 'draft')
    return 'bg-amber-50 text-amber-700 ring-amber-600/20 dark:bg-amber-400/10 dark:text-amber-300 dark:ring-amber-400/20'
  return 'bg-stone-100 text-stone-600 ring-stone-500/20 dark:bg-white/5 dark:text-neutral-300 dark:ring-white/10'
}

function formatStatus(status: string): string {
  return status
    .replaceAll('_', ' ')
    .replace(/\b\w/g, character => character.toUpperCase())
}

function formatRelativeTime(timestamp: number): string {
  if (!timestamp)
    return 'Not recorded'

  const minutes = Math.max(0, Math.floor((Date.now() - timestamp) / 60000))
  if (minutes < 1)
    return 'Just now'
  if (minutes < 60)
    return `${minutes}m ago`

  const hours = Math.floor(minutes / 60)
  if (hours < 24)
    return `${hours}h ago`
  return `${Math.floor(hours / 24)}d ago`
}

async function loadOverview(): Promise<void> {
  loading.set(true)
  loadError.set('')

  try {
    const data = await dashboardApi<DeliveryOverviewResponse>('/api/dashboard/commerce/delivery')
    if (
      !data
      || !Array.isArray(data.stats)
      || !Array.isArray(data.routes)
      || !Array.isArray(data.methods)
      || !Array.isArray(data.zones)
      || !data.drivers
    ) {
      throw new TypeError('Delivery resources were not returned in the expected shape.')
    }

    stats.set(data.stats)
    routes.set(data.routes)
    methods.set(data.methods)
    zones.set(data.zones)
    drivers.set(data.drivers)
  }
  catch (error) {
    loadError.set(error instanceof Error ? error.message : String(error))
    pushToast('error', 'Could not load delivery overview', { detail: loadError() })
  }
  finally {
    loading.set(false)
  }
}

onMount(() => {
  void loadOverview()
})
</script>

<div class="space-y-6">
  <TabNavigation model-value="overview" />

  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="font-bold text-2xl text-gray-900 dark:text-white">Delivery</h1>
      <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Monitor active routes, driver availability, shipping methods, and coverage.</p>
    </div>
    <div class="flex gap-2">
      <Button :loading="loading()" variant="secondary" @click="loadOverview()">
        <span :if="!loading()" aria-hidden="true" class="h-4 w-4 i-hugeicons-refresh"></span>
        Refresh
      </Button>
      <Button href="/commerce/delivery/delivery-routes">
        <span aria-hidden="true" class="h-4 w-4 i-hugeicons-route-02"></span>
        Manage routes
      </Button>
    </div>
  </header>

  <div :if="loadError()" role="alert" class="flex gap-4 items-center justify-between p-4 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">
    <span>{{ loadError() }}</span>
    <Button variant="secondary" size="sm" @click="loadOverview()">Retry</Button>
  </div>

  <div :if="loading()" aria-label="Loading delivery overview" class="space-y-6 animate-pulse">
    <div class="grid gap-3 grid-cols-1 sm:grid-cols-2 xl:grid-cols-4">
      <div class="h-28 bg-gray-200/70 dark:bg-neutral-800 rounded-lg"></div>
      <div class="h-28 bg-gray-200/70 dark:bg-neutral-800 rounded-lg"></div>
      <div class="h-28 bg-gray-200/70 dark:bg-neutral-800 rounded-lg"></div>
      <div class="h-28 bg-gray-200/70 dark:bg-neutral-800 rounded-lg"></div>
    </div>
    <div class="grid gap-6 grid-cols-1 lg:grid-cols-3">
      <div class="lg:col-span-2 h-80 bg-gray-200/70 dark:bg-neutral-800 rounded-xl"></div>
      <div class="h-80 bg-gray-200/70 dark:bg-neutral-800 rounded-xl"></div>
    </div>
  </div>

  <div :if="!loading() && !loadError()" class="space-y-6">
    <section aria-label="Delivery metrics" class="grid gap-3 grid-cols-1 sm:grid-cols-2 xl:grid-cols-4">
      <template :for="item in stats()" :key="item.label">
        <article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
          <div class="flex items-start justify-between">
            <p class="text-gray-500 text-xs dark:text-neutral-400">{{ item.label }}</p>
            <span :class="'h-5 w-5 text-blue-600 dark:text-blue-400 ' + statIcon(item.label)"></span>
          </div>
          <p class="mt-2 font-semibold tabular-nums text-2xl text-gray-900 dark:text-white">{{ item.value }}</p>
          <p class="mt-1 text-gray-400 text-xs dark:text-neutral-500">{{ item.detail }}</p>
        </article>
      </template>
    </section>

    <div class="grid gap-6 grid-cols-1 lg:grid-cols-3">
      <section class="overflow-hidden lg:col-span-2 bg-white dark:bg-neutral-800 border border-gray-200 rounded-xl dark:border-neutral-700">
        <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200 dark:border-neutral-700">
          <div>
            <h2 class="font-semibold text-gray-900 dark:text-white">Routes active in 24 hours</h2>
            <p class="mt-0.5 text-gray-500 text-xs dark:text-neutral-400">Most recently active persisted route plans.</p>
          </div>
          <a href="/commerce/delivery/delivery-routes" class="font-semibold text-blue-600 text-sm dark:text-blue-400 hover:text-blue-500">View all</a>
        </div>

        <div :if="routes().length === 0" class="px-6 py-14 text-center">
          <span class="inline-block h-8 w-8 text-gray-400 i-hugeicons-route-02"></span>
          <p class="mt-2 font-medium text-gray-800 text-sm dark:text-neutral-200">No active delivery routes</p>
          <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Add a route or update its activity to include it here.</p>
        </div>

        <div :if="routes().length > 0" class="overflow-x-auto">
          <table class="min-w-full divide-gray-200 divide-y dark:divide-neutral-700">
            <thead class="bg-gray-50 dark:bg-neutral-900/40">
              <tr>
                <th scope="col" class="px-5 py-3 font-medium text-gray-500 text-left text-xs tracking-wide uppercase dark:text-neutral-400">Driver</th>
                <th scope="col" class="px-4 py-3 font-medium text-gray-500 text-left text-xs tracking-wide uppercase dark:text-neutral-400">Plan</th>
                <th scope="col" class="px-4 py-3 font-medium text-gray-500 text-left text-xs tracking-wide uppercase dark:text-neutral-400">Distance</th>
                <th scope="col" class="px-5 py-3 font-medium text-gray-500 text-right text-xs tracking-wide uppercase dark:text-neutral-400">Last active</th>
              </tr>
            </thead>
            <tbody class="divide-gray-100 divide-y dark:divide-neutral-700">
              <template :for="route in routes()" :key="route.id">
                <tr class="hover:bg-gray-50/70 dark:hover:bg-neutral-700/40">
                  <td class="px-5 py-3.5">
                    <p class="font-medium text-gray-900 text-sm dark:text-white">{{ route.driver }}</p>
                    <p class="mt-0.5 text-gray-500 text-xs dark:text-neutral-400">{{ route.vehicle }}</p>
                  </td>
                  <td class="px-4 py-3.5 text-gray-600 text-sm whitespace-nowrap dark:text-neutral-300">
                    <span class="font-medium tabular-nums text-gray-900 dark:text-white">{{ route.stops }}</span>
                    {{ route.stops === 1 ? 'stop' : 'stops' }}
                    <span class="mx-1 text-gray-300 dark:text-neutral-600">/</span>
                    {{ route.duration }}
                  </td>
                  <td class="px-4 py-3.5 text-gray-600 text-sm whitespace-nowrap dark:text-neutral-300">{{ route.distance }}</td>
                  <td class="px-5 py-3.5 text-gray-500 text-right text-sm whitespace-nowrap dark:text-neutral-400">{{ formatRelativeTime(route.lastActive) }}</td>
                </tr>
              </template>
            </tbody>
          </table>
        </div>
      </section>

      <section class="p-5 text-white bg-stone-950 rounded-xl">
        <div class="flex items-start justify-between">
          <div>
            <h2 class="font-semibold">Fleet availability</h2>
            <p class="mt-1 text-sm text-stone-400">Current persisted driver statuses.</p>
          </div>
          <span class="h-5 w-5 text-blue-400 i-hugeicons-delivery-truck-02"></span>
        </div>
        <div class="mt-7">
          <p class="font-semibold tabular-nums text-4xl tracking-tight">{{ drivers().total }}</p>
          <p class="mt-1 text-sm text-stone-400">Drivers in the fleet</p>
        </div>
        <dl class="mt-7 space-y-3">
          <div class="flex items-center justify-between py-2 border-b border-stone-800">
            <dt class="flex gap-2 items-center text-sm text-stone-300"><span class="h-2 w-2 bg-emerald-400 rounded-full"></span>Available</dt>
            <dd class="font-semibold tabular-nums">{{ drivers().active }}</dd>
          </div>
          <div class="flex items-center justify-between py-2 border-b border-stone-800">
            <dt class="flex gap-2 items-center text-sm text-stone-300"><span class="h-2 w-2 bg-blue-400 rounded-full"></span>On delivery</dt>
            <dd class="font-semibold tabular-nums">{{ drivers().onDelivery }}</dd>
          </div>
          <div class="flex items-center justify-between py-2">
            <dt class="flex gap-2 items-center text-sm text-stone-300"><span class="h-2 w-2 bg-amber-400 rounded-full"></span>On break</dt>
            <dd class="font-semibold tabular-nums">{{ drivers().onBreak }}</dd>
          </div>
        </dl>
        <a href="/commerce/delivery/drivers" class="inline-flex gap-2 items-center mt-6 font-semibold text-blue-300 text-sm hover:text-blue-200">
          Manage drivers
          <span class="h-4 w-4 i-hugeicons-arrow-right-01"></span>
        </a>
      </section>
    </div>

    <div class="grid gap-6 grid-cols-1 lg:grid-cols-2">
      <section class="overflow-hidden bg-white dark:bg-neutral-800 border border-gray-200 rounded-xl dark:border-neutral-700">
        <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200 dark:border-neutral-700">
          <div>
            <h2 class="font-semibold text-gray-900 dark:text-white">Shipping methods</h2>
            <p class="mt-0.5 text-gray-500 text-xs dark:text-neutral-400">Active methods are listed first.</p>
          </div>
          <a href="/commerce/delivery/shipping-methods" class="font-semibold text-blue-600 text-sm dark:text-blue-400 hover:text-blue-500">Manage</a>
        </div>
        <div :if="methods().length === 0" class="px-6 py-10 text-center text-gray-500 text-sm dark:text-neutral-400">No shipping methods configured.</div>
        <ul :if="methods().length > 0" class="divide-gray-100 divide-y dark:divide-neutral-700">
          <template :for="method in methods()" :key="method.id">
            <li class="flex gap-4 items-center justify-between px-5 py-3.5">
              <div class="min-w-0">
                <div class="flex gap-2 items-center">
                  <p class="font-medium text-gray-900 text-sm truncate dark:text-white">{{ method.name }}</p>
                  <span :class="'inline-flex px-2 py-0.5 font-medium text-xs ring-1 ring-inset rounded-full ' + statusClass(method.status)">{{ formatStatus(method.status) }}</span>
                </div>
                <p class="mt-1 text-gray-500 text-xs dark:text-neutral-400">Free shipping: {{ method.freeShipping }}</p>
              </div>
              <p class="font-semibold tabular-nums text-gray-900 text-sm whitespace-nowrap dark:text-white">{{ method.baseRate }}</p>
            </li>
          </template>
        </ul>
      </section>

      <section class="overflow-hidden bg-white dark:bg-neutral-800 border border-gray-200 rounded-xl dark:border-neutral-700">
        <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200 dark:border-neutral-700">
          <div>
            <h2 class="font-semibold text-gray-900 dark:text-white">Shipping zones</h2>
            <p class="mt-0.5 text-gray-500 text-xs dark:text-neutral-400">Active regional coverage is listed first.</p>
          </div>
          <a href="/commerce/delivery/shipping-zones" class="font-semibold text-blue-600 text-sm dark:text-blue-400 hover:text-blue-500">Manage</a>
        </div>
        <div :if="zones().length === 0" class="px-6 py-10 text-center text-gray-500 text-sm dark:text-neutral-400">No shipping zones configured.</div>
        <ul :if="zones().length > 0" class="divide-gray-100 divide-y dark:divide-neutral-700">
          <template :for="zone in zones()" :key="zone.id">
            <li class="flex gap-4 items-center justify-between px-5 py-3.5">
              <div class="min-w-0">
                <div class="flex gap-2 items-center">
                  <p class="font-medium text-gray-900 text-sm truncate dark:text-white">{{ zone.name }}</p>
                  <span :class="'inline-flex px-2 py-0.5 font-medium text-xs ring-1 ring-inset rounded-full ' + statusClass(zone.status)">{{ formatStatus(zone.status) }}</span>
                </div>
                <p class="mt-1 text-gray-500 text-xs dark:text-neutral-400">{{ zone.regions }} regional {{ zone.regions === 1 ? 'assignment' : 'assignments' }}</p>
              </div>
              <div class="text-right">
                <p class="font-semibold tabular-nums text-gray-900 text-sm dark:text-white">{{ zone.countries }}</p>
                <p class="text-gray-500 text-xs dark:text-neutral-400">countries</p>
              </div>
            </li>
          </template>
        </ul>
      </section>
    </div>
  </div>
</div>
