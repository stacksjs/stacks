<script client>
type DriverStatus = 'active' | 'on_delivery' | 'on_break'

interface DriverRow {
  id: number
  name: string
  phone: string
  vehicle_number: string
  license: string
  status: DriverStatus
  user_id?: number | null
  user?: { id: number, name: string, email?: string }
}

const drivers = useReactiveProp('drivers', [] as DriverRow[])
const emit = defineEmits()

function statusLabel(status: DriverStatus): string {
  return {
    active: 'Available',
    on_delivery: 'On delivery',
    on_break: 'On break',
  }[status] || status
}

function statusClass(status: DriverStatus): string {
  if (status === 'active')
    return 'bg-green-50 text-green-700 ring-green-600/20 dark:bg-green-900/30 dark:text-green-300'
  if (status === 'on_delivery')
    return 'bg-blue-50 text-blue-700 ring-blue-600/20 dark:bg-blue-900/30 dark:text-blue-300'
  return 'bg-amber-50 text-amber-700 ring-amber-600/20 dark:bg-amber-900/30 dark:text-amber-300'
}
</script>

<div class="overflow-x-auto border border-stone-200/80 rounded-xl dark:border-neutral-700 shadow-sm">
  <table class="min-w-full divide-stone-100 divide-y dark:divide-neutral-700">
    <thead class="bg-stone-50/80 dark:bg-neutral-800">
      <tr>
        <th scope="col" class="pl-6 pr-3 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">Driver</th>
        <th scope="col" class="px-4 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">Phone</th>
        <th scope="col" class="px-4 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">Vehicle</th>
        <th scope="col" class="px-4 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">License</th>
        <th scope="col" class="px-4 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">User</th>
        <th scope="col" class="px-4 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">Status</th>
        <th scope="col" class="relative pl-3 pr-6 py-3.5">
          <span class="sr-only">Actions</span>
        </th>
      </tr>
    </thead>
    <tbody class="bg-white dark:bg-neutral-800 divide-stone-100 divide-y dark:divide-neutral-700">
      <template :for="driver in drivers" :key="driver.id">
        <tr class="hover:bg-stone-50/50 dark:hover:bg-neutral-700/50 transition-colors">
          <td class="pl-6 pr-3 py-3.5 font-medium text-sm text-stone-800 whitespace-nowrap dark:text-white">
            {{ driver.name }}
          </td>
          <td class="px-4 py-3.5 text-sm text-stone-500 whitespace-nowrap dark:text-neutral-300">
            {{ driver.phone }}
          </td>
          <td class="px-4 py-3.5 font-mono text-sm text-stone-500 whitespace-nowrap dark:text-neutral-300">
            {{ driver.vehicle_number }}
          </td>
          <td class="px-4 py-3.5 font-mono text-sm text-stone-500 whitespace-nowrap dark:text-neutral-300">
            {{ driver.license }}
          </td>
          <td class="px-4 py-3.5 text-sm text-stone-500 whitespace-nowrap dark:text-neutral-300">
            {{ driver.user?.name || (driver.user_id ? 'User #' + driver.user_id : 'Not linked') }}
          </td>
          <td class="px-4 py-3.5 text-sm whitespace-nowrap">
            <span :class="'inline-flex items-center px-2 py-1 font-medium text-xs ring-1 ring-inset rounded-md ' + statusClass(driver.status)">
              {{ statusLabel(driver.status) }}
            </span>
          </td>
          <td class="relative pl-3 pr-6 py-3.5 font-medium text-right text-sm whitespace-nowrap">
            <Button
              variant="ghost"
              size="sm"
              iconOnly
              @click="emit('edit', driver)"
              :ariaLabel="'Edit driver ' + driver.name + ', record ' + driver.id"
            >
              <span class="block h-4 w-4 text-blue-500 i-hugeicons-edit-01"></span>
            </Button>
            <Button
              variant="ghost"
              size="sm"
              iconOnly
              @click="emit('delete', driver)"
              :ariaLabel="'Delete driver ' + driver.name + ', record ' + driver.id"
            >
              <span class="block h-4 w-4 text-red-500 i-hugeicons-waste"></span>
            </Button>
          </td>
        </tr>
      </template>

      <tr :if="drivers().length === 0">
        <td colspan="7" class="px-6 py-12 text-center text-sm text-stone-500 dark:text-neutral-400">
          No drivers found.
        </td>
      </tr>
    </tbody>
  </table>
</div>
