<script client>
interface DeliveryRouteRow {
  id: number
  driver: string
  driver_id?: number | null
  driver_record?: { id: number, name: string, vehicle_number: string }
  vehicle: string
  stops: number
  delivery_time: number
  total_distance: number
  last_active: string
}

const routes = useReactiveProp('routes', [] as DeliveryRouteRow[])
const emit = defineEmits()

function formatDateTime(value: string): string {
  if (!value)
    return 'Not recorded'

  const normalized = value.includes('T') ? value : value.replace(' ', 'T')
  const date = new Date(normalized)
  if (Number.isNaN(date.getTime()))
    return value

  return new Intl.DateTimeFormat('en-US', {
    dateStyle: 'medium',
    timeStyle: 'short',
  }).format(date)
}

function formatNumber(value: number): string {
  return new Intl.NumberFormat('en-US', { maximumFractionDigits: 2 }).format(value)
}
</script>

<div class="overflow-x-auto border border-stone-200/80 rounded-xl dark:border-neutral-700 shadow-sm">
  <table class="min-w-full divide-stone-100 divide-y dark:divide-neutral-700">
    <thead class="bg-stone-50/80 dark:bg-neutral-800">
      <tr>
        <th scope="col" class="pl-6 pr-3 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">Route</th>
        <th scope="col" class="px-4 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">Driver</th>
        <th scope="col" class="px-4 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">Vehicle</th>
        <th scope="col" class="px-4 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">Stops</th>
        <th scope="col" class="px-4 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">Time</th>
        <th scope="col" class="px-4 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">Distance</th>
        <th scope="col" class="px-4 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">Last Active</th>
        <th scope="col" class="relative pl-3 pr-6 py-3.5">
          <span class="sr-only">Actions</span>
        </th>
      </tr>
    </thead>
    <tbody class="bg-white dark:bg-neutral-800 divide-stone-100 divide-y dark:divide-neutral-700">
      <template :for="route in routes" :key="route.id">
        <tr class="hover:bg-stone-50/50 dark:hover:bg-neutral-700/50 transition-colors">
          <td class="pl-6 pr-3 py-3.5 font-medium tabular-nums text-sm text-stone-800 whitespace-nowrap dark:text-white">
            #{{ route.id }}
          </td>
          <td class="px-4 py-3.5 font-medium text-sm text-stone-800 whitespace-nowrap dark:text-white">
            <span class="block">{{ route.driver_record?.name || route.driver }}</span>
            <span class="block font-normal text-stone-400 text-xs dark:text-neutral-500">{{ route.driver_id ? 'Linked driver #' + route.driver_id : 'Legacy snapshot' }}</span>
          </td>
          <td class="px-4 py-3.5 text-sm text-stone-500 whitespace-nowrap dark:text-neutral-300">
            {{ route.vehicle }}
          </td>
          <td class="px-4 py-3.5 tabular-nums text-sm text-stone-500 whitespace-nowrap dark:text-neutral-300">
            {{ route.stops }}
          </td>
          <td class="px-4 py-3.5 tabular-nums text-sm text-stone-500 whitespace-nowrap dark:text-neutral-300">
            {{ formatNumber(route.delivery_time) }} min
          </td>
          <td class="px-4 py-3.5 tabular-nums text-sm text-stone-500 whitespace-nowrap dark:text-neutral-300">
            {{ formatNumber(route.total_distance) }} mi
          </td>
          <td class="px-4 py-3.5 text-sm text-stone-500 whitespace-nowrap dark:text-neutral-300">
            {{ formatDateTime(route.last_active) }}
          </td>
          <td class="relative pl-3 pr-6 py-3.5 font-medium text-right text-sm whitespace-nowrap">
            <button
              type="button"
              @click="emit('edit', route)"
              :aria-label="'Edit delivery route ' + route.id + ' for ' + route.driver"
              class="mr-1 p-2 text-stone-400 hover:text-blue-700 dark:hover:text-blue-300 rounded-md transition-colors"
            >
              <span class="block h-5 w-5 i-hugeicons-edit-01"></span>
            </button>
            <button
              type="button"
              @click="emit('delete', route)"
              :aria-label="'Delete delivery route ' + route.id + ' for ' + route.driver"
              class="p-2 text-stone-400 hover:text-red-700 dark:hover:text-red-300 rounded-md transition-colors"
            >
              <span class="block h-5 w-5 i-hugeicons-waste"></span>
            </button>
          </td>
        </tr>
      </template>

      <tr :if="routes().length === 0">
        <td colspan="8" class="px-6 py-12 text-center text-sm text-stone-500 dark:text-neutral-400">
          No delivery routes found.
        </td>
      </tr>
    </tbody>
  </table>
</div>
