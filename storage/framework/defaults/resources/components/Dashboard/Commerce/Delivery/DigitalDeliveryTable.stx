<script client>
type DigitalDeliveryStatus = 'active' | 'inactive'

interface DigitalDeliveryRow {
  id: number
  name: string
  description: string
  download_limit?: number | null
  expiry_days: number
  requires_login: boolean | number
  automatic_delivery: boolean | number
  status: DigitalDeliveryStatus
}

const methods = useReactiveProp('methods', [] as DigitalDeliveryRow[])
const emit = defineEmits()

function statusClass(status: DigitalDeliveryStatus): string {
  return status === 'active'
    ? 'bg-green-50 text-green-700 ring-green-600/20 dark:bg-green-900/30 dark:text-green-300'
    : 'bg-stone-100 text-stone-600 ring-stone-500/20 dark:bg-neutral-700 dark:text-neutral-300'
}

function yesNo(value: boolean | number): string {
  return Boolean(value) ? 'Yes' : 'No'
}
</script>

<div class="overflow-x-auto border border-stone-200/80 rounded-xl dark:border-neutral-700 shadow-sm">
  <table class="min-w-full divide-stone-100 divide-y dark:divide-neutral-700">
    <thead class="bg-stone-50/80 dark:bg-neutral-800">
      <tr>
        <th scope="col" class="pl-6 pr-3 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">Method</th>
        <th scope="col" class="px-4 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">Description</th>
        <th scope="col" class="px-4 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">Downloads</th>
        <th scope="col" class="px-4 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">Expiry</th>
        <th scope="col" class="px-4 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">Login</th>
        <th scope="col" class="px-4 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">Automatic</th>
        <th scope="col" class="px-4 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">Status</th>
        <th scope="col" class="relative pl-3 pr-6 py-3.5">
          <span class="sr-only">Actions</span>
        </th>
      </tr>
    </thead>
    <tbody class="bg-white dark:bg-neutral-800 divide-stone-100 divide-y dark:divide-neutral-700">
      <template :for="method in methods" :key="method.id">
        <tr class="hover:bg-stone-50/50 dark:hover:bg-neutral-700/50 transition-colors">
          <td class="pl-6 pr-3 py-3.5 font-medium text-sm text-stone-800 whitespace-nowrap dark:text-white">
            {{ method.name }}
          </td>
          <td class="px-4 py-3.5 max-w-72 text-sm text-stone-500 dark:text-neutral-300">
            <span class="block truncate" :title="method.description">{{ method.description }}</span>
          </td>
          <td class="px-4 py-3.5 tabular-nums text-sm text-stone-500 whitespace-nowrap dark:text-neutral-300">
            {{ method.download_limit ?? 'Unlimited' }}
          </td>
          <td class="px-4 py-3.5 tabular-nums text-sm text-stone-500 whitespace-nowrap dark:text-neutral-300">
            {{ method.expiry_days }} days
          </td>
          <td class="px-4 py-3.5 text-sm text-stone-500 whitespace-nowrap dark:text-neutral-300">
            {{ yesNo(method.requires_login) }}
          </td>
          <td class="px-4 py-3.5 text-sm text-stone-500 whitespace-nowrap dark:text-neutral-300">
            {{ yesNo(method.automatic_delivery) }}
          </td>
          <td class="px-4 py-3.5 text-sm whitespace-nowrap">
            <span :class="'inline-flex items-center px-2 py-1 font-medium text-xs ring-1 ring-inset rounded-md ' + statusClass(method.status)">
              {{ method.status === 'active' ? 'Active' : 'Inactive' }}
            </span>
          </td>
          <td class="relative pl-3 pr-6 py-3.5 font-medium text-right text-sm whitespace-nowrap">
            <Button
              variant="ghost"
              size="sm"
              iconOnly
              @click="emit('edit', method)"
              :ariaLabel="'Edit digital delivery method ' + method.name + ', record ' + method.id"
            >
              <span class="block h-4 w-4 text-blue-500 i-hugeicons-edit-01"></span>
            </Button>
            <Button
              variant="ghost"
              size="sm"
              iconOnly
              @click="emit('delete', method)"
              :ariaLabel="'Delete digital delivery method ' + method.name + ', record ' + method.id"
            >
              <span class="block h-4 w-4 text-red-500 i-hugeicons-waste"></span>
            </Button>
          </td>
        </tr>
      </template>

      <tr :if="methods().length === 0">
        <td colspan="8" class="px-6 py-12 text-center text-sm text-stone-500 dark:text-neutral-400">
          No digital delivery methods found.
        </td>
      </tr>
    </tbody>
  </table>
</div>
