<script client>
interface ShippingResourceOption {
  id: number
  name: string
}

interface ShippingRateRecord {
  id: number
  shipping_method_id: number
  shipping_zone_id: number
  weight_from: number
  weight_to: number
  rate: number
}

const open = useReactiveProp('open', false)
const mode = useReactiveProp('mode', 'create')
const record = useReactiveProp('record', null as ShippingRateRecord | null)
const methods = useReactiveProp('methods', [] as ShippingResourceOption[])
const zones = useReactiveProp('zones', [] as ShippingResourceOption[])
const busy = useReactiveProp('busy', false)
const error = useReactiveProp('error', '')
const emit = defineEmits()
const methodId = state('')
const zoneId = state('')
const weightFrom = state('')
const weightTo = state('')
const amount = state('')
let hydrationKey = ''

effect(() => {
  if (!open()) {
    hydrationKey = ''
    return
  }
  const current = record()
  const nextKey = `${mode()}:${current?.id || 'new'}`
  if (hydrationKey === nextKey)
    return
  hydrationKey = nextKey
  methodId.set(current ? String(current.shipping_method_id) : '')
  zoneId.set(current ? String(current.shipping_zone_id) : '')
  weightFrom.set(current ? String(current.weight_from) : '')
  weightTo.set(current ? String(current.weight_to) : '')
  amount.set(current ? (current.rate / 100).toFixed(2) : '')
})

function submit(): void {
  const selectedMethodId = Number(methodId())
  const selectedZoneId = Number(zoneId())
  const from = Number(weightFrom())
  const to = Number(weightTo())
  const rate = Number(amount())

  if (!Number.isInteger(selectedMethodId) || selectedMethodId < 1) {
    emit('invalid', 'Select a shipping method.')
    return
  }
  if (!Number.isInteger(selectedZoneId) || selectedZoneId < 1) {
    emit('invalid', 'Select a shipping zone.')
    return
  }
  if (!Number.isFinite(from) || from < 0) {
    emit('invalid', 'Starting weight must be a non-negative number.')
    return
  }
  if (!Number.isFinite(to) || to < from) {
    emit('invalid', 'Ending weight must be greater than or equal to the starting weight.')
    return
  }
  if (!Number.isFinite(rate) || rate < 0) {
    emit('invalid', 'Rate must be a non-negative amount.')
    return
  }

  emit('submit', {
    shippingMethodId: selectedMethodId,
    shippingZoneId: selectedZoneId,
    weightFrom: from,
    weightTo: to,
    rate: Math.round(rate * 100),
  })
}
</script>

<div :if="open()" class="flex fixed inset-0 z-50 items-center justify-center p-4 dashboard-modal-layer">
  <button type="button" aria-label="Close shipping rate dialog" class="absolute inset-0 bg-black/45" @click="emit('close')"></button>
  <section role="dialog" aria-modal="true" aria-labelledby="shipping-rate-dialog-title" class="overflow-y-auto relative max-h-[92dvh] max-w-lg w-full bg-white dark:bg-neutral-800 border border-gray-200 rounded-xl dark:border-neutral-700 shadow-xl">
    <form @submit.prevent="submit()">
      <div class="p-6">
        <h2 id="shipping-rate-dialog-title" class="font-semibold text-gray-900 text-lg dark:text-white">{{ mode() === 'edit' ? 'Edit shipping rate' : 'Add shipping rate' }}</h2>
        <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Connect a persisted method and zone to an exact weight band.</p>
        <div :if="error()" class="mt-4 p-3 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">{{ error() }}</div>

        <div class="mt-5 space-y-4">
          <label class="block">
            <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Shipping method</span>
            <select x-model="methodId" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700">
              <option value="">Select a shipping method</option>
              <template :for="method in methods()" :key="method.id"><option :value="method.id">{{ method.name }}</option></template>
            </select>
          </label>
          <label class="block">
            <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Shipping zone</span>
            <select x-model="zoneId" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700">
              <option value="">Select a shipping zone</option>
              <template :for="zone in zones()" :key="zone.id"><option :value="zone.id">{{ zone.name }}</option></template>
            </select>
          </label>
          <div class="grid gap-4 grid-cols-1 sm:grid-cols-2">
            <label class="block"><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Weight from (kg)</span><input x-model="weightFrom" type="number" required min="0" step="0.01" inputmode="decimal" placeholder="0.00" class="mt-1 px-3 py-2 w-full tabular-nums text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" /></label>
            <label class="block"><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Weight to (kg)</span><input x-model="weightTo" type="number" required min="0" step="0.01" inputmode="decimal" placeholder="10.00" class="mt-1 px-3 py-2 w-full tabular-nums text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" /></label>
          </div>
          <label class="block"><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Rate</span><input x-model="amount" type="number" required min="0" step="0.01" inputmode="decimal" placeholder="5.99" class="mt-1 px-3 py-2 w-full tabular-nums text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" /></label>
        </div>
      </div>
      <footer class="flex gap-2 justify-end px-6 py-4 bg-gray-50 dark:bg-neutral-900/50 border-gray-200 border-t dark:border-neutral-700">
        <Button :disabled="busy()" variant="secondary" @click="emit('close')">Cancel</Button>
        <Button type="submit" :loading="busy()">{{ mode() === 'edit' ? 'Save changes' : 'Add rate' }}</Button>
      </footer>
    </form>
  </section>
</div>
