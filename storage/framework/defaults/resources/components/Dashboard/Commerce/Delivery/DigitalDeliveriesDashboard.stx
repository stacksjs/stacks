<script client>
import { dashboardApi } from '../../../../../functions/dashboard-api'
import { pushToast } from '../../../../../functions/toasts'

type DigitalDeliveryStatus = 'active' | 'inactive'

interface DigitalDeliveryRecord {
  id: number
  name: string
  description: string
  download_limit?: number | null
  expiry_days: number
  requires_login: boolean
  automatic_delivery: boolean
  status: DigitalDeliveryStatus
}

interface DigitalDeliveryPayload {
  name: string
  description: string
  downloadLimit: number | null
  expiryDays: number
  requiresLogin: boolean
  automaticDelivery: boolean
  status: DigitalDeliveryStatus
}

const records = state<DigitalDeliveryRecord[]>([])
const loading = state(true)
const loadError = state('')
const search = state('')
const page = state(1)
const perPage = state(10)
const editorOpen = state(false)
const editorMode = state<'create' | 'edit'>('create')
const editing = state<DigitalDeliveryRecord | null>(null)
const saving = state(false)
const editorError = state('')
const deleting = state<DigitalDeliveryRecord | null>(null)
const deleteBusy = state(false)
const deleteError = state('')

function filteredRecords(): DigitalDeliveryRecord[] {
  const query = search().trim().toLowerCase()
  if (!query)
    return records()
  return records().filter(record => [
    record.name,
    record.description,
    record.status,
    record.download_limit ?? 'unlimited',
    record.expiry_days,
  ].some(value => String(value).toLowerCase().includes(query)))
}

function paginatedRecords(): DigitalDeliveryRecord[] {
  const start = (page() - 1) * perPage()
  return filteredRecords().slice(start, start + perPage())
}

function metricCards(): Array<{ label: string, value: string, detail: string }> {
  return [
    { label: 'Methods', value: records().length.toLocaleString(), detail: 'Persisted digital delivery records' },
    { label: 'Active', value: records().filter(record => record.status === 'active').length.toLocaleString(), detail: 'Available for fulfillment' },
    { label: 'Automatic', value: records().filter(record => record.automatic_delivery).length.toLocaleString(), detail: 'Delivered after payment' },
    { label: 'Login required', value: records().filter(record => record.requires_login).length.toLocaleString(), detail: 'Protected customer access' },
  ]
}

async function loadMethods(): Promise<void> {
  loading.set(true)
  loadError.set('')
  try {
    const data = await dashboardApi<DigitalDeliveryRecord[]>('/api/dashboard/commerce/digital-deliveries')
    if (!Array.isArray(data))
      throw new TypeError('Digital delivery records were not returned in the expected shape.')
    records.set(data)
    const lastPage = Math.max(1, Math.ceil(filteredRecords().length / perPage()))
    if (page() > lastPage)
      page.set(lastPage)
  }
  catch (error) {
    loadError.set(error instanceof Error ? error.message : String(error))
    pushToast('error', 'Could not load digital delivery', { detail: loadError() })
  }
  finally {
    loading.set(false)
  }
}

function handleSearch(value: string): void {
  search.set(value)
  page.set(1)
}

function openCreate(): void {
  editing.set(null)
  editorMode.set('create')
  editorError.set('')
  editorOpen.set(true)
}

function openEdit(record: DigitalDeliveryRecord): void {
  editing.set(record)
  editorMode.set('edit')
  editorError.set('')
  editorOpen.set(true)
}

function closeEditor(): void {
  if (saving())
    return
  editorOpen.set(false)
  editing.set(null)
  editorError.set('')
}

function setEditorError(message: string): void {
  editorError.set(message)
}

async function saveMethod(payload: DigitalDeliveryPayload): Promise<void> {
  saving.set(true)
  editorError.set('')
  try {
    const current = editing()
    const updated = await dashboardApi<DigitalDeliveryRecord>(
      current
        ? `/api/dashboard/commerce/digital-deliveries/${current.id}`
        : '/api/dashboard/commerce/digital-deliveries',
      {
        method: current ? 'PATCH' : 'POST',
        body: payload,
      },
    )
    if (current) {
      records.set(records().map(record => record.id === current.id ? updated : record))
    }
    else {
      const nextRecords = [...records(), updated]
      records.set(nextRecords)
      page.set(Math.max(1, Math.ceil(nextRecords.length / perPage())))
    }
    editorOpen.set(false)
    editing.set(null)
    pushToast('success', current ? 'Digital delivery updated' : 'Digital delivery added', { detail: updated.name })
  }
  catch (error) {
    editorError.set(error instanceof Error ? error.message : String(error))
  }
  finally {
    saving.set(false)
  }
}

function requestDelete(record: DigitalDeliveryRecord): void {
  deleting.set(record)
  deleteError.set('')
}

function closeDelete(): void {
  if (deleteBusy())
    return
  deleting.set(null)
  deleteError.set('')
}

async function confirmDelete(): Promise<void> {
  const current = deleting()
  if (!current)
    return
  deleteBusy.set(true)
  deleteError.set('')
  try {
    await dashboardApi(`/api/dashboard/commerce/digital-deliveries/${current.id}`, {
      method: 'DELETE',
    })
    records.set(records().filter(record => record.id !== current.id))
    deleting.set(null)
    const lastPage = Math.max(1, Math.ceil(filteredRecords().length / perPage()))
    if (page() > lastPage)
      page.set(lastPage)
    pushToast('success', 'Digital delivery deleted', { detail: current.name })
  }
  catch (error) {
    deleteError.set(error instanceof Error ? error.message : String(error))
  }
  finally {
    deleteBusy.set(false)
  }
}

function goToPage(value: number): void {
  page.set(value)
}

onMount(() => {
  void loadMethods()
})
</script>

<div class="space-y-6">
  <TabNavigation model-value="digital" />

  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="font-bold text-2xl text-gray-900 dark:text-white">Digital delivery</h1>
      <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Control file access, download limits, expiry, and automatic fulfillment.</p>
    </div>
    <div class="flex gap-2">
      <Button :loading="loading()" variant="secondary" @click="loadMethods()"><span :if="!loading()" aria-hidden="true" class="h-4 w-4 i-hugeicons-refresh"></span>Refresh</Button>
      <Button :disabled="loading()" @click="openCreate()"><span aria-hidden="true" class="h-4 w-4 i-hugeicons-add-01"></span>Add method</Button>
    </div>
  </header>

  <div :if="loadError()" class="flex gap-4 items-center justify-between p-4 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900"><span>{{ loadError() }}</span><Button variant="secondary" size="sm" @click="loadMethods()">Retry</Button></div>

  <section aria-label="Digital delivery metrics" class="grid gap-3 grid-cols-1 sm:grid-cols-2 xl:grid-cols-4">
    <template :for="item in metricCards()" :key="item.label"><article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700"><p class="text-gray-500 text-xs dark:text-neutral-400">{{ item.label }}</p><p class="mt-2 font-semibold text-2xl text-gray-900 dark:text-white">{{ item.value }}</p><p class="mt-1 text-gray-400 text-xs dark:text-neutral-500">{{ item.detail }}</p></article></template>
  </section>

  <section class="overflow-hidden bg-white dark:bg-neutral-800 border border-gray-200 rounded-xl dark:border-neutral-700">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between px-4 py-4 border-b border-gray-200 dark:border-neutral-700">
      <div><h2 class="font-semibold text-gray-900 dark:text-white">Delivery methods</h2><p class="mt-0.5 text-gray-500 text-xs dark:text-neutral-400">{{ filteredRecords().length }} matching records</p></div>
      <SearchFilter placeholder="Search digital delivery" class="w-full sm:w-80" @search="handleSearch" />
    </div>
    <div :if="loading()" class="flex items-center justify-center py-24 text-gray-500 text-sm dark:text-neutral-400"><span class="mr-2 h-4 w-4 animate-spin i-hugeicons-loading-03"></span>Loading digital delivery</div>
    <DigitalDeliveryTable :if="!loading()" :methods="paginatedRecords()" @edit="openEdit" @delete="requestDelete" />
    <div :if="!loading()" class="px-4 py-3 bg-gray-50 dark:bg-neutral-900/50 border-gray-200 border-t dark:border-neutral-700">
      <DeliveryPagination :current-page="page()" :total-items="filteredRecords().length" :items-per-page="perPage()" @select="goToPage" />
    </div>
  </section>
</div>

<DigitalDeliveryDialog :open="editorOpen()" :mode="editorMode()" :record="editing()" :busy="saving()" :error="editorError()" @submit="saveMethod" @invalid="setEditorError" @close="closeEditor()" />
<DigitalDeliveryDeleteDialog :open="Boolean(deleting())" :record="deleting()" :busy="deleteBusy()" :error="deleteError()" @confirm="confirmDelete()" @close="closeDelete()" />
