<script client>
type DigitalDeliveryStatus = 'active' | 'inactive'

interface DigitalDeliveryRecord {
  id: number
  name: string
  description: string
  download_limit?: number | null
  expiry_days: number
  requires_login: boolean
  automatic_delivery: boolean
  status: DigitalDeliveryStatus
}

const open = useReactiveProp('open', false)
const mode = useReactiveProp('mode', 'create')
const record = useReactiveProp('record', null as DigitalDeliveryRecord | null)
const busy = useReactiveProp('busy', false)
const error = useReactiveProp('error', '')
const emit = defineEmits(['invalid', 'submit', 'close'])
const name = state('')
const descriptionText = state('')
const downloadLimit = state('')
const expiryDays = state('30')
const requiresLogin = state(false)
const automaticDelivery = state(true)
const status = state<DigitalDeliveryStatus>('active')
let hydrationKey = ''

effect(() => {
  if (!open()) {
    hydrationKey = ''
    return
  }
  const current = record()
  const nextKey = `${mode()}:${current?.id || 'new'}`
  if (hydrationKey === nextKey)
    return
  hydrationKey = nextKey
  name.set(current?.name || '')
  descriptionText.set(current?.description || '')
  downloadLimit.set(current?.download_limit === null || current?.download_limit === undefined ? '' : String(current.download_limit))
  expiryDays.set(String(current?.expiry_days ?? 30))
  requiresLogin.set(Boolean(current?.requires_login))
  automaticDelivery.set(current ? Boolean(current.automatic_delivery) : true)
  status.set(current?.status || 'active')
})

function submit(): void {
  const parsedDownloadLimit = downloadLimit() === '' ? null : Number(downloadLimit())
  const parsedExpiryDays = Number(expiryDays())

  if (!name().trim()) {
    emit('invalid', 'Method name is required.')
    return
  }
  if (!descriptionText().trim()) {
    emit('invalid', 'Description is required.')
    return
  }
  if (parsedDownloadLimit !== null && (!Number.isInteger(parsedDownloadLimit) || parsedDownloadLimit < 0)) {
    emit('invalid', 'Download limit must be a whole number of zero or more.')
    return
  }
  if (!Number.isInteger(parsedExpiryDays) || parsedExpiryDays < 0) {
    emit('invalid', 'Expiry must be a whole number of days.')
    return
  }

  emit('submit', {
    name: name().trim(),
    description: descriptionText().trim(),
    downloadLimit: parsedDownloadLimit,
    expiryDays: parsedExpiryDays,
    requiresLogin: requiresLogin(),
    automaticDelivery: automaticDelivery(),
    status: status(),
  })
}
</script>

<Modal
  :isOpen="open()"
  :title="mode() === 'edit' ? 'Edit digital delivery' : 'Add digital delivery'"
  description="Configure access, expiry, download limits, and fulfillment behavior."
  size="lg"
  @close="emit('close')"
>
    <form id="digital-delivery-form" @submit.prevent="submit()">
        <div :if="error()" class="mb-5 p-3 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">{{ error() }}</div>

        <div class="space-y-4">
          <div>
            <Input v-model:value="name" label="Method name" :required="true" :maxLength="255" autocomplete="off" placeholder="Secure download" />
          </div>
          <div>
            <Textarea v-model:value="descriptionText" label="Description" :required="true" :rows="3" placeholder="Explain how customers receive and access files." />
          </div>
          <div class="grid gap-4 grid-cols-1 sm:grid-cols-2">
            <Input v-model:value="downloadLimit" label="Download limit" type="number" min="0" step="1" inputmode="numeric" placeholder="Unlimited" hint="Leave blank for unlimited downloads." />
            <Input v-model:value="expiryDays" label="Expiry days" type="number" :required="true" min="0" step="1" inputmode="numeric" hint="Use 0 for access without expiry." />
          </div>
          <div class="grid gap-3 grid-cols-1 sm:grid-cols-2">
            <div class="p-3 border border-gray-200 rounded-lg dark:border-neutral-700">
              <Toggle v-model:checked="requiresLogin" label="Require login" description="Only authenticated customers can download." labelPosition="left" />
            </div>
            <div class="p-3 border border-gray-200 rounded-lg dark:border-neutral-700">
              <Toggle v-model:checked="automaticDelivery" label="Automatic delivery" description="Fulfill automatically after payment." labelPosition="left" />
            </div>
          </div>
          <div>
            <Select v-model:value="status" label="Status" placeholder="" :options="[{ value: 'active', label: 'Active' }, { value: 'inactive', label: 'Inactive' }]" />
          </div>
        </div>
    </form>
  <template #footer>
    <div class="flex gap-2 justify-end w-full">
      <Button :disabled="busy()" variant="secondary" @click="emit('close')">Cancel</Button>
      <Button type="submit" form="digital-delivery-form" :loading="busy()">{{ mode() === 'edit' ? 'Save changes' : 'Add method' }}</Button>
    </div>
  </template>
</Modal>
