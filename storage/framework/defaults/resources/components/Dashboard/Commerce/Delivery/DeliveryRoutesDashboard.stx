<script client>
import { dashboardApi } from '../../../../../functions/dashboard-api'
import { useRecordsDashboard, useServerList } from '../../../../../functions/dashboard-list'
import { pushToast } from '../../../../../functions/toasts'

interface CourierRecord {
  id: number
  name: string
  vehicle_number: string
  status: 'active' | 'on_delivery' | 'on_break'
}

interface DeliveryRouteRecord {
  id: number
  courier: string
  courier_id?: number | null
  courier_record?: CourierRecord
  vehicle: string
  stops: number
  delivery_time: number
  total_distance: number
  last_active: string | number
}

interface DeliveryRoutePayload {
  courier: string
  courierId: number
  vehicle: string
  stops: number
  deliveryTime: number
  totalDistance: number
  lastActive: number
}

interface DeliveryRouteSummary {
  total: number
  linked: number
  stops: number
  distance: number
  active: number
}

interface DeliveryRoutePage {
  records: DeliveryRouteRecord[]
  total: number
  page: number
  summary?: DeliveryRouteSummary
}

// The dialog and the delete confirmation. The list itself is the server's
// (stacksjs/stacks#3218): this page used to read the 500 most recently
// active routes and search, page and count them in the browser.
const {
  editorOpen,
  editorMode,
  editing,
  saving,
  editorError,
  deleting,
  deleteBusy,
  deleteError,
  openCreate,
  openEdit,
  closeEditor,
  requestDelete,
  closeDelete,
} = useRecordsDashboard<DeliveryRouteRecord>({ filter: records => records })

const couriers = state<CourierRecord[]>([])
const summary = state<DeliveryRouteSummary>({ total: 0, linked: 0, stops: 0, distance: 0, active: 0 })

const {
  records,
  total,
  page,
  perPage,
  search,
  loading,
  loadError,
  load,
  changePage,
  changePageSize,
  changeSort,
} = useServerList<DeliveryRouteRecord>({
  fetch: params => dashboardApi<DeliveryRoutePage>(`/api/dashboard/commerce/delivery-routes?${params}`),
  defaultSort: { sort: 'active', direction: 'desc' },
  columnSorts: {
    routeLabel: 'id',
    courierLabel: 'courier',
    vehicle: 'vehicle',
    stops: 'stops',
    delivery_time: 'time',
    total_distance: 'distance',
    last_active: 'active',
  },
  onLoad: result => summary.set((result as DeliveryRoutePage).summary ?? { total: 0, linked: 0, stops: 0, distance: 0, active: 0 }),
  onError: error => pushToast('error', 'Could not load delivery routes', { detail: error instanceof Error ? error.message : String(error) }),
})

function courierFor(id?: number | null): CourierRecord | undefined {
  return id ? couriers().find(courier => courier.id === id) : undefined
}

function withCourier(record: DeliveryRouteRecord): DeliveryRouteRecord {
  return {
    ...record,
    courier_record: courierFor(record.courier_id) || record.courier_record,
  }
}

function rows(): DeliveryRouteRecord[] {
  return records().map(withCourier)
}

function handleSearch(value: string): void {
  search.set(value)
}

function matchingLabel(): string {
  const count = total()
  return `${count.toLocaleString()} matching ${count === 1 ? 'record' : 'records'}`
}

function metricCards(): Array<{ label: string, value: string, detail: string }> {
  const current = summary()
  return [
    { label: 'Routes', value: current.total.toLocaleString(), detail: `${current.linked.toLocaleString()} linked to couriers` },
    { label: 'Stops', value: current.stops.toLocaleString(), detail: 'Across the current route plan' },
    { label: 'Distance', value: `${current.distance.toLocaleString()} mi`, detail: 'Planned route distance' },
    { label: 'Active in 24h', value: current.active.toLocaleString(), detail: 'Based on persisted activity time' },
  ]
}

/** The couriers the dialog offers and the rows show; store configuration, read whole. */
async function loadCouriers(): Promise<void> {
  try {
    const courierData = await dashboardApi<CourierRecord[]>('/api/dashboard/commerce/couriers')
    if (!Array.isArray(courierData))
      throw new TypeError('Couriers were not returned in the expected shape.')
    couriers.set(courierData)
  }
  catch (error) {
    pushToast('error', 'Could not load couriers', { detail: error instanceof Error ? error.message : String(error) })
  }
}

function loadRoutes(): void {
  void load()
  void loadCouriers()
}

function setEditorError(message: string): void {
  editorError.set(message)
}

async function saveRoute(payload: DeliveryRoutePayload): Promise<void> {
  saving.set(true)
  editorError.set('')
  try {
    const current = editing()
    const updated = await dashboardApi<DeliveryRouteRecord>(
      current
        ? `/api/dashboard/commerce/delivery-routes/${current.id}`
        : '/api/dashboard/commerce/delivery-routes',
      {
        method: current ? 'PATCH' : 'POST',
        body: payload,
      },
    )
    const hydrated = withCourier(updated)
    editorOpen.set(false)
    editing.set(null)
    pushToast('success', current ? 'Delivery route updated' : 'Delivery route added', { detail: `Route #${hydrated.id}` })
    await load()
  }
  catch (error) {
    editorError.set(error instanceof Error ? error.message : String(error))
  }
  finally {
    saving.set(false)
  }
}

async function confirmDelete(): Promise<void> {
  const current = deleting()
  if (!current)
    return
  deleteBusy.set(true)
  deleteError.set('')
  try {
    await dashboardApi(`/api/dashboard/commerce/delivery-routes/${current.id}`, {
      method: 'DELETE',
    })
    deleting.set(null)
    pushToast('success', 'Delivery route deleted', { detail: `Route #${current.id}` })
    await load()
  }
  catch (error) {
    deleteError.set(error instanceof Error ? error.message : String(error))
  }
  finally {
    deleteBusy.set(false)
  }
}

onMount(() => {
  loadRoutes()
})
</script>

<div class="flex flex-col gap-6">
  <TabNavigation model-value="routes" />

  <PageHeader title="Delivery routes" description="Assign persisted couriers and track route workload, distance, and activity.">
  <div class="flex gap-2">
    <Button :loading="loading()" variant="secondary" @click="loadRoutes()"><span :if="!loading()" aria-hidden="true" class="h-4 w-4 i-hugeicons-refresh"></span>Refresh</Button>
    <Button :disabled="loading() || couriers().length === 0" @click="openCreate()"><span aria-hidden="true" class="h-4 w-4 i-hugeicons-add-01"></span>Add route</Button>
  </div>
  </PageHeader>

  <div :if="loadError()" class="flex gap-4 items-center justify-between p-4 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900"><span>{{ loadError() }}</span><Button variant="secondary" size="sm" @click="loadRoutes()">Retry</Button></div>
  <div :if="!loading() && couriers().length === 0" class="p-4 text-amber-800 text-sm dark:text-amber-200 bg-amber-50 dark:bg-amber-950/30 border border-amber-200 rounded-lg dark:border-amber-900">Add a courier before creating a delivery route.</div>

  <MetricCards label="Delivery route metrics" columns="grid-cols-1 sm:grid-cols-2 xl:grid-cols-4" :items="metricCards()" />

  <section class="overflow-hidden bg-white dark:bg-neutral-800 border border-gray-200 rounded-xl dark:border-neutral-700">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between px-4 py-4 border-b border-gray-200 dark:border-neutral-700">
      <div><h2 class="font-semibold text-gray-900 dark:text-white">Route plan</h2><p class="mt-0.5 text-gray-500 text-xs dark:text-neutral-400">{{ matchingLabel() }}</p></div>
      <SearchFilter placeholder="Search delivery routes" class="w-full sm:w-80" @search="handleSearch" />
    </div>
    <DeliveryRoutesTable :routes="rows()" :total="total()" :current-page="page()" :per-page="perPage()" :loading="loading()" @edit="openEdit" @delete="requestDelete" @page-change="changePage" @page-size-change="changePageSize" @sort="changeSort" />
  </section>
</div>

<DeliveryRouteDialog :open="editorOpen()" :mode="editorMode()" :record="editing()" :couriers="couriers()" :busy="saving()" :error="editorError()" @submit="saveRoute" @invalid="setEditorError" @close="closeEditor()" />
<DeliveryRouteDeleteDialog :open="Boolean(deleting())" :record="deleting()" :busy="deleteBusy()" :error="deleteError()" @confirm="confirmDelete()" @close="closeDelete()" />
