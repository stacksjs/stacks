<script client>
import { dashboardApi } from '../../../../../functions/dashboard-api'
import { pushToast } from '../../../../../functions/toasts'

interface DriverRecord {
  id: number
  name: string
  vehicle_number: string
  status: 'active' | 'on_delivery' | 'on_break'
}

interface DeliveryRouteRecord {
  id: number
  driver: string
  driver_id?: number | null
  driver_record?: DriverRecord
  vehicle: string
  stops: number
  delivery_time: number
  total_distance: number
  last_active: string | number
}

interface DeliveryRoutePayload {
  driver: string
  driverId: number
  vehicle: string
  stops: number
  deliveryTime: number
  totalDistance: number
  lastActive: number
}

const records = state<DeliveryRouteRecord[]>([])
const drivers = state<DriverRecord[]>([])
const loading = state(true)
const loadError = state('')
const search = state('')
const page = state(1)
const perPage = state(10)
const editorOpen = state(false)
const editorMode = state<'create' | 'edit'>('create')
const editing = state<DeliveryRouteRecord | null>(null)
const saving = state(false)
const editorError = state('')
const deleting = state<DeliveryRouteRecord | null>(null)
const deleteBusy = state(false)
const deleteError = state('')

function driverFor(id?: number | null): DriverRecord | undefined {
  return id ? drivers().find(driver => driver.id === id) : undefined
}

function withDriver(record: DeliveryRouteRecord): DeliveryRouteRecord {
  return {
    ...record,
    driver_record: driverFor(record.driver_id) || record.driver_record,
  }
}

function routeTime(value: string | number): number {
  if (typeof value === 'number' || /^\d+$/.test(String(value)))
    return Number(value)
  return new Date(String(value).replace(' ', 'T')).getTime()
}

function filteredRecords(): DeliveryRouteRecord[] {
  const query = search().trim().toLowerCase()
  if (!query)
    return records()
  return records().filter(record => [
    record.id,
    record.driver,
    record.driver_record?.name,
    record.vehicle,
    record.stops,
    record.delivery_time,
    record.total_distance,
  ].some(value => String(value || '').toLowerCase().includes(query)))
}

function paginatedRecords(): DeliveryRouteRecord[] {
  const start = (page() - 1) * perPage()
  return filteredRecords().slice(start, start + perPage())
}

function metricCards(): Array<{ label: string, value: string, detail: string }> {
  const totalStops = records().reduce((sum, record) => sum + record.stops, 0)
  const totalDistance = records().reduce((sum, record) => sum + record.total_distance, 0)
  const activeCutoff = Date.now() - (24 * 60 * 60 * 1000)
  const activeRoutes = records().filter(record => routeTime(record.last_active) >= activeCutoff).length
  return [
    { label: 'Routes', value: records().length.toLocaleString(), detail: `${records().filter(record => record.driver_id).length} linked to drivers` },
    { label: 'Stops', value: totalStops.toLocaleString(), detail: 'Across the current route plan' },
    { label: 'Distance', value: `${totalDistance.toLocaleString()} mi`, detail: 'Planned route distance' },
    { label: 'Active in 24h', value: activeRoutes.toLocaleString(), detail: 'Based on persisted activity time' },
  ]
}

async function loadRoutes(): Promise<void> {
  loading.set(true)
  loadError.set('')
  try {
    const [routeData, driverData] = await Promise.all([
      dashboardApi<DeliveryRouteRecord[]>('/api/dashboard/commerce/delivery-routes'),
      dashboardApi<DriverRecord[]>('/api/dashboard/commerce/drivers'),
    ])
    if (!Array.isArray(routeData) || !Array.isArray(driverData))
      throw new TypeError('Delivery route resources were not returned in the expected shape.')
    drivers.set(driverData)
    records.set(routeData.map(withDriver))
    const lastPage = Math.max(1, Math.ceil(filteredRecords().length / perPage()))
    if (page() > lastPage)
      page.set(lastPage)
  }
  catch (error) {
    loadError.set(error instanceof Error ? error.message : String(error))
    pushToast('error', 'Could not load delivery routes', { detail: loadError() })
  }
  finally {
    loading.set(false)
  }
}

function handleSearch(value: string): void {
  search.set(value)
  page.set(1)
}

function openCreate(): void {
  editing.set(null)
  editorMode.set('create')
  editorError.set('')
  editorOpen.set(true)
}

function openEdit(record: DeliveryRouteRecord): void {
  editing.set(record)
  editorMode.set('edit')
  editorError.set('')
  editorOpen.set(true)
}

function closeEditor(): void {
  if (saving())
    return
  editorOpen.set(false)
  editing.set(null)
  editorError.set('')
}

function setEditorError(message: string): void {
  editorError.set(message)
}

async function saveRoute(payload: DeliveryRoutePayload): Promise<void> {
  saving.set(true)
  editorError.set('')
  try {
    const current = editing()
    const updated = await dashboardApi<DeliveryRouteRecord>(
      current
        ? `/api/dashboard/commerce/delivery-routes/${current.id}`
        : '/api/dashboard/commerce/delivery-routes',
      {
        method: current ? 'PATCH' : 'POST',
        body: payload,
      },
    )
    const hydrated = withDriver(updated)
    if (current) {
      records.set(records().map(record => record.id === current.id ? hydrated : record))
    }
    else {
      const nextRecords = [...records(), hydrated]
      records.set(nextRecords)
      page.set(Math.max(1, Math.ceil(nextRecords.length / perPage())))
    }
    editorOpen.set(false)
    editing.set(null)
    pushToast('success', current ? 'Delivery route updated' : 'Delivery route added', { detail: `Route #${hydrated.id}` })
  }
  catch (error) {
    editorError.set(error instanceof Error ? error.message : String(error))
  }
  finally {
    saving.set(false)
  }
}

function requestDelete(record: DeliveryRouteRecord): void {
  deleting.set(record)
  deleteError.set('')
}

function closeDelete(): void {
  if (deleteBusy())
    return
  deleting.set(null)
  deleteError.set('')
}

async function confirmDelete(): Promise<void> {
  const current = deleting()
  if (!current)
    return
  deleteBusy.set(true)
  deleteError.set('')
  try {
    await dashboardApi(`/api/dashboard/commerce/delivery-routes/${current.id}`, {
      method: 'DELETE',
    })
    records.set(records().filter(record => record.id !== current.id))
    deleting.set(null)
    const lastPage = Math.max(1, Math.ceil(filteredRecords().length / perPage()))
    if (page() > lastPage)
      page.set(lastPage)
    pushToast('success', 'Delivery route deleted', { detail: `Route #${current.id}` })
  }
  catch (error) {
    deleteError.set(error instanceof Error ? error.message : String(error))
  }
  finally {
    deleteBusy.set(false)
  }
}

function goToPage(value: number): void {
  page.set(value)
}

onMount(() => {
  void loadRoutes()
})
</script>

<div class="space-y-6">
  <TabNavigation model-value="routes" />

  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="font-bold text-2xl text-gray-900 dark:text-white">Delivery routes</h1>
      <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Assign persisted drivers and track route workload, distance, and activity.</p>
    </div>
    <div class="flex gap-2">
      <Button :loading="loading()" variant="secondary" @click="loadRoutes()"><span :if="!loading()" aria-hidden="true" class="h-4 w-4 i-hugeicons-refresh"></span>Refresh</Button>
      <Button :disabled="loading() || drivers().length === 0" @click="openCreate()"><span aria-hidden="true" class="h-4 w-4 i-hugeicons-add-01"></span>Add route</Button>
    </div>
  </header>

  <div :if="loadError()" class="flex gap-4 items-center justify-between p-4 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900"><span>{{ loadError() }}</span><Button variant="secondary" size="sm" @click="loadRoutes()">Retry</Button></div>
  <div :if="!loading() && drivers().length === 0" class="p-4 text-amber-800 text-sm dark:text-amber-200 bg-amber-50 dark:bg-amber-950/30 border border-amber-200 rounded-lg dark:border-amber-900">Add a driver before creating a delivery route.</div>

  <section aria-label="Delivery route metrics" class="grid gap-3 grid-cols-1 sm:grid-cols-2 xl:grid-cols-4">
    <template :for="item in metricCards()" :key="item.label"><article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700"><p class="text-gray-500 text-xs dark:text-neutral-400">{{ item.label }}</p><p class="mt-2 font-semibold text-2xl text-gray-900 dark:text-white">{{ item.value }}</p><p class="mt-1 text-gray-400 text-xs dark:text-neutral-500">{{ item.detail }}</p></article></template>
  </section>

  <section class="overflow-hidden bg-white dark:bg-neutral-800 border border-gray-200 rounded-xl dark:border-neutral-700">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between px-4 py-4 border-b border-gray-200 dark:border-neutral-700">
      <div><h2 class="font-semibold text-gray-900 dark:text-white">Route plan</h2><p class="mt-0.5 text-gray-500 text-xs dark:text-neutral-400">{{ filteredRecords().length }} matching records</p></div>
      <SearchFilter placeholder="Search delivery routes" class="w-full sm:w-80" @search="handleSearch" />
    </div>
    <div :if="loading()" class="flex items-center justify-center py-24 text-gray-500 text-sm dark:text-neutral-400"><span class="mr-2 h-4 w-4 animate-spin i-hugeicons-loading-03"></span>Loading delivery routes</div>
    <DeliveryRoutesTable :if="!loading()" :routes="paginatedRecords()" @edit="openEdit" @delete="requestDelete" />
    <div :if="!loading()" class="px-4 py-3 bg-gray-50 dark:bg-neutral-900/50 border-gray-200 border-t dark:border-neutral-700">
      <DeliveryPagination :current-page="page()" :total-items="filteredRecords().length" :items-per-page="perPage()" @select="goToPage" />
    </div>
  </section>
</div>

<DeliveryRouteDialog :open="editorOpen()" :mode="editorMode()" :record="editing()" :drivers="drivers()" :busy="saving()" :error="editorError()" @submit="saveRoute" @invalid="setEditorError" @close="closeEditor()" />
<DeliveryRouteDeleteDialog :open="Boolean(deleting())" :record="deleting()" :busy="deleteBusy()" :error="deleteError()" @confirm="confirmDelete()" @close="closeDelete()" />
