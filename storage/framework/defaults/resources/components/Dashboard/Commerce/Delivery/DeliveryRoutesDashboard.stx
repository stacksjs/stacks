<script client>
import { dashboardApi } from '../../../../../functions/dashboard-api'
import { useRecordsDashboard } from '../../../../../functions/dashboard-list'
import { pushToast } from '../../../../../functions/toasts'

interface CourierRecord {
  id: number
  name: string
  vehicle_number: string
  status: 'active' | 'on_delivery' | 'on_break'
}

interface DeliveryRouteRecord {
  id: number
  courier: string
  courier_id?: number | null
  courier_record?: CourierRecord
  vehicle: string
  stops: number
  delivery_time: number
  total_distance: number
  last_active: string | number
}

interface DeliveryRoutePayload {
  courier: string
  courierId: number
  vehicle: string
  stops: number
  deliveryTime: number
  totalDistance: number
  lastActive: number
}

function matchesQuery(records: DeliveryRouteRecord[], query: string): DeliveryRouteRecord[] {
  return records.filter(record => [
    record.id,
    record.courier,
    record.courier_record?.name,
    record.vehicle,
    record.stops,
    record.delivery_time,
    record.total_distance,
  ].some(value => String(value || '').toLowerCase().includes(query)))
}

const {
  records,
  loading,
  loadError,
  search,
  page,
  perPage,
  editorOpen,
  editorMode,
  editing,
  saving,
  editorError,
  deleting,
  deleteBusy,
  deleteError,
  filteredRecords,
  paginatedRecords,
  goToPage,
  handleSearch,
  openCreate,
  openEdit,
  closeEditor,
  requestDelete,
  closeDelete,
  upsert,
  remove,
  clampPage,
} = useRecordsDashboard<DeliveryRouteRecord>({ filter: matchesQuery })

const couriers = state<CourierRecord[]>([])

function courierFor(id?: number | null): CourierRecord | undefined {
  return id ? couriers().find(courier => courier.id === id) : undefined
}

function withCourier(record: DeliveryRouteRecord): DeliveryRouteRecord {
  return {
    ...record,
    courier_record: courierFor(record.courier_id) || record.courier_record,
  }
}

function routeTime(value: string | number): number {
  if (typeof value === 'number' || /^\d+$/.test(String(value)))
    return Number(value)
  return new Date(String(value).replace(' ', 'T')).getTime()
}

function metricCards(): Array<{ label: string, value: string, detail: string }> {
  const totalStops = records().reduce((sum, record) => sum + record.stops, 0)
  const totalDistance = records().reduce((sum, record) => sum + record.total_distance, 0)
  const activeCutoff = Date.now() - (24 * 60 * 60 * 1000)
  const activeRoutes = records().filter(record => routeTime(record.last_active) >= activeCutoff).length
  return [
    { label: 'Routes', value: records().length.toLocaleString(), detail: `${records().filter(record => record.courier_id).length} linked to couriers` },
    { label: 'Stops', value: totalStops.toLocaleString(), detail: 'Across the current route plan' },
    { label: 'Distance', value: `${totalDistance.toLocaleString()} mi`, detail: 'Planned route distance' },
    { label: 'Active in 24h', value: activeRoutes.toLocaleString(), detail: 'Based on persisted activity time' },
  ]
}

async function loadRoutes(): Promise<void> {
  loading.set(true)
  loadError.set('')
  try {
    const [routeData, courierData] = await Promise.all([
      dashboardApi<DeliveryRouteRecord[]>('/api/dashboard/commerce/delivery-routes'),
      dashboardApi<CourierRecord[]>('/api/dashboard/commerce/couriers'),
    ])
    if (!Array.isArray(routeData) || !Array.isArray(courierData))
      throw new TypeError('Delivery route resources were not returned in the expected shape.')
    couriers.set(courierData)
    records.set(routeData.map(withCourier))
    clampPage()
  }
  catch (error) {
    loadError.set(error instanceof Error ? error.message : String(error))
    pushToast('error', 'Could not load delivery routes', { detail: loadError() })
  }
  finally {
    loading.set(false)
  }
}

function setEditorError(message: string): void {
  editorError.set(message)
}

async function saveRoute(payload: DeliveryRoutePayload): Promise<void> {
  saving.set(true)
  editorError.set('')
  try {
    const current = editing()
    const updated = await dashboardApi<DeliveryRouteRecord>(
      current
        ? `/api/dashboard/commerce/delivery-routes/${current.id}`
        : '/api/dashboard/commerce/delivery-routes',
      {
        method: current ? 'PATCH' : 'POST',
        body: payload,
      },
    )
    const hydrated = withCourier(updated)
    upsert(hydrated, current)
    editorOpen.set(false)
    editing.set(null)
    pushToast('success', current ? 'Delivery route updated' : 'Delivery route added', { detail: `Route #${hydrated.id}` })
  }
  catch (error) {
    editorError.set(error instanceof Error ? error.message : String(error))
  }
  finally {
    saving.set(false)
  }
}

async function confirmDelete(): Promise<void> {
  const current = deleting()
  if (!current)
    return
  deleteBusy.set(true)
  deleteError.set('')
  try {
    await dashboardApi(`/api/dashboard/commerce/delivery-routes/${current.id}`, {
      method: 'DELETE',
    })
    remove(current)
    deleting.set(null)
    clampPage()
    pushToast('success', 'Delivery route deleted', { detail: `Route #${current.id}` })
  }
  catch (error) {
    deleteError.set(error instanceof Error ? error.message : String(error))
  }
  finally {
    deleteBusy.set(false)
  }
}

onMount(() => {
  void loadRoutes()
})
</script>

<div class="space-y-6">
  <TabNavigation model-value="routes" />

  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="font-bold text-2xl text-gray-900 dark:text-white">Delivery routes</h1>
      <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Assign persisted couriers and track route workload, distance, and activity.</p>
    </div>
    <div class="flex gap-2">
      <Button :loading="loading()" variant="secondary" @click="loadRoutes()"><span :if="!loading()" aria-hidden="true" class="h-4 w-4 i-hugeicons-refresh"></span>Refresh</Button>
      <Button :disabled="loading() || couriers().length === 0" @click="openCreate()"><span aria-hidden="true" class="h-4 w-4 i-hugeicons-add-01"></span>Add route</Button>
    </div>
  </header>

  <div :if="loadError()" class="flex gap-4 items-center justify-between p-4 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900"><span>{{ loadError() }}</span><Button variant="secondary" size="sm" @click="loadRoutes()">Retry</Button></div>
  <div :if="!loading() && couriers().length === 0" class="p-4 text-amber-800 text-sm dark:text-amber-200 bg-amber-50 dark:bg-amber-950/30 border border-amber-200 rounded-lg dark:border-amber-900">Add a courier before creating a delivery route.</div>

  <MetricCards label="Delivery route metrics" columns="grid-cols-1 sm:grid-cols-2 xl:grid-cols-4" :items="metricCards()" />

  <section class="overflow-hidden bg-white dark:bg-neutral-800 border border-gray-200 rounded-xl dark:border-neutral-700">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between px-4 py-4 border-b border-gray-200 dark:border-neutral-700">
      <div><h2 class="font-semibold text-gray-900 dark:text-white">Route plan</h2><p class="mt-0.5 text-gray-500 text-xs dark:text-neutral-400">{{ filteredRecords().length }} matching records</p></div>
      <SearchFilter placeholder="Search delivery routes" class="w-full sm:w-80" @search="handleSearch" />
    </div>
    <div :if="loading()" class="flex items-center justify-center py-24 text-gray-500 text-sm dark:text-neutral-400"><span class="mr-2 h-4 w-4 animate-spin i-hugeicons-loading-03"></span>Loading delivery routes</div>
    <DeliveryRoutesTable :if="!loading()" :routes="paginatedRecords()" @edit="openEdit" @delete="requestDelete" />
    <div :if="!loading()" class="px-4 py-3 bg-gray-50 dark:bg-neutral-900/50 border-gray-200 border-t dark:border-neutral-700">
      <DeliveryPagination :current-page="page()" :total-items="filteredRecords().length" :items-per-page="perPage()" @select="goToPage" />
    </div>
  </section>
</div>

<DeliveryRouteDialog :open="editorOpen()" :mode="editorMode()" :record="editing()" :couriers="couriers()" :busy="saving()" :error="editorError()" @submit="saveRoute" @invalid="setEditorError" @close="closeEditor()" />
<DeliveryRouteDeleteDialog :open="Boolean(deleting())" :record="deleting()" :busy="deleteBusy()" :error="deleteError()" @confirm="confirmDelete()" @close="closeDelete()" />
