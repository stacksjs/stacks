<script client>
interface DeliveryRouteRecord {
  id: number
  driver: string
}

const open = useReactiveProp('open', false)
const record = useReactiveProp('record', null as DeliveryRouteRecord | null)
const busy = useReactiveProp('busy', false)
const error = useReactiveProp('error', '')
const emit = defineEmits()
const description = derived(() => `Delete route #${record()?.id} for ${record()?.driver || 'the selected driver'} permanently.`)
</script>

<ConfirmDialog
  :isOpen="open() && Boolean(record())"
  title="Delete delivery route?"
  :description="description()"
  confirmLabel="Delete route"
  :busy="busy()"
  :error="error()"
  @close="emit('close')"
  @confirm="emit('confirm')"
/>
