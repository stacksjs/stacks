@import('../UI/Table')

<script client>
import type { ProductVariantRecord } from '../../../../app/Actions/Dashboard/Commerce/product-variant-records'

const records = useReactiveProp('records', [] as ProductVariantRecord[])
const loading = useReactiveProp('loading', false)
const emit = defineEmits()

/**
 * Two slotted columns, dispatched on `column.key`: the variant with its type
 * and description beneath it, and the option pills, of which the first four
 * show and the rest are counted.
 */
const COLUMNS = [
  { key: 'variant', label: 'Variant', sortable: true, slotted: true },
  { key: 'productName', label: 'Product', sortable: true, emptyText: 'Unassigned' },
  { key: 'optionsLabel', label: 'Options', slotted: true, class: 'max-w-sm' },
  {
    key: 'status',
    label: 'Status',
    type: 'badge' as const,
    sortable: true,
    badgeClasses: {
      active: 'text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/40',
      draft: 'text-amber-700 dark:text-amber-300 bg-amber-50 dark:bg-amber-950/40',
    },
  },
  { key: 'createdAt', label: 'Created', type: 'date' as const, sortable: true, class: 'whitespace-nowrap' },
]

const ROW_ACTIONS = [
  { action: 'edit', label: 'Edit', icon: 'i-hugeicons-edit-01' },
  { action: 'delete', label: 'Delete', icon: 'i-hugeicons-delete-02', class: 'text-red-500' },
]

const rows = derived(() => records().map(record => ({
  ...record,
  // Searchable text for the options, and the parts the cell draws.
  optionsLabel: record.options.join(', '),
  shownOptions: record.options.slice(0, 4),
  moreOptions: record.options.length > 4 ? `+${record.options.length - 4}` : '',
})))

function handleRowAction(payload: { action: string, row: ProductVariantRecord }): void {
  emit(payload.action, payload.row)
}
</script>

<Table
  :columns="COLUMNS"
  :data="rows()"
  :loading="loading()"
  :row-actions="ROW_ACTIONS"
  action-label-key="variant"
  paginated
  :page-size="25"
  empty-title="No product variants found"
  empty-description="Adjust the filters or add a ProductVariant record."
  @row-action="handleRowAction"
>
  <template #cell="{ row, column }">
    <template :if="column.key === 'variant'">
      <p class="font-medium text-gray-900 text-sm dark:text-white" x-text="row.variant"></p>
      <p class="mt-1 text-gray-500 text-xs dark:text-neutral-400" x-text="row.type"></p>
      <p class="mt-2 max-w-sm text-gray-500 text-xs dark:text-neutral-400" x-text="row.description"></p>
    </template>
    <template :else>
      <div class="flex flex-wrap gap-1">
        <template :for="option in row.shownOptions" :key="option">
          <span class="px-2 py-0.5 text-blue-700 text-xs dark:text-blue-300 bg-blue-50 dark:bg-blue-950/40 rounded-full" x-text="option"></span>
        </template>
        <span :if="row.moreOptions" class="px-2 py-0.5 text-gray-600 text-xs dark:text-neutral-300 bg-gray-100 dark:bg-neutral-700 rounded-full" x-text="row.moreOptions"></span>
        <span :if="row.shownOptions.length === 0" class="text-gray-400 text-xs">No options</span>
      </div>
    </template>
  </template>
</Table>
