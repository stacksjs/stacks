<script client>
import type { CustomerChoice, ProductChoice } from '../../../../app/Actions/Dashboard/Commerce/commerce-choice-records'
import type { ProductWaitlistRecord, ProductWaitlistWritePayload } from '../../../../app/Actions/Dashboard/Commerce/product-waitlist-records'
import { dashboardApi } from '../../../../functions/dashboard-api'
import { formErrorMessages } from '../../../../functions/dashboard-form'

type DialogMode = 'add' | 'edit'

const open = useReactiveProp('open', false)
const mode = useReactiveProp('mode', 'add' as DialogMode)
const record = useReactiveProp('record', null as ProductWaitlistRecord | null)
const busy = useReactiveProp('busy', false)
const errors = useReactiveProp('errors', {} as Record<string, string>)
const emit = defineEmits(['submit', 'close'])

const productId = state<number | string>('')
const customerId = state<number | string>('')
const name = state('')
const email = state('')
const phone = state('')
const quantity = state(1)
const notificationPreference = state<ProductWaitlistWritePayload['notificationPreference']>('email')
const source = state('website')
const notes = state('')
const status = state<ProductWaitlistWritePayload['status']>('waiting')
let lastSync = ''

// The product and customer choices are server searches (stacksjs/stacks#3218):
// this used to be handed the first 500 of each by name, so an entry could not
// be made for a product or customer past the 500th.
const productChoices = state<ProductChoice[]>([])
const productMatches = state(0)
const productQuery = state('')
const customerChoices = state<CustomerChoice[]>([])
const customerMatches = state(0)
const customerQuery = state('')
const requests = { products: 0, customers: 0 }
const timers: Record<'products' | 'customers', ReturnType<typeof setTimeout> | null> = { products: null, customers: null }

async function loadChoices(kind: 'products' | 'customers', term: string): Promise<void> {
  const request = ++requests[kind]
  const params = new URLSearchParams()
  if (term)
    params.set('q', term)
  const path = kind === 'products' ? '/api/dashboard/commerce/product-choices' : '/api/dashboard/commerce/customer-choices'
  try {
    const data = await dashboardApi<{ choices?: Array<ProductChoice & Partial<CustomerChoice>>, total?: number }>(`${path}${term ? `?${params}` : ''}`)
    if (request !== requests[kind])
      return
    const choices = Array.isArray(data.choices) ? data.choices : []
    if (kind === 'products') {
      productChoices.set(choices)
      productMatches.set(data.total ?? choices.length)
    }
    else {
      customerChoices.set(choices as CustomerChoice[])
      customerMatches.set(data.total ?? choices.length)
    }
  }
  catch {
    // Soft-fail: the entry's own product and customer stay selectable.
    if (request !== requests[kind])
      return
    if (kind === 'products') {
      productChoices.set([])
      productMatches.set(0)
    }
    else {
      customerChoices.set([])
      customerMatches.set(0)
    }
  }
}

function searchSoon(kind: 'products' | 'customers'): void {
  const timer = timers[kind]
  if (timer)
    clearTimeout(timer)
  timers[kind] = setTimeout(() => {
    void loadChoices(kind, (kind === 'products' ? productQuery() : customerQuery()).trim())
  }, 250)
}

/** The choices to show: the search results, with the entry's own product kept in. */
const products = derived((): ProductChoice[] => {
  const found = productChoices()
  const entry = record()
  if (!entry?.productId || found.some(choice => choice.id === entry.productId))
    return found
  return [{ id: entry.productId, label: entry.productName || `Product ${entry.productId}`, detail: '' }, ...found]
})

/** The choices to show: the search results, with the entry's own customer kept in. */
const customers = derived((): CustomerChoice[] => {
  const found = customerChoices()
  const entry = record()
  if (!entry?.customerId || found.some(choice => choice.id === entry.customerId))
    return found
  return [{ id: entry.customerId, label: entry.name || `Customer ${entry.customerId}`, detail: entry.email, email: entry.email, phone: entry.phone }, ...found]
})

function moreLabel(shown: number, total: number, noun: string): string {
  return total > shown ? `Showing ${shown} of ${total.toLocaleString()} matching ${noun}. Search to narrow it down.` : ''
}

function relationId(value: number | string): number | null {
  if (value === '')
    return null
  const id = Number(value)
  return Number.isInteger(id) && id > 0 ? id : null
}

function reset(entry: ProductWaitlistRecord | null): void {
  productId.set(entry?.productId || '')
  customerId.set(entry?.customerId || '')
  name.set(entry?.name || '')
  email.set(entry?.email || '')
  phone.set(entry?.phone || '')
  quantity.set(entry?.quantity || 1)
  notificationPreference.set((entry?.notificationPreference as ProductWaitlistWritePayload['notificationPreference']) || 'email')
  source.set(entry?.source || 'website')
  notes.set(entry?.notes || '')
  status.set((entry?.status as ProductWaitlistWritePayload['status']) || 'waiting')
}

effect(() => {
  const entry = record()
  if (!open()) {
    lastSync = ''
    return
  }

  const signature = `${mode()}:${entry?.id || 'new'}`
  if (signature === lastSync)
    return

  lastSync = signature
  reset(entry)
  productQuery.set('')
  customerQuery.set('')
  void loadChoices('products', '')
  void loadChoices('customers', '')
})

function hydrateCustomer(event: Event): void {
  const selectedId = (event.target as HTMLSelectElement).value
  const customer = customers().find(option => option.id === selectedId)
  if (!customer)
    return
  if (!name().trim())
    name.set(customer.label)
  if (!email().trim())
    email.set(customer.email)
  if (!phone().trim())
    phone.set(customer.phone)
}

function submitForm(): void {
  const selectedProductId = relationId(productId())
  if (!selectedProductId)
    return

  emit('submit', {
    productId: selectedProductId,
    customerId: relationId(customerId()),
    name: name().trim(),
    email: email().trim(),
    phone: phone().trim(),
    quantity: Math.max(1, Math.trunc(Number(quantity()) || 1)),
    notificationPreference: notificationPreference(),
    source: source(),
    notes: notes().trim(),
    status: status(),
  } satisfies ProductWaitlistWritePayload)
}

function errorMessages(): string[] {
  return formErrorMessages(errors())
}
</script>

<Modal
  :isOpen="open()"
  :title="mode() === 'edit' ? 'Edit waitlist entry' : 'Add waitlist entry'"
  description="Save this entry through the WaitlistProduct model API."
  size="lg"
  :closable="!busy()"
  @close="emit('close')"
>
  <form id="product-waitlist-entry-form" @submit.prevent="submitForm()">
    <ul :if="errorMessages().length > 0" class="p-3 space-y-1 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">
      <li :for="message in errorMessages()" :key="message">{{ message }}</li>
    </ul>

    <div class="grid gap-4 sm:grid-cols-2 mt-6">
      <label class="block sm:col-span-2">
        <span class="block font-medium text-gray-900 text-sm dark:text-neutral-200">Product</span>
        <input x-model="productQuery" @input="searchSoon('products')" type="search" name="product_search" aria-label="Search products by name or id" placeholder="Search products by name or id" class="block mt-2 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-700 border border-gray-300 rounded-md dark:border-neutral-600" />
      </label>
      <div class="sm:col-span-2 -mt-2">
        <select x-model="productId" required aria-label="Product" class="block px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-700 border border-gray-300 rounded-md dark:border-neutral-600">
          <option value="">Select a product</option>
          <option :for="option in products()" :key="option.id" :value="option.id" :selected="option.id === String(productId())">{{ option.label }}{{ option.detail ? ' · ' + option.detail : '' }}</option>
        </select>
        <p :if="moreLabel(productChoices().length, productMatches(), 'products')" class="mt-1 text-gray-500 text-xs dark:text-neutral-400" :text="moreLabel(productChoices().length, productMatches(), 'products')"></p>
      </div>

      <label class="block sm:col-span-2">
        <span class="block font-medium text-gray-900 text-sm dark:text-neutral-200">Existing customer</span>
        <input x-model="customerQuery" @input="searchSoon('customers')" type="search" name="customer_search" aria-label="Search customers by name, email or phone" placeholder="Search customers by name, email or phone" class="block mt-2 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-700 border border-gray-300 rounded-md dark:border-neutral-600" />
      </label>
      <div class="sm:col-span-2 -mt-2">
        <select x-model="customerId" aria-label="Existing customer" class="block px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-700 border border-gray-300 rounded-md dark:border-neutral-600" @change="hydrateCustomer($event)">
          <option value="">No linked customer</option>
          <option :for="option in customers()" :key="option.id" :value="option.id" :selected="option.id === String(customerId())">{{ option.label }}{{ option.detail ? ' · ' + option.detail : '' }}</option>
        </select>
        <p :if="moreLabel(customerChoices().length, customerMatches(), 'customers')" class="mt-1 text-gray-500 text-xs dark:text-neutral-400" :text="moreLabel(customerChoices().length, customerMatches(), 'customers')"></p>
      </div>

      <label class="block">
        <span class="block font-medium text-gray-900 text-sm dark:text-neutral-200">Name</span>
        <input type="text" x-model.trim="name" required maxlength="255" autocomplete="name" class="block mt-2 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-700 border border-gray-300 rounded-md dark:border-neutral-600" />
      </label>

      <label class="block">
        <span class="block font-medium text-gray-900 text-sm dark:text-neutral-200">Email</span>
        <input type="email" x-model.trim="email" required maxlength="255" autocomplete="email" class="block mt-2 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-700 border border-gray-300 rounded-md dark:border-neutral-600" />
      </label>

      <label class="block">
        <span class="block font-medium text-gray-900 text-sm dark:text-neutral-200">Phone</span>
        <input type="tel" x-model.trim="phone" maxlength="100" autocomplete="tel" class="block mt-2 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-700 border border-gray-300 rounded-md dark:border-neutral-600" />
      </label>

      <label class="block">
        <span class="block font-medium text-gray-900 text-sm dark:text-neutral-200">Quantity</span>
        <input type="number" x-model.number="quantity" required min="1" step="1" class="block mt-2 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-700 border border-gray-300 rounded-md dark:border-neutral-600" />
      </label>

      <label class="block">
        <span class="block font-medium text-gray-900 text-sm dark:text-neutral-200">Notification preference</span>
        <select x-model="notificationPreference" required class="block mt-2 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-700 border border-gray-300 rounded-md dark:border-neutral-600">
          <option value="email">Email</option>
          <option value="sms">SMS</option>
          <option value="both">Email and SMS</option>
        </select>
      </label>

      <label class="block">
        <span class="block font-medium text-gray-900 text-sm dark:text-neutral-200">Source</span>
        <select x-model="source" required class="block mt-2 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-700 border border-gray-300 rounded-md dark:border-neutral-600">
          <option value="website">Website</option>
          <option value="social_media">Social media</option>
          <option value="in-store">In store</option>
          <option value="email">Email</option>
          <option value="app">App</option>
          <option value="referral">Referral</option>
          <option value="other">Other</option>
        </select>
      </label>

      <label class="block">
        <span class="block font-medium text-gray-900 text-sm dark:text-neutral-200">Status</span>
        <select x-model="status" required class="block mt-2 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-700 border border-gray-300 rounded-md dark:border-neutral-600">
          <option value="waiting">Waiting</option>
          <option value="notified">Notified</option>
          <option value="purchased">Purchased</option>
          <option value="cancelled">Cancelled</option>
        </select>
      </label>

      <label class="block sm:col-span-2">
        <span class="block font-medium text-gray-900 text-sm dark:text-neutral-200">Notes</span>
        <textarea x-model.trim="notes" maxlength="500" rows="3" class="block mt-2 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-700 border border-gray-300 rounded-md dark:border-neutral-600"></textarea>
      </label>
    </div>

  </form>

  <template #footer>
    <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end w-full">
      <Button variant="secondary" :disabled="busy()" @click="emit('close')">Cancel</Button>
      <Button type="submit" form="product-waitlist-entry-form" :loading="busy()">{{ mode() === 'edit' ? 'Save changes' : 'Add entry' }}</Button>
    </div>
  </template>
</Modal>
