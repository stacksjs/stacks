<script client>
import type { TaxRateRecord, TaxRateSummary } from '../../../../app/Actions/Dashboard/Commerce/tax-rate-records'
import { DashboardApiError, dashboardApi } from '../../../../functions/dashboard-api'
import { pushToast } from '../../../../functions/toasts'

interface TaxRateIndexResponse {
  records: TaxRateRecord[]
  summary: TaxRateSummary
}

interface TaxRateWritePayload {
  name: string
  rate: number
  type: string
  country: string
  region: string
  status: 'active' | 'inactive'
  isDefault: boolean
}

const emptySummary: TaxRateSummary = { total: 0, active: 0, countries: 0, averageRate: 0, defaultConflicts: 0 }
const records = state<TaxRateRecord[]>([])
const summary = state<TaxRateSummary>({ ...emptySummary })
const search = state('')
const statusFilter = state('all')
const countryFilter = state('all')
const typeFilter = state('all')
const sort = state('name')
const loading = state(true)
const loadError = state('')
const dialogOpen = state(false)
const dialogMode = state<'add' | 'edit'>('add')
const editingRecord = state<TaxRateRecord | null>(null)
const deletingRecord = state<TaxRateRecord | null>(null)
const saving = state(false)
const deleting = state(false)
const validationErrors = state<Record<string, string>>({})

function countries(): string[] {
  return [...new Set(records().map(record => record.country).filter(Boolean))].sort()
}

function taxTypes(): string[] {
  return [...new Set(records().map(record => record.type).filter(Boolean))].sort()
}

function visibleRecords(): TaxRateRecord[] {
  const query = search().trim().toLowerCase()
  const status = statusFilter()
  const country = countryFilter()
  const type = typeFilter()

  return [...records()]
    .filter((record) => {
      if (status !== 'all' && record.status !== status)
        return false
      if (country !== 'all' && record.country !== country)
        return false
      if (type !== 'all' && record.type !== type)
        return false
      return !query || [record.name, record.type, record.country, record.region]
        .some(value => value.toLowerCase().includes(query))
    })
    .sort((left, right) => {
      if (sort() === 'rate')
        return right.rate - left.rate || left.name.localeCompare(right.name)
      if (sort() === 'country')
        return left.country.localeCompare(right.country) || left.name.localeCompare(right.name)
      if (sort() === 'newest')
        return Number(right.id) - Number(left.id)
      return left.name.localeCompare(right.name)
    })
}

function metricCards(): Array<{ label: string, value: string }> {
  return [
    { label: 'Tax rates', value: String(summary().total) },
    { label: 'Active rates', value: String(summary().active) },
    { label: 'Countries', value: String(summary().countries) },
    { label: 'Average rate', value: `${summary().averageRate.toFixed(1)}%` },
  ]
}

async function loadTaxes(): Promise<void> {
  loading.set(true)
  loadError.set('')
  try {
    const data = await dashboardApi<TaxRateIndexResponse>('/api/dashboard/commerce/taxes')
    records.set(Array.isArray(data.records) ? data.records : [])
    summary.set(data.summary ?? { ...emptySummary })
  }
  catch (error) {
    loadError.set('Tax rate records could not be loaded.')
    pushToast('error', 'Could not load tax rates', {
      detail: error instanceof Error ? error.message : String(error),
    })
  }
  finally {
    loading.set(false)
  }
}

function openAdd(): void {
  dialogMode.set('add')
  editingRecord.set(null)
  validationErrors.set({})
  dialogOpen.set(true)
}

function openEdit(record: TaxRateRecord): void {
  dialogMode.set('edit')
  editingRecord.set(record)
  validationErrors.set({})
  dialogOpen.set(true)
}

function closeDialog(): void {
  if (saving())
    return
  dialogOpen.set(false)
  editingRecord.set(null)
  validationErrors.set({})
}

async function saveTax(payload: TaxRateWritePayload): Promise<void> {
  const current = editingRecord()
  const editing = dialogMode() === 'edit' && current !== null
  const path = editing
    ? `/api/dashboard/commerce/taxes/${current.id}`
    : '/api/dashboard/commerce/taxes'
  const body = {
    name: payload.name,
    rate: payload.rate,
    type: payload.type,
    country: payload.country,
    region: payload.region,
    status: payload.status,
    isDefault: payload.isDefault,
  }

  saving.set(true)
  validationErrors.set({})
  try {
    await dashboardApi(path, {
      method: editing ? 'PATCH' : 'POST',
      body,
    })

    dialogOpen.set(false)
    editingRecord.set(null)
    pushToast('success', editing ? 'Tax rate updated' : 'Tax rate added')
    await loadTaxes()
  }
  catch (error) {
    if (error instanceof DashboardApiError)
      validationErrors.set(error.fields ?? {})
    pushToast('error', 'Could not save tax rate', {
      detail: error instanceof Error ? error.message : String(error),
    })
  }
  finally {
    saving.set(false)
  }
}

function openDelete(record: TaxRateRecord): void {
  deletingRecord.set(record)
}

function closeDelete(): void {
  if (!deleting())
    deletingRecord.set(null)
}

async function deleteTax(): Promise<void> {
  const current = deletingRecord()
  if (!current)
    return
  deleting.set(true)
  try {
    await dashboardApi(`/api/dashboard/commerce/taxes/${current.id}`, { method: 'DELETE' })
    deletingRecord.set(null)
    pushToast('success', 'Tax rate deleted')
    await loadTaxes()
  }
  catch (error) {
    pushToast('error', 'Could not delete tax rate', {
      detail: error instanceof Error ? error.message : String(error),
    })
  }
  finally {
    deleting.set(false)
  }
}

onMount(() => {
  void loadTaxes()
})
</script>

<div class="space-y-6">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="font-bold text-2xl text-gray-900 dark:text-white">Tax rates</h1>
      <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Manage native TaxRate records used by commerce calculations.</p>
    </div>
    <div class="flex gap-2">
      <Button variant="secondary" :loading="loading()" @click="loadTaxes">
        <span :if="!loading()" class="h-4 w-4 i-hugeicons-refresh"></span>
        Refresh
      </Button>
      <Button @click="openAdd()">
        <span class="h-4 w-4 i-hugeicons-add-01"></span>
        Add tax rate
      </Button>
    </div>
  </header>

  <div :if="loadError()" class="p-4 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">{{ loadError() }}</div>
  <div :if="summary().defaultConflicts > 0" class="flex gap-3 items-start p-4 text-amber-800 text-sm dark:text-amber-200 bg-amber-50 dark:bg-amber-950/30 border border-amber-200 rounded-lg dark:border-amber-900">
    <span class="shrink-0 mt-0.5 h-5 w-5 i-hugeicons-alert-02"></span>
    <p>{{ summary().defaultConflicts + 1 }} tax rates are marked as default. Save the intended default to clear the others.</p>
  </div>

  <section aria-label="Tax rate metrics" class="grid gap-3 grid-cols-2 lg:grid-cols-4">
    <template :for="item in metricCards()" :key="item.label">
      <article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
        <p class="text-gray-500 text-xs dark:text-neutral-400">{{ item.label }}</p>
        <p class="mt-2 font-semibold text-2xl text-gray-900 dark:text-white">{{ item.value }}</p>
      </article>
    </template>
  </section>

  <section class="space-y-3">
    <div class="grid gap-3 grid-cols-1 sm:grid-cols-2 xl:grid-cols-5">
      <label class="relative sm:col-span-2">
        <span class="sr-only">Search tax rates</span>
        <span class="flex absolute inset-y-0 left-0 items-center pl-3 text-gray-400 pointer-events-none"><span class="h-4 w-4 i-hugeicons-search-01"></span></span>
        <input x-model="search" type="search" placeholder="Search tax rates" class="pl-9 pr-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700" />
      </label>
      <label>
        <span class="sr-only">Tax status</span>
        <select x-model="statusFilter" class="px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700">
          <option value="all">All statuses</option>
          <option value="active">Active</option>
          <option value="inactive">Inactive</option>
        </select>
      </label>
      <label>
        <span class="sr-only">Tax country</span>
        <select x-model="countryFilter" class="px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700">
          <option value="all">All countries</option>
          <template :for="country in countries()" :key="country"><option :value="country">{{ country }}</option></template>
        </select>
      </label>
      <label>
        <span class="sr-only">Tax type</span>
        <select x-model="typeFilter" class="px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700">
          <option value="all">All tax types</option>
          <template :for="type in taxTypes()" :key="type"><option :value="type">{{ type }}</option></template>
        </select>
      </label>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-gray-500 text-sm dark:text-neutral-400">{{ visibleRecords().length }} matching tax rates</p>
      <label class="flex gap-2 items-center text-gray-500 text-sm dark:text-neutral-400">
        Sort
        <select x-model="sort" class="px-3 py-1.5 text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700">
          <option value="name">Name</option>
          <option value="rate">Highest rate</option>
          <option value="country">Country</option>
          <option value="newest">Newest</option>
        </select>
      </label>
    </div>

    <CommerceTaxesTable :records="visibleRecords()" :loading="loading()" @edit="openEdit" @delete="openDelete" />
  </section>
</div>

<CommerceTaxDialog :open="dialogOpen()" :mode="dialogMode()" :record="editingRecord()" :types="taxTypes()" :busy="saving()" :errors="validationErrors()" @submit="saveTax" @close="closeDialog()" />
<CommerceTaxDeleteDialog :open="Boolean(deletingRecord())" :record="deletingRecord()" :busy="deleting()" @confirm="deleteTax()" @close="closeDelete()" />
