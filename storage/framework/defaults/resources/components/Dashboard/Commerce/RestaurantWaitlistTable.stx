@import('../UI/Table')

<script client>
import {
  restaurantWaitlistTimestamp,
  type RestaurantWaitlistRecord,
} from '../../../../app/Actions/Dashboard/Commerce/restaurant-waitlist-records'

const records = useReactiveProp('records', [] as RestaurantWaitlistRecord[])
const loading = useReactiveProp('loading', false)
const busyId = useReactiveProp('busyId', '')
/**
 * The server pages and sorts what the parent's search and filters match
 * (stacksjs/stacks#3218): how many parties match, the page shown and its size.
 */
const total = useReactiveProp('total', 0)
const currentPage = useReactiveProp('currentPage', 1)
const perPage = useReactiveProp('perPage', 25)
const emit = defineEmits(['seat', 'no-show', 'edit', 'delete', 'page-change', 'page-size-change', 'sort'])

const STATUS_CLASSES = {
  seated: 'text-green-700 dark:text-green-300 bg-green-50 dark:bg-green-950/30',
  waiting: 'text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-950/30',
  no_show: 'text-red-700 dark:text-red-300 bg-red-50 dark:bg-red-950/30',
}

const COLUMNS = [
  { key: 'name', label: 'Party', sortable: true, emptyText: 'Unnamed party', subtitleKey: 'contact', class: 'font-medium text-gray-900 dark:text-white' },
  { key: 'partySize', label: 'Size', type: 'number' as const, sortable: true, align: 'right' as const, class: 'font-mono' },
  // `no_show` renders as "No show" from the badge's own humanising, so no
  // label map is needed for it.
  { key: 'status', label: 'Status', type: 'badge' as const, sortable: true, badgeClasses: STATUS_CLASSES },
  { key: 'quotedWait', label: 'Quoted wait', sortable: true, align: 'right' as const, class: 'font-mono' },
  { key: 'preference', label: 'Preference', sortable: true, class: 'capitalize' },
  { key: 'checkIn', label: 'Check in', sortable: true, emptyText: 'Not recorded', class: 'whitespace-nowrap' },
]

/**
 * Seating and marking a no-show only apply while the party is still waiting,
 * which is what `when` expresses. All four are disabled on the row whose write
 * is in flight, via `busy-key`/`busy-value`.
 */
const ROW_ACTIONS = [
  { action: 'seat', label: 'Seat party for', icon: 'i-hugeicons-checkmark-circle-02', class: 'text-green-600 dark:text-green-300', when: { key: 'status', equals: 'waiting' } },
  { action: 'no-show', label: 'Mark no show for', icon: 'i-hugeicons-user-remove-01', class: 'text-red-600 dark:text-red-300', when: { key: 'status', equals: 'waiting' } },
  { action: 'edit', label: 'Edit restaurant waitlist entry for' },
  { action: 'delete', label: 'Delete restaurant waitlist entry for' },
]

function formatDateTime(value: string): string {
  if (!value)
    return ''
  const timestamp = restaurantWaitlistTimestamp(value)
  if (!timestamp)
    return value
  const date = new Date(timestamp * 1000)
  return Number.isNaN(date.getTime())
    ? value
    : new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' }).format(date)
}

function preferenceLabel(value: string): string {
  return value === 'no_preference' ? 'No preference' : value.replaceAll('_', ' ')
}

/**
 * Computed per row because a column reads a field. `checkIn` keeps this
 * component's own parser - a restaurant check-in is stored as a unix
 * timestamp, which `UI/Table`'s `datetime` type does not read - and the
 * quoted wait carries its unit.
 */
const rows = derived(() => records().map(entry => ({
  ...entry,
  contact: entry.phone || entry.email || 'No contact recorded',
  quotedWait: `${entry.quotedWaitTime} min`,
  preference: preferenceLabel(entry.tablePreference),
  checkIn: formatDateTime(entry.checkInTime),
})))

function handleRowAction(payload: { action: string, row: RestaurantWaitlistRecord }): void {
  emit(payload.action, payload.row)
}

function changePage(page: number): void {
  emit('page-change', page)
}

function changePageSize(size: number): void {
  emit('page-size-change', size)
}

function changeSort(sort: { key: string, direction: string }): void {
  emit('sort', sort)
}
</script>

{{--
  No `searchable` or `filterable`: the parent dashboard owns the search box and
  the filter selects, and the server pages and sorts what they match.
--}}
<Table
  :columns="COLUMNS"
  :data="rows()"
  :loading="loading()"
  :row-actions="ROW_ACTIONS"
  action-label-key="name"
  busy-key="id"
  :busy-value="busyId()"
  paginated
  manual-pagination
  manual-sort
  :total="total()"
  :current-page="currentPage()"
  :page-size="perPage()"
  empty-title="No restaurant waitlist records found"
  empty-description="Add a party or adjust the current filters."
  @row-action="handleRowAction"
  @page-change="changePage"
  @page-size-change="changePageSize"
  @sort="changeSort"
/>
