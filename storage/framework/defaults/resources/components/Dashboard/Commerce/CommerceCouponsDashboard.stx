<script client>
import type {
  CouponDiscountType,
  CouponRecord,
  CouponStatus,
  CouponSummary,
} from '../../../../app/Actions/Dashboard/Commerce/coupon-records'
import { DashboardApiError, dashboardApi } from '../../../../functions/dashboard-api'
import { pushToast } from '../../../../functions/toasts'

interface CouponIndexResponse {
  records: CouponRecord[]
  summary: CouponSummary
}

interface CouponWritePayload {
  code: string
  description: string
  status: CouponStatus
  isActive: boolean
  discountType: CouponDiscountType
  discountValue: number
  minOrderAmount?: number
  maxDiscountAmount?: number
  freeProductId?: string
  usageLimit?: number
  startDate?: string
  endDate?: string
}

const emptySummary: CouponSummary = { total: 0, enabled: 0, scheduled: 0, expired: 0, redemptions: 0 }
const records = state<CouponRecord[]>([])
const summary = state<CouponSummary>({ ...emptySummary })
const search = state('')
const statusFilter = state('all')
const enabledFilter = state('all')
const typeFilter = state('all')
const sort = state('newest')
const page = state(1)
const pageSize = 20
const loading = state(true)
const loadError = state('')
const dialogOpen = state(false)
const dialogMode = state<'add' | 'edit'>('add')
const editingRecord = state<CouponRecord | null>(null)
const detailsRecord = state<CouponRecord | null>(null)
const deletingRecord = state<CouponRecord | null>(null)
const saving = state(false)
const deleting = state(false)
const validationErrors = state<Record<string, string>>({})

function filteredRecords(): CouponRecord[] {
  const query = search().trim().toLowerCase()
  const selectedStatus = statusFilter()
  const selectedEnabled = enabledFilter()
  const selectedType = typeFilter()
  return [...records()]
    .filter((record) => {
      if (selectedStatus !== 'all' && record.status !== selectedStatus)
        return false
      if (selectedEnabled === 'enabled' && !record.isActive)
        return false
      if (selectedEnabled === 'disabled' && record.isActive)
        return false
      if (selectedType !== 'all' && record.discountType !== selectedType)
        return false
      return !query || [record.code, record.description, record.freeProductId]
        .some(value => value.toLowerCase().includes(query))
    })
    .sort((left, right) => {
      if (sort() === 'code')
        return left.code.localeCompare(right.code)
      if (sort() === 'usage')
        return right.usageCount - left.usageCount || left.code.localeCompare(right.code)
      if (sort() === 'expiry')
        return left.endDate.localeCompare(right.endDate) || left.code.localeCompare(right.code)
      return Number(right.id) - Number(left.id)
    })
}

function pageCount(): number {
  return Math.max(1, Math.ceil(filteredRecords().length / pageSize))
}

function visibleRecords(): CouponRecord[] {
  const selectedPage = Math.min(page(), pageCount())
  return filteredRecords().slice((selectedPage - 1) * pageSize, selectedPage * pageSize)
}

function metricCards(): Array<{ label: string, value: string, detail: string }> {
  const current = summary()
  return [
    { label: 'Coupons', value: String(current.total), detail: 'Persisted Coupon records' },
    { label: 'Enabled', value: String(current.enabled), detail: `${current.total - current.enabled} disabled` },
    { label: 'Scheduled', value: String(current.scheduled), detail: `${current.expired} expired` },
    { label: 'Redemptions', value: current.redemptions.toLocaleString(), detail: 'Recorded usage count' },
  ]
}

function exportHref(): string {
  const rows = filteredRecords().map(record => [
    record.code,
    record.description,
    record.status,
    record.isActive ? 'Enabled' : 'Disabled',
    record.discountType,
    String(record.discountValue),
    String(record.usageCount),
    record.usageLimit === null ? '' : String(record.usageLimit),
    record.startDate,
    record.endDate,
  ])
  const escape = (value: string): string => `"${value.replaceAll('"', '""')}"`
  const csv = [
    ['Code', 'Description', 'Status', 'Availability', 'Discount type', 'Discount value', 'Usage count', 'Usage limit', 'Start date', 'End date'],
    ...rows,
  ].map(row => row.map(escape).join(',')).join('\n')
  return `data:text/csv;charset=utf-8,${encodeURIComponent(`\uFEFF${csv}`)}`
}

effect(() => {
  search()
  statusFilter()
  enabledFilter()
  typeFilter()
  sort()
  page.set(1)
})

async function loadCoupons(): Promise<void> {
  loading.set(true)
  loadError.set('')
  try {
    const data = await dashboardApi<CouponIndexResponse>('/api/dashboard/commerce/coupons')
    records.set(Array.isArray(data.records) ? data.records : [])
    summary.set(data.summary ?? { ...emptySummary })
    page.set(Math.min(page(), Math.max(1, Math.ceil((data.records?.length || 0) / pageSize))))
  }
  catch (error) {
    loadError.set('Coupons could not be loaded.')
    pushToast('error', 'Could not load coupons', {
      detail: error instanceof Error ? error.message : String(error),
    })
  }
  finally {
    loading.set(false)
  }
}

function openAdd(): void {
  dialogMode.set('add')
  editingRecord.set(null)
  validationErrors.set({})
  dialogOpen.set(true)
}

function openEdit(record: CouponRecord): void {
  dialogMode.set('edit')
  editingRecord.set(record)
  validationErrors.set({})
  dialogOpen.set(true)
}

function closeDialog(): void {
  if (saving())
    return
  dialogOpen.set(false)
  editingRecord.set(null)
  validationErrors.set({})
}

async function saveCoupon(payload: CouponWritePayload): Promise<void> {
  const current = editingRecord()
  const editing = dialogMode() === 'edit' && current !== null
  const body = {
    ...payload,
    usageCount: editing ? current.usageCount : 0,
  }
  saving.set(true)
  validationErrors.set({})
  try {
    await dashboardApi(editing ? `/api/dashboard/commerce/coupons/${current.id}` : '/api/dashboard/commerce/coupons', {
      method: editing ? 'PATCH' : 'POST',
      body,
    })
    dialogOpen.set(false)
    editingRecord.set(null)
    pushToast('success', editing ? 'Coupon updated' : 'Coupon added')
    await loadCoupons()
  }
  catch (error) {
    if (error instanceof DashboardApiError)
      validationErrors.set(error.fields ?? {})
    pushToast('error', 'Could not save coupon', {
      detail: error instanceof Error ? error.message : String(error),
    })
  }
  finally {
    saving.set(false)
  }
}

function openDetails(record: CouponRecord): void {
  detailsRecord.set(record)
}

function closeDetails(): void {
  detailsRecord.set(null)
}

function openDelete(record: CouponRecord): void {
  deletingRecord.set(record)
}

function closeDelete(): void {
  if (!deleting())
    deletingRecord.set(null)
}

async function deleteCoupon(): Promise<void> {
  const current = deletingRecord()
  if (!current)
    return
  deleting.set(true)
  try {
    await dashboardApi(`/api/dashboard/commerce/coupons/${current.id}`, { method: 'DELETE' })
    deletingRecord.set(null)
    detailsRecord.set(null)
    pushToast('success', 'Coupon deleted', { detail: current.code })
    await loadCoupons()
  }
  catch (error) {
    pushToast('error', 'Could not delete coupon', {
      detail: error instanceof Error ? error.message : String(error),
    })
  }
  finally {
    deleting.set(false)
  }
}

function previousPage(): void {
  page.set(Math.max(1, page() - 1))
}

function nextPage(): void {
  page.set(Math.min(pageCount(), page() + 1))
}

onMount(() => {
  void loadCoupons()
})
</script>

<div class="space-y-6">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="font-bold text-2xl text-gray-900 dark:text-white">Coupons</h1>
      <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Manage native Coupon records, availability, limits, and redemption state.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <Button variant="secondary" :loading="loading()" @click="loadCoupons()"><span :if="!loading()" class="h-4 w-4 i-hugeicons-refresh"></span>Refresh</Button>
      <Button tag="a" variant="secondary" :href="exportHref()" :download="'coupons-' + new Date().toISOString().slice(0, 10) + '.csv'"><span class="h-4 w-4 i-hugeicons-download-04"></span>Export filtered</Button>
      <Button @click="openAdd()"><span class="h-4 w-4 i-hugeicons-add-01"></span>Add coupon</Button>
    </div>
  </header>

  <div :if="loadError()" class="p-4 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">{{ loadError() }}</div>

  <section aria-label="Coupon metrics" class="grid gap-3 grid-cols-2 lg:grid-cols-4">
    <template :for="item in metricCards()" :key="item.label">
      <article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
        <p class="text-gray-500 text-xs dark:text-neutral-400">{{ item.label }}</p>
        <p class="mt-2 font-semibold text-2xl text-gray-900 dark:text-white">{{ item.value }}</p>
        <p class="mt-1 text-gray-400 text-xs dark:text-neutral-500">{{ item.detail }}</p>
      </article>
    </template>
  </section>

  <CommerceCouponBreakdown :records="records()" />

  <section class="space-y-3">
    <div class="grid gap-3 grid-cols-1 sm:grid-cols-2 xl:grid-cols-6">
      <label class="relative sm:col-span-2">
        <span class="sr-only">Search coupons</span>
        <span class="flex absolute inset-y-0 left-0 items-center pl-3 text-gray-400 pointer-events-none"><span class="h-4 w-4 i-hugeicons-search-01"></span></span>
        <input x-model="search" type="search" placeholder="Search codes, descriptions, or products" class="pl-9 pr-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700" />
      </label>
      <label><span class="sr-only">Coupon status</span><select x-model="statusFilter" class="px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700"><option value="all">All statuses</option><option value="Active">Active</option><option value="Scheduled">Scheduled</option><option value="Expired">Expired</option></select></label>
      <label><span class="sr-only">Coupon availability</span><select x-model="enabledFilter" class="px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700"><option value="all">Any availability</option><option value="enabled">Enabled</option><option value="disabled">Disabled</option></select></label>
      <label><span class="sr-only">Discount type</span><select x-model="typeFilter" class="px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700"><option value="all">All discount types</option><option value="percentage">Percentage</option><option value="fixed_amount">Fixed amount</option></select></label>
      <label><span class="sr-only">Sort coupons</span><select x-model="sort" class="px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700"><option value="newest">Newest</option><option value="code">Code</option><option value="usage">Most used</option><option value="expiry">Expiry date</option></select></label>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-gray-500 text-sm dark:text-neutral-400">{{ filteredRecords().length }} matching coupons</p>
      <div class="flex gap-2 items-center">
        <Button variant="secondary" size="sm" :disabled="page() <= 1" @click="previousPage()">Previous</Button>
        <span class="text-gray-500 text-sm dark:text-neutral-400">Page {{ Math.min(page(), pageCount()) }} of {{ pageCount() }}</span>
        <Button variant="secondary" size="sm" :disabled="page() >= pageCount()" @click="nextPage()">Next</Button>
      </div>
    </div>

    <CommerceCouponsTable :records="visibleRecords()" :loading="loading()" @view="openDetails" @edit="openEdit" @delete="openDelete" />
  </section>
</div>

<CommerceCouponDialog :open="dialogOpen()" :mode="dialogMode()" :record="editingRecord()" :busy="saving()" :errors="validationErrors()" @submit="saveCoupon" @close="closeDialog()" />
<CommerceCouponDetailsDialog :open="Boolean(detailsRecord())" :record="detailsRecord()" @edit="openEdit" @delete="openDelete" @close="closeDetails()" />
<CommerceCouponDeleteDialog :open="Boolean(deletingRecord())" :record="deletingRecord()" :busy="deleting()" @confirm="deleteCoupon()" @close="closeDelete()" />
