<script client>
import type { CouponSummary } from '../../../../app/Actions/Dashboard/Commerce/coupon-records'

/**
 * Counted by the server over every coupon (stacksjs/stacks#3218); this used
 * to count the records the page had, which were the newest 500.
 */
const summary = useReactiveProp<CouponSummary>('summary', { total: 0, enabled: 0, active: 0, scheduled: 0, expired: 0, percentage: 0, fixedAmount: 0, redemptions: 0, mostUsed: [] })

function statuses(): Array<{ label: string, count: number, color: string }> {
  return [
    { label: 'Active', count: summary().active, color: 'bg-emerald-500' },
    { label: 'Scheduled', count: summary().scheduled, color: 'bg-blue-500' },
    { label: 'Expired', count: summary().expired, color: 'bg-gray-400' },
  ]
}

function width(count: number): string {
  return `${summary().total ? Math.round((count / summary().total) * 100) : 0}%`
}

function discountTypes(): Array<{ label: string, count: number }> {
  return [
    { label: 'Percentage', count: summary().percentage },
    { label: 'Fixed amount', count: summary().fixedAmount },
  ]
}

function mostUsed(): CouponSummary['mostUsed'] {
  return summary().mostUsed ?? []
}
</script>

<section aria-label="Coupon breakdowns" class="grid gap-3 grid-cols-1 lg:grid-cols-3">
  <article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700"><h2 class="font-semibold text-gray-900 text-sm dark:text-white">Status distribution</h2><div class="mt-4 space-y-3"><div :for="item in statuses()" :key="item.label"><div class="flex justify-between text-xs"><span class="text-gray-500 dark:text-neutral-400">{{ item.label }}</span><span class="font-mono text-gray-700 dark:text-neutral-200">{{ item.count }}</span></div><div class="mt-1 h-1.5 bg-gray-100 dark:bg-neutral-700 rounded-full"><div :class="'h-full rounded-full ' + item.color" :style="'width: ' + width(item.count)"></div></div></div></div></article>
  <article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700"><h2 class="font-semibold text-gray-900 text-sm dark:text-white">Discount types</h2><dl class="mt-3 divide-gray-100 divide-y dark:divide-neutral-700"><div :for="item in discountTypes()" :key="item.label" class="flex items-center justify-between py-3"><dt class="text-gray-500 text-sm dark:text-neutral-400">{{ item.label }}</dt><dd class="font-mono text-gray-900 text-sm dark:text-white">{{ item.count }}</dd></div></dl></article>
  <article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700"><h2 class="font-semibold text-gray-900 text-sm dark:text-white">Most redeemed</h2><p :if="mostUsed().length === 0" class="mt-4 text-gray-500 text-sm dark:text-neutral-400">No coupon usage recorded.</p><ol :else class="mt-3 divide-gray-100 divide-y dark:divide-neutral-700"><li :for="record in mostUsed()" :key="record.id" class="flex items-center justify-between py-2"><span class="font-mono text-gray-600 text-sm truncate dark:text-neutral-300">{{ record.code }}</span><span class="ml-3 font-mono text-gray-900 text-sm dark:text-white">{{ record.usageCount.toLocaleString() }}</span></li></ol></article>
</section>
