<script client>
import type { CouponRecord } from '../../../../app/Actions/Dashboard/Commerce/coupon-records'

const records = useReactiveProp('records', [] as CouponRecord[])

function statuses(): Array<{ label: string, count: number, color: string }> {
  return [
    { label: 'Active', count: records().filter(record => record.status === 'Active').length, color: 'bg-emerald-500' },
    { label: 'Scheduled', count: records().filter(record => record.status === 'Scheduled').length, color: 'bg-blue-500' },
    { label: 'Expired', count: records().filter(record => record.status === 'Expired').length, color: 'bg-gray-400' },
  ]
}

function width(count: number): string {
  return `${records().length ? Math.round((count / records().length) * 100) : 0}%`
}

function discountTypes(): Array<{ label: string, count: number }> {
  return [
    { label: 'Percentage', count: records().filter(record => record.discountType === 'percentage').length },
    { label: 'Fixed amount', count: records().filter(record => record.discountType === 'fixed_amount').length },
  ]
}

function mostUsed(): CouponRecord[] {
  return [...records()].sort((left, right) => right.usageCount - left.usageCount || left.code.localeCompare(right.code)).slice(0, 5)
}
</script>

<section aria-label="Coupon breakdowns" class="grid gap-3 lg:grid-cols-3">
  <article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700"><h2 class="font-semibold text-gray-900 text-sm dark:text-white">Status distribution</h2><div class="mt-4 space-y-3"><template :for="item in statuses()" :key="item.label"><div><div class="flex justify-between text-xs"><span class="text-gray-500 dark:text-neutral-400">{{ item.label }}</span><span class="font-mono text-gray-700 dark:text-neutral-200">{{ item.count }}</span></div><div class="mt-1 h-1.5 bg-gray-100 dark:bg-neutral-700 rounded-full"><div :class="'h-full rounded-full ' + item.color" :style="'width: ' + width(item.count)"></div></div></div></template></div></article>
  <article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700"><h2 class="font-semibold text-gray-900 text-sm dark:text-white">Discount types</h2><dl class="mt-3 divide-gray-100 divide-y dark:divide-neutral-700"><template :for="item in discountTypes()" :key="item.label"><div class="flex items-center justify-between py-3"><dt class="text-gray-500 text-sm dark:text-neutral-400">{{ item.label }}</dt><dd class="font-mono text-gray-900 text-sm dark:text-white">{{ item.count }}</dd></div></template></dl></article>
  <article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700"><h2 class="font-semibold text-gray-900 text-sm dark:text-white">Most redeemed</h2><p :if="mostUsed().length === 0" class="mt-4 text-gray-500 text-sm dark:text-neutral-400">No coupon usage recorded.</p><ol :else class="mt-3 divide-gray-100 divide-y dark:divide-neutral-700"><template :for="record in mostUsed()" :key="record.id"><li class="flex items-center justify-between py-2"><span class="font-mono text-gray-600 text-sm truncate dark:text-neutral-300">{{ record.code }}</span><span class="ml-3 font-mono text-gray-900 text-sm dark:text-white">{{ record.usageCount.toLocaleString() }}</span></li></template></ol></article>
</section>
