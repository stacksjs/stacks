<script client>
import type { ProductWaitlistRecord, ProductWaitlistSummary } from '../../../../app/Actions/Dashboard/Commerce/product-waitlist-records'
import { dashboardApi } from '../../../../functions/dashboard-api'
import { pushToast } from '../../../../functions/toasts'

interface ProductWaitlistResponse {
  records: ProductWaitlistRecord[]
  summary: ProductWaitlistSummary
}

const records = state<ProductWaitlistRecord[]>([])
const summary = state<ProductWaitlistSummary>({ total: 0, waiting: 0, notified: 0, purchased: 0, conversionRate: 0 })
const search = state('')
const status = state('all')
const isLoading = state(true)
const loadError = state('')

function rows(): ProductWaitlistRecord[] {
  const query = search().trim().toLowerCase()
  return records().filter((record) => {
    if (status() !== 'all' && record.status !== status())
      return false
    return !query || [record.name, record.email, record.phone, record.source, record.productId]
      .some(value => value.toLowerCase().includes(query))
  })
}

function updateSearch(event: Event): void {
  search.set((event.target as HTMLInputElement).value)
}

function updateStatus(event: Event): void {
  status.set((event.target as HTMLSelectElement).value)
}

function formatDate(value: string): string {
  if (!value)
    return 'Not recorded'
  const date = new Date(value)
  return Number.isNaN(date.getTime()) ? value : new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' }).format(date)
}

function statusClass(value: string): string {
  if (value === 'purchased')
    return 'text-purple-700 dark:text-purple-300 bg-purple-50 dark:bg-purple-950/30'
  if (value === 'notified')
    return 'text-green-700 dark:text-green-300 bg-green-50 dark:bg-green-950/30'
  if (value === 'waiting')
    return 'text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-950/30'
  return 'text-gray-700 dark:text-neutral-300 bg-gray-100 dark:bg-neutral-700'
}

async function loadRecords(): Promise<void> {
  isLoading.set(true)
  loadError.set('')
  try {
    const result = await dashboardApi<ProductWaitlistResponse>('/api/dashboard/commerce/waitlist-products')
    records.set(Array.isArray(result.records) ? result.records : [])
    summary.set(result.summary ?? { total: 0, waiting: 0, notified: 0, purchased: 0, conversionRate: 0 })
  }
  catch (error) {
    loadError.set('Product waitlist records could not be loaded.')
    pushToast('error', 'Could not load product waitlist', {
      detail: error instanceof Error ? error.message : String(error),
    })
  }
  finally {
    isLoading.set(false)
  }
}

onMount(() => {
  void loadRecords()
})
</script>

<div class="space-y-6">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="font-bold text-2xl text-gray-900 dark:text-white">Product Waitlist</h1>
      <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Native WaitlistProduct records without simulated customers or activity.</p>
    </div>
    <button type="button" :disabled="isLoading()" class="inline-flex items-center self-start px-3 py-2 font-semibold text-gray-700 text-sm dark:text-neutral-200 bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700 disabled:opacity-50" @click="loadRecords">
      <span :class="'mr-2 h-4 w-4 ' + (isLoading() ? 'animate-spin i-hugeicons-loading-03' : 'i-hugeicons-refresh')"></span>
      Refresh
    </button>
  </header>

  <div :if="loadError()" class="p-4 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">{{ loadError() }}</div>

  <section class="grid gap-3 grid-cols-2 lg:grid-cols-5">
    <template :for="item in [
      { label: 'Recorded', value: summary().total },
      { label: 'Waiting', value: summary().waiting },
      { label: 'Notified', value: summary().notified },
      { label: 'Purchased', value: summary().purchased },
      { label: 'Conversion', value: summary().conversionRate + '%' }
    ]">
      <div class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
        <p class="text-gray-500 text-xs uppercase dark:text-neutral-400">{{ item.label }}</p>
        <p class="mt-2 font-semibold text-2xl text-gray-900 dark:text-white">{{ item.value }}</p>
      </div>
    </template>
  </section>

  <section class="space-y-3">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2 class="font-semibold text-gray-900 dark:text-white">Waitlist entries</h2>
        <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Up to 200 recent records from the application model.</p>
      </div>
      <div class="flex gap-2">
        <label class="sr-only" for="waitlist-status">Status</label>
        <select id="waitlist-status" :value="status()" class="px-3 py-2 text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700" @change="updateStatus($event)">
          <option value="all">All statuses</option>
          <option value="waiting">Waiting</option>
          <option value="notified">Notified</option>
          <option value="purchased">Purchased</option>
          <option value="cancelled">Cancelled</option>
        </select>
        <label class="sr-only" for="waitlist-search">Search waitlist</label>
        <input id="waitlist-search" :value="search()" type="search" placeholder="Search waitlist" class="px-3 py-2 w-56 text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700" @input="updateSearch($event)" />
      </div>
    </div>

    <div class="overflow-hidden bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
      <div :if="isLoading()" class="flex items-center justify-center p-8 text-gray-500 text-sm dark:text-neutral-400">Loading waitlist records</div>
      <div :else-if="rows().length === 0" class="p-8 text-center">
        <p class="font-medium text-gray-900 text-sm dark:text-white">No product waitlist records found</p>
        <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Records created through the WaitlistProduct API will appear here.</p>
      </div>
      <div :else class="overflow-x-auto">
        <table class="min-w-full divide-gray-200 divide-y dark:divide-neutral-700">
          <thead class="bg-gray-50 dark:bg-neutral-900/50">
            <tr>
              <th class="px-4 py-3 font-semibold text-gray-600 text-left text-xs uppercase dark:text-neutral-400">Customer</th>
              <th class="px-4 py-3 font-semibold text-gray-600 text-left text-xs uppercase dark:text-neutral-400">Product</th>
              <th class="px-4 py-3 font-semibold text-gray-600 text-right text-xs uppercase dark:text-neutral-400">Quantity</th>
              <th class="px-4 py-3 font-semibold text-gray-600 text-left text-xs uppercase dark:text-neutral-400">Status</th>
              <th class="px-4 py-3 font-semibold text-gray-600 text-left text-xs uppercase dark:text-neutral-400">Preference</th>
              <th class="px-4 py-3 font-semibold text-gray-600 text-left text-xs uppercase dark:text-neutral-400">Created</th>
            </tr>
          </thead>
          <tbody class="divide-gray-100 divide-y dark:divide-neutral-700">
            <template :for="record in rows()" :key="record.id">
              <tr>
                <td class="px-4 py-3">
                  <p class="font-medium text-gray-900 text-sm dark:text-white">{{ record.name || 'Unnamed' }}</p>
                  <p class="mt-1 text-gray-500 text-xs dark:text-neutral-400">{{ record.email || record.phone || 'No contact recorded' }}</p>
                </td>
                <td class="px-4 py-3 font-mono text-gray-600 text-sm dark:text-neutral-300">{{ record.productId || 'Not linked' }}</td>
                <td class="px-4 py-3 font-mono text-gray-700 text-right text-sm dark:text-neutral-200">{{ record.quantity }}</td>
                <td class="px-4 py-3"><span :class="'inline-flex px-2 py-1 font-medium text-xs capitalize rounded-full ' + statusClass(record.status)">{{ record.status || 'unknown' }}</span></td>
                <td class="px-4 py-3 capitalize text-gray-600 text-sm dark:text-neutral-300">{{ record.notificationPreference || 'Not recorded' }}</td>
                <td class="px-4 py-3 text-gray-600 text-sm whitespace-nowrap dark:text-neutral-300">{{ formatDate(record.createdAt) }}</td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</div>
