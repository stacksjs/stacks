<script client>
import type {
  CommerceOrderRecord,
  OrderCustomerOption,
} from '../../../../app/Actions/Dashboard/Commerce/commerce-order-records'
import { minorToInput, moneyInputError, moneyInputStep, parseMoneyInput } from '@stacksjs/commerce/money'
import { dashboardApi } from '../../../../functions/dashboard-api'
import { formErrorMessages } from '../../../../functions/dashboard-form'

const open = useReactiveProp('open', false)
const mode = useReactiveProp('mode', 'add')
const record = useReactiveProp('record', null as CommerceOrderRecord | null)
// The customer choices are a server search (stacksjs/stacks#3218): this used
// to be handed the first 500 customers by name, so nobody past the 500th could
// be chosen.
const customerOptions = state<OrderCustomerOption[]>([])
const customerMatches = state(0)
const customerQuery = state('')
let customerRequest = 0
let customerTimer: ReturnType<typeof setTimeout> | null = null
const statuses = useReactiveProp('statuses', [] as string[])
const orderTypes = useReactiveProp('orderTypes', [] as string[])
const defaultCurrency = useReactiveProp('defaultCurrency', 'USD')
const busy = useReactiveProp('busy', false)
const errors = useReactiveProp('errors', {} as Record<string, string>)
const emit = defineEmits(['submit', 'close'])
const customerId = state('')
const couponId = state('')
const status = state('PENDING')
const totalAmount = state('0')
const currency = state('USD')
const taxAmount = state('0')
const discountAmount = state('0')
const deliveryFee = state('0')
const tipAmount = state('0')
const orderType = state('DELIVERY')
const deliveryAddress = state('')
const specialInstructions = state('')
const estimatedDeliveryTime = state('')
const appliedCouponId = state('')
let hydrationKey = ''

effect(() => {
  if (!open()) {
    hydrationKey = ''
    return
  }
  const current = record()
  const key = `${mode()}:${current?.id || 'new'}`
  if (hydrationKey === key)
    return
  hydrationKey = key
  customerQuery.set('')
  void loadCustomers('')
  customerId.set(current?.customerId || '')
  couponId.set(current?.couponId || '')
  status.set(current?.status || statuses()[0] || 'PENDING')
  // Stored amounts are integer minor units; the fields show the decimal.
  const orderCurrency = current?.currency || defaultCurrency()
  currency.set(orderCurrency)
  totalAmount.set(minorToInput(current?.totalAmount ?? 0, orderCurrency))
  taxAmount.set(minorToInput(current?.taxAmount ?? 0, orderCurrency))
  discountAmount.set(minorToInput(current?.discountAmount ?? 0, orderCurrency))
  deliveryFee.set(minorToInput(current?.deliveryFee ?? 0, orderCurrency))
  tipAmount.set(minorToInput(current?.tipAmount ?? 0, orderCurrency))
  orderType.set(current?.orderType || orderTypes()[0] || 'DELIVERY')
  deliveryAddress.set(current?.deliveryAddress || '')
  specialInstructions.set(current?.specialInstructions || '')
  estimatedDeliveryTime.set(current?.estimatedDeliveryTime.slice(0, 16) || '')
  appliedCouponId.set(current?.appliedCouponId || '')
})

/** The choices to show: the search results, with the order's own customer kept in. */
const customers = derived(() => {
  const options = customerOptions()
  const current = record()
  if (!current?.customerId || options.some(option => option.id === current.customerId))
    return options
  return [{ id: current.customerId, label: current.customerName || `Customer ${current.customerId}` }, ...options]
})

const moreCustomersLabel = derived(() => {
  const shown = customerOptions().length
  const total = customerMatches()
  return total > shown ? `Showing ${shown} of ${total.toLocaleString()} matching customers. Search to narrow it down.` : ''
})

async function loadCustomers(term: string): Promise<void> {
  const request = ++customerRequest
  try {
    const params = new URLSearchParams()
    if (term)
      params.set('q', term)
    const suffix = params.toString()
    const data = await dashboardApi<{ customers?: OrderCustomerOption[], total?: number }>(`/api/dashboard/commerce/orders/customers${suffix ? `?${suffix}` : ''}`)
    if (request !== customerRequest)
      return
    customerOptions.set(data.customers ?? [])
    customerMatches.set(data.total ?? (data.customers?.length ?? 0))
  }
  catch {
    // Soft-fail: the order's own customer stays selectable, and Unassigned.
    if (request === customerRequest) {
      customerOptions.set([])
      customerMatches.set(0)
    }
  }
}

function searchCustomersSoon(): void {
  if (customerTimer)
    clearTimeout(customerTimer)
  customerTimer = setTimeout(() => { void loadCustomers(customerQuery().trim()) }, 250)
}

function label(value: string): string {
  return value.replaceAll('_', ' ').toLowerCase().replace(/\b\w/g, letter => letter.toUpperCase())
}

// An empty optional amount means zero, as it did before amounts were
// converted to minor units.
function validNumber(value: string, required = false): boolean {
  return !moneyInputError(value, currency(), { required })
}

function minorAmount(value: string): number {
  return parseMoneyInput(value, currency(), { required: false }) ?? 0
}

function valid(): boolean {
  return Boolean(
    status().trim()
    && orderType().trim()
    && currency().trim().length === 3
    && validNumber(totalAmount(), true)
    && validNumber(taxAmount())
    && validNumber(discountAmount())
    && validNumber(deliveryFee())
    && validNumber(tipAmount())
  )
}

function submit(): void {
  if (!valid())
    return
  emit('submit', {
    customerId: customerId() ? Number(customerId()) : undefined,
    couponId: couponId() ? Number(couponId()) : undefined,
    status: status().trim(),
    totalAmount: parseMoneyInput(totalAmount(), currency()),
    currency: currency().trim().toUpperCase(),
    taxAmount: minorAmount(taxAmount()),
    discountAmount: minorAmount(discountAmount()),
    deliveryFee: minorAmount(deliveryFee()),
    tipAmount: minorAmount(tipAmount()),
    orderType: orderType().trim(),
    deliveryAddress: deliveryAddress().trim() || undefined,
    specialInstructions: specialInstructions().trim() || undefined,
    estimatedDeliveryTime: estimatedDeliveryTime() || undefined,
    appliedCouponId: appliedCouponId().trim() || undefined,
  })
}

function errorMessages(): string[] {
  return formErrorMessages(errors())
}
</script>

<Modal
  :isOpen="open()"
  :title="mode() === 'edit' ? 'Edit order' : 'Add order'"
  description="Store fields and relationships declared by the native Order model."
  size="xl"
  @close="emit('close')"
>
    <form id="order-form" @submit.prevent="submit">
        <ul :if="errorMessages().length > 0" class="mb-5 p-3 space-y-1 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">
          <template :for="message in errorMessages()" :key="message"><li>{{ message }}</li></template>
        </ul>
        <div class="grid gap-4 grid-cols-1 sm:grid-cols-2">
          <div class="block">
            <label class="block"><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Customer</span><input x-model="customerQuery" @input="searchCustomersSoon()" type="search" name="customer_search" aria-label="Search customers by name or email" placeholder="Search by name or email" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" /></label>
            <select x-model="customerId" aria-label="Customer" class="mt-2 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700"><option value="">Unassigned customer</option><template :for="option in customers()" :key="option.id"><option :value="option.id" :selected="option.id === customerId()">{{ option.label }}</option></template></select>
            <p :if="moreCustomersLabel()" class="mt-1 text-gray-500 text-xs dark:text-neutral-400" :text="moreCustomersLabel()"></p>
          </div>
          <label class="block"><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Status</span><select x-model="status" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700"><template :for="option in statuses()" :key="option"><option :value="option">{{ label(option) }}</option></template></select></label>
          <label class="block"><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Order type</span><select x-model="orderType" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700"><template :for="option in orderTypes()" :key="option"><option :value="option">{{ label(option) }}</option></template></select></label>
          <label class="block"><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Currency</span><input x-model="currency" type="text" minlength="3" maxlength="3" required spellcheck="false" class="mt-1 px-3 py-2 w-full font-mono text-gray-900 text-sm uppercase dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" /></label>
          <label class="block"><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Total amount</span><input x-model="totalAmount" type="number" min="0" :step="moneyInputStep(currency())" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" /></label>
          <label class="block"><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Tax amount</span><input x-model="taxAmount" type="number" min="0" :step="moneyInputStep(currency())" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" /></label>
          <label class="block"><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Discount amount</span><input x-model="discountAmount" type="number" min="0" :step="moneyInputStep(currency())" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" /></label>
          <label class="block"><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Delivery fee</span><input x-model="deliveryFee" type="number" min="0" :step="moneyInputStep(currency())" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" /></label>
          <label class="block"><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Tip amount</span><input x-model="tipAmount" type="number" min="0" :step="moneyInputStep(currency())" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" /></label>
          <label class="block"><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Estimated delivery time</span><input x-model="estimatedDeliveryTime" type="datetime-local" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" /></label>
          <label class="block"><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Coupon relation ID</span><input x-model="couponId" type="number" min="1" step="1" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" /></label>
          <label class="block"><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Applied coupon reference</span><input x-model="appliedCouponId" type="text" class="mt-1 px-3 py-2 w-full font-mono text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" /></label>
          <label class="block sm:col-span-2"><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Delivery address</span><textarea x-model="deliveryAddress" rows="3" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700"></textarea></label>
          <label class="block sm:col-span-2"><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Special instructions</span><textarea x-model="specialInstructions" rows="3" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700"></textarea></label>
        </div>
    </form>
  <template #footer>
    <div class="flex gap-2 justify-end w-full"><Button variant="secondary" :disabled="busy()" @click="emit('close')">Cancel</Button><Button type="submit" form="order-form" :loading="busy()" :disabled="!valid()">{{ mode() === 'edit' ? 'Save order' : 'Add order' }}</Button></div>
  </template>
</Modal>
