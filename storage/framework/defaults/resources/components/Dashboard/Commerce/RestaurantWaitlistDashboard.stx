<script client>
import type { RestaurantWaitlistOptions, RestaurantWaitlistRecord, RestaurantWaitlistSummary, RestaurantWaitlistWritePayload } from '../../../../app/Actions/Dashboard/Commerce/restaurant-waitlist-records'
import { restaurantWaitlistTimestamp } from '../../../../app/Actions/Dashboard/Commerce/restaurant-waitlist-records'
import { DashboardApiError, dashboardApi } from '../../../../functions/dashboard-api'
import { pushToast } from '../../../../functions/toasts'

interface RestaurantWaitlistResponse {
  records: RestaurantWaitlistRecord[]
  summary: RestaurantWaitlistSummary
  options: RestaurantWaitlistOptions
}

const records = state<RestaurantWaitlistRecord[]>([])
const summary = state<RestaurantWaitlistSummary>({ total: 0, waiting: 0, seated: 0, cancelled: 0, noShow: 0, averageQuotedWait: 0, seatingRate: 0 })
const options = state<RestaurantWaitlistOptions>({ customers: [] })
const search = state('')
const status = state('all')
const preference = state('all')
const isLoading = state(true)
const loadError = state('')
const entryDialogOpen = state(false)
const entryDialogMode = state<'add' | 'edit'>('add')
const editingRecord = state<RestaurantWaitlistRecord | null>(null)
const deleteRecord = state<RestaurantWaitlistRecord | null>(null)
const isSaving = state(false)
const isDeleting = state(false)
const busyId = state('')
const validationErrors = state<Record<string, string>>({})

function rows(): RestaurantWaitlistRecord[] {
  const query = search().trim().toLowerCase()
  return records().filter((record) => {
    if (status() !== 'all' && record.status !== status())
      return false
    if (preference() !== 'all' && record.tablePreference !== preference())
      return false
    return !query || [record.name, record.email, record.phone, record.status, record.tablePreference]
      .some(value => value.toLowerCase().includes(query))
  })
}

function openAddDialog(): void {
  entryDialogMode.set('add')
  editingRecord.set(null)
  validationErrors.set({})
  entryDialogOpen.set(true)
}

function openEditDialog(record: RestaurantWaitlistRecord): void {
  entryDialogMode.set('edit')
  editingRecord.set(record)
  validationErrors.set({})
  entryDialogOpen.set(true)
}

function closeEntryDialog(): void {
  if (isSaving())
    return
  entryDialogOpen.set(false)
  editingRecord.set(null)
  validationErrors.set({})
}

function openDeleteDialog(record: RestaurantWaitlistRecord): void {
  deleteRecord.set(record)
}

function closeDeleteDialog(): void {
  if (!isDeleting())
    deleteRecord.set(null)
}

function relationId(value: string): number | null {
  const id = Number(value)
  return Number.isInteger(id) && id > 0 ? id : null
}

function writePayload(record: RestaurantWaitlistRecord, nextStatus = record.status): RestaurantWaitlistWritePayload {
  const payload: RestaurantWaitlistWritePayload = {
    customerId: relationId(record.customerId),
    name: record.name,
    email: record.email,
    phone: record.phone,
    partySize: record.partySize,
    checkInTime: restaurantWaitlistTimestamp(record.checkInTime),
    tablePreference: record.tablePreference as RestaurantWaitlistWritePayload['tablePreference'],
    status: nextStatus as RestaurantWaitlistWritePayload['status'],
    quoted_wait_time: record.quotedWaitTime,
  }
  if (record.actualWaitTime !== null)
    payload.actual_wait_time = record.actualWaitTime
  if (record.queuePosition !== null)
    payload.queue_position = record.queuePosition
  return payload
}

function elapsedMinutes(value: string): number {
  const checkedIn = restaurantWaitlistTimestamp(value) * 1000
  if (checkedIn <= 0)
    return 0
  return Math.max(0, Math.round((Date.now() - checkedIn) / 60000))
}

async function loadRecords(): Promise<void> {
  isLoading.set(true)
  loadError.set('')
  try {
    const result = await dashboardApi<RestaurantWaitlistResponse>('/api/dashboard/commerce/waitlist-restaurants')
    records.set(Array.isArray(result.records) ? result.records : [])
    summary.set(result.summary ?? { total: 0, waiting: 0, seated: 0, cancelled: 0, noShow: 0, averageQuotedWait: 0, seatingRate: 0 })
    options.set(result.options ?? { customers: [] })
  }
  catch (error) {
    loadError.set('Restaurant waitlist records could not be loaded.')
    pushToast('error', 'Could not load restaurant waitlist', {
      detail: error instanceof Error ? error.message : String(error),
    })
  }
  finally {
    isLoading.set(false)
  }
}

async function saveRecord(payload: RestaurantWaitlistWritePayload): Promise<void> {
  const current = editingRecord()
  const isEditing = entryDialogMode() === 'edit' && current !== null
  const path = isEditing
    ? `/api/dashboard/commerce/waitlist-restaurants/${current.id}`
    : '/api/dashboard/commerce/waitlist-restaurants'
  const method = isEditing ? 'PATCH' : 'POST'

  isSaving.set(true)
  validationErrors.set({})
  try {
    await dashboardApi(path, { method, body: payload })
    entryDialogOpen.set(false)
    editingRecord.set(null)
    pushToast('success', isEditing ? 'Waitlist party updated' : 'Waitlist party added')
    await loadRecords()
  }
  catch (error) {
    if (error instanceof DashboardApiError)
      validationErrors.set(error.fields ?? {})
    pushToast('error', 'Could not save waitlist party', {
      detail: error instanceof Error ? error.message : String(error),
    })
  }
  finally {
    isSaving.set(false)
  }
}

async function changeStatus(record: RestaurantWaitlistRecord, nextStatus: 'seated' | 'no_show'): Promise<void> {
  busyId.set(record.id)
  try {
    const payload = writePayload(record, nextStatus)
    if (nextStatus === 'seated' && payload.actual_wait_time === undefined)
      payload.actual_wait_time = elapsedMinutes(record.checkInTime)
    await dashboardApi(`/api/dashboard/commerce/waitlist-restaurants/${record.id}`, { method: 'PATCH', body: payload })
    pushToast('success', nextStatus === 'seated' ? 'Party marked as seated' : 'Party marked as no show')
    await loadRecords()
  }
  catch (error) {
    pushToast('error', 'Could not update waitlist status', {
      detail: error instanceof Error ? error.message : String(error),
    })
  }
  finally {
    busyId.set('')
  }
}

async function deleteSelectedRecord(): Promise<void> {
  const current = deleteRecord()
  if (!current)
    return

  isDeleting.set(true)
  busyId.set(current.id)
  try {
    await dashboardApi(`/api/dashboard/commerce/waitlist-restaurants/${current.id}`, { method: 'DELETE' })
    deleteRecord.set(null)
    pushToast('success', 'Waitlist party deleted')
    await loadRecords()
  }
  catch (error) {
    pushToast('error', 'Could not delete waitlist party', {
      detail: error instanceof Error ? error.message : String(error),
    })
  }
  finally {
    isDeleting.set(false)
    busyId.set('')
  }
}

onMount(() => {
  void loadRecords()
})
</script>

<div class="space-y-6">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="font-bold text-2xl text-gray-900 dark:text-white">Restaurant Waitlist</h1>
      <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Manage persisted WaitlistRestaurant records and seating states.</p>
    </div>
    <div class="flex gap-2">
      <Button variant="secondary" :loading="isLoading()" @click="loadRecords">
        <span :if="!isLoading()" class="h-4 w-4 i-hugeicons-refresh"></span>
        Refresh
      </Button>
      <Button :disabled="isLoading()" @click="openAddDialog()">
        <span class="h-4 w-4 i-hugeicons-add-01"></span>
        Add party
      </Button>
    </div>
  </header>

  <div :if="loadError()" class="p-4 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">{{ loadError() }}</div>

  <section class="grid gap-3 grid-cols-2 lg:grid-cols-5">
    <template :for="item in [
      { label: 'Waiting', value: summary().waiting },
      { label: 'Quoted wait', value: summary().averageQuotedWait + ' min' },
      { label: 'Seated', value: summary().seated },
      { label: 'No show', value: summary().noShow },
      { label: 'Seating rate', value: summary().seatingRate + '%' }
    ]">
      <div class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
        <p class="text-gray-500 text-xs uppercase dark:text-neutral-400">{{ item.label }}</p>
        <p class="mt-2 font-semibold text-2xl text-gray-900 dark:text-white">{{ item.value }}</p>
      </div>
    </template>
  </section>

  <section class="space-y-3">
    <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <h2 class="font-semibold text-gray-900 dark:text-white">Waitlist parties</h2>
        <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Up to 200 recent records from the application model.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <label class="sr-only" for="restaurant-waitlist-status">Status</label>
        <select id="restaurant-waitlist-status" x-model="status" class="px-3 py-2 text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700">
          <option value="all">All statuses</option>
          <option value="waiting">Waiting</option>
          <option value="seated">Seated</option>
          <option value="cancelled">Cancelled</option>
          <option value="no_show">No show</option>
        </select>
        <label class="sr-only" for="restaurant-waitlist-preference">Table preference</label>
        <select id="restaurant-waitlist-preference" x-model="preference" class="px-3 py-2 text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700">
          <option value="all">All tables</option>
          <option value="no_preference">No preference</option>
          <option value="indoor">Indoor</option>
          <option value="bar">Bar</option>
          <option value="booth">Booth</option>
        </select>
        <label class="sr-only" for="restaurant-waitlist-search">Search waitlist</label>
        <input id="restaurant-waitlist-search" x-model="search" type="search" placeholder="Search waitlist" class="px-3 py-2 w-56 text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700" />
      </div>
    </div>

    <RestaurantWaitlistTable
      :records="rows()"
      :loading="isLoading()"
      :busyId="busyId()"
      @seat="changeStatus($event, 'seated')"
      @no-show="changeStatus($event, 'no_show')"
      @edit="openEditDialog"
      @delete="openDeleteDialog"
    />
  </section>
</div>

<RestaurantWaitlistEntryDialog
  :open="entryDialogOpen()"
  :mode="entryDialogMode()"
  :record="editingRecord()"
  :options="options()"
  :busy="isSaving()"
  :errors="validationErrors()"
  @submit="saveRecord"
  @close="closeEntryDialog()"
/>

<RestaurantWaitlistDeleteDialog
  :open="Boolean(deleteRecord())"
  :record="deleteRecord()"
  :busy="isDeleting()"
  @confirm="deleteSelectedRecord()"
  @close="closeDeleteDialog()"
/>
