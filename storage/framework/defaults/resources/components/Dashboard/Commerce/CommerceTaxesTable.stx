@import('../UI/Table')

<script client>
import type { TaxRateRecord } from '../../../../app/Actions/Dashboard/Commerce/tax-rate-records'

const records = useReactiveProp('records', [] as TaxRateRecord[])
const loading = useReactiveProp('loading', false)
/** The parent's sort select; a change hands the order back from a header sort. */
const sortResetKey = useReactiveProp<unknown>('sortResetKey', '')
const emit = defineEmits(['edit', 'delete'])

/**
 * The name cell is slotted: the default, code and exemptible badges sit
 * beside the name because each changes what a customer is charged, and the
 * code is what application code matches on, so renaming the rate must not
 * change the bill. Everything else is a column option.
 */
const COLUMNS = [
  { key: 'name', label: 'Tax rate', sortable: true, slotted: true },
  { key: 'rateLabel', label: 'Rate', sortable: true, searchable: false, class: 'font-medium text-gray-900 whitespace-nowrap dark:text-white' },
  { key: 'country', label: 'Location', sortable: true, subtitleKey: 'region' },
  {
    key: 'status',
    label: 'Status',
    type: 'badge' as const,
    sortable: true,
    badgeClasses: { active: 'text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/40' },
    badgeLabels: { active: 'Active', inactive: 'Inactive' },
  },
  { key: 'createdAt', label: 'Created', type: 'date' as const, sortable: true, class: 'whitespace-nowrap' },
]

const ROW_ACTIONS = [
  { action: 'edit', label: 'Edit', icon: 'i-hugeicons-edit-01' },
  { action: 'delete', label: 'Delete', icon: 'i-hugeicons-delete-02', class: 'text-red-500' },
]

const rows = derived(() => records().map(record => ({
  ...record,
  rateLabel: `${record.rate}%`,
  // Anything but active reads as inactive, as the hand-rolled pill did.
  status: record.status === 'active' ? 'active' : 'inactive',
})))

function handleRowAction(payload: { action: string, row: TaxRateRecord }): void {
  emit(payload.action, payload.row)
}
</script>

{{--
  No `searchable` or `filterable`: the parent dashboard owns the search box
  and the filter selects. Paging is what was missing, and Table brings it.
--}}
<Table
  :sort-reset-key="sortResetKey()"
  :columns="COLUMNS"
  :data="rows()"
  :loading="loading()"
  :row-actions="ROW_ACTIONS"
  action-label-key="name"
  paginated
  :page-size="25"
  empty-title="No tax rates found"
  empty-description="Adjust the filters or add a TaxRate record."
  @row-action="handleRowAction"
>
  <template #cell="{ row }">
    <div class="flex flex-wrap gap-2 items-center">
      <p class="font-medium text-gray-900 text-sm dark:text-white" x-text="row.name"></p>
      <span :if="row.isDefault" class="px-2 py-0.5 font-medium text-blue-700 text-xs dark:text-blue-300 bg-blue-50 dark:bg-blue-950/40 rounded-full">Default</span>
      <span :if="row.code" class="px-2 py-0.5 font-mono text-gray-600 text-xs dark:text-neutral-300 bg-gray-100 dark:bg-neutral-700 rounded-full" x-text="row.code"></span>
      <span :if="row.exemptible" class="px-2 py-0.5 font-medium text-amber-700 text-xs dark:text-amber-300 bg-amber-50 dark:bg-amber-950/40 rounded-full" x-tooltip="Not charged to a customer who qualifies for an exemption" title="Not charged to a customer who qualifies for an exemption">Exemptible</span>
    </div>
    <p class="mt-1 text-gray-500 text-xs dark:text-neutral-400" x-text="row.type"></p>
  </template>
</Table>
