<script client>
import type { ProductUnitRecord } from '../../../../app/Actions/Dashboard/Commerce/product-unit-records'

const open = useReactiveProp('open', false)
const record = useReactiveProp('record', null as ProductUnitRecord | null)
const busy = useReactiveProp('busy', false)
const emit = defineEmits()
</script>

<div :if="open()" class="flex fixed inset-0 z-50 items-center justify-center p-4 dashboard-modal-layer">
  <button type="button" aria-label="Close delete product unit dialog" class="absolute inset-0 bg-black/45" @click="emit('close')"></button>
  <section role="dialog" aria-modal="true" aria-labelledby="product-unit-delete-title" class="relative p-6 max-w-md w-full bg-white dark:bg-neutral-800 border border-gray-200 rounded-xl dark:border-neutral-700 shadow-xl">
    <h2 id="product-unit-delete-title" class="font-semibold text-gray-900 text-lg dark:text-white">Delete product unit?</h2>
    <p class="mt-2 text-gray-600 text-sm dark:text-neutral-300">
      <span class="font-medium">{{ record()?.name }}</span> will be permanently removed.
      <span :if="record()?.productName">The linked product {{ record()?.productName }} will remain.</span>
    </p>
    <p :if="record()?.isDefault" class="mt-3 p-3 text-amber-800 text-sm dark:text-amber-200 bg-amber-50 dark:bg-amber-950/30 rounded-lg">This is the current default for {{ record()?.type }}. No replacement is selected automatically.</p>
    <footer class="flex gap-2 justify-end mt-6">
      <Button variant="secondary" :disabled="busy()" @click="emit('close')">Cancel</Button>
      <Button variant="danger" :loading="busy()" @click="emit('confirm')">
        Delete product unit
      </Button>
    </footer>
  </section>
</div>
