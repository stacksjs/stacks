<script client>
import type { CommerceCategoryRecord } from '../../../../app/Actions/Dashboard/Commerce/commerce-category-records'

const open = useReactiveProp('open', false)
const mode = useReactiveProp('mode', 'add')
const record = useReactiveProp('record', null as CommerceCategoryRecord | null)
const records = useReactiveProp('records', [] as CommerceCategoryRecord[])
const busy = useReactiveProp('busy', false)
const errors = useReactiveProp('errors', {} as Record<string, string>)
const emit = defineEmits()
const name = state('')
const description = state('')
const slug = state('')
const imageUrl = state('')
const isActive = state(true)
const parentCategoryId = state('')
const displayOrder = state('0')
let hydrationKey = ''
let slugTouched = false

function slugify(value: string): string {
  return value
    .normalize('NFKD')
    .replace(/[\u0300-\u036F]/g, '')
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '')
}

effect(() => {
  if (!open()) {
    hydrationKey = ''
    return
  }
  const current = record()
  const key = `${mode()}:${current?.id || 'new'}`
  if (hydrationKey === key)
    return
  hydrationKey = key
  name.set(current?.name || '')
  description.set(current?.description || '')
  slug.set(current?.slug || '')
  imageUrl.set(current?.imageUrl || '')
  isActive.set(current?.isActive ?? true)
  parentCategoryId.set(current?.parentCategoryId || '')
  displayOrder.set(String(current?.displayOrder ?? 0))
  slugTouched = Boolean(current?.slug)
})

function inputValue(event: Event): string {
  return (event.target as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement).value
}

function updateName(event: Event): void {
  const value = inputValue(event)
  name.set(value)
  if (!slugTouched)
    slug.set(slugify(value))
}

function updateDescription(event: Event): void {
  description.set(inputValue(event))
}

function updateSlug(event: Event): void {
  slugTouched = true
  slug.set(slugify(inputValue(event)))
}

function updateImageUrl(event: Event): void {
  imageUrl.set(inputValue(event))
}

function updateParent(event: Event): void {
  parentCategoryId.set(inputValue(event))
}

function updateDisplayOrder(event: Event): void {
  displayOrder.set(inputValue(event))
}

function updateIsActive(event: Event): void {
  isActive.set((event.target as HTMLInputElement).checked)
}

function forbiddenParentIds(): Set<string> {
  const currentId = record()?.id
  if (!currentId)
    return new Set()
  const forbidden = new Set([currentId])
  let changed = true
  while (changed) {
    changed = false
    for (const candidate of records()) {
      if (candidate.parentCategoryId && forbidden.has(candidate.parentCategoryId) && !forbidden.has(candidate.id)) {
        forbidden.add(candidate.id)
        changed = true
      }
    }
  }
  return forbidden
}

function parentOptions(): CommerceCategoryRecord[] {
  const forbidden = forbiddenParentIds()
  return records()
    .filter(candidate => !forbidden.has(candidate.id))
    .sort((left, right) => left.name.localeCompare(right.name))
}

function valid(): boolean {
  return Boolean(
    name().trim()
    && slug().trim()
    && Number.isFinite(Number(displayOrder()))
    && Number(displayOrder()) >= 0
  )
}

function submit(): void {
  if (!valid())
    return
  emit('submit', {
    name: name().trim(),
    description: description().trim() || undefined,
    slug: slug().trim(),
    imageUrl: imageUrl().trim() || undefined,
    isActive: isActive(),
    parentCategoryId: parentCategoryId() || undefined,
    displayOrder: Number(displayOrder()),
  })
}

function errorMessages(): string[] {
  return Object.entries(errors()).map(([field, message]) => {
    const label = field.replace(/([a-z])([A-Z])/g, '$1 $2').replaceAll('_', ' ')
    return `${label.charAt(0).toUpperCase()}${label.slice(1)}: ${message}`
  })
}
</script>

<div :if="open()" class="flex fixed inset-0 z-50 items-center justify-center p-4">
  <button type="button" aria-label="Close category dialog" class="absolute inset-0 bg-black/45" @click="emit('close')"></button>
  <section role="dialog" aria-modal="true" aria-labelledby="category-dialog-title" class="overflow-y-auto relative max-h-[90dvh] max-w-2xl w-full bg-white dark:bg-neutral-800 border border-gray-200 rounded-xl dark:border-neutral-700 shadow-xl">
    <form @submit.prevent="submit">
      <div class="p-6">
        <h2 id="category-dialog-title" class="font-semibold text-gray-900 text-lg dark:text-white">{{ mode() === 'edit' ? 'Edit category' : 'Add category' }}</h2>
        <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Store hierarchy fields declared by the Category model.</p>
        <ul :if="errorMessages().length > 0" class="mt-5 p-3 space-y-1 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">
          <template :for="message in errorMessages()" :key="message"><li>{{ message }}</li></template>
        </ul>
        <div class="grid gap-4 grid-cols-1 sm:grid-cols-2 mt-5">
          <label class="block"><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Name</span><input :value="name()" type="text" maxlength="50" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @input="updateName($event)" /></label>
          <label class="block"><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Slug</span><input :value="slug()" type="text" required spellcheck="false" class="mt-1 px-3 py-2 w-full font-mono text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @input="updateSlug($event)" /></label>
          <label class="block sm:col-span-2"><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Description</span><textarea :value="description()" rows="3" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @input="updateDescription($event)"></textarea></label>
          <label class="block sm:col-span-2"><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Image URL</span><input :value="imageUrl()" type="text" placeholder="Optional persisted asset URL" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @input="updateImageUrl($event)" /><span class="block mt-1 text-gray-400 text-xs dark:text-neutral-500">Use a stored asset URL. File uploads belong to the native storage workflow.</span></label>
          <label class="block"><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Parent category</span><select :value="parentCategoryId()" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @change="updateParent($event)"><option value="">Root category</option><template :for="option in parentOptions()" :key="option.id"><option :value="option.id">{{ option.name }}</option></template></select></label>
          <label class="block"><span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Display order</span><input :value="displayOrder()" type="number" min="0" step="1" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @input="updateDisplayOrder($event)" /></label>
          <label class="flex gap-3 items-center sm:col-span-2 p-3 border border-gray-200 rounded-lg dark:border-neutral-700"><input type="checkbox" :checked="isActive()" class="h-4 w-4 text-blue-600 border-gray-300 rounded" @change="updateIsActive($event)" /><span><span class="block font-medium text-gray-700 text-sm dark:text-neutral-200">Active in the storefront</span><span class="block mt-0.5 text-gray-400 text-xs dark:text-neutral-500">Availability is independent from the hierarchy.</span></span></label>
        </div>
      </div>
      <footer class="flex gap-2 justify-end px-6 py-4 bg-gray-50 dark:bg-neutral-900/50 border-gray-200 border-t dark:border-neutral-700"><button type="button" :disabled="busy()" class="px-3 py-2 font-semibold text-gray-700 text-sm dark:text-neutral-200 bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700 disabled:opacity-50" @click="emit('close')">Cancel</button><button type="submit" :disabled="busy() || !valid()" class="inline-flex items-center px-3 py-2 font-semibold text-sm text-white bg-blue-600 hover:bg-blue-500 rounded-md disabled:opacity-50"><span :if="busy()" class="mr-2 h-4 w-4 animate-spin i-hugeicons-loading-03"></span>{{ mode() === 'edit' ? 'Save category' : 'Add category' }}</button></footer>
    </form>
  </section>
</div>
