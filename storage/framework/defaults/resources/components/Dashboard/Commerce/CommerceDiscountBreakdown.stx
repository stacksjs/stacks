<script client>
import type { DiscountSummary } from '../../../../app/Actions/Dashboard/Commerce/discount-records'

/** Counted by the server over every discount, against the current time. */
const summary = useReactiveProp<DiscountSummary>('summary', {
  total: 0,
  automatic: 0,
  code: 0,
  active: 0,
  scheduled: 0,
  expired: 0,
  exhausted: 0,
  disabled: 0,
  redemptions: 0,
  byType: { percentage: 0, fixed_amount: 0, buy_x_get_y: 0, volume: 0, free_shipping: 0 },
  mostUsed: [],
})

function states(): Array<{ label: string, count: number, color: string }> {
  return [
    { label: 'Active', count: summary().active, color: 'bg-emerald-500' },
    { label: 'Scheduled', count: summary().scheduled, color: 'bg-blue-500' },
    { label: 'Used up', count: summary().exhausted, color: 'bg-amber-500' },
    { label: 'Expired', count: summary().expired, color: 'bg-gray-400' },
    { label: 'Disabled', count: summary().disabled, color: 'bg-gray-300 dark:bg-neutral-600' },
  ]
}

function width(count: number): string {
  return `${summary().total ? Math.round((count / summary().total) * 100) : 0}%`
}

function types(): Array<{ label: string, count: number }> {
  const byType = summary().byType
  return [
    { label: 'Percentage', count: byType.percentage },
    { label: 'Amount off', count: byType.fixed_amount },
    { label: 'Buy X get Y', count: byType.buy_x_get_y },
    { label: 'Volume tiers', count: byType.volume },
    { label: 'Free shipping', count: byType.free_shipping },
  ]
}

function mostUsed(): DiscountSummary['mostUsed'] {
  return summary().mostUsed ?? []
}
</script>

<section aria-label="Discount breakdowns" class="grid gap-3 grid-cols-1 lg:grid-cols-3">
  <article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
    <h2 class="font-semibold text-gray-900 text-sm dark:text-white">Right now</h2>
    <div class="mt-4 space-y-3">
      <div :for="item in states()" :key="item.label">
        <div class="flex justify-between text-xs"><span class="text-gray-500 dark:text-neutral-400">{{ item.label }}</span><span class="font-mono text-gray-700 dark:text-neutral-200">{{ item.count }}</span></div>
        <div class="mt-1 h-1.5 bg-gray-100 dark:bg-neutral-700 rounded-full"><div :class="'h-full rounded-full ' + item.color" :style="'width: ' + width(item.count)"></div></div>
      </div>
    </div>
  </article>
  <article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
    <h2 class="font-semibold text-gray-900 text-sm dark:text-white">Types</h2>
    <dl class="mt-3 divide-gray-100 divide-y dark:divide-neutral-700">
      <div :for="item in types()" :key="item.label" class="flex items-center justify-between py-2"><dt class="text-gray-500 text-sm dark:text-neutral-400">{{ item.label }}</dt><dd class="font-mono text-gray-900 text-sm dark:text-white">{{ item.count }}</dd></div>
    </dl>
  </article>
  <article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
    <h2 class="font-semibold text-gray-900 text-sm dark:text-white">Most used</h2>
    <p :if="mostUsed().length === 0" class="mt-4 text-gray-500 text-sm dark:text-neutral-400">No discount has been used yet.</p>
    <ol :else class="mt-3 divide-gray-100 divide-y dark:divide-neutral-700">
      <li :for="entry in mostUsed()" :key="entry.id" class="flex items-center justify-between py-2"><span class="text-gray-600 text-sm truncate dark:text-neutral-300">{{ entry.title }}</span><span class="ml-3 font-mono text-gray-900 text-sm dark:text-white">{{ entry.usageCount.toLocaleString() }}</span></li>
    </ol>
  </article>
</section>
