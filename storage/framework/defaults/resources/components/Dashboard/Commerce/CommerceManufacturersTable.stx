@import('../UI/Table')

<script client>
import type { ManufacturerRecord } from '../../../../app/Actions/Dashboard/Commerce/manufacturer-records'

const records = useReactiveProp('records', [] as ManufacturerRecord[])
const loading = useReactiveProp('loading', false)
/** The parent's sort select; a change hands the order back from a header sort. */
const sortResetKey = useReactiveProp<unknown>('sortResetKey', '')
const emit = defineEmits()

/**
 * `featured` becomes a flag badge beside the name rather than the starred line
 * it used to be under it. The information is the same and it reads as a table
 * column; the star is dropped because a `cell` slot cannot carry markup yet
 * (stacksjs/stx#2095, stacksjs/stx#2096).
 *
 * `createdAt` is a `date` column, and `UI/Table` now normalises SQLite's
 * space-separated timestamps the way this component used to do for itself.
 */
const COLUMNS = [
  { key: 'name', label: 'Manufacturer', sortable: true, emptyText: 'Unnamed manufacturer', class: 'min-w-48 font-medium text-gray-900 dark:text-white' },
  {
    key: 'featuredFlag',
    label: '',
    type: 'badge' as const,
    emptyText: '',
    badgeClasses: { featured: 'text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-950/40' },
    badgeLabels: { featured: 'Featured' },
    searchable: false,
  },
  { key: 'description', label: 'Description', emptyText: 'No description recorded.', class: 'max-w-md min-w-64 line-clamp-2 text-gray-500 dark:text-neutral-400' },
  { key: 'country', label: 'Country', sortable: true, emptyText: 'Not recorded', class: 'whitespace-nowrap' },
  { key: 'productCount', label: 'Products', type: 'number' as const, sortable: true, align: 'right' as const, class: 'font-mono' },
  { key: 'createdAt', label: 'Created', type: 'date' as const, sortable: true, class: 'whitespace-nowrap' },
]

const ROW_ACTIONS = [
  { action: 'edit', label: 'Edit', icon: 'i-hugeicons-edit-01' },
  { action: 'delete', label: 'Delete', icon: 'i-hugeicons-waste', class: 'text-red-500' },
]

/** A badge column maps a row field, so the flag needs one. */
const rows = derived(() => records().map(record => ({
  ...record,
  featuredFlag: record.featured ? 'featured' : '',
})))

function handleRowAction(payload: { action: string, row: ManufacturerRecord }): void {
  emit(payload.action, payload.row)
}
</script>

{{--
  No `searchable` or `filterable`: the parent dashboard already owns the
  search box and the filter selects, and a second set inside the table would
  duplicate them. Paging is what was missing, and Table brings it.
--}}
<Table
  :sort-reset-key="sortResetKey()"
  :columns="COLUMNS"
  :data="rows()"
  :loading="loading()"
  :row-actions="ROW_ACTIONS"
  action-label-key="name"
  paginated
  :page-size="25"
  empty-title="No manufacturers found"
  empty-description="Add a manufacturer or adjust the current filters."
  @row-action="handleRowAction"
/>
