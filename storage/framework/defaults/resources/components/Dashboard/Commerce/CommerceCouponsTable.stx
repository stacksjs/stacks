<script client>
import type { CouponRecord } from '../../../../app/Actions/Dashboard/Commerce/coupon-records'

const records = useReactiveProp('records', [] as CouponRecord[])
const loading = useReactiveProp('loading', false)
const emit = defineEmits()

function statusClass(status: string): string {
  if (status === 'Active')
    return 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-300'
  if (status === 'Scheduled')
    return 'bg-blue-100 text-blue-800 dark:bg-blue-950/50 dark:text-blue-300'
  return 'bg-gray-100 text-gray-700 dark:bg-neutral-700 dark:text-neutral-300'
}

function discount(record: CouponRecord): string {
  return record.discountType === 'percentage'
    ? `${record.discountValue}%`
    : new Intl.NumberFormat(undefined, { style: 'currency', currency: 'USD' }).format(record.discountValue)
}

function date(value: string): string {
  if (!value)
    return 'No date'
  const parsed = new Date(`${value}T00:00:00`)
  return Number.isNaN(parsed.getTime())
    ? value
    : new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' }).format(parsed)
}
</script>

<div class="overflow-hidden bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
  <div :if="loading() && records().length === 0" class="flex items-center justify-center p-10 text-gray-500 text-sm dark:text-neutral-400"><span class="mr-2 h-4 w-4 animate-spin i-hugeicons-loading-03"></span>Loading coupons</div>
  <div :else-if="records().length === 0" class="p-10 text-center"><p class="font-medium text-gray-900 text-sm dark:text-white">No coupons found</p><p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Add a coupon or adjust the current filters.</p></div>
  <div :else class="overflow-x-auto">
    <table class="min-w-full divide-gray-200 divide-y dark:divide-neutral-700">
      <thead class="bg-gray-50 dark:bg-neutral-900/50"><tr>
        <th scope="col" class="px-4 py-3 font-semibold text-gray-600 text-left text-xs uppercase dark:text-neutral-400">Coupon</th>
        <th scope="col" class="px-4 py-3 font-semibold text-gray-600 text-left text-xs uppercase dark:text-neutral-400">Discount</th>
        <th scope="col" class="px-4 py-3 font-semibold text-gray-600 text-left text-xs uppercase dark:text-neutral-400">Status</th>
        <th scope="col" class="px-4 py-3 font-semibold text-gray-600 text-left text-xs uppercase dark:text-neutral-400">Availability</th>
        <th scope="col" class="px-4 py-3 font-semibold text-gray-600 text-right text-xs uppercase dark:text-neutral-400">Usage</th>
        <th scope="col" class="px-4 py-3 font-semibold text-gray-600 text-left text-xs uppercase dark:text-neutral-400">Dates</th>
        <th scope="col" class="relative px-4 py-3"><span class="sr-only">Actions</span></th>
      </tr></thead>
      <tbody class="divide-gray-100 divide-y dark:divide-neutral-700">
        <template :for="record in records()" :key="record.id">
          <tr class="hover:bg-gray-50/60 dark:hover:bg-neutral-700/40">
            <td class="px-4 py-4 min-w-56"><button type="button" class="font-mono font-semibold text-gray-900 text-left text-sm dark:text-white hover:text-blue-700 dark:hover:text-blue-300" @click="emit('view', record)">{{ record.code || 'No code' }}</button><p class="mt-1 max-w-xs text-gray-400 text-xs truncate dark:text-neutral-500">{{ record.description || 'No description recorded' }}</p></td>
            <td class="px-4 py-4 text-gray-700 text-sm whitespace-nowrap dark:text-neutral-200"><span class="font-semibold">{{ discount(record) }}</span><p class="mt-1 text-gray-400 text-xs">{{ record.discountType === 'percentage' ? 'Percentage' : 'Fixed amount' }}</p></td>
            <td class="px-4 py-4 whitespace-nowrap"><span :class="'inline-flex px-2 py-1 font-semibold text-xs rounded-full ' + statusClass(record.status)">{{ record.status }}</span></td>
            <td class="px-4 py-4 text-sm whitespace-nowrap"><span :class="record.isActive ? 'text-emerald-700 dark:text-emerald-300' : 'text-gray-500 dark:text-neutral-400'">{{ record.isActive ? 'Enabled' : 'Disabled' }}</span></td>
            <td class="px-4 py-4 font-mono text-gray-700 text-right text-sm whitespace-nowrap dark:text-neutral-200">{{ record.usageCount.toLocaleString() }} / {{ record.usageLimit ? record.usageLimit.toLocaleString() : 'No limit' }}</td>
            <td class="px-4 py-4 min-w-44 text-gray-500 text-sm dark:text-neutral-400"><p>{{ date(record.startDate) }}</p><p class="mt-1 text-xs">to {{ date(record.endDate) }}</p></td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <button type="button" :aria-label="'View ' + record.code" class="p-2 text-gray-400 hover:text-blue-700 dark:hover:text-blue-300 rounded-md" @click="emit('view', record)"><span class="block h-5 w-5 i-hugeicons-view"></span></button>
              <button type="button" :aria-label="'Edit ' + record.code" class="p-2 text-gray-400 hover:text-blue-700 dark:hover:text-blue-300 rounded-md" @click="emit('edit', record)"><span class="block h-5 w-5 i-hugeicons-edit-01"></span></button>
              <button type="button" :aria-label="'Delete ' + record.code" class="p-2 text-gray-400 hover:text-red-700 dark:hover:text-red-300 rounded-md" @click="emit('delete', record)"><span class="block h-5 w-5 i-hugeicons-waste"></span></button>
            </td>
          </tr>
        </template>
      </tbody>
    </table>
  </div>
</div>
