@import('../UI/Table')

<script client>
import type { PrintDeviceRecord } from '../../../../app/Actions/Dashboard/Commerce/print-device-records'

const records = useReactiveProp('records', [] as PrintDeviceRecord[])
const loading = useReactiveProp('loading', false)
/** The parent's sort select: a change hands the order back from a header sort. */
const sortResetKey = useReactiveProp<unknown>('sortResetKey', '')
/** The parent's search and filters: a change returns to the first page. */
const pageResetKey = useReactiveProp<unknown>('pageResetKey', '')
const emit = defineEmits(['view', 'edit', 'delete'])

function formatHeartbeat(value: number): string {
  if (!value)
    return 'Not recorded'
  const date = new Date(value)
  if (Number.isNaN(date.getTime()))
    return 'Not recorded'
  const elapsed = Date.now() - date.getTime()
  const minutes = Math.round(elapsed / 60000)
  if (Math.abs(minutes) < 1)
    return 'Just now'
  if (Math.abs(minutes) < 60)
    return `${Math.abs(minutes)} min ${minutes > 0 ? 'ago' : 'from now'}`
  const hours = Math.round(minutes / 60)
  if (Math.abs(hours) < 24)
    return `${Math.abs(hours)} hr ${hours > 0 ? 'ago' : 'from now'}`
  return new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' }).format(date)
}

/** The heartbeat reads relative to now, so it is text rather than a date column. */
const COLUMNS = [
  { key: 'nameLabel', label: 'Printer', sortable: true, subtitleKey: 'macLabel', class: 'font-medium text-gray-900 dark:text-white' },
  { key: 'location', label: 'Location', sortable: true, emptyText: 'Not recorded', class: 'whitespace-nowrap' },
  { key: 'terminal', label: 'Terminal', sortable: true, emptyText: 'Not recorded', class: 'font-mono whitespace-nowrap' },
  {
    key: 'status',
    label: 'Status',
    type: 'badge' as const,
    sortable: true,
    badgeClasses: {
      online: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-300',
      warning: 'bg-amber-100 text-amber-800 dark:bg-amber-950/50 dark:text-amber-300',
      offline: 'bg-red-100 text-red-800 dark:bg-red-950/50 dark:text-red-300',
    },
    badgeLabels: { online: 'Online', warning: 'Warning', offline: 'Offline' },
  },
  { key: 'heartbeatLabel', label: 'Last heartbeat', searchable: false, class: 'whitespace-nowrap' },
  { key: 'printCount', label: 'Prints', type: 'number' as const, sortable: true, align: 'right' as const, class: 'font-mono' },
]

const ROW_ACTIONS = [
  { action: 'view', label: 'View', icon: 'i-hugeicons-view' },
  { action: 'edit', label: 'Edit', icon: 'i-hugeicons-edit-01' },
  { action: 'delete', label: 'Delete', icon: 'i-hugeicons-waste', class: 'text-red-500' },
]

const rows = derived(() => records().map(record => ({
  ...record,
  nameLabel: record.name || 'Unnamed printer',
  macLabel: record.macAddress || 'No MAC address',
  heartbeatLabel: formatHeartbeat(record.lastPing),
})))

function handleRowAction(payload: { action: string, row: PrintDeviceRecord }): void {
  emit(payload.action, payload.row)
}
</script>

{{--
  No `searchable` or `filterable`: the parent dashboard owns the search box
  and the filter selects. Table pages the whole filtered list the parent passes.
--}}
<Table
  :sort-reset-key="sortResetKey()"
  :page-reset-key="pageResetKey()"
  :columns="COLUMNS"
  :data="rows()"
  :loading="loading()"
  :row-actions="ROW_ACTIONS"
  action-label-key="nameLabel"
  paginated
  :page-size="20"
  empty-title="No print devices found"
  empty-description="Add a printer or adjust the current filters."
  @row-action="handleRowAction"
/>
