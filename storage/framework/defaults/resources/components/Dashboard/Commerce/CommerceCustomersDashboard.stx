<script client>
import type {
  CommerceCustomerRecord,
  CommerceCustomerSummary,
} from '../../../../app/Actions/Dashboard/Commerce/commerce-customer-records'
import { DashboardApiError, dashboardApi } from '../../../../functions/dashboard-api'
import { useServerList } from '../../../../functions/dashboard-list'
import { pushToast } from '../../../../functions/toasts'
import { formatCurrency } from '@stacksjs/commerce/money'

interface CustomerIndexResponse {
  records: CommerceCustomerRecord[]
  total: number
  page: number
  summary: CommerceCustomerSummary
  currency: string
}

interface CustomerWritePayload {
  name: string
  email: string
  phone: string
  totalSpent: number
  lastOrder?: string
  status: 'Active' | 'Inactive'
  avatar: string
}

const emptySummary: CommerceCustomerSummary = {
  total: 0,
  active: 0,
  inactive: 0,
  totalSpent: 0,
  averageSpent: 0,
}
const summary = state<CommerceCustomerSummary>({ ...emptySummary })
const currency = state('USD')
const statusFilter = state('all')
const sort = state('name')
const dialogOpen = state(false)
const dialogMode = state<'add' | 'edit'>('add')
const editingRecord = state<CommerceCustomerRecord | null>(null)
const detailsRecord = state<CommerceCustomerRecord | null>(null)
const deletingRecord = state<CommerceCustomerRecord | null>(null)
const saving = state(false)
const deleting = state(false)
const validationErrors = state<Record<string, string>>({})

function formatMoney(value: number): string {
  return formatCurrency(value, currency())
}

const SELECT_SORTS: Record<string, { sort: string, direction: 'asc' | 'desc' }> = {
  'name': { sort: 'name', direction: 'asc' },
  'spend-high': { sort: 'spend', direction: 'desc' },
  'recent-order': { sort: 'last-order', direction: 'desc' },
  'newest': { sort: 'newest', direction: 'desc' },
}

// The server searches, filters, sorts and pages (stacksjs/stacks#3218), where
// this page used to do all of that with the first 500 customers by name.
const {
  records,
  total,
  page,
  perPage,
  search,
  loading,
  loadError,
  params,
  load,
  changePage,
  changePageSize,
  changeSort,
} = useServerList<CommerceCustomerRecord>({
  fetch: query => dashboardApi<CustomerIndexResponse>(`/api/dashboard/commerce/customers?${query}`),
  defaultSort: () => SELECT_SORTS[sort()] ?? SELECT_SORTS.name!,
  columnSorts: { nameLabel: 'name', emailLabel: 'email', totalSpent: 'spend', lastOrder: 'last-order', status: 'status' },
  filters: () => ({ status: statusFilter() }),
  onLoad: (result) => {
    const data = result as CustomerIndexResponse
    summary.set(data.summary ?? { ...emptySummary })
    currency.set(data.currency || 'USD')
  },
  onError: error => pushToast('error', 'Could not load customers', { detail: error instanceof Error ? error.message : String(error) }),
})

function matchingLabel(): string {
  const count = total()
  return `${count.toLocaleString()} matching ${count === 1 ? 'customer' : 'customers'}`
}

function metricCards(): Array<{ label: string, value: string, detail: string }> {
  const current = summary()
  return [
    { label: 'Customers', value: String(current.total), detail: 'Persisted Customer records' },
    { label: 'Active', value: String(current.active), detail: `${current.inactive} inactive` },
    { label: 'Recorded spend', value: formatMoney(current.totalSpent), detail: 'Across all customers' },
    { label: 'Average spend', value: formatMoney(current.averageSpent), detail: `Configured in ${currency()}` },
  ]
}

/** Every matching customer as CSV, built by the server, not just the page shown. */
function exportHref(): string {
  return `/api/dashboard/commerce/customers/export?${params()}`
}

function loadCustomers(): Promise<void> {
  return load()
}

function openAdd(): void {
  dialogMode.set('add')
  editingRecord.set(null)
  validationErrors.set({})
  dialogOpen.set(true)
}

function openEdit(record: CommerceCustomerRecord): void {
  detailsRecord.set(null)
  dialogMode.set('edit')
  editingRecord.set(record)
  validationErrors.set({})
  dialogOpen.set(true)
}

function closeDialog(): void {
  if (saving())
    return
  dialogOpen.set(false)
  editingRecord.set(null)
  validationErrors.set({})
}

async function saveCustomer(payload: CustomerWritePayload): Promise<void> {
  const current = editingRecord()
  const editing = dialogMode() === 'edit' && current !== null
  saving.set(true)
  validationErrors.set({})
  try {
    await dashboardApi(editing ? `/api/dashboard/commerce/customers/${current.id}` : '/api/dashboard/commerce/customers', {
      method: editing ? 'PATCH' : 'POST',
      body: payload,
    })
    dialogOpen.set(false)
    editingRecord.set(null)
    pushToast('success', editing ? 'Customer updated' : 'Customer added')
    await loadCustomers()
  }
  catch (error) {
    if (error instanceof DashboardApiError)
      validationErrors.set(error.fields ?? {})
    pushToast('error', 'Could not save customer', {
      detail: error instanceof Error ? error.message : String(error),
    })
  }
  finally {
    saving.set(false)
  }
}

function openDetails(record: CommerceCustomerRecord): void {
  detailsRecord.set(record)
}

function closeDetails(): void {
  detailsRecord.set(null)
}

function openDelete(record: CommerceCustomerRecord): void {
  deletingRecord.set(record)
}

function closeDelete(): void {
  if (!deleting())
    deletingRecord.set(null)
}

async function deleteCustomer(): Promise<void> {
  const current = deletingRecord()
  if (!current)
    return
  deleting.set(true)
  try {
    await dashboardApi(`/api/dashboard/commerce/customers/${current.id}`, { method: 'DELETE' })
    deletingRecord.set(null)
    detailsRecord.set(null)
    pushToast('success', 'Customer deleted', { detail: current.name })
    await loadCustomers()
  }
  catch (error) {
    pushToast('error', 'Could not delete customer', {
      detail: error instanceof Error ? error.message : String(error),
    })
  }
  finally {
    deleting.set(false)
  }
}

onMount(() => {
  void loadCustomers()
})
</script>

<div class="space-y-6">
  <PageHeader title="Customers" description="Manage native Customer records, contact details, status, and recorded spend.">
  <div class="flex flex-wrap gap-2">
    <Button variant="secondary" :loading="loading()" @click="loadCustomers()"><span :if="!loading()" class="h-4 w-4 i-hugeicons-refresh"></span>Refresh</Button>
    <Button tag="a" variant="secondary" :href="exportHref()" download><span class="h-4 w-4 i-hugeicons-download-04"></span>Export filtered</Button>
    <Button @click="openAdd()"><span class="h-4 w-4 i-hugeicons-add-01"></span>Add customer</Button>
  </div>
  </PageHeader>

  <div :if="loadError()" class="p-4 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">{{ loadError() }}</div>

  <MetricCards label="Customer metrics" columns="grid-cols-2 lg:grid-cols-4" :items="metricCards()" />

  <section class="space-y-3">
    <div class="grid gap-3 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
      <label class="relative sm:col-span-2">
        <span class="sr-only">Search customers</span>
        <span class="flex absolute inset-y-0 left-0 items-center pl-3 text-gray-400 pointer-events-none"><span class="h-4 w-4 i-hugeicons-search-01"></span></span>
        <input x-model="search" type="search" placeholder="Search names, email, or phone" class="pl-9 pr-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700" />
      </label>
      <label><span class="sr-only">Customer status</span><select x-model="statusFilter" class="px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700"><option value="all">Any status</option><option value="Active">Active</option><option value="Inactive">Inactive</option></select></label>
      <label><span class="sr-only">Sort customers</span><select x-model="sort" class="px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700"><option value="name">Name</option><option value="spend-high">Highest spend</option><option value="recent-order">Most recent order</option><option value="newest">Newest record</option></select></label>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-gray-500 text-sm dark:text-neutral-400">{{ matchingLabel() }}</p>
    </div>

    <CommerceCustomersTable :sort-reset-key="sort()" :records="records()" :total="total()" :current-page="page()" :per-page="perPage()" :loading="loading()" :currency="currency()" @view="openDetails" @edit="openEdit" @delete="openDelete" @page-change="changePage" @page-size-change="changePageSize" @sort="changeSort" />
  </section>
</div>

<CommerceCustomerDialog :open="dialogOpen()" :mode="dialogMode()" :record="editingRecord()" :currency="currency()" :busy="saving()" :errors="validationErrors()" @submit="saveCustomer" @close="closeDialog()" />
<CommerceCustomerDetailsDialog :open="Boolean(detailsRecord())" :record="detailsRecord()" :currency="currency()" @edit="openEdit" @delete="openDelete" @close="closeDetails()" />
<CommerceCustomerDeleteDialog :open="Boolean(deletingRecord())" :record="deletingRecord()" :busy="deleting()" @confirm="deleteCustomer()" @close="closeDelete()" />
