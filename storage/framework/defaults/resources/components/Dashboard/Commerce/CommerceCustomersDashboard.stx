<script client>
import type {
  CommerceCustomerRecord,
  CommerceCustomerSummary,
} from '../../../../app/Actions/Dashboard/Commerce/commerce-customer-records'
import { DashboardApiError, dashboardApi } from '../../../../functions/dashboard-api'
import { pushToast } from '../../../../functions/toasts'

interface CustomerIndexResponse {
  records: CommerceCustomerRecord[]
  summary: CommerceCustomerSummary
  currency: string
}

interface CustomerWritePayload {
  name: string
  email: string
  phone: string
  totalSpent: number
  lastOrder?: string
  status: 'Active' | 'Inactive'
  avatar: string
}

const emptySummary: CommerceCustomerSummary = {
  total: 0,
  active: 0,
  inactive: 0,
  totalSpent: 0,
  averageSpent: 0,
}
const records = state<CommerceCustomerRecord[]>([])
const summary = state<CommerceCustomerSummary>({ ...emptySummary })
const currency = state('USD')
const search = state('')
const statusFilter = state('all')
const sort = state('name')
const page = state(1)
const pageSize = 15
const loading = state(true)
const loadError = state('')
const dialogOpen = state(false)
const dialogMode = state<'add' | 'edit'>('add')
const editingRecord = state<CommerceCustomerRecord | null>(null)
const detailsRecord = state<CommerceCustomerRecord | null>(null)
const deletingRecord = state<CommerceCustomerRecord | null>(null)
const saving = state(false)
const deleting = state(false)
const validationErrors = state<Record<string, string>>({})

function timestamp(value: string): number {
  if (!value)
    return 0
  const normalized = /^\d{4}-\d{2}-\d{2} \d/.test(value)
    ? `${value.replace(' ', 'T')}Z`
    : value
  const result = new Date(normalized).getTime()
  return Number.isFinite(result) ? result : 0
}

function formatMoney(value: number): string {
  try {
    return new Intl.NumberFormat(undefined, {
      style: 'currency',
      currency: currency(),
      maximumFractionDigits: 2,
    }).format(value)
  }
  catch {
    return `${value.toFixed(2)} ${currency()}`
  }
}

function filteredRecords(): CommerceCustomerRecord[] {
  const query = search().trim().toLowerCase()
  const selectedStatus = statusFilter()
  return [...records()]
    .filter((record) => {
      if (selectedStatus !== 'all' && record.status !== selectedStatus)
        return false
      return !query || [record.name, record.email, record.phone]
        .some(value => value.toLowerCase().includes(query))
    })
    .sort((left, right) => {
      if (sort() === 'spend-high')
        return right.totalSpent - left.totalSpent || left.name.localeCompare(right.name)
      if (sort() === 'recent-order')
        return timestamp(right.lastOrder) - timestamp(left.lastOrder) || left.name.localeCompare(right.name)
      if (sort() === 'newest')
        return Number(right.id) - Number(left.id)
      return left.name.localeCompare(right.name)
    })
}

function pageCount(): number {
  return Math.max(1, Math.ceil(filteredRecords().length / pageSize))
}

function visibleRecords(): CommerceCustomerRecord[] {
  const selectedPage = Math.min(page(), pageCount())
  return filteredRecords().slice((selectedPage - 1) * pageSize, selectedPage * pageSize)
}

function matchingLabel(): string {
  const count = filteredRecords().length
  return `${count} matching ${count === 1 ? 'customer' : 'customers'}`
}

function metricCards(): Array<{ label: string, value: string, detail: string }> {
  const current = summary()
  return [
    { label: 'Customers', value: String(current.total), detail: 'Persisted Customer records' },
    { label: 'Active', value: String(current.active), detail: `${current.inactive} inactive` },
    { label: 'Recorded spend', value: formatMoney(current.totalSpent), detail: 'Across all customers' },
    { label: 'Average spend', value: formatMoney(current.averageSpent), detail: `Configured in ${currency()}` },
  ]
}

function exportHref(): string {
  const rows = filteredRecords().map(record => [
    record.name,
    record.email,
    record.phone,
    record.status,
    String(record.totalSpent),
    record.lastOrder,
    record.avatar,
  ])
  const escape = (value: string): string => `"${value.replaceAll('"', '""')}"`
  const csv = [
    ['Name', 'Email', 'Phone', 'Status', `Total spent (${currency()})`, 'Last order', 'Avatar URL'],
    ...rows,
  ].map(row => row.map(escape).join(',')).join('\n')
  return `data:text/csv;charset=utf-8,${encodeURIComponent(`\uFEFF${csv}`)}`
}

effect(() => {
  search()
  statusFilter()
  sort()
  page.set(1)
})

async function loadCustomers(): Promise<void> {
  loading.set(true)
  loadError.set('')
  try {
    const data = await dashboardApi<CustomerIndexResponse>('/api/dashboard/commerce/customers')
    records.set(Array.isArray(data.records) ? data.records : [])
    summary.set(data.summary ?? { ...emptySummary })
    currency.set(data.currency || 'USD')
    page.set(Math.min(page(), Math.max(1, Math.ceil((data.records?.length || 0) / pageSize))))
  }
  catch (error) {
    loadError.set('Customer records could not be loaded.')
    pushToast('error', 'Could not load customers', {
      detail: error instanceof Error ? error.message : String(error),
    })
  }
  finally {
    loading.set(false)
  }
}

function openAdd(): void {
  dialogMode.set('add')
  editingRecord.set(null)
  validationErrors.set({})
  dialogOpen.set(true)
}

function openEdit(record: CommerceCustomerRecord): void {
  detailsRecord.set(null)
  dialogMode.set('edit')
  editingRecord.set(record)
  validationErrors.set({})
  dialogOpen.set(true)
}

function closeDialog(): void {
  if (saving())
    return
  dialogOpen.set(false)
  editingRecord.set(null)
  validationErrors.set({})
}

async function saveCustomer(payload: CustomerWritePayload): Promise<void> {
  const current = editingRecord()
  const editing = dialogMode() === 'edit' && current !== null
  saving.set(true)
  validationErrors.set({})
  try {
    await dashboardApi(editing ? `/api/dashboard/commerce/customers/${current.id}` : '/api/dashboard/commerce/customers', {
      method: editing ? 'PATCH' : 'POST',
      body: payload,
    })
    dialogOpen.set(false)
    editingRecord.set(null)
    pushToast('success', editing ? 'Customer updated' : 'Customer added')
    await loadCustomers()
  }
  catch (error) {
    if (error instanceof DashboardApiError)
      validationErrors.set(error.fields ?? {})
    pushToast('error', 'Could not save customer', {
      detail: error instanceof Error ? error.message : String(error),
    })
  }
  finally {
    saving.set(false)
  }
}

function openDetails(record: CommerceCustomerRecord): void {
  detailsRecord.set(record)
}

function closeDetails(): void {
  detailsRecord.set(null)
}

function openDelete(record: CommerceCustomerRecord): void {
  deletingRecord.set(record)
}

function closeDelete(): void {
  if (!deleting())
    deletingRecord.set(null)
}

async function deleteCustomer(): Promise<void> {
  const current = deletingRecord()
  if (!current)
    return
  deleting.set(true)
  try {
    await dashboardApi(`/api/dashboard/commerce/customers/${current.id}`, { method: 'DELETE' })
    deletingRecord.set(null)
    detailsRecord.set(null)
    pushToast('success', 'Customer deleted', { detail: current.name })
    await loadCustomers()
  }
  catch (error) {
    pushToast('error', 'Could not delete customer', {
      detail: error instanceof Error ? error.message : String(error),
    })
  }
  finally {
    deleting.set(false)
  }
}

function previousPage(): void {
  page.set(Math.max(1, page() - 1))
}

function nextPage(): void {
  page.set(Math.min(pageCount(), page() + 1))
}

onMount(() => {
  void loadCustomers()
})
</script>

<div class="space-y-6">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="font-bold text-2xl text-gray-900 dark:text-white">Customers</h1>
      <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Manage native Customer records, contact details, status, and recorded spend.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <Button variant="secondary" :loading="loading()" @click="loadCustomers()"><span :if="!loading()" class="h-4 w-4 i-hugeicons-refresh"></span>Refresh</Button>
      <Button tag="a" variant="secondary" :href="exportHref()" :download="'customers-' + new Date().toISOString().slice(0, 10) + '.csv'"><span class="h-4 w-4 i-hugeicons-download-04"></span>Export filtered</Button>
      <Button @click="openAdd()"><span class="h-4 w-4 i-hugeicons-add-01"></span>Add customer</Button>
    </div>
  </header>

  <div :if="loadError()" class="p-4 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">{{ loadError() }}</div>

  <section aria-label="Customer metrics" class="grid gap-3 grid-cols-2 lg:grid-cols-4">
    <template :for="item in metricCards()" :key="item.label">
      <article class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
        <p class="text-gray-500 text-xs dark:text-neutral-400">{{ item.label }}</p>
        <p class="mt-2 font-semibold text-2xl text-gray-900 dark:text-white">{{ item.value }}</p>
        <p class="mt-1 text-gray-400 text-xs dark:text-neutral-500">{{ item.detail }}</p>
      </article>
    </template>
  </section>

  <section class="space-y-3">
    <div class="grid gap-3 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
      <label class="relative sm:col-span-2">
        <span class="sr-only">Search customers</span>
        <span class="flex absolute inset-y-0 left-0 items-center pl-3 text-gray-400 pointer-events-none"><span class="h-4 w-4 i-hugeicons-search-01"></span></span>
        <input x-model="search" type="search" placeholder="Search names, email, or phone" class="pl-9 pr-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700" />
      </label>
      <label><span class="sr-only">Customer status</span><select x-model="statusFilter" class="px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700"><option value="all">Any status</option><option value="Active">Active</option><option value="Inactive">Inactive</option><option value="Unknown">Unknown</option></select></label>
      <label><span class="sr-only">Sort customers</span><select x-model="sort" class="px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700"><option value="name">Name</option><option value="spend-high">Highest spend</option><option value="recent-order">Most recent order</option><option value="newest">Newest record</option></select></label>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-gray-500 text-sm dark:text-neutral-400">{{ matchingLabel() }}</p>
      <div class="flex gap-2 items-center">
        <Button variant="secondary" size="sm" :disabled="page() <= 1" @click="previousPage()">Previous</Button>
        <span class="text-gray-500 text-sm dark:text-neutral-400">Page {{ Math.min(page(), pageCount()) }} of {{ pageCount() }}</span>
        <Button variant="secondary" size="sm" :disabled="page() >= pageCount()" @click="nextPage()">Next</Button>
      </div>
    </div>

    <CommerceCustomersTable :records="visibleRecords()" :loading="loading()" :currency="currency()" @view="openDetails" @edit="openEdit" @delete="openDelete" />
  </section>
</div>

<CommerceCustomerDialog :open="dialogOpen()" :mode="dialogMode()" :record="editingRecord()" :currency="currency()" :busy="saving()" :errors="validationErrors()" @submit="saveCustomer" @close="closeDialog()" />
<CommerceCustomerDetailsDialog :open="Boolean(detailsRecord())" :record="detailsRecord()" :currency="currency()" @edit="openEdit" @delete="openDelete" @close="closeDetails()" />
<CommerceCustomerDeleteDialog :open="Boolean(deletingRecord())" :record="deletingRecord()" :busy="deleting()" @confirm="deleteCustomer()" @close="closeDelete()" />
