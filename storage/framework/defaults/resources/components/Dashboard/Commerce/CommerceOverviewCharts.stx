<script client>
import type { CommerceDashboardChartSeries } from '../../../../app/Actions/Dashboard/Commerce/commerce-dashboard'
import { useLazyCharts } from '../../../../views/dashboard/composables'

const series = useReactiveProp('series', {
  labels: [],
  revenue: [],
  orders: [],
} as CommerceDashboardChartSeries)
const loading = useReactiveProp('loading', false)

const colors = [
  ['rgba(37, 99, 235, 1)', 'rgba(37, 99, 235, 0.14)'],
  ['rgba(5, 150, 105, 1)', 'rgba(5, 150, 105, 0.14)'],
  ['rgba(217, 119, 6, 1)', 'rgba(217, 119, 6, 0.14)'],
  ['rgba(124, 58, 237, 1)', 'rgba(124, 58, 237, 0.14)'],
  ['rgba(220, 38, 38, 1)', 'rgba(220, 38, 38, 0.14)'],
]

const revenueData = {
  labels: [] as string[],
  datasets: [] as Array<{
    label: string
    backgroundColor: string
    borderColor: string
    borderWidth: number
    pointBackgroundColor: string
    fill: boolean
    tension: number
    data: number[]
  }>,
}
const ordersData = {
  labels: [] as string[],
  datasets: [{
    label: 'Orders',
    backgroundColor: 'rgba(5, 150, 105, 0.78)',
    borderColor: 'rgba(5, 150, 105, 1)',
    borderWidth: 1,
    borderRadius: 4,
    data: [] as number[],
  }],
}
const chartOptions = {
  responsive: true,
  maintainAspectRatio: false,
  plugins: { legend: { display: true, position: 'top' } },
  scales: {
    y: { beginAtZero: true, grid: { display: true, color: 'rgba(100, 116, 139, 0.12)' } },
    x: { grid: { display: false } },
  },
}

function hasOrders(): boolean {
  return series().orders.some(value => value > 0)
}

function syncChartData(): void {
  const current = series()
  revenueData.labels = [...current.labels]
  revenueData.datasets = current.revenue.map((dataset, index) => ({
    label: dataset.currency,
    backgroundColor: colors[index % colors.length][1],
    borderColor: colors[index % colors.length][0],
    borderWidth: 2,
    pointBackgroundColor: colors[index % colors.length][0],
    fill: true,
    tension: 0.35,
    data: [...dataset.data],
  }))
  ordersData.labels = [...current.labels]
  ordersData.datasets[0].data = [...current.orders]
}

const chartHandle = useLazyCharts(async () => {
  syncChartData()
  const { Chart, registerables } = await import('/__deps/charts.js')
  Chart.register(...registerables)
  return [
    { Chart, id: 'commerce-revenue-chart', type: 'line', data: revenueData, options: chartOptions },
    { Chart, id: 'commerce-orders-chart', type: 'bar', data: ordersData, options: { ...chartOptions, plugins: { legend: { display: false } } } },
  ]
})

effect(() => {
  series()
  syncChartData()
  chartHandle.updateAll()
})
</script>

<section aria-label="Commerce trends" class="grid gap-5 grid-cols-1 lg:grid-cols-2">
  <article class="overflow-hidden bg-white dark:bg-neutral-800 border border-gray-200 rounded-xl dark:border-neutral-700">
    <div class="p-5 border-b border-gray-100 dark:border-neutral-700">
      <h2 class="font-semibold text-base text-gray-900 dark:text-white">Net revenue</h2>
      <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Cancelled orders are excluded and currencies remain separate.</p>
    </div>
    <div class="relative p-5 h-80">
      <canvas id="commerce-revenue-chart" aria-label="Net revenue by date and currency"></canvas>
      <div :if="!loading() && !hasOrders()" class="flex absolute inset-0 items-center justify-center text-gray-500 text-sm dark:text-neutral-400 bg-white/80 dark:bg-neutral-800/80">
        No orders recorded in this range.
      </div>
    </div>
  </article>

  <article class="overflow-hidden bg-white dark:bg-neutral-800 border border-gray-200 rounded-xl dark:border-neutral-700">
    <div class="p-5 border-b border-gray-100 dark:border-neutral-700">
      <h2 class="font-semibold text-base text-gray-900 dark:text-white">Orders</h2>
      <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Recorded orders per reporting bucket.</p>
    </div>
    <div class="relative p-5 h-80">
      <canvas id="commerce-orders-chart" aria-label="Orders by date"></canvas>
      <div :if="!loading() && !hasOrders()" class="flex absolute inset-0 items-center justify-center text-gray-500 text-sm dark:text-neutral-400 bg-white/80 dark:bg-neutral-800/80">
        No orders recorded in this range.
      </div>
    </div>
  </article>
</section>
