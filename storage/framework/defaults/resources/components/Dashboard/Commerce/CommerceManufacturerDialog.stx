<script client>
import type { ManufacturerRecord } from '../../../../app/Actions/Dashboard/Commerce/manufacturer-records'

const open = useReactiveProp('open', false)
const mode = useReactiveProp('mode', 'add')
const record = useReactiveProp('record', null as ManufacturerRecord | null)
const busy = useReactiveProp('busy', false)
const emit = defineEmits()
const name = state('')
const description = state('')
const country = state('')
const featured = state(false)
let hydrationKey = ''

effect(() => {
  if (!open()) {
    hydrationKey = ''
    return
  }
  const current = record()
  const key = `${mode()}:${current?.id || 'new'}`
  if (hydrationKey === key)
    return
  hydrationKey = key
  name.set(current?.name || '')
  description.set(current?.description || '')
  country.set(current?.country || '')
  featured.set(current?.featured || false)
})

function updateName(event: Event): void {
  name.set((event.target as HTMLInputElement).value)
}

function updateDescription(event: Event): void {
  description.set((event.target as HTMLTextAreaElement).value)
}

function updateCountry(event: Event): void {
  country.set((event.target as HTMLInputElement).value)
}

function updateFeatured(event: Event): void {
  featured.set((event.target as HTMLInputElement).checked)
}

function submit(): void {
  if (!name().trim() || !country().trim())
    return
  emit('submit', {
    manufacturer: name().trim(),
    description: description().trim(),
    country: country().trim(),
    featured: featured(),
  })
}
</script>

<div :if="open()" class="flex fixed inset-0 z-50 items-center justify-center p-4">
  <button type="button" aria-label="Close manufacturer dialog" class="absolute inset-0 bg-black/45" @click="emit('close')"></button>
  <section role="dialog" aria-modal="true" aria-labelledby="manufacturer-dialog-title" class="relative max-w-lg w-full bg-white dark:bg-neutral-800 border border-gray-200 rounded-xl dark:border-neutral-700 shadow-xl">
    <form @submit.prevent="submit">
      <div class="p-6">
        <h2 id="manufacturer-dialog-title" class="font-semibold text-gray-900 text-lg dark:text-white">{{ mode() === 'edit' ? 'Edit manufacturer' : 'Add manufacturer' }}</h2>
        <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Store only fields declared by the Manufacturer model.</p>
        <div class="mt-5 space-y-4">
          <label class="block">
            <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Name</span>
            <input :value="name()" type="text" maxlength="100" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @input="updateName($event)" />
          </label>
          <label class="block">
            <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Description</span>
            <textarea :value="description()" rows="4" maxlength="2000" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @input="updateDescription($event)"></textarea>
          </label>
          <label class="block">
            <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Country</span>
            <input :value="country()" type="text" maxlength="100" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @input="updateCountry($event)" />
          </label>
          <label class="flex gap-3 items-center p-3 border border-gray-200 rounded-lg dark:border-neutral-700">
            <input type="checkbox" :checked="featured()" class="h-4 w-4 text-blue-600 border-gray-300 rounded" @change="updateFeatured($event)" />
            <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Featured manufacturer</span>
          </label>
        </div>
      </div>
      <footer class="flex gap-2 justify-end px-6 py-4 bg-gray-50 dark:bg-neutral-900/50 border-gray-200 border-t dark:border-neutral-700">
        <button type="button" :disabled="busy()" class="px-3 py-2 font-semibold text-gray-700 text-sm dark:text-neutral-200 bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700 disabled:opacity-50" @click="emit('close')">Cancel</button>
        <button type="submit" :disabled="busy() || !name().trim() || !country().trim()" class="inline-flex items-center px-3 py-2 font-semibold text-sm text-white bg-blue-600 hover:bg-blue-500 rounded-md disabled:opacity-50">
          <span :if="busy()" class="mr-2 h-4 w-4 animate-spin i-hugeicons-loading-03"></span>
          {{ mode() === 'edit' ? 'Save manufacturer' : 'Add manufacturer' }}
        </button>
      </footer>
    </form>
  </section>
</div>
