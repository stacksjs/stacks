<script client>
import type { ManufacturerRecord } from '../../../../app/Actions/Dashboard/Commerce/manufacturer-records'

const open = useReactiveProp('open', false)
const mode = useReactiveProp('mode', 'add')
const record = useReactiveProp('record', null as ManufacturerRecord | null)
const busy = useReactiveProp('busy', false)
const errors = useReactiveProp('errors', {} as Record<string, string>)
const emit = defineEmits()
const name = state('')
const description = state('')
const country = state('')
const featured = state(false)
let hydrationKey = ''

effect(() => {
  if (!open()) {
    hydrationKey = ''
    return
  }
  const current = record()
  const key = `${mode()}:${current?.id || 'new'}`
  if (hydrationKey === key)
    return
  hydrationKey = key
  name.set(current?.name || '')
  description.set(current?.description || '')
  country.set(current?.country || '')
  featured.set(current?.featured || false)
})

function submit(): void {
  if (!name().trim() || !country().trim())
    return
  emit('submit', {
    manufacturer: name().trim(),
    description: description().trim(),
    country: country().trim(),
    featured: featured(),
  })
}

function errorMessages(): string[] {
  return Object.entries(errors()).map(([field, message]) => {
    const label = field.replace(/([a-z])([A-Z])/g, '$1 $2').replaceAll('_', ' ')
    return `${label.charAt(0).toUpperCase()}${label.slice(1)}: ${message}`
  })
}
</script>

<Modal
  :isOpen="open()"
  :title="mode() === 'edit' ? 'Edit manufacturer' : 'Add manufacturer'"
  description="Store only fields declared by the Manufacturer model."
  size="md"
  @close="emit('close')"
>
    <form id="manufacturer-form" @submit.prevent="submit">
        <ul :if="errorMessages().length > 0" class="mb-5 p-3 space-y-1 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">
          <template :for="message in errorMessages()" :key="message"><li>{{ message }}</li></template>
        </ul>
        <div class="space-y-4">
          <label class="block">
            <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Name</span>
            <input x-model="name" type="text" maxlength="100" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" />
          </label>
          <label class="block">
            <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Description</span>
            <textarea x-model="description" rows="4" maxlength="2000" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700"></textarea>
          </label>
          <label class="block">
            <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Country</span>
            <input x-model="country" type="text" maxlength="100" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" />
          </label>
          <label class="flex gap-3 items-center p-3 border border-gray-200 rounded-lg dark:border-neutral-700">
            <input x-model="featured" type="checkbox" class="h-4 w-4 text-blue-600 border-gray-300 rounded" />
            <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Featured manufacturer</span>
          </label>
        </div>
    </form>
  <template #footer>
    <div class="flex gap-2 justify-end w-full">
        <Button variant="secondary" :disabled="busy()" @click="emit('close')">Cancel</Button>
        <Button type="submit" form="manufacturer-form" :loading="busy()" :disabled="!name().trim() || !country().trim()">
          {{ mode() === 'edit' ? 'Save manufacturer' : 'Add manufacturer' }}
        </Button>
    </div>
  </template>
</Modal>
