<script client>
import type {
  GiftCardRecord,
  GiftCardStatus,
  GiftCardSummary,
} from '../../../../app/Actions/Dashboard/Commerce/gift-card-records'
import { DashboardApiError, dashboardApi } from '../../../../functions/dashboard-api'
import { useServerList } from '../../../../functions/dashboard-list'
import { pushToast } from '../../../../functions/toasts'

interface GiftCardIndexResponse {
  records: GiftCardRecord[]
  total: number
  page: number
  perPage: number
  summary: GiftCardSummary
}

interface GiftCardWritePayload {
  code: string
  initialBalance: number
  currentBalance: number
  currency: string
  status: GiftCardStatus
  purchaser_id?: string
  recipient_email?: string
  recipientName?: string
  personalMessage?: string
  isDigital: boolean
  isReloadable: boolean
  isActive: boolean
  expiryDate?: number
  lastUsedDate?: number
  templateId?: string
  customerId?: number
}

const emptySummary: GiftCardSummary = {
  total: 0,
  available: 0,
  enabled: 0,
  digital: 0,
  reloadable: 0,
  statuses: { ACTIVE: 0, USED: 0, EXPIRED: 0, DEACTIVATED: 0 },
  currencies: [],
}
const summary = state<GiftCardSummary>({ ...emptySummary })
const statusFilter = state('all')
const enabledFilter = state('all')
const deliveryFilter = state('all')
const sort = state('newest')
const dialogOpen = state(false)
const dialogMode = state<'add' | 'edit'>('add')
const editingRecord = state<GiftCardRecord | null>(null)
const detailsRecord = state<GiftCardRecord | null>(null)
const deletingRecord = state<GiftCardRecord | null>(null)
const saving = state(false)
const deleting = state(false)
const validationErrors = state<Record<string, string>>({})

const SELECT_SORTS: Record<string, { sort: string, direction: 'asc' | 'desc' }> = {
  newest: { sort: 'created', direction: 'desc' },
  code: { sort: 'code', direction: 'asc' },
  balance: { sort: 'balance', direction: 'desc' },
  expiry: { sort: 'expiry', direction: 'asc' },
}

/** The table's sortable columns, as the server's sort names. */
const COLUMN_SORTS: Record<string, string> = {
  code: 'code',
  recipientLabel: 'recipient',
  currentBalance: 'balance',
  status: 'status',
  deliveryLabel: 'delivery',
  expiryDate: 'expiry',
}

// The server searches, filters, sorts and pages (stacksjs/stacks#3218), where
// this page used to do all of that with the newest 500.
const {
  records,
  total,
  page,
  perPage,
  search,
  loading,
  loadError,
  params,
  load,
  changePage,
  changePageSize,
  changeSort,
} = useServerList<GiftCardRecord>({
  fetch: query => dashboardApi<GiftCardIndexResponse>(`/api/dashboard/commerce/gift-cards?${query}`),
  defaultSort: () => SELECT_SORTS[sort()] ?? SELECT_SORTS.newest!,
  columnSorts: COLUMN_SORTS,
  filters: () => ({ status: statusFilter(), enabled: enabledFilter(), delivery: deliveryFilter() }),
  onLoad: (result) => {
    summary.set((result as GiftCardIndexResponse).summary ?? { ...emptySummary })
  },
  onError: error => pushToast('error', 'Could not load gift cards', { detail: error instanceof Error ? error.message : String(error) }),
})

function matchingLabel(): string {
  const count = total()
  return `${count.toLocaleString()} matching ${count === 1 ? 'gift card' : 'gift cards'}`
}

function metricCards(): Array<{ label: string, value: string, detail: string }> {
  const current = summary()
  return [
    { label: 'Gift cards', value: String(current.total), detail: 'Persisted GiftCard records' },
    { label: 'Available', value: String(current.available), detail: 'Enabled, active, and funded' },
    { label: 'Digital', value: String(current.digital), detail: `${current.total - current.digital} physical` },
    { label: 'Reloadable', value: String(current.reloadable), detail: `${current.enabled} enabled` },
  ]
}

/** Every matching gift card as CSV, built by the server, not just the page shown. */
function exportHref(): string {
  return `/api/dashboard/commerce/gift-cards/export?${params()}`
}

function loadGiftCards(): Promise<void> {
  return load()
}

function openAdd(): void {
  dialogMode.set('add')
  editingRecord.set(null)
  validationErrors.set({})
  dialogOpen.set(true)
}

function openEdit(record: GiftCardRecord): void {
  detailsRecord.set(null)
  dialogMode.set('edit')
  editingRecord.set(record)
  validationErrors.set({})
  dialogOpen.set(true)
}

function closeDialog(): void {
  if (saving())
    return
  dialogOpen.set(false)
  editingRecord.set(null)
  validationErrors.set({})
}

async function saveGiftCard(payload: GiftCardWritePayload): Promise<void> {
  const current = editingRecord()
  const editing = dialogMode() === 'edit' && current !== null
  saving.set(true)
  validationErrors.set({})
  try {
    await dashboardApi(editing ? `/api/dashboard/commerce/gift-cards/${current.id}` : '/api/dashboard/commerce/gift-cards', {
      method: editing ? 'PATCH' : 'POST',
      body: payload,
    })
    dialogOpen.set(false)
    editingRecord.set(null)
    pushToast('success', editing ? 'Gift card updated' : 'Gift card added')
    await loadGiftCards()
  }
  catch (error) {
    if (error instanceof DashboardApiError)
      validationErrors.set(error.fields ?? {})
    pushToast('error', 'Could not save gift card', {
      detail: error instanceof Error ? error.message : String(error),
    })
  }
  finally {
    saving.set(false)
  }
}

function openDetails(record: GiftCardRecord): void {
  detailsRecord.set(record)
}

function closeDetails(): void {
  detailsRecord.set(null)
}

function openDelete(record: GiftCardRecord): void {
  deletingRecord.set(record)
}

function closeDelete(): void {
  if (!deleting())
    deletingRecord.set(null)
}

async function deleteGiftCard(): Promise<void> {
  const current = deletingRecord()
  if (!current)
    return
  deleting.set(true)
  try {
    await dashboardApi(`/api/dashboard/commerce/gift-cards/${current.id}`, { method: 'DELETE' })
    deletingRecord.set(null)
    detailsRecord.set(null)
    pushToast('success', 'Gift card deleted', { detail: current.code })
    await loadGiftCards()
  }
  catch (error) {
    pushToast('error', 'Could not delete gift card', {
      detail: error instanceof Error ? error.message : String(error),
    })
  }
  finally {
    deleting.set(false)
  }
}

onMount(() => {
  void loadGiftCards()
})
</script>

<div class="flex flex-col gap-6">
  <PageHeader title="Gift Cards" description="Manage native GiftCard balances, recipients, delivery, and lifecycle state.">
  <div class="flex flex-wrap gap-2">
    <Button variant="secondary" :loading="loading()" @click="loadGiftCards()"><span :if="!loading()" class="h-4 w-4 i-hugeicons-refresh"></span>Refresh</Button>
    <Button tag="a" variant="secondary" :href="exportHref()" download><span class="h-4 w-4 i-hugeicons-download-04"></span>Export filtered</Button>
    <Button @click="openAdd()"><span class="h-4 w-4 i-hugeicons-add-01"></span>Add gift card</Button>
  </div>
  </PageHeader>

  <div :if="loadError()" class="p-4 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">{{ loadError() }}</div>

  <MetricCards label="Gift card metrics" columns="grid-cols-2 lg:grid-cols-4" :items="metricCards()" />

  <CommerceGiftCardBreakdown :summary="summary()" />

  <section class="flex flex-col gap-3">
    <div class="grid gap-3 grid-cols-1 sm:grid-cols-2 xl:grid-cols-6">
      <label class="relative sm:col-span-2">
        <span class="sr-only">Search gift cards</span>
        <span class="flex absolute inset-y-0 left-0 items-center pl-3 text-gray-400 pointer-events-none"><span class="h-4 w-4 i-hugeicons-search-01"></span></span>
        <input x-model="search" type="search" placeholder="Search codes, recipients, or purchasers" class="pl-9 pr-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700" />
      </label>
      <label><span class="sr-only">Gift card status</span><select x-model="statusFilter" class="px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700"><option value="all">All statuses</option><option value="ACTIVE">Active</option><option value="USED">Used</option><option value="EXPIRED">Expired</option><option value="DEACTIVATED">Deactivated</option></select></label>
      <label><span class="sr-only">Gift card availability</span><select x-model="enabledFilter" class="px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700"><option value="all">Any availability</option><option value="enabled">Enabled</option><option value="disabled">Disabled</option></select></label>
      <label><span class="sr-only">Gift card delivery</span><select x-model="deliveryFilter" class="px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700"><option value="all">Any delivery</option><option value="digital">Digital</option><option value="physical">Physical</option></select></label>
      <label><span class="sr-only">Sort gift cards</span><select x-model="sort" class="px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700"><option value="newest">Newest</option><option value="code">Code</option><option value="balance">Highest balance</option><option value="expiry">Expiry date</option></select></label>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-gray-500 text-sm dark:text-neutral-400">{{ matchingLabel() }}</p>
    </div>

    <CommerceGiftCardsTable :sort-reset-key="sort()" :records="records()" :total="total()" :current-page="page()" :per-page="perPage()" :loading="loading()" @view="openDetails" @edit="openEdit" @delete="openDelete" @page-change="changePage" @page-size-change="changePageSize" @sort="changeSort" />
  </section>
</div>

<CommerceGiftCardDialog :open="dialogOpen()" :mode="dialogMode()" :record="editingRecord()" :busy="saving()" :errors="validationErrors()" @submit="saveGiftCard" @close="closeDialog()" />
<CommerceGiftCardDetailsDialog :open="Boolean(detailsRecord())" :record="detailsRecord()" @edit="openEdit" @delete="openDelete" @close="closeDetails()" />
<CommerceGiftCardDeleteDialog :open="Boolean(deletingRecord())" :record="deletingRecord()" :busy="deleting()" @confirm="deleteGiftCard()" @close="closeDelete()" />
