@import('../UI/Table')

<script client>
import type { CommerceProductRecord } from '../../../../app/Actions/Dashboard/Commerce/commerce-product-records'

const records = useReactiveProp('records', [] as CommerceProductRecord[])
const loading = useReactiveProp('loading', false)
/** The parent's sort select: a change hands the order back from a header sort. */
const sortResetKey = useReactiveProp<unknown>('sortResetKey', '')
/** The parent's search and filters: a change returns to the first page. */
const pageResetKey = useReactiveProp<unknown>('pageResetKey', '')
const currency = useReactiveProp('currency', 'USD')
const emit = defineEmits(['view', 'edit', 'delete'])

function initials(name: string): string {
  return name.split(/\s+/).filter(Boolean).slice(0, 2).map(part => part[0]?.toUpperCase() || '').join('') || 'PR'
}

/**
 * The product cell is slotted for its initials, and inventory for its colour:
 * none in stock reads red. Everything else is a column option.
 */
const COLUMNS = [
  { key: 'nameLabel', label: 'Product', sortable: true, slotted: true },
  { key: 'categoryName', label: 'Relationships', sortable: true, subtitleKey: 'manufacturerName', class: 'text-gray-700 dark:text-neutral-200' },
  { key: 'price', label: 'Price', type: 'currency' as const, currencyKey: 'currency', sortable: true, class: 'font-medium whitespace-nowrap' },
  { key: 'inventoryCount', label: 'Inventory', sortable: true, slotted: true },
  {
    key: 'availability',
    label: 'Availability',
    type: 'badge' as const,
    sortable: true,
    badgeClasses: { available: 'bg-green-50 text-green-700 dark:bg-green-950/40 dark:text-green-300' },
    badgeLabels: { available: 'Available', unavailable: 'Unavailable' },
  },
  { key: 'variantsLabel', label: 'Related', subtitleKey: 'reviewsLabel', searchable: false, class: 'text-gray-500 text-xs dark:text-neutral-400' },
]

const ROW_ACTIONS = [
  { action: 'view', label: 'View product', icon: 'i-hugeicons-view' },
  { action: 'edit', label: 'Edit product', icon: 'i-hugeicons-edit-02' },
  { action: 'delete', label: 'Delete product', icon: 'i-hugeicons-delete-02', class: 'text-red-500' },
]

const rows = derived(() => records().map(record => ({
  ...record,
  currency: currency(),
  nameLabel: record.name || 'Unnamed product',
  initials: initials(record.name),
  descriptionLabel: record.description || 'No description',
  outOfStock: record.inventoryCount === 0,
  inventoryLabel: record.inventoryCount.toLocaleString(),
  prepLabel: `${record.preparationTime} min prep`,
  availability: record.isAvailable ? 'available' : 'unavailable',
  variantsLabel: `${record.variantCount} variants, ${record.unitCount} units`,
  reviewsLabel: `${record.reviewCount} reviews`,
})))

function handleRowAction(payload: { action: string, row: CommerceProductRecord }): void {
  emit(payload.action, payload.row)
}
</script>

{{--
  No `searchable` or `filterable`: the parent dashboard owns the search box
  and the filter selects. Table pages the whole filtered list the parent passes.
--}}
<Table
  :sort-reset-key="sortResetKey()"
  :page-reset-key="pageResetKey()"
  :columns="COLUMNS"
  :data="rows()"
  :loading="loading()"
  :row-actions="ROW_ACTIONS"
  action-label-key="nameLabel"
  paginated
  :page-size="10"
  empty-title="No products found"
  empty-description="Adjust the filters or add a native Product record."
  @row-action="handleRowAction"
>
  <template #cell="{ row, column }">
    <template :if="column.key === 'nameLabel'">
      <div class="flex gap-3 items-center">
        <div class="flex flex-none items-center justify-center h-9 w-9 font-semibold text-blue-700 text-xs dark:text-blue-300 bg-blue-50 dark:bg-blue-950/40 rounded-md" x-text="row.initials"></div>
        <div class="min-w-0">
          <p class="font-medium text-gray-900 text-sm dark:text-white" x-text="row.nameLabel"></p>
          <p class="mt-1 max-w-52 text-gray-400 text-xs truncate dark:text-neutral-500" x-text="row.descriptionLabel"></p>
        </div>
      </div>
    </template>
    <template :if="column.key === 'inventoryCount'">
      <p :class="'font-medium text-sm ' + (row.outOfStock ? 'text-red-600 dark:text-red-400' : 'text-gray-700 dark:text-neutral-200')" x-text="row.inventoryLabel"></p>
      <p class="mt-1 text-gray-400 text-xs dark:text-neutral-500" x-text="row.prepLabel"></p>
    </template>
  </template>
</Table>
