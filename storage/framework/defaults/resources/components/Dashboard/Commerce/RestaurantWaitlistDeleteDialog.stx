<script client>
import type { RestaurantWaitlistRecord } from '../../../../app/Actions/Dashboard/Commerce/restaurant-waitlist-records'

const open = useReactiveProp('open', false)
const record = useReactiveProp('record', null as RestaurantWaitlistRecord | null)
const busy = useReactiveProp('busy', false)
const emit = defineEmits()
</script>

<div :show="open" role="alertdialog" aria-modal="true" aria-label="Delete restaurant waitlist entry" class="fixed inset-0 overflow-y-auto z-40">
  <div class="flex items-end justify-center sm:items-center p-4 min-h-full text-center">
    <button type="button" aria-label="Close delete confirmation" class="fixed inset-0 bg-gray-950/50" :disabled="busy()" @click="emit('close')"></button>
    <div class="relative p-5 sm:p-6 sm:max-w-md sm:w-full text-left bg-white dark:bg-neutral-800 border border-gray-200 rounded-xl dark:border-neutral-700 shadow-xl">
      <div class="flex items-center justify-center h-10 w-10 text-red-700 dark:text-red-300 bg-red-50 dark:bg-red-950/30 rounded-full">
        <span class="h-5 w-5 i-hugeicons-waste"></span>
      </div>
      <h2 class="mt-4 font-semibold text-gray-900 text-lg dark:text-white">Delete waitlist party?</h2>
      <p class="mt-2 text-gray-500 text-sm dark:text-neutral-400">
        {{ record()?.name || 'This party' }} will be permanently removed from the WaitlistRestaurant model.
      </p>
      <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end mt-6">
        <button type="button" :disabled="busy()" class="px-4 py-2 font-semibold text-gray-700 text-sm dark:text-neutral-200 bg-white dark:bg-neutral-700 border border-gray-300 rounded-md dark:border-neutral-600 disabled:opacity-50" @click="emit('close')">Cancel</button>
        <button type="button" :disabled="busy()" class="inline-flex items-center justify-center px-4 py-2 font-semibold text-sm text-white bg-red-600 hover:bg-red-500 rounded-md disabled:opacity-50" @click="emit('confirm')">
          <span :if="busy()" class="mr-2 h-4 w-4 animate-spin i-hugeicons-loading-03"></span>
          {{ busy() ? 'Deleting' : 'Delete party' }}
        </button>
      </div>
    </div>
  </div>
</div>
