<script client>
import type { ProductUnitRecord } from '../../../../app/Actions/Dashboard/Commerce/product-unit-records'

const records = useReactiveProp('records', [] as ProductUnitRecord[])
const loading = useReactiveProp('loading', false)
const emit = defineEmits()

function formatDate(value: string): string {
  if (!value)
    return 'Unknown'
  const date = new Date(value)
  return Number.isNaN(date.getTime())
    ? value
    : new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' }).format(date)
}
</script>

<div class="overflow-hidden bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
  <div :if="loading() && records().length === 0" class="flex items-center justify-center py-16 text-gray-500 text-sm dark:text-neutral-400">
    <span class="mr-2 h-5 w-5 animate-spin i-hugeicons-loading-03"></span>
    Loading product units
  </div>

  <div :else-if="records().length === 0" class="px-6 py-16 text-center">
    <span class="inline-block h-8 w-8 text-gray-400 i-hugeicons-package"></span>
    <p class="mt-3 font-medium text-gray-900 text-sm dark:text-white">No product units found</p>
    <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Adjust the filters or add a ProductUnit record.</p>
  </div>

  <div :else class="overflow-x-auto">
    <table class="min-w-full divide-gray-200 divide-y dark:divide-neutral-700">
      <thead class="bg-gray-50 dark:bg-neutral-900/50">
        <tr>
          <th scope="col" class="px-4 py-3 font-semibold text-gray-600 text-left text-xs dark:text-neutral-300">Unit</th>
          <th scope="col" class="px-4 py-3 font-semibold text-gray-600 text-left text-xs dark:text-neutral-300">Type</th>
          <th scope="col" class="px-4 py-3 font-semibold text-gray-600 text-left text-xs dark:text-neutral-300">Product</th>
          <th scope="col" class="px-4 py-3 font-semibold text-gray-600 text-left text-xs dark:text-neutral-300">Description</th>
          <th scope="col" class="px-4 py-3 font-semibold text-gray-600 text-left text-xs dark:text-neutral-300">Created</th>
          <th scope="col" class="px-4 py-3 font-semibold text-gray-600 text-right text-xs dark:text-neutral-300"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody class="divide-gray-200 divide-y dark:divide-neutral-700">
        <template :for="record in records()" :key="record.id">
          <tr class="align-top">
            <td class="px-4 py-4">
              <div class="flex gap-2 items-center">
                <p class="font-medium text-gray-900 text-sm dark:text-white">{{ record.name }}</p>
                <span :if="record.isDefault" class="px-2 py-0.5 font-medium text-emerald-700 text-xs dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/40 rounded-full">Default</span>
              </div>
              <p class="mt-1 text-gray-500 text-xs dark:text-neutral-400">{{ record.abbreviation }}</p>
            </td>
            <td class="px-4 py-4 text-gray-600 text-sm whitespace-nowrap dark:text-neutral-300">{{ record.type }}</td>
            <td class="px-4 py-4 text-gray-600 text-sm dark:text-neutral-300">{{ record.productName || 'Unassigned' }}</td>
            <td class="px-4 py-4 max-w-sm text-gray-600 text-sm dark:text-neutral-300">{{ record.description || 'No description' }}</td>
            <td class="px-4 py-4 text-gray-500 text-sm whitespace-nowrap dark:text-neutral-400">{{ formatDate(record.createdAt) }}</td>
            <td class="px-4 py-4">
              <div class="flex gap-1 justify-end">
                <Button variant="ghost" size="sm" iconOnly :ariaLabel="'Edit ' + record.name" @click="emit('edit', record)">
                  <span class="block h-4 w-4 text-blue-500 i-hugeicons-edit-01"></span>
                </Button>
                <Button variant="ghost" size="sm" iconOnly :ariaLabel="'Delete ' + record.name" @click="emit('delete', record)">
                  <span class="block h-4 w-4 text-red-500 i-hugeicons-delete-02"></span>
                </Button>
              </div>
            </td>
          </tr>
        </template>
      </tbody>
    </table>
  </div>
</div>
