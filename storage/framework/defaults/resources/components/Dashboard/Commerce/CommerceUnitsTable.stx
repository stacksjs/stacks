@import('../UI/Table')

<script client>
import type { ProductUnitRecord } from '../../../../app/Actions/Dashboard/Commerce/product-unit-records'

const records = useReactiveProp('records', [] as ProductUnitRecord[])
const loading = useReactiveProp('loading', false)
/** The parent's sort select; a change hands the order back from a header sort. */
const sortResetKey = useReactiveProp<unknown>('sortResetKey', '')
const emit = defineEmits()

/**
 * No slots. `UI/Table`'s `cell` and `actions` slots cannot be used yet -
 * slot content loses its `{{ … }}` (stacksjs/stx#2095) and `stx typecheck`
 * rejects every scoped slot prop (stacksjs/stx#2096) - so the two custom
 * cells here are expressed as column options instead: `subtitleKey` for the
 * abbreviation under the name, and a flag `badge` column for the default
 * marker.
 */
const COLUMNS = [
  { key: 'name', label: 'Unit', sortable: true, subtitleKey: 'abbreviation', class: 'font-medium text-gray-900 dark:text-white' },
  {
    key: 'defaultFlag',
    label: '',
    type: 'badge' as const,
    // A flag rather than a status: only the default unit is marked, and the
    // rest of the column stays blank.
    emptyText: '',
    badgeClasses: { default: 'text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/40' },
    badgeLabels: { default: 'Default' },
    searchable: false,
  },
  { key: 'type', label: 'Type', sortable: true, class: 'whitespace-nowrap' },
  { key: 'productName', label: 'Product', sortable: true, emptyText: 'Unassigned' },
  { key: 'description', label: 'Description', class: 'max-w-sm', emptyText: 'No description' },
  { key: 'createdAt', label: 'Created', type: 'datetime' as const, sortable: true, class: 'whitespace-nowrap' },
]

const ROW_ACTIONS = [
  { action: 'edit', label: 'Edit', icon: 'i-hugeicons-edit-01' },
  { action: 'delete', label: 'Delete', icon: 'i-hugeicons-delete-02', class: 'text-red-500' },
]

/** `defaultFlag` carries the badge value, since a badge column maps a row field. */
const rows = derived(() => records().map(record => ({
  ...record,
  defaultFlag: record.isDefault ? 'default' : '',
})))

function handleRowAction(payload: { action: string, row: ProductUnitRecord }): void {
  emit(payload.action, payload.row)
}
</script>

{{--
  No `searchable` or `filterable`: the parent dashboard already owns the
  search box and the filter selects, and a second set inside the table would
  duplicate them. Paging is what was missing, and Table brings it.
--}}
<Table
  :sort-reset-key="sortResetKey()"
  :columns="COLUMNS"
  :data="rows()"
  :loading="loading()"
  :row-actions="ROW_ACTIONS"
  action-label-key="name"
  paginated
  :page-size="25"
  empty-title="No product units found"
  empty-description="Adjust the filters or add a ProductUnit record."
  @row-action="handleRowAction"
/>
