<script client>
import type { GiftCardRecord, GiftCardStatus } from '../../../../app/Actions/Dashboard/Commerce/gift-card-records'

const { records = [], loading = false } = defineProps<{ records: GiftCardRecord[], loading?: boolean }>()
const emit = defineEmits<{
  view: [record: GiftCardRecord]
  edit: [record: GiftCardRecord]
  delete: [record: GiftCardRecord]
}>()

function money(value: number, currency: string): string {
  try {
    return new Intl.NumberFormat(undefined, { style: 'currency', currency }).format(value)
  }
  catch {
    return `${currency} ${value.toFixed(2)}`
  }
}

function date(value: string): string {
  if (!value)
    return 'No expiry'
  const parsed = new Date(value)
  return Number.isNaN(parsed.getTime()) ? value : parsed.toLocaleDateString()
}

function statusLabel(status: GiftCardStatus): string {
  return status.charAt(0) + status.slice(1).toLowerCase()
}

function statusClass(status: GiftCardStatus): string {
  if (status === 'ACTIVE')
    return 'bg-green-50 text-green-700 dark:bg-green-950/40 dark:text-green-300'
  if (status === 'USED')
    return 'bg-blue-50 text-blue-700 dark:bg-blue-950/40 dark:text-blue-300'
  if (status === 'EXPIRED')
    return 'bg-amber-50 text-amber-700 dark:bg-amber-950/40 dark:text-amber-300'
  return 'bg-gray-100 text-gray-600 dark:bg-neutral-700 dark:text-neutral-300'
}
</script>

<div class="overflow-hidden bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
  <div :if="loading" class="flex items-center justify-center py-16 text-gray-500 text-sm dark:text-neutral-400"><span class="mr-2 h-4 w-4 animate-spin i-hugeicons-loading-03"></span>Loading gift cards</div>
  <div :if="!loading && records.length === 0" class="py-16 text-center">
    <div class="mb-3 mx-auto h-8 w-8 text-gray-400 i-hugeicons-gift"></div>
    <p class="font-medium text-gray-900 text-sm dark:text-white">No gift cards found</p>
    <p class="mt-1 text-gray-500 text-xs dark:text-neutral-400">Adjust the filters or add a native GiftCard record.</p>
  </div>
  <div :if="!loading && records.length > 0" class="overflow-x-auto">
    <table class="min-w-full divide-gray-200 divide-y dark:divide-neutral-700">
      <thead class="bg-gray-50 dark:bg-neutral-900/60">
        <tr>
          <th class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wide uppercase dark:text-neutral-400">Gift card</th>
          <th class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wide uppercase dark:text-neutral-400">Recipient</th>
          <th class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wide uppercase dark:text-neutral-400">Balance</th>
          <th class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wide uppercase dark:text-neutral-400">Status</th>
          <th class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wide uppercase dark:text-neutral-400">Delivery</th>
          <th class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wide uppercase dark:text-neutral-400">Expiry</th>
          <th class="px-4 py-3"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody class="divide-gray-100 divide-y dark:divide-neutral-700">
        <template :for="record in records" :key="record.id">
          <tr class="hover:bg-gray-50/70 dark:hover:bg-neutral-900/40">
            <td class="px-4 py-3">
              <Button variant="ghost" size="xs" @click="emit('view', record)">{{ record.code }}</Button>
              <p class="mt-1 text-gray-400 text-xs dark:text-neutral-500">{{ record.currency }}</p>
            </td>
            <td class="px-4 py-3">
              <p class="text-gray-900 text-sm dark:text-white">{{ record.recipientName || 'Unassigned' }}</p>
              <p class="mt-1 max-w-52 text-gray-400 text-xs truncate dark:text-neutral-500">{{ record.recipientEmail || 'No recipient email' }}</p>
            </td>
            <td class="px-4 py-3">
              <p class="font-medium text-gray-900 text-sm dark:text-white">{{ money(record.currentBalance, record.currency) }}</p>
              <p class="mt-1 text-gray-400 text-xs dark:text-neutral-500">of {{ money(record.initialBalance, record.currency) }}</p>
            </td>
            <td class="px-4 py-3">
              <span :class="'inline-flex px-2 py-1 font-medium text-xs rounded-full ' + statusClass(record.status)">{{ statusLabel(record.status) }}</span>
              <p :class="'mt-1 text-xs ' + (record.isActive ? 'text-green-600 dark:text-green-400' : 'text-gray-400 dark:text-neutral-500')">{{ record.isActive ? 'Enabled' : 'Disabled' }}</p>
            </td>
            <td class="px-4 py-3">
              <p class="text-gray-700 text-sm dark:text-neutral-200">{{ record.isDigital ? 'Digital' : 'Physical' }}</p>
              <p class="mt-1 text-gray-400 text-xs dark:text-neutral-500">{{ record.isReloadable ? 'Reloadable' : 'Single use' }}</p>
            </td>
            <td class="px-4 py-3 text-gray-500 text-sm whitespace-nowrap dark:text-neutral-400">{{ date(record.expiryDate) }}</td>
            <td class="px-4 py-3">
              <div class="flex gap-1 justify-end">
                <Button variant="ghost" size="sm" iconOnly :ariaLabel="'View ' + record.code" @click="emit('view', record)"><span class="block h-4 w-4 text-blue-500 i-hugeicons-view"></span></Button>
                <Button variant="ghost" size="sm" iconOnly :ariaLabel="'Edit ' + record.code" @click="emit('edit', record)"><span class="block h-4 w-4 text-blue-500 i-hugeicons-edit-02"></span></Button>
                <Button variant="ghost" size="sm" iconOnly :ariaLabel="'Delete ' + record.code" @click="emit('delete', record)"><span class="block h-4 w-4 text-red-500 i-hugeicons-delete-02"></span></Button>
              </div>
            </td>
          </tr>
        </template>
      </tbody>
    </table>
  </div>
</div>
