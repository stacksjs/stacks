@import('../UI/Table')

<script client>
import type { GiftCardRecord, GiftCardStatus } from '../../../../app/Actions/Dashboard/Commerce/gift-card-records'
import { formatCurrency } from '@stacksjs/commerce/money'

const records = useReactiveProp('records', [] as GiftCardRecord[])
const loading = useReactiveProp('loading', false)
/** The parent's sort select: a change hands the order back from a header sort. */
const sortResetKey = useReactiveProp<unknown>('sortResetKey', '')
/** The parent's search and filters: a change returns to the first page. */
const pageResetKey = useReactiveProp<unknown>('pageResetKey', '')
const emit = defineEmits(['view', 'edit', 'delete'])

function statusLabel(status: GiftCardStatus): string {
  return status.charAt(0) + status.slice(1).toLowerCase()
}

/**
 * The balance is a currency column keyed on each card's own currency; the
 * initial balance beneath it is formatted here with the same helper, since
 * a subtitle is text.
 */
const COLUMNS = [
  { key: 'code', label: 'Gift card', sortable: true, subtitleKey: 'currency', class: 'font-medium text-gray-900 dark:text-white' },
  { key: 'recipientLabel', label: 'Recipient', sortable: true, subtitleKey: 'recipientEmailLabel', class: 'text-gray-900 dark:text-white' },
  { key: 'currentBalance', label: 'Balance', type: 'currency' as const, currencyKey: 'currency', sortable: true, subtitleKey: 'initialLabel', class: 'font-medium text-gray-900 dark:text-white' },
  {
    key: 'status',
    label: 'Status',
    type: 'badge' as const,
    sortable: true,
    badgeLabelKey: 'statusLabel',
    subtitleKey: 'enabledLabel',
    badgeClasses: {
      ACTIVE: 'bg-green-50 text-green-700 dark:bg-green-950/40 dark:text-green-300',
      USED: 'bg-blue-50 text-blue-700 dark:bg-blue-950/40 dark:text-blue-300',
      EXPIRED: 'bg-amber-50 text-amber-700 dark:bg-amber-950/40 dark:text-amber-300',
    },
  },
  { key: 'deliveryLabel', label: 'Delivery', sortable: true, subtitleKey: 'reloadLabel', class: 'text-gray-700 dark:text-neutral-200' },
  { key: 'expiryDate', label: 'Expiry', type: 'date' as const, sortable: true, emptyText: 'No expiry', class: 'whitespace-nowrap' },
]

const ROW_ACTIONS = [
  { action: 'view', label: 'View', icon: 'i-hugeicons-view' },
  { action: 'edit', label: 'Edit', icon: 'i-hugeicons-edit-02' },
  { action: 'delete', label: 'Delete', icon: 'i-hugeicons-delete-02', class: 'text-red-500' },
]

const rows = derived(() => records().map(record => ({
  ...record,
  recipientLabel: record.recipientName || 'Unassigned',
  recipientEmailLabel: record.recipientEmail || 'No recipient email',
  initialLabel: `of ${formatCurrency(record.initialBalance, record.currency)}`,
  statusLabel: statusLabel(record.status),
  enabledLabel: record.isActive ? 'Enabled' : 'Disabled',
  deliveryLabel: record.isDigital ? 'Digital' : 'Physical',
  reloadLabel: record.isReloadable ? 'Reloadable' : 'Single use',
})))

function handleRowAction(payload: { action: string, row: GiftCardRecord }): void {
  emit(payload.action, payload.row)
}
</script>

{{--
  No `searchable` or `filterable`: the parent dashboard owns the search box
  and the filter selects. Table pages the whole filtered list the parent passes.
--}}
<Table
  :sort-reset-key="sortResetKey()"
  :page-reset-key="pageResetKey()"
  :columns="COLUMNS"
  :data="rows()"
  :loading="loading()"
  :row-actions="ROW_ACTIONS"
  action-label-key="code"
  paginated
  :page-size="20"
  empty-title="No gift cards found"
  empty-description="Adjust the filters or add a native GiftCard record."
  @row-action="handleRowAction"
/>
