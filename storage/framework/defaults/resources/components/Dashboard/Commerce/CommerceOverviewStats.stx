<script client>
import type { CommerceDashboardStat } from '../../../../app/Actions/Dashboard/Commerce/commerce-dashboard'

const stats = useReactiveProp('stats', [] as CommerceDashboardStat[])
const loading = useReactiveProp('loading', false)

function changeClass(change: string): string {
  if (change.startsWith('+'))
    return 'text-green-600 dark:text-green-400'
  if (change.startsWith('-'))
    return 'text-red-600 dark:text-red-400'
  return 'text-gray-500 dark:text-neutral-400'
}

function changeIcon(change: string): string {
  if (change.startsWith('+'))
    return 'i-hugeicons-analytics-up'
  if (change.startsWith('-'))
    return 'i-hugeicons-analytics-down'
  return ''
}
</script>

<section aria-label="Commerce metrics" class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
  <template :if="loading() && stats().length === 0" :for="index in [1, 2, 3, 4]">
    <div :key="index" class="p-5 bg-white dark:bg-neutral-800 border border-gray-200 rounded-xl dark:border-neutral-700">
      <div class="h-4 w-28 bg-gray-100 dark:bg-neutral-700 rounded animate-pulse"></div>
      <div class="mt-3 h-8 w-36 bg-gray-100 dark:bg-neutral-700 rounded animate-pulse"></div>
      <div class="mt-3 h-3 w-24 bg-gray-100 dark:bg-neutral-700 rounded animate-pulse"></div>
    </div>
  </template>
  <template :for="stat in stats()" :key="stat.label">
    <article class="p-5 bg-white dark:bg-neutral-800 border border-gray-200 rounded-xl dark:border-neutral-700">
      <p class="font-medium text-gray-500 text-sm dark:text-neutral-400">{{ stat.label }}</p>
      <p class="mt-2 font-semibold text-2xl text-gray-900 tracking-tight dark:text-white">{{ stat.value }}</p>
      <div class="flex gap-2 items-center mt-2 min-h-5 text-xs">
        <span :if="stat.change" :class="'inline-flex items-center font-semibold ' + changeClass(stat.change)">
          <span :class="'mr-1 h-3.5 w-3.5 ' + changeIcon(stat.change)"></span>
          {{ stat.change }}
        </span>
        <span class="text-gray-500 truncate dark:text-neutral-400">{{ stat.detail }}</span>
      </div>
    </article>
  </template>
</section>
