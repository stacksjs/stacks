<script client>
import type { GiftCardRecord, GiftCardStatus } from '../../../../app/Actions/Dashboard/Commerce/gift-card-records'
import { minorToInput, moneyInputError, moneyInputStep, parseMoneyInput } from '@stacksjs/commerce/money'
import { formErrorMessages } from '../../../../functions/dashboard-form'

const open = useReactiveProp('open', false)
const mode = useReactiveProp('mode', 'add')
const record = useReactiveProp('record', null as GiftCardRecord | null)
const busy = useReactiveProp('busy', false)
const errors = useReactiveProp('errors', {} as Record<string, string>)
const emit = defineEmits(['submit', 'close'])
const code = state('')
// Balances as typed, in major units. Stored as integer minor units.
const initialBalance = state('50.00')
const currentBalance = state('50.00')
const currency = state('USD')
const status = state<GiftCardStatus>('ACTIVE')
const purchaserId = state('')
const recipientEmail = state('')
const recipientName = state('')
const personalMessage = state('')
const isDigital = state(true)
const isReloadable = state(false)
const isActive = state(true)
const expiryDate = state('')
const lastUsedDate = state('')
const templateId = state('')
const customerId = state('')
let hydrationKey = ''
let previousInitialBalance = '50.00'

function generatedCode(): string {
  const alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'
  const bytes = new Uint8Array(12)
  crypto.getRandomValues(bytes)
  return `GIFT-${[...bytes].map(value => alphabet[value % alphabet.length]).join('')}`
}

function defaultExpiry(): string {
  const date = new Date()
  date.setFullYear(date.getFullYear() + 1)
  date.setMinutes(date.getMinutes() - date.getTimezoneOffset())
  return date.toISOString().slice(0, 16)
}

function inputDateTime(value: string): string {
  if (!value)
    return ''
  const date = new Date(value)
  if (Number.isNaN(date.getTime()))
    return ''
  const local = new Date(date.getTime() - date.getTimezoneOffset() * 60_000)
  return local.toISOString().slice(0, 16)
}

effect(() => {
  if (!open()) {
    hydrationKey = ''
    return
  }
  const current = record()
  const key = `${mode()}:${current?.id || 'new'}`
  if (hydrationKey === key)
    return
  hydrationKey = key
  code.set(current?.code || generatedCode())
  const cardCurrency = current?.currency || 'USD'
  const hydratedInitialBalance = current?.initialBalance ? minorToInput(current.initialBalance, cardCurrency) : '50.00'
  initialBalance.set(hydratedInitialBalance)
  currentBalance.set(current ? minorToInput(current.currentBalance ?? current.initialBalance, cardCurrency) : hydratedInitialBalance)
  previousInitialBalance = hydratedInitialBalance
  currency.set(cardCurrency)
  status.set(current?.status || 'ACTIVE')
  purchaserId.set(current?.purchaserId || '')
  recipientEmail.set(current?.recipientEmail || '')
  recipientName.set(current?.recipientName || '')
  personalMessage.set(current?.personalMessage || '')
  isDigital.set(current?.isDigital ?? true)
  isReloadable.set(current?.isReloadable ?? false)
  isActive.set(current?.isActive ?? true)
  expiryDate.set(current?.expiryDate ? inputDateTime(current.expiryDate) : defaultExpiry())
  lastUsedDate.set(current?.lastUsedDate ? inputDateTime(current.lastUsedDate) : '')
  templateId.set(current?.templateId || '')
  customerId.set(current?.customerId || '')
})

/** What the initial balance was just changed to, as the input reports it. */
function syncCurrentBalance(next: string): void {
  if (currentBalance() === previousInitialBalance)
    currentBalance.set(next)
  previousInitialBalance = next
}

function optionalTimestamp(value: string): number | undefined {
  if (!value)
    return undefined
  const milliseconds = new Date(value).getTime()
  return Number.isNaN(milliseconds) ? undefined : Math.floor(milliseconds / 1000)
}

function optionalCustomerId(): number | undefined {
  if (!customerId().trim())
    return undefined
  const result = Number(customerId())
  return Number.isInteger(result) && result > 0 ? result : undefined
}

function balanceError(): string {
  const initialError = moneyInputError(initialBalance(), currency(), { min: 1 })
  if (initialError)
    return `Initial balance: ${initialError}`
  const currentError = moneyInputError(currentBalance(), currency())
  if (currentError)
    return `Current balance: ${currentError}`
  if (parseMoneyInput(currentBalance(), currency()) > parseMoneyInput(initialBalance(), currency()))
    return 'Current balance cannot exceed the initial balance.'
  return ''
}

function valid(): boolean {
  return Boolean(
    code().trim()
    && /^[A-Z]{3}$/.test(currency().trim().toUpperCase())
    && !balanceError()
  )
}

function submit(): void {
  if (!valid())
    return
  emit('submit', {
    code: code().trim().toUpperCase(),
    initialBalance: parseMoneyInput(initialBalance(), currency()),
    currentBalance: parseMoneyInput(currentBalance(), currency()),
    currency: currency().trim().toUpperCase(),
    status: status(),
    purchaser_id: purchaserId().trim() || undefined,
    recipient_email: recipientEmail().trim() || undefined,
    recipientName: recipientName().trim() || undefined,
    personalMessage: personalMessage().trim() || undefined,
    isDigital: isDigital(),
    isReloadable: isReloadable(),
    isActive: isActive(),
    expiryDate: optionalTimestamp(expiryDate()),
    lastUsedDate: optionalTimestamp(lastUsedDate()),
    templateId: templateId().trim() || undefined,
    customerId: optionalCustomerId(),
  })
}

function errorMessages(): string[] {
  return formErrorMessages(errors())
}
</script>

<Modal
  :isOpen="open()"
  :title="mode() === 'edit' ? 'Edit gift card' : 'Add gift card'"
  description="Store fields declared by the GiftCard model."
  size="xl"
  @close="emit('close')"
>
    <form id="gift-card-form" @submit.prevent="submit">
        <ul :if="errorMessages().length > 0" class="mb-5 p-3 space-y-1 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">
          <li :for="message in errorMessages()" :key="message">{{ message }}</li>
        </ul>
        <div class="grid gap-4 grid-cols-1 sm:grid-cols-2">
          <div class="sm:col-span-2"><Input v-model:value="code" label="Code" :maxLength="50" :required="true" :spellcheck="false" :monospace="true" class="uppercase" /></div>
          <Input v-model:value="initialBalance" label="Initial balance" type="number" min="0" :step="moneyInputStep(currency())" :required="true" @input="syncCurrentBalance($event)" />
          <Input v-model:value="currentBalance" label="Current balance" :max="initialBalance()" type="number" min="0" :step="moneyInputStep(currency())" :required="true" />
          <p :if="balanceError()" class="sm:col-span-2 -mt-2 text-red-600 text-xs dark:text-red-400">{{ balanceError() }}</p>
          <Input v-model:value="currency" label="Currency" :minLength="3" :maxLength="3" :required="true" :spellcheck="false" :monospace="true" class="uppercase" />
          <Select v-model:value="status" label="Status" placeholder="" :options="[{ value: 'ACTIVE', label: 'Active' }, { value: 'USED', label: 'Used' }, { value: 'EXPIRED', label: 'Expired' }, { value: 'DEACTIVATED', label: 'Deactivated' }]" />
          <Input v-model:value="recipientName" label="Recipient name" placeholder="Optional" />
          <Input v-model:value="recipientEmail" label="Recipient email" type="email" placeholder="Optional" />
          <div class="sm:col-span-2"><Textarea v-model:value="personalMessage" label="Personal message" :rows="3" placeholder="Optional" /></div>
          <Input v-model:value="expiryDate" label="Expiry date" type="datetime-local" />
          <Input v-model:value="lastUsedDate" label="Last used date" type="datetime-local" />
          <Input v-model:value="purchaserId" label="Purchaser ID" placeholder="Optional" :monospace="true" />
          <Input v-model:value="customerId" label="Customer ID" type="number" min="1" step="1" placeholder="Optional" />
          <div class="sm:col-span-2"><Input v-model:value="templateId" label="Template ID" placeholder="Optional" :monospace="true" /></div>
          <div class="grid gap-3 grid-cols-1 sm:col-span-2 sm:grid-cols-3">
            <div class="p-3 border border-gray-200 rounded-lg dark:border-neutral-700">
              <Toggle v-model:checked="isActive" label="Enabled" labelPosition="left" />
            </div>
            <div class="p-3 border border-gray-200 rounded-lg dark:border-neutral-700">
              <Toggle v-model:checked="isDigital" label="Digital delivery" labelPosition="left" />
            </div>
            <div class="p-3 border border-gray-200 rounded-lg dark:border-neutral-700">
              <Toggle v-model:checked="isReloadable" label="Reloadable" labelPosition="left" />
            </div>
          </div>
        </div>
    </form>
  <template #footer>
    <div class="flex gap-2 justify-end w-full">
        <Button variant="secondary" :disabled="busy()" @click="emit('close')">Cancel</Button>
        <Button type="submit" form="gift-card-form" :loading="busy()" :disabled="!valid()">{{ mode() === 'edit' ? 'Save gift card' : 'Add gift card' }}</Button>
    </div>
  </template>
</Modal>
