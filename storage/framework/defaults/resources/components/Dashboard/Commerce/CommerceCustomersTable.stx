<script client>
import type { CommerceCustomerRecord } from '../../../../app/Actions/Dashboard/Commerce/commerce-customer-records'

const records = useReactiveProp('records', [] as CommerceCustomerRecord[])
const loading = useReactiveProp('loading', false)
const currency = useReactiveProp('currency', 'USD')
const emit = defineEmits()

function formatMoney(value: number): string {
  try {
    return new Intl.NumberFormat(undefined, { style: 'currency', currency: currency() }).format(value)
  }
  catch {
    return `${value.toFixed(2)} ${currency()}`
  }
}

function formatDate(value: string): string {
  if (!value)
    return 'No order recorded'
  const normalized = /^\d{4}-\d{2}-\d{2}$/.test(value)
    ? `${value}T00:00:00`
    : /^\d{4}-\d{2}-\d{2} \d/.test(value)
      ? `${value.replace(' ', 'T')}Z`
      : value
  const date = new Date(normalized)
  return Number.isNaN(date.getTime())
    ? value
    : new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' }).format(date)
}

function statusClass(record: CommerceCustomerRecord): string {
  if (record.status === 'Active')
    return 'bg-green-50 text-green-700 dark:bg-green-950/40 dark:text-green-300'
  if (record.status === 'Inactive')
    return 'bg-gray-100 text-gray-600 dark:bg-neutral-700 dark:text-neutral-300'
  return 'bg-amber-50 text-amber-700 dark:bg-amber-950/40 dark:text-amber-300'
}
</script>

<div class="overflow-hidden bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
  <div :if="loading()" class="flex items-center justify-center py-16 text-gray-500 text-sm dark:text-neutral-400"><span class="mr-2 h-4 w-4 animate-spin i-hugeicons-loading-03"></span>Loading customers</div>
  <div :if="!loading() && records().length === 0" class="py-16 text-center">
    <div class="mb-3 mx-auto h-8 w-8 text-gray-400 i-hugeicons-user-group"></div>
    <p class="font-medium text-gray-900 text-sm dark:text-white">No customers found</p>
    <p class="mt-1 text-gray-500 text-xs dark:text-neutral-400">Adjust the filters or add a native Customer record.</p>
  </div>
  <div :if="!loading() && records().length > 0" class="overflow-x-auto">
    <table class="min-w-full divide-gray-200 divide-y dark:divide-neutral-700">
      <thead class="bg-gray-50 dark:bg-neutral-900/60"><tr><th class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wide uppercase dark:text-neutral-400">Customer</th><th class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wide uppercase dark:text-neutral-400">Contact</th><th class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wide uppercase dark:text-neutral-400">Recorded spend</th><th class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wide uppercase dark:text-neutral-400">Last order</th><th class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wide uppercase dark:text-neutral-400">Status</th><th class="px-4 py-3"><span class="sr-only">Actions</span></th></tr></thead>
      <tbody class="divide-gray-100 divide-y dark:divide-neutral-700">
        <template :for="record in records()" :key="record.id">
          <tr class="hover:bg-gray-50/70 dark:hover:bg-neutral-900/40">
            <td class="px-4 py-3"><div class="flex gap-3 items-center"><span class="flex items-center justify-center shrink-0 h-9 w-9 font-semibold text-blue-700 text-sm dark:text-blue-300 bg-blue-50 dark:bg-blue-950/40 rounded-md">{{ (record.name || '?').slice(0, 1).toUpperCase() }}</span><div class="min-w-0"><Button variant="ghost" size="xs" @click="emit('view', record)">{{ record.name || 'Unnamed customer' }}</Button><p class="mt-1 font-mono text-gray-400 text-xs dark:text-neutral-500">ID {{ record.id || 'not recorded' }}</p></div></div></td>
            <td class="px-4 py-3"><p class="text-gray-700 text-sm dark:text-neutral-200">{{ record.email || 'No email recorded' }}</p><p class="mt-1 text-gray-400 text-xs dark:text-neutral-500">{{ record.phone || 'No phone recorded' }}</p></td>
            <td class="px-4 py-3 font-medium text-gray-700 text-sm dark:text-neutral-200">{{ formatMoney(record.totalSpent) }}</td>
            <td class="px-4 py-3 text-gray-700 text-sm dark:text-neutral-200">{{ formatDate(record.lastOrder) }}</td>
            <td class="px-4 py-3"><span :class="'inline-flex px-2 py-1 font-medium text-xs rounded-full ' + statusClass(record)">{{ record.status }}</span></td>
            <td class="px-4 py-3"><div class="flex gap-1 justify-end"><Button variant="ghost" size="sm" iconOnly :ariaLabel="'View ' + record.name" @click="emit('view', record)"><span class="block h-4 w-4 text-blue-500 i-hugeicons-view"></span></Button><Button variant="ghost" size="sm" iconOnly :ariaLabel="'Edit ' + record.name" @click="emit('edit', record)"><span class="block h-4 w-4 text-blue-500 i-hugeicons-edit-02"></span></Button><Button variant="ghost" size="sm" iconOnly :ariaLabel="'Delete ' + record.name" @click="emit('delete', record)"><span class="block h-4 w-4 text-red-500 i-hugeicons-delete-02"></span></Button></div></td>
          </tr>
        </template>
      </tbody>
    </table>
  </div>
</div>
