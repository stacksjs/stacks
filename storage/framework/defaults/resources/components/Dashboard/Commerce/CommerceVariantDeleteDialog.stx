<script client>
import type { ProductVariantRecord } from '../../../../app/Actions/Dashboard/Commerce/product-variant-records'

const open = useReactiveProp('open', false)
const record = useReactiveProp('record', null as ProductVariantRecord | null)
const busy = useReactiveProp('busy', false)
const emit = defineEmits()
</script>

<div :if="open()" class="flex fixed inset-0 z-50 items-center justify-center p-4 dashboard-modal-layer">
  <button type="button" aria-label="Close delete product variant dialog" class="absolute inset-0 bg-black/45" @click="emit('close')"></button>
  <section role="dialog" aria-modal="true" aria-labelledby="product-variant-delete-title" class="relative p-6 max-w-md w-full bg-white dark:bg-neutral-800 border border-gray-200 rounded-xl dark:border-neutral-700 shadow-xl">
    <h2 id="product-variant-delete-title" class="font-semibold text-gray-900 text-lg dark:text-white">Delete product variant?</h2>
    <p class="mt-2 text-gray-600 text-sm dark:text-neutral-300"><span class="font-medium">{{ record()?.variant }}</span> will be permanently removed. <span :if="record()?.productName">The linked product {{ record()?.productName }} will remain.</span></p>
    <footer class="flex gap-2 justify-end mt-6"><Button variant="secondary" :disabled="busy()" @click="emit('close')">Cancel</Button><Button variant="danger" :loading="busy()" @click="emit('confirm')">Delete product variant</Button></footer>
  </section>
</div>
