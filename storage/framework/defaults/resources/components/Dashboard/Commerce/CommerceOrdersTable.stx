@import('../UI/Table')

<script client>
import type { CommerceOrderRecord } from '../../../../app/Actions/Dashboard/Commerce/commerce-order-records'

const records = useReactiveProp('records', [] as CommerceOrderRecord[])
const loading = useReactiveProp('loading', false)
/** The parent's sort select: a change hands the order back from a header sort. */
const sortResetKey = useReactiveProp<unknown>('sortResetKey', '')
/** The parent's search and filters: a change returns to the first page. */
const pageResetKey = useReactiveProp<unknown>('pageResetKey', '')
// One page the server chose (stacksjs/stacks#3218): it searches, filters, sorts
// and pages the orders, so this shows them as given and hands paging and
// column sorting back to the parent.
const total = useReactiveProp('total', 0)
const currentPage = useReactiveProp('currentPage', 1)
const perPage = useReactiveProp('perPage', 25)
const emit = defineEmits(['view', 'edit', 'delete', 'page-change', 'page-size-change', 'sort'])

function label(value: string): string {
  return value.replaceAll('_', ' ').toLowerCase().replace(/\b\w/g, letter => letter.toUpperCase())
}

/**
 * The pill's colour by tone rather than by status, so a status the table
 * has not named still reads as pending, as the hand-rolled pill did.
 */
function statusTone(status: string): string {
  const value = status.toUpperCase()
  if (['DELIVERED', 'COMPLETED', 'PAID'].includes(value))
    return 'done'
  if (['CANCELED', 'CANCELLED', 'REFUNDED'].includes(value))
    return 'stopped'
  if (['PREPARING', 'PROCESSING', 'READY', 'SHIPPED'].includes(value))
    return 'moving'
  return 'pending'
}

const COLUMNS = [
  { key: 'orderLabel', label: 'Order', sortable: true, subtitleKey: 'itemsLabel', class: 'font-medium text-gray-900 whitespace-nowrap dark:text-white' },
  { key: 'customerLabel', label: 'Customer', sortable: true, subtitleKey: 'customerEmail', class: 'text-gray-700 dark:text-neutral-200' },
  // Integer minor units of the order's own currency.
  { key: 'totalAmount', label: 'Total', type: 'currency' as const, currencyKey: 'currency', sortable: true, class: 'font-medium' },
  { key: 'fulfillmentLabel', label: 'Fulfillment', sortable: true, subtitleKey: 'deliveryAddress', class: 'text-gray-700 dark:text-neutral-200' },
  {
    key: 'statusTone',
    label: 'Status',
    type: 'badge' as const,
    sortable: true,
    badgeLabelKey: 'statusLabel',
    badgeClasses: {
      done: 'bg-green-50 text-green-700 dark:bg-green-950/40 dark:text-green-300',
      stopped: 'bg-red-50 text-red-700 dark:bg-red-950/40 dark:text-red-300',
      moving: 'bg-blue-50 text-blue-700 dark:bg-blue-950/40 dark:text-blue-300',
      pending: 'bg-amber-50 text-amber-700 dark:bg-amber-950/40 dark:text-amber-300',
    },
  },
  { key: 'createdAt', label: 'Created', type: 'datetime' as const, sortable: true, emptyText: 'Not recorded', class: 'whitespace-nowrap' },
]

const ROW_ACTIONS = [
  { action: 'view', label: 'View order' },
  { action: 'edit', label: 'Edit order' },
  { action: 'delete', label: 'Delete order' },
]

const rows = derived(() => records().map(record => ({
  ...record,
  orderLabel: `ORD-${record.id.padStart(5, '0')}`,
  itemsLabel: `${record.itemCount} ${record.itemCount === 1 ? 'item' : 'items'}`,
  customerLabel: record.customerName || 'Unassigned customer',
  fulfillmentLabel: label(record.orderType),
  statusTone: statusTone(record.status),
  statusLabel: label(record.status),
})))

function handleRowAction(payload: { action: string, row: CommerceOrderRecord }): void {
  emit(payload.action, payload.row)
}

function changePage(page: number): void {
  emit('page-change', page)
}

function changePageSize(size: number): void {
  emit('page-size-change', size)
}

function changeSort(sort: { key: string, direction: string }): void {
  emit('sort', sort)
}
</script>

{{--
  No `searchable` or `filterable`: the parent dashboard owns the search box
  and the filter selects, and the server pages and sorts what they match.
--}}
<Table
  :sort-reset-key="sortResetKey()"
  :page-reset-key="pageResetKey()"
  :columns="COLUMNS"
  :data="rows()"
  :loading="loading()"
  :row-actions="ROW_ACTIONS"
  action-label-key="id"
  paginated
  manual-pagination
  manual-sort
  :total="total()"
  :current-page="currentPage()"
  :page-size="perPage()"
  empty-title="No orders found"
  empty-description="Adjust the filters or add a native Order record."
  @row-action="handleRowAction"
  @page-change="changePage"
  @page-size-change="changePageSize"
  @sort="changeSort"
/>
