<script client>
import type { CommerceDashboardOrder } from '../../../../app/Actions/Dashboard/Commerce/commerce-dashboard'

const orders = useReactiveProp('orders', [] as CommerceDashboardOrder[])
const loading = useReactiveProp('loading', false)

function formatRelativeTime(value: string): string {
  if (!value)
    return 'Not recorded'
  const numeric = /^\d{10,13}$/.test(value)
    ? Number(value) * (value.length === 10 ? 1000 : 1)
    : Number.NaN
  const normalized = /^\d{4}-\d{2}-\d{2} \d/.test(value)
    ? `${value.replace(' ', 'T')}Z`
    : value
  const timestamp = Number.isFinite(numeric) ? numeric : new Date(normalized).getTime()
  if (!Number.isFinite(timestamp))
    return value
  const minutes = Math.max(0, Math.floor((Date.now() - timestamp) / 60000))
  if (minutes < 1)
    return 'Just now'
  if (minutes < 60)
    return `${minutes}m ago`
  const hours = Math.floor(minutes / 60)
  if (hours < 24)
    return `${hours}h ago`
  return `${Math.floor(hours / 24)}d ago`
}

function statusClass(status: string): string {
  const value = status.toLowerCase()
  if (['completed', 'delivered'].includes(value))
    return 'text-green-700 dark:text-green-300 bg-green-50 dark:bg-green-950/30'
  if (['processing', 'preparing'].includes(value))
    return 'text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-950/30'
  if (['canceled', 'cancelled', 'failed'].includes(value))
    return 'text-red-700 dark:text-red-300 bg-red-50 dark:bg-red-950/30'
  return 'text-gray-700 dark:text-neutral-300 bg-gray-100 dark:bg-neutral-700'
}
</script>

<section class="overflow-hidden bg-white dark:bg-neutral-800 border border-gray-200 rounded-xl dark:border-neutral-700">
  <div class="px-5 py-4 border-b border-gray-100 dark:border-neutral-700">
    <h2 class="font-semibold text-base text-gray-900 dark:text-white">Recent orders</h2>
    <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Latest orders inside the selected range.</p>
  </div>
  <div :if="loading() && orders().length === 0" class="flex items-center justify-center p-10 text-gray-500 text-sm dark:text-neutral-400">
    <span class="mr-2 h-4 w-4 animate-spin i-hugeicons-loading-03"></span>
    Loading recent orders
  </div>
  <div :else-if="orders().length === 0" class="p-10 text-center">
    <p class="font-medium text-gray-900 text-sm dark:text-white">No recent orders</p>
    <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Orders in this range will appear here.</p>
  </div>
  <div :else class="overflow-x-auto">
    <table class="min-w-full divide-gray-200 divide-y dark:divide-neutral-700">
      <thead class="bg-gray-50 dark:bg-neutral-900/50">
        <tr>
          <th scope="col" class="px-5 py-3 font-semibold text-gray-600 text-left text-xs uppercase dark:text-neutral-400">Order</th>
          <th scope="col" class="px-5 py-3 font-semibold text-gray-600 text-left text-xs uppercase dark:text-neutral-400">Customer</th>
          <th scope="col" class="px-5 py-3 font-semibold text-gray-600 text-right text-xs uppercase dark:text-neutral-400">Total</th>
          <th scope="col" class="px-5 py-3 font-semibold text-gray-600 text-left text-xs uppercase dark:text-neutral-400">Status</th>
          <th scope="col" class="px-5 py-3 font-semibold text-gray-600 text-right text-xs uppercase dark:text-neutral-400">When</th>
        </tr>
      </thead>
      <tbody class="divide-gray-100 divide-y dark:divide-neutral-700">
        <template :for="order in orders()" :key="order.id">
          <tr>
            <td class="px-5 py-3 font-medium font-mono text-gray-900 text-sm whitespace-nowrap dark:text-white">{{ order.id }}</td>
            <td class="px-5 py-3 text-gray-600 text-sm dark:text-neutral-300">{{ order.customer }}</td>
            <td class="px-5 py-3 font-medium text-gray-700 text-right text-sm whitespace-nowrap dark:text-neutral-200">{{ order.total }}</td>
            <td class="px-5 py-3">
              <span :class="'inline-flex px-2 py-1 font-medium text-xs capitalize rounded-full ' + statusClass(order.status)">{{ order.status.toLowerCase() }}</span>
            </td>
            <td class="px-5 py-3 text-gray-500 text-right text-sm whitespace-nowrap dark:text-neutral-400">{{ formatRelativeTime(order.createdAt) }}</td>
          </tr>
        </template>
      </tbody>
    </table>
  </div>
</section>
