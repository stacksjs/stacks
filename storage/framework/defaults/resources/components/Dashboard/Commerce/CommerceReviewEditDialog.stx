<script client>
import type { ReviewRecord } from '../../../../app/Actions/Dashboard/Commerce/review-records'
import { formErrorMessages } from '../../../../functions/dashboard-form'

const open = useReactiveProp('open', false)
const review = useReactiveProp('review', null as ReviewRecord | null)
const busy = useReactiveProp('busy', false)
const errors = useReactiveProp('errors', {} as Record<string, string>)
const emit = defineEmits(['submit', 'close'])
const reviewTitle = state('')
const content = state('')
// A string, so the select can hold "no rating" as well as 1 to 5.
const rating = state('5')
const approved = state(false)
const featured = state(false)
let hydratedId = ''

effect(() => {
  const current = review()
  if (!open() || !current) {
    hydratedId = ''
    return
  }
  if (hydratedId === current.id)
    return
  hydratedId = current.id
  reviewTitle.set(current.title)
  content.set(current.content)
  rating.set(current.rating === null ? '' : String(current.rating))
  approved.set(current.approved)
  featured.set(current.featured)
})

function submit(): void {
  if (!reviewTitle().trim() || !content().trim())
    return
  emit('submit', {
    title: reviewTitle().trim(),
    content: content().trim(),
    rating: rating() === '' ? null : Number(rating()),
    isApproved: approved(),
    isFeatured: featured(),
  })
}

function errorMessages(): string[] {
  return formErrorMessages(errors())
}
</script>

<Modal
  :isOpen="open()"
  title="Edit review"
  :description="`${review()?.customerName || 'Unknown customer'} on ${review()?.productName || 'Unknown product'}`"
  size="lg"
  @close="emit('close')"
>
    <form id="review-form" @submit.prevent="submit">
        <ul :if="errorMessages().length > 0" class="mb-5 p-3 space-y-1 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">
          <li :for="message in errorMessages()" :key="message">{{ message }}</li>
        </ul>

        <div class="space-y-4">
          <div>
            <Input v-model:value="reviewTitle" label="Title" :maxLength="100" :required="true" />
          </div>
          <div>
            <Textarea v-model:value="content" label="Review" :rows="6" :maxLength="2000" :required="true" />
          </div>
          <div>
            <Select v-model:value="rating" label="Rating" placeholder="" :options="[{ value: '5', label: '5 stars' }, { value: '4', label: '4 stars' }, { value: '3', label: '3 stars' }, { value: '2', label: '2 stars' }, { value: '1', label: '1 star' }, { value: '', label: 'No rating' }]" />
          </div>
          <div class="grid gap-3 grid-cols-1 sm:grid-cols-2">
            <div class="p-3 border border-gray-200 rounded-lg dark:border-neutral-700">
              <Toggle v-model:checked="approved" label="Approved" labelPosition="left" />
            </div>
            <div class="p-3 border border-gray-200 rounded-lg dark:border-neutral-700">
              <Toggle v-model:checked="featured" label="Featured" labelPosition="left" />
            </div>
          </div>
        </div>
    </form>
  <template #footer>
    <div class="flex gap-2 justify-end w-full">
        <Button variant="secondary" :disabled="busy()" @click="emit('close')">Cancel</Button>
        <Button type="submit" form="review-form" :loading="busy()" :disabled="!reviewTitle().trim() || !content().trim()">Save review</Button>
    </div>
  </template>
</Modal>
