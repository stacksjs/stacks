<script client>
import type { ReviewRecord } from '../../../../app/Actions/Dashboard/Commerce/review-records'

const open = useReactiveProp('open', false)
const review = useReactiveProp('review', null as ReviewRecord | null)
const busy = useReactiveProp('busy', false)
const emit = defineEmits()
const title = state('')
const content = state('')
const rating = state(5)
const approved = state(false)
const featured = state(false)
let hydratedId = ''

effect(() => {
  const current = review()
  if (!open() || !current) {
    hydratedId = ''
    return
  }
  if (hydratedId === current.id)
    return
  hydratedId = current.id
  title.set(current.title)
  content.set(current.content)
  rating.set(current.rating)
  approved.set(current.approved)
  featured.set(current.featured)
})

function updateTitle(event: Event): void {
  title.set((event.target as HTMLInputElement).value)
}

function updateContent(event: Event): void {
  content.set((event.target as HTMLTextAreaElement).value)
}

function updateRating(event: Event): void {
  rating.set(Number((event.target as HTMLSelectElement).value))
}

function updateApproved(event: Event): void {
  approved.set((event.target as HTMLInputElement).checked)
}

function updateFeatured(event: Event): void {
  featured.set((event.target as HTMLInputElement).checked)
}

function submit(): void {
  if (!title().trim() || !content().trim())
    return
  emit('submit', {
    title: title().trim(),
    content: content().trim(),
    rating: rating(),
    isApproved: approved(),
    isFeatured: featured(),
  })
}
</script>

<div :if="open()" class="flex fixed inset-0 z-50 items-center justify-center p-4">
  <button type="button" aria-label="Close edit review dialog" class="absolute inset-0 bg-black/45" @click="emit('close')"></button>
  <section role="dialog" aria-modal="true" aria-labelledby="review-edit-title" class="overflow-hidden relative max-w-xl w-full bg-white dark:bg-neutral-800 border border-gray-200 rounded-xl dark:border-neutral-700 shadow-xl">
    <form @submit.prevent="submit">
      <div class="p-6">
        <h2 id="review-edit-title" class="font-semibold text-gray-900 text-lg dark:text-white">Edit review</h2>
        <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">{{ review()?.customerName }} on {{ review()?.productName }}</p>

        <div class="mt-5 space-y-4">
          <label class="block">
            <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Title</span>
            <input :value="title()" type="text" maxlength="100" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @input="updateTitle($event)" />
          </label>
          <label class="block">
            <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Review</span>
            <textarea :value="content()" rows="6" maxlength="2000" required class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @input="updateContent($event)"></textarea>
          </label>
          <label class="block">
            <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Rating</span>
            <select :value="rating()" class="mt-1 px-3 py-2 w-full text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-900 border border-gray-300 rounded-md dark:border-neutral-700" @change="updateRating($event)">
              <option value="5">5 stars</option>
              <option value="4">4 stars</option>
              <option value="3">3 stars</option>
              <option value="2">2 stars</option>
              <option value="1">1 star</option>
            </select>
          </label>
          <div class="grid gap-3 grid-cols-1 sm:grid-cols-2">
            <label class="flex gap-3 items-center p-3 border border-gray-200 rounded-lg dark:border-neutral-700">
              <input type="checkbox" :checked="approved()" class="h-4 w-4 text-blue-600 border-gray-300 rounded" @change="updateApproved($event)" />
              <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Approved</span>
            </label>
            <label class="flex gap-3 items-center p-3 border border-gray-200 rounded-lg dark:border-neutral-700">
              <input type="checkbox" :checked="featured()" class="h-4 w-4 text-blue-600 border-gray-300 rounded" @change="updateFeatured($event)" />
              <span class="font-medium text-gray-700 text-sm dark:text-neutral-200">Featured</span>
            </label>
          </div>
        </div>
      </div>
      <footer class="flex gap-2 justify-end px-6 py-4 bg-gray-50 dark:bg-neutral-900/50 border-gray-200 border-t dark:border-neutral-700">
        <button type="button" :disabled="busy()" class="px-3 py-2 font-semibold text-gray-700 text-sm dark:text-neutral-200 bg-white dark:bg-neutral-800 border border-gray-300 rounded-md dark:border-neutral-700 disabled:opacity-50" @click="emit('close')">Cancel</button>
        <button type="submit" :disabled="busy() || !title().trim() || !content().trim()" class="inline-flex items-center px-3 py-2 font-semibold text-sm text-white bg-blue-600 hover:bg-blue-500 rounded-md disabled:opacity-50">
          <span :if="busy()" class="mr-2 h-4 w-4 animate-spin i-hugeicons-loading-03"></span>
          Save review
        </button>
      </footer>
    </form>
  </section>
</div>
