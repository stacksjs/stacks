@import('../UI/Input', '../UI/Button')

<script client>
const emit = defineEmits()
const title = useReactiveProp<string>('title', 'Create an account')
const subtitle = useReactiveProp<string>('subtitle', 'Get started with your free account')
const isLoading = useReactiveProp<boolean>('isLoading', false)
const error = useReactiveProp<string>('error', '')
const showLogin = useReactiveProp<boolean>('showLogin', true)
const name = state('')
const email = state('')
const password = state('')
const passwordConfirmation = state('')
const agreeToTerms = state(false)
const errors = state<Record<string, string>>({})

function computePasswordStrength(pw: string): number {
  let score = 0
  if (pw.length >= 8) score++
  if (pw.length >= 12) score++
  if (/[A-Z]/.test(pw) && /[a-z]/.test(pw)) score++
  if (/\d/.test(pw)) score++
  if (/[^A-Za-z0-9]/.test(pw)) score++
  return Math.min(4, score)
}

const passwordStrength = derived(() => computePasswordStrength(password()))
const passwordStrengthLabel = derived(() => {
  const labels = ['', 'Weak', 'Fair', 'Good', 'Strong']
  return password() ? labels[passwordStrength()] || '' : ''
})

function setFieldError(field: string, message: string): void {
  errors.set({ ...errors(), [field]: message })
}

function fieldError(field: string): string {
  return errors()[field] || ''
}

function validateEmail(): void {
  if (!email().trim())
    setFieldError('email', 'Email is required')
  else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email()))
    setFieldError('email', 'Please enter a valid email')
  else
    setFieldError('email', '')
}

function validatePassword(): void {
  if (!password())
    setFieldError('password', 'Password is required')
  else if (password().length < 8)
    setFieldError('password', 'Password must be at least 8 characters')
  else
    setFieldError('password', '')
}

function validateConfirmation(): void {
  setFieldError('passwordConfirmation', passwordConfirmation() && password() !== passwordConfirmation() ? 'Passwords do not match' : '')
}

function validateForm(): boolean {
  const newErrors: Record<string, string> = {}

  if (!name().trim())
    newErrors.name = 'Name is required'

  if (!email().trim())
    newErrors.email = 'Email is required'
  else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email()))
    newErrors.email = 'Please enter a valid email'

  if (!password())
    newErrors.password = 'Password is required'
  else if (password().length < 8)
    newErrors.password = 'Password must be at least 8 characters'

  if (password() !== passwordConfirmation())
    newErrors.passwordConfirmation = 'Passwords do not match'

  if (!agreeToTerms())
    newErrors.terms = 'You must agree to the terms'

  errors.set(newErrors)
  return Object.keys(newErrors).length === 0
}

function handleSubmit(): void {
  if (!validateForm())
    return

  emit('submit', {
    name: name(),
    email: email(),
    password: password(),
    password_confirmation: passwordConfirmation(),
  })
}
</script>
<div class="flex items-center justify-center px-4 py-12 min-h-screen">
  <div class="max-w-sm w-full">
    <!-- Logo/Brand -->
    <div class="mb-8 text-center">
      <div class="inline-flex items-center justify-center mb-4 h-12 w-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl shadow-blue-500/25 shadow-lg">
        <span class="h-7 w-7 text-white i-hugeicons-cube"></span>
      </div>
      <h1 class="font-semibold text-2xl text-neutral-900 dark:text-white">
        {{ title() }}
      </h1>
      <p class="mt-2 text-neutral-500 text-sm dark:text-neutral-400">
        {{ subtitle() }}
      </p>
    </div>

    <!-- Register Form -->
    <div class="p-6 bg-white dark:bg-neutral-900 border border-neutral-200/60 rounded-2xl dark:border-neutral-800 shadow-black/5 shadow-xl dark:shadow-black/20">
      <!-- Error Message -->
        <div :if="error()" class="mb-4 p-3 bg-red-50 dark:bg-red-900/20 border border-red-200 rounded-lg dark:border-red-800">
          <div class="flex gap-2 items-center">
            <div class="h-4 w-4 text-red-600 dark:text-red-400 i-hugeicons-alert-circle"></div>
            <p class="text-red-600 text-sm dark:text-red-400">{{ error() }}</p>
          </div>
        </div>

      <form @submit.prevent="handleSubmit">
        <!-- Name Field -->
        <div class="mb-4">
          <Input
            type="text"
            label="Full name"
            placeholder="John Doe"
            v-model:value="name"
            :error="fieldError('name')"
            required
            :disabled="isLoading()"
          />
        </div>

        <!-- Email Field -->
        <div class="mb-4">
          <Input
            type="email"
            label="Email address"
            placeholder="you@example.com"
            v-model:value="email"
            @blur="validateEmail"
            :error="fieldError('email')"
            required
            :disabled="isLoading()"
          />
        </div>

        <!-- Password Field -->
        <div class="mb-4">
          <Input
            type="password"
            label="Password"
            placeholder="At least 8 characters"
            v-model:value="password"
            @input="validatePassword"
            @blur="validatePassword"
            :error="fieldError('password')"
            required
            :disabled="isLoading()"
          />
          <!-- Password Strength Indicator -->
            <div :if="password().length > 0" class="mt-2">
              <div class="flex gap-1">
                <div class="flex-1 h-1 rounded-full" :class="passwordStrength() >= 1 ? (passwordStrength() <= 1 ? 'bg-red-500' : passwordStrength() === 2 ? 'bg-orange-500' : passwordStrength() === 3 ? 'bg-yellow-500' : 'bg-green-500') : 'bg-neutral-200 dark:bg-neutral-700'"></div>
                <div class="flex-1 h-1 rounded-full" :class="passwordStrength() >= 2 ? (passwordStrength() === 2 ? 'bg-orange-500' : passwordStrength() === 3 ? 'bg-yellow-500' : 'bg-green-500') : 'bg-neutral-200 dark:bg-neutral-700'"></div>
                <div class="flex-1 h-1 rounded-full" :class="passwordStrength() >= 3 ? (passwordStrength() === 3 ? 'bg-yellow-500' : 'bg-green-500') : 'bg-neutral-200 dark:bg-neutral-700'"></div>
                <div class="flex-1 h-1 rounded-full" :class="passwordStrength() >= 4 ? 'bg-green-500' : 'bg-neutral-200 dark:bg-neutral-700'"></div>
              </div>
              <p class="mt-1 text-xs" :class="passwordStrength() <= 1 ? 'text-red-500' : passwordStrength() === 2 ? 'text-orange-500' : passwordStrength() === 3 ? 'text-yellow-600 dark:text-yellow-400' : 'text-green-500'">
                {{ passwordStrengthLabel() }}
              </p>
            </div>
        </div>

        <!-- Confirm Password Field -->
        <div class="mb-4">
          <Input
            type="password"
            label="Confirm password"
            placeholder="Confirm your password"
            v-model:value="passwordConfirmation"
            @input="validateConfirmation"
            :error="fieldError('passwordConfirmation')"
            required
            :disabled="isLoading()"
          />
        </div>

        <!-- Terms Checkbox -->
        <div class="mb-6">
          <label class="flex gap-2 items-start cursor-pointer">
            <input
              type="checkbox"
              class="mt-0.5 h-4 w-4 text-blue-500 bg-white dark:bg-neutral-800 border-neutral-300 rounded dark:border-neutral-600 focus:ring-blue-500/40 focus:ring-offset-0"
              x-model="agreeToTerms"
              :disabled="isLoading()"
            />
            <span class="text-neutral-600 text-sm dark:text-neutral-400">
              I agree to the
              <a href="/terms" class="text-blue-600 dark:text-blue-400 hover:text-blue-500">Terms of Service</a>
              and
              <a href="/privacy" class="text-blue-600 dark:text-blue-400 hover:text-blue-500">Privacy Policy</a>
            </span>
          </label>
            <p :if="fieldError('terms')" class="mt-1 text-red-600 text-sm dark:text-red-400">{{ fieldError('terms') }}</p>
        </div>

        <!-- Submit Button -->
        <Button
          type="submit"
          variant="primary"
          size="lg"
          fullWidth
          :loading="isLoading()"
          :disabled="isLoading()"
        >
          <span :if="isLoading()">Creating account...</span>
          <span :if="!isLoading()">Create account</span>
        </Button>
      </form>

    </div>

    <!-- Login Link -->
      <p :if="showLogin()" class="mt-6 text-center text-neutral-500 text-sm dark:text-neutral-400">
        Already have an account?
        <a href="/login" class="font-medium text-blue-600 dark:text-blue-400 hover:text-blue-500 dark:hover:text-blue-300">
          Sign in
        </a>
      </p>
  </div>
</div>
