<script client>
// Imported rather than taken as a global, the way LoginDashboard and
// RegisterDashboard already import useAuth. The bare name only resolves on the
// dashboard server, so mounting this container anywhere else - such as the
// site's /forgot-password page - reached the submit handler and threw
// "dashboardApi is not defined", which the catch below then showed to the
// visitor as the reason their reset link could not be sent.
import { dashboardApi } from '../../../../functions/dashboard-api'

const isLoading = state(false)
const error = state('')
const success = state(false)

async function handleForgotPassword(data: { email: string }): Promise<void> {
  isLoading.set(true)
  error.set('')

  try {
    await dashboardApi('/password/forgot', {
      method: 'POST',
      auth: false,
      body: data,
    })
    success.set(true)
  }
  catch (err) {
    error.set(err instanceof Error ? err.message : 'Failed to send reset link')
  }
  finally {
    isLoading.set(false)
  }
}

function handleRetry(): void {
  success.set(false)
  error.set('')
}
</script>

<template>
  <ForgotPassword
    @submit="handleForgotPassword"
    @retry="handleRetry"
    :isLoading="isLoading()"
    :error="error()"
    :success="success()"
  />
</template>
