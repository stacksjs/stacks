<script client>
const isLoading = state(false)
const error = state('')
const success = state(false)

async function handleForgotPassword(data) {
  isLoading.set(true)
  error.set('')

  try {
    await dashboardApi('/password/forgot', {
      method: 'POST',
      auth: false,
      body: data,
    })
    success.set(true)
  }
  catch (err) {
    error.set(err instanceof Error ? err.message : 'Failed to send reset link')
    // eslint-disable-next-line no-console
    console.error(err)
  }
  finally {
    isLoading.set(false)
  }
}

function handleRetry(): void {
  success.set(false)
  error.set('')
}
</script>

<template>
  <ForgotPassword
    @submit="handleForgotPassword"
    @retry="handleRetry"
    :isLoading="isLoading()"
    :error="error()"
    :success="success()"
  />
</template>
