@import('../UI/Input', '../UI/Button')

{{--
  The page a mailed reset link lands on. Presentational only: it renders the
  four states the flow has and emits `submit`; ResetPasswordDashboard decides
  which state applies and talks to the API.

  States, in the order a visitor meets them:
    checking  - the token is being verified, before any field is shown
    invalid   - the token is expired, already used, or was never real
    success   - the password is changed
    (default) - the form
--}}

<script client>
const emit = defineEmits()
const title = useReactiveProp<string>('title', 'Choose a new password')
const subtitle = useReactiveProp<string>('subtitle', 'Set the password you will use to sign in')
const isLoading = useReactiveProp<boolean>('isLoading', false)
const error = useReactiveProp<string>('error', '')
const success = useReactiveProp<boolean>('success', false)
const checking = useReactiveProp<boolean>('checking', false)
const invalid = useReactiveProp<boolean>('invalid', false)
const password = state('')
const confirmation = state('')

function mismatch(): boolean {
  return confirmation().length > 0 && password() !== confirmation()
}

function canSubmit(): boolean {
  return !isLoading() && password().length > 0 && confirmation().length > 0 && !mismatch()
}

function handleSubmit(): void {
  if (!canSubmit())
    return

  emit('submit', {
    password: password(),
    password_confirmation: confirmation(),
  })
}
</script>

<div class="flex items-center justify-center px-4 py-12 min-h-screen">
  <div class="max-w-sm w-full">
    <!-- Logo/Brand -->
    <div class="mb-8 text-center">
      <div class="inline-flex items-center justify-center mb-4 h-12 w-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl shadow-blue-500/25 shadow-lg">
        <span class="h-7 w-7 text-white i-hugeicons-cube"></span>
      </div>
      <h1 class="font-semibold text-2xl text-neutral-900 dark:text-white">
        {{ title() }}
      </h1>
      <p class="mt-2 text-neutral-500 text-sm dark:text-neutral-400">
        {{ subtitle() }}
      </p>
    </div>

    <!-- Form Card -->
    <div class="p-6 bg-white dark:bg-neutral-900 border border-neutral-200/60 rounded-2xl dark:border-neutral-800 shadow-black/5 shadow-xl dark:shadow-black/20">
      <div :if="checking()">
        <div class="py-4 text-center">
          <div class="inline-flex items-center justify-center mb-4 h-12 w-12 bg-neutral-100 dark:bg-neutral-800 rounded-full">
            <div class="h-6 w-6 text-neutral-500 animate-spin i-hugeicons-loading-03"></div>
          </div>
          <p class="text-neutral-500 text-sm dark:text-neutral-400">Checking your link</p>
        </div>
      </div>

      <div :else-if="invalid()">
        <div class="py-4 text-center">
          <div class="inline-flex items-center justify-center mb-4 h-12 w-12 bg-red-100 dark:bg-red-900/30 rounded-full">
            <div class="h-6 w-6 text-red-600 dark:text-red-400 i-hugeicons-alert-circle"></div>
          </div>
          <h2 class="mb-2 font-medium text-lg text-neutral-900 dark:text-white">
            This link no longer works
          </h2>
          <p class="mb-6 text-neutral-500 text-sm dark:text-neutral-400">
            Reset links expire, and each one can be used only once. Ask for a fresh link and it will arrive in a moment.
          </p>
          <Button href="/forgot-password">
            Send a new link
          </Button>
        </div>
      </div>

      <div :else-if="success()">
        <div class="py-4 text-center">
          <div class="inline-flex items-center justify-center mb-4 h-12 w-12 bg-green-100 dark:bg-green-900/30 rounded-full">
            <div class="h-6 w-6 text-green-600 dark:text-green-400 i-hugeicons-checkmark-circle-02"></div>
          </div>
          <h2 class="mb-2 font-medium text-lg text-neutral-900 dark:text-white">
            Password changed
          </h2>
          <p class="mb-6 text-neutral-500 text-sm dark:text-neutral-400">
            You can sign in with your new password now.
          </p>
          <Button href="/login">
            Go to sign in
          </Button>
        </div>
      </div>

      <div :else>
        <div :if="error()" role="alert" class="mb-4 p-3 bg-red-50 dark:bg-red-900/20 border border-red-200 rounded-lg dark:border-red-800">
          <div class="flex gap-2 items-center">
            <div class="h-4 w-4 text-red-600 dark:text-red-400 i-hugeicons-alert-circle"></div>
            <p class="text-red-600 text-sm dark:text-red-400">{{ error() }}</p>
          </div>
        </div>

        <form @submit.prevent="handleSubmit">
          <div class="mb-4">
            <Input
              type="password"
              label="New password"
              placeholder="At least 8 characters"
              autocomplete="new-password"
              v-model:value="password"
              required
              :disabled="isLoading()"
            />
          </div>

          <div class="mb-6">
            <Input
              type="password"
              label="Confirm new password"
              placeholder="Repeat your new password"
              autocomplete="new-password"
              v-model:value="confirmation"
              :error="mismatch() ? 'Both passwords must match' : ''"
              required
              :disabled="isLoading()"
            />
          </div>

          <Button
            type="submit"
            variant="primary"
            size="lg"
            fullWidth
            :loading="isLoading()"
            :disabled="!canSubmit()"
          >
            <span :if="isLoading()">Saving...</span>
            <span :if="!isLoading()">Change password</span>
          </Button>
        </form>
      </div>
    </div>

    <!-- Back to Login -->
    <p class="mt-6 text-center text-neutral-500 text-sm dark:text-neutral-400">
      <a href="/login" class="inline-flex gap-1 items-center font-medium text-blue-600 dark:text-blue-400 hover:text-blue-500 dark:hover:text-blue-300">
        <div class="h-4 w-4 i-hugeicons-arrow-left-01"></div>
        Back to sign in
      </a>
    </p>
  </div>
</div>
