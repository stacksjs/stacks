<script client>
/**
 * Container for the mailed reset link.
 *
 * The link the framework sends is `/password/reset/{token}?email={email}`
 * (core/auth/src/password/reset.ts, overridable via
 * `config.auth.passwordReset.url`), so both halves of the credential come off
 * the URL: the token from the route, the address from the query string.
 *
 * The token is verified before any field is shown. `/password/verify-token`
 * exists for exactly this, and it means an expired link says so immediately
 * instead of after someone has chosen and typed a new password twice.
 */
import { dashboardApi } from '../../../../functions/dashboard-api'

const route = useRoute()

const checking = state(true)
const invalid = state(false)
const isLoading = state(false)
const error = state('')
const success = state(false)

function token(): string {
  return String(route.params.token || '')
}

function email(): string {
  return String(route.query.email || '')
}

async function verify(): Promise<void> {
  if (!token() || !email()) {
    checking.set(false)
    invalid.set(true)
    return
  }

  try {
    await dashboardApi('/password/verify-token', {
      method: 'POST',
      auth: false,
      body: { token: token(), email: email() },
    })
  }
  catch {
    // Any failure here is the link, not the network: a token that verifies
    // is the only thing that lets the form be worth showing.
    invalid.set(true)
  }
  finally {
    checking.set(false)
  }
}

async function handleReset(data: { password: string, password_confirmation: string }): Promise<void> {
  isLoading.set(true)
  error.set('')

  try {
    await dashboardApi('/password/reset', {
      method: 'POST',
      auth: false,
      body: {
        token: token(),
        email: email(),
        password: data.password,
        password_confirmation: data.password_confirmation,
      },
    })
    success.set(true)
  }
  catch (err) {
    error.set(err instanceof Error ? err.message : 'Could not change your password')
  }
  finally {
    isLoading.set(false)
  }
}

effect(() => {
  verify()
})
</script>

<template>
  <ResetPassword
    @submit="handleReset"
    :checking="checking()"
    :invalid="invalid()"
    :isLoading="isLoading()"
    :error="error()"
    :success="success()"
  />
</template>
