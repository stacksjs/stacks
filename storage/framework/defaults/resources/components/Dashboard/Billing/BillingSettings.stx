<script client>
import type { BillingPaymentMethod, BillingSubscription, BillingTransaction } from '../../../../functions/billing/dashboard'
import { fetchBillingOverview } from '../../../../functions/billing/dashboard'
import { useAuth } from '../../../../functions/auth'

const loading = state(true)
const authenticated = state(false)
const loadError = state('')
const unavailable = state<string[]>([])
const subscription = state<BillingSubscription | null>(null)
const paymentMethods = state<BillingPaymentMethod[]>([])
const transactions = state<BillingTransaction[]>([])

async function loadBilling(): Promise<void> {
  loading.set(true)
  loadError.set('')
  unavailable.set([])

  try {
    const auth = useAuth()
    const user = await auth.fetchAuthUser()
    authenticated.set(Boolean(user?.id))
    if (!user?.id)
      return

    const overview = await fetchBillingOverview()
    subscription.set(overview.subscription)
    paymentMethods.set(overview.paymentMethods)
    transactions.set(overview.transactions)
    unavailable.set(overview.unavailable)
  }
  catch (error) {
    loadError.set(error instanceof Error ? error.message : String(error))
  }
  finally {
    loading.set(false)
  }
}

onMount(() => { void loadBilling() })
</script>

<div class="space-y-6">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="font-semibold text-blue-600 text-xs tracking-wide uppercase dark:text-blue-400">Settings</p>
      <h1 class="mt-1 font-bold text-2xl text-gray-900 dark:text-white">Billing</h1>
      <p class="mt-1 max-w-2xl text-gray-500 text-sm dark:text-neutral-400">Inspect the active subscription, provider-backed payment methods, and persisted transaction records for the signed-in user.</p>
    </div>
    <Button :if="authenticated()" variant="secondary" :loading="loading()" @click="loadBilling()">
      <span :if="!loading()" class="h-4 w-4 i-hugeicons-refresh"></span>
      Refresh
    </Button>
  </header>

  <section :if="loading()" aria-live="polite" class="flex items-center justify-center py-20 text-gray-500 text-sm dark:text-neutral-400 bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
    <span class="mr-2 h-5 w-5 animate-spin i-hugeicons-loading-03"></span>
    Loading billing details
  </section>

  <section :else-if="!authenticated()" class="p-8 text-center bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
    <span class="inline-block h-8 w-8 text-gray-400 i-hugeicons-square-lock-02"></span>
    <h2 class="mt-3 font-semibold text-gray-900 text-lg dark:text-white">Sign in to view billing</h2>
    <p class="mt-2 mx-auto max-w-lg text-gray-500 text-sm dark:text-neutral-400">Billing APIs are scoped to the authenticated user. No account or payment data is exposed to an anonymous dashboard session.</p>
    <div class="mt-5"><Button tag="a" href="/login"><span class="h-4 w-4 i-hugeicons-login-03"></span>Sign in</Button></div>
  </section>

  <template :else>
    <div :if="loadError()" role="alert" class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between p-4 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900">
      <span>{{ loadError() }}</span>
      <Button variant="secondary" size="sm" @click="loadBilling()">Retry</Button>
    </div>

    <div :if="unavailable().length" role="status" class="p-4 text-amber-800 text-sm dark:text-amber-200 bg-amber-50 dark:bg-amber-950/30 border border-amber-200 rounded-lg dark:border-amber-900">
      <p class="font-semibold">Some provider-backed details are unavailable.</p>
      <ul class="mt-2 pl-5 space-y-1 list-disc">
        <template :for="message in unavailable()"><li>{{ message }}</li></template>
      </ul>
    </div>

    <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_minmax(22rem,0.8fr)]">
      <BillingPlanSummary :subscription="subscription()" />
      <BillingPaymentMethodsPanel :methods="paymentMethods()" />
    </div>

    <BillingTransactionHistory :transactions="transactions()" />
  </template>
</div>
