<script client>
import type { BillingTransaction } from '../../../../functions/billing/dashboard'

const transactions = useReactiveProp('transactions', [] as BillingTransaction[])

function amount(transaction: BillingTransaction): string {
  if (transaction.amount === null)
    return 'Not reported'
  return `${new Intl.NumberFormat().format(transaction.amount)} minor units`
}
</script>

<section class="overflow-hidden bg-white dark:bg-neutral-800 border border-gray-200 rounded-lg dark:border-neutral-700">
  <header class="flex items-center justify-between px-5 py-4 border-b border-gray-200 dark:border-neutral-700">
    <div>
      <h2 class="font-semibold text-base text-gray-900 dark:text-white">Transaction history</h2>
      <p class="mt-1 text-gray-500 text-xs dark:text-neutral-400">Persisted PaymentTransaction model records for this user.</p>
    </div>
    <span class="h-5 w-5 text-gray-400 i-hugeicons-transaction-history"></span>
  </header>

  <div :if="transactions().length === 0" class="px-6 py-14 text-center">
    <span class="inline-block h-7 w-7 text-gray-400 i-hugeicons-receipt-dollar"></span>
    <p class="mt-3 font-medium text-gray-900 text-sm dark:text-white">No transactions recorded</p>
    <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Successful persisted billing transactions will appear here.</p>
  </div>

  <div :else class="overflow-x-auto">
    <table class="min-w-full divide-gray-200 divide-y dark:divide-neutral-700">
      <thead class="bg-gray-50 dark:bg-neutral-900/50">
        <tr>
          <th scope="col" class="px-5 py-3 font-semibold text-gray-600 text-left text-xs dark:text-neutral-300">Transaction</th>
          <th scope="col" class="px-5 py-3 font-semibold text-gray-600 text-left text-xs dark:text-neutral-300">Type</th>
          <th scope="col" class="px-5 py-3 font-semibold text-gray-600 text-left text-xs dark:text-neutral-300">Amount</th>
          <th scope="col" class="px-5 py-3 font-semibold text-gray-600 text-left text-xs dark:text-neutral-300">Provider reference</th>
        </tr>
      </thead>
      <tbody class="divide-gray-200 divide-y dark:divide-neutral-700">
        <template :for="transaction in transactions()" :key="transaction.id">
          <tr>
            <td class="px-5 py-4 max-w-lg"><p class="font-medium text-gray-900 text-sm dark:text-white">{{ transaction.name || 'Unnamed transaction' }}</p><p :if="transaction.description" class="mt-1 text-gray-500 text-xs truncate dark:text-neutral-400">{{ transaction.description }}</p></td>
            <td class="px-5 py-4"><span class="inline-flex px-2 py-1 capitalize font-medium text-gray-700 text-xs dark:text-neutral-200 bg-gray-100 dark:bg-neutral-700 rounded-full">{{ transaction.type || 'unknown' }}</span></td>
            <td class="px-5 py-4 text-gray-700 text-sm whitespace-nowrap dark:text-neutral-200">{{ amount(transaction) }}</td>
            <td class="px-5 py-4 font-mono text-gray-500 text-xs dark:text-neutral-400">{{ transaction.providerId || 'Not reported' }}</td>
          </tr>
        </template>
      </tbody>
    </table>
  </div>
</section>
