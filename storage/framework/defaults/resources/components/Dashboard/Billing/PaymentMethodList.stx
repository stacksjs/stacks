<script>
interface PaymentMethodListProps {
  userId?: number
  paymentMethods?: any[]
  loading?: boolean
}

const { userId = 1, paymentMethods = [], loading = false } = defineProps<PaymentMethodListProps>()
</script>
<div class="mt-4">
    @if(loading)
      <slot name="loading" />
    @else
      <ul role="list" class="grid gap-6 grid-cols-1 sm:grid-cols-1 lg:grid-cols-1">
        @foreach(paymentMethods as method)
          <li class="col-span-1 bg-white border divide-gray-200 divide-y rounded-lg shadow">
            <div class="p-3 w-full">
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-4">
                  <slot name="cardBrand" />
                  <h2 class="text-gray-600 text-sm">
                    {{ method.brand }} •••• {{ method.last_four }} <br>
                    <span class="italic text-gray-500 text-xs">Expires {{ method.exp_month }} / {{ method.exp_year }}</span>
                  </h2>
                </div>

                <div class="flex justify-end space-x-4">
                  <Button
                    variant="secondary"
                    size="sm"
                    iconOnly
                    ariaLabel="Make {{ method.brand }} ending in {{ method.last_four }} the default payment method"
                    dataAction="make-default"
                    dataMethodId="{{ method.id }}"
                  >
                    <span class="text-amber-500 i-hugeicons-star"></span>
                  </Button>

                  <Button
                    variant="ghost"
                    size="sm"
                    iconOnly
                    ariaLabel="Delete {{ method.brand }} ending in {{ method.last_four }}"
                    dataAction="delete"
                    dataMethodId="{{ method.id }}"
                  >
                    <span class="text-red-500 i-hugeicons-trash"></span>
                  </Button>
                </div>
              </div>
            </div>
          </li>
        @endforeach
      </ul>
    @endif
  </div>
