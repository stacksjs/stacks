@import('../UI/Table')

<script client>
interface ErrorGroup {
  id?: string | number
  type: string
  message: string
  count: number
  status: 'unresolved' | 'resolved' | 'ignored'
  first_seen: string
  last_seen: string
  stack?: string | null
}

const errors = useReactiveProp('errors', [])
const emptyTitle = useReactiveProp('emptyTitle', 'No errors found')
const emptyDescription = useReactiveProp('emptyDescription', 'Your application is running smoothly!')
// The rows are one page the server chose (stacksjs/stacks#3195): it searches,
// filters, sorts and pages the groups, so this shows them as given and hands
// paging and sorting back to the parent.
const total = useReactiveProp('total', 0)
const loading = useReactiveProp('loading', false)
const currentPage = useReactiveProp('currentPage', 1)
const perPage = useReactiveProp('perPage', 10)
const emit = defineEmits(['view', 'resolve', 'ignore', 'unresolve', 'delete', 'row-click', 'page-change', 'page-size-change', 'sort'])

function formatRelativeTime(value: string): string {
  if (!value)
    return 'Not recorded'
  const date = new Date(value)
  if (Number.isNaN(date.getTime()))
    return value
  const seconds = Math.max(0, Math.floor((Date.now() - date.getTime()) / 1000))
  if (seconds < 60)
    return 'Just now'
  const minutes = Math.floor(seconds / 60)
  if (minutes < 60)
    return `${minutes}m ago`
  const hours = Math.floor(minutes / 60)
  if (hours < 24)
    return `${hours}h ago`
  const days = Math.floor(hours / 24)
  return days < 7 ? `${days}d ago` : date.toLocaleDateString()
}

/**
 * Last seen reads relative to now, so it is slotted rather than a datetime
 * column. Every sortable key here is one the server sorts by.
 */
const COLUMNS = [
  { key: 'type', label: 'Type', type: 'badge' as const, sortable: true },
  { key: 'message', label: 'Message', class: 'max-w-lg truncate text-neutral-700 dark:text-neutral-200' },
  { key: 'count', label: 'Count', type: 'number' as const, sortable: true, align: 'center' as const, class: 'font-semibold' },
  {
    key: 'status',
    label: 'Status',
    type: 'badge' as const,
    sortable: true,
    align: 'center' as const,
    badgeClasses: {
      unresolved: 'text-red-700 dark:text-red-300 bg-red-50 dark:bg-red-950/40',
      resolved: 'text-green-700 dark:text-green-300 bg-green-50 dark:bg-green-950/40',
      ignored: 'text-amber-700 dark:text-amber-300 bg-amber-50 dark:bg-amber-950/40',
    },
  },
  { key: 'last_seen', label: 'Last seen', sortable: true, align: 'right' as const, slotted: true },
]

/** Resolve and ignore an open error; reopen one that is resolved or ignored. */
const ROW_ACTIONS = [
  { action: 'view', label: 'View details of' },
  { action: 'resolve', label: 'Resolve', icon: 'i-hugeicons-checkmark-circle-02', class: 'text-green-500', when: { key: 'open', equals: true } },
  { action: 'ignore', label: 'Ignore', icon: 'i-hugeicons-view-off', class: 'text-amber-500', when: { key: 'open', equals: true } },
  { action: 'unresolve', label: 'Unresolve', icon: 'i-hugeicons-refresh', class: 'text-neutral-500', when: { key: 'open', equals: false } },
  { action: 'delete', label: 'Delete' },
]

const rows = derived(() => (errors() as ErrorGroup[]).map((error, index) => ({
  ...error,
  rowId: error.id ?? `${error.type}:${error.message}:${index}`,
  open: error.status === 'unresolved',
  lastSeenLabel: formatRelativeTime(error.last_seen),
  // The message, not the type: several groups share a type, and a name read out
  // for every row of one type would not say which row it acts on.
  actionName: `${error.type}: ${error.message}`,
})))

function handleRowAction(payload: { action: string, row: ErrorGroup }): void {
  emit(payload.action === 'view' ? 'row-click' : payload.action, payload.row)
}

function changePage(page: number): void {
  emit('page-change', page)
}

function changePageSize(size: number): void {
  emit('page-size-change', size)
}

function changeSort(sort: { key: string, direction: string }): void {
  emit('sort', sort)
}
</script>

<Table
  :columns="COLUMNS"
  :data="rows()"
  :loading="loading()"
  :row-actions="ROW_ACTIONS"
  action-label-key="actionName"
  row-key="rowId"
  paginated
  manual-pagination
  manual-sort
  :total="total()"
  :current-page="currentPage()"
  :page-size="perPage()"
  :empty-title="emptyTitle()"
  :empty-description="emptyDescription()"
  @row-action="handleRowAction"
  @page-change="changePage"
  @page-size-change="changePageSize"
  @sort="changeSort"
>
  <template #cell="{ row }">
    <span class="text-neutral-500 text-sm whitespace-nowrap dark:text-neutral-400" x-text="row.lastSeenLabel"></span>
  </template>
</Table>
