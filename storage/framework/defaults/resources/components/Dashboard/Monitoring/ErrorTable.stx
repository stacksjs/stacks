<script client>
interface ErrorGroup {
  id?: string | number
  type: string
  message: string
  count: number
  status: 'unresolved' | 'resolved' | 'ignored'
  first_seen: string
  last_seen: string
  stack?: string | null
}

interface SortPayload {
  column: 'type' | 'count' | 'last_seen'
  direction: 'asc' | 'desc'
}

const errors = useReactiveProp('errors', [])
const emptyTitle = useReactiveProp('emptyTitle', 'No errors found')
const emptyDescription = useReactiveProp('emptyDescription', 'Your application is running smoothly!')
const sortColumn = useReactiveProp('sortColumn', 'last_seen')
const sortDirection = useReactiveProp('sortDirection', 'desc')
const emit = defineEmits()

function rows(): ErrorGroup[] {
  return errors() as ErrorGroup[]
}

function nextSort(column: SortPayload['column']): void {
  const direction = sortColumn() === column && sortDirection() === 'desc' ? 'asc' : 'desc'
  emit('sort', { column, direction })
}

function statusClass(status: string): string {
  const classes: Record<string, string> = {
    unresolved: 'text-red-700 dark:text-red-300 bg-red-50 dark:bg-red-950/40 border-red-200 dark:border-red-900',
    resolved: 'text-green-700 dark:text-green-300 bg-green-50 dark:bg-green-950/40 border-green-200 dark:border-green-900',
    ignored: 'text-amber-700 dark:text-amber-300 bg-amber-50 dark:bg-amber-950/40 border-amber-200 dark:border-amber-900',
  }
  return classes[status] || 'text-neutral-700 dark:text-neutral-300 bg-neutral-50 dark:bg-neutral-800 border-neutral-200 dark:border-neutral-700'
}

function formatRelativeTime(value: string): string {
  if (!value)
    return 'Not recorded'
  const date = new Date(value)
  if (Number.isNaN(date.getTime()))
    return value
  const seconds = Math.max(0, Math.floor((Date.now() - date.getTime()) / 1000))
  if (seconds < 60)
    return 'Just now'
  const minutes = Math.floor(seconds / 60)
  if (minutes < 60)
    return `${minutes}m ago`
  const hours = Math.floor(minutes / 60)
  if (hours < 24)
    return `${hours}h ago`
  const days = Math.floor(hours / 24)
  return days < 7 ? `${days}d ago` : date.toLocaleDateString()
}
</script>

<div class="overflow-hidden border border-stone-200/80 rounded-xl dark:border-neutral-700">
  <div :if="rows().length === 0" class="flex flex-col items-center justify-center px-4 py-12 text-center">
    <span class="block mb-3 h-7 w-7 text-neutral-400 i-hugeicons-inbox"></span>
    <p class="font-medium text-neutral-700 text-sm dark:text-neutral-200">{{ emptyTitle() }}</p>
    <p class="mt-1 text-neutral-500 text-sm dark:text-neutral-400">{{ emptyDescription() }}</p>
  </div>

  <div :if="rows().length > 0" class="overflow-x-auto">
    <table class="w-full">
      <thead class="bg-stone-50/80 dark:bg-neutral-800/50">
        <tr>
          <th scope="col" class="pl-5 pr-4 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">
            <button type="button" class="inline-flex gap-1.5 items-center hover:text-stone-700 dark:hover:text-neutral-200" @click="nextSort('type')">
              Type
              <span class="h-3.5 w-3.5 opacity-40 i-hugeicons-arrow-up-down"></span>
            </button>
          </th>
          <th scope="col" class="px-4 py-3.5 font-semibold text-left text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">Message</th>
          <th scope="col" class="px-4 py-3.5 font-semibold text-center text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">
            <button type="button" class="inline-flex gap-1.5 items-center hover:text-stone-700 dark:hover:text-neutral-200" @click="nextSort('count')">
              Events
              <span class="h-3.5 w-3.5 opacity-40 i-hugeicons-arrow-up-down"></span>
            </button>
          </th>
          <th scope="col" class="px-4 py-3.5 font-semibold text-center text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">Status</th>
          <th scope="col" class="px-4 py-3.5 font-semibold text-right text-stone-500 text-xs tracking-wider uppercase dark:text-neutral-400">
            <button type="button" class="inline-flex gap-1.5 items-center hover:text-stone-700 dark:hover:text-neutral-200" @click="nextSort('last_seen')">
              Last seen
              <span class="h-3.5 w-3.5 opacity-40 i-hugeicons-arrow-up-down"></span>
            </button>
          </th>
          <th scope="col" class="px-4 py-3.5 w-36"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody class="divide-stone-100 divide-y dark:divide-neutral-700">
        <template :for="error in rows()">
          <tr class="hover:bg-stone-50/50 dark:hover:bg-neutral-800/50">
            <td class="pl-5 pr-4 py-3.5">
              <span class="inline-flex items-center px-2 py-0.5 font-medium text-neutral-700 text-xs dark:text-neutral-200 bg-neutral-100 dark:bg-neutral-700 rounded">{{ error.type }}</span>
            </td>
            <td class="px-4 py-3.5 max-w-lg">
              <button type="button" class="block w-full text-left text-neutral-700 text-sm truncate dark:text-neutral-200 hover:text-blue-600 dark:hover:text-blue-400" @click="emit('row-click', error)">{{ error.message }}</button>
            </td>
            <td class="px-4 py-3.5 text-center">
              <span class="inline-flex items-center justify-center px-2 py-0.5 min-w-[2rem] font-semibold text-neutral-700 text-xs dark:text-neutral-200 bg-neutral-100 dark:bg-neutral-700 rounded-full">{{ error.count }}</span>
            </td>
            <td class="px-4 py-3.5 text-center">
              <span :class="'inline-flex items-center px-2 py-0.5 font-medium text-xs border rounded-full ' + statusClass(error.status)">{{ error.status }}</span>
            </td>
            <td class="px-4 py-3.5 text-neutral-500 text-right text-sm whitespace-nowrap dark:text-neutral-400">{{ formatRelativeTime(error.last_seen) }}</td>
            <td class="px-4 py-3.5">
              <div class="flex gap-1 items-center justify-end">
                <Button :if="error.status === 'unresolved'" variant="success" size="sm" iconOnly ariaLabel="Resolve error" @click="emit('resolve', error)">
                  <span class="block h-4 w-4 i-hugeicons-checkmark-circle-02"></span>
                </Button>
                <Button :if="error.status === 'unresolved'" variant="warning" size="sm" iconOnly ariaLabel="Ignore error" @click="emit('ignore', error)">
                  <span class="block h-4 w-4 i-hugeicons-view-off"></span>
                </Button>
                <Button :if="error.status !== 'unresolved'" variant="secondary" size="sm" iconOnly ariaLabel="Unresolve error" @click="emit('unresolve', error)">
                  <span class="block h-4 w-4 i-hugeicons-refresh"></span>
                </Button>
                <Button variant="danger" size="sm" iconOnly ariaLabel="Delete error" @click="emit('delete', error)">
                  <span class="block h-4 w-4 i-hugeicons-delete-02"></span>
                </Button>
              </div>
            </td>
          </tr>
        </template>
      </tbody>
    </table>
  </div>
</div>
