<div class="p-6 space-y-6">

  <PageHeader title="Error Tracking" description="Monitor and manage application errors. Similar errors are grouped together." />

  <div :show="hasStats" class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 mb-6">
    <StatsCard title="Total Errors" icon="i-hugeicons-bug-01" iconBg="primary">
      <template #value>{{ totalErrorsLabel() }}</template>
    </StatsCard>
    <StatsCard title="Unresolved" icon="i-hugeicons-alert-02" iconBg="danger">
      <template #value>{{ unresolvedLabel() }}</template>
    </StatsCard>
    <StatsCard title="Last 24 Hours" trendLabel="vs previous period" icon="i-hugeicons-time-02" iconBg="warning">
      <template #value>{{ last24hLabel() }}</template>
      <template #trend>
        <span :class="'inline-flex items-center font-medium text-[12px] ' + (trendValue() > 0 ? 'text-green-500 dark:text-green-400' : trendValue() < 0 ? 'text-red-500 dark:text-red-400' : 'text-neutral-500 dark:text-neutral-400')">
          <span :if="trendValue() !== 0" :class="'mr-0.5 h-3.5 w-3.5 ' + (trendValue() > 0 ? 'i-hugeicons-arrow-up-02' : 'i-hugeicons-arrow-down-02')"></span>
          {{ Math.abs(trendValue()) }}%
        </span>
      </template>
    </StatsCard>
    <StatsCard title="Resolved" icon="i-hugeicons-checkmark-circle-02" iconBg="success">
      <template #value>{{ resolvedStatsLabel() }}</template>
    </StatsCard>
  </div>

  <Card padding="none">
    <template #header>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <h2 class="font-semibold text-lg text-neutral-900 dark:text-white">Issues</h2>
        <div class="flex flex-col gap-3 sm:flex-row">
          <div class="w-full sm:w-64">
            <Input v-model:value="searchQuery" ariaLabel="Search errors" placeholder="Search errors..." size="sm">
              <template #iconLeft>
                <div class="h-4 w-4 i-hugeicons-search-01"></div>
              </template>
            </Input>
          </div>
          <div class="w-full sm:w-40">
            <Select v-model:value="statusFilter" :options="statusOptions" ariaLabel="Error status" placeholder="" size="sm" />
          </div>
          <div class="w-full sm:w-40">
            <Select v-model:value="typeFilter" :options="typeOptions" ariaLabel="Error type" placeholder="" size="sm" />
          </div>
        </div>
      </div>
    </template>

    <ErrorTable
      :errors="filteredErrors"
      :total="groupTotal"
      :currentPage="groupPage"
      :perPage="groupPerPage"
      :emptyTitle="emptyTitle"
      :emptyDescription="emptyDescription"
      @row-click="viewError"
      @resolve="handleResolveError"
      @ignore="handleIgnoreError"
      @unresolve="handleUnresolveError"
      @delete="openDeleteModal"
      @page-change="changeGroupPage"
      @page-size-change="changeGroupPageSize"
      @sort="changeGroupSort"
    />
  </Card>

  <Modal :isOpen="isDetailModalOpen()" :title="detailTitle" size="lg" @close="closeDetailModal">
    <div :show="hasSelectedError" class="space-y-6">
      <div>
        <h3 class="mb-2 font-medium text-neutral-500 text-sm dark:text-neutral-400">Message</h3>
        <p class="p-3 text-neutral-900 dark:text-white bg-neutral-50 dark:bg-neutral-800 rounded-lg">{{ selectedMessage() }}</p>
      </div>

      <div class="grid gap-4 grid-cols-3">
        <div class="p-3 text-center bg-neutral-50 dark:bg-neutral-800 rounded-lg">
          <div class="font-semibold text-2xl text-neutral-900 dark:text-white">{{ selectedCount() }}</div>
          <div class="text-neutral-500 text-sm dark:text-neutral-400">Occurrences</div>
        </div>
        <div class="p-3 text-center bg-neutral-50 dark:bg-neutral-800 rounded-lg">
          <div class="font-medium text-neutral-900 text-sm dark:text-white">{{ selectedFirstSeen() }}</div>
          <div class="text-neutral-500 text-sm dark:text-neutral-400">First Seen</div>
        </div>
        <div class="p-3 text-center bg-neutral-50 dark:bg-neutral-800 rounded-lg">
          <div class="font-medium text-neutral-900 text-sm dark:text-white">{{ selectedLastSeen() }}</div>
          <div class="text-neutral-500 text-sm dark:text-neutral-400">Last Seen</div>
        </div>
      </div>

      <div :show="hasStackTrace">
        <h3 class="mb-2 font-medium text-neutral-500 text-sm dark:text-neutral-400">Stack Trace</h3>
        <pre class="overflow-x-auto p-4 max-h-64 text-neutral-700 text-xs dark:text-neutral-300 bg-neutral-900 dark:bg-black rounded-lg">{{ selectedStackTrace() }}</pre>
      </div>

      <div class="flex gap-2 items-center">
        <span class="text-neutral-500 text-sm dark:text-neutral-400">Status:</span>
        <Badge :variant="getStatusVariant(selectedStatus())">{{ selectedStatus() }}</Badge>
      </div>
    </div>

    <template #footer>
      <div class="flex items-center justify-between w-full">
        <div class="flex gap-2 items-center">
          <Button :show="selectedIsUnresolved" variant="primary" size="sm" @click="resolveSelected()">
            <template #iconLeft>
              <div class="h-4 w-4 i-hugeicons-checkmark-circle-02"></div>
            </template>
            Resolve
          </Button>
          <Button :show="selectedIsUnresolved" variant="outline" size="sm" @click="ignoreSelected()">
            <template #iconLeft>
              <div class="h-4 w-4 i-hugeicons-view-off"></div>
            </template>
            Ignore
          </Button>
          <Button :show="selectedIsResolvedOrIgnored" variant="outline" size="sm" @click="unresolveSelected()">
            <template #iconLeft>
              <div class="h-4 w-4 i-hugeicons-refresh"></div>
            </template>
            Unresolve
          </Button>
        </div>
        <div class="flex gap-2 items-center">
          <Button variant="danger" size="sm" @click="deleteSelected()">
            <template #iconLeft>
              <div class="h-4 w-4 i-hugeicons-delete-02"></div>
            </template>
            Delete
          </Button>
          <Button variant="ghost" size="sm" @click="closeDetailModal">Close</Button>
        </div>
      </div>
    </template>
  </Modal>

  <Modal :isOpen="showDeleteModal()" title="Delete Error Group" size="sm" @close="closeDeleteModal">
    <div class="text-center">
      <div class="flex items-center justify-center mb-4 mx-auto h-12 w-12 bg-red-100 dark:bg-red-900/30 rounded-full">
        <div class="h-6 w-6 text-red-600 dark:text-red-400 i-hugeicons-alert-02"></div>
      </div>
      <p class="text-neutral-600 text-sm dark:text-neutral-300">
        Are you sure you want to delete all <strong>{{ deleteCount() }}</strong> occurrences of this error? This action cannot be undone.
      </p>
      <p class="mt-2 font-medium text-neutral-900 text-sm dark:text-white">{{ deleteMessage() }}</p>
    </div>

    <template #footer>
      <div class="flex gap-3 items-center justify-end w-full">
        <Button variant="ghost" @click="closeDeleteModal()">Cancel</Button>
        <Button variant="danger" @click="confirmDelete()">Delete All</Button>
      </div>
    </template>
  </Modal>
</div>

<script client>
import { useErrors } from '../../../../functions/monitoring/errors'
import { pushToast } from '../../../../functions/toasts'

interface ErrorGroup {
  id?: string | number
  type: string
  message: string
  count: number
  status: 'unresolved' | 'resolved' | 'ignored'
  first_seen: string
  last_seen: string
  stack?: string | null
}

const { groupedErrors, groupedErrorsPage, errorStats, fetchGroupedErrors, fetchErrorStats, resolveErrorGroup, ignoreErrorGroup, unresolveErrorGroup, deleteErrorGroup } = useErrors()

const searchQuery = state('')
const statusFilter = state('')
const typeFilter = state('')

// The groups are one page, searched, filtered and sorted by the server
// (stacksjs/stacks#3195); these are what it was last asked for.
const listPage = state(1)
const perPage = state(10)
const appliedSearch = state('')
const sortKey = state('')
const sortDirection = state<'asc' | 'desc'>('desc')
let searchTimer: ReturnType<typeof setTimeout> | undefined

const selectedError = state<ErrorGroup | null>(null)
const isDetailModalOpen = state(false)
const showDeleteModal = state(false)
const errorToDelete = state<ErrorGroup | null>(null)

const statusOptions = [
  { value: '', label: 'All Statuses' },
  { value: 'unresolved', label: 'Unresolved' },
  { value: 'resolved', label: 'Resolved' },
  { value: 'ignored', label: 'Ignored' },
]

function errorList(): ErrorGroup[] {
  return (groupedErrors.value as ErrorGroup[]) || []
}

function statsValue(): { total?: number, unresolved?: number, last_24h?: number, resolved?: number, trend?: number } | null {
  return (errorStats.value as { total?: number, unresolved?: number, last_24h?: number, resolved?: number, trend?: number } | null) || null
}

const hasStats = derived(() => statsValue() !== null)
const totalErrorsLabel = derived(() => String(statsValue()?.total ?? 0))
const unresolvedLabel = derived(() => String(statsValue()?.unresolved ?? 0))
const last24hLabel = derived(() => String(statsValue()?.last_24h ?? 0))
const resolvedStatsLabel = derived(() => String(statsValue()?.resolved ?? 0))
const trendValue = derived(() => statsValue()?.trend ?? 0)

function pageInfo(): { total: number, page: number, types: string[] } {
  return (groupedErrorsPage.value as { total: number, page: number, types: string[] } | null) ?? { total: 0, page: 1, types: [] }
}

/** Every recorded type, from the server: a page alone would list only its own. */
const typeOptions = derived(() => [
  { value: '', label: 'All Types' },
  ...pageInfo().types.map(type => ({ value: type, label: type })),
])

/** The page the server chose; its search, filters and order are already applied. */
const filteredErrors = derived(() => errorList())
const groupTotal = derived(() => pageInfo().total)
const groupPage = derived(() => pageInfo().page)
const groupPerPage = derived(() => perPage())

async function loadGroups(): Promise<void> {
  await fetchGroupedErrors({
    page: listPage(),
    perPage: perPage(),
    search: appliedSearch(),
    status: statusFilter(),
    type: typeFilter(),
    sort: sortKey() || undefined,
    direction: sortDirection(),
  })
  // The server moves back to the last page when a delete or a narrower
  // filter leaves this one past the end.
  listPage.set(pageInfo().page)
}

function changeGroupPage(value: number | CustomEvent<number>): void {
  listPage.set(Number(eventValue(value)) || 1)
  void loadGroups()
}

function changeGroupPageSize(value: number | CustomEvent<number>): void {
  perPage.set(Number(eventValue(value)) || 10)
  listPage.set(1)
  void loadGroups()
}

function changeGroupSort(value: { key: string, direction: string } | CustomEvent<{ key: string, direction: string }>): void {
  const sort = eventValue(value)
  sortKey.set(sort.key || '')
  sortDirection.set(sort.direction === 'asc' ? 'asc' : 'desc')
  listPage.set(1)
  void loadGroups()
}

// The search and the two filters are model bindings; a change to any asks
// the server for page 1, the search once typing pauses.
let shownSearch = searchQuery()
effect(() => {
  const term = searchQuery().trim()
  if (term === shownSearch)
    return
  shownSearch = term
  if (searchTimer)
    clearTimeout(searchTimer)
  searchTimer = setTimeout(() => {
    appliedSearch.set(term)
    listPage.set(1)
    void loadGroups()
  }, 250)
})

let shownFilters = JSON.stringify([statusFilter(), typeFilter()])
effect(() => {
  const filters = JSON.stringify([statusFilter(), typeFilter()])
  if (filters === shownFilters)
    return
  shownFilters = filters
  listPage.set(1)
  void loadGroups()
})


const hasFilters = derived(() => searchQuery() !== '' || (statusFilter() ?? '') !== '' || (typeFilter() ?? '') !== '')
const emptyTitle = derived(() => hasFilters() ? 'No matching errors' : 'No errors found')
const emptyDescription = derived(() => hasFilters() ? 'Try adjusting your filters' : 'Your application is running smoothly!')

const hasSelectedError = derived(() => selectedError() !== null)
const selectedIsUnresolved = derived(() => selectedError()?.status === 'unresolved')
const selectedIsResolvedOrIgnored = derived(() => {
  const s = selectedError()?.status
  return s !== undefined && s !== 'unresolved'
})
const hasStackTrace = derived(() => Boolean(selectedError()?.stack))
const detailTitle = derived(() => selectedError()?.type ?? 'Error Details')

function selectedMessage(): string { return selectedError()?.message ?? '' }
function selectedCount(): number { return selectedError()?.count ?? 0 }
function selectedStatus(): string { return selectedError()?.status ?? '' }
function selectedFirstSeen(): string { return formatDate(selectedError()?.first_seen ?? '') }
function selectedLastSeen(): string { return formatDate(selectedError()?.last_seen ?? '') }
function selectedStackTrace(): string { return selectedError()?.stack ?? '' }

function deleteCount(): number { return errorToDelete()?.count ?? 0 }
function deleteMessage(): string { return errorToDelete()?.message ?? '' }

function eventValue<T>(value: T | CustomEvent<T>): T {
  return value instanceof CustomEvent ? value.detail : value
}

function viewError(value: ErrorGroup | CustomEvent<ErrorGroup>): void {
  const error = eventValue(value)
  selectedError.set(error)
  isDetailModalOpen.set(true)
}

function closeDetailModal(): void {
  isDetailModalOpen.set(false)
  selectedError.set(null)
}

async function handleResolveError(value: ErrorGroup | CustomEvent<ErrorGroup>): Promise<void> {
  const error = eventValue(value)
  // Only a write that landed moves the group: this used to mark it resolved
  // whatever the server answered (stacksjs/stacks#3194).
  if (!await resolveErrorGroup(error.type, error.message)) {
    pushToast('error', 'Could not resolve this error')
    return
  }
  // Reread the groups too: the table does not see a status changed in place.
  await Promise.all([loadGroups(), fetchErrorStats()])
  if (isDetailModalOpen() && selectedError())
    selectedError.update(e => e ? { ...e, status: 'resolved' } : e)
}

async function handleIgnoreError(value: ErrorGroup | CustomEvent<ErrorGroup>): Promise<void> {
  const error = eventValue(value)
  // Only a write that landed moves the group: this used to mark it ignored
  // whatever the server answered (stacksjs/stacks#3194).
  if (!await ignoreErrorGroup(error.type, error.message)) {
    pushToast('error', 'Could not ignore this error')
    return
  }
  // Reread the groups too: the table does not see a status changed in place.
  await Promise.all([loadGroups(), fetchErrorStats()])
  if (isDetailModalOpen() && selectedError())
    selectedError.update(e => e ? { ...e, status: 'ignored' } : e)
}

async function handleUnresolveError(value: ErrorGroup | CustomEvent<ErrorGroup>): Promise<void> {
  const error = eventValue(value)
  // Only a write that landed moves the group: this used to mark it unresolved
  // whatever the server answered (stacksjs/stacks#3194).
  if (!await unresolveErrorGroup(error.type, error.message)) {
    pushToast('error', 'Could not reopen this error')
    return
  }
  // Reread the groups too: the table does not see a status changed in place.
  await Promise.all([loadGroups(), fetchErrorStats()])
  if (isDetailModalOpen() && selectedError())
    selectedError.update(e => e ? { ...e, status: 'unresolved' } : e)
}

async function resolveSelected(): Promise<void> {
  const target = selectedError()
  if (target)
    await handleResolveError(target)
}

async function ignoreSelected(): Promise<void> {
  const target = selectedError()
  if (target)
    await handleIgnoreError(target)
}

async function unresolveSelected(): Promise<void> {
  const target = selectedError()
  if (target)
    await handleUnresolveError(target)
}

function deleteSelected(): void {
  const target = selectedError()
  if (target)
    openDeleteModal(target)
}

function openDeleteModal(value: ErrorGroup | CustomEvent<ErrorGroup>): void {
  const error = eventValue(value)
  errorToDelete.set(error)
  showDeleteModal.set(true)
  if (isDetailModalOpen())
    isDetailModalOpen.set(false)
}

function closeDeleteModal(): void {
  showDeleteModal.set(false)
  errorToDelete.set(null)
}

async function confirmDelete(): Promise<void> {
  const target = errorToDelete()
  if (!target)
    return
  if (!await deleteErrorGroup(target.type, target.message)) {
    pushToast('error', 'Could not delete this error')
    return
  }
  // Reread the groups too: the table does not see a status changed in place.
  await Promise.all([loadGroups(), fetchErrorStats()])
  closeDeleteModal()
}

function getStatusVariant(status: string): string {
  const variants: Record<string, string> = {
    unresolved: 'danger',
    resolved: 'success',
    ignored: 'warning',
  }
  return variants[status] || 'default'
}

function formatDate(date: string): string {
  if (!date)
    return ''
  return new Date(date).toLocaleString()
}

onMount(async () => {
  await Promise.all([loadGroups(), fetchErrorStats()])
})
</script>
