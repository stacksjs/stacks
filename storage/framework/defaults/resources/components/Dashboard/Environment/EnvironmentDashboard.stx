<script client>
import { DashboardApiError, dashboardApi } from '@stacksjs/defaults/functions/dashboard-api'
import { serializeEnvironmentValue } from '@stacksjs/defaults/resources/functions/dashboard/environment-value'
import { confirmSettingsDiscard } from '@stacksjs/defaults/views/dashboard/composables/settings-dialog'

interface EnvironmentFileIssue {
  line: number
  message: string
}

interface EnvironmentFileState {
  path: string
  content: string
  revision: string
  exists: boolean
  updatedAt: string | null
  backup: {
    content: string
    exists: boolean
    updatedAt: string | null
  }
}

interface KeyReadElsewhere {
  key: string
  file: string
  readable: boolean
}

interface EnvironmentResponse {
  environment: EnvironmentFileState
  files: string[]
  readElsewhere: KeyReadElsewhere[]
}

const envValues = state('')
// The env file open in the editor, and every env file the app loads
// (stacksjs/stacks#3341). A key a later file sets again is read from there.
const file = state('.env')
const files = state<string[]>(['.env'])
const readElsewhere = state<KeyReadElsewhere[]>([])
const readElsewhereLabel = derived(() => readElsewhere()
  .map(entry => entry.readable ? `${entry.key} (${entry.file})` : `${entry.key} (${entry.file}, encrypted, not readable here)`)
  .join(', '))
const revision = state('')
const backupContent = state('')
const backupUpdatedAt = state<string | null>(null)

// Formatted here rather than in the template: `:if` is a sibling attribute on
// the same element, not a wrapper around the expression, so it cannot narrow
// `backupUpdatedAt()` away from null for the `:text` beside it.
const backupSavedLabel = derived(() => {
  const savedAt = backupUpdatedAt()
  return savedAt ? `Saved ${new Date(savedAt).toLocaleString()}` : ''
})
const showAddModal = state(false)
const showBackupModal = state(false)
const isLoading = state(true)
const isSaving = state(false)
const confirming = state(false)
const discardAction = state<(() => void) | null>(null)
const loadError = state('')
const saveError = state('')
const successMessage = state('')
const validationIssues = state<EnvironmentFileIssue[]>([])
const loadedContent = state('')

const newVarKey = state('')
const newVarValue = state('')
const newVarDescription = state('')
const addError = state('')
const addFormId = useId('add-environment-variable')
const fileOptions = derived(() => files().map(name => ({ value: name, label: name })))
const discardTitle = 'Discard unsaved edits?'
const discardDescription = 'Your unsaved changes to this environment file will be lost.'

const hasBackup = derived(() => backupContent().length > 0)
const isBusy = derived(() => isLoading() || isSaving())
const variableCount = derived(() => envValues().split('\n').filter((line) => {
  const trimmed = line.trim()
  return trimmed && !trimmed.startsWith('#') && trimmed.includes('=')
}).length)
const dirty = derived(() => Boolean(revision()) && envValues() !== loadedContent())

function applyEnvironment(result: EnvironmentResponse): void {
  const { environment } = result
  file.set(environment.path)
  files.set(result.files)
  readElsewhere.set(result.readElsewhere)
  envValues.set(environment.content)
  loadedContent.set(environment.content)
  revision.set(environment.revision)
  backupContent.set(environment.backup.content)
  backupUpdatedAt.set(environment.backup.updatedAt)
}

function describeError(error: unknown, fallback: string): string {
  return error instanceof DashboardApiError ? error.message : fallback
}

async function loadEnvironment(): Promise<void> {
  isLoading.set(true)
  loadError.set('')
  try {
    const result = await dashboardApi<EnvironmentResponse>(`/api/dashboard/environment?file=${encodeURIComponent(file())}`)
    applyEnvironment(result)
  }
  catch (error) {
    loadError.set(describeError(error, 'The environment file could not be loaded.'))
  }
  finally {
    isLoading.set(false)
  }
}

function openFile(name: string): void {
  if (!files().includes(name) || name === file())
    return
  void replaceDraft(() => {
    clearFeedback()
    file.set(name)
    void loadEnvironment()
  })
}

function clearFeedback(): void {
  successMessage.set('')
  saveError.set('')
  validationIssues.set([])
}

async function replaceDraft(action: () => void): Promise<void> {
  if (isBusy() || confirming() || discardAction())
    return
  if (!dirty()) {
    action()
    return
  }
  confirming.set(true)
  try {
    const confirmed = await confirmSettingsDiscard(discardTitle, discardDescription, 'Discard Changes')
    if (confirmed === null)
      discardAction.set(action)
    else if (confirmed)
      action()
  }
  finally {
    confirming.set(false)
  }
}

function discardAndContinue(): void {
  const action = discardAction()
  discardAction.set(null)
  action?.()
}

function revertChanges(): void {
  void replaceDraft(() => {
    clearFeedback()
    envValues.set(loadedContent())
  })
}

function openAddModal(): void {
  newVarKey.set('')
  newVarValue.set('')
  newVarDescription.set('')
  addError.set('')
  showAddModal.set(true)
}

function closeAddModal(): void {
  showAddModal.set(false)
  addError.set('')
}

function formatContent(): void {
  const formatted = envValues().split('\n').map((sourceLine) => {
    const line = sourceLine.trim()
    if (!line || line.startsWith('#'))
      return sourceLine.trimEnd()

    const separator = sourceLine.indexOf('=')
    if (separator < 1)
      return sourceLine.trimEnd()

    const key = sourceLine.slice(0, separator).trim()
    const value = sourceLine.slice(separator + 1).trim()
    return `${key}=${value}`
  }).join('\n').replace(/\n{3,}/g, '\n\n')

  envValues.set(formatted.endsWith('\n') ? formatted : `${formatted}\n`)
}

function addVariable(): void {
  const key = newVarKey().trim().toUpperCase()
  if (!/^[A-Z_][A-Z0-9_]*$/.test(key)) {
    addError.set('Use uppercase letters, numbers, and underscores. The first character must be a letter or underscore.')
    return
  }

  const duplicate = envValues().split('\n').some(line => line.slice(0, line.indexOf('=')).trim() === key && line.includes('='))
  if (duplicate) {
    addError.set(`${key} is already defined.`)
    return
  }

  const description = newVarDescription().trim()
  const addition = `${description ? `# ${description}\n` : ''}${key}=${serializeEnvironmentValue(newVarValue())}`
  const current = envValues().trimEnd()
  envValues.set(`${current}${current ? '\n\n' : ''}${addition}\n`)
  closeAddModal()
}

function loadBackup(): void {
  const content = backupContent()
  showBackupModal.set(false)
  void replaceDraft(() => {
    clearFeedback()
    envValues.set(content)
    successMessage.set('Backup loaded into the editor. Review it, then save to apply it.')
  })
}

async function handleSave(): Promise<void> {
  if (isBusy() || confirming() || discardAction() || !dirty())
    return

  isSaving.set(true)
  saveError.set('')
  successMessage.set('')
  validationIssues.set([])

  try {
    const result = await dashboardApi<EnvironmentResponse & { success: true }>('/api/dashboard/environment', {
      method: 'PUT',
      body: {
        file: file(),
        content: envValues(),
        revision: revision(),
      },
    })
    applyEnvironment(result)
    successMessage.set('Environment file saved. Restart long-running processes to load changed values.')
  }
  catch (error) {
    if (error instanceof DashboardApiError && error.status === 422) {
      const fields = error.fields ?? {}
      validationIssues.set(Object.entries(fields).map(([line, message]) => ({
        line: Number(line) || 0,
        message,
      })))
    }
    saveError.set(describeError(error, 'The environment file could not be saved.'))
  }
  finally {
    isSaving.set(false)
  }
}

function handlePageKeydown(event: KeyboardEvent): void {
  if (event.defaultPrevented || confirming() || discardAction() || showBackupModal() || showAddModal()
    || !(event.metaKey || event.ctrlKey) || event.shiftKey || event.altKey)
    return
  if (event.key.toLowerCase() === 'n' && !isBusy()) {
    event.preventDefault()
    openAddModal()
  }
  if (event.key.toLowerCase() === 's') {
    event.preventDefault()
    void handleSave()
  }
}

useEventListener('keydown', handlePageKeydown)
onMount(() => void loadEnvironment())
</script>

<template>
<div class="dashboard-settings-stack">
  <SettingsGroup>
    <SettingsRow :label="files().length > 1 ? 'Environment file' : file()" :description="dirty() ? 'Unsaved changes' : `${variableCount()} variables`">
      <SettingsPicker :if="files().length > 1" :options="fileOptions()" :value="file()"
        ariaLabel="Environment file" :disabled="isBusy() || confirming()" @change="openFile($event)" />
    </SettingsRow>
    <SettingsRow label="Variables">
      <div class="flex flex-wrap gap-2 items-center justify-end">
        <Button :if="hasBackup()" variant="secondary" size="sm" :disabled="isBusy()" @click="showBackupModal.set(true)">View Backup</Button>
        <Button size="sm" :disabled="isBusy()" @click="openAddModal">Add Variable</Button>
      </div>
    </SettingsRow>
  </SettingsGroup>

  <div :if="readElsewhere().length" class="p-4 text-amber-800 text-sm dark:text-amber-200 bg-amber-50 dark:bg-amber-950/30 border border-amber-200 rounded-xl dark:border-amber-900" role="note" data-env-read-elsewhere>
    <p class="font-medium">Some keys here are set again in a file the app loads later.</p>
    <p class="mt-1">Wherever the app can read that later value, it uses it instead of this file's, so change them there:</p>
    <p class="mt-1 font-mono text-xs" :text="readElsewhereLabel()"></p>
  </div>

  <div :if="loadError()" class="p-4 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-xl dark:border-red-900" role="alert">
    <p :text="loadError()"></p>
    <Button class="mt-3" size="sm" variant="secondary" @click="loadEnvironment">Try again</Button>
  </div>

  <div :if="successMessage()" class="p-4 text-emerald-700 text-sm dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 rounded-xl dark:border-emerald-900" role="status" :text="successMessage()"></div>

  <div :if="saveError()" class="p-4 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-xl dark:border-red-900" role="alert">
    <p :text="saveError()"></p>
    <ul :if="validationIssues().length" class="mt-2 pl-5 space-y-1 list-disc">
      <li :for="issue in validationIssues()" :text="issue.line ? `Line ${issue.line}: ${issue.message}` : issue.message"></li>
    </ul>
  </div>

  <div :if="!loadError()">
    <SettingsCodeEditor
      v-model:value="envValues"
      :label="file()"
      language="dotenv"
      :loading="isLoading()"
      @save="handleSave"
      @format="formatContent"
    />

    <div class="flex flex-col gap-3 items-start justify-between sm:flex-row sm:items-center mt-4">
      <div class="flex flex-wrap gap-x-4 gap-y-2 text-stone-500 text-xs dark:text-neutral-400">
        <span><kbd class="px-1.5 py-0.5 font-semibold text-stone-700 dark:text-neutral-200 bg-stone-100 dark:bg-neutral-800 border border-stone-200 rounded dark:border-neutral-700">Cmd/Ctrl + S</kbd> save</span>
        <span><kbd class="px-1.5 py-0.5 font-semibold text-stone-700 dark:text-neutral-200 bg-stone-100 dark:bg-neutral-800 border border-stone-200 rounded dark:border-neutral-700">Cmd/Ctrl + N</kbd> add variable</span>
        <span><kbd class="px-1.5 py-0.5 font-semibold text-stone-700 dark:text-neutral-200 bg-stone-100 dark:bg-neutral-800 border border-stone-200 rounded dark:border-neutral-700">Cmd/Ctrl + Shift + F</kbd> format</span>
      </div>
      <div class="flex gap-2">
        <Button :if="dirty()" variant="secondary" :disabled="isBusy()" @click="revertChanges">Revert</Button>
        <Button variant="secondary" :disabled="isBusy()" @click="formatContent">Format</Button>
        <Button :loading="isSaving()" :disabled="isBusy() || !dirty()" @click="handleSave">Save changes</Button>
      </div>
    </div>
  </div>

  <Modal
    :isOpen="showAddModal()"
    title="Add environment variable"
    description="The variable is added to the editor first. Save the file when you are ready."
    size="sm"
    @close="closeAddModal"
  >
    <form :id="addFormId" class="flex flex-col gap-4" @submit.prevent="addVariable">
      <Input v-model:value="newVarKey" label="Name" placeholder="APP_NAME" :spellcheck="false" required />
      <Input v-model:value="newVarValue" label="Value" placeholder="My App" />
      <Input v-model:value="newVarDescription" label="Description" placeholder="Used in emails and the interface" hint="Optional comment placed above the variable." />
      <p :if="addError()" class="text-red-600 text-sm dark:text-red-400" role="alert" :text="addError()"></p>
    </form>
    <template #footer>
      <div class="flex gap-2">
        <Button variant="ghost" @click="closeAddModal">Cancel</Button>
        <Button type="submit" :form="addFormId">Add to Editor</Button>
      </div>
    </template>
  </Modal>
  <ConfirmDialog :isOpen="Boolean(discardAction())" :title="discardTitle" :description="discardDescription"
    confirmLabel="Discard Changes" variant="warning" @close="discardAction.set(null)" @confirm="discardAndContinue" />

  <Modal
    :isOpen="showBackupModal()"
    title="Environment backup"
    description="This is the file content from immediately before the latest successful save."
    size="lg"
    @close="showBackupModal.set(false)"
  >
    <div class="flex flex-col gap-3">
      <p :if="backupUpdatedAt()" class="text-stone-500 text-xs dark:text-neutral-400" :text="backupSavedLabel()"></p>
      <SettingsCodeEditor readonly :value="backupContent()" label="Environment backup source" language="dotenv" />
    </div>
    <template #footer>
      <div class="flex gap-2">
        <Button variant="ghost" @click="showBackupModal.set(false)">Close</Button>
        <Button @click="loadBackup">Load into editor</Button>
      </div>
    </template>
  </Modal>
</div>
</template>
