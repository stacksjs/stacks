<script client>
import { useDashboard } from '../../../../functions/dashboard'

const dashboard = useDashboard()
const loadingCards = [1, 2, 3, 4]

/**
 * `section` names the feature-backed dashboard section a card belongs to.
 * A card with one is only offered when the server says that section exists -
 * otherwise the home page links to pages the sidebar has hidden and that
 * cannot load. See stacksjs/stacks#2928.
 */
const allQuickLinks = [
  {
    title: 'Blog',
    description: 'Manage posts and pages',
    href: '/content/dashboard',
    icon: 'i-hugeicons-book-open-01',
    tone: 'blue',
    section: 'content',
  },
  {
    title: 'Commerce',
    description: 'View orders and products',
    href: '/commerce/dashboard',
    icon: 'i-hugeicons-store-01',
    tone: 'green',
    section: 'commerce',
  },
  {
    title: 'Cloud',
    description: 'View infrastructure',
    href: '/cloud',
    icon: 'i-hugeicons-cloud',
    tone: 'purple',
  },
  {
    title: 'Settings',
    description: 'Configure the application',
    href: '/settings',
    icon: 'i-hugeicons-settings-02',
    tone: 'neutral',
  },
]

/**
 * Cards without a `section` are always offered. A card with one waits for the
 * server to say that section exists, so the home page never links to a
 * section the sidebar has hidden and whose pages cannot load.
 *
 * Waits, as in `=== true`: until the answer arrives nothing is known, and
 * "not false" showed the Blog and Commerce cards for a moment on every load -
 * long enough for their links to be prefetched and answer 404 in an app with
 * both features off.
 */
function quickLinks() {
  const available = dashboard.sections.value
  return allQuickLinks.filter(link => !link.section || available[link.section] === true)
}

/** Orders are part of the feed only with commerce on, so they are named only then. */
function activityDescription(): string {
  return dashboard.sections.value.commerce === true
    ? 'Orders and user registrations'
    : 'User registrations'
}

const resourceLinks = [
  {
    title: 'Documentation',
    description: 'Guides and API references',
    href: 'https://docs.stacksjs.com',
    icon: 'i-hugeicons-book-02',
    tone: 'blue',
  },
  {
    title: 'Community',
    description: 'Join the Stacks Discord',
    href: 'https://stacksjs.com/discord',
    icon: 'i-hugeicons-discord',
    tone: 'purple',
  },
  {
    title: 'GitHub',
    description: 'Browse the Stacks source',
    href: 'https://github.com/stacksjs/stacks',
    icon: 'i-hugeicons-github',
    tone: 'neutral',
  },
]

function stats() {
  return dashboard.stats.value
}

function httpMetrics() {
  return dashboard.httpMetrics.value
}

function services() {
  return dashboard.systemHealth.value
}

function activities() {
  return dashboard.recentActivity.value
}

function issues() {
  if (dashboard.error.value) {
    return [{ source: 'Dashboard', message: dashboard.error.value }]
  }
  return dashboard.issues.value
}

async function loadDashboard(): Promise<void> {
  try {
    await dashboard.fetchAll()
  }
  catch {
    // The composable exposes the request failure through `error`.
  }
}

onMount(() => {
  void loadDashboard()
})
</script>

<style>
  .dashboard-overview {
    --overview-border: var(--dashboard-border, light-dark(#dedee5, #ffffff1a));
    --overview-surface: var(--dashboard-surface, light-dark(#ffffff, #18191f));
  }
  .overview-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
    gap: .625rem;
    min-width: 0;
  }
  .overview-details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 21rem), 1fr));
    gap: 1rem;
  }
  .overview-panel {
    background: var(--overview-surface);
    border: 1px solid var(--overview-border);
    border-radius: var(--dashboard-radius, 1rem);
  }
</style>

<div class="mx-auto px-4 py-6 sm:px-8 sm:py-8 max-w-6xl dashboard-overview" data-dashboard-overview-page>
  <div data-dashboard-hero class="flex flex-wrap gap-3 items-start justify-between mb-6">
    <PageHeader title="Dashboard" description="Application activity and service health" />
    <Button variant="secondary" size="sm" :loading="dashboard.isLoading.value" @click="loadDashboard">
      Refresh
    </Button>
  </div>

  <details :if="issues().length > 0" class="mb-4 px-4 py-3 text-amber-800 text-sm dark:text-amber-200 overview-panel">
    <summary class="font-medium cursor-pointer">Some dashboard data is unavailable</summary>
    <ul class="mt-2 pl-5 list-disc">
      <li :for="issue in issues()">{{ issue.source }}: {{ issue.message }}</li>
    </ul>
  </details>

  <section aria-labelledby="application-overview" class="mb-5 p-3 sm:p-4 overview-panel">
    <div class="flex flex-wrap gap-2 items-center justify-between mb-3">
      <h2 data-dashboard-ink id="application-overview" class="font-semibold text-base text-neutral-900 dark:text-white">Overview</h2>
      <StxLink data-dashboard-muted to="/requests" class="text-neutral-500 text-sm hover:text-neutral-700 dark:hover:text-neutral-300">Request history</StxLink>
    </div>
    <div class="overview-metrics">
      <StatsCard :for="item in loadingCards" :if="dashboard.isLoading.value && stats().length === 0" loading />
      <StatsCard
        :for="stat in stats()"
        :title="stat.title"
        :value="stat.value"
        :trend="stat.trend"
        :trendLabel="stat.trendLabel"
        :icon="stat.icon"
        :iconBg="stat.iconBg"
      />
      <StatsCard
        :for="metric in httpMetrics()"
        :title="metric.title"
        :value="metric.value"
        :subtitle="metric.detail"
        :icon="metric.icon"
        iconBg="info"
      />
    </div>
  </section>

  <div class="overview-details">
    <ServiceHealth :services="services()" :loading="dashboard.isLoading.value" />
    <ActivityTable :activities="activities()" :description="activityDescription()" :loading="dashboard.isLoading.value">
      <template #actions>
        <StxLink data-dashboard-muted to="/data/activity" class="text-neutral-500 text-sm hover:text-neutral-700 dark:hover:text-neutral-300">View all</StxLink>
      </template>
    </ActivityTable>
  </div>

  <div class="mt-5"><QuickLinks :links="quickLinks()" /></div>
  <div class="mt-5"><QuickLinks title="Resources" :links="resourceLinks" /></div>
</div>
