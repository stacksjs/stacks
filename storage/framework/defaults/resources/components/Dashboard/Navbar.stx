@import('./UI/Button')

<script server>
interface NavbarProps {
  showDropdown?: boolean
  isSidebarCollapsed?: boolean
  currentPath?: string
}

const { isSidebarCollapsed = false, currentPath = '/' } = defineProps<NavbarProps>()

function isActiveRoute(path) {
  return currentPath === path || currentPath.startsWith(path + '/')
}

function getNavbarClasses() {
  return isSidebarCollapsed ? 'navbar-collapsed' : 'navbar-expanded'
}
</script>

<script client>
import { useAuth } from '../../../functions/auth'

const requestedDropdown = useReactiveProp('showDropdown', false)
const dropdownOpen = state(requestedDropdown())
const signingOut = state(false)
const userMenu = useRef('dashboardNavbarUserMenu')
const auth = useAuth()

effect(() => {
  dropdownOpen.set(requestedDropdown())
})

function setDropdownOpen(open: boolean): void {
  dropdownOpen.set(open)
}

async function signOut(): Promise<void> {
  if (signingOut())
    return
  signingOut.set(true)
  try {
    await auth.logout()
    setDropdownOpen(false)
    navigate('/login')
  }
  finally {
    signingOut.set(false)
  }
}

useClickOutside(userMenu, () => setDropdownOpen(false))
</script>

<header
  class="hidden lg:flex sticky top-0 z-10 gap-x-4 items-center px-4 sm:px-6 lg:px-8 h-16 bg-white dark:bg-neutral-900 border-b border-gray-200 dark:border-neutral-600 shadow-sm transition-all duration-300 {{ getNavbarClasses() }}"
>
  <div class="flex flex-1 gap-x-4 self-stretch lg:gap-x-6">
    <StxLink
      to="/models"
      class="flex relative flex-1 items-center pl-8 text-gray-400 sm:text-sm hover:text-gray-600 dark:hover:text-neutral-200 transition-colors"
      aria-label="Search model records"
    >
      <span aria-hidden="true" class="absolute left-0 h-5 w-5 i-hugeicons-search-01"></span>
      <span>Search model records</span>
      <kbd class="ml-auto px-1.5 py-0.5 font-medium text-[10px] text-neutral-400 bg-neutral-100 dark:bg-neutral-700 border border-neutral-200 rounded dark:border-neutral-600">
        ⌘K
      </kbd>
    </StxLink>

    <nav class="flex gap-x-4 items-center lg:gap-x-6" aria-label="Dashboard utilities">
      <a href="/errors" data-stx-link class="header-icon-button header-link {{ isActiveRoute('/errors') ? 'active-header-link' : '' }}" title="View errors">
        <span class="sr-only">View errors</span>
        <span aria-hidden="true" class="h-6 w-6 duration-150 ease-in-out transition i-hugeicons-alert-01"></span>
      </a>

      <a href="/health" data-stx-link class="header-icon-button header-link {{ isActiveRoute('/health') ? 'active-header-link' : '' }}" title="View health">
        <span class="sr-only">View health</span>
        <span aria-hidden="true" class="h-6 w-6 duration-150 ease-in-out transition i-hugeicons-health"></span>
      </a>

      <a href="/insights" data-stx-link class="header-icon-button header-link {{ isActiveRoute('/insights') ? 'active-header-link' : '' }}" title="View cloud insights">
        <span class="sr-only">View cloud insights</span>
        <span aria-hidden="true" class="h-6 w-6 duration-150 ease-in-out transition i-hugeicons-pulse-01"></span>
      </a>

      <a href="/inbox" data-stx-link class="header-icon-button header-link {{ isActiveRoute('/inbox') ? 'active-header-link' : '' }}" title="View inbox">
        <span class="sr-only">View inbox</span>
        <span aria-hidden="true" class="h-6 w-6 duration-150 ease-in-out transition i-hugeicons-mail-02"></span>
      </a>

      <a href="/notifications/dashboard" data-stx-link class="header-icon-button header-link {{ isActiveRoute('/notifications/dashboard') ? 'active-header-link' : '' }}" title="View notifications">
        <span class="sr-only">View notifications</span>
        <span aria-hidden="true" class="h-6 w-6 i-hugeicons-notification-02"></span>
      </a>

      <span class="h-6 w-px bg-gray-200 dark:bg-neutral-700" aria-hidden="true"></span>

      <div ref="dashboardNavbarUserMenu" class="relative ml-3" @keydown.escape="setDropdownOpen(false)">
        <button
          id="user-menu-button"
          type="button"
          class="flex relative items-center justify-center h-8 w-8 text-neutral-300 bg-gray-800 rounded-full focus:outline-none focus:ring-2 focus:ring-blue-500/40"
          :aria-expanded="String(dropdownOpen())"
          aria-haspopup="menu"
          aria-label="Open user menu"
          @click="setDropdownOpen(!dropdownOpen())"
        >
          <span aria-hidden="true" class="h-5 w-5 i-hugeicons-user"></span>
        </button>

        <div
          :if="dropdownOpen()"
          class="absolute right-0 z-10 mt-2 py-1 w-48 bg-white dark:bg-neutral-800 ring-1 ring-black/10 rounded-md focus:outline-none shadow-lg origin-top-right"
          role="menu"
          aria-labelledby="user-menu-button"
        >
          <a href="/settings" data-stx-link class="block px-4 py-2 text-gray-700 text-sm dark:text-neutral-200 hover:bg-gray-100 dark:hover:bg-neutral-700" role="menuitem" @click="setDropdownOpen(false)">Account settings</a>
          <a href="/library/components" data-stx-link class="block px-4 py-2 text-gray-700 text-sm dark:text-neutral-200 hover:bg-gray-100 dark:hover:bg-neutral-700" role="menuitem" @click="setDropdownOpen(false)">Components</a>
          <a href="/settings/billing" data-stx-link class="block px-4 py-2 text-gray-700 text-sm dark:text-neutral-200 hover:bg-gray-100 dark:hover:bg-neutral-700" role="menuitem" @click="setDropdownOpen(false)">Billing</a>
          <div class="px-2 py-1">
            <Button type="button" variant="danger" size="sm" fullWidth :loading="signingOut()" @click="signOut()">Sign out</Button>
          </div>
        </div>
      </div>
    </nav>
  </div>
</header>

<style scoped>
.header-icon-button {
  @apply p-2.5 -m-2.5;
}

.header-link {
  @apply text-gray-400 hover:text-neutral-500 transition-colors duration-150;
}

.active-header-link {
  @apply text-blue-600 dark:text-blue-400;
}

.navbar-expanded,
.navbar-collapsed {
  width: 100%;
}
</style>
