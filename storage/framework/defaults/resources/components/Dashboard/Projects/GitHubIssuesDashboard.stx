<script client>
import { dashboardApi } from '@stacksjs/defaults/functions/dashboard-api'

interface Issue {
  repository: string
  number: number
  title: string
  state: 'open' | 'closed'
  updatedAt: string
  labels: string[]
  url: string
}

interface IssuesSnapshot {
  projects: Array<{ id: string, name: string, repository: string | null }>
  issues: Issue[]
  failures: Array<{ repository: string, message: string }>
  loading: boolean
}

const snapshot = state<IssuesSnapshot | null>(null)
const requesting = state(true)
const error = state('')
const search = state('')
const projectId = state('')
const status = state('all')
const page = state(1)
const pageSize = 30
const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' })
const statusOptions = [
  { value: 'all', label: 'All statuses' },
  { value: 'open', label: 'Open' },
  { value: 'closed', label: 'Closed' },
]

const loading = derived(() => requesting() || Boolean(snapshot()?.loading))
const projects = derived(() => snapshot()?.projects ?? [])
const connected = derived(() => projects().filter(project => project.repository))
const disconnected = derived(() => projects().filter(project => !project.repository))
const projectOptions = derived(() => [
  { value: '', label: 'All projects' },
  ...connected().map(project => ({ value: project.id, label: `${project.name} · ${project.repository}` })),
])
const selectedRepository = derived(() => connected().find(project => project.id === projectId())?.repository)
const filtered = derived(() => {
  const query = search().trim().toLowerCase()
  const repository = selectedRepository()
  const issueStatus = status()
  return (snapshot()?.issues ?? []).filter(issue =>
    (!repository || issue.repository === repository)
    && (issueStatus === 'all' || issue.state === issueStatus)
    && (!query || `${issue.title} ${issue.repository} #${issue.number} ${issue.labels.join(' ')}`.toLowerCase().includes(query)),
  )
})
const visible = derived(() => filtered().slice((page() - 1) * pageSize, page() * pageSize))
const failures = derived(() => snapshot()?.failures ?? [])
const emptyMessage = derived(() => {
  if (!connected().length)
    return 'No local Stacks projects with a GitHub remote.'
  if (failures().length)
    return 'No matching issues in the results GitHub returned.'
  return 'No issues match these filters.'
})

function resetPage(): void {
  page.set(1)
}

async function load(mode: 'initial' | 'refresh' | 'poll' = 'initial'): Promise<void> {
  if (mode !== 'poll') {
    requesting.set(true)
    error.set('')
    resetPage()
  }
  try {
    const query = mode === 'initial' ? '' : `?${mode}=1`
    const next = await dashboardApi<IssuesSnapshot>(`/__buddy/github-issues${query}`, { auth: false })
    snapshot.set(next)
    if (projectId() && !next.projects.some(project => project.id === projectId() && project.repository))
      projectId.set('')
  }
  catch (failure) {
    error.set(failure instanceof Error ? failure.message : 'Could not load GitHub issues.')
    const previous = snapshot()
    if (previous?.loading)
      snapshot.set({ ...previous, loading: false })
  }
  finally {
    requesting.set(false)
  }
}

let polling = false
useInterval(async () => {
  if (!snapshot()?.loading || requesting() || polling)
    return
  polling = true
  try {
    await load('poll')
  }
  finally {
    polling = false
  }
}, 1_500)
onMount(() => { void load() })
</script>

<div class="flex flex-col gap-5">
  <PageHeader title="GitHub Issues" description="Open and closed issues across your local Stacks projects.">
    <Button variant="secondary" :loading="loading()" @click="load('refresh')">
      <span :if="!loading()" aria-hidden="true" class="h-4 w-4 i-hugeicons-refresh"></span>
      Refresh
    </Button>
  </PageHeader>

  <p :if="error()" role="alert" class="px-4 py-3 text-red-800 text-sm dark:text-red-200 bg-red-50 dark:bg-red-950/30 border border-red-200 rounded-lg dark:border-red-900" :text="error()"></p>
  <aside :if="failures().length" role="status" class="px-4 py-3 text-amber-900 text-sm dark:text-amber-200 bg-amber-50 dark:bg-amber-950/30 border border-amber-200 rounded-lg dark:border-amber-900">
    <p class="font-medium">Some repositories could only be loaded partially or were unavailable.</p>
    <ul class="mt-1 space-y-1">
      <li :for="failure in failures()"><span class="font-medium" :text="failure.repository"></span><span class="ml-2" :text="failure.message"></span></li>
    </ul>
  </aside>

  <section aria-label="Issues" :aria-busy="loading()" class="overflow-hidden bg-white dark:bg-neutral-900 border border-gray-200 rounded-lg dark:border-neutral-800">
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-[minmax(0,1fr)_minmax(0,16rem)_9rem] p-4 border-b border-gray-200 dark:border-neutral-800">
      <SearchFilter v-model:searchValue="search" @search="resetPage" placeholder="Search issues" ariaLabel="Search issues" class="sm:col-span-2 lg:col-span-1" />
      <Select v-model:value="projectId" @change="resetPage" ariaLabel="Filter by project" placeholder="" :options="projectOptions()" />
      <Select v-model:value="status" @change="resetPage" ariaLabel="Filter by status" placeholder="" :options="statusOptions" />
    </div>

    <p :if="loading() && !filtered().length" role="status" class="px-4 py-14 text-center text-gray-500 text-sm dark:text-neutral-400">Loading GitHub issues…</p>
    <p :else-if="snapshot() && !filtered().length" role="status" class="px-4 py-14 text-center text-gray-500 text-sm dark:text-neutral-400" :text="emptyMessage()"></p>
    <ul :else-if="snapshot()" class="divide-gray-200 divide-y dark:divide-neutral-800">
      <li :for="issue in visible()" :key="issue.url">
        <a :href="issue.url" target="_blank" rel="noopener noreferrer" class="flex gap-3 items-start px-4 py-3 hover:bg-gray-50 dark:hover:bg-neutral-800/60 focus-visible:outline-2 focus-visible:outline-blue-500 focus-visible:-outline-offset-2">
          <span :class="issue.state === 'open' ? 'text-green-600 dark:text-green-400 i-hugeicons-circle' : 'text-violet-600 dark:text-violet-400 i-hugeicons-checkmark-circle-02'" class="shrink-0 mt-0.5 h-5 w-5" aria-hidden="true"></span>
          <div class="flex-1 min-w-0">
            <p class="break-words font-medium text-gray-900 text-sm dark:text-white" :text="issue.title"></p>
            <div class="flex flex-wrap gap-x-2 gap-y-1 items-center mt-1 text-gray-500 text-xs dark:text-neutral-400">
              <span class="break-all" :text="issue.repository + ' #' + issue.number"></span>
              <span aria-hidden="true">·</span>
              <span :text="issue.state === 'open' ? 'Open' : 'Closed'"></span>
              <span aria-hidden="true">·</span>
              <time :datetime="issue.updatedAt" :text="'Updated ' + dateFormat.format(new Date(issue.updatedAt))"></time>
              <span :for="label in issue.labels" class="px-2 py-0.5 break-words text-gray-700 dark:text-neutral-200 bg-gray-100 dark:bg-neutral-800 rounded-full" :text="label"></span>
            </div>
          </div>
          <span class="shrink-0 mt-0.5 h-4 w-4 text-gray-400 i-hugeicons-arrow-up-right-01" aria-hidden="true"></span>
        </a>
      </li>
    </ul>

    <div :if="filtered().length > pageSize" class="px-4 py-3 border-gray-200 border-t dark:border-neutral-800">
      <Pagination :currentPage="page()" :totalItems="filtered().length" :itemsPerPage="pageSize" @page="page.set($event)" />
    </div>
    <p :if="loading() && filtered().length" role="status" class="px-4 py-3 text-gray-500 text-xs dark:text-neutral-400 border-gray-200 border-t dark:border-neutral-800">Loading more issues from GitHub…</p>
  </section>

  <details :if="disconnected().length" class="text-gray-600 text-sm dark:text-neutral-400">
    <summary class="cursor-pointer">{{ disconnected().length }} local projects without a GitHub remote</summary>
    <ul class="flex flex-wrap gap-x-4 gap-y-1 mt-2 pl-4">
      <li :for="project in disconnected()" :text="project.name"></li>
    </ul>
  </details>
</div>
