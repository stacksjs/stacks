<script>
interface FontConfig {
  subsets: string[]
  display: string
  variable: string
}

interface LayoutProps {
  inter?: FontConfig
  lexend?: FontConfig
}

const { inter = {
  subsets: ['latin'],
  display: 'swap',
  variable: '--font-inter',
}, lexend = {
  subsets: ['latin'],
  display: 'swap',
  variable: '--font-lexend',
} } = defineProps<LayoutProps>()
</script>
<html
  lang="en"
  class="h-full scroll-smooth bg-white antialiased {{ inter.variable }} {{ lexend.variable }}"
>
  <body class="flex flex-col h-full">
    <slot />
  </body>
</html>
