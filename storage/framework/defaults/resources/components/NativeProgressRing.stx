<script client>
/**
 * A ring that fills as something completes: sets done, a countdown running
 * out. Whatever goes inside it — a count, a time — is the slot.
 *
 * `value` is 0–100. Drawn as an Activity-style ring: a stroke with rounded
 * ends that sweeps from the top, animating to each new value. Colours follow
 * `--native-ring` and `--native-ring-track`, its thickness
 * `--native-ring-width`.
 */
const value = useReactiveProp<number>('value', 0)
const size = useReactiveProp<number>('size', 56)
const label = useReactiveProp<string>('label', '')

const percent = derived(() => Math.max(0, Math.min(100, Number(value()) || 0)))
const ringStyle = derived(() => {
  const px = Math.max(16, Number(size()) || 56)
  return `width:${px}px;height:${px}px`
})
// pathLength is 100, so the offset is what is left to fill. An empty ring
// hides its stroke: a rounded end of zero length still draws a dot.
const fillStyle = derived(() => `stroke-dashoffset:${100 - percent()};opacity:${percent() > 0 ? 1 : 0}`)
</script>

<div class="native-ring" role="img" :aria-label="label()" :style="ringStyle()" data-native-progress-ring>
  <svg class="native-ring-svg" aria-hidden="true" focusable="false">
    <circle class="native-ring-track" cx="50%" cy="50%" r="50%" />
    <circle class="native-ring-fill" cx="50%" cy="50%" r="50%" pathLength="100" :style="fillStyle()" />
  </svg>
  <div class="native-ring-center">
    <slot />
  </div>
</div>

<style>
  .native-ring {
    position: relative;
    flex-shrink: 0;
  }

  /* No viewBox, so the SVG's units are CSS pixels and the stroke is exactly
     --native-ring-width. Inset by half of it: the stroke is drawn centred on
     the circle (r 50% of a square box is half its side) and overflows the
     box by the other half, so the ring's outer edge is the component's. */
  .native-ring-svg {
    position: absolute;
    inset: calc(var(--native-ring-width, 5px) / 2);
    width: calc(100% - var(--native-ring-width, 5px));
    height: calc(100% - var(--native-ring-width, 5px));
    overflow: visible;
    transform: rotate(-90deg);
  }

  .native-ring-track,
  .native-ring-fill {
    fill: none;
    stroke-width: var(--native-ring-width, 5px);
  }

  .native-ring-track { stroke: var(--native-ring-track, rgb(148 163 184 / 0.22)); }

  .native-ring-fill {
    stroke: var(--native-ring, rgb(16 185 129));
    stroke-linecap: round;
    stroke-dasharray: 100;
    transition: stroke-dashoffset 500ms cubic-bezier(0.32, 0.72, 0, 1), opacity 150ms ease;
  }

  .native-ring-center {
    position: absolute;
    inset: var(--native-ring-width, 5px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
  }

  @media (prefers-reduced-motion: reduce) {
    .native-ring-fill { transition: none; }
  }

  :root[data-native-reduce-motion] .native-ring-fill { transition: none; }
</style>
