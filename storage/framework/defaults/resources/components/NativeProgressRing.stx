<script client>
/**
 * A ring that fills as something completes: sets done, a countdown running
 * out. Whatever goes inside it — a count, a time — is the slot.
 *
 * `value` is 0–100. Colours follow `--native-ring` and `--native-ring-track`,
 * its thickness `--native-ring-width`.
 */
const value = useReactiveProp<number>('value', 0)
const size = useReactiveProp<number>('size', 56)
const label = useReactiveProp<string>('label', '')

const ringStyle = derived(() => {
  const percent = Math.max(0, Math.min(100, Number(value()) || 0))
  const px = Math.max(16, Number(size()) || 56)
  return `width:${px}px;height:${px}px;background:conic-gradient(var(--native-ring, rgb(16 185 129)) ${percent}%, var(--native-ring-track, rgb(148 163 184 / 0.22)) 0)`
})
</script>

<div class="native-ring" role="img" :aria-label="label()" :style="ringStyle()" data-native-progress-ring>
  <div class="native-ring-center">
    <slot />
  </div>
</div>

<style>
  .native-ring {
    position: relative;
    flex-shrink: 0;
    border-radius: 9999px;
    transition: background 200ms linear;
  }

  .native-ring-center {
    position: absolute;
    inset: var(--native-ring-width, 5px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: var(--native-ring-center, var(--native-safe-area-background, Canvas));
  }

  @media (prefers-reduced-motion: reduce) {
    .native-ring { transition: none; }
  }
</style>
