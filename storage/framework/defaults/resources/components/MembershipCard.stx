<script client>
  /** A personalized keepsake. Mount after confirmed completion to play once. */
  const mcName = useReactiveProp<string>('name', '')
  const mcBrand = useReactiveProp<string>('brand', '')
  const mcLogo = useReactiveProp<string>('logo', '')
  const mcNameFont = useReactiveProp<string>('nameFont', "'Snell Roundhand', 'Apple Chancery', 'URW Chancery L', cursive")
  const mcDetail = useReactiveProp<string>('detail', '')
  const mcLabel = useReactiveProp<string>('label', '')
  const mcNameLabel = useReactiveProp<string>('nameLabel', '')
  const mcMemberId = useReactiveProp<string>('memberId', '')
  const mcMemberIdLabel = useReactiveProp<string>('memberIdLabel', '')
  const mcReplay = useReactiveProp<number>('replay', 0)
  const mcReveals = derived(() => [mcReplay()])
  const mcCelebrate = useReactiveProp<boolean>('celebrate', true)
  const mcPieces = [...Array(32).keys()].map(id => ({
    id,
    style: `--mc-x:${(id * 37 + 11) % 100}%;--mc-drift:${(id * 29 % 160) - 80}px;--mc-delay:${id % 8 * 65}ms;--mc-turn:${180 + id * 47}deg;--mc-color:var(--membership-card-confetti-${id % 4 + 1},${['#99f6e4', '#e2e8f0', '#5eead4', '#94a3b8'][id % 4]})`,
  }))
</script>

<div :for="reveal in mcReveals" :key="reveal" class="relative mx-auto w-full mc-stage" :class="mcCelebrate ? 'mc-celebrate' : ''" data-membership-reveal>
  <div :if="mcCelebrate" class="absolute inset-0 overflow-hidden pointer-events-none mc-confetti" aria-hidden="true">
    <span :for="piece in mcPieces" :key="piece.id" class="mc-piece" :style="piece.style"></span>
  </div>
  <article class="overflow-hidden relative mx-auto w-full mc-metal" :aria-label="mcLabel" data-membership-card>
    <div class="absolute inset-0 pointer-events-none mc-grain" aria-hidden="true"></div>
    <div class="absolute inset-0 pointer-events-none mc-shine" aria-hidden="true"></div>
    <div class="flex relative gap-4 items-start justify-between">
      <img :if="mcLogo" class="mc-logo" :src="mcLogo" :alt="mcBrand" width="96" height="38" />
      <span :if="!mcLogo" class="font-bold mc-wordmark" :text="mcBrand"></span>
    </div>
    <p class="relative mt-3 text-xs mc-label" :text="mcLabel"></p>
    <div class="relative mc-holder">
      <div class="mc-person">
        <p class="mb-2 text-xs mc-label" :text="mcNameLabel"></p>
        <p class="mc-engraving" :style="{ fontFamily: mcNameFont }" :text="mcName" data-membership-name></p>
      </div>
      <div :if="mcMemberId" class="mc-identity">
        <p class="text-xs mc-label" :text="mcMemberIdLabel"></p>
        <p class="font-semibold mc-serial" :text="mcMemberId" data-membership-id></p>
      </div>
    </div>
    <p :if="mcDetail" class="relative mt-5 text-xs mc-detail" :text="mcDetail"></p>
  </article>
</div>

<style>
  .mc-stage { max-width: 28rem; padding: 2rem 0 2.5rem; perspective: 1000px; }
  .mc-metal {
    box-sizing: border-box; min-height: 15.5rem; padding: clamp(1.25rem, 5vw, 2rem); border-radius: 1.25rem;
    color: var(--membership-card-color, #e2e8f0); border: 1px solid var(--membership-card-border, #87939d);
    background: var(--membership-card-background, linear-gradient(125deg, #596570 0%, #28343e 22%, #111c25 48%, #35434f 74%, #657480 100%));
    box-shadow: var(--membership-card-shadow, inset 0 1px 0 #f1f5f9a6, inset 0 -2px 0 #050b10, inset 1px 0 0 #cbd5e133, 0 24px 40px -20px #02061799);
  }
  .mc-metal p { margin: 0; }
  .mc-metal > .mc-label { margin-top: 0.75rem; }
  .mc-metal .mc-person .mc-label { margin-bottom: 0.5rem; }
  .mc-metal .mc-serial { margin-top: 0.5rem; }
  .mc-metal .mc-detail { margin-top: 1.25rem; }
  .mc-metal::after { content: ''; position: absolute; inset: 6px; border: 1px solid var(--membership-card-inset-border, #cbd5e126); border-radius: 1rem; pointer-events: none; }
  .mc-grain { opacity: 0.35; background: repeating-linear-gradient(0deg, transparent, transparent 1px, var(--membership-card-grain, #cbd5e114) 1px, var(--membership-card-grain, #cbd5e114) 2px); }
  .mc-shine { transform: translateX(-150%) skewX(-20deg); background: linear-gradient(90deg, transparent 25%, #ffffff30 48%, #ffffff66 50%, #ffffff12 54%, transparent 75%); }
  .mc-wordmark { font-size: clamp(1.3rem, 5vw, 1.75rem); letter-spacing: -0.06em; overflow-wrap: anywhere; text-shadow: 0 -1px 1px #020617, 0 1px 0 #ffffff55; }
  .mc-metal .mc-logo { display: block; width: 6rem; height: 2.375rem; margin: 0; object-fit: contain; object-position: left center; }
  .mc-label { color: var(--membership-card-label, #cbd5e1); letter-spacing: 0.12em; }
  .mc-holder { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1.25rem; align-items: end; margin-top: 2rem; }
  .mc-person { min-width: 0; }
  .mc-metal .mc-engraving { padding: 0 0 0.25rem; font-size: clamp(2.25rem, 8vw, 3.25rem); font-weight: 400; line-height: 1.2; letter-spacing: 0; overflow-wrap: anywhere; color: var(--membership-card-name, #f1f5f9); text-shadow: 0 -1px 1px #020617, 0 1px 0 #ffffff80, 0 2px 2px #02061780; }
  .mc-identity { padding-left: 1rem; border-left: 1px solid var(--membership-card-divider, #cbd5e133); }
  .mc-serial { margin-top: 0.4rem; font-family: ui-monospace, monospace; font-size: clamp(1rem, 3.8vw, 1.2rem); letter-spacing: 0.1em; overflow-wrap: anywhere; color: var(--membership-card-serial, #ccfbf1); text-shadow: 0 -1px 1px #020617, 0 1px 0 #ffffff80; }
  .mc-detail { color: var(--membership-card-detail, #cbd5e1); overflow-wrap: anywhere; }
  .mc-confetti { z-index: 2; }
  .mc-piece { position: absolute; top: 0; left: var(--mc-x); width: 5px; height: 10px; border-radius: 1px; background: var(--mc-color); opacity: 0; }
  @media (max-width: 360px) {
    .mc-holder { grid-template-columns: minmax(0, 1fr); gap: 1rem; margin-top: 2rem; }
    .mc-identity { padding-left: 0; border-left: 0; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .mc-celebrate .mc-metal { animation: mc-arrive 1100ms cubic-bezier(0.16, 1, 0.3, 1) both; }
    .mc-celebrate .mc-shine { animation: mc-polish 1700ms ease-in-out 650ms both; }
    .mc-celebrate .mc-piece { animation: mc-fall 2400ms cubic-bezier(0.2, 0.65, 0.45, 1) var(--mc-delay) both; }
    .mc-metal:hover .mc-shine { transform: translateX(150%) skewX(-20deg); transition: transform 1400ms ease; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mc-confetti, .mc-shine { display: none; }
  }
  @keyframes mc-arrive { from { opacity: 0; transform: translateY(32px) rotateX(16deg) rotateY(-12deg) scale(0.92); } to { opacity: 1; transform: none; } }
  @keyframes mc-polish { from { transform: translateX(-150%) skewX(-20deg); } to { transform: translateX(150%) skewX(-20deg); } }
  @keyframes mc-fall { 0% { opacity: 0; transform: translateY(-12px) rotate(0deg); } 12% { opacity: 1; } 80% { opacity: 0.9; } 100% { opacity: 0; transform: translate(var(--mc-drift), 340px) rotate(var(--mc-turn)); } }
</style>
