@extends('layouts/default')

<script server>
import { buildDashboardSectionHubs } from '@stacksjs/defaults/resources/functions/dashboard/section-navigation'
import { buildWebSidebarSections } from '@stacksjs/defaults/resources/functions/dashboard/sidebar'

export const hub = buildDashboardSectionHubs(buildWebSidebarSections())
  .find(section => section.id === (typeof params !== 'undefined' ? params.section : undefined))
export const sectionTitle = hub ? `Dashboard - ${hub.label}` : 'Section not found'
</script>

@section('content')
@title(sectionTitle)
@if(hub)
  <div data-dashboard-section-page data-section-id="{{ hub.id }}" class="mx-auto px-4 py-6 sm:px-8 sm:py-8 max-w-6xl">
    <div data-dashboard-hero class="mb-6">
      <PageHeader :title="hub.label" :description="hub.description || ''" />
    </div>
    <DashboardNavigationCards :navigationCards="hub.destinations" emptyLabel="No pages are available in this section." />
  </div>
@else
  <NotFoundDashboard />
@endif
@endsection
