@extends('layouts/default')

@section('content')
<script client>
interface DeliveryStat {
  label: string
  value: string
  detail: string
}

interface DeliveryRoute {
  id: number
  driver: string
  vehicle: string
  stops: number
  duration: string
  distance: string
  lastActive: string
}

interface ShippingMethod {
  id: number
  name: string
  status: string
  baseRate: string
  freeShipping: string
}

interface ShippingZone {
  id: number
  name: string
  status: string
  countries: number
  regions: number
}

interface DriverSummary {
  total: number
  active: number
  onDelivery: number
  onBreak: number
}

interface DeliveryOverviewResponse {
  stats?: DeliveryStat[]
  routes?: DeliveryRoute[]
  methods?: ShippingMethod[]
  zones?: ShippingZone[]
  drivers?: DriverSummary
}

const stats = state<DeliveryStat[]>([])
const routes = state<DeliveryRoute[]>([])
const methods = state<ShippingMethod[]>([])
const zones = state<ShippingZone[]>([])
const drivers = state<DriverSummary>({
  total: 0,
  active: 0,
  onDelivery: 0,
  onBreak: 0,
})

const loading = state(true)
const error = state<string | null>(null)

const visibleMethods = derived(() => methods().slice(0, 5))
const visibleZones = derived(() => zones().slice(0, 5))

async function loadOverview(): Promise<void> {
  loading.set(true)
  error.set(null)

  try {
    const response = await fetch('/api/dashboard/commerce/delivery', {
      headers: { accept: 'application/json' },
    })

    if (!response.ok)
      throw new Error(`The delivery API returned HTTP ${response.status}.`)

    const data = await response.json() as DeliveryOverviewResponse

    stats.set(data.stats ?? [])
    routes.set(data.routes ?? [])
    methods.set(data.methods ?? [])
    zones.set(data.zones ?? [])
    drivers.set(data.drivers ?? {
      total: 0,
      active: 0,
      onDelivery: 0,
      onBreak: 0,
    })
  }
  catch (cause) {
    error.set(cause instanceof Error ? cause.message : 'The delivery overview could not be loaded.')
  }
  finally {
    loading.set(false)
  }
}

function statIcon(label: string): string {
  const icons: Record<string, string> = {
    'Active Routes': 'i-hugeicons-route-02',
    'Drivers on Delivery': 'i-hugeicons-delivery-truck-02',
    'Average Route': 'i-hugeicons-clock-01',
    'Active Zones': 'i-hugeicons-maps-global-02',
  }

  return icons[label] || 'i-hugeicons-chart'
}

function statusClass(status: string): string {
  if (status === 'active')
    return 'bg-emerald-50 text-emerald-700 ring-emerald-600/20 dark:bg-emerald-400/10 dark:text-emerald-300 dark:ring-emerald-400/20'
  if (status === 'draft')
    return 'bg-amber-50 text-amber-700 ring-amber-600/20 dark:bg-amber-400/10 dark:text-amber-300 dark:ring-amber-400/20'

  return 'bg-stone-100 text-stone-600 ring-stone-500/20 dark:bg-white/5 dark:text-neutral-300 dark:ring-white/10'
}

function formatStatus(status: string): string {
  return status
    .replaceAll('_', ' ')
    .replace(/\b\w/g, character => character.toUpperCase())
}

function formatRelativeTime(date: string): string {
  if (!date)
    return 'Not recorded'

  const timestamp = new Date(date.replace(' ', 'T')).getTime()
  if (Number.isNaN(timestamp))
    return date

  const minutes = Math.max(0, Math.floor((Date.now() - timestamp) / 60000))
  if (minutes < 1)
    return 'Just now'
  if (minutes < 60)
    return `${minutes}m ago`

  const hours = Math.floor(minutes / 60)
  if (hours < 24)
    return `${hours}h ago`

  return `${Math.floor(hours / 24)}d ago`
}

onMount(loadOverview)
</script>

@title('Dashboard - Commerce Delivery')
<div class="py-6">
  <div class="mx-auto px-4 sm:px-6 md:px-8 max-w-7xl">
    <TabNavigation modelValue="overview" />

    <div class="mt-6">
      <PageHeader
        title="Delivery"
        description="Monitor routes, drivers, shipping methods, and coverage from one place"
      >
        <template #actions>
          <button
            type="button"
            @click="loadOverview()"
            :disabled="loading()"
            class="inline-flex gap-2 items-center px-3 py-2 font-semibold text-sm text-stone-700 dark:text-neutral-200 bg-white dark:bg-neutral-800 hover:bg-stone-50 dark:hover:bg-neutral-700 ring-1 ring-inset ring-stone-300 rounded-md dark:ring-neutral-700 shadow-sm disabled:opacity-50 transition-colors"
          >
            <span :class="(loading() ? 'animate-spin ' : '') + 'h-4 w-4 i-hugeicons-refresh'"></span>
            Refresh
          </button>
          <a
            href="/commerce/delivery/delivery-routes"
            class="inline-flex gap-2 items-center px-3 py-2 font-semibold text-sm text-white bg-blue-600 hover:bg-blue-500 rounded-md shadow-sm transition-colors"
          >
            <span class="h-4 w-4 i-hugeicons-route-02"></span>
            Manage routes
          </a>
        </template>
      </PageHeader>

      <div
        :if="error()"
        role="alert"
        class="flex gap-3 items-start mb-5 px-4 py-3 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/40 ring-1 ring-inset ring-red-200 rounded-lg dark:ring-red-900"
      >
        <span class="mt-0.5 h-5 w-5 i-hugeicons-alert-02"></span>
        <div class="flex-1">
          <p class="font-medium">Delivery data is unavailable</p>
          <p class="mt-0.5 text-red-600 dark:text-red-400" :text="error()"></p>
        </div>
        <button type="button" @click="loadOverview()" class="font-semibold hover:text-red-900 dark:hover:text-red-200">
          Try again
        </button>
      </div>

      <div :if="loading()" aria-label="Loading delivery overview" class="space-y-6 animate-pulse">
        <div class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
          <div class="h-32 bg-stone-200/70 dark:bg-neutral-800 rounded-xl"></div>
          <div class="h-32 bg-stone-200/70 dark:bg-neutral-800 rounded-xl"></div>
          <div class="h-32 bg-stone-200/70 dark:bg-neutral-800 rounded-xl"></div>
          <div class="h-32 bg-stone-200/70 dark:bg-neutral-800 rounded-xl"></div>
        </div>
        <div class="grid gap-6 grid-cols-1 lg:grid-cols-3">
          <div class="lg:col-span-2 h-80 bg-stone-200/70 dark:bg-neutral-800 rounded-xl"></div>
          <div class="h-80 bg-stone-200/70 dark:bg-neutral-800 rounded-xl"></div>
        </div>
      </div>

      <div :if="!loading() && !error()">
        <dl class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
          <template :for="stat in stats">
            <div class="p-5 bg-white dark:bg-neutral-800 ring-1 ring-inset ring-stone-200 rounded-xl dark:ring-neutral-700 shadow-sm">
              <div class="flex items-start justify-between">
                <dt class="font-medium text-sm text-stone-500 dark:text-neutral-400">{{ stat.label }}</dt>
                <span :class="'h-5 w-5 text-blue-600 dark:text-blue-400 ' + statIcon(stat.label)"></span>
              </div>
              <dd class="mt-3 font-semibold tabular-nums text-3xl text-stone-900 tracking-tight dark:text-white">{{ stat.value }}</dd>
              <dd class="mt-1 text-stone-500 text-xs dark:text-neutral-400">{{ stat.detail }}</dd>
            </div>
          </template>
        </dl>

        <div class="grid gap-6 grid-cols-1 lg:grid-cols-3 mt-6">
          <section class="overflow-hidden lg:col-span-2 bg-white dark:bg-neutral-800 ring-1 ring-inset ring-stone-200 rounded-xl dark:ring-neutral-700 shadow-sm">
            <div class="flex items-center justify-between px-5 py-4 border-b border-stone-200 dark:border-neutral-700">
              <div>
                <h2 class="font-semibold text-stone-900 dark:text-white">Active delivery routes</h2>
                <p class="mt-0.5 text-sm text-stone-500 dark:text-neutral-400">Planned stops and the latest route activity</p>
              </div>
              <a href="/commerce/delivery/delivery-routes" class="font-semibold text-blue-600 text-sm dark:text-blue-400 hover:text-blue-500">
                View all
              </a>
            </div>

            <div :if="routes().length === 0" class="px-6 py-14 text-center">
              <span class="inline-block h-8 w-8 text-stone-400 i-hugeicons-route-02"></span>
              <p class="mt-2 font-medium text-sm text-stone-800 dark:text-neutral-200">No delivery routes yet</p>
              <p class="mt-1 text-sm text-stone-500 dark:text-neutral-400">Add a route to begin planning deliveries.</p>
            </div>

            <div :if="routes().length > 0" class="overflow-x-auto">
              <table class="min-w-full divide-stone-200 divide-y dark:divide-neutral-700">
                <thead class="bg-stone-50 dark:bg-neutral-900/40">
                  <tr>
                    <th scope="col" class="px-5 py-3 font-medium text-left text-stone-500 text-xs tracking-wide uppercase dark:text-neutral-400">Driver</th>
                    <th scope="col" class="px-4 py-3 font-medium text-left text-stone-500 text-xs tracking-wide uppercase dark:text-neutral-400">Plan</th>
                    <th scope="col" class="px-4 py-3 font-medium text-left text-stone-500 text-xs tracking-wide uppercase dark:text-neutral-400">Distance</th>
                    <th scope="col" class="px-5 py-3 font-medium text-right text-stone-500 text-xs tracking-wide uppercase dark:text-neutral-400">Last active</th>
                  </tr>
                </thead>
                <tbody class="divide-stone-100 divide-y dark:divide-neutral-700">
                  <template :for="route in routes">
                    <tr class="hover:bg-stone-50/70 dark:hover:bg-neutral-700/40 transition-colors">
                      <td class="px-5 py-3.5">
                        <p class="font-medium text-sm text-stone-900 dark:text-white">{{ route.driver }}</p>
                        <p class="mt-0.5 text-stone-500 text-xs dark:text-neutral-400">{{ route.vehicle }}</p>
                      </td>
                      <td class="px-4 py-3.5 text-sm text-stone-600 whitespace-nowrap dark:text-neutral-300">
                        <span class="font-medium tabular-nums text-stone-900 dark:text-white">{{ route.stops }}</span> {{ route.stops === 1 ? 'stop' : 'stops' }}
                        <span class="mx-1 text-stone-300 dark:text-neutral-600">/</span>
                        {{ route.duration }}
                      </td>
                      <td class="px-4 py-3.5 text-sm text-stone-600 whitespace-nowrap dark:text-neutral-300">{{ route.distance }}</td>
                      <td class="px-5 py-3.5 text-right text-sm text-stone-500 whitespace-nowrap dark:text-neutral-400">{{ formatRelativeTime(route.lastActive) }}</td>
                    </tr>
                  </template>
                </tbody>
              </table>
            </div>
          </section>

          <section class="p-5 text-white bg-stone-950 rounded-xl shadow-sm">
            <div class="flex items-start justify-between">
              <div>
                <h2 class="font-semibold">Fleet availability</h2>
                <p class="mt-1 text-sm text-stone-400">Current driver assignments</p>
              </div>
              <span class="h-5 w-5 text-blue-400 i-hugeicons-delivery-truck-02"></span>
            </div>

            <div class="mt-7">
              <p class="font-semibold tabular-nums text-4xl tracking-tight">{{ drivers().total }}</p>
              <p class="mt-1 text-sm text-stone-400">Drivers in the fleet</p>
            </div>

            <dl class="mt-7 space-y-3">
              <div class="flex items-center justify-between py-2 border-b border-stone-800">
                <dt class="flex gap-2 items-center text-sm text-stone-300">
                  <span class="h-2 w-2 bg-emerald-400 rounded-full"></span>
                  Available
                </dt>
                <dd class="font-semibold tabular-nums">{{ drivers().active }}</dd>
              </div>
              <div class="flex items-center justify-between py-2 border-b border-stone-800">
                <dt class="flex gap-2 items-center text-sm text-stone-300">
                  <span class="h-2 w-2 bg-blue-400 rounded-full"></span>
                  On delivery
                </dt>
                <dd class="font-semibold tabular-nums">{{ drivers().onDelivery }}</dd>
              </div>
              <div class="flex items-center justify-between py-2">
                <dt class="flex gap-2 items-center text-sm text-stone-300">
                  <span class="h-2 w-2 bg-amber-400 rounded-full"></span>
                  On break
                </dt>
                <dd class="font-semibold tabular-nums">{{ drivers().onBreak }}</dd>
              </div>
            </dl>

            <a href="/commerce/delivery/drivers" class="inline-flex gap-2 items-center mt-6 font-semibold text-blue-300 text-sm hover:text-blue-200">
              Manage drivers
              <span class="h-4 w-4 i-hugeicons-arrow-right-01"></span>
            </a>
          </section>
        </div>

        <div class="grid gap-6 grid-cols-1 lg:grid-cols-2 mt-6">
          <section class="overflow-hidden bg-white dark:bg-neutral-800 ring-1 ring-inset ring-stone-200 rounded-xl dark:ring-neutral-700 shadow-sm">
            <div class="flex items-center justify-between px-5 py-4 border-b border-stone-200 dark:border-neutral-700">
              <div>
                <h2 class="font-semibold text-stone-900 dark:text-white">Shipping methods</h2>
                <p class="mt-0.5 text-sm text-stone-500 dark:text-neutral-400">Rates and free shipping thresholds</p>
              </div>
              <a href="/commerce/delivery/shipping-methods" class="font-semibold text-blue-600 text-sm dark:text-blue-400 hover:text-blue-500">Manage</a>
            </div>

            <div :if="visibleMethods().length === 0" class="px-6 py-10 text-center text-sm text-stone-500 dark:text-neutral-400">
              No shipping methods configured.
            </div>

            <ul :if="visibleMethods().length > 0" class="divide-stone-100 divide-y dark:divide-neutral-700">
              <template :for="method in visibleMethods">
                <li class="flex gap-4 items-center justify-between px-5 py-3.5">
                  <div class="min-w-0">
                    <div class="flex gap-2 items-center">
                      <p class="font-medium text-sm text-stone-900 truncate dark:text-white">{{ method.name }}</p>
                      <span :class="'inline-flex px-2 py-0.5 font-medium text-xs ring-1 ring-inset rounded-full ' + statusClass(method.status)">{{ formatStatus(method.status) }}</span>
                    </div>
                    <p class="mt-1 text-stone-500 text-xs dark:text-neutral-400">Free shipping: {{ method.freeShipping }}</p>
                  </div>
                  <p class="font-semibold tabular-nums text-sm text-stone-900 whitespace-nowrap dark:text-white">{{ method.baseRate }}</p>
                </li>
              </template>
            </ul>
          </section>

          <section class="overflow-hidden bg-white dark:bg-neutral-800 ring-1 ring-inset ring-stone-200 rounded-xl dark:ring-neutral-700 shadow-sm">
            <div class="flex items-center justify-between px-5 py-4 border-b border-stone-200 dark:border-neutral-700">
              <div>
                <h2 class="font-semibold text-stone-900 dark:text-white">Shipping zones</h2>
                <p class="mt-0.5 text-sm text-stone-500 dark:text-neutral-400">Regional coverage by zone</p>
              </div>
              <a href="/commerce/delivery/shipping-zones" class="font-semibold text-blue-600 text-sm dark:text-blue-400 hover:text-blue-500">Manage</a>
            </div>

            <div :if="visibleZones().length === 0" class="px-6 py-10 text-center text-sm text-stone-500 dark:text-neutral-400">
              No shipping zones configured.
            </div>

            <ul :if="visibleZones().length > 0" class="divide-stone-100 divide-y dark:divide-neutral-700">
              <template :for="zone in visibleZones">
                <li class="flex gap-4 items-center justify-between px-5 py-3.5">
                  <div class="min-w-0">
                    <div class="flex gap-2 items-center">
                      <p class="font-medium text-sm text-stone-900 truncate dark:text-white">{{ zone.name }}</p>
                      <span :class="'inline-flex px-2 py-0.5 font-medium text-xs ring-1 ring-inset rounded-full ' + statusClass(zone.status)">{{ formatStatus(zone.status) }}</span>
                    </div>
                    <p class="mt-1 text-stone-500 text-xs dark:text-neutral-400">{{ zone.regions }} regional {{ zone.regions === 1 ? 'assignment' : 'assignments' }}</p>
                  </div>
                  <div class="text-right">
                    <p class="font-semibold tabular-nums text-sm text-stone-900 dark:text-white">{{ zone.countries }}</p>
                    <p class="text-stone-500 text-xs dark:text-neutral-400">countries</p>
                  </div>
                </li>
              </template>
            </ul>
          </section>
        </div>
      </div>
    </div>
  </div>
</div>

@endsection
