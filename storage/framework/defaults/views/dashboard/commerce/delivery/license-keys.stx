@extends('layouts/default')

@section('content')
@title('Dashboard - License Keys')
<div class="py-6">
  <div class="mx-auto px-4 sm:px-6 md:px-8 max-w-7xl">
    <TabNavigation modelValue="license" />

    <div class="overflow-hidden mt-6 bg-white dark:bg-neutral-800 rounded-lg shadow">
      <div class="px-4 py-5 sm:px-6 border-b border-gray-200 dark:border-neutral-700">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="font-medium text-gray-900 text-lg dark:text-white">License Keys</h2>
            <p class="mt-1 text-gray-500 text-sm dark:text-neutral-400">Assign products and orders to generated software licenses.</p>
          </div>
          <button @click="openAddModal()" type="button" class="inline-flex items-center px-3 py-2 font-semibold text-sm text-white bg-blue-600 hover:bg-blue-500 rounded-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600 focus-visible:outline-offset-2 shadow-sm">
            <span class="mr-2 h-5 w-5 i-hugeicons-plus-sign"></span>
            Add License Key
          </button>
        </div>
        <div class="mt-4">
          <div class="w-full md:w-96"><SearchFilter placeholder="Search license keys..." @search="handleSearch" /></div>
        </div>
      </div>

      <LicenseKeysTable :licenseKeys="paginatedLicenseKeys" @edit="openEditModal" @delete="handleDeleteLicenseKey" />

      <div class="px-4 py-3 bg-gray-50 dark:bg-neutral-900 border-gray-200 border-t dark:border-neutral-700">
        <DeliveryPagination :currentPage="currentPage" :totalItems="totalItems" :itemsPerPage="itemsPerPage" @prev="handlePrevPage" @next="handleNextPage" @page="handlePageChange" />
      </div>
    </div>
  </div>

  <LicenseKeyDialog
    :open="showAddModal"
    mode="add"
    :options="licenseKeyOptions"
    @submit="addLicenseKey"
    @close="closeAddModal()"
  />
  <LicenseKeyDialog
    :open="showEditModal"
    mode="edit"
    :license-key="editingLicenseKey"
    :options="licenseKeyOptions"
    @submit="saveLicenseKey"
    @close="closeEditModal()"
  />
</div>

<script client>
import { useLicenseKeys } from '../../../../functions/commerce/shippings/license-keys'

type LicenseKeyStatus = 'active' | 'inactive' | 'unassigned'

interface RelatedSummary {
  id: number
  label: string
  detail?: string
}

interface LicenseKey {
  id?: number
  key: string
  template: string
  customer_id?: number | null
  product_id?: number | null
  order_id?: number | null
  expiry_date: string
  created_at?: string
  status: LicenseKeyStatus
  customer?: RelatedSummary | null
  product?: RelatedSummary | null
  order?: RelatedSummary | null
}

const {
  licenseKeys,
  licenseKeyOptions,
  createLicenseKey,
  fetchLicenseKeys,
  fetchLicenseKeyOptions,
  updateLicenseKey,
  deleteLicenseKey,
} = useLicenseKeys()

const showAddModal = state(false)
const showEditModal = state(false)
const editingLicenseKey = state<LicenseKey | null>(null)
const searchQuery = state('')
const currentPage = state(1)
const itemsPerPage = state(5)

const filteredLicenseKeys = derived(() => {
  const list = (licenseKeys.value as LicenseKey[]) || []
  const query = searchQuery().trim().toLowerCase()
  if (!query)
    return list

  return list.filter(licenseKey =>
    licenseKey.key.toLowerCase().includes(query)
    || licenseKey.template.toLowerCase().includes(query)
    || licenseKey.status.toLowerCase().includes(query)
    || (licenseKey.customer?.label.toLowerCase().includes(query) ?? false)
    || (licenseKey.customer?.detail?.toLowerCase().includes(query) ?? false)
    || (licenseKey.product?.label.toLowerCase().includes(query) ?? false)
    || (licenseKey.order?.label.toLowerCase().includes(query) ?? false),
  )
})

const paginatedLicenseKeys = derived(() => {
  const start = (currentPage() - 1) * itemsPerPage()
  return filteredLicenseKeys().slice(start, start + itemsPerPage())
})

const totalItems = derived(() => filteredLicenseKeys().length)

function openAddModal(): void {
  showAddModal.set(true)
}

function closeAddModal(): void {
  showAddModal.set(false)
}

function openEditModal(licenseKey: LicenseKey): void {
  editingLicenseKey.set(licenseKey)
  showEditModal.set(true)
}

function closeEditModal(): void {
  showEditModal.set(false)
  editingLicenseKey.set(null)
}

async function addLicenseKey(payload: LicenseKey): Promise<void> {
  const created = await createLicenseKey(payload as LicenseKey)
  if (!created)
    return
  await fetchLicenseKeys()
  closeAddModal()
}

async function saveLicenseKey(payload: LicenseKey): Promise<void> {
  const target = editingLicenseKey()
  if (!target)
    return

  const updated = await updateLicenseKey({ ...target, ...payload })
  if (!updated)
    return
  await fetchLicenseKeys()
  closeEditModal()
}

function handleSearch(query: string): void {
  searchQuery.set(query)
  currentPage.set(1)
}

async function handleDeleteLicenseKey(licenseKey: LicenseKey): Promise<void> {
  // eslint-disable-next-line no-alert
  if (!confirm('Are you sure you want to delete this license key?'))
    return
  await deleteLicenseKey(licenseKey.id as number)
}

function handlePrevPage(): void {
  if (currentPage() > 1)
    currentPage.update(page => page - 1)
}

function handleNextPage(): void {
  const totalPages = Math.ceil(totalItems() / itemsPerPage())
  if (currentPage() < totalPages)
    currentPage.update(page => page + 1)
}

function handlePageChange(page: number): void {
  currentPage.set(page)
}

onMount(async () => {
  await Promise.all([
    fetchLicenseKeys(),
    fetchLicenseKeyOptions(),
  ])
})
</script>

@endsection
