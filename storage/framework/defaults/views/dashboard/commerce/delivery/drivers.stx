@extends('layouts/default')

@section('content')
@title('Dashboard - Delivery Drivers')
<div class="py-6">
  <div class="mx-auto px-4 sm:px-6 md:px-8 max-w-7xl">
    <TabNavigation modelValue="drivers" />

    <dl class="grid gap-4 grid-cols-1 sm:grid-cols-3 mt-6">
      <div class="flex gap-4 items-center p-5 bg-white dark:bg-neutral-800 rounded-lg shadow">
        <span class="h-8 w-8 text-blue-500 i-hugeicons-user-group"></span>
        <div>
          <dt class="font-medium text-gray-500 text-sm dark:text-neutral-400">Total drivers</dt>
          <dd class="font-semibold tabular-nums text-2xl text-gray-900 dark:text-white">{{ totalDrivers() }}</dd>
        </div>
      </div>
      <div class="flex gap-4 items-center p-5 bg-white dark:bg-neutral-800 rounded-lg shadow">
        <span class="h-8 w-8 text-green-500 i-hugeicons-checkmark-circle-02"></span>
        <div>
          <dt class="font-medium text-gray-500 text-sm dark:text-neutral-400">Available</dt>
          <dd class="font-semibold tabular-nums text-2xl text-gray-900 dark:text-white">{{ availableDrivers() }}</dd>
        </div>
      </div>
      <div class="flex gap-4 items-center p-5 bg-white dark:bg-neutral-800 rounded-lg shadow">
        <span class="h-8 w-8 text-blue-500 i-hugeicons-delivery-truck-01"></span>
        <div>
          <dt class="font-medium text-gray-500 text-sm dark:text-neutral-400">On delivery</dt>
          <dd class="font-semibold tabular-nums text-2xl text-gray-900 dark:text-white">{{ onDeliveryDrivers() }}</dd>
        </div>
      </div>
    </dl>

    <div class="overflow-hidden mt-6 bg-white dark:bg-neutral-800 rounded-lg shadow">
      <div class="px-4 py-5 sm:px-6 border-b border-gray-200 dark:border-neutral-700">
        <div class="flex items-center justify-between">
          <h2 class="font-medium text-gray-900 text-lg dark:text-white">Delivery Drivers</h2>
          <button @click="openAddModal()" type="button" class="inline-flex items-center px-3 py-2 font-semibold text-sm text-white bg-blue-600 hover:bg-blue-500 rounded-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600 focus-visible:outline-offset-2 shadow-sm">
            <div class="mr-2 h-5 w-5 i-hugeicons-plus-sign"></div>
            Add Driver
          </button>
        </div>
        <div class="mt-4">
          <div class="w-full md:w-96"><SearchFilter placeholder="Search drivers..." @search="handleSearch" /></div>
        </div>
      </div>

      <DriversTable :drivers="paginatedDrivers" @edit="openEditModal" @delete="handleDeleteDriver" />

      <div class="px-4 py-3 bg-gray-50 dark:bg-neutral-900 border-gray-200 border-t dark:border-neutral-700">
        <DeliveryPagination :currentPage="currentPage" :totalItems="totalItems" :itemsPerPage="itemsPerPage" @prev="handlePrevPage" @next="handleNextPage" @page="handlePageChange" />
      </div>
    </div>
  </div>

  <!-- Add Driver Modal -->
  <div :show="showAddModal" class="fixed inset-0 overflow-y-auto z-10">
    <div class="flex items-end justify-center sm:items-center p-4 sm:p-0 min-h-full text-center">
      <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" @click="closeAddModal()"></div>
      <form @submit.prevent="addDriver()" class="overflow-hidden relative pb-4 pt-5 px-4 sm:my-8 sm:p-6 sm:max-w-lg sm:w-full text-left bg-white dark:bg-neutral-800 rounded-lg shadow-xl transition-all transform">
        <div>
          <div class="mt-3 sm:mt-5 text-center">
            <h3 class="font-semibold leading-6 text-base text-gray-900 dark:text-white">Add New Driver</h3>
            <div class="mt-4">
              <div class="space-y-4">
                <div>
                  <label for="driver-name" class="block font-medium leading-6 text-gray-900 text-left text-sm dark:text-neutral-200">Name</label>
                  <div class="mt-2">
                    <input type="text" id="driver-name" x-model.trim="newName" maxlength="255" required placeholder="Enter driver name" class="block py-1.5 w-full text-gray-900 sm:leading-6 sm:text-sm dark:text-white placeholder:text-gray-400 dark:bg-neutral-700 border-0 ring-1 ring-gray-300 ring-inset rounded-md dark:ring-neutral-600 focus:ring-2 focus:ring-blue-600 focus:ring-inset shadow-sm" />
                  </div>
                </div>
                <div>
                  <label for="driver-phone" class="block font-medium leading-6 text-gray-900 text-left text-sm dark:text-neutral-200">Phone</label>
                  <div class="mt-2">
                    <input type="tel" id="driver-phone" x-model.trim="newPhone" maxlength="255" required placeholder="Enter phone number" class="block py-1.5 w-full text-gray-900 sm:leading-6 sm:text-sm dark:text-white placeholder:text-gray-400 dark:bg-neutral-700 border-0 ring-1 ring-gray-300 ring-inset rounded-md dark:ring-neutral-600 focus:ring-2 focus:ring-blue-600 focus:ring-inset shadow-sm" />
                  </div>
                </div>
                <div>
                  <label for="driver-vehicle" class="block font-medium leading-6 text-gray-900 text-left text-sm dark:text-neutral-200">Vehicle Number</label>
                  <div class="mt-2">
                    <input type="text" id="driver-vehicle" x-model.trim="newVehicleNumber" maxlength="255" required placeholder="Enter vehicle number" class="block py-1.5 w-full text-gray-900 sm:leading-6 sm:text-sm dark:text-white placeholder:text-gray-400 dark:bg-neutral-700 border-0 ring-1 ring-gray-300 ring-inset rounded-md dark:ring-neutral-600 focus:ring-2 focus:ring-blue-600 focus:ring-inset shadow-sm" />
                  </div>
                </div>
                <div>
                  <label for="driver-license" class="block font-medium leading-6 text-gray-900 text-left text-sm dark:text-neutral-200">License</label>
                  <div class="mt-2">
                    <input type="text" id="driver-license" x-model.trim="newLicense" maxlength="255" required placeholder="Enter license number" class="block py-1.5 w-full text-gray-900 sm:leading-6 sm:text-sm dark:text-white placeholder:text-gray-400 dark:bg-neutral-700 border-0 ring-1 ring-gray-300 ring-inset rounded-md dark:ring-neutral-600 focus:ring-2 focus:ring-blue-600 focus:ring-inset shadow-sm" />
                  </div>
                </div>
                <div>
                  <label for="driver-status" class="block font-medium leading-6 text-gray-900 text-left text-sm dark:text-neutral-200">Status</label>
                  <div class="mt-2">
                    <select id="driver-status" x-model="newStatus" required class="block py-1.5 w-full text-gray-900 sm:leading-6 sm:text-sm dark:text-white dark:bg-neutral-700 border-0 ring-1 ring-gray-300 ring-inset rounded-md dark:ring-neutral-600 focus:ring-2 focus:ring-blue-600 focus:ring-inset shadow-sm">
                      <option value="active">Available</option>
                      <option value="on_delivery">On delivery</option>
                      <option value="on_break">On break</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="sm:grid sm:gap-3 sm:grid-cols-2 sm:grid-flow-row-dense mt-5 sm:mt-6">
          <button type="submit" class="inline-flex justify-center sm:col-start-2 px-3 py-2 w-full font-semibold text-sm text-white bg-blue-600 hover:bg-blue-500 rounded-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600 focus-visible:outline-offset-2 shadow-sm">Add Driver</button>
          <button type="button" @click="closeAddModal()" class="inline-flex justify-center sm:col-start-1 mt-3 px-3 py-2 sm:mt-0 w-full font-semibold text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-700 hover:bg-gray-50 dark:hover:bg-neutral-600 ring-1 ring-gray-300 ring-inset rounded-md dark:ring-neutral-600 shadow-sm">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Edit Driver Modal -->
  <div :show="showEditModal" class="fixed inset-0 overflow-y-auto z-10">
    <div class="flex items-end justify-center sm:items-center p-4 sm:p-0 min-h-full text-center">
      <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" @click="closeEditModal()"></div>
      <form @submit.prevent="saveDriver()" class="overflow-hidden relative pb-4 pt-5 px-4 sm:my-8 sm:p-6 sm:max-w-lg sm:w-full text-left bg-white dark:bg-neutral-800 rounded-lg shadow-xl transition-all transform">
        <div>
          <div class="mt-3 sm:mt-5 text-center">
            <h3 class="font-semibold leading-6 text-base text-gray-900 dark:text-white">Edit Driver</h3>
            <div class="mt-4">
              <div class="space-y-4">
                <div>
                  <label for="edit-driver-name" class="block font-medium leading-6 text-gray-900 text-left text-sm dark:text-neutral-200">Name</label>
                  <div class="mt-2">
                    <input type="text" id="edit-driver-name" x-model.trim="newName" maxlength="255" required placeholder="Enter driver name" class="block py-1.5 w-full text-gray-900 sm:leading-6 sm:text-sm dark:text-white placeholder:text-gray-400 dark:bg-neutral-700 border-0 ring-1 ring-gray-300 ring-inset rounded-md dark:ring-neutral-600 focus:ring-2 focus:ring-blue-600 focus:ring-inset shadow-sm" />
                  </div>
                </div>
                <div>
                  <label for="edit-driver-phone" class="block font-medium leading-6 text-gray-900 text-left text-sm dark:text-neutral-200">Phone</label>
                  <div class="mt-2">
                    <input type="tel" id="edit-driver-phone" x-model.trim="newPhone" maxlength="255" required placeholder="Enter phone number" class="block py-1.5 w-full text-gray-900 sm:leading-6 sm:text-sm dark:text-white placeholder:text-gray-400 dark:bg-neutral-700 border-0 ring-1 ring-gray-300 ring-inset rounded-md dark:ring-neutral-600 focus:ring-2 focus:ring-blue-600 focus:ring-inset shadow-sm" />
                  </div>
                </div>
                <div>
                  <label for="edit-driver-vehicle" class="block font-medium leading-6 text-gray-900 text-left text-sm dark:text-neutral-200">Vehicle Number</label>
                  <div class="mt-2">
                    <input type="text" id="edit-driver-vehicle" x-model.trim="newVehicleNumber" maxlength="255" required placeholder="Enter vehicle number" class="block py-1.5 w-full text-gray-900 sm:leading-6 sm:text-sm dark:text-white placeholder:text-gray-400 dark:bg-neutral-700 border-0 ring-1 ring-gray-300 ring-inset rounded-md dark:ring-neutral-600 focus:ring-2 focus:ring-blue-600 focus:ring-inset shadow-sm" />
                  </div>
                </div>
                <div>
                  <label for="edit-driver-license" class="block font-medium leading-6 text-gray-900 text-left text-sm dark:text-neutral-200">License</label>
                  <div class="mt-2">
                    <input type="text" id="edit-driver-license" x-model.trim="newLicense" maxlength="255" required placeholder="Enter license number" class="block py-1.5 w-full text-gray-900 sm:leading-6 sm:text-sm dark:text-white placeholder:text-gray-400 dark:bg-neutral-700 border-0 ring-1 ring-gray-300 ring-inset rounded-md dark:ring-neutral-600 focus:ring-2 focus:ring-blue-600 focus:ring-inset shadow-sm" />
                  </div>
                </div>
                <div>
                  <label for="edit-driver-status" class="block font-medium leading-6 text-gray-900 text-left text-sm dark:text-neutral-200">Status</label>
                  <div class="mt-2">
                    <select id="edit-driver-status" x-model="newStatus" required class="block py-1.5 w-full text-gray-900 sm:leading-6 sm:text-sm dark:text-white dark:bg-neutral-700 border-0 ring-1 ring-gray-300 ring-inset rounded-md dark:ring-neutral-600 focus:ring-2 focus:ring-blue-600 focus:ring-inset shadow-sm">
                      <option value="active">Available</option>
                      <option value="on_delivery">On delivery</option>
                      <option value="on_break">On break</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="sm:grid sm:gap-3 sm:grid-cols-2 sm:grid-flow-row-dense mt-5 sm:mt-6">
          <button type="submit" class="inline-flex justify-center sm:col-start-2 px-3 py-2 w-full font-semibold text-sm text-white bg-blue-600 hover:bg-blue-500 rounded-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600 focus-visible:outline-offset-2 shadow-sm">Save Changes</button>
          <button type="button" @click="closeEditModal()" class="inline-flex justify-center sm:col-start-1 mt-3 px-3 py-2 sm:mt-0 w-full font-semibold text-gray-900 text-sm dark:text-white bg-white dark:bg-neutral-700 hover:bg-gray-50 dark:hover:bg-neutral-600 ring-1 ring-gray-300 ring-inset rounded-md dark:ring-neutral-600 shadow-sm">Cancel</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script client>
import { useDrivers } from '../../../../functions/commerce/shippings/drivers'

type DriverStatus = 'active' | 'on_delivery' | 'on_break'

interface Driver {
  id?: number
  user_id?: number | null
  name: string
  phone: string
  vehicle_number: string
  license: string
  status: DriverStatus
}

const { drivers, createDriver, fetchDrivers, updateDriver, deleteDriver } = useDrivers()

const showAddModal = state(false)
const showEditModal = state(false)
const editingDriver = state<Driver | null>(null)

const newName = state('')
const newPhone = state('')
const newVehicleNumber = state('')
const newLicense = state('')
const newStatus = state<DriverStatus>('active')

const searchQuery = state('')
const currentPage = state(1)
const itemsPerPage = state(5)

const filteredDrivers = derived(() => {
  const list = (drivers.value as Driver[]) || []
  const q = searchQuery().toLowerCase()
  if (!q)
    return list
  return list.filter(d =>
    d.name.toLowerCase().includes(q)
    || d.phone.toLowerCase().includes(q)
    || d.vehicle_number.toLowerCase().includes(q)
    || d.license.toLowerCase().includes(q)
    || d.status.toLowerCase().includes(q),
  )
})

const paginatedDrivers = derived(() => {
  const start = (currentPage() - 1) * itemsPerPage()
  return filteredDrivers().slice(start, start + itemsPerPage())
})

const totalItems = derived(() => filteredDrivers().length)
const totalDrivers = derived(() => ((drivers.value as Driver[]) || []).length)
const availableDrivers = derived(() => ((drivers.value as Driver[]) || []).filter(d => d.status === 'active').length)
const onDeliveryDrivers = derived(() => ((drivers.value as Driver[]) || []).filter(d => d.status === 'on_delivery').length)

function resetForm(): void {
  newName.set('')
  newPhone.set('')
  newVehicleNumber.set('')
  newLicense.set('')
  newStatus.set('active')
}

function openAddModal(): void {
  resetForm()
  showAddModal.set(true)
}

function closeAddModal(): void {
  showAddModal.set(false)
}

function openEditModal(driver: Driver): void {
  editingDriver.set(driver)
  newName.set(driver.name)
  newPhone.set(driver.phone)
  newVehicleNumber.set(driver.vehicle_number)
  newLicense.set(driver.license)
  newStatus.set(driver.status)
  showEditModal.set(true)
}

function closeEditModal(): void {
  showEditModal.set(false)
  editingDriver.set(null)
}

async function addDriver(): Promise<void> {
  try {
    await createDriver({
      name: newName(),
      phone: newPhone(),
      vehicle_number: newVehicleNumber(),
      license: newLicense(),
      status: newStatus(),
    } as Driver)
    closeAddModal()
  }
  catch (error) {
    // eslint-disable-next-line no-console
    console.error('Failed to create driver:', error)
  }
}

async function saveDriver(): Promise<void> {
  const target = editingDriver()
  if (!target)
    return
  try {
    await updateDriver({
      ...target,
      name: newName(),
      phone: newPhone(),
      vehicle_number: newVehicleNumber(),
      license: newLicense(),
      status: newStatus(),
    })
    closeEditModal()
  }
  catch (error) {
    // eslint-disable-next-line no-console
    console.error('Failed to update driver:', error)
  }
}

function handleSearch(query: string): void {
  searchQuery.set(query)
  currentPage.set(1)
}

async function handleDeleteDriver(driver: Driver): Promise<void> {
  // eslint-disable-next-line no-alert
  if (!confirm('Are you sure you want to delete this driver?'))
    return
  try {
    await deleteDriver(driver.id as number)
  }
  catch (error) {
    // eslint-disable-next-line no-console
    console.error('Failed to delete driver:', error)
  }
}

function handlePrevPage(): void {
  if (currentPage() > 1)
    currentPage.update(p => p - 1)
}

function handleNextPage(): void {
  const totalPages = Math.ceil(totalItems() / itemsPerPage())
  if (currentPage() < totalPages)
    currentPage.update(p => p + 1)
}

function handlePageChange(page: number): void {
  currentPage.set(page)
}

onMount(async () => {
  await fetchDrivers()
})
</script>

@endsection
