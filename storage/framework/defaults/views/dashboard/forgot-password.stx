@extends('layouts/guest')

@section('content')
<script client>
// Forgot-password form (stacksjs/stacks#1838) — same broken-const fix as
// login/register. Original `<script server>` had:
//   1. `const` reassignments (never worked in strict mode)
//   2. A missing `)` on the fetch options object (would never parse)
//   3. `process.env.PORT_API` for a hardcoded `localhost:3008` URL,
//      which won't survive a deploy
// Now uses signals + the shared API client against the framework's
// `/password/forgot` route, so the request carries the CSRF token seeded
// by the guest page and surfaces the server's normalized error message.
const isLoading = state(false)
const error = state('')
const success = state(false)

async function handleForgotPassword(data) {
  isLoading.set(true)
  error.set('')

  try {
    await dashboardApi('/password/forgot', {
      method: 'POST',
      auth: false,
      body: data,
    })
    success.set(true)
  }
  catch (err) {
    error.set(err instanceof Error ? err.message : 'Failed to send reset link')
    // eslint-disable-next-line no-console
    console.error(err)
  }
  finally {
    isLoading.set(false)
  }
}

function handleRetry(): void {
  success.set(false)
  error.set('')
}
</script>

@title('Forgot Password - Stacks Dashboard')
<ForgotPassword
  @submit="handleForgotPassword"
  @retry="handleRetry"
  :isLoading="isLoading()"
  :error="error()"
  :success="success()"
/>

@endsection
