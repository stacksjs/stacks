{
  "name": "ts-broadcasting",
  "type": "module",
  "version": "0.0.9",
  "author": "Chris Breuer <chris@stacksjs.org>",
  "license": "MIT",
  "homepage": "https://github.com/stacksjs/ts-broadcasting#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/ts-broadcasting.git",
    "directory": "packages/ts-broadcasting"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/ts-broadcasting/issues"
  },
  "keywords": [
    "websocket",
    "broadcasting",
    "realtime",
    "bun",
    "laravel",
    "echo"
  ],
  "main": "dist/src/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "broadcast": "./dist/bin/cli.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "test": "bun test",
    "test:unit": "bun test test/unit/",
    "test:integration": "bun test test/integration/",
    "test:e2e": "bun test test/e2e/",
    "test:watch": "bun test --watch",
    "prepublishOnly": "bun --bun build.ts",
    "build": "bun --bun build.ts && bun run compile",
    "compile": "bun build ./bin/cli.ts --compile --minify --outfile bin/broadcast",
    "dev": "bun --watch bin/cli.ts start"
  }
}
