{
  "name": "localtunnels",
  "type": "module",
  "version": "0.2.12",
  "description": "A simple and smart tunneling solution. Expose your localhost to the world.",
  "author": "Chris Breuer <chris@stacksjs.com>",
  "license": "MIT",
  "homepage": "https://github.com/stacksjs/localtunnels",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/localtunnels.git",
    "directory": "packages/localtunnels"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/localtunnels/issues"
  },
  "keywords": [
    "local",
    "tunnel",
    "localtunnel",
    "ngrok",
    "self-hosted",
    "websocket",
    "proxy",
    "expose",
    "localhost",
    "vpn",
    "wireguard",
    "bun",
    "stacks",
    "typescript",
    "javascript"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./cloud": {
      "types": "./dist/src/cloud/index.d.ts",
      "import": "./dist/src/cloud/index.js"
    },
    "./vpn": {
      "types": "./dist/src/vpn/index.d.ts",
      "import": "./dist/src/vpn/index.js"
    }
  },
  "module": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "localtunnel": "./dist/bin/cli.js",
    "lt": "./dist/bin/cli.js"
  },
  "files": [
    "README.md",
    "dist",
    "native/build.zig",
    "native/src"
  ],
  "scripts": {
    "build": "bun build.ts",
    "prepublishOnly": "bun run build",
    "test": "bun test"
  },
  "dependencies": {
    "@stacksjs/ts-analytics": "github:stacksjs/ts-analytics",
    "bunfig": "^0.15.6"
  },
  "devDependencies": {
    "@stacksjs/clapp": "^0.2.0",
    "@stacksjs/ts-cloud": "^0.7.7",
    "better-dx": "^0.2.15"
  }
}
