{
  "name": "@stacksjs/components",
  "type": "module",
  "version": "0.2.154",
  "description": "A modern component library built with STX, featuring headwind utility classes and TypeScript syntax highlighting.",
  "author": "Chris Breuer <chris@stacksjs.org>",
  "license": "MIT",
  "homepage": "https://github.com/stacksjs/stx/tree/main/packages/components#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/stx.git",
    "directory": "./packages/components"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/stx/issues"
  },
  "keywords": [
    "components",
    "ui",
    "stx",
    "headwind",
    "typescript",
    "bun",
    "component-library"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "bun": "./dist/*/index.js",
      "import": "./dist/*/index.js"
    },
    "./stx-plugin": {
      "bun": "./stx-plugin.ts",
      "import": "./stx-plugin.ts"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "dist",
    "src",
    "stx-plugin.ts"
  ],
  "scripts": {
    "build": "bun --bun build.ts",
    "dev": "bun --bun build.ts --watch",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "bun x --bun pickier lint",
    "lint:fix": "bun x --bun pickier lint --fix",
    "typecheck": "bun tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@iconify-json/f7": "^1.2.2",
    "@cwcss/crosswind": "^0.2.14",
    "@stacksjs/stx": "0.2.153",
    "bun-plugin-stx": "0.2.153",
    "ts-syntax-highlighter": "^0.2.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "bun-plugin-dtsx": "^0.21.17",
    "pickier": "^0.1.35",
    "typescript": "^7.0.2"
  }
}
