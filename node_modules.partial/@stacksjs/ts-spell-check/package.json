{
  "name": "@stacksjs/ts-spell-check",
  "type": "module",
  "version": "0.1.0",
  "description": "Fast, zero-dependency spell checker for code. Built with Bun.",
  "author": "Chris Breuer <chris@stacksjs.org>",
  "license": "MIT",
  "homepage": "https://github.com/stacksjs/ts-spell-check#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/ts-spell-check.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/ts-spell-check/issues"
  },
  "keywords": [
    "spell-check",
    "spellcheck",
    "lint",
    "bun",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "import": "./dist/*"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "dist",
    "src/words"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun && bun --bun tsc --declaration --emitDeclarationOnly --outDir dist",
    "test": "bun test",
    "typecheck": "bun --bun tsc --noEmit"
  }
}
